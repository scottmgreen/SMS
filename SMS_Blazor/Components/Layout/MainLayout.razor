@inherits LayoutComponentBase
@inject ISMSSessionService SessionService
@inject NavigationManager Navigation
@inject ILogger<MainLayout> Logger

<div class="d-flex flex-column min-vh-100">
    <header>
        <!-- PDXSMS Navigation -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">
                    <i class="fas fa-shield-alt me-2"></i>PDX Safety Management System
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <!-- Main Navigation -->
                    <ul class="navbar-nav me-auto">
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/">
                                    <i class="fas fa-home me-1"></i>Dashboard
                                </a>
                            </li>
                            
                            <!-- Safety Risk Management -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-exclamation-triangle me-1"></i>Safety Risk Management
                                </a>
                                <ul class="dropdown-menu">
                                    <li><h6 class="dropdown-header">Reports Management</h6></li>
                                    <li><a class="dropdown-item" href="/SMSRiskManagement/Reports">
                                        <i class="fas fa-file-alt me-2"></i>Reports
                                    </a></li>
                                    <li><a class="dropdown-item" href="/SMSRiskManagement/Hazards">
                                        <i class="fas fa-exclamation-triangle me-2"></i>Hazards
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">Hazard Management</h6></li>
                                    <li><a class="dropdown-item" href="/SafetyRiskManagement/HazardReporting">
                                        <i class="fas fa-file-medical-alt me-2"></i>Hazard Reporting
                                    </a></li>
                                    <li><a class="dropdown-item" href="/SafetyRiskManagement/ReportProcessing">
                                        <i class="fas fa-tasks me-2"></i>Report Processing
                                    </a></li>
                                </ul>
                            </li>

                            <!-- System -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-cog me-1"></i>System
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/System/UserManagement">
                                        <i class="fas fa-users me-2"></i>User Management
                                    </a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    
                    <!-- User Information -->
                    <ul class="navbar-nav">
                        @if (isAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-user-circle me-2"></i>
                                        <div class="d-none d-md-block me-2">
                                            <div class="fw-semibold">@displayName</div>
                                        </div>
                                        <span class="badge bg-info text-white user-badge">
                                            @GetUserTypeDisplay()
                                        </span>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><h6 class="dropdown-header">@displayName</h6></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="/api/auth/logout">
                                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                                    </a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link btn btn-outline-light ms-2" href="/login">
                                    <i class="fas fa-sign-in-alt me-1"></i>Access PDXSMS
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        <div class="container-fluid py-3">
            @Body
        </div>
    </main>

    <footer class="bg-primary text-white text-center py-3">
        <div class="container">
            <small>&copy; @DateTime.Now.Year Port of Portland. All rights reserved.</small>
        </div>
    </footer>

    <!-- Radzen Components -->
    <RadzenDialog />
    <RadzenNotification />
    <RadzenTooltip />
    <RadzenContextMenu />
</div>

@code {
    private bool isAuthenticated = false;
    private string displayName = string.Empty;
    private string userType = string.Empty;
    private string userId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isAuthenticated = SessionService.IsAuthenticated();
            
            if (isAuthenticated)
            {
                displayName = SessionService.GetCurrentUserDisplayName() ?? "User";
                userType = SessionService.GetCurrentUserType() ?? "User";
                userId = SessionService.GetCurrentUserId() ?? "Unknown";
                
                Logger.LogInformation("MainLayout initialized for user: {DisplayName} ({UserType})", displayName, userType);
            }
            else
            {
                Logger.LogInformation("MainLayout initialized - user not authenticated");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error checking authentication state in MainLayout");
            isAuthenticated = false;
        }
    }

    private string GetUserTypeDisplay()
    {
        return userType switch
        {
            "APPLICATION" => "Administrator",
            "ORGANIZATIONAL" => "Manager",
            "STAKEHOLDER" => "Stakeholder",
            _ => "User"
        };
    }
}
