@inherits LayoutComponentBase

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - PDXSMS</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Site CSS -->
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="SMS_Blazor.styles.css" />
    
    <style>
        body {
            background-image: url('/images/background_opening.jpg');
            background-size: cover, cover;
            background-position: center center, center center;
            background-repeat: no-repeat, no-repeat;
            background-attachment: fixed, fixed;
            min-height: 100vh;
            position: relative;
        }
        
        /* Add overlay for better text readability */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
        }
        
        main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .login-container {
            width: 100%;
            max-width: 400px;
            padding: 20px;
            z-index: 1;
        }
        
        .login-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }
        
        .login-header {
            padding: 30px 30px 20px;
            background: linear-gradient(45deg, rgba(248, 249, 250, 0.9), rgba(233, 236, 239, 0.9));
            border-bottom: 1px solid #dee2e6;
        }
        
        .login-body {
            padding: 30px;
        }
        
        .form-control-lg {
            border-radius: 10px;
        }
        
        .btn-lg {
            border-radius: 10px;
            padding: 12px;
            font-weight: 600;
        }
        
        .alert {
            border-radius: 10px;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Header with simplified navigation for login -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">
                    <i class="fas fa-shield-alt"></i> PDX Safety Management System (PDXSMS)
                </a>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 d-flex align-items-center justify-content-center">
        @Body
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>