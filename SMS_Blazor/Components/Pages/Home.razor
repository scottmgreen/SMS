@page "/"
@layout SMS_Blazor.Components.Layout.MainLayout
@inject ISMSSessionService SessionService

<PageTitle>PDXSMS Dashboard</PageTitle>

@if (!isAuthenticated)
{
    
    <div class="text-center py-5">
        <div class="text-center mb-4">
            <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
            <h2 class="text-primary">SMS Portal</h2>
            <p class="text-muted">Port of Portland Safety Management System</p>
        </div>
        <a href="/login" class="btn btn-primary">Access System</a>
    </div>
}
else
{
    <div class="container">
        <h2>Welcome to PDXSMS Dashboard</h2>
        <p>Welcome back, @displayName</p>
        
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h5>Reports</h5>
                        <p>Manage safety reports</p>
                        <a href="/SMSRiskManagement/Reports" class="btn btn-primary">View Reports</a>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
}

@code {
    private bool isAuthenticated = false;
    private string displayName = string.Empty;

    protected override void OnInitialized()
    {
        try
        {
            isAuthenticated = SessionService.IsAuthenticated();
            if (isAuthenticated)
            {
                displayName = SessionService.GetCurrentUserDisplayName() ?? "User";
            }
        }
        catch
        {
            isAuthenticated = false;
        }
    }
}
