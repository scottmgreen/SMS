@using SMS_Domain.Entities
@inject IMediator Mediator
@inject ILogger<HazardDetails> Logger

<!-- Hazard Details Expansion Component -->
<div class="p-3 bg-light border-top">
    @if (IsLoading)
    {
        <!-- Loading State -->
        <div class="text-center py-3">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <p class="mt-2 text-muted">Loading hazards for report @ReportCode...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <!-- Error State -->
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter">
            <RadzenIcon Icon="warning" Class="me-2" />
            <strong>Error:</strong> @ErrorMessage
        </RadzenAlert>
    }
    else if (!AssociatedHazards.Any())
    {
        <!-- No Hazards State -->
        <div class="text-center py-3">
            <RadzenIcon Icon="info" Style="font-size: 2rem; color: var(--rz-text-disabled-color);" />
            <p class="mt-2 text-muted">No hazards found for this report</p>
        </div>
    }
    else
    {
        <!-- Hazards List -->
        <div class="row">
            <div class="col-12 mb-3">
                <h6>
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                    Associated Hazards 
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@AssociatedHazards.Count.ToString()" Class="ms-2" />
                </h6>
            </div>
        </div>

        <!-- Hazards Grid -->
        <div class="row g-3">
            @foreach (var hazard in AssociatedHazards)
            {
                <div class="col-lg-6">
                    <div class="card border-warning h-100">
                        <div class="card-header bg-warning bg-opacity-10 py-2">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h6 class="mb-0">
                                        <strong>@hazard.Code</strong>
                                        @if (!string.IsNullOrEmpty(hazard.Name))
                                        {
                                            <span class="text-muted">- @hazard.Name</span>
                                        }
                                    </h6>
                                </div>
                                <div class="col-auto">
                                    <RadzenBadge Text="@GetHazardStatusBadgeText(hazard.Status)" 
                                               BadgeStyle="@GetHazardStatusBadgeStyle(hazard.Status)" 
                                               Variant="Variant.Flat" />
                                </div>
                            </div>
                        </div>
                        <div class="card-body py-2">
                            <div class="row g-2">
                                <!-- Left Column - Hazard Details -->
                                <div class="col-md-8">
                                    <!-- Description -->
                                    <div class="mb-2">
                                        <small class="text-muted d-block">
                                            <strong>Description:</strong>
                                        </small>
                                        <p class="small mb-2">@(hazard.Description ?? "No description")</p>
                                    </div>

                                    <!-- Hazard Details -->
                                    <div class="row g-2 mb-2">
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block"><strong>Type:</strong></small>
                                            <span class="small">@(hazard.HazardType ?? "Not specified")</span>
                                        </div>
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block"><strong>Category:</strong></small>
                                            <span class="small">@(hazard.Category ?? "Not specified")</span>
                                        </div>
                                    </div>

                                    <!-- Priority & Risk Level -->
                                    <div class="row g-2 mb-2">
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block"><strong>Priority:</strong></small>
                                            <RadzenBadge Text="@GetHazardPriorityText(hazard.Priority)" 
                                                       BadgeStyle="@GetHazardPriorityBadgeStyle(hazard.Priority)" 
                                                       Size="BadgeSize.Small" />
                                        </div>
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block"><strong>Risk Level:</strong></small>
                                            <span class="small">@(hazard.RiskLevel ?? "Not assessed")</span>
                                        </div>
                                    </div>

                                    <!-- Reporter Information -->
                                    <div class="row g-2">
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block"><strong>Reported By:</strong></small>
                                            <span class="small">@(hazard.ReportedBy ?? "Unknown")</span>
                                        </div>
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block"><strong>Reported On:</strong></small>
                                            <span class="small">@hazard.ReportedOn.ToString("MM/dd/yyyy")</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right Column - Location Card -->
                                <div class="col-md-4">
                                    <SMS_Blazor.Components.Pages.SMSRiskManagement.Components.HazardLocationCard
                                        Latitude="@GetHazardLatitude(hazard)"
                                        Longitude="@GetHazardLongitude(hazard)"
                                        LocationDescription="@GetHazardLocationDescription(hazard)" />
                                </div>
                            </div>
                        </div>
                        <div class="card-footer py-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    Created: @(hazard.CreatedDate?.ToString("MM/dd/yyyy") ?? "N/A")
                                </small>
                                <div class="btn-group btn-group-sm">
                                    <RadzenButton ButtonStyle="ButtonStyle.Info" 
                                                Variant="Variant.Text" 
                                                Size="ButtonSize.ExtraSmall"
                                                Icon="visibility" 
                                                Text="View"
                                                Click="@(() => OnViewHazard(hazard))" />
                                    <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                                Variant="Variant.Text" 
                                                Size="ButtonSize.ExtraSmall"
                                                Icon="edit" 
                                                Text="Edit"
                                                Click="@(() => OnEditHazard(hazard))" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string ReportCode { get; set; } = string.Empty;
    [Parameter] public EventCallback<Hazard> OnViewHazardCallback { get; set; }
    [Parameter] public EventCallback<Hazard> OnEditHazardCallback { get; set; }

    public List<Hazard> AssociatedHazards { get; set; } = new();
    public bool IsLoading { get; set; } = true;
    public string? ErrorMessage { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(ReportCode))
        {
            await LoadHazardsByReportAsync();
        }
    }

    private async Task LoadHazardsByReportAsync()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;
            StateHasChanged();

            Logger.LogInformation("Loading hazards for report: {ReportCode}", ReportCode);

            // Create ReportID and execute query
            var reportId = new ReportID(ReportCode);
            var query = new GetHazardsByReportIdQuery(reportId);
            var result = await Mediator.SendAsync(query, CancellationToken.None);

            if (result.IsSuccess)
            {
                AssociatedHazards = result.Value ?? new List<Hazard>();
                Logger.LogInformation("Successfully loaded {Count} hazards for report {ReportCode}", 
                    AssociatedHazards.Count, ReportCode);
            }
            else
            {
                AssociatedHazards = new List<Hazard>();
                ErrorMessage = result.Error?.Message ?? "Failed to load hazards";
                Logger.LogWarning("Failed to load hazards for report {ReportCode}: {Error}", 
                     ReportCode, ErrorMessage);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception loading hazards for report {ReportCode}", ReportCode);
            AssociatedHazards = new List<Hazard>();
            ErrorMessage = "An unexpected error occurred while loading hazards.";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnViewHazard(Hazard hazard)
    {
        Logger.LogInformation("View hazard requested: {HazardCode}", hazard.Code);
        if (OnViewHazardCallback.HasDelegate)
        {
            await OnViewHazardCallback.InvokeAsync(hazard);
        }
    }

    private async Task OnEditHazard(Hazard hazard)
    {
        Logger.LogInformation("Edit hazard requested: {HazardCode}", hazard.Code);
        if (OnEditHazardCallback.HasDelegate)
        {
            await OnEditHazardCallback.InvokeAsync(hazard);
        }
    }

    #region Badge Helper Methods
    private string GetHazardStatusBadgeText(SMS_Domain.Enums.HazardStatus status)
    {
        return status?.Name ?? "Unknown";
    }

    private BadgeStyle GetHazardStatusBadgeStyle(SMS_Domain.Enums.HazardStatus status)
    {
        if (status == null) return BadgeStyle.Secondary;

        return status.Name.ToLower() switch
        {
            "active" => BadgeStyle.Success,
            "pending" => BadgeStyle.Warning,
            "closed" => BadgeStyle.Secondary,
            "investigating" => BadgeStyle.Info,
            _ => BadgeStyle.Light
        };
    }

    private string GetHazardPriorityText(SMS_Domain.Enums.HazardPriority priority)
    {
        return priority?.Name ?? "Unknown";
    }

    private BadgeStyle GetHazardPriorityBadgeStyle(SMS_Domain.Enums.HazardPriority priority)
    {
        if (priority == null) return BadgeStyle.Secondary;

        return priority.Name.ToLower() switch
        {
            "high" => BadgeStyle.Danger,
            "medium" => BadgeStyle.Warning,
            "low" => BadgeStyle.Success,
            _ => BadgeStyle.Secondary
        };
    }
    #endregion

    #region Location Helper Methods
    private decimal? GetHazardLatitude(Hazard hazard)
    {
        if (string.IsNullOrEmpty(hazard.LocationArea)) return null;
        
        // Try to parse "Lat: XX.XXXXXX, Lng: YY.YYYYYY" format
        var latMatch = System.Text.RegularExpressions.Regex.Match(hazard.LocationArea, @"Lat:\s*(-?\d+\.?\d*)");
        if (latMatch.Success && decimal.TryParse(latMatch.Groups[1].Value, out var lat))
        {
            return lat;
        }
        
        return null;
    }

    private decimal? GetHazardLongitude(Hazard hazard)
    {
        if (string.IsNullOrEmpty(hazard.LocationArea)) return null;
        
        // Try to parse "Lat: XX.XXXXXX, Lng: YY.YYYYYY" format
        var lngMatch = System.Text.RegularExpressions.Regex.Match(hazard.LocationArea, @"Lng:\s*(-?\d+\.?\d*)");
        if (lngMatch.Success && decimal.TryParse(lngMatch.Groups[1].Value, out var lng))
        {
            return lng;
        }
        
        return null;
    }

    private string? GetHazardLocationDescription(Hazard hazard)
    {
        // If we have coordinates, show the sub-area description
        if (GetHazardLatitude(hazard).HasValue && GetHazardLongitude(hazard).HasValue)
        {
            return hazard.LocationSubArea ?? "Map location";
        }
        
        // Otherwise, show the main location area as description
        return hazard.LocationArea ?? hazard.LocationSubArea;
    }
    #endregion
}