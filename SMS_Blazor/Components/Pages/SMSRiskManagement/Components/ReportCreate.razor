<!-- Report Creation Component -->
<div class="report-create-container">
    <!-- Header -->
    <RadzenCard Variant="Variant.Text" Class="mb-4">
        <div class="d-flex align-items-center">
            <RadzenIcon Icon="add_circle" Class="me-3" Style="font-size: 2.5rem; color: var(--rz-primary);" />
            <div>
                <h3 class="mb-1">Create New Hazard Report</h3>
                <p class="text-muted mb-0">Submit a new hazard report to the SMS system</p>
            </div>
        </div>
    </RadzenCard>

    @if (IsLoading)
    {
        <!-- Loading State -->
        <RadzenCard Class="text-center py-5">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
            <p class="mt-3 text-muted">Processing your report...</p>
        </RadzenCard>
    }
    else if (ShowSuccessConfirmation)
    {
        <!-- Success State -->
        <RadzenCard>
            <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter">
                <div class="d-flex align-items-center">
                    <RadzenIcon Icon="check_circle" Style="font-size: 3rem; color: var(--rz-success);" Class="me-3" />
                    <div>
                        <h4 class="mb-2">Report Successfully Created!</h4>
                        <p class="mb-2">
                            <strong>Report ID:</strong> <RadzenBadge Text="@GeneratedReportId" BadgeStyle="BadgeStyle.Primary" />
                            <strong class="ms-3">Hazard ID:</strong> <RadzenBadge Text="@GeneratedHazardId" BadgeStyle="BadgeStyle.Info" />
                        </p>
                        <p class="text-muted mb-0">Your report has been submitted and will be reviewed by SMS personnel.</p>
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                Click="ResetForm" 
                                Text="Create Another Report" 
                                Icon="add" />
                    <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                Click="OnCloseCallback" 
                                Text="Close" 
                                Icon="close" />
                </div>
            </RadzenAlert>
        </RadzenCard>
    }
    else
    {
        <!-- Main Form -->
        <RadzenRow Gap="2rem">
            <!-- Form Column -->
            <RadzenColumn Size="8">
                <RadzenCard>
                    <RadzenTemplateForm Data="@HazardReportData" Submit="@HandleFormSubmit" TItem="ReportHazardData">
                        <!-- Hazard Type -->
                        <RadzenStack Gap="1.5rem">
                            <RadzenFormField Text="Hazard Type *" Variant="Variant.Outlined">
                                <ChildContent>
                                    <RadzenDropDown @bind-Value="@HazardReportData.HazardType" 
                                                  Data="@HazardTypeOptions" 
                                                  TextProperty="Text" 
                                                  ValueProperty="Value"
                                                  Placeholder="Select hazard type..."
                                                  Name="HazardType"
                                                  Style="width: 100%;" />
                                </ChildContent>
                                <Helper>
                                    <RadzenRequiredValidator Component="HazardType" Text="Hazard type is required" />
                                </Helper>
                            </RadzenFormField>

                            <!-- Reported By and Reported On -->
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="8">
                                    <RadzenFormField Text="Reported By *" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenTextBox @bind-Value="@HazardReportData.ReportedBy" 
                                                         Placeholder="Enter your name and position..."
                                                         Name="ReportedBy"
                                                         Style="width: 100%;" />
                                        </ChildContent>
                                        <Helper>
                                            <RadzenRequiredValidator Component="ReportedBy" Text="Reported by is required" />
                                        </Helper>
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Reported On" Variant="Variant.Outlined">
                                        <RadzenDatePicker @bind-Value="@HazardReportData.ReportedOn" 
                                                        ShowTime="true"
                                                        DateFormat="MM/dd/yyyy HH:mm"
                                                        Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <!-- Department -->
                            <RadzenFormField Text="Reporting Department" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@HazardReportData.ReportingDepartment" 
                                              Data="@DepartmentOptions" 
                                              TextProperty="Text" 
                                              ValueProperty="Value"
                                              Placeholder="Select your department..." 
                                              AllowClear="true"
                                              Style="width: 100%;" />
                            </RadzenFormField>

                            <!-- Location Selection with Map -->
                            <RadzenFormField Text="Location" Variant="Variant.Outlined">
                                <ChildContent>
                                    <RadzenStack Gap="0.5rem">
                                        <div class="d-flex align-items-center gap-2">
                                            <RadzenTextBox Value="@LocationDisplayText" 
                                                         ReadOnly="true"
                                                         Placeholder="Click 'Select on Map' to choose location"
                                                         Style="flex: 1;" />
                                            <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                                        Icon="map"
                                                        Text="Select on Map"
                                                        Click="ShowLocationSelector" />
                                            @if (HasGeoLocation)
                                            {
                                                <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                                            Icon="clear"
                                                            Click="ClearLocation"
                                                            title="Clear location" />
                                            }
                                        </div>
                                        @if (HasGeoLocation)
                                        {
                                            <small class="text-success">
                                                <RadzenIcon Icon="location_on" />
                                                Location set: @LocationDisplayText
                                            </small>
                                        }
                                    </RadzenStack>
                                </ChildContent>
                            </RadzenFormField>

                            <!-- Enhanced Location Selector -->
                            <SMS_Blazor.Components.Pages.SMSRiskManagement.Components.HazardLocationOpenLayers @ref="hazardLocationComponent"
                                                                                                                   OnLocationSelected="OnLocationSelectedCallback"
                                                                                                                   InitialLocation="SelectedGeoLocation" />

                            <!-- Description -->
                            <RadzenFormField Text="Hazard Description *" Variant="Variant.Outlined">
                                <ChildContent>
                                    <RadzenTextArea @bind-Value="@HazardReportData.Description" 
                                                  Rows="6"
                                                  Name="Description"
                                                  Placeholder="Provide a detailed description of the hazard including what happened, when, who was involved, conditions, immediate actions taken, and potential consequences..."
                                                  Style="width: 100%;" />
                                </ChildContent>
                                <Helper>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <RadzenRequiredValidator Component="Description" Text="Description is required" />
                                        <small class="text-muted">@DescriptionCharacterCount/2000 characters</small>
                                    </div>
                                </Helper>
                            </RadzenFormField>

                            <!-- Confidential Flag -->
                            <RadzenCard Variant="Variant.Outlined">
                                <RadzenStack Gap="1rem">
                                    <div class="d-flex align-items-center gap-2">
                                        <RadzenCheckBox @bind-Value="@HazardReportData.IsConfidential" 
                                                      Name="IsConfidential" 
                                                      TriState="false" />
                                        <RadzenLabel Text="Submit as Confidential Report" Component="IsConfidential" />
                                        <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                                    Variant="Variant.Text"
                                                    Icon="info"
                                                    Size="ButtonSize.ExtraSmall"
                                                    Click="ShowConfidentialInfo" />
                                    </div>
                                    @if (ShowConfidentialDetails)
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small">
                                            <strong>Confidential Protection:</strong> Your identity will be protected and access to this report will be restricted to authorized SMS personnel only.
                                        </RadzenAlert>
                                    }
                                </RadzenStack>
                            </RadzenCard>

                            <!-- File Attachments -->
                            <RadzenFormField Text="Supporting Documents" Variant="Variant.Outlined">
                                <ChildContent>
                                    <RadzenFileInput @bind-Value="@SelectedFiles" 
                                                   Multiple="true"
                                                   Accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.txt"
                                                   MaxFileSize="10485760"
                                                   Style="width: 100%;" />
                                </ChildContent>
                                <Helper>
                                    <small class="text-muted d-block mb-2">
                                        <RadzenIcon Icon="attach_file" /> 
                                        Supported formats: JPG, PNG, PDF, DOC, DOCX, TXT (Max 10MB per file)
                                    </small>
                                    @if (AttachedFiles.Any())
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small">
                                            <strong>Selected files (@AttachedFiles.Count):</strong>
                                            <ul class="mb-0 mt-1">
                                                @foreach (var file in AttachedFiles)
                                                {
                                                    <li>@file.FileName (@file.SizeDisplay)</li>
                                                }
                                            </ul>
                                        </RadzenAlert>
                                    }
                                </Helper>
                            </RadzenFormField>
                        </RadzenStack>

                        <!-- Form Actions -->
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Class="mt-4">
                            <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                        Variant="Variant.Outlined"
                                        Icon="preview"
                                        Text="Preview Report"
                                        Click="ShowPreview"
                                        Disabled="@(!IsFormValidForPreview)" />

                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                            Variant="Variant.Outlined"
                                            Icon="clear"
                                            Text="Clear Form"
                                            Click="ClearForm" />
                                <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                            Icon="send"
                                            Text="Submit Report"
                                            ButtonType="ButtonType.Submit"
                                            Disabled="@(!IsFormValidForSubmission)" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenTemplateForm>
                </RadzenCard>
            </RadzenColumn>

            <!-- Help Panel -->
            <RadzenColumn Size="4">
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <div class="d-flex align-items-center gap-2">
                            <RadzenIcon Icon="help" Style="color: var(--rz-info);" />
                            <h5 class="mb-0">Reporting Guidelines</h5>
                        </div>

                        <div>
                            <h6>What to Report:</h6>
                            <RadzenStack Gap="0.25rem">
                                <div><RadzenIcon Icon="check" Style="color: var(--rz-success);" /> Actual incidents or accidents</div>
                                <div><RadzenIcon Icon="check" Style="color: var(--rz-success);" /> Near-miss events</div>
                                <div><RadzenIcon Icon="check" Style="color: var(--rz-success);" /> Unsafe conditions</div>
                                <div><RadzenIcon Icon="check" Style="color: var(--rz-success);" /> Equipment malfunctions</div>
                                <div><RadzenIcon Icon="check" Style="color: var(--rz-success);" /> Procedural violations</div>
                                <div><RadzenIcon Icon="check" Style="color: var(--rz-success);" /> Security concerns</div>
                                <div><RadzenIcon Icon="check" Style="color: var(--rz-success);" /> Environmental hazards</div>
                            </RadzenStack>
                        </div>

                        <div>
                            <h6>Confidential Reporting:</h6>
                            <p class="small mb-2">Use confidential reporting when concerned about:</p>
                            <RadzenStack Gap="0.25rem" Class="small">
                                <div><RadzenIcon Icon="security" Style="color: var(--rz-primary);" /> Personal safety or retaliation</div>
                                <div><RadzenIcon Icon="security" Style="color: var(--rz-primary);" /> Sensitive operational information</div>
                                <div><RadzenIcon Icon="security" Style="color: var(--rz-primary);" /> Personnel-related issues</div>
                                <div><RadzenIcon Icon="security" Style="color: var(--rz-primary);" /> Management concerns</div>
                            </RadzenStack>
                        </div>

                        <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small">
                            <h6>Need Help?</h6>
                            <RadzenStack Gap="0.25rem" Class="small">
                                <div><RadzenIcon Icon="phone" /> SMS Team: (503) 555-0100</div>
                                <div><RadzenIcon Icon="email" /> sms@flypdx.com</div>
                                <div><RadzenIcon Icon="schedule" /> 24/7 Emergency Hotline</div>
                            </RadzenStack>
                        </RadzenAlert>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    }
</div>

<style>
    .report-create-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem;
    }
</style>