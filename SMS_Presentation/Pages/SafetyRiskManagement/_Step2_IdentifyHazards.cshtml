@model SMS.Presentation.Pages.SafetyRiskManagement.RiskAssessmentWizardModel

<!-- ENHANCED Step 2: Hazard Identification -->

<!-- System Context from Step 1 -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="fas fa-sitemap"></i> System Context (From Step 1)</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-2"><strong>System:</strong> @Model.Step1.SystemDescription</p>
                        <p class="mb-0"><strong>Boundaries:</strong> @Model.Step1.SystemBoundaries</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-2"><strong>Purpose:</strong> @Model.Step1.SystemPurpose</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Existing Hazards Display - FIRST AS REQUESTED -->
@if (Model.ReportHazards?.Any() == true)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0">
                        <i class="fas fa-list"></i> Identified Hazards
                        <span class="badge bg-light text-dark ms-2">@Model.ReportHazards.Count</span>
                    </h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Hazard ID</th>
                                    <th>Description</th>
                                    <th>Category</th>
                                    <th>5M Component</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.ReportHazards.Count; i++)
                                {
                                    var hazard = Model.ReportHazards[i];
                                    <tr>
                                        <td><span class="badge bg-primary">@hazard.Code</span></td>
                                        <td>@hazard.Description</td>
                                        <td><span class="badge bg-secondary">@(hazard.Category ?? "Not specified")</span></td>
                                        <td><span class="badge bg-warning">@(hazard.FiveMComponent?.Name ?? "Not specified")</span></td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-primary" 
                                                    data-bs-toggle="modal" data-bs-target="#editHazardModal"
                                                    onclick="editHazard('@hazard.Code', '@Html.Raw(hazard.Description?.Replace("'", "\\'").Replace("\"", "&quot;").Replace("\r", "").Replace("\n", " "))', '@(hazard.Category ?? "")', '@(hazard.FiveMComponent?.Value ?? "")')"
                                                    title="Edit hazard @hazard.Code">
                                                <i class="fas fa-edit"></i> Edit
                                            </button>
                                            @* Debug info - Remove this after testing *@
                                            <small class="d-block text-muted">ID: @hazard.Code</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Add New Hazard Form - SECOND AS REQUESTED -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h6 class="mb-0"><i class="fas fa-plus-circle"></i> Add New Hazard</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label">Hazard Description <span class="text-danger">*</span></label>
                            <textarea class="form-control" name="newHazardDescription" rows="3" 
                                      placeholder="Describe the hazard clearly and specifically..."></textarea>
                            <div class="form-text">Be specific about the hazardous condition, not just the potential outcome</div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Hazard Category</label>
                                    <select class="form-select" name="newHazardCategory">
                                        <option value="">Select category...</option>
                                        <option value="Aircraft Operations">Aircraft Operations</option>
                                        <option value="Ground Operations">Ground Operations</option>
                                        <option value="Security Operations">Security Operations</option>
                                        <option value="Weather Related">Weather Related</option>
                                        <option value="Equipment Failure">Equipment Failure</option>
                                        <option value="Human Factors">Human Factors</option>
                                        <option value="Environmental">Environmental</option>
                                        <option value="Procedural">Procedural</option>
                                        <option value="Communication">Communication</option>
                                        <option value="Infrastructure">Infrastructure</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">5M Framework Component</label>
                                    <select class="form-select" name="newHazardFiveM">
                                        <option value="">Select 5M component...</option>
                                        <option value="MAN">Man (Human)</option>
                                        <option value="MACHINE">Machine (Equipment)</option>
                                        <option value="METHOD">Method (Procedures)</option>
                                        <option value="MATERIAL">Material (Resources)</option>
                                        <option value="MILIEU">Milieu (Environment)</option>
                                    </select>
                                    <div class="form-text">Which 5M factor does this hazard relate to?</div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <button type="button" class="btn btn-success" onclick="addNewHazard()">
                                <i class="fas fa-plus"></i> Add Hazard
                            </button>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="card-title"><i class="fas fa-lightbulb text-warning"></i> 5M Framework Guide</h6>
                                <div class="small">
                                    <strong>People:</strong> Personnel qualifications, training, fatigue, workload<br>
                                    <strong>Procedures:</strong> Operating procedures, checklists, documentation<br>
                                    <strong>Equipment:</strong> Tools, machinery, systems, materials<br>
                                    <strong>Resources:</strong> Staffing levels, time constraints, funding<br>
                                    <strong>Environment:</strong> Weather, lighting, noise, workspace design
                                </div>
                                <hr>
                                <div class="small">
                                    <strong>Good descriptions:</strong>
                                    <ul class="mb-0">
                                        <li>"Wet floors in terminal during rain"</li>
                                        <li>"Aircraft engine intake exposed during gate operations"</li>
                                        <li>"Inadequate lighting on taxiway Charlie"</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Hazard Modal -->
<div class="modal fade" id="editHazardModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-edit"></i> Edit Hazard</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Hazard ID</label>
                    <input type="text" class="form-control" id="editHazardId" readonly>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Hazard Description <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="editHazardDescription" rows="3"></textarea>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Category</label>
                            <select class="form-select" id="editHazardCategory">
                                <option value="">Select category...</option>
                                <option value="Aircraft Operations">Aircraft Operations</option>
                                <option value="Ground Operations">Ground Operations</option>
                                <option value="Security Operations">Security Operations</option>
                                <option value="Weather Related">Weather Related</option>
                                <option value="Equipment Failure">Equipment Failure</option>
                                <option value="Human Factors">Human Factors</option>
                                <option value="Environmental">Environmental</option>
                                <option value="Procedural">Procedural</option>
                                <option value="Communication">Communication</option>
                                <option value="Infrastructure">Infrastructure</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">5M Component</label>
                            <select class="form-select" id="editHazardFiveM">
                                <option value="">Select 5M component...</option>
                                <option value="MAN">Man (Human)</option>
                                <option value="MACHINE">Machine (Equipment)</option>
                                <option value="METHOD">Method (Procedures)</option>
                                <option value="MATERIAL">Material (Resources)</option>
                                <option value="MILIEU">Milieu (Environment)</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="updateHazard()">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MINIMAL JavaScript - Only for modal population and onclick handlers -->
<script>
function editHazard(hazardId, description, category, fiveM) {
    // Debug: Log what parameters we received
    console.log('editHazard called with:', {
        hazardId: hazardId,
        description: description,
        category: category,
        fiveM: fiveM
    });

    document.getElementById('editHazardId').value = hazardId;
    document.getElementById('editHazardDescription').value = description;
    document.getElementById('editHazardCategory').value = category;
    document.getElementById('editHazardFiveM').value = fiveM || '';
    
    // Debug: Confirm what was set in the modal
    console.log('Modal populated with:', {
        id: document.getElementById('editHazardId').value,
        description: document.getElementById('editHazardDescription').value,
        category: document.getElementById('editHazardCategory').value,
        fiveM: document.getElementById('editHazardFiveM').value
    });
}

function updateHazard() {
    // Target the main form more specifically
    const form = document.querySelector('form[method="post"]:not([id])');
    if (!form) {
        alert('Form not found');
        return;
    }
    
    // Remove ALL hazard-related hidden inputs from ALL forms to be safe
    document.querySelectorAll('input[type="hidden"]').forEach(input => {
        if (input.name && (input.name.includes('hazard') || input.name.includes('Hazard'))) {
            input.remove();
        }
    });
    
    // Get the hazard ID directly from the modal input
    const currentHazardId = document.getElementById('editHazardId').value;
    if (!currentHazardId) {
        alert('No hazard ID found in modal');
        return;
    }
    
    // Create a temporary form to ensure clean submission
    const tempForm = document.createElement('form');
    tempForm.method = 'post';
    tempForm.action = '?handler=UpdateHazard';
    
    // Add all the necessary hidden inputs
    ['__RequestVerificationToken', 'Id', 'StepNumber', 'HazardId', 'ReportId'].forEach(fieldName => {
        const existing = form.querySelector(`input[name="${fieldName}"]`);
        if (existing) {
            const copy = document.createElement('input');
            copy.type = 'hidden';
            copy.name = fieldName;
            copy.value = existing.value;
            tempForm.appendChild(copy);
        }
    });
    
    // Add the hazard-specific data
    const hazardData = [
        { name: 'hazardId', value: currentHazardId },
        { name: 'hazardDescription', value: document.getElementById('editHazardDescription').value },
        { name: 'hazardCategory', value: document.getElementById('editHazardCategory').value },
        { name: 'hazardFiveM', value: document.getElementById('editHazardFiveM').value }
    ];
    
    hazardData.forEach(data => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = data.name;
        input.value = data.value;
        tempForm.appendChild(input);
    });
    
    // Append to body, submit, then remove
    document.body.appendChild(tempForm);
    tempForm.submit();
}

function addNewHazard() {
    const form = document.querySelector('form[method="post"]');
    
    // CRITICAL: Remove any existing hidden inputs to prevent conflicts
    const existingInputs = form.querySelectorAll('input[name="hazardDescription"], input[name="hazardCategory"], input[name="hazardFiveM"], input[name="hazardId"]');
    existingInputs.forEach(input => input.remove());
    
    // Create hidden inputs for the CreateHazard handler
    const hazardDescription = document.createElement('input');
    hazardDescription.type = 'hidden';
    hazardDescription.name = 'hazardDescription';
    hazardDescription.value = document.querySelector('textarea[name="newHazardDescription"]').value;
    
    const hazardCategory = document.createElement('input');
    hazardCategory.type = 'hidden';
    hazardCategory.name = 'hazardCategory';
    hazardCategory.value = document.querySelector('select[name="newHazardCategory"]').value;
    
    const hazardFiveM = document.createElement('input');
    hazardFiveM.type = 'hidden';
    hazardFiveM.name = 'hazardFiveM';
    hazardFiveM.value = document.querySelector('select[name="newHazardFiveM"]').value;
    
    // Add inputs to form
    form.appendChild(hazardDescription);
    form.appendChild(hazardCategory);
    form.appendChild(hazardFiveM);
    
    // Debug: Log what we're sending
    console.log('Creating new hazard:', {
        description: hazardDescription.value,
        category: hazardCategory.value,
        fiveM: hazardFiveM.value
    });
    
    // Set form action and submit
    form.action = '?handler=CreateHazard';
    form.submit();
}
</script>
