@{
    var hazardCount = Model.AvailableHazards?.Count ?? 0;
    var analyzedCount = Model.Step3.HazardAnalyses?.Count(ha => ha.Value.IsComplete) ?? 0;
    var analysisProgress = hazardCount > 0 ? (analyzedCount * 100) / hazardCount : 0;
}
