@model PDXSMS_Presentation.Pages.SafetyRiskManagement.RiskAssessmentWizardModel
@using ApplicationDto = PDXSMS.UseCases.Queries.RiskAssessmentQueries.IdentifiedHazardDto
@{
    var hazardCount = Model.AssessmentData.IdentifiedHazards?.Count ?? 0;
    var analyzedCount = Model.AssessmentData.IdentifiedHazards?.Count(h => !string.IsNullOrEmpty(h.WorstCredibleOutcome)) ?? 0;
    var analysisProgress = hazardCount > 0 ? (analyzedCount * 100) / hazardCount : 0;
}
@* <div class="row">
    <div class="col-12">
        <div class="alert alert-info">
            <i class="fas fa-chart-line"></i>
            <strong>Step 3 Objective:</strong> Analyze each identified hazard by documenting the worst credible outcome and root causes. 
            The SMS Risk Matrix (5x5) scoring will be completed in Step 4.
        </div>
    </div>
</div> *@

<!-- Risk Analysis Method Display (Fixed to SMS Risk Matrix) -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="fas fa-cogs"></i> Risk Analysis Method</h6>
                    <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="popover" data-bs-placement="left" data-bs-trigger="click" data-bs-html="true" data-bs-title="Risk Analysis Notes & Assumptions - Examples" data-bs-content="<ul class='mb-0'><li>Document any assumptions, criteria, or notes about the risk analysis approach</li><li>Record key assumptions and criteria used in this risk analysis</li><li>Note any limitations or constraints</li><li>Reference relevant standards or guidelines</li><li>Document environmental or operational conditions considered</li></ul>">
                        <i class="fas fa-question-circle"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="d-flex align-items-center">
                            @* <div class="me-3">
                                <i class="fas fa-table fa-2x text-primary"></i>
                            </div> *@
                            <div>
                                @* <h5 class="mb-1">SMS Risk Matrix (5x5)</h5>
                                <p class="mb-0 text-muted">The standard SMS 5x5 risk matrix method for systematic risk analysis</p> *@
                                
                                <!-- Hidden field to maintain the method -->
                                <input type="hidden" asp-for="AssessmentData.RiskAnalysisMethod" value="SMS Risk Matrix" />
                            </div>
                        </div>
                    </div>
                    @* <div class="col-md-4">
                        <div class="card border-info">
                            <div class="card-body text-center p-2">
                                <div class="h6 text-info mb-1">Analysis Progress</div>
                                
                                <div class="h4 text-primary">@analyzedCount / @hazardCount</div>
                                <small>Hazards Analyzed</small>
                                <div class="progress mt-2" style="height: 6px;">
                                    <div class="progress-bar bg-primary" style="width: @analysisProgress%"></div>
                                </div>
                            </div>
                        </div>
                    </div> *@
                </div>
                
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="mb-3">
                            <label class="form-label">Risk Analysis Notes & Assumptions</label>
                            <textarea class="form-control" asp-for="AssessmentData.RiskCriteria" rows="2"></textarea>
                            <div class="form-text">Record key assumptions and criteria used in this risk analysis</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Risk Analysis Form for Each Hazard -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <div class="row align-items-center">
                    <div class="col">
                        <h6 class="mb-0">
                            <i class="fas fa-clipboard-check"></i> Hazard Risk Analysis
                        </h6>
                    </div>
                    <div class="col-auto">
                        <small><i class="fas fa-info-circle"></i> Complete analysis for each hazard below</small>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (Model.AssessmentData.IdentifiedHazards?.Any() == true)
                {
                    <!-- Hidden fields to maintain state -->
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="StepNumber" />

                    @for (int i = 0; i < Model.AssessmentData.IdentifiedHazards.Count; i++)
                    {
                        var hazard = Model.AssessmentData.IdentifiedHazards[i];
                        
                        <!-- Hidden fields to preserve hazard data -->
                        <input type="hidden" name="AssessmentData.IdentifiedHazards[@i].Id" value="@hazard.Id" />
                        <input type="hidden" name="AssessmentData.IdentifiedHazards[@i].Description" value="@hazard.Description" />
                        <input type="hidden" name="AssessmentData.IdentifiedHazards[@i].Category" value="@hazard.Category" />
                        
                        <div class="card border-secondary mb-4">
                            <div class="card-header">
                                <div class="row align-items-center">
                                    <div class="col">
                                        <strong>@hazard.Id: @hazard.Description</strong>
                                        @if (!string.IsNullOrEmpty(hazard.Category))
                                        {
                                            <span class="badge bg-info ms-2">@hazard.Category</span>
                                        }
                                    </div>
                                    <div class="col-auto">
                                        @if (!string.IsNullOrEmpty(hazard.WorstCredibleOutcome))
                                        {
                                            <span class="badge bg-success">Analyzed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pending Analysis</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <!-- Worst Credible Outcome -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Worst Credible Outcome <span class="text-danger">*</span></label>
                                        <textarea class="form-control" name="AssessmentData.IdentifiedHazards[@i].WorstCredibleOutcome" 
                                                  rows="3" required placeholder="Describe the worst reasonable outcome that could result from this hazard...">@hazard.WorstCredibleOutcome</textarea>
                                        <div class="form-text">Focus on the most severe but realistic consequence - what could actually happen?</div>
                                    </div>
                                    
                                    <!-- Root Cause Analysis -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Root Cause Analysis <span class="text-danger">*</span></label>
                                        <textarea class="form-control" name="RootCauses[@i]" rows="3" required
                                                  placeholder="Identify the underlying root causes that could lead to this hazard...">@(Model.RootCauses?.Count > i ? Model.RootCauses[i] : "")</textarea>
                                        <div class="form-text">Identify underlying causes, not just symptoms - ask "why" multiple times</div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <!-- Additional Comments -->
                                    <div class="col-12 mb-3">
                                        <label class="form-label">Additional Analysis Comments</label>
                                        <textarea class="form-control" name="AdditionalComments[@i]" rows="2"
                                                  placeholder="Any additional observations, assumptions, or analysis notes for this hazard...">@(Model.AdditionalComments?.Count > i ? Model.AdditionalComments[i] : "")</textarea>
                                        <div class="form-text">Document any additional context, assumptions, or observations relevant to this hazard</div>
                                    </div>
                                </div>
                                
                                <!-- Analysis Tips -->
                                @* <div class="alert alert-light">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6><i class="fas fa-lightbulb text-warning"></i> Worst Credible Outcome Tips:</h6>
                                            <ul class="small mb-0">
                                                <li>Focus on realistic, not theoretical outcomes</li>
                                                <li>Consider direct and indirect consequences</li>
                                                <li>Include operational, safety, and financial impacts</li>
                                                <li>Think about cascading effects</li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <h6><i class="fas fa-search text-info"></i> Root Cause Analysis Tips:</h6>
                                            <ul class="small mb-0">
                                                <li>Use the "5 Whys" technique</li>
                                                <li>Consider human, technical, and organizational factors</li>
                                                <li>Look beyond immediate causes to system-level issues</li>
                                                <li>Reference your 5M analysis from Step 1</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div> *@
                            </div>
                        </div>
                    }
                    
                    <!-- Progress Summary -->
                    <div class="row mt-4">
                        <div class="col-12">
                           @*  <div class="alert alert-info">
                                <div class="row align-items-center">
                                    <div class="col">
                                        <strong><i class="fas fa-info-circle"></i> Step 3 Focus:</strong> 
                                        Complete the analysis for each hazard above. Risk matrix scoring (Severity × Likelihood) will be performed in Step 4.
                                    </div>
                                    <div class="col-auto">
                                        <div class="badge bg-primary">@analyzedCount of @hazardCount hazards analyzed</div>
                                    </div>
                                </div>
                            </div> *@
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                        <h5>No hazards identified yet</h5>
                        <p>Please complete Step 2 (Identify Hazards) before proceeding with risk analysis.</p>
                        <a href="/SafetyRiskManagement/RiskAssessmentWizard/@Model.Id/step/2" class="btn btn-warning">
                            <i class="fas fa-arrow-left"></i> Go to Step 2
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- SMS Risk Matrix Reference (Informational Only) -->


<script>
// Auto-save functionality for Step 3
let autoSaveTimeout;

function autoSaveStep3() {
    clearTimeout(autoSaveTimeout);
    autoSaveTimeout = setTimeout(() => {
        const assessmentId = '@Model.Id';
        const sessionKey = `Assessment_${assessmentId}_Step3Data`;
        
        // Collect all worst outcomes, root causes, and additional comments
        const worstOutcomes = [];
        const rootCauses = [];
        const additionalComments = [];
        
        const worstOutcomeTextareas = document.querySelectorAll('textarea[name*="WorstCredibleOutcome"]');
        const rootCauseTextareas = document.querySelectorAll('textarea[name*="RootCauses"]');
        const commentTextareas = document.querySelectorAll('textarea[name*="AdditionalComments"]');
        
        worstOutcomeTextareas.forEach(ta => worstOutcomes.push(ta.value));
        rootCauseTextareas.forEach(ta => rootCauses.push(ta.value));
        commentTextareas.forEach(ta => additionalComments.push(ta.value));
        
        const step3Data = {
            worstOutcomes: worstOutcomes,
            rootCauses: rootCauses,
            additionalComments: additionalComments,
            riskCriteria: document.querySelector('textarea[name*="RiskCriteria"]')?.value || '',
            savedAt: new Date().toISOString()
        };
        
        try {
            sessionStorage.setItem(sessionKey, JSON.stringify(step3Data));
            console.log('Auto-saved Step 3 data');
        } catch (error) {
            console.error('Error auto-saving Step 3 data:', error);
        }
    }, 2000);
}

// Load Step 3 data on page load
function loadStep3Data() {
    const assessmentId = '@Model.Id';
    const sessionKey = `Assessment_${assessmentId}_Step3Data`;
    
    try {
        const savedData = sessionStorage.getItem(sessionKey);
        if (savedData) {
            const step3Data = JSON.parse(savedData);
            
            // Restore worst outcomes
            const worstOutcomeTextareas = document.querySelectorAll('textarea[name*="WorstCredibleOutcome"]');
            worstOutcomeTextareas.forEach((ta, index) => {
                if (step3Data.worstOutcomes && step3Data.worstOutcomes[index] && !ta.value) {
                    ta.value = step3Data.worstOutcomes[index];
                }
            });
            
            // Restore root causes
            const rootCauseTextareas = document.querySelectorAll('textarea[name*="RootCauses"]');
            rootCauseTextareas.forEach((ta, index) => {
                if (step3Data.rootCauses && step3Data.rootCauses[index] && !ta.value) {
                    ta.value = step3Data.rootCauses[index];
                }
            });
            
            // Restore additional comments
            const commentTextareas = document.querySelectorAll('textarea[name*="AdditionalComments"]');
            commentTextareas.forEach((ta, index) => {
                if (step3Data.additionalComments && step3Data.additionalComments[index] && !ta.value) {
                    ta.value = step3Data.additionalComments[index];
                }
            });
            
            // Restore risk criteria
            const riskCriteriaTextarea = document.querySelector('textarea[name*="RiskCriteria"]');
            if (riskCriteriaTextarea && step3Data.riskCriteria && !riskCriteriaTextarea.value) {
                riskCriteriaTextarea.value = step3Data.riskCriteria;
            }
            
            console.log('Loaded Step 3 data from session storage');
        }
    } catch (error) {
        console.error('Error loading Step 3 data:', error);
    }
}

// Validation before step progression
function validateStep3() {
    const worstOutcomeTextareas = document.querySelectorAll('textarea[name*="WorstCredibleOutcome"]');
    const rootCauseTextareas = document.querySelectorAll('textarea[name*="RootCauses"]');
    
    let incompleteHazards = [];
    let validationErrors = [];

    worstOutcomeTextareas.forEach((ta, index) => {
        const worstOutcome = ta.value.trim();
        const rootCause = rootCauseTextareas[index]?.value.trim() || '';
        const hazardId = ta.closest('.card').querySelector('strong').textContent.split(':')[0];
        
        // Check if fields are empty
        if (!worstOutcome || !rootCause) {
            incompleteHazards.push(hazardId);
        }
        
        // Check minimum length requirements (10 characters)
        if (worstOutcome && worstOutcome.length < 10) {
            validationErrors.push(`${hazardId}: Worst Credible Outcome must be at least 10 characters (currently ${worstOutcome.length})`);
        }
        
        if (rootCause && rootCause.length < 10) {
            validationErrors.push(`${hazardId}: Root Cause Analysis must be at least 10 characters (currently ${rootCause.length})`);
        }
    });
    
    // Show validation errors
    if (incompleteHazards.length > 0) {
        alert(`Please complete the risk analysis for the following hazards:\n\n${incompleteHazards.join(', ')}\n\nBoth "Worst Credible Outcome" and "Root Cause Analysis" are required for each hazard.`);
        return false;
    }
    
    if (validationErrors.length > 0) {
        alert(`Please provide more detailed analysis:\n\n${validationErrors.join('\n')}\n\nBoth fields require at least 10 characters for meaningful analysis.`);
        return false;
    }
    
    return true;
}

// Real-time validation feedback
function addRealTimeValidation() {
    const requiredTextareas = document.querySelectorAll('textarea[name*="WorstCredibleOutcome"], textarea[name*="RootCauses"]');
    
    requiredTextareas.forEach(textarea => {
        // Add character counter
        const formText = textarea.nextElementSibling;
        const counter = document.createElement('small');
        counter.className = 'text-muted ms-2';
        counter.style.fontSize = '0.75em';
        formText.parentNode.insertBefore(counter, formText.nextSibling);
        
        function updateValidation() {
            const length = textarea.value.trim().length;
            const minLength = 10;
            
            // Update counter
            counter.textContent = `${length}/${minLength} characters`;
            
            // Update styling based on validation
            if (length === 0) {
                textarea.classList.remove('is-valid', 'is-invalid');
                counter.className = 'text-muted ms-2';
            } else if (length < minLength) {
                textarea.classList.remove('is-valid');
                textarea.classList.add('is-invalid');
                counter.className = 'text-danger ms-2';
                counter.textContent = `${length}/${minLength} characters (minimum ${minLength} required)`;
            } else {
                textarea.classList.remove('is-invalid');
                textarea.classList.add('is-valid');
                counter.className = 'text-success ms-2';
                counter.textContent = `${length} characters ?`;
            }
        }
        
        // Initial validation
        updateValidation();
        
        // Add event listeners
        textarea.addEventListener('input', updateValidation);
        textarea.addEventListener('blur', updateValidation);
    });
}

// Initialize page
document.addEventListener('DOMContentLoaded', function() {
    // Load saved data
    loadStep3Data();
    
    // Initialize Bootstrap popovers
    initializeStep3Popovers();
    
    // Add real-time validation with character counters
    addRealTimeValidation();
    
    // Add auto-save listeners
    const textareas = document.querySelectorAll('textarea');
    textareas.forEach(textarea => {
        textarea.addEventListener('input', autoSaveStep3);
    });
    
    // Hook into form submission for validation
    const form = document.querySelector('form');
    if (form) {
        form.addEventListener('submit', function(e) {
            const submitButton = document.activeElement;
            
            // Only validate for Next Step button, not Save Draft
            if (submitButton && submitButton.textContent.includes('Next Step')) {
                if (!validateStep3()) {
                    e.preventDefault();
                    return false;
                }
            }
        });
    }
});

// ===================================================
// BOOTSTRAP POPOVERS INITIALIZATION FOR STEP 3
// ===================================================

function initializeStep3Popovers() {
    // Initialize all popovers
    var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
    var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
        return new bootstrap.Popover(popoverTriggerEl, {
            container: 'body',
            sanitize: false,
            customClass: 'step3-help-popover'
        });
    });
    
    // Close other popovers when one is opened
    popoverTriggerList.forEach(function(popoverTriggerEl) {
        popoverTriggerEl.addEventListener('show.bs.popover', function () {
            // Hide all other popovers
            popoverList.forEach(function(popoverInstance) {
                if (popoverInstance._element !== popoverTriggerEl) {
                    popoverInstance.hide();
                }
            });
        });
    });
    
    // Close popover when clicking outside
    document.addEventListener('click', function (e) {
        var isPopoverButton = e.target.closest('[data-bs-toggle="popover"]');
        var isPopoverContent = e.target.closest('.popover');
        
        if (!isPopoverButton && !isPopoverContent) {
            popoverList.forEach(function(popoverInstance) {
                popoverInstance.hide();
            });
        }
    });
}
</script>

<style>
.risk-matrix td, .risk-matrix th {
    padding: 8px;
    font-size: 0.85em;
    min-width: 80px;
}

.card-header strong {
    font-size: 1.1em;
}

.badge {
    font-size: 0.8em;
}

textarea.form-control:focus {
    border-color: #0d6efd;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
}

/* Step 3 Help Popover Styling */
.step3-help-popover {
    max-width: 350px;
}

.step3-help-popover .popover-header {
    background-color: #f8f9fa;
    border-bottom: 1px solid #dee2e6;
    font-weight: 600;
    font-size: 0.875rem;
}

.step3-help-popover .popover-body {
    font-size: 0.8rem;
    padding: 0.75rem;
}

.step3-help-popover .popover-body ul {
    margin-bottom: 0;
    padding-left: 1.2rem;
}

.step3-help-popover .popover-body li {
    margin-bottom: 0.25rem;
    line-height: 1.4;
}

/* Help button hover effect */
.card-header .btn-outline-light:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.3);
}

/* Ensure popovers appear above other elements */
.popover {
    z-index: 1060;
}
</style>
