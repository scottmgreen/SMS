<!-- Risk Analysis Form for Each Hazard -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <div class="row align-items-center">
                    <div class="col">
                        <h6 class="mb-0">
                            <i class="fas fa-clipboard-check"></i> Hazard Risk Analysis
                        </h6>
                    </div>
                    <div class="col-auto">
                        <small><i class="fas fa-info-circle"></i> Complete analysis for each hazard below</small>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (Model.AvailableHazards?.Any() == true)
                {
                    <!-- Hidden fields to maintain state -->
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="StepNumber" />

                    @for (int i = 0; i < Model.AvailableHazards.Count; i++)
                    {
                        var hazard = Model.AvailableHazards[i];
                        var hazardAnalysis = Model.Step3.GetHazardAnalysis(hazard.Code);
                        
                        <!-- Hidden fields to preserve hazard data -->
                        <input type="hidden" name="Step3.HazardAnalyses[@hazard.Code].HazardId" value="@hazard.Code" />
                        <input type="hidden" name="Step3.HazardAnalyses[@hazard.Code].HazardDescription" value="@hazard.Description" />
                        <input type="hidden" name="Step3.HazardAnalyses[@hazard.Code].HazardCategory" value="@hazard.HazardType" />
                        
                        <div class="card border-secondary mb-4">
                            <div class="card-header">
                                <div class="row align-items-center">
                                    <div class="col">
                                        <strong>@hazard.Code: @hazard.Description</strong>
                                        @if (!string.IsNullOrEmpty(hazard.HazardType))
                                        {
                                            <span class="badge bg-info ms-2">@hazard.HazardType</span>
                                        }
                                    </div>
                                    <div class="col-auto">
                                        @if (!string.IsNullOrEmpty(hazardAnalysis.WorstCredibleOutcome))
                                        {
                                            <span class="badge bg-success">Analyzed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pending Analysis</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <!-- Worst Credible Outcome -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Worst Credible Outcome <span class="text-danger">*</span></label>
                                        <textarea class="form-control" name="Step3.HazardAnalyses[@hazard.Code].WorstCredibleOutcome" 
                                                  rows="3" required placeholder="Describe the worst reasonable outcome that could result from this hazard...">@hazardAnalysis.WorstCredibleOutcome</textarea>
                                        <div class="form-text">Focus on the most severe but realistic consequence - what could actually happen?</div>
                                    </div>
                                    
                                    <!-- Root Cause Analysis -->
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Root Cause Analysis <span class="text-danger">*</span></label>
                                        <textarea class="form-control" name="Step3.HazardAnalyses[@hazard.Code].RootCauseAnalysis" rows="3" required
                                          placeholder="Identify the underlying root causes that could lead to this hazard...">@hazardAnalysis.RootCauseAnalysis</textarea>
                                        <div class="form-text">Identify underlying causes, not just symptoms - ask "why" multiple times</div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <!-- Additional Comments -->
                                    <div class="col-12 mb-3">
                                        <label class="form-label">Additional Analysis Comments</label>
                                        <textarea class="form-control" name="Step3.HazardAnalyses[@hazard.Code].AdditionalComments" rows="2">@hazardAnalysis.AdditionalComments</textarea>
                                        <div class="form-text">Document any additional context, assumptions, or observations relevant to this hazard</div>
                                    </div>
                                </div>
                                
                                <!-- Analysis Tips -->
                                @* <div class="alert alert-light">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6><i class="fas fa-lightbulb text-warning"></i> Worst Credible Outcome Tips:</h6>
                                            <ul class="small mb-0">
                                                <li>Focus on realistic, not theoretical outcomes</li>
                                                <li>Consider direct and indirect consequences</li>
                                                <li>Include operational, safety, and financial impacts</li>
                                                <li>Think about cascading effects</li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <h6><i class="fas fa-search text-info"></i> Root Cause Analysis Tips:</h6>
                                            <ul class="small mb-0">
                                                <li>Use the "5 Whys" technique</li>
                                                <li>Consider human, technical, and organizational factors</li>
                                                <li>Look beyond immediate causes to system-level issues</li>
                                                <li>Reference your 5M analysis from Step 1</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div> *@
                            </div>
                        </div>
                    }
                    
                    <!-- Progress Summary -->
                    <div class="row mt-4">
                        <div class="col-12">
                           @*  <div class="alert alert-info">
                                <div class="row align-items-center">
                                    <div class="col">
                                        <strong><i class="fas fa-info-circle"></i> Step 3 Focus:</strong> 
                                        Complete the analysis for each hazard above. Risk matrix scoring (Severity × Likelihood) will be performed in Step 4.
                                    </div>
                                    <div class="col-auto">
                                        <div class="badge bg-primary">@analyzedCount of @hazardCount hazards analyzed</div>
                                    </div>
                                </div>
                            </div> *@
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                        <h5>No hazards identified yet</h5>
                        <p>Please complete Step 2 (Identify Hazards) before proceeding with risk analysis.</p>
                        <a href="/SafetyRiskManagement/RiskAssessmentWizard/@Model.Id/step/2" class="btn btn-warning">
                            <i class="fas fa-arrow-left"></i> Go to Step 2
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- SMS Risk Matrix Reference (Informational Only) -->


<script>
// SIMPLIFIED Step 3 JavaScript - Server-Side Logic Focused
// Most validation and auto-save logic moved to C# Step3Model

let autoSaveTimeout;
let validationStatusCache = {};

// ===================================================
// AUTO-SAVE (AJAX calls to server-side handlers)
// ===================================================

function autoSaveStep3() {
    clearTimeout(autoSaveTimeout);
    autoSaveTimeout = setTimeout(async () => {
        try {
            const formData = new FormData();
            
            // Collect all form data
            const textareas = document.querySelectorAll('textarea[name*="Step3.HazardAnalyses"], textarea[name*="RiskCriteria"]');
            textareas.forEach(ta => {
                if (ta.name && ta.value) {
                    formData.append(ta.name, ta.value);
                }
            });
            
            // Add anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) formData.append('__RequestVerificationToken', token.value);
            
            formData.append('Id', '@Model.Id');
            
            // Call server-side auto-save
            const response = await fetch('/SafetyRiskManagement/RiskAssessmentWizard?handler=AutoSaveStep3', {
                method: 'POST',
                body: formData
            });
            
            if (response.ok) {
                const result = await response.json();
                if (result.success) {
                    console.log(`Auto-saved at ${result.savedAt}`);
                    updateAutoSaveStatus('? Auto-saved', 'text-success');
                } else {
                    console.error('Auto-save failed:', result.message);
                    updateAutoSaveStatus('? Auto-save failed', 'text-warning');
                }
            }
        } catch (error) {
            console.error('Auto-save error:', error);
            updateAutoSaveStatus('? Auto-save failed', 'text-danger');
        }
    }, 3000); // 3 second delay
}

function updateAutoSaveStatus(message, cssClass) {
    let statusEl = document.getElementById('autoSaveStatus');
    if (!statusEl) {
        // Create status indicator if it doesn't exist
        statusEl = document.createElement('small');
        statusEl.id = 'autoSaveStatus';
        statusEl.className = 'ms-2';
        
        const header = document.querySelector('.card-header h6');
        if (header) header.appendChild(statusEl);
    }
    
    statusEl.textContent = message;
    statusEl.className = `ms-2 ${cssClass}`;
    
    // Clear status after 3 seconds
    setTimeout(() => {
        statusEl.textContent = '';
        statusEl.className = 'ms-2';
    }, 3000);
}

// ===================================================
// REAL-TIME VALIDATION (Client-side UI feedback)
// ===================================================

function addRealTimeValidation() {
    const requiredTextareas = document.querySelectorAll('textarea[name*="WorstCredibleOutcome"], textarea[name*="RootCauseAnalysis"]');
    
    requiredTextareas.forEach(textarea => {
        // Add character counter
        const formText = textarea.closest('.mb-3').querySelector('.form-text');
        if (!formText) return;
        
        const counter = document.createElement('small');
        counter.className = 'text-muted ms-2 character-counter';
        counter.style.fontSize = '0.75em';
        formText.appendChild(counter);
        
        function updateValidation() {
            const length = textarea.value.trim().length;
            const minLength = 10;
            
            // Update counter
            counter.textContent = `${length}/${minLength} characters`;
            
            // Update styling based on validation
            textarea.classList.remove('is-valid', 'is-invalid');
            
            if (length === 0) {
                counter.className = 'text-muted ms-2 character-counter';
            } else if (length < minLength) {
                textarea.classList.add('is-invalid');
                counter.className = 'text-danger ms-2 character-counter';
                counter.textContent = `${length}/${minLength} characters (minimum ${minLength} required)`;
}}}
