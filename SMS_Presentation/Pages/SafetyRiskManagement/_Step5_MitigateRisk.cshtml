// 🔧 MISSING FUNCTION: Assign residual panel
async function assignResidualPanel() {
    if (!currentResidualHazardId) {
        alert('No hazard selected.');
        return;
    }
    
    const selectedUsers = [];
    const checkboxes = document.querySelectorAll('.residual-sms-user-checkbox:checked');
    
    checkboxes.forEach(cb => {
        selectedUsers.push({
            id: cb.value,
            name: cb.getAttribute('data-user-name') || 'Unknown'
        });
    });
    
    if (selectedUsers.length === 0) {
        alert('Please select at least one SMS user for the residual risk panel.');
        return;
    }
    
    console.log('Assigning ' + selectedUsers.length + ' users to residual panel for ' + currentResidualHazardId);
    
    try {
        // Show loading state
        const button = document.querySelector('#residualScoringPanelModal .btn-info');
        if (button) {
            const originalText = button.innerHTML;
            button.disabled = true;
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating Panel...';
        }
        
        // Send to server with "residual-" prefix
        const success = await assignResidualPanelOnServer(currentResidualHazardId, selectedUsers);
        
        if (success) {
            // Show success message
            const userNames = selectedUsers.map(u => u.name).join(', ');
            alert('✅ Successfully assigned ' + selectedUsers.length + ' users to residual risk panel for ' + currentResidualHazardId + ':\n\n' + userNames + '\n\nThe page will refresh to show the updated panel.');
            
            // Close modal
            const modalElement = document.getElementById('residualScoringPanelModal');
            if (modalElement) {
                const modal = bootstrap.Modal.getInstance(modalElement);
                if (modal) modal.hide();
            }
            
            // Refresh to the same Step 5 page
            setTimeout(() => {
                const currentUrl = new URL(window.location);
                const assessmentId = currentUrl.pathname.split('/')[3];
                const step5Url = `/SafetyRiskManagement/RiskAssessmentWizard/${assessmentId}/step/5`;
                console.log('🔄 Refreshing to Step 5 URL: ' + step5Url);
                window.location.href = step5Url;
            }, 1500);
        } else {
            alert('Failed to update residual panel. Please try again.');
        }
        
        // Restore button
        if (button) {
            button.disabled = false;
            button.innerHTML = '<i class="fas fa-users"></i> Update Residual Panel';
        }
        
    } catch (error) {
        console.error('💥 Error in assignResidualPanel:', error);
        alert('Error updating residual panel. Please try again.\n\nError: ' + error.message);
    }
}

// 🔧 MISSING FUNCTION: Assign residual panel members on server
async function assignResidualPanelOnServer(hazardId, selectedUsers) {
    console.log('🔧 STARTING assignResidualPanelOnServer');
    console.log('🔧 Input: hazardId=' + hazardId + ', userCount=' + selectedUsers.length);
    
    try {
        const assessmentIdField = document.querySelector('input[name="Id"]');
        const tokenField = document.querySelector('input[name="__RequestVerificationToken"]');
        
        if (!assessmentIdField || !tokenField) {
            throw new Error('Form fields not found');
        }
        
        const assessmentId = assessmentIdField.value;
        const userIds = selectedUsers.map(function(u) { return u.id; }).join(',');
        
        const formData = new FormData();
        formData.append('hazardId', 'residual-' + hazardId);
        formData.append('userIds', userIds);
        formData.append('Id', assessmentId);
        formData.append('StepNumber', '5');
        formData.append('__RequestVerificationToken', tokenField.value);
        
        const requestUrl = window.location.pathname + '?handler=AssignScoringPanel';
        console.log('🔧 Making POST request to: ' + requestUrl);
        console.log('🔧 Request payload: hazardId=residual-' + hazardId + ', StepNumber=5, Users=' + userIds);
        
        const response = await fetch(requestUrl, {
            method: 'POST',
            body: formData
        });
        
        console.log('🔧 Server response received: status=' + response.status + ', ok=' + response.ok);
        
        if (response.ok) {
            const contentType = response.headers.get('content-type');
            if (contentType && contentType.includes('application/json')) {
                const result = await response.json();
                console.log('✅ JSON response data:', result);
                
                if (result.success) {
                    console.log('✅ Residual panel assignment confirmed successful by server');
                    return true;
                } else {
                    console.error('❌ Server reported failure: ' + (result.message || 'Unknown error'));
                    return false;
                }
            } else {
                console.log('✅ Non-JSON response, assuming success');
                return true;
            }
        } else {
            const errorText = await response.text();
            console.error('❌ Server error response: status=' + response.status + ', error=' + errorText.substring(0, 500));
            throw new Error('Server error: ' + response.status + ' - ' + response.statusText);
        }
        
    } catch (error) {
        console.error('💥 Error in assignResidualPanelOnServer:', error);
        return false;
    }
}

