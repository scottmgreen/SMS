@model SMS.Presentation.Pages.SafetyRiskManagement.RiskAssessmentWizardModel

@{
    // Calculate all hazard states once at the top
    var allHazards = Model.AssessmentData?.IdentifiedHazards ?? new List<RiskAssessmentWizardModel.IdentifiedHazardDto>();
    var assessedHazards = allHazards.Where(h => !string.IsNullOrEmpty(h.Tolerability) || 
                                               !string.IsNullOrEmpty(h.RiskLevel) || 
                                               (!string.IsNullOrEmpty(h.Severity) && !string.IsNullOrEmpty(h.Likelihood))).ToList();
    var requiresMitigation = assessedHazards.Where(h => h.Tolerability == "ALARP" || h.Tolerability == "Unacceptable" || string.IsNullOrEmpty(h.Tolerability)).ToList();
    // 🔧 CRITICAL FIX: Check both ProposedMitigations AND SavedMitigationStrategies for existing mitigation
    var hasMitigations = requiresMitigation.Where(h => 
        (h.ProposedMitigations?.Any() == true) || 
        (Model.SavedMitigationStrategies?.ContainsKey(h.Id) == true && Model.SavedMitigationStrategies[h.Id]?.Any() == true)
    ).ToList();
    var requiresCount = requiresMitigation.Count();
    var mitigatedCount = hasMitigations.Count();
    var mitigationProgress = requiresCount > 0 ? (mitigatedCount * 100) / requiresCount : 100;
}

<div class="row">
    <div class="col-12">
        <!-- Header with Implementation Planning -->
        <div class="card border-primary mb-4">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-shield-alt"></i> Step 5: Risk Mitigation & Residual Assessment
                    </h5>
                    <div>
                        <span class="badge bg-light text-dark">
                            @requiresCount Need Mitigation
                        </span>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <p class="mb-3">
                    Develop mitigation strategies for hazards requiring risk reduction, then assess residual risk levels after mitigation implementation.
                </p>
                
                <!-- Implementation Planning -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Implementation Strategy</label>
                            <select class="form-select" asp-for="AssessmentData.ImplementationPlan">
                                <option value="">Select strategy...</option>
                                <option value="Immediate" selected="@(Model.SavedImplementationStrategy == "Immediate" ? "selected" : null)">Immediate Implementation</option>
                                <option value="Phased" selected="@(Model.SavedImplementationStrategy == "Phased" ? "selected" : null)">Phased Implementation</option>
                                <option value="Risk-Based" selected="@(Model.SavedImplementationStrategy == "Risk-Based" ? "selected" : null)">Risk-Based Priority</option>
                                <option value="Resource-Based" selected="@(Model.SavedImplementationStrategy == "Resource-Based" ? "selected" : null)">Resource-Based Priority</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Overall Timeline</label>
                            <input type="date" class="form-control" name="OverallTargetDate" 
                                   value="@(string.IsNullOrEmpty(Model.SavedOverallTargetDate) ? DateTime.Now.AddMonths(6).ToString("yyyy-MM-dd") : DateTime.Parse(Model.SavedOverallTargetDate).ToString("yyyy-MM-dd"))">
                            <div class="form-text">Target completion for all mitigation strategies</div>
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-12">
                        <div class="mb-3">
                            <label class="form-label">Implementation Notes</label>
                            <textarea class="form-control" name="ImplementationNotes" rows="2" 
                                      placeholder="Document overall implementation approach, resource requirements, and coordination notes...">@Model.SavedImplementationNotes</textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hidden fields for form binding -->
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="StepNumber" value="@Model.StepNumber" />
        @Html.AntiForgeryToken()

        @if (assessedHazards.Any())
        {
            @foreach (var hazard in assessedHazards)
            {
                var originalIndex = allHazards.IndexOf(hazard);
                var riskClass = Model.GetRiskLevelClass(hazard.RiskLevel ?? "");
                var needsMitigation = hazard.Tolerability == "ALARP" || hazard.Tolerability == "Unacceptable";
                
                // 🔧 CRITICAL FIX: Check if this hazard already has mitigation strategies (from ProposedMitigations OR SavedMitigationStrategies)
                var hasSavedStrategies = Model.SavedMitigationStrategies?.ContainsKey(hazard.Id) == true && 
                                        Model.SavedMitigationStrategies[hazard.Id]?.Any() == true;
                var hasProposedMitigations = hazard.ProposedMitigations?.Any() == true;
                var hasMitigationStrategies = hasSavedStrategies || hasProposedMitigations;
                
                // Hidden fields to preserve hazard data
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].Id" value="@hazard.Id" />
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].Description" value="@hazard.Description" />
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].Category" value="@hazard.Category" />
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].WorstCredibleOutcome" value="@hazard.WorstCredibleOutcome" />
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].Severity" value="@hazard.Severity" />
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].Likelihood" value="@hazard.Likelihood" />
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].RiskLevel" value="@hazard.RiskLevel" />
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].Tolerability" value="@hazard.Tolerability" />
                
                <div class="card border-@(needsMitigation ? (hasMitigationStrategies ? "info" : "warning") : "success") mb-4" data-hazard-index="@originalIndex">
                    <div class="card-header bg-@(needsMitigation ? (hasMitigationStrategies ? "info" : "warning") : "success") @(needsMitigation && !hasMitigationStrategies ? "text-dark" : "text-white")">
                        <div class="row align-items-center">
                            <div class="col">
                                <h5 class="mb-0">
                                    <strong>@hazard.Id: @hazard.Description</strong>
                                </h5>
                                @if (!string.IsNullOrEmpty(hazard.RiskLevel))
                                {
                                    <span class="badge bg-@riskClass ms-2">Initial: @hazard.RiskLevel</span>
                                }
                                @if (!string.IsNullOrEmpty(hazard.Tolerability))
                                {
                                    <span class="badge bg-secondary ms-1">@hazard.Tolerability</span>
                                }
                            </div>
                            <div class="col-auto" data-hazard-status="@originalIndex">
                                @if (needsMitigation)
                                {
                                    @if (hasMitigationStrategies)
                                    {
                                        <i class="fas fa-shield-alt"></i> <strong>Mitigation Strategies Defined</strong>
                                        <br><small>@(Model.SavedMitigationStrategies?.GetValueOrDefault(hazard.Id)?.Count ?? hazard.ProposedMitigations?.Count ?? 0) strategies loaded</small>
                                    }
                                    else
                                    {
                                        <i class="fas fa-exclamation-triangle"></i> <strong>Mitigation Required</strong>
                                    }
                                }
                                else
                                {
                                    <i class="fas fa-check-circle"></i> <strong>Monitor Only</strong>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (needsMitigation)
                        {
                            <!-- Mitigation Strategies Section -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h6><i class="fas fa-lightbulb text-warning"></i> Mitigation Strategies</h6>
                                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="addMitigationStrategy(@originalIndex)">
                                            <i class="fas fa-plus"></i> Add Mitigation Strategy
                                        </button>
                                    </div>
                                    <div id="mitigationsList@(originalIndex)">
                                        <div class="alert alert-info">
                                            <i class="fas fa-plus-circle"></i>
                                            <strong>Add mitigation strategies above.</strong> Each strategy can include cost estimates, priorities, and department assignments.
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Residual Risk Assessment Section -->
                            <div class="residual-risk-section" id="residualRisk@(originalIndex)" style="display: @(hasMitigationStrategies ? "block" : "none");">
                                <div class="card border-info">
                                    <div class="card-header bg-info text-white">
                                        <div class="row align-items-center">
                                            <div class="col">
                                                <h6 class="mb-0"><i class="fas fa-calculator"></i> Residual Risk Assessment</h6>
                                            </div>
                                            <div class="col-auto">
                                                <button type="button" class="btn btn-info btn-sm" 
                                                        data-bs-toggle="modal" data-bs-target="#residualScoringPanelModal" 
                                                        onclick="setCurrentResidualHazard('@hazard.Id', '@hazard.Description', @originalIndex)">
                                                    <i class="fas fa-users"></i> Manage Residual Panel
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        @{
                                            // Check if this hazard has a residual scoring panel assigned
                                            var residualHazardId = "residual-" + hazard.Id;
                                            var residualPanelMembers = Model.HazardPanelMembers?.ContainsKey(residualHazardId) == true 
                                                ? Model.HazardPanelMembers[residualHazardId] 
                                                : new List<string>();
                                            var residualScores = Model.PanelScores?.ContainsKey(residualHazardId) == true 
                                                ? Model.PanelScores[residualHazardId] 
                                                : new List<RiskAssessmentWizardModel.PanelMemberScoreData>();
                                            var residualAverageScore = Model.HazardAverageScores?.ContainsKey(residualHazardId) == true 
                                                ? (double?)Model.HazardAverageScores[residualHazardId] 
                                                : null;
                                            var completedResidualScores = residualScores.Count(s => s.IsComplete);
                                        }
                                        
                                        @if (hasMitigationStrategies)
                                        {
                                            <p><i class="fas fa-info-circle text-info"></i> <strong>Mitigation strategies loaded.</strong> Assign a panel to assess residual risk after mitigation implementation.</p>
                                            
                                            @if (residualPanelMembers.Any())
                                            {
                                                <p><i class="fas fa-users text-success"></i> <strong>Residual Risk Panel Assigned:</strong> @residualPanelMembers.Count panel members ready to assess residual risk after mitigation.</p>
                                                
                                                <!-- Residual Risk Scoring Table -->
                                                <div class="table-responsive mt-3">
                                                    <table class="table table-bordered table-sm">
                                                        <thead class="table-info">
                                                            <tr>
                                                                <th width="25%">
                                                                    <i class="fas fa-user"></i> Panel Member
                                                                </th>
                                                                <th width="20%" class="text-center">
                                                                    <i class="fas fa-exclamation-circle"></i> Residual Severity
                                                                </th>
                                                                <th width="20%" class="text-center">
                                                                    <i class="fas fa-clock"></i> Residual Likelihood
                                                                </th>
                                                                <th width="15%" class="text-center">
                                                                    <i class="fas fa-calculator"></i> Residual Score
                                                                </th>
                                                                <th width="20%" class="text-center">
                                                                    <i class="fas fa-save"></i> Action
                                                                </th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var panelistId in residualPanelMembers)
                                                            {
                                                                var panelist = Model.AvailableSMSUsers?.FirstOrDefault(u => u.Id.Value == panelistId);
                                                                if (panelist != null)
                                                                {
                                                                    var memberScore = residualScores.FirstOrDefault(s => s.MemberId == panelistId);
                                                                    var isCompleted = memberScore?.IsComplete == true;
                                                                    var rowId = $"residual-scoring-row-{hazard.Id}-{panelistId}";
                                                                    
                                                                    <tr id="@rowId" class="residual-scoring-row @(isCompleted ? "table-success" : "table-light")" 
                                                                        data-member-id="@panelistId" data-hazard-id="@residualHazardId">
                                                                        <!-- Panel Member Info -->
                                                                        <td>
                                                                            <div class="d-flex align-items-center">
                                                                                <div class="me-2">
                                                                                    <i class="fas fa-user-shield text-info"></i>
                                                                                </div>
                                                                                <div>
                                                                                    <strong class="small">@(panelist.UserName.Value ?? panelist.Id.Value)</strong><br>
                                                                                    <small class="text-muted">@(panelist.ApplicationRole ?? "SMS Employee")</small><br>
                                                                                    @if (isCompleted)
                                                                                    {
                                                                                        <span class="badge bg-success mt-1">
                                                                                            <i class="fas fa-check"></i> Scored
                                                                                        </span>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="badge bg-warning mt-1">
                                                                                            <i class="fas fa-clock"></i> Pending
                                                                                        </span>
                                                                                    }
                                                                                </div>
                                                                            </div>
                                                                        </td>
                                                                        
                                                                        @if (isCompleted)
                                                                        {
                                                                            <!-- Show completed residual scoring (read-only) -->
                                                                            <td class="text-center align-middle">
                                                                                <div class="badge bg-info fs-6 p-2">
                                                                                    @memberScore.SeverityScore
                                                                                </div>
                                                                                <br><small class="text-muted mt-1">
                                                                                    @(memberScore.SeverityScore switch {
                                                                                        1 => "Minor",
                                                                                        2 => "Moderate", 
                                                                                        3 => "Serious",
                                                                                        4 => "Major",
                                                                                        5 => "Catastrophic",
                                                                                        _ => "Unknown"
                                                                                    })
                                                                                </small>
                                                                            </td>
                                                                            <td class="text-center align-middle">
                                                                                <div class="badge bg-info fs-6 p-2">
                                                                                    @memberScore.LikelihoodScore
                                                                                </div>
                                                                                <br><small class="text-muted mt-1">
                                                                                    @(memberScore.LikelihoodScore switch {
                                                                                        1 => "Rare",
                                                                                        2 => "Unlikely",
                                                                                        3 => "Possible", 
                                                                                        4 => "Likely",
                                                                                        5 => "Frequent",
                                                                                        _ => "Unknown"
                                                                                    })
                                                                                </small>
                                                                            </td>
                                                                            <td class="text-center align-middle">
                                                                                <div class="badge bg-success fs-5 p-2">
                                                                                    @memberScore.CalculatedScore.ToString("F1")
                                                                                </div>
                                                                            </td>
                                                                            <td class="text-center align-middle">
                                                                                <button type="button" class="btn btn-outline-secondary btn-sm" 
                                                                                        onclick="editResidualScore('@panelistId', '@residualHazardId', @memberScore.SeverityScore, @memberScore.LikelihoodScore)">
                                                                                    <i class="fas fa-edit"></i> Edit
                                                                                </button>
                                                                            </td>
                                                                        }
                                                                        else
                                                                        {
                                                                            <!-- Show residual risk scoring dropdowns -->
                                                                            <td class="align-middle">
                                                                                <select class="form-select form-select-sm severity-select" 
                                                                                        name="residualSeverityScore" 
                                                                                        onchange="calculateResidualScore('@rowId')" required>
                                                                                    <option value="">Select Severity...</option>
                                                                                    <option value="1">1 - Minor Impact</option>
                                                                                    <option value="2">2 - Moderate Impact</option>
                                                                                    <option value="3">3 - Serious Impact</option>
                                                                                    <option value="4">4 - Major Impact</option>
                                                                                    <option value="5">5 - Catastrophic Impact</option>
                                                                                </select>
                                                                                <small class="text-muted">After mitigation</small>
                                                                            </td>
                                                                            <td class="align-middle">
                                                                                <select class="form-select form-select-sm likelihood-select" 
                                                                                        name="residualLikelihoodScore" 
                                                                                        onchange="calculateResidualScore('@rowId')" required>
                                                                                    <option value="">Select Likelihood...</option>
                                                                                    <option value="1">1 - Rare (A)</option>
                                                                                    <option value="2">2 - Unlikely (B)</option>
                                                                                    <option value="3">3 - Possible (C)</option>
                                                                                    <option value="4">4 - Likely (D)</option>
                                                                                    <option value="5">5 - Frequent (E)</option>
                                                                                </select>
                                                                                <small class="text-muted">After mitigation</small>
                                                                            </td>
                                                                            <td class="text-center align-middle">
                                                                                <div class="score-display badge bg-secondary fs-6 p-2">-</div>
                                                                                <br><small class="text-muted">Auto-calculated</small>
                                                                            </td>
                                                                            <td class="text-center align-middle">
                                                                                <button type="button" class="btn btn-success btn-sm submit-btn" 
                                                                                        onclick="submitResidualScore('@panelistId', '@residualHazardId')" disabled>
                                                                                    <i class="fas fa-save"></i> Submit
                                                                                </button>
                                                                            </td>
                                                                        }
                                                                    </tr>
                                                                }
                                                                else
                                                                {
                                                                    <!-- Missing panelist -->
                                                                    <tr class="table-warning">
                                                                        <td colspan="5">
                                                                            <small class="text-warning">
                                                                                <i class="fas fa-exclamation-triangle"></i>
                                                                                Panelist "@panelistId" not found in SMS user list.
                                                                            </small>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                
                                                <!-- Residual Risk Summary -->
                                                @if (residualAverageScore.HasValue && completedResidualScores > 0)
                                                {
                                                    <div class="alert alert-success mt-2">
                                                        <div class="row align-items-center">
                                                            <div class="col-md-8">
                                                                <h6 class="mb-1">
                                                                    <i class="fas fa-shield-check text-success"></i> 
                                                                    <strong>Residual Risk Assessment Complete</strong>
                                                                </h6>
                                                                <p class="mb-0">
                                                                    <strong>Average Residual Score: @residualAverageScore.Value.ToString("F1")</strong> 
                                                                    (calculated from @completedResidualScores panelist scores)
                                                                </p>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="progress mb-2" style="height: 20px;">
                                                                    <div class="progress-bar bg-success" 
                                                                         style="width: @((completedResidualScores / (double)residualPanelMembers.Count) * 100)%">
                                                                        @completedResidualScores/@residualPanelMembers.Count
                                                                    </div>
                                                                </div>
                                                                <small class="text-muted">Completion Progress</small>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else if (residualPanelMembers.Count > 0)
                                                {
                                                    <div class="alert alert-info mt-2">
                                                        <i class="fas fa-info-circle"></i>
                                                        <strong>Residual Risk Assessment in Progress:</strong> 
                                                        @completedResidualScores of @residualPanelMembers.Count panelists have assessed the residual risk.
                                                        @if (completedResidualScores == 0)
                                                        {
                                                            <span class="text-muted">Ready for panelist scoring...</span>
                                                        }
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <p><i class="fas fa-info-circle text-info"></i> <strong>Mitigation strategies loaded.</strong> Assign a panel to assess residual risk after mitigation implementation.</p>
                                            }
                                        }
                                        else
                                        {
                                            <p>Residual risk assessment will appear here after mitigation strategies are defined.</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Monitoring Only for Acceptable Risks -->
                            <div class="alert alert-success">
                                <h6><i class="fas fa-eye"></i> Monitoring & Review Requirements</h6>
                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="form-label">Monitoring Frequency</label>
                                        <select class="form-select" name="MonitoringFrequency[@originalIndex]">
                                            <option value="">Select frequency...</option>
                                            <option value="Continuous">Continuous</option>
                                            <option value="Daily">Daily</option>
                                            <option value="Weekly">Weekly</option>
                                            <option value="Monthly">Monthly</option>
                                            <option value="Quarterly">Quarterly</option>
                                            <option value="Annually">Annually</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Responsible Department</label>
                                        <input type="text" class="form-control" name="MonitoringDepartment[@originalIndex]" 
                                               placeholder="Which department monitors?">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Review Trigger</label>
                                        <input type="text" class="form-control" name="ReviewTrigger[@originalIndex]" 
                                               placeholder="What triggers a review?">
                                    </div>
                                </div>
                            </div>
                        }
                        
                        <!-- Current Controls Display -->
                        @if (hazard.CurrentMitigations?.Any() == true)
                        {
                            <div class="alert alert-info mt-3">
                                <h6><i class="fas fa-shield"></i> Current Controls</h6>
                                <ul class="mb-0">
                                    @foreach (var control in hazard.CurrentMitigations)
                                    {
                                        <li>@control</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else if (allHazards.Any())
        {
            <!-- Show message for hazards without assessment -->
            <div class="text-center text-muted py-4">
                <i class="fas fa-balance-scale fa-3x mb-3"></i>
                <h5>Risk Assessment Required</h5>
                <p>@allHazards.Count hazards identified but need risk assessment before mitigation planning.</p>
                <a href="/SafetyRiskManagement/RiskAssessmentWizard/@Model.Id/step/4" class="btn btn-info">
                    <i class="fas fa-balance-scale"></i> Complete Step 4 - Risk Assessment
                </a>
            </div>
        }
        else
        {
            <!-- No hazards found -->
            <div class="text-center text-muted py-4">
                <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                <h5>No hazards found</h5>
                <p>Please complete the previous steps before proceeding with mitigation planning.</p>
                <div class="btn-group">
                    <a href="/SafetyRiskManagement/RiskAssessmentWizard/@Model.Id/step/2" class="btn btn-warning">
                        <i class="fas fa-exclamation-triangle"></i> Step 2 - Identify Hazards
                    </a>
                    <a href="/SafetyRiskManagement/RiskAssessmentWizard/@Model.Id/step/3" class="btn btn-info">
                        <i class="fas fa-chart-line"></i> Step 3 - Analyze Risk
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Residual Risk Scoring Panel Modal -->
<div class="modal fade" id="residualScoringPanelModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="fas fa-users"></i> <span id="residualModalTitle">Manage Residual Risk Scoring Panel</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info" id="currentResidualHazardInfo" style="display: none;">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Managing residual risk panel for:</strong> <span id="currentResidualHazardDisplay"></span>
                </div>
                
                <div class="card border-success">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0">
                            <i class="fas fa-check-square"></i> Select SMS Users for Residual Risk Assessment
                        </h6>
                    </div>
                    <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                        @if (Model.AvailableSMSUsers?.Any() == true)
                        {
                            <div class="alert alert-info mb-3">
                                <i class="fas fa-info-circle"></i>
                                <strong>Found @Model.AvailableSMSUsers.Count SMS Users:</strong> Select users to assess residual risk after mitigation implementation.
                            </div>
                            <div class="row">
                                @foreach (var smsUser in Model.AvailableSMSUsers)
                                {
                                    <div class="col-md-12 mb-3">
                                        <div class="card border-light">
                                            <div class="card-body p-3">
                                                <div class="form-check">
                                                    <input class="form-check-input residual-sms-user-checkbox" type="checkbox" 
                                                           name="selectedResidualSMSUsers" value="@smsUser.Id" 
                                                           id="residual_@smsUser.Id" 
                                                           data-user-id="@smsUser.Id"
                                                           data-user-name="@(smsUser.UserName.Value ?? smsUser.Id.Value)">
                                                    <label class="form-check-label w-100" for="residual_@smsUser.Id">
                                                        <div class="d-flex align-items-center">
                                                            <div class="me-3">
                                                                <i class="fas fa-user-tie text-info fa-2x"></i>
                                                            </div>
                                                            <div class="flex-grow-1">
                                                                <h6 class="mb-1">@(smsUser.UserName.Value ?? smsUser.Id.Value)</h6>
                                                                <p class="mb-1 text-muted">
                                                                    <i class="fas fa-envelope"></i> @smsUser.ApplicationRole
                                                                </p>
                                                                <span class="badge bg-info">Residual Risk Assessor</span>
                                                            </div>
                                                        </div>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle"></i>
                                <strong>No SMS Users Available</strong><br>
                                Please load SMS users first.
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-info" onclick="assignResidualPanel()">
                    <i class="fas fa-users"></i> Update Residual Panel
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.mitigation-strategy {
    background-color: #fff8e1;
    border-left: 4px solid #ff9800;
}

.assignment-item {
    background-color: #f5f5f5 !important;
}

.residual-scoring-row {
    background-color: #f0f9ff;
}

.residual-scoring-row.table-success {
    background-color: #d4edda !important;
}

.residual-scoring-row.table-light {
    background-color: #f8f9fa !important;
}
</style>

<script>
// Clean, minimal JavaScript for Step 5 functionality
'use strict';

// Global state
const Step5 = {
    currentResidualHazard: { id: '', description: '', index: -1 },
    mitigationCounters: {},
    assignmentCounters: {},
    departments: [
        'Airport Operations', 'Safety Management', 'Maintenance & Engineering', 
        'Aircraft Rescue & Firefighting', 'Airport Security', 'Air Traffic Control', 
        'Ground Handling Services', 'Cargo Operations', 'External Contractor'
    ]
};

// Initialize when DOM loads
document.addEventListener('DOMContentLoaded', function() {
    // Initialize mitigation strategies from server data
    @if (Model.SavedMitigationStrategies != null && Model.SavedMitigationStrategies.Any())
    {
        @foreach (var kvp in Model.SavedMitigationStrategies)
        {
            <text>
            Step5.loadSavedStrategies('@(kvp.Key)', @Html.Raw(Json.Serialize(kvp.Value ?? new List<string>()));
            </text>
        }
    }
});

// Load saved mitigation strategies for a hazard
Step5.loadSavedStrategies = function(hazardId, strategies) {
    const hazardIndex = this.findHazardIndex(hazardId);
    if (hazardIndex === -1) return;
    
    const container = document.getElementById(`mitigationsList${hazardIndex}`);
    if (!container) return;
    
    // Clear placeholder
    const placeholder = container.querySelector('.alert');
    if (placeholder) placeholder.remove();
    
    // Add each strategy
    strategies.forEach((strategy, index) => {
        this.addStrategy(hazardIndex, index, strategy);
        this.mitigationCounters[hazardIndex] = Math.max(this.mitigationCounters[hazardIndex] || 0, index + 1);
    });
    
    // Show residual risk section
    this.updateResidualVisibility(hazardIndex);
};

// Find hazard index by ID
Step5.findHazardIndex = function(hazardId) {
    const cards = document.querySelectorAll('[data-hazard-index]');
    for (let i = 0; i < cards.length; i++) {
        const hiddenField = document.querySelector(`input[name="AssessmentData.IdentifiedHazards[${i}].Id"][value="${hazardId}"]`);
        if (hiddenField) return i;
    }
    return -1;
};

// Add mitigation strategy
function addMitigationStrategy(hazardIndex) {
    const strategyIndex = Step5.mitigationCounters[hazardIndex] || 0;
    Step5.mitigationCounters[hazardIndex] = strategyIndex + 1;
    
    Step5.addStrategy(hazardIndex, strategyIndex);
    Step5.updateResidualVisibility(hazardIndex);
}

// Add strategy to DOM
Step5.addStrategy = function(hazardIndex, strategyIndex, data = {}) {
    const container = document.getElementById(`mitigationsList${hazardIndex}`);
    if (!container) return;
    
    // Remove placeholder
    const placeholder = container.querySelector('.alert');
    if (placeholder) placeholder.remove();
    
    const strategyHtml = `
        <div class="mitigation-strategy border rounded p-3 mb-3" data-strategy-index="${strategyIndex}">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0"><i class="fas fa-shield-alt text-primary"></i> Strategy ${strategyIndex + 1}</h6>
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="Step5.removeStrategy(${hazardIndex}, ${strategyIndex})">
                    <i class="fas fa-trash"></i> Remove
                </button>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Strategy Description</label>
                <textarea class="form-control" rows="2" placeholder="Describe the mitigation strategy...">${data.description || ''}</textarea>
            </div>
            
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">Control Type</label>
                    <select class="form-control">
                        <option value="">Select type...</option>
                        <option value="Eliminate" ${data.controlType === 'Eliminate' ? 'selected' : ''}>Eliminate</option>
                        <option value="Engineering" ${data.controlType === 'Engineering' ? 'selected' : ''}>Engineering Control</option>
                        <option value="Administrative" ${data.controlType === 'Administrative' ? 'selected' : ''}>Administrative Control</option>
                        <option value="PPE" ${data.controlType === 'PPE' ? 'selected' : ''}>Personal Protective Equipment</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Priority</label>
                    <select class="form-control">
                        <option value="">Select priority...</option>
                        <option value="Critical" ${data.priority === 'Critical' ? 'selected' : ''}>Critical</option>
                        <option value="High" ${data.priority === 'High' ? 'selected' : ''}>High</option>
                        <option value="Medium" ${data.priority === 'Medium' ? 'selected' : ''}>Medium</option>
                        <option value="Low" ${data.priority === 'Low' ? 'selected' : ''}>Low</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Target Date</label>
                    <input type="date" class="form-control" value="${data.targetDate || ''}">
                </div>
            </div>
        </div>
    `;
    
    container.insertAdjacentHTML('beforeend', strategyHtml);
};

// Remove mitigation strategy
Step5.removeStrategy = function(hazardIndex, strategyIndex) {
    if (!confirm('Remove this mitigation strategy?')) return;
    
    const strategy = document.querySelector(`#mitigationsList${hazardIndex} [data-strategy-index="${strategyIndex}"]`);
    if (strategy) strategy.remove();
    
    const container = document.getElementById(`mitigationsList${hazardIndex}`);
    if (container.children.length === 0) {
        container.innerHTML = `
            <div class="alert alert-info">
                <i class="fas fa-plus-circle"></i>
                <strong>Add mitigation strategies above.</strong>
            </div>
        `;
    }
    
    this.updateResidualVisibility(hazardIndex);
};

// Update residual risk section visibility
Step5.updateResidualVisibility = function(hazardIndex) {
    const container = document.getElementById(`mitigationsList${hazardIndex}`);
    const residualSection = document.getElementById(`residualRisk${hazardIndex}`);
    
    if (container && residualSection) {
        const hasStrategies = container.querySelectorAll('.mitigation-strategy').length > 0;
        residualSection.style.display = hasStrategies ? 'block' : 'none';
    }
};

// Set current residual hazard for modal
function setCurrentResidualHazard(hazardId, hazardDescription, hazardIndex) {
    Step5.currentResidualHazard = { id: hazardId, description: hazardDescription, index: hazardIndex };
    
    document.getElementById('residualModalTitle').textContent = `Residual Risk Panel for ${hazardId}`;
    document.getElementById('currentResidualHazardDisplay').textContent = `${hazardId}: ${hazardDescription}`;
    document.getElementById('currentResidualHazardInfo').style.display = 'block';
}

// Assign residual panel
async function assignResidualPanel() {
    const { id: hazardId } = Step5.currentResidualHazard;
    if (!hazardId) return;
    
    const selectedUsers = Array.from(document.querySelectorAll('.residual-sms-user-checkbox:checked'))
        .map(cb => ({ id: cb.value, name: cb.dataset.userName }));
    
    if (selectedUsers.length === 0) {
        alert('Please select at least one SMS user for the residual risk panel.');
        return;
    }
    
    try {
        const formData = new FormData();
        formData.append('hazardId', `residual-${hazardId}`);
        formData.append('userIds', selectedUsers.map(u => u.id).join(','));
        formData.append('Id', document.querySelector('input[name="Id"]').value);
        formData.append('StepNumber', '5');
        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        
        const response = await fetch(`${window.location.pathname}?handler=AssignScoringPanel`, {
            method: 'POST',
            body: formData
        });
        
        if (response.ok) {
            alert(`Successfully assigned ${selectedUsers.length} users to residual risk panel. Page will refresh.`);
            setTimeout(() => window.location.reload(), 1000);
        }
    } catch (error) {
        alert('Error assigning panel. Please try again.');
    }
}

// Calculate residual score
function calculateResidualScore(rowId) {
    const row = document.getElementById(rowId);
    if (!row) return;
    
    const severity = parseInt(row.querySelector('.severity-select').value);
    const likelihood = parseInt(row.querySelector('.likelihood-select').value);
    const scoreDisplay = row.querySelector('.score-display');
    const submitButton = row.querySelector('.submit-btn');
    
    if (severity && likelihood) {
        const score = severity * likelihood;
        scoreDisplay.textContent = score.toFixed(1);
        scoreDisplay.className = 'score-display badge bg-info fs-6 p-2';
        submitButton.disabled = false;
    } else {
        scoreDisplay.textContent = '-';
        scoreDisplay.className = 'score-display badge bg-secondary fs-6 p-2';
        submitButton.disabled = true;
    }
}

// Submit residual score
async function submitResidualScore(memberId, residualHazardId) {
    const rowId = `residual-scoring-row-${residualHazardId.replace('residual-', '')}-${memberId}`;
    const row = document.getElementById(rowId);
    if (!row) return;
    
    const severity = parseInt(row.querySelector('.severity-select').value);
    const likelihood = parseInt(row.querySelector('.likelihood-select').value);
    
    if (!severity || !likelihood) {
        alert('Please select both severity and likelihood.');
        return;
    }
    
    try {
        const formData = new FormData();
        formData.append('hazardId', residualHazardId);
        formData.append('memberId', memberId);
        formData.append('severityScore', severity.toString());
        formData.append('likelihoodScore', likelihood.toString());
        formData.append('Id', document.querySelector('input[name="Id"]').value);
        formData.append('StepNumber', '5');
        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        
        const response = await fetch(`${window.location.pathname}?handler=SubmitResidualScore`, {
            method: 'POST',
            body: formData
        });
        
        if (response.ok) {
            alert('Residual risk score submitted successfully. Page will refresh.');
            setTimeout(() => window.location.reload(), 1000);
        }
    } catch (error) {
        alert('Error submitting score. Please try again.');
    }
}

// Edit residual score
function editResidualScore(memberId, residualHazardId, currentSeverity, currentLikelihood) {
    const rowId = `residual-scoring-row-${residualHazardId.replace('residual-', '')}-${memberId}`;
    const row = document.getElementById(rowId);
    if (!row) return;
    
    // Convert back to dropdowns
    row.classList.remove('table-success');
    row.classList.add('table-light');
    
    const cells = row.children;
    cells[1].innerHTML = `
        <select class="form-select form-select-sm severity-select" onchange="calculateResidualScore('${rowId}')">
            <option value="">Select Severity...</option>
            <option value="1" ${currentSeverity === 1 ? 'selected' : ''}>1 - Minor</option>
            <option value="2" ${currentSeverity === 2 ? 'selected' : ''}>2 - Moderate</option>
            <option value="3" ${currentSeverity === 3 ? 'selected' : ''}>3 - Serious</option>
            <option value="4" ${currentSeverity === 4 ? 'selected' : ''}>4 - Major</option>
            <option value="5" ${currentSeverity === 5 ? 'selected' : ''}>5 - Catastrophic</option>
        </select>
    `;
    
    cells[2].innerHTML = `
        <select class="form-select form-select-sm likelihood-select" onchange="calculateResidualScore('${rowId}')">
            <option value="">Select Likelihood...</option>
            <option value="1" ${currentLikelihood === 1 ? 'selected' : ''}>1 - Rare</option>
            <option value="2" ${currentLikelihood === 2 ? 'selected' : ''}>2 - Unlikely</option>
            <option value="3" ${currentLikelihood === 3 ? 'selected' : ''}>3 - Possible</option>
            <option value="4" ${currentLikelihood === 4 ? 'selected' : ''}>4 - Likely</option>
            <option value="5" ${currentLikelihood === 5 ? 'selected' : ''}>5 - Frequent</option>
        </select>
    `;
    
    cells[3].innerHTML = `<div class="score-display badge bg-info fs-6 p-2">${(currentSeverity * currentLikelihood).toFixed(1)}</div>`;
    cells[4].innerHTML = `<button class="btn btn-success btn-sm submit-btn" onclick="submitResidualScore('${memberId}', '${residualHazardId}')"><i class="fas fa-save"></i> Submit</button>`;
}
</script>