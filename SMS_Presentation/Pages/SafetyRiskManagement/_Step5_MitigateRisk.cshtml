    const strategyKey = `${hazardIndex}-${strategyIndex}`;
    assignmentCounters[strategyKey] = 0;
    
    const departmentOptionsHtml = departmentOptions.map(dept => 
        `<option value="${dept}">${dept}</option>`
    ).join('');
    
    assignments.forEach((assignment, assignmentIndex) => {
        const assignmentHtml = `
            <div class="assignment-item border rounded p-2 mb-2 bg-light" data-assignment-index="${assignmentIndex}">
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label small">Department/Organization</label>
                        <select class="form-select form-select-sm assignment-field" name="MitigationStrategies[${hazardIndex}][${strategyIndex}][Assignments][${assignmentIndex}][Department]"
                                onchange="saveMitigationData(${hazardIndex}, ${strategyIndex})">
                            <option value="">Select department...</option>
                            ${departmentOptionsHtml}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Person/Role</label>
                        <input type="text" class="form-control form-control-sm assignment-field" 
                               name="MitigationStrategies[${hazardIndex}][${strategyIndex}][Assignments][${assignmentIndex}][Person]" 
                               placeholder="Name or role title" value="${assignment.person || ''}" onchange="saveMitigationData(${hazardIndex}, ${strategyIndex})">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Responsibility</label>
                        <select class="form-select form-select-sm assignment-field" name="MitigationStrategies[${hazardIndex}][${strategyIndex}][Assignments][${assignmentIndex}][Role]"
                                onchange="saveMitigationData(${hazardIndex}, ${strategyIndex})">
                            <option value="">Select role...</option>
                            <option value="Lead" ${assignment.role === 'Lead' ? 'selected' : ''}>Lead/Manager</option>
                            <option value="Execute" ${assignment.role === 'Execute' ? 'selected' : ''}>Execute/Implement</option>
                            <option value="Support" ${assignment.role === 'Support' ? 'selected' : ''}>Support/Assist</option>
                            <option value="Review" ${assignment.role === 'Review' ? 'selected' : ''}>Review/Approve</option>
                            <option value="Monitor" ${assignment.role === 'Monitor' ? 'selected' : ''}>Monitor/Oversee</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label small">&nbsp;</label>
                        <button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="removeAssignment(${hazardIndex}, ${strategyIndex}, ${assignmentIndex})">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        `;
        
        container.insertAdjacentHTML('beforeend', assignmentHtml);
        
        // Set the department value after HTML is inserted
        const departmentSelect = container.querySelector(`[data-assignment-index="${assignmentIndex}"] select[name*="[Department]"]`);
        if (departmentSelect && assignment.department) {
            departmentSelect.value = assignment.department;
        }
        
        assignmentCounters[strategyKey] = Math.max(assignmentCounters[strategyKey], assignmentIndex + 1);
    });
}

// 🔧 NEW: Helper function to format date for input field
function formatDateForInput(dateString) {
    if (!dateString) return '';
    
    try {
        const date = new Date(dateString);
        if (isNaN(date.getTime())) return '';
        
        // Format as YYYY-MM-DD for HTML date input
        return date.toISOString().split('T')[0];
    } catch (error) {
        console.log('Date formatting error:', error);
        return '';
    }
}

