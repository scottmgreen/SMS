// 🔧 MISSING FUNCTION: Save mitigation strategy data to server
async function saveMitigationData(hazardIndex, strategyIndex) {
    console.log('💾 Saving mitigation data for hazard ' + hazardIndex + ', strategy ' + strategyIndex);
    
    try {
        // Get hazard ID from the AssessmentData
        const hazardId = window.assessmentHazards && window.assessmentHazards[hazardIndex] 
            ? window.assessmentHazards[hazardIndex].Id 
            : `HZ-${String(hazardIndex).padStart(4, '0')}`;
        
        // Collect strategy data
        const strategyData = {
            description: document.querySelector(`[name="MitigationStrategies[${hazardIndex}][${strategyIndex}][Description]"]`)?.value || '',
            controlType: document.querySelector(`[name="MitigationStrategies[${hazardIndex}][${strategyIndex}][ControlType]"]`)?.value || '',
            priority: document.querySelector(`[name="MitigationStrategies[${hazardIndex}][${strategyIndex}][Priority]"]`)?.value || '',
            targetDate: document.querySelector(`[name="MitigationStrategies[${hazardIndex}][${strategyIndex}][TargetDate]"]`)?.value || '',
            estimatedCost: parseFloat(document.querySelector(`[name="MitigationStrategies[${hazardIndex}][${strategyIndex}][EstimatedCost]"]`)?.value || '0'),
            status: document.querySelector(`[name="MitigationStrategies[${hazardIndex}][${strategyIndex}][Status]"]`)?.value || 'Planned'
        };
        
        // Collect assignments for this strategy
        const assignments = [];
        const assignmentContainer = document.getElementById(`assignments-${hazardIndex}-${strategyIndex}`);
        if (assignmentContainer) {
            const assignmentItems = assignmentContainer.querySelectorAll('.assignment-item');
            assignmentItems.forEach((item, idx) => {
                const department = item.querySelector(`[name*="[Department]"]`)?.value || '';
                const person = item.querySelector(`[name*="[Person]"]`)?.value || '';
                const role = item.querySelector(`[name*="[Role]"]`)?.value || '';
                
                if (department || person || role) {
                    assignments.push({ department, person, role });
                }
            });
        }
        
        strategyData.assignments = assignments;
        
        // Send to server
        const assessmentIdField = document.querySelector('input[name="Id"]');
        const tokenField = document.querySelector('input[name="__RequestVerificationToken"]');
        
        if (!assessmentIdField || !tokenField) {
            console.error('❌ Missing form fields for mitigation save');
            return;
        }
        
        const formData = new FormData();
        formData.append('hazardId', hazardId);
        formData.append('hazardIndex', hazardIndex.toString());
        formData.append('strategyIndex', strategyIndex.toString());
        formData.append('strategyData', JSON.stringify(strategyData));
        formData.append('Id', assessmentIdField.value);
        formData.append('StepNumber', '5');
        formData.append('__RequestVerificationToken', tokenField.value);
        
        console.log('📤 Saving mitigation strategy:', strategyData);
        
        const response = await fetch(window.location.pathname + '?handler=SaveMitigationStrategy', {
            method: 'POST',
            body: formData
        });
        
        if (response.ok) {
            const result = await response.json();
            if (result.success) {
                console.log('✅ Mitigation strategy saved successfully');
            } else {
                console.error('❌ Failed to save mitigation strategy:', result.message);
            }
        } else {
            console.error('❌ Server error saving mitigation strategy:', response.status);
        }
        
    } catch (error) {
        console.error('💥 Error saving mitigation data:', error);
    }
}

