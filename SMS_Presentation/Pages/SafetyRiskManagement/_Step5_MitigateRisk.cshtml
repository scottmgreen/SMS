@model PDXSMS_Presentation.Pages.SafetyRiskManagement.RiskAssessmentWizardModel

@{
    // Calculate all hazard states once at the top
    var allHazards = Model.AssessmentData?.IdentifiedHazards ?? new List<RiskAssessmentWizardModel.IdentifiedHazardDto>();
    var assessedHazards = allHazards.Where(h => !string.IsNullOrEmpty(h.Tolerability) || 
                                               !string.IsNullOrEmpty(h.RiskLevel) || 
                                               (!string.IsNullOrEmpty(h.Severity) && !string.IsNullOrEmpty(h.Likelihood))).ToList();
    var requiresMitigation = assessedHazards.Where(h => h.Tolerability == "ALARP" || h.Tolerability == "Unacceptable" || string.IsNullOrEmpty(h.Tolerability)).ToList();
    // 🔧 CRITICAL FIX: Check both ProposedMitigations AND SavedMitigationStrategies for existing mitigation
    var hasMitigations = requiresMitigation.Where(h => 
        (h.ProposedMitigations?.Any() == true) || 
        (Model.SavedMitigationStrategies?.ContainsKey(h.Id) == true && Model.SavedMitigationStrategies[h.Id]?.Any() == true)
    ).ToList();
    var requiresCount = requiresMitigation.Count();
    var mitigatedCount = hasMitigations.Count();
    var mitigationProgress = requiresCount > 0 ? (mitigatedCount * 100) / requiresCount : 100;
}

<div class="row">
    <div class="col-12">
        <!-- Header with Implementation Planning -->
        <div class="card border-primary mb-4">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-shield-alt"></i> Step 5: Risk Mitigation & Residual Assessment
                    </h5>
                    <div>
                        <span class="badge bg-light text-dark">
                            @requiresCount Need Mitigation
                        </span>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <p class="mb-3">
                    Develop mitigation strategies for hazards requiring risk reduction, then assess residual risk levels after mitigation implementation.
                </p>
                
                <!-- Implementation Planning -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Implementation Strategy</label>
                            <select class="form-select" asp-for="AssessmentData.ImplementationPlan">
                                <option value="">Select strategy...</option>
                                <option value="Immediate" selected="@(Model.SavedImplementationStrategy == "Immediate" ? "selected" : null)">Immediate Implementation</option>
                                <option value="Phased" selected="@(Model.SavedImplementationStrategy == "Phased" ? "selected" : null)">Phased Implementation</option>
                                <option value="Risk-Based" selected="@(Model.SavedImplementationStrategy == "Risk-Based" ? "selected" : null)">Risk-Based Priority</option>
                                <option value="Resource-Based" selected="@(Model.SavedImplementationStrategy == "Resource-Based" ? "selected" : null)">Resource-Based Priority</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Overall Timeline</label>
                            <input type="date" class="form-control" name="OverallTargetDate" 
                                   value="@(string.IsNullOrEmpty(Model.SavedOverallTargetDate) ? DateTime.Now.AddMonths(6).ToString("yyyy-MM-dd") : DateTime.Parse(Model.SavedOverallTargetDate).ToString("yyyy-MM-dd"))">
                            <div class="form-text">Target completion for all mitigation strategies</div>
                        </div>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-12">
                        <div class="mb-3">
                            <label class="form-label">Implementation Notes</label>
                            <textarea class="form-control" name="ImplementationNotes" rows="2" 
                                      placeholder="Document overall implementation approach, resource requirements, and coordination notes...">@Model.SavedImplementationNotes</textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hidden fields for form binding -->
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="StepNumber" value="@Model.StepNumber" />
        @Html.AntiForgeryToken()

        @if (assessedHazards.Any())
        {
            @foreach (var hazard in assessedHazards)
            {
                var originalIndex = allHazards.IndexOf(hazard);
                var riskClass = Model.GetRiskLevelClass(hazard.RiskLevel ?? "");
                var needsMitigation = hazard.Tolerability == "ALARP" || hazard.Tolerability == "Unacceptable";
                
                // 🔧 CRITICAL FIX: Check if this hazard already has mitigation strategies (from ProposedMitigations OR SavedMitigationStrategies)
                var hasSavedStrategies = Model.SavedMitigationStrategies?.ContainsKey(hazard.Id) == true && 
                                        Model.SavedMitigationStrategies[hazard.Id]?.Any() == true;
                var hasProposedMitigations = hazard.ProposedMitigations?.Any() == true;
                var hasMitigationStrategies = hasSavedStrategies || hasProposedMitigations;
                
                // Hidden fields to preserve hazard data
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].Id" value="@hazard.Id" />
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].Description" value="@hazard.Description" />
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].Category" value="@hazard.Category" />
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].WorstCredibleOutcome" value="@hazard.WorstCredibleOutcome" />
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].Severity" value="@hazard.Severity" />
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].Likelihood" value="@hazard.Likelihood" />
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].RiskLevel" value="@hazard.RiskLevel" />
                <input type="hidden" name="AssessmentData.IdentifiedHazards[@originalIndex].Tolerability" value="@hazard.Tolerability" />
                
                <div class="card border-@(needsMitigation ? (hasMitigationStrategies ? "info" : "warning") : "success") mb-4" data-hazard-index="@originalIndex">
                    <div class="card-header bg-@(needsMitigation ? (hasMitigationStrategies ? "info" : "warning") : "success") @(needsMitigation && !hasMitigationStrategies ? "text-dark" : "text-white")">
                        <div class="row align-items-center">
                            <div class="col">
                                <h5 class="mb-0">
                                    <strong>@hazard.Id: @hazard.Description</strong>
                                </h5>
                                @if (!string.IsNullOrEmpty(hazard.RiskLevel))
                                {
                                    <span class="badge bg-@riskClass ms-2">Initial: @hazard.RiskLevel</span>
                                }
                                @if (!string.IsNullOrEmpty(hazard.Tolerability))
                                {
                                    <span class="badge bg-secondary ms-1">@hazard.Tolerability</span>
                                }
                            </div>
                            <div class="col-auto" data-hazard-status="@originalIndex">
                                @if (needsMitigation)
                                {
                                    @if (hasMitigationStrategies)
                                    {
                                        <i class="fas fa-shield-alt"></i> <strong>Mitigation Strategies Defined</strong>
                                        <br><small>@(Model.SavedMitigationStrategies?.GetValueOrDefault(hazard.Id)?.Count ?? hazard.ProposedMitigations?.Count ?? 0) strategies loaded</small>
                                    }
                                    else
                                    {
                                        <i class="fas fa-exclamation-triangle"></i> <strong>Mitigation Required</strong>
                                    }
                                }
                                else
                                {
                                    <i class="fas fa-check-circle"></i> <strong>Monitor Only</strong>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (needsMitigation)
                        {
                            <!-- Mitigation Strategies Section -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h6><i class="fas fa-lightbulb text-warning"></i> Mitigation Strategies</h6>
                                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="addMitigationStrategy(@originalIndex)">
                                            <i class="fas fa-plus"></i> Add Mitigation Strategy
                                        </button>
                                    </div>
                                    <div id="mitigationsList@(originalIndex)">
                                        <div class="alert alert-info">
                                            <i class="fas fa-plus-circle"></i>
                                            <strong>Add mitigation strategies above.</strong> Each strategy can include cost estimates, priorities, and department assignments.
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Residual Risk Assessment Section -->
                            <div class="residual-risk-section" id="residualRisk@(originalIndex)" style="display: @(hasMitigationStrategies ? "block" : "none");">
                                <div class="card border-info">
                                    <div class="card-header bg-info text-white">
                                        <div class="row align-items-center">
                                            <div class="col">
                                                <h6 class="mb-0"><i class="fas fa-calculator"></i> Residual Risk Assessment</h6>
                                            </div>
                                            <div class="col-auto">
                                                <button type="button" class="btn btn-info btn-sm" 
                                                        data-bs-toggle="modal" data-bs-target="#residualScoringPanelModal" 
                                                        onclick="setCurrentResidualHazard('@hazard.Id', '@hazard.Description', @originalIndex)">
                                                    <i class="fas fa-users"></i> Manage Residual Panel
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        @{
                                            // Check if this hazard has a residual scoring panel assigned
                                            var residualHazardId = "residual-" + hazard.Id;
                                            var residualPanelMembers = Model.HazardPanelMembers?.ContainsKey(residualHazardId) == true 
                                                ? Model.HazardPanelMembers[residualHazardId] 
                                                : new List<string>();
                                            var residualScores = Model.PanelScores?.ContainsKey(residualHazardId) == true 
                                                ? Model.PanelScores[residualHazardId] 
                                                : new List<RiskAssessmentWizardModel.PanelMemberScoreData>();
                                            var residualAverageScore = Model.HazardAverageScores?.ContainsKey(residualHazardId) == true 
                                                ? (double?)Model.HazardAverageScores[residualHazardId] 
                                                : null;
                                            var completedResidualScores = residualScores.Count(s => s.IsComplete);
                                        }
                                        
                                        @if (hasMitigationStrategies)
                                        {
                                            <p><i class="fas fa-info-circle text-info"></i> <strong>Mitigation strategies loaded.</strong> Assign a panel to assess residual risk after mitigation implementation.</p>
                                            
                                            @if (residualPanelMembers.Any())
                                            {
                                                <p><i class="fas fa-users text-success"></i> <strong>Residual Risk Panel Assigned:</strong> @residualPanelMembers.Count panel members ready to assess residual risk after mitigation.</p>
                                                
                                                <!-- Residual Risk Scoring Table -->
                                                <div class="table-responsive mt-3">
                                                    <table class="table table-bordered table-sm">
                                                        <thead class="table-info">
                                                            <tr>
                                                                <th width="25%">
                                                                    <i class="fas fa-user"></i> Panel Member
                                                                </th>
                                                                <th width="20%" class="text-center">
                                                                    <i class="fas fa-exclamation-circle"></i> Residual Severity
                                                                </th>
                                                                <th width="20%" class="text-center">
                                                                    <i class="fas fa-clock"></i> Residual Likelihood
                                                                </th>
                                                                <th width="15%" class="text-center">
                                                                    <i class="fas fa-calculator"></i> Residual Score
                                                                </th>
                                                                <th width="20%" class="text-center">
                                                                    <i class="fas fa-save"></i> Action
                                                                </th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var panelistId in residualPanelMembers)
                                                            {
                                                                var panelist = Model.AvailableSMSUsers?.FirstOrDefault(u => u.Id == panelistId);
                                                                if (panelist != null)
                                                                {
                                                                    var memberScore = residualScores.FirstOrDefault(s => s.MemberId == panelistId);
                                                                    var isCompleted = memberScore?.IsComplete == true;
                                                                    var rowId = $"residual-scoring-row-{hazard.Id}-{panelistId}";
                                                                    
                                                                    <tr id="@rowId" class="residual-scoring-row @(isCompleted ? "table-success" : "table-light")" 
                                                                        data-member-id="@panelistId" data-hazard-id="@residualHazardId">
                                                                        <!-- Panel Member Info -->
                                                                        <td>
                                                                            <div class="d-flex align-items-center">
                                                                                <div class="me-2">
                                                                                    <i class="fas fa-user-shield text-info"></i>
                                                                                </div>
                                                                                <div>
                                                                                    <strong class="small">@(panelist.DisplayName ?? panelist.Id)</strong><br>
                                                                                    <small class="text-muted">@(panelist.OrganizationName ?? "SMS Employee")</small><br>
                                                                                    @if (isCompleted)
                                                                                    {
                                                                                        <span class="badge bg-success mt-1">
                                                                                            <i class="fas fa-check"></i> Scored
                                                                                        </span>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="badge bg-warning mt-1">
                                                                                            <i class="fas fa-clock"></i> Pending
                                                                                        </span>
                                                                                    }
                                                                                </div>
                                                                            </div>
                                                                        </td>
                                                                        
                                                                        @if (isCompleted)
                                                                        {
                                                                            <!-- Show completed residual scoring (read-only) -->
                                                                            <td class="text-center align-middle">
                                                                                <div class="badge bg-info fs-6 p-2">
                                                                                    @memberScore.SeverityScore
                                                                                </div>
                                                                                <br><small class="text-muted mt-1">
                                                                                    @(memberScore.SeverityScore switch {
                                                                                        1 => "Minor",
                                                                                        2 => "Moderate", 
                                                                                        3 => "Serious",
                                                                                        4 => "Major",
                                                                                        5 => "Catastrophic",
                                                                                        _ => "Unknown"
                                                                                    })
                                                                                </small>
                                                                            </td>
                                                                            <td class="text-center align-middle">
                                                                                <div class="badge bg-info fs-6 p-2">
                                                                                    @memberScore.LikelihoodScore
                                                                                </div>
                                                                                <br><small class="text-muted mt-1">
                                                                                    @(memberScore.LikelihoodScore switch {
                                                                                        1 => "Rare",
                                                                                        2 => "Unlikely",
                                                                                        3 => "Possible", 
                                                                                        4 => "Likely",
                                                                                        5 => "Frequent",
                                                                                        _ => "Unknown"
                                                                                    })
                                                                                </small>
                                                                            </td>
                                                                            <td class="text-center align-middle">
                                                                                <div class="badge bg-success fs-5 p-2">
                                                                                    @memberScore.CalculatedScore.ToString("F1")
                                                                                </div>
                                                                            </td>
                                                                            <td class="text-center align-middle">
                                                                                <button type="button" class="btn btn-outline-secondary btn-sm" 
                                                                                        onclick="editResidualScore('@panelistId', '@residualHazardId', @memberScore.SeverityScore, @memberScore.LikelihoodScore)">
                                                                                    <i class="fas fa-edit"></i> Edit
                                                                                </button>
                                                                            </td>
                                                                        }
                                                                        else
                                                                        {
                                                                            <!-- Show residual risk scoring dropdowns -->
                                                                            <td class="align-middle">
                                                                                <select class="form-select form-select-sm severity-select" 
                                                                                        name="residualSeverityScore" 
                                                                                        onchange="calculateResidualScore('@rowId')" required>
                                                                                    <option value="">Select Severity...</option>
                                                                                    <option value="1">1 - Minor Impact</option>
                                                                                    <option value="2">2 - Moderate Impact</option>
                                                                                    <option value="3">3 - Serious Impact</option>
                                                                                    <option value="4">4 - Major Impact</option>
                                                                                    <option value="5">5 - Catastrophic Impact</option>
                                                                                </select>
                                                                                <small class="text-muted">After mitigation</small>
                                                                            </td>
                                                                            <td class="align-middle">
                                                                                <select class="form-select form-select-sm likelihood-select" 
                                                                                        name="residualLikelihoodScore" 
                                                                                        onchange="calculateResidualScore('@rowId')" required>
                                                                                    <option value="">Select Likelihood...</option>
                                                                                    <option value="1">1 - Rare (A)</option>
                                                                                    <option value="2">2 - Unlikely (B)</option>
                                                                                    <option value="3">3 - Possible (C)</option>
                                                                                    <option value="4">4 - Likely (D)</option>
                                                                                    <option value="5">5 - Frequent (E)</option>
                                                                                </select>
                                                                                <small class="text-muted">After mitigation</small>
                                                                            </td>
                                                                            <td class="text-center align-middle">
                                                                                <div class="score-display badge bg-secondary fs-6 p-2">-</div>
                                                                                <br><small class="text-muted">Auto-calculated</small>
                                                                            </td>
                                                                            <td class="text-center align-middle">
                                                                                <button type="button" class="btn btn-success btn-sm submit-btn" 
                                                                                        onclick="submitResidualScore('@panelistId', '@residualHazardId')" disabled>
                                                                                    <i class="fas fa-save"></i> Submit
                                                                                </button>
                                                                            </td>
                                                                        }
                                                                    </tr>
                                                                }
                                                                else
                                                                {
                                                                    <!-- Missing panelist -->
                                                                    <tr class="table-warning">
                                                                        <td colspan="5">
                                                                            <small class="text-warning">
                                                                                <i class="fas fa-exclamation-triangle"></i>
                                                                                Panelist "@panelistId" not found in SMS user list.
                                                                            </small>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                
                                                <!-- Residual Risk Summary -->
                                                @if (residualAverageScore.HasValue && completedResidualScores > 0)
                                                {
                                                    <div class="alert alert-success mt-2">
                                                        <div class="row align-items-center">
                                                            <div class="col-md-8">
                                                                <h6 class="mb-1">
                                                                    <i class="fas fa-shield-check text-success"></i> 
                                                                    <strong>Residual Risk Assessment Complete</strong>
                                                                </h6>
                                                                <p class="mb-0">
                                                                    <strong>Average Residual Score: @residualAverageScore.Value.ToString("F1")</strong> 
                                                                    (calculated from @completedResidualScores panelist scores)
                                                                </p>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="progress mb-2" style="height: 20px;">
                                                                    <div class="progress-bar bg-success" 
                                                                         style="width: @((completedResidualScores / (double)residualPanelMembers.Count) * 100)%">
                                                                        @completedResidualScores/@residualPanelMembers.Count
                                                                    </div>
                                                                </div>
                                                                <small class="text-muted">Completion Progress</small>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else if (residualPanelMembers.Count > 0)
                                                {
                                                    <div class="alert alert-info mt-2">
                                                        <i class="fas fa-info-circle"></i>
                                                        <strong>Residual Risk Assessment in Progress:</strong> 
                                                        @completedResidualScores of @residualPanelMembers.Count panelists have assessed the residual risk.
                                                        @if (completedResidualScores == 0)
                                                        {
                                                            <span class="text-muted">Ready for panelist scoring...</span>
                                                        }
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <p><i class="fas fa-info-circle text-info"></i> <strong>Mitigation strategies loaded.</strong> Assign a panel to assess residual risk after mitigation implementation.</p>
                                            }
                                        }
                                        else
                                        {
                                            <p>Residual risk assessment will appear here after mitigation strategies are defined.</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Monitoring Only for Acceptable Risks -->
                            <div class="alert alert-success">
                                <h6><i class="fas fa-eye"></i> Monitoring & Review Requirements</h6>
                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="form-label">Monitoring Frequency</label>
                                        <select class="form-select" name="MonitoringFrequency[@originalIndex]">
                                            <option value="">Select frequency...</option>
                                            <option value="Continuous">Continuous</option>
                                            <option value="Daily">Daily</option>
                                            <option value="Weekly">Weekly</option>
                                            <option value="Monthly">Monthly</option>
                                            <option value="Quarterly">Quarterly</option>
                                            <option value="Annually">Annually</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Responsible Department</label>
                                        <input type="text" class="form-control" name="MonitoringDepartment[@originalIndex]" 
                                               placeholder="Which department monitors?">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Review Trigger</label>
                                        <input type="text" class="form-control" name="ReviewTrigger[@originalIndex]" 
                                               placeholder="What triggers a review?">
                                    </div>
                                </div>
                            </div>
                        }
                        
                        <!-- Current Controls Display -->
                        @if (hazard.CurrentMitigations?.Any() == true)
                        {
                            <div class="alert alert-info mt-3">
                                <h6><i class="fas fa-shield"></i> Current Controls</h6>
                                <ul class="mb-0">
                                    @foreach (var control in hazard.CurrentMitigations)
                                    {
                                        <li>@control</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else if (allHazards.Any())
        {
            <!-- Show message for hazards without assessment -->
            <div class="text-center text-muted py-4">
                <i class="fas fa-balance-scale fa-3x mb-3"></i>
                <h5>Risk Assessment Required</h5>
                <p>@allHazards.Count hazards identified but need risk assessment before mitigation planning.</p>
                <a href="/SafetyRiskManagement/RiskAssessmentWizard/@Model.Id/step/4" class="btn btn-info">
                    <i class="fas fa-balance-scale"></i> Complete Step 4 - Risk Assessment
                </a>
            </div>
        }
        else
        {
            <!-- No hazards found -->
            <div class="text-center text-muted py-4">
                <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                <h5>No hazards found</h5>
                <p>Please complete the previous steps before proceeding with mitigation planning.</p>
                <div class="btn-group">
                    <a href="/SafetyRiskManagement/RiskAssessmentWizard/@Model.Id/step/2" class="btn btn-warning">
                        <i class="fas fa-exclamation-triangle"></i> Step 2 - Identify Hazards
                    </a>
                    <a href="/SafetyRiskManagement/RiskAssessmentWizard/@Model.Id/step/3" class="btn btn-info">
                        <i class="fas fa-chart-line"></i> Step 3 - Analyze Risk
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Residual Risk Scoring Panel Modal -->
<div class="modal fade" id="residualScoringPanelModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="fas fa-users"></i> <span id="residualModalTitle">Manage Residual Risk Scoring Panel</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info" id="currentResidualHazardInfo" style="display: none;">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Managing residual risk panel for:</strong> <span id="currentResidualHazardDisplay"></span>
                </div>
                
                <div class="card border-success">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0">
                            <i class="fas fa-check-square"></i> Select SMS Users for Residual Risk Assessment
                        </h6>
                    </div>
                    <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                        @if (Model.AvailableSMSUsers?.Any() == true)
                        {
                            <div class="alert alert-info mb-3">
                                <i class="fas fa-info-circle"></i>
                                <strong>Found @Model.AvailableSMSUsers.Count SMS Users:</strong> Select users to assess residual risk after mitigation implementation.
                            </div>
                            <div class="row">
                                @foreach (var smsUser in Model.AvailableSMSUsers)
                                {
                                    <div class="col-md-12 mb-3">
                                        <div class="card border-light">
                                            <div class="card-body p-3">
                                                <div class="form-check">
                                                    <input class="form-check-input residual-sms-user-checkbox" type="checkbox" 
                                                           name="selectedResidualSMSUsers" value="@smsUser.Id" 
                                                           id="residual_@smsUser.Id" 
                                                           data-user-id="@smsUser.Id"
                                                           data-user-name="@(smsUser.DisplayName ?? smsUser.Id)">
                                                    <label class="form-check-label w-100" for="residual_@smsUser.Id">
                                                        <div class="d-flex align-items-center">
                                                            <div class="me-3">
                                                                <i class="fas fa-user-tie text-info fa-2x"></i>
                                                            </div>
                                                            <div class="flex-grow-1">
                                                                <h6 class="mb-1">@(smsUser.DisplayName ?? smsUser.Id)</h6>
                                                                <p class="mb-1 text-muted">
                                                                    <i class="fas fa-envelope"></i> @smsUser.Email
                                                                </p>
                                                                <span class="badge bg-info">Residual Risk Assessor</span>
                                                            </div>
                                                        </div>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle"></i>
                                <strong>No SMS Users Available</strong><br>
                                Please load SMS users first.
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-info" onclick="assignResidualPanel()">
                    <i class="fas fa-users"></i> Update Residual Panel
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.mitigation-strategy {
    background-color: #fff8e1;
    border-left: 4px solid #ff9800;
}

.assignment-item {
    background-color: #f5f5f5 !important;
}

.residual-scoring-row {
    background-color: #f0f9ff;
}

.residual-scoring-row.table-success {
    background-color: #d4edda !important;
}

.residual-scoring-row.table-light {
    background-color: #f8f9fa !important;
}
</style>

<script>
// Global variables
let currentResidualHazardId = '';
let currentResidualHazardDescription = '';
let currentResidualHazardIndex = -1;
let mitigationCounters = {};
let assignmentCounters = {};

// Department options for assignments
const departmentOptions = [
    'Airport Operations', 'Safety Management', 'Maintenance & Engineering', 'Aircraft Rescue & Firefighting',
    'Airport Security', 'Air Traffic Control', 'Ground Handling Services', 'Cargo Operations',
    'Fuel Services', 'Facilities Management', 'IT & Telecommunications', 'Environmental Services',
    'Construction Management', 'Airline Operations', 'TSA', 'Customs & Border Protection',
    'Concessions & Retail', 'Parking Services', 'Administration', 'External Contractor'
];

// Initialize when DOM loads
document.addEventListener('DOMContentLoaded', function() {
    console.log('✅ Step 5 mitigation management and residual risk assessment initialized');
    
    // 🔧 CRITICAL FIX: Load hazards data from server-side model
    try {
        // Get hazards data from model (if available)
        window.assessmentHazards = [];
        @if (Model.AssessmentData?.IdentifiedHazards != null)
        {
            <text>
            window.assessmentHazards = @Html.Raw(Json.Serialize(Model.AssessmentData.IdentifiedHazards.Select(h => new {
                Id = h.Id,
                Description = h.Description ?? "",
                Category = h.Category ?? "",
                Severity = h.Severity ?? "",
                Likelihood = h.Likelihood ?? "",
                RiskLevel = h.RiskLevel ?? "",
                Tolerability = h.Tolerability ?? ""
            })));
            </text>
        }
        
        console.log('📋 Loaded ' + (window.assessmentHazards?.length || 0) + ' hazards for mitigation management');
    } catch (error) {
        console.error('❌ Error loading hazards data:', error);
        window.assessmentHazards = [];
    }
    
    // 🔧 CRITICAL FIX: Safe and simple data loading without complex serialization
    window.savedMitigationStrategies = {};
    window.savedResidualRiskAssessments = {};
    window.savedMonitoringRequirements = {};
    
    // Check if we have saved mitigation strategies
    @if (Model.SavedMitigationStrategies != null && Model.SavedMitigationStrategies.Any())
    {
        <text>
        try {
            console.log('📊 Found saved mitigation strategies in model for @Model.SavedMitigationStrategies.Count hazards');
            
            // Initialize empty object first
            window.savedMitigationStrategies = {};
            
            @foreach (var kvp in Model.SavedMitigationStrategies)
            {
                <text>
                try {
                    console.log('🔧 Processing strategies for hazard: @(kvp.Key)');
                    var hazardStrategies = @Html.Raw(Json.Serialize(kvp.Value ?? new List<object>()));
                    window.savedMitigationStrategies['@(kvp.Key)'] = hazardStrategies;
                    console.log('✅ Successfully loaded ' + hazardStrategies.length + ' strategies for @(kvp.Key)');
                    
                    // 🔧 DEBUG: Log the actual strategy data structure
                    console.log('🔍 DEBUG: Strategy data for @(kvp.Key):', hazardStrategies);
                    if (hazardStrategies.length > 0) {
                        console.log('🔍 DEBUG: First strategy structure:', hazardStrategies[0]);
                        console.log('🔍 DEBUG: First strategy keys:', Object.keys(hazardStrategies[0]));
                    }
                    
                    // 🔧 CRITICAL DEBUG: Test if the key was actually set
                    console.log('🔍 DEBUG: Immediate test - Object.keys after setting @(kvp.Key):', Object.keys(window.savedMitigationStrategies));
                    console.log('🔍 DEBUG: Immediate test - Can retrieve @(kvp.Key):', window.savedMitigationStrategies['@(kvp.Key)']);
                    
                } catch (hazardError) {
                    console.error('❌ Error loading strategies for @(kvp.Key):', hazardError);
                    window.savedMitigationStrategies['@(kvp.Key)'] = [];
                }
                </text>
            }
            
            console.log('📊 Total mitigation strategies loaded for ' + Object.keys(window.savedMitigationStrategies).length + ' hazards');
            
            // 🔧 DEBUG: Log the complete savedMitigationStrategies object
            console.log('🔍 DEBUG: Complete savedMitigationStrategies object:', window.savedMitigationStrategies);
        } catch (error) {
            console.error('❌ Error loading mitigation strategies:', error);
            window.savedMitigationStrategies = {};
        }
        </text>
    }
    else
    {
        <text>
        console.log('📋 No saved mitigation strategies found in model');
        window.savedMitigationStrategies = {};
        </text>
    }
    
    // 🔧 DEBUG: Log debug information for troubleshooting
    @if (Model.SavedMitigationStrategies != null)
    {
        <text>
        console.log('🔍 DEBUG: SavedMitigationStrategies analysis:');
        console.log('  - Total hazards with strategies: @Model.SavedMitigationStrategies.Count');
        @foreach (var kvp in Model.SavedMitigationStrategies)
        {
            <text>
            console.log('  - Hazard @(kvp.Key): @(kvp.Value?.Count ?? 0) strategies');
            </text>
        }
        
        // 🔧 DEBUG: Test the actual object contents right after loading
        console.log('🔍 DEBUG: Testing savedMitigationStrategies immediately after loading:');
        console.log('  - Object keys:', Object.keys(window.savedMitigationStrategies));
        console.log('  - Object values:', Object.values(window.savedMitigationStrategies));
        console.log('  - Object entries:', Object.entries(window.savedMitigationStrategies));
        console.log('  - HZ-0001 direct access:', window.savedMitigationStrategies['HZ-0001']);
        console.log('  - HZ-0001 hasOwnProperty:', window.savedMitigationStrategies.hasOwnProperty('HZ-0001'));
        
        // 🔧 DEBUG: Test different ways to access the data
        for (let key in window.savedMitigationStrategies) {
            console.log('🔍 DEBUG: Found key via for-in loop:', key, '=', window.savedMitigationStrategies[key]);
        }
        </text>
    }
    
    // 🔧 CONSOLIDATED DEBUG: Verify all required functions are defined AFTER loading data
    console.log('🔧 Checking function availability and debugging object state...');
    
    const allFunctions = {
        setCurrentResidualHazard: typeof setCurrentResidualHazard,
        assignResidualPanel: typeof assignResidualPanel,
        assignResidualPanelOnServer: typeof assignResidualPanelOnServer,
        addMitigationStrategy: typeof addMitigationStrategy,
        updateResidualRiskVisibility: typeof updateResidualRiskVisibility,
        reconstructSavedMitigationStrategies: typeof reconstructSavedMitigationStrategies
    };
    
    console.log('🔧 Function availability check:', allFunctions);
    
    // Check for missing critical functions
    const missingFunctions = Object.entries(allFunctions)
        .filter(([name, type]) => type === 'undefined')
        .map(([name]) => name);
        
    if (missingFunctions.length > 0) {
        console.error('❌ Missing functions:', missingFunctions);
        
        // Try to define missing functions with basic implementations
        if (typeof addMitigationStrategy === 'undefined') {
            console.log('🔧 Creating fallback addMitigationStrategy function');
            window.addMitigationStrategy = function(hazardIndex) {
                console.log('❌ addMitigationStrategy called but not properly defined for hazard index:', hazardIndex);
                alert('Add Mitigation Strategy function is not available. Please check console for errors.');
            };
        }
        
        if (typeof setCurrentResidualHazard === 'undefined') {
            console.log('🔧 Creating fallback setCurrentResidualHazard function');
            window.setCurrentResidualHazard = function(hazardId, hazardDescription, hazardIndex) {
                console.log('❌ setCurrentResidualHazard called but not properly defined:', hazardId);
                alert('Residual Risk Panel function is not available. Please check console for errors.');
            };
        }
        
        if (typeof assignResidualPanel === 'undefined') {
            console.log('🔧 Creating fallback assignResidualPanel function');
            window.assignResidualPanel = function() {
                console.log('❌ assignResidualPanel called but not properly defined');
                alert('Assign Residual Panel function is not available. Please check console for errors.');
            };
        }
    } else {
        console.log('✅ All required functions are defined');
    }
    
    // 🔧 CRITICAL DEBUG: Re-check the object right before calling reconstruction
    console.log('🔍 DEBUG: Final check before reconstruction:');
    console.log('  - savedMitigationStrategies keys:', Object.keys(window.savedMitigationStrategies || {}));
    console.log('  - savedMitigationStrategies object:', window.savedMitigationStrategies);
    
    // 🔧 CRITICAL FIX: Reconstruct saved mitigation strategies on page load
    setTimeout(() => {
        try {
            // 🔧 DEBUG: One more check right in setTimeout
            console.log('🔍 DEBUG: In setTimeout - savedMitigationStrategies keys:', Object.keys(window.savedMitigationStrategies || {}));
            reconstructSavedMitigationStrategies();
            
            // 🔧 NEW: Debug residual risk scoring interface after reconstruction
            setTimeout(() => {
                console.log('🔍 DEBUG: Checking residual risk scoring interface after reconstruction...');
                
                // Check all residual risk sections
                document.querySelectorAll('[id^="residualRisk"]').forEach(section => {
                    const hazardIndex = section.id.replace('residualRisk', '');
                    const isVisible = section.style.display !== 'none';
                    const cardBody = section.querySelector('.card-body');
                    const scoringTable = section.querySelector('.table-responsive');
                    const managePanelButton = section.querySelector('button[data-bs-target="#residualScoringPanelModal"]');
                    
                    console.log(`🔍 DEBUG: Hazard ${hazardIndex} residual section - Visible: ${isVisible}, HasTable: ${!!scoringTable}, HasButton: ${!!managePanelButton}`);
                    
                    if (cardBody) {
                        const textContent = cardBody.textContent || '';
                        if (textContent.includes('No Risk Assessment') || textContent.includes('scoring panel loaded')) {
                            console.log(`❌ ISSUE: Hazard ${hazardIndex} shows "No Risk Assessment" message`);
                        } else if (textContent.includes('Mitigation strategies loaded')) {
                            console.log(`✅ GOOD: Hazard ${hazardIndex} shows mitigation strategies loaded message`);
                            
                            // Check if there's a panel assignment
                            const panelMessage = cardBody.textContent;
                            if (panelMessage.includes('panel members ready')) {
                                console.log(`✅ EXCELLENT: Hazard ${hazardIndex} has residual panel assigned`);
                            } else if (panelMessage.includes('Assign a panel')) {
                                console.log(`📋 INFO: Hazard ${hazardIndex} needs residual panel assignment`);
                            }
                        }
                    }
                });
            }, 100);
            
        } catch (error) {
            console.error('❌ Error reconstructing mitigation strategies:', error);
        }
    }, 500);
});

// 🔧 NEW: Reconstruct saved mitigation strategies from server data
function reconstructSavedMitigationStrategies() {
    console.log('🔧 Starting reconstruction of saved mitigation strategies');
    
    // 🔧 DEBUG: Log what data structures we have available
    console.log('🔍 DEBUG: Reconstruction - window.savedMitigationStrategies:', window.savedMitigationStrategies);
    console.log('🔍 DEBUG: Reconstruction - window.assessmentHazards:', window.assessmentHazards);
    
    if (!window.savedMitigationStrategies || !window.assessmentHazards) {
        console.log('📋 No saved strategies or hazards to reconstruct');
        return;
    }
    
    // 🔧 DEBUG: Check what keys are available
    const availableStrategies = Object.keys(window.savedMitigationStrategies);
    const availableHazards = window.assessmentHazards.map(h => h.Id || h.id);
    console.log('🔍 DEBUG: Available strategy keys:', availableStrategies);
    console.log('🔍 DEBUG: Available hazard IDs:', availableHazards);
    
    // 🔧 DEBUG: Check what mitigation containers exist in the DOM
    const allMitigationContainers = document.querySelectorAll('[id^="mitigationsList"]');
    console.log('🔍 DEBUG: Found mitigation containers in DOM:', Array.from(allMitigationContainers).map(el => el.id));
    
    // Loop through each hazard and reconstruct their saved strategies
    window.assessmentHazards.forEach((hazard, hazardIndex) => {
        const hazardId = hazard.Id || hazard.id;
        if (!hazardId) {
            console.log('⚠️ DEBUG: Hazard at index ' + hazardIndex + ' has no ID');
            return;
        }
        
        console.log('🔧 DEBUG: Processing hazard ' + hazardIndex + ' with ID: ' + hazardId);
        
        const savedStrategies = window.savedMitigationStrategies[hazardId];
        console.log('🔍 DEBUG: Retrieved strategies for ' + hazardId + ':', savedStrategies);
        
        if (!savedStrategies || !Array.isArray(savedStrategies)) {
            console.log('📋 No saved strategies found for hazard:', hazardId, '(Expected array, got:', typeof savedStrategies, ')');
            return;
        }
        
        console.log('🔧 Reconstructing', savedStrategies.length, 'strategies for hazard:', hazardId);
        
        // Clear existing placeholder in mitigations list
        const container = document.getElementById(`mitigationsList${hazardIndex}`);
        console.log('🔍 DEBUG: Looking for container:', `mitigationsList${hazardIndex}`, 'Found:', !!container);
        
        if (container) {
            // Log container state before clearing
            console.log('🔍 DEBUG: Container innerHTML before clearing (length):', container.innerHTML.length);
            console.log('🔍 DEBUG: Container innerHTML before clearing (first 200 chars):', container.innerHTML.substring(0, 200));
            
            const placeholder = container.querySelector('.alert');
            console.log('🔍 DEBUG: Found placeholder alert to remove:', !!placeholder);
            if (placeholder) {
                console.log('🔍 DEBUG: Removing placeholder:', placeholder.textContent.substring(0, 50));
                placeholder.remove();
            }
            
            // Log container state after clearing
            console.log('🔍 DEBUG: Container innerHTML after clearing (length):', container.innerHTML.length);
        } else {
            console.error('❌ Could not find container mitigationsList' + hazardIndex);
            return;
        }
        
        // Initialize counters for this hazard
        if (!mitigationCounters[hazardIndex]) {
            mitigationCounters[hazardIndex] = 0;
        }
        
        // Reconstruct each saved strategy
        savedStrategies.forEach((strategyData, strategyIndex) => {
            console.log('🔧 DEBUG: Reconstructing strategy ' + strategyIndex + ' with data:', strategyData);
            reconstructSingleMitigationStrategy(hazardIndex, strategyIndex, strategyData);
            mitigationCounters[hazardIndex] = Math.max(mitigationCounters[hazardIndex], strategyIndex + 1);
        });
        
        // 🔧 CRITICAL DEBUG: Check final container state
        const finalContainer = document.getElementById(`mitigationsList${hazardIndex}`);
        if (finalContainer) {
            const finalStrategies = finalContainer.querySelectorAll('.mitigation-strategy');
            console.log('🔍 DEBUG: Final container strategies count:', finalStrategies.length);
            console.log('🔍 DEBUG: Final container innerHTML length:', finalContainer.innerHTML.length);
            console.log('🔍 DEBUG: Final container innerHTML (first 300 chars):', finalContainer.innerHTML.substring(0, 300));
        }
        
        // 🔧 CRITICAL FIX: Update residual risk visibility AFTER all strategies are reconstructed
        updateResidualRiskVisibility(hazardIndex);
        
        console.log('✅ Reconstructed', savedStrategies.length, 'strategies for hazard:', hazardId);
    });
    
    console.log('✅ Completed reconstruction of all saved mitigation strategies');
    
    // 🔧 NEW: Update all hazard card headers to reflect loaded strategies
    updateHazardCardHeaders();
}

// 🔧 NEW: Update hazard card headers to show correct mitigation status
function updateHazardCardHeaders() {
    console.log('🔧 Updating hazard card headers based on loaded strategies');
    
    if (!window.assessmentHazards) return;
    
    window.assessmentHazards.forEach((hazard, hazardIndex) => {
        const hazardId = hazard.Id || hazard.id;
        if (!hazardId) return;
        
        const container = document.getElementById(`mitigationsList${hazardIndex}`);
        if (!container) return;
        
        const strategies = container.querySelectorAll('.mitigation-strategy');
        const strategyCount = strategies.length;
        
        // Find the card header status element using the data attribute
        const statusElement = document.querySelector(`[data-hazard-status="${hazardIndex}"]`);
        if (!statusElement) {
            console.log('⚠️ Could not find status element for hazard index', hazardIndex);
            return;
        }
        
        // Update the status text based on loaded strategies
        if (strategyCount > 0) {
            statusElement.innerHTML = `
                <i class="fas fa-shield-alt"></i> <strong>Mitigation Strategies Defined</strong>
                <br><small>${strategyCount} strategies loaded</small>
            `;
            
            // Also update the card border and header color to info (blue) to indicate mitigation is in progress
            const card = statusElement.closest('.card');
            if (card) {
                card.className = card.className.replace(/border-(warning|success)/, 'border-info');
                const cardHeader = card.querySelector('.card-header');
                if (cardHeader) {
                    cardHeader.className = cardHeader.className
                        .replace(/bg-(warning|success)/, 'bg-info')
                        .replace(/text-dark/, 'text-white');
                }
            }
            
            console.log('✅ Updated header for hazard', hazardId, 'with', strategyCount, 'strategies');
        }
    });
}

// 🔧 NEW: Reconstruct a single mitigation strategy with all its data
function reconstructSingleMitigationStrategy(hazardIndex, strategyIndex, strategyData) {
    console.log('🔧 Reconstructing strategy', strategyIndex, 'for hazard', hazardIndex, ':', strategyData);
    
    const strategyKey = `${hazardIndex}-${strategyIndex}`;
    if (!assignmentCounters[strategyKey]) {
        assignmentCounters[strategyKey] = 0;
    }
    
    const departmentOptionsHtml = departmentOptions.map(dept => 
        `<option value="${dept}" ${strategyData.controlType === dept ? 'selected' : ''}>${dept}</option>`
    ).join('');
    
    // Create strategy HTML with populated data
    const mitigationHtml = `
        <div class="mitigation-strategy border rounded p-3 mb-3" data-strategy-index="${strategyIndex}">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0"><i class="fas fa-shield-alt text-primary"></i> Mitigation Strategy ${strategyIndex + 1}</h6>
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeStrategy(${hazardIndex}, ${strategyIndex})">
                    <i class="fas fa-trash"></i> Remove Strategy
                </button>
            </div>
            
            <div class="row mb-3">
                <div class="col-md-8">
                    <label class="form-label">Strategy Description <span class="text-danger">*</span></label>
                    <textarea class="form-control mitigation-field" name="MitigationStrategies[${hazardIndex}][${strategyIndex}][Description]" 
                              rows="2" placeholder="Describe the mitigation strategy in detail..." required 
                              onchange="saveMitigationData(${hazardIndex}, ${strategyIndex})">${strategyData.description || ''}</textarea>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Control Type <span class="text-danger">*</span></label>
                    <select class="form-select mitigation-field" name="MitigationStrategies[${hazardIndex}][${strategyIndex}][ControlType]" required
                            onchange="saveMitigationData(${hazardIndex}, ${strategyIndex})">
                        <option value="">Select control type...</option>
                        <option value="Eliminate" ${strategyData.controlType === 'Eliminate' ? 'selected' : ''}>Eliminate</option>
                        <option value="Substitute" ${strategyData.controlType === 'Substitute' ? 'selected' : ''}>Substitute</option>
                        <option value="Engineering" ${strategyData.controlType === 'Engineering' ? 'selected' : ''}>Engineering Control</option>
                        <option value="Warning" ${strategyData.controlType === 'Warning' ? 'selected' : ''}>Warning/Signage</option>
                        <option value="Administrative" ${strategyData.controlType === 'Administrative' ? 'selected' : ''}>Administrative Control</option>
                        <option value="PPE" ${strategyData.controlType === 'PPE' ? 'selected' : ''}>Personal Protective Equipment</option>
                    </select>
                </div>
            </div>
            
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label">Priority <span class="text-danger">*</span></label>
                    <select class="form-select mitigation-field" name="MitigationStrategies[${hazardIndex}][${strategyIndex}][Priority]" required
                            onchange="saveMitigationData(${hazardIndex}, ${strategyIndex})">
                        <option value="">Select priority...</option>
                        <option value="Critical" ${strategyData.priority === 'Critical' ? 'selected' : ''}>Critical</option>
                        <option value="High" ${strategyData.priority === 'High' ? 'selected' : ''}>High</option>
                        <option value="Medium" ${strategyData.priority === 'Medium' ? 'selected' : ''}>Medium</option>
                        <option value="Low" ${strategyData.priority === 'Low' ? 'selected' : ''}>Low</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Target Date <span class="text-danger">*</span></label>
                    <input type="date" class="form-control mitigation-field" name="MitigationStrategies[${hazardIndex}][${strategyIndex}][TargetDate]" required
                           value="${formatDateForInput(strategyData.targetDate)}" onchange="saveMitigationData(${hazardIndex}, ${strategyIndex})">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Estimated Cost</label>
                    <input type="number" class="form-control mitigation-field" name="MitigationStrategies[${hazardIndex}][${strategyIndex}][EstimatedCost]" 
                           placeholder="0.00" step="0.01" min="0" value="${strategyData.estimatedCost || 0}" onchange="saveMitigationData(${hazardIndex}, ${strategyIndex})">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select class="form-select mitigation-field" name="MitigationStrategies[${hazardIndex}][${strategyIndex}][Status]"
                            onchange="saveMitigationData(${hazardIndex}, ${strategyIndex})">
                        <option value="Planned" ${strategyData.status === 'Planned' ? 'selected' : ''}>Planned</option>
                        <option value="In Progress" ${strategyData.status === 'In Progress' ? 'selected' : ''}>In Progress</option>
                        <option value="Completed" ${strategyData.status === 'Completed' ? 'selected' : ''}>Completed</option>
                        <option value="On Hold" ${strategyData.status === 'On Hold' ? 'selected' : ''}>On Hold</option>
                    </select>
                </div>
            </div>
            
            <!-- Assignments Section -->
            <div class="assignments-section">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0"><i class="fas fa-users text-info"></i> Assignments</h6>
                    <button type="button" class="btn btn-outline-info btn-sm" onclick="addAssignment(${hazardIndex}, ${strategyIndex})">
                        <i class="fas fa-plus"></i> Add Assignment
                    </button>
                </div>
                <div id="assignments-${hazardIndex}-${strategyIndex}" class="assignments-container">
                    <!-- Assignments will be populated by reconstructAssignments -->
                </div>
            </div>
        </div>
    `;
    
    const container = document.getElementById(`mitigationsList${hazardIndex}`);
    console.log('🔍 DEBUG: Looking for container:', `mitigationsList${hazardIndex}`, 'Found:', !!container);
    
    if (container) {
        // Log current container content before insertion
        const currentContent = container.innerHTML.trim();
        console.log('🔍 DEBUG: Container current content length:', currentContent.length);
        console.log('🔍 DEBUG: Container current content (first 100 chars):', currentContent.substring(0, 100));
        
        container.insertAdjacentHTML('beforeend', mitigationHtml);
        
        // Verify the content was inserted
        const newContent = container.innerHTML.trim();
        console.log('🔍 DEBUG: Container after insertion length:', newContent.length);
        
        const strategies = container.querySelectorAll('.mitigation-strategy');
        console.log('🔍 DEBUG: Total strategies in container after insertion:', strategies.length);
        
        // Reconstruct assignments for this strategy
        if (strategyData.assignments && Array.isArray(strategyData.assignments)) {
            console.log('🔧 Reconstructing', strategyData.assignments.length, 'assignments for strategy', strategyIndex);
            reconstructAssignments(hazardIndex, strategyIndex, strategyData.assignments);
        } else {
            console.log('🔧 No assignments found, adding empty assignment for strategy', strategyIndex);
            // Add one empty assignment if no saved assignments
            addAssignment(hazardIndex, strategyIndex);
        }
        
        console.log('✅ Reconstructed strategy', strategyIndex, 'with', (strategyData.assignments || []).length, 'assignments');
    } else {
        console.error('❌ Could not find mitigations container for hazard index', hazardIndex);
        console.error('❌ Expected ID:', `mitigationsList${hazardIndex}`);
        
        // Try to find all elements with similar IDs
        const allMitigationElements = document.querySelectorAll('[id^="mitigationsList"]');
