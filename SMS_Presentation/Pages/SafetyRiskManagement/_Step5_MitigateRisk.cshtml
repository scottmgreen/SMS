/**
 * Submit residual risk score
 */
async function submitResidualScore(memberId, residualHazardId) {
    console.log('📤 Submitting residual score for member ' + memberId + ' on ' + residualHazardId);
    
    const rowId = 'residual-scoring-row-' + residualHazardId.replace('residual-', '') + '-' + memberId;
    const row = document.getElementById(rowId);
    
    if (!row) {
        console.error('❌ Residual row not found: ' + rowId);
        alert('Error: Could not find residual scoring row. Please refresh the page.');
        return;
    }
    
    const severitySelect = row.querySelector('.severity-select');
    const likelihoodSelect = row.querySelector('.likelihood-select');
    const submitBtn = row.querySelector('.submit-btn');
    
    if (!severitySelect || !likelihoodSelect || !submitBtn) {
        console.error('❌ Missing residual form elements');
        alert('Error: Missing form elements. Please refresh the page.');
        return;
    }
    
    const severity = parseInt(severitySelect.value);
    const likelihood = parseInt(likelihoodSelect.value);
    
    if (!severity || !likelihood) {
        alert('Please select both residual severity and likelihood before submitting.');
        return;
    }
    
    const score = severity * likelihood;
    
    try {
        // Show loading state
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';
        
        console.log('📤 Submitting residual score: Severity=' + severity + ', Likelihood=' + likelihood + ', Score=' + score);
        
        // Get form data
        const assessmentIdField = document.querySelector('input[name="Id"]');
        const tokenField = document.querySelector('input[name="__RequestVerificationToken"]');
        
        if (!assessmentIdField || !tokenField) {
            throw new Error('Missing form fields');
        }
        
        // Create form data for submission
        const formData = new FormData();
        formData.append('hazardId', residualHazardId);
        formData.append('memberId', memberId);
        formData.append('severityScore', severity.toString());
        formData.append('likelihoodScore', likelihood.toString());
        formData.append('Id', assessmentIdField.value);
        formData.append('StepNumber', '5');
        formData.append('__RequestVerificationToken', tokenField.value);
        
        console.log('📤 Submitting residual score data for ' + residualHazardId + '/' + memberId);
        
        // Submit to server
        const response = await fetch(window.location.pathname + '?handler=SubmitResidualScore', {
            method: 'POST',
            body: formData
        });
        
        if (response.ok) {
            const result = await response.json();
            console.log('✅ Residual score submission response:', result);
            
            if (result.success) {
                console.log('✅ Residual score submitted for ' + residualHazardId + ': ' + score);
                
                // Show success message
                alert('✅ Residual risk score submitted successfully!\n\nScore: ' + score + '\nThe page will refresh to show updated results.');
                
                // Refresh page after a short delay to show updated data
                setTimeout(function() {
                    window.location.reload();
                }, 2000);
            } else {
                console.error('❌ Failed to submit residual score: ' + (result.message || 'Unknown error'));
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
                alert('Failed to submit residual score: ' + (result.message || 'Unknown error'));
            }
        } else {
            throw new Error('Server responded with ' + response.status + ': ' + response.statusText);
        }
        
    } catch (error) {
        console.error('💥 Error submitting residual score:', error);
        alert('Error submitting residual score. Please try again.');
        
        // Restore button
        const submitBtn = row.querySelector('.submit-btn');
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-save"></i> Submit';
        }
    }
}

/**
 * Edit existing residual score (convert back to dropdowns)
 */
function editResidualScore(memberId, residualHazardId, currentSeverity, currentLikelihood) {
    console.log('✏️ Editing residual score for member ' + memberId + ' on ' + residualHazardId);
    
    const rowId = 'residual-scoring-row-' + residualHazardId.replace('residual-', '') + '-' + memberId;
    const row = document.getElementById(rowId);
    
    if (!row) {
        console.error('❌ Residual row not found: ' + rowId);
        return;
    }
    
    // Convert back to editing mode
    row.classList.remove('table-success');
    row.classList.add('table-light');
    
    // Restore dropdown controls
    const severityCell = row.children[1];
    severityCell.innerHTML = 
        '<select class="form-select form-select-sm severity-select" name="residualSeverityScore" onchange="calculateResidualScore(\'' + rowId + '\')" required>' +
        '<option value="">Select Severity...</option>' +
        '<option value="1"' + (currentSeverity === 1 ? ' selected' : '') + '>1 - Minor Impact</option>' +
        '<option value="2"' + (currentSeverity === 2 ? ' selected' : '') + '>2 - Moderate Impact</option>' +
        '<option value="3"' + (currentSeverity === 3 ? ' selected' : '') + '>3 - Serious Impact</option>' +
        '<option value="4"' + (currentSeverity === 4 ? ' selected' : '') + '>4 - Major Impact</option>' +
        '<option value="5"' + (currentSeverity === 5 ? ' selected' : '') + '>5 - Catastrophic Impact</option>' +
        '</select>' +
        '<small class="text-muted">After mitigation</small>';
    
    const likelihoodCell = row.children[2];
    likelihoodCell.innerHTML = 
        '<select class="form-select form-select-sm likelihood-select" name="residualLikelihoodScore" onchange="calculateResidualScore(\'' + rowId + '\')" required>' +
        '<option value="">Select Likelihood...</option>' +
        '<option value="1"' + (currentLikelihood === 1 ? ' selected' : '') + '>1 - Rare (A)</option>' +
        '<option value="2"' + (currentLikelihood === 2 ? ' selected' : '') + '>2 - Unlikely (B)</option>' +
        '<option value="3"' + (currentLikelihood === 3 ? ' selected' : '') + '>3 - Possible (C)</option>' +
        '<option value="4"' + (currentLikelihood === 4 ? ' selected' : '') + '>4 - Likely (D)</option>' +
        '<option value="5"' + (currentLikelihood === 5 ? ' selected' : '') + '>5 - Frequent (E)</option>' +
        '</select>' +
        '<small class="text-muted">After mitigation</small>';
    
    const scoreCell = row.children[3];
    scoreCell.innerHTML = 
        '<div class="score-display badge bg-info fs-6 p-2">' + (currentSeverity * currentLikelihood).toFixed(1) + '</div>' +
        '<br><small class="text-muted">Auto-calculated</small>';
    
    const actionCell = row.children[4];
    actionCell.innerHTML = 
        '<button type="button" class="btn btn-success btn-sm submit-btn" onclick="submitResidualScore(\'' + memberId + '\', \'' + residualHazardId + '\')">' +
        '<i class="fas fa-save"></i> Submit' +
        '</button>';
    
    // Update user info badge
    const userInfoCell = row.children[0];
    const badge = userInfoCell.querySelector('.badge');
    if (badge) {
        badge.className = 'badge bg-warning mt-1';
        badge.innerHTML = '<i class="fas fa-clock"></i> Pending';
    }
}
</script>

@functions {
    private string GetSeverityLabel(int severity)
    {
        return severity switch
        {
            1 => "Minor",
            2 => "Moderate", 
            3 => "Serious",
            4 => "Major",
            5 => "Catastrophic",
            _ => "Unknown"
        };
    }
    
    private string GetLikelihoodLabel(int likelihood)
    {
        return likelihood switch
        {
            1 => "Rare",
            2 => "Unlikely",
            3 => "Possible", 
            4 => "Likely",
            5 => "Frequent",
            _ => "Unknown"
        };
    }
}