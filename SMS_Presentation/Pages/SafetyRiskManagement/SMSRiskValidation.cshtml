        }
        
        /* Required field asterisk styling */
        .text-danger {
            color: #dc3545 !important;
        }
        
        /* Enhanced validation message styling */
        span.text-danger.small {
            font-size: 0.75rem;
            margin-top: 0.25rem;
            display: block;
        }

        /* Minimum Dataset Help Popover Styling */
        .minimum-dataset-help-popover {
            max-width: 350px;
        }

        .minimum-dataset-help-popover .popover-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
            font-weight: 600;
            font-size: 0.875rem;
        }

        .minimum-dataset-help-popover .popover-body {
            font-size: 0.8rem;
            padding: 0.75rem;
        }

        .minimum-dataset-help-popover .popover-body ul {
            margin-bottom: 0;
            padding-left: 1.2rem;
        }

        .minimum-dataset-help-popover .popover-body li {
            margin-bottom: 0.25rem;
            line-height: 1.4;
        }

        /* Help button hover effect for dataset cards */
        .card-header .btn-outline-secondary:hover {
            background-color: rgba(108, 117, 125, 0.1);
            border-color: rgba(108, 117, 125, 0.3);
        }

        /* Ensure popovers appear above other elements */
        .popover {
            z-index: 1060;
        }

        /* Minimum dataset cards styling */
        #smsRiskMinimumDatasetCards .card {
            border: 1px solid #dee2e6;
        }

        #smsRiskMinimumDatasetCards .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }

        #smsRiskMinimumDatasetCards .card-body {
            padding: 0.75rem;
        }

        /* Improved guidance panel styling */
        #mitigationGuidance .table td {
            vertical-align: middle;
            padding: 0.5rem;
        }

        #mitigationGuidance .table td:first-child {
            width: 60px;
        }

        #mitigationGuidance .alert {
            margin-bottom: 0.5rem;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Disable jQuery validation for conditional fields if it exists
            if (typeof $ !== 'undefined' && $.validator) {
                // Remove validation rules for conditional fields
                const conditionalFields = ['ClosureReason', 'ReferralAction', 'InformationNeeded', 'PriorityOverride'];
                conditionalFields.forEach(fieldName => {
                    const field = $(`[name="${fieldName}"]`);
                    if (field.length > 0) {
                        field.rules('remove');
                        // Remove any existing validation messages
                        field.next('.field-validation-error').remove();
                        field.removeClass('input-validation-error');
                    }
                });
            }
            
            // Get all radio buttons with the radio-trigger class
            const radioButtons = document.querySelectorAll('.radio-trigger');
            const conditionalFields = {
                'sms_risk': document.getElementById('smsRiskFields'),
                'not_sms_risk': document.getElementById('notSmsRiskFields'),
                'investigation': document.getElementById('investigationFields')
            };

            // Minimum dataset elements
            const smsRiskDatasetCards = document.getElementById('smsRiskMinimumDatasetCards');

            // Initialize Bootstrap popovers for help buttons
            initializeMinimumDatasetPopovers();

            // Function to hide all conditional fields
            function hideAllConditionalFields() {
                Object.values(conditionalFields).forEach(field => {
                    if (field) {
                        field.style.display = 'none';
                    }
                });
            }

            // Function to show the appropriate conditional fields
            function showConditionalFields(selectedValue) {
                hideAllConditionalFields();
                
                if (conditionalFields[selectedValue]) {
                    conditionalFields[selectedValue].style.display = 'block';
                    
                    // Smooth scroll to the conditional fields
                    setTimeout(() => {
                        conditionalFields[selectedValue].scrollIntoView({ 
                            behavior: 'smooth', 
                            block: 'start' 
                        });
                    }, 100);
                }

                // Handle minimum dataset cards visibility
                if (selectedValue === 'sms_risk') {
                    if (smsRiskDatasetCards) smsRiskDatasetCards.style.display = 'block';
                } else {
                    if (smsRiskDatasetCards) smsRiskDatasetCards.style.display = 'none';
                }
                
                // Clear validation errors for hidden conditional fields
                clearConditionalValidationErrors(selectedValue);
            }

            // Function to clear validation errors for conditional fields that should not be validated
            function clearConditionalValidationErrors(selectedValue) {
                // Define which fields should be cleared based on the selected value
                const fieldsTolear = [];
                
                switch(selectedValue) {
                    case 'sms_risk':
                        // For SMS Risk, clear validation for non-SMS and investigation fields
                        fieldsTolear.push('ClosureReason', 'ReferralAction', 'InformationNeeded');
                        break;
                    case 'not_sms_risk':
                        // For Non-SMS Risk, clear validation for SMS and investigation fields  
                        fieldsTolear.push('InformationNeeded');
                        break;
                    case 'investigation':
                        // For Investigation, clear validation for SMS and non-SMS fields
                        fieldsTolear.push('ClosureReason', 'ReferralAction');
                        break;
                }
                
                // Always clear PriorityOverride as it's optional
                fieldsTolear.push('PriorityOverride');
                
                // Clear validation errors
                fieldsTolear.forEach(fieldName => {
                    const field = document.querySelector(`[name="${fieldName}"]`);
                    if (field) {
                        // Remove validation classes
                        field.classList.remove('is-invalid', 'input-validation-error');
                        
                        // Remove validation messages
                        const validationMessage = field.parentElement.querySelector('.invalid-feedback, .field-validation-error');
                        if (validationMessage) {
                            validationMessage.remove();
                        }
                        
                        // Clear jQuery validation if it exists
                        if (typeof $ !== 'undefined' && $.validator) {
                            $(field).rules('remove');
                        }
                    }
                });
            }

            // Function to update card styling
            function updateCardStyling(selectedValue) {
                // Reset all cards to default styling
                document.querySelectorAll('.card.h-100').forEach(card => {
                    card.classList.remove('border-success', 'border-danger', 'border-warning', 'bg-light');
                    card.classList.add('border-light');
                });

                // Apply styling to selected card
                const radioButton = document.querySelector(`input[value="${selectedValue}"]`);
                if (radioButton) {
                    const card = radioButton.closest('.card');
                    if (card) {
                        card.classList.remove('border-light');
                        card.classList.add('bg-light');
                        
                        switch(selectedValue) {
                            case 'sms_risk':
                                card.classList.add('border-success');
                                break;
                            case 'not_sms_risk':
                                card.classList.add('border-danger');
                                break;
                            case 'investigation':
                                card.classList.add('border-warning');
                                break;
                        }
                    }
                }
            }

            // Add event listeners to all radio buttons
            radioButtons.forEach(radio => {
                radio.addEventListener('change', function() {
                    if (this.checked) {
                        const selectedValue = this.value;
                        console.log('🎯 Radio button selected:', selectedValue);
                        console.log('🎯 Available conditional fields:', Object.keys(conditionalFields));
                        console.log('🎯 Target field element:', conditionalFields[selectedValue]);
                        
                        // Update card styling
                        updateCardStyling(selectedValue);
                        
                        // Show appropriate conditional fields
                        showConditionalFields(selectedValue);
                    }
                });
            });

            // Show appropriate fields on page load if a selection exists
            const checkedRadio = document.querySelector('.radio-trigger:checked');
            if (checkedRadio) {
                const selectedValue = checkedRadio.value;
                console.log('🎯 Page load - Found checked radio:', selectedValue);
                updateCardStyling(selectedValue);
                showConditionalFields(selectedValue);
            } else {
                console.log('🎯 Page load - No checked radio found');
            }

            // ========================================
            // MINIMUM DATASET POPOVERS INITIALIZATION
            // ========================================

            function initializeMinimumDatasetPopovers() {
                // Initialize all popovers
                var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
                var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
                    return new bootstrap.Popover(popoverTriggerEl, {
                        container: 'body',
                        sanitize: false,
                        customClass: 'minimum-dataset-help-popover'
                    });
                });
                
                // Close other popovers when one is opened
                popoverTriggerList.forEach(function(popoverTriggerEl) {
                    popoverTriggerEl.addEventListener('show.bs.popover', function () {
                        // Hide all other popovers
                        popoverList.forEach(function(popoverInstance) {
                            if (popoverInstance._element !== popoverTriggerEl) {
                                popoverInstance.hide();
                            }
                        });
                    });
                });
                
                // Close popover when clicking outside
                document.addEventListener('click', function (e) {
                    var isPopoverButton = e.target.closest('[data-bs-toggle="popover"]');
                    var isPopoverContent = e.target.closest('.popover');
                    
                    if (!isPopoverButton && !isPopoverContent) {
                        popoverList.forEach(function(popoverInstance) {
                            popoverInstance.hide();
                        });
                    }
                });
            }

            // ========================================
            // MINIMUM DATASET DYNAMIC BEHAVIOR
            // ========================================

            // Location Area sub-fields
            const locationArea = document.getElementById('locationArea');
            const subLocationContainer = document.getElementById('subLocationContainer');
            const locationSubArea = document.getElementById('locationSubArea');
            const otherLocationContainer = document.getElementById('otherLocationContainer');

            if (locationArea) {
                locationArea.addEventListener('change', function() {
                    const selectedArea = this.value;
                    
                    // Show/hide sub-location fields
                    if (selectedArea && selectedArea !== 'Other') {
                        subLocationContainer.style.display = 'block';
                        otherLocationContainer.style.display = 'none';
                        
                        // Clear existing options
                        locationSubArea.innerHTML = '<option value="">Select specific area...</option>';
                        
                        // Populate sub-area options based on selection
                        let subOptions = [];
                        switch(selectedArea) {
                            case 'Movement Area':
                                subOptions = ['Runway', 'Taxiway', 'Apron'];
                                break;
                            case 'Non-movement Area':
                                subOptions = ['Ramp', 'Baggage Tunnel', 'Fuel Farm', 'Terminal Building', 'Cargo Area', 'Maintenance Area'];
                                break;
                        }
                        
                        subOptions.forEach(option => {
                            const optionElement = document.createElement('option');
                            optionElement.value = option;
                            optionElement.textContent = option;
                            locationSubArea.appendChild(optionElement);
                        });
                    } else if (selectedArea === 'Other') {
                        subLocationContainer.style.display = 'none';
                        otherLocationContainer.style.display = 'block';
                    } else {
                        subLocationContainer.style.display = 'none';
                        otherLocationContainer.style.display = 'none';
                    }
                });
            }

            // Triggering Event - show/hide involved components
            const triggeringEvent = document.getElementById('triggeringEvent');
            const involvedComponentsSection = document.getElementById('involvedComponentsSection');

            if (triggeringEvent && involvedComponentsSection) {
                triggeringEvent.addEventListener('change', function() {
                    const selectedEvent = this.value;
                    const showComponents = [
                        'Aircraft Accident',
                        'Aircraft Incident', 
                        'Surface Incident (Movement)',
                        'Surface Incident (Non-movement)'
                    ].includes(selectedEvent);
                    
                    involvedComponentsSection.style.display = showComponents ? 'block' : 'none';
                });
            }

            // Initialize dynamic fields on page load
            setTimeout(() => {
                if (locationArea && locationArea.value) {
                    locationArea.dispatchEvent(new Event('change'));
                }
                if (triggeringEvent && triggeringEvent.value) {
                    triggeringEvent.dispatchEvent(new Event('change'));
                }
            }, 500);

            // Initialize popovers for help buttons
            const popoverTriggers = document.querySelectorAll('[data-bs-toggle="popover"]');
            if (popoverTriggers) {
                const popoverList = [];

                // Initialize all popovers
                popoverTriggers.forEach(trigger => {
                    const popoverInstance = new bootstrap.Popover(trigger, {
                        html: true,
                        trigger: 'click',
                        placement: 'left',
                        boundary: 'viewport',
                        container: 'body'
                    });
                    
                    popoverList.push(popoverInstance);
                });

                // Close popovers when clicking outside
                document.addEventListener('click', function (e) {
                    if (!e.target.closest('.popover') && !e.target.matches('[data-bs-toggle="popover"]')) {
                        popoverList.forEach(popover => {
                            popover.hide();
                        });
                    }
                });
            }
        });
    </script>
}



