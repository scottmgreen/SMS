@model SMS.Presentation.Pages.SafetyRiskManagement.RiskAssessmentWizardModel

<!-- System Overview -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="mb-3">
            <label for="leadAssessor" class="form-label">Lead Assessor <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="leadAssessor" name="Step1.LeadAssessor" asp-for="Step1.LeadAssessor" 
                   placeholder="Enter the name of the lead assessor...">
            <div class="form-text">Person responsible for conducting this risk assessment</div>
            <span asp-validation-for="Step1.LeadAssessor" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label for="systemDescription" class="form-label">System Description <span class="text-danger">*</span></label>
            <textarea class="form-control" id="systemDescription" name="Step1.SystemDescription" asp-for="Step1.SystemDescription" 
                      rows="4" placeholder="Provide a comprehensive description of the system being assessed..."></textarea>
            <div class="form-text">Describe what the system does, its primary functions, and operational context</div>
            <span asp-validation-for="Step1.SystemDescription" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label for="systemBoundaries" class="form-label">System Boundaries <span class="text-danger">*</span></label>
            <textarea class="form-control" id="systemBoundaries" name="Step1.SystemBoundaries" asp-for="Step1.SystemBoundaries" 
                      rows="4" placeholder="Define what is included and excluded from this assessment..."></textarea>
            <div class="form-text">Clearly define the scope - what's in and what's out of this assessment</div>
            <span asp-validation-for="Step1.SystemBoundaries" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="mb-3">
            <label for="systemPurpose" class="form-label">System Purpose & Objectives</label>
            <textarea class="form-control" id="systemPurpose" name="Step1.SystemPurpose" asp-for="Step1.SystemPurpose" 
                      rows="3" placeholder="What is the system designed to achieve? What are its key objectives?"></textarea>
            <div class="form-text">Define the intended purpose and key performance objectives</div>
        </div>
    </div>
</div>

<!-- 5M Analysis Framework -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">
                <i class="fas fa-project-diagram text-primary"></i> 
                5M Framework Analysis
                <small class="text-muted">- Systematic breakdown of system elements</small>
            </h5>
        </div>
    </div>
</div>

<div class="row">
    <!-- Left Column - 5M Framework Forms -->
    <div class="col-md-12">
        <div class="row">
            <!-- Man (People) -->
            <div class="col-12 mb-4">
                <div class="card border-primary">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0"><i class="fas fa-users"></i> Man (People)</h6>
                            <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="popover" data-bs-placement="left" data-bs-trigger="click" data-bs-html="true" data-bs-title="Man (People) - Examples" data-bs-content="<ul class='mb-0'><li>Air traffic controllers</li><li>Pilots and flight crews</li><li>Ground handling personnel</li><li>Maintenance staff</li><li>Training requirements</li><li>Workload factors</li></ul>">
                                <i class="fas fa-question-circle"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Personnel & Human Factors <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="fiveMPersonnel" name="Step1.FiveMPersonnel" asp-for="Step1.FiveMPersonnel" rows="4"></textarea>
                            <div class="form-text">Who are the people involved? What human factors apply?</div>
                            <span asp-validation-for="Step1.FiveMPersonnel" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Machine (Equipment) -->
            <div class="col-12 mb-4">
                <div class="card border-success">
                    <div class="card-header bg-success text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0"><i class="fas fa-cogs"></i> Machine (Equipment)</h6>
                            <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="popover" data-bs-placement="left" data-bs-trigger="click" data-bs-html="true" data-bs-title="Machine (Equipment) - Examples" data-bs-content="<ul class='mb-0'><li>Aircraft systems</li><li>Ground support equipment</li><li>Navigation aids</li><li>Communication systems</li><li>Runway lighting</li><li>Radar systems</li></ul>">
                                <i class="fas fa-question-circle"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Equipment & Technology <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="fiveMEquipment" name="Step1.FiveMEquipment" asp-for="Step1.FiveMEquipment" rows="4"></textarea>
                            <div class="form-text">What equipment and technology is involved?</div>
                            <span asp-validation-for="Step1.FiveMEquipment" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Method (Procedures) -->
            <div class="col-12 mb-4">
                <div class="card border-info">
                    <div class="card-header bg-info text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0"><i class="fas fa-clipboard-list"></i> Method (Procedures)</h6>
                            <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="popover" data-bs-placement="left" data-bs-trigger="click" data-bs-html="true" data-bs-title="Method (Procedures) - Examples" data-bs-content="<ul class='mb-0'><li>Standard operating procedures</li><li>Emergency procedures</li><li>Communication protocols</li><li>Coordination processes</li><li>Quality assurance</li><li>Regulatory requirements</li></ul>">
                                <i class="fas fa-question-circle"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Procedures & Processes <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="fiveMProcedures" name="Step1.FiveMProcedures" asp-for="Step1.FiveMProcedures" rows="4"></textarea>
                            <div class="form-text">What procedures and processes are followed?</div>
                            <span asp-validation-for="Step1.FiveMProcedures" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Material (Resources) -->
            <div class="col-12 mb-4">
                <div class="card border-warning">
                    <div class="card-header bg-warning text-dark">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0"><i class="fas fa-boxes"></i> Material (Resources)</h6>
                            <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="popover" data-bs-placement="left" data-bs-trigger="click" data-bs-html="true" data-bs-title="Material (Resources) - Examples" data-bs-content="<ul class='mb-0'><li>Aviation fuel</li><li>Runway materials</li><li>Spare parts inventory</li><li>Documentation</li><li>Information systems</li><li>Support resources</li></ul>">
                                <i class="fas fa-question-circle"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Materials & Resources <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="fiveMResources" name="Step1.FiveMResources" asp-for="Step1.FiveMResources" rows="4"></textarea>
                            <div class="form-text">What materials and resources are required?</div>
                            <span asp-validation-for="Step1.FiveMResources" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Milieu (Environment) -->
            <div class="col-12 mb-4">
                <div class="card border-danger">
                    <div class="card-header bg-danger text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0"><i class="fas fa-globe"></i> Milieu (Environment)</h6>
                            <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="popover" data-bs-placement="left" data-bs-trigger="click" data-bs-html="true" data-bs-title="Milieu (Environment) - Examples" data-bs-content="<ul class='mb-0'><li>Weather conditions</li><li>Terrain and obstacles</li><li>Noise considerations</li><li>Lighting conditions</li><li>Traffic density</li><li>Time pressures</li><li>Regulatory environment</li><li>Organizational culture</li></ul>">
                                <i class="fas fa-question-circle"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-12 mb-3">
                                <label class="form-label">Physical Environment <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="fiveMPhysicalEnvironment" name="Step1.FiveMPhysicalEnvironment" asp-for="Step1.FiveMPhysicalEnvironment" rows="3"></textarea>
                                <span asp-validation-for="Step1.FiveMPhysicalEnvironment" class="text-danger"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <label class="form-label">Operational Environment <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="fiveMOperationalEnvironment" name="Step1.FiveMOperationalEnvironment" asp-for="Step1.FiveMOperationalEnvironment" rows="3"></textarea>
                                <span asp-validation-for="Step1.FiveMOperationalEnvironment" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stakeholder Analysis - SIMPLE MOVE BETWEEN LISTS -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-user-friends"></i> Stakeholder Selection</h6>
            </div>
            <div class="card-body">
                <!-- Stakeholder Groups -->
                <div class="row mb-4">
                    <div class="col-12">
                        <h6 class="text-primary mb-3"><i class="fas fa-users"></i> Stakeholder Groups</h6>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Available Groups</label>
                        @if (Model.StakeholderGroups?.Any() == true)
                        {
                            <select class="form-select" id="availableGroups" multiple size="6">
                                @foreach (var group in Model.StakeholderGroups)
                                {
                                    <option value="@group.Name">@group.Name</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="border rounded p-3 text-muted text-center">No groups available</div>
                        }
                    </div>
                    <div class="col-md-2 text-center align-self-center">
                        <button type="button" class="btn btn-primary btn-sm d-block mb-2" onclick="moveGroups('right')">
                            Add →
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm d-block" onclick="moveGroups('left')">
                            ← Remove
                        </button>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Selected Groups</label>
                        <select class="form-select" id="selectedGroups" multiple size="6"></select>
                    </div>
                </div>

                <!-- Individual Stakeholders -->
                <div class="row mb-4">
                    <div class="col-12">
                        <h6 class="text-info mb-3"><i class="fas fa-user"></i> Individual Stakeholders</h6>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Available Stakeholders</label>
                        @if (Model.AvailableStakeholders?.Any() == true)
                        {
                            <select class="form-select" id="availableStakeholders" multiple size="6">
                                @foreach (var stakeholder in Model.AvailableStakeholders)
                                {
                                    <option value="@stakeholder.Code" data-name="@stakeholder.DisplayName" data-org="@stakeholder.Organization">
                                        @stakeholder.DisplayName (@stakeholder.Organization)
                                    </option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="border rounded p-3 text-muted text-center">No stakeholders available</div>
                        }
                    </div>
                    <div class="col-md-2 text-center align-self-center">
                        <button type="button" class="btn btn-primary btn-sm d-block mb-2" onclick="moveStakeholders('right')">
                            Add →
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm d-block" onclick="moveStakeholders('left')">
                            ← Remove
                        </button>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Selected Stakeholders</label>
                        <select class="form-select" id="selectedStakeholders" multiple size="6"></select>
                    </div>
                </div>

                <!-- Hidden Fields for Form Binding -->
                <input type="hidden" name="Step1.StakeholderGroups" asp-for="Step1.StakeholderGroups" id="hiddenGroups" />
                <input type="hidden" name="Step1.SelectedIndividualStakeholders" asp-for="Step1.SelectedIndividualStakeholders" id="hiddenStakeholders" />
            </div>
        </div>
    </div>
</div>

<!-- Step 1 Complete Button -->
@* <div class="row mt-4">
    <div class="col-12">
        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-success btn-lg">
                <i class="fas fa-check-circle"></i> Complete Step 1
            </button>
        </div>
    </div>
</div>
 *@
<script>
// Simplified Step 1 JavaScript - just validation and simple list movement
document.addEventListener('DOMContentLoaded', function() {
    console.log('✅ Step 1 Simple - validation + list movement');
    
    // Initialize popovers
    if (typeof bootstrap !== 'undefined' && bootstrap.Popover) {
        const popoverTriggerList = document.querySelectorAll('[data-bs-toggle="popover"]');
        const popoverList = [...popoverTriggerList].map(popoverTriggerEl => {
            return new bootstrap.Popover(popoverTriggerEl, {
                html: true,
                trigger: 'click',
                container: 'body'
            });
        });
    }
    
    // Load existing selections into selected lists
    loadExistingSelections();
    
    // Add real-time validation  
    const requiredTextareas = document.querySelectorAll('textarea[name^="Step1.FiveM"], textarea[name*="Step1.System"], input[name="Step1.LeadAssessor"]');
    
    requiredTextareas.forEach(field => {
        const formText = field.nextElementSibling;
        if (formText && formText.classList.contains('form-text')) {
            const counter = document.createElement('small');
            counter.className = 'text-muted ms-2';
            counter.style.fontSize = '0.75em';
            formText.parentNode.insertBefore(counter, formText.nextSibling);
            
            function updateValidation() {
                const length = field.value.trim().length;
                const minLength = field.type === 'textarea' ? 10 : 3;
                
                counter.textContent = `${length}/${minLength} characters`;
                
                if (length === 0) {
                    field.classList.remove('is-valid', 'is-invalid');
                    counter.className = 'text-muted ms-2';
                } else if (length < minLength) {
                    field.classList.remove('is-valid');
                    field.classList.add('is-invalid');
                    counter.className = 'text-danger ms-2';
                } else {
                    field.classList.remove('is-invalid');
                    field.classList.add('is-valid');
                    counter.className = 'text-success ms-2';
                    counter.textContent = `${length} characters ✓`;
                }
            }
            
            updateValidation();
            field.addEventListener('input', updateValidation);
            field.addEventListener('blur', updateValidation);
        }
    });
});

// Simple functions to move items between lists
function moveGroups(direction) {
    const available = document.getElementById('availableGroups');
    const selected = document.getElementById('selectedGroups');
    
    if (direction === 'right') {
        moveSelectedOptions(available, selected);
    } else {
        moveSelectedOptions(selected, available);
    }
    
    updateHiddenGroups();
}

function moveStakeholders(direction) {
    const available = document.getElementById('availableStakeholders');
    const selected = document.getElementById('selectedStakeholders');
    
    if (direction === 'right') {
        moveSelectedOptions(available, selected);
    } else {
        moveSelectedOptions(selected, available);
    }
    
    updateHiddenStakeholders();
}

function moveSelectedOptions(fromSelect, toSelect) {
    const selectedOptions = Array.from(fromSelect.selectedOptions);
    selectedOptions.forEach(option => {
        toSelect.appendChild(option.cloneNode(true));
        option.remove();
    });
}

function updateHiddenGroups() {
    const selected = document.getElementById('selectedGroups');
    const hiddenField = document.getElementById('hiddenGroups');
    const values = Array.from(selected.options).map(option => option.value);
    hiddenField.value = values.join(', ');
}

function updateHiddenStakeholders() {
    const selected = document.getElementById('selectedStakeholders');
    const hiddenField = document.getElementById('hiddenStakeholders');
    const stakeholders = Array.from(selected.options).map(option => ({
        code: option.value,
        name: option.dataset.name,
        organization: option.dataset.org
    }));
    hiddenField.value = JSON.stringify(stakeholders);
}

function loadExistingSelections() {
    // Load existing groups
    const hiddenGroups = document.getElementById('hiddenGroups');
    if (hiddenGroups && hiddenGroups.value) {
        const groupNames = hiddenGroups.value.split(',').map(g => g.trim()).filter(g => g);
        const available = document.getElementById('availableGroups');
        const selected = document.getElementById('selectedGroups');
        
        groupNames.forEach(groupName => {
            const option = Array.from(available.options).find(opt => opt.value === groupName);
            if (option) {
                selected.appendChild(option.cloneNode(true));
                option.remove();
            }
        });
    }
    
    // Load existing stakeholders
    const hiddenStakeholders = document.getElementById('hiddenStakeholders');
    if (hiddenStakeholders && hiddenStakeholders.value) {
        try {
            const stakeholders = JSON.parse(hiddenStakeholders.value);
            const available = document.getElementById('availableStakeholders');
            const selected = document.getElementById('selectedStakeholders');
            
            stakeholders.forEach(stakeholder => {
                const option = Array.from(available.options).find(opt => opt.value === stakeholder.code);
                if (option) {
                    selected.appendChild(option.cloneNode(true));
                    option.remove();
                }
            });
        } catch (e) {
            console.log('Could not parse existing stakeholders');
        }
    }
}
</script>
