@model SMS.Presentation.Pages.SafetyRiskManagement.RiskAssessmentWizardModel

@* <div class="row">
    <div class="col-12">
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            <strong>Step 1 Objective:</strong> Define the system boundaries and scope using the 5M methodology (Man, Machine, Method, Material, Milieu).
            This establishes the foundation for identifying hazards in subsequent steps.
        </div>
    </div>
</div> *@

<!-- System Overview -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="mb-3">
            <label for="leadAssessor" class="form-label">Lead Assessor <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="leadAssessor" name="LeadAssessor" asp-for="LeadAssessor" 
                   placeholder="Enter the name of the lead assessor...">
            <div class="form-text">Person responsible for conducting this risk assessment</div>
            <span asp-validation-for="LeadAssessor" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label for="systemDescription" class="form-label">System Description <span class="text-danger">*</span></label>
            <textarea class="form-control" id="systemDescription" name="SystemDescription" asp-for="SystemDescription" 
                      rows="4" placeholder="Provide a comprehensive description of the system being assessed..."></textarea>
            <div class="form-text">Describe what the system does, its primary functions, and operational context</div>
            <span asp-validation-for="SystemDescription" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label for="systemBoundaries" class="form-label">System Boundaries <span class="text-danger">*</span></label>
            <textarea class="form-control" id="systemBoundaries" name="SystemBoundaries" asp-for="SystemBoundaries" 
                      rows="4" placeholder="Define what is included and excluded from this assessment..."></textarea>
            <div class="form-text">Clearly define the scope - what's in and what's out of this assessment</div>
            <span asp-validation-for="SystemBoundaries" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="mb-3">
            <label for="systemPurpose" class="form-label">System Purpose & Objectives</label>
            <textarea class="form-control" id="systemPurpose" name="SystemPurpose" asp-for="SystemPurpose" 
                      rows="3" placeholder="What is the system designed to achieve? What are its key objectives?"></textarea>
            <div class="form-text">Define the intended purpose and key performance objectives</div>
        </div>
    </div>
</div>

<!-- 5M Analysis Framework -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">
                <i class="fas fa-project-diagram text-primary"></i> 
                5M Framework Analysis
                <small class="text-muted">- Systematic breakdown of system elements</small>
            </h5>
        </div>
        
        @* <div class="alert alert-info small">
            <i class="fas fa-info-circle"></i>
            <strong>Required for Complete Assessment:</strong> Use the 5M Framework to systematically analyze system elements. This ensures comprehensive hazard identification in Step 2.
            The framework covers: <strong>Man</strong> (people/human factors), <strong>Machine</strong> (equipment/technology), 
            <strong>Method</strong> (procedures/processes), <strong>Material</strong> (resources/supplies), and <strong>Milieu</strong> (environment/conditions).
        </div> *@
    </div>
</div>

<div class="row">
    <!-- Left Column - 5M Framework Forms -->
    <div class="col-md-12">
        <div class="row">
            <!-- Man (People) -->
            <div class="col-12 mb-4">
                <div class="card border-primary">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0"><i class="fas fa-users"></i> Man (People)</h6>
                            <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="popover" data-bs-placement="left" data-bs-trigger="click" data-bs-html="true" data-bs-title="Man (People) - Examples" data-bs-content="<ul class='mb-0'><li>Air traffic controllers</li><li>Pilots and flight crews</li><li>Ground handling personnel</li><li>Maintenance staff</li><li>Training requirements</li><li>Workload factors</li></ul>">
                                <i class="fas fa-question-circle"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Personnel & Human Factors <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="fiveMPersonnel" name="FiveMPersonnel" asp-for="FiveMPersonnel" rows="4"></textarea>
                            <div class="form-text">Who are the people involved? What human factors apply?</div>
                            <span asp-validation-for="FiveMPersonnel" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Machine (Equipment) -->
            <div class="col-12 mb-4">
                <div class="card border-success">
                    <div class="card-header bg-success text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0"><i class="fas fa-cogs"></i> Machine (Equipment)</h6>
                            <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="popover" data-bs-placement="left" data-bs-trigger="click" data-bs-html="true" data-bs-title="Machine (Equipment) - Examples" data-bs-content="<ul class='mb-0'><li>Aircraft systems</li><li>Ground support equipment</li><li>Navigation aids</li><li>Communication systems</li><li>Runway lighting</li><li>Radar systems</li></ul>">
                                <i class="fas fa-question-circle"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Equipment & Technology <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="fiveMEquipment" name="FiveMEquipment" asp-for="FiveMEquipment" rows="4"></textarea>
                            <div class="form-text">What equipment and technology is involved?</div>
                            <span asp-validation-for="FiveMEquipment" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Method (Procedures) -->
            <div class="col-12 mb-4">
                <div class="card border-info">
                    <div class="card-header bg-info text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0"><i class="fas fa-clipboard-list"></i> Method (Procedures)</h6>
                            <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="popover" data-bs-placement="left" data-bs-trigger="click" data-bs-html="true" data-bs-title="Method (Procedures) - Examples" data-bs-content="<ul class='mb-0'><li>Standard operating procedures</li><li>Emergency procedures</li><li>Communication protocols</li><li>Coordination processes</li><li>Quality assurance</li><li>Regulatory requirements</li></ul>">
                                <i class="fas fa-question-circle"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Procedures & Processes <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="fiveMProcedures" name="FiveMProcedures" asp-for="FiveMProcedures" rows="4"></textarea>
                            <div class="form-text">What procedures and processes are followed?</div>
                            <span asp-validation-for="FiveMProcedures" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Material (Resources) -->
            <div class="col-12 mb-4">
                <div class="card border-warning">
                    <div class="card-header bg-warning text-dark">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0"><i class="fas fa-boxes"></i> Material (Resources)</h6>
                            <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="popover" data-bs-placement="left" data-bs-trigger="click" data-bs-html="true" data-bs-title="Material (Resources) - Examples" data-bs-content="<ul class='mb-0'><li>Aviation fuel</li><li>Runway materials</li><li>Spare parts inventory</li><li>Documentation</li><li>Information systems</li><li>Support resources</li></ul>">
                                <i class="fas fa-question-circle"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Materials & Resources <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="fiveMResources" name="FiveMResources" asp-for="FiveMResources" rows="4"></textarea>
                            <div class="form-text">What materials and resources are required?</div>
                            <span asp-validation-for="FiveMResources" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Milieu (Environment) -->
            <div class="col-12 mb-4">
                <div class="card border-danger">
                    <div class="card-header bg-danger text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0"><i class="fas fa-globe"></i> Milieu (Environment)</h6>
                            <button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="popover" data-bs-placement="left" data-bs-trigger="click" data-bs-html="true" data-bs-title="Milieu (Environment) - Examples" data-bs-content="<ul class='mb-0'><li>Weather conditions</li><li>Terrain and obstacles</li><li>Noise considerations</li><li>Lighting conditions</li><li>Traffic density</li><li>Time pressures</li><li>Regulatory environment</li><li>Organizational culture</li></ul>">
                                <i class="fas fa-question-circle"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-12 mb-3">
                                <label class="form-label">Physical Environment <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="fiveMPhysicalEnvironment" name="FiveMPhysicalEnvironment" asp-for="FiveMPhysicalEnvironment" rows="3"></textarea>
                                <span asp-validation-for="FiveMPhysicalEnvironment" class="text-danger"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <label class="form-label">Operational Environment <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="fiveMOperationalEnvironment" name="FiveMOperationalEnvironment" asp-for="FiveMOperationalEnvironment" rows="3"></textarea>
                                <span asp-validation-for="FiveMOperationalEnvironment" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stakeholder Analysis - ✅ UPDATED: Now uses UniversalUserRepository Stakeholder System -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="fas fa-user-friends"></i> Stakeholder Management</h6>
                    <small class="text-muted">✅ Powered by JSON Stakeholder Repository</small>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Left Column: Stakeholder Groups and Selection -->
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label">Available Stakeholder Groups</label>
                            <div class="border rounded p-2" style="max-height: 200px; overflow-y: auto;">
                                @if (Model.StakeholderGroups_Data.Any())
                                {
                                    foreach (var group in Model.StakeholderGroups_Data)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input stakeholder-group-checkbox" 
                                                   type="checkbox" 
                                                   value="@group.Name" 
                                                   id="group_@group.Id"
                                                   @(Model.SelectedStakeholderIds.Contains(group.Name) ? "checked" : "")
                                                   onchange="toggleStakeholderGroup('@group.Name', this.checked)">
                                            <label class="form-check-label" for="group_@group.Id">
                                                <strong>@group.Name</strong> 
                                                <span class="badge bg-secondary">@group.MemberCount members</span>
                                                <br>
                                                <small class="text-muted">@group.Description</small>
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted">No stakeholder groups found. Create stakeholder users in the User Management section.</p>
                                }
                            </div>
                            <div class="form-text">Select stakeholder groups relevant to this risk assessment</div>
                        </div>

                        <!-- Selected Stakeholders Display -->
                        <div class="mb-3">
                            <label class="form-label">Selected Stakeholders</label>
                            <div id="selectedStakeholdersContainer" class="border rounded p-2" style="min-height: 100px; max-height: 150px; overflow-y: auto;">
                                <small class="text-muted">Selected stakeholder groups will appear here</small>
                            </div>
                        </div>

                        <!-- Individual Stakeholder Selection -->
                        <div class="mb-3">
                            <label class="form-label">Individual Stakeholders</label>
                            <select class="form-select" id="individualStakeholderSelect" multiple size="6" onchange="updateSelectedStakeholders()">
                                @foreach (var stakeholder in Model.AvailableStakeholders.Where(s => s.IsActive))
                                {
                                    <option value="@stakeholder.Id" 
                                            data-name="@stakeholder.DisplayName" 
                                            data-organization="@stakeholder.Organization"
                                            data-type="@stakeholder.StakeholderType"
                                            data-category="@stakeholder.StakeholderType">
                                        @stakeholder.DisplayName (@stakeholder.Organization) - @stakeholder.StakeholderType
                                    </option>
                                }
                            </select>
                            <div class="form-text">Hold Ctrl/Cmd to select multiple individual stakeholders</div>
                        </div>
                    </div>

                    <!-- Right Column: Create New Stakeholder - CONVERTED TO MODAL TRIGGER -->
                    <div class="col-md-4">
                        <div class="card border-primary">
                            <div class="card-header bg-primary text-white">
                                <h6 class="mb-0"><i class="fas fa-plus"></i> Add New Stakeholder</h6>
                            </div>
                            <div class="card-body text-center">
                                <p class="text-muted mb-3">
                                    <i class="fas fa-user-plus fa-2x"></i><br>
                                    Create a new stakeholder user and assign to a stakeholder group
                                </p>
                                
                                <!-- MODAL TRIGGER BUTTON -->
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createStakeholderModal">
                                    <i class="fas fa-plus"></i> Add New Stakeholder
                                </button>
                                
                                <div class="mt-3">
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle"></i>
                                        Stakeholder will be created and automatically assigned to the selected group
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- Stakeholder Statistics -->
                        <div class="card border-info mt-3">
                            <div class="card-header bg-info text-white">
                                <h6 class="mb-0"><i class="fas fa-chart-bar"></i> Stakeholder Stats</h6>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-6">
                                        <h5 class="text-primary">@Model.AvailableStakeholders.Count</h5>
                                        <small>Total Stakeholders</small>
                                    </div>
                                    <div class="col-6">
                                        <h5 class="text-success">@Model.StakeholderGroups_Data.Count</h5>
                                        <small>Groups</small>
                                    </div>
                                </div>
                                <hr>
                                <div class="small">
                                    @if (Model.StakeholderGroups_Data.Any())
                                    {
                                        foreach (var group in Model.StakeholderGroups_Data.Take(3))
                                        {
                                            <div class="d-flex justify-content-between">
                                                <span>@group.Name.Split('-').LastOrDefault()?.Trim()</span>
                                                <span class="badge bg-secondary">@group.MemberCount</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-muted small">
                                            No groups created yet.<br>
                                            <a href="/SafetyPolicy/ResponsibilitiesAndAccountability" class="text-info">Create stakeholder groups</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Hidden fields to store selected stakeholders for form submission -->
                <input type="hidden" asp-for="StakeholderGroups" id="stakeholderGroupsHidden">
                <input type="hidden" asp-for="SelectedIndividualStakeholders" id="selectedIndividualStakeholdersHidden">
            </div>
        </div>
    </div>
</div>

<!-- Modal for Creating New Stakeholder -->
<div class="modal fade" id="createStakeholderModal" tabindex="-1" aria-labelledby="createStakeholderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateStakeholder">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="createStakeholderModalLabel">
                        <i class="fas fa-user-plus"></i> Create New Stakeholder
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @* <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>Creating Stakeholder for Risk Assessment:</strong> 
                        This stakeholder will be available for selection in current and future risk assessments.
                    </div> *@
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Full Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="stakeholderName" required 
                                       placeholder="Enter full name...">
                                <div class="form-text">First and last name of the stakeholder</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" name="stakeholderEmail" 
                                       placeholder="stakeholder@organization.com">
                                <div class="form-text">Primary contact email</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Organization</label>
                                <input type="text" class="form-control" name="stakeholderOrganization" 
                                       placeholder="Organization name...">
                                <div class="form-text">Company or organization name</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Stakeholder Group <span class="text-danger">*</span></label>
                                <select class="form-select" name="stakeholderGroup" required>
                                    <option value="">Select Group...</option>
                                    @if (Model.StakeholderGroups_Data.Any())
                                    {
                                        @foreach (var group in Model.StakeholderGroups_Data)
                                        {
                                            <option value="@group.Name">@group.Name (@group.MemberCount members)</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="Default Group">Default Group (Create groups in User Management)</option>
                                    }
                                </select>
                                <div class="form-text">Stakeholder will be assigned to this group</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Type</label>
                                <select class="form-select" name="stakeholderType">
                                    <option value="External">External</option>
                                    <option value="Regulatory">Regulatory</option>
                                    <option value="Contractor">Contractor</option>
                                    <option value="Airline">Airline</option>
                                    <option value="Government">Government</option>
                                    <option value="Community">Community</option>
                                </select>
                                <div class="form-text">Type of stakeholder organization</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Category</label>
                                <select class="form-select" name="stakeholderCategory">
                                    <option value="Important">Important</option>
                                    <option value="Critical">Critical</option>
                                    <option value="Normal">Normal</option>
                                </select>
                                <div class="form-text">Priority level for stakeholder engagement</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Phone</label>
                                <input type="tel" class="form-control" name="stakeholderPhone" 
                                       placeholder="(555) 123-4567">
                                <div class="form-text">Contact phone number (optional)</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-user-plus"></i> Create Stakeholder
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JavaScript for Stakeholder Management and JSON Persistence -->
<script src="~/js/json-persistence-client.js?v=@DateTime.Now.Ticks"></script>
@* DISABLED: Causing infinite loop conflicts *@
@* <script src="~/js/stakeholder-management.js?v=@DateTime.Now.Ticks"></script> *@

<script>
// 🔧 STEP1 STAKEHOLDER MANAGEMENT INTEGRATION - FIXED VERSION
console.log('🎯 Step 1 Stakeholder Management Integration Starting...');

// Initialize global state
window.selectedStakeholderGroups = [];
window.selectedIndividualStakeholders = [];

document.addEventListener('DOMContentLoaded', function() {
    console.log('🎯 DOM Loaded - Initializing Step 1 components...');
    
    const assessmentId = '@Model.Id';
    const stepNumber = 1;
    
    // ✅ Initialize JSON persistence for this assessment step
    console.log('🎯 Initializing Step 1 with JSON persistence');
    const jsonPersistence = window.initializeJsonPersistence ? 
        window.initializeJsonPersistence(assessmentId, stepNumber) : 
        null;
    
    if (!jsonPersistence) {
        console.warn('⚠️ JSON persistence client not available, using fallback mode');
    }
    
    // FIXED: Initialize stakeholder management with proper form binding
    console.log('🎯 Initializing SIMPLE stakeholder management - no external dependencies...');
    
    // FIXED: Define proper stakeholder management functions
    // SIMPLE Toggle function for stakeholder groups
    window.toggleStakeholderGroup = function(groupName, isChecked) {
        console.log(`🎯 Toggle stakeholder group: ${groupName}, checked: ${isChecked}`);
        
        // Update the selected groups tracking
        if (isChecked) {
            if (!window.selectedStakeholderGroups.includes(groupName)) {
                window.selectedStakeholderGroups.push(groupName);
            }
        } else {
            window.selectedStakeholderGroups = window.selectedStakeholderGroups.filter(g => g !== groupName);
        }
        
        console.log('🎯 Updated selected groups:', window.selectedStakeholderGroups);
        
        // Update the display and form data
        updateSelectedStakeholdersDisplay();
        updateStakeholderFormData(); // CRITICAL: Update form data immediately
    };
    
    // SIMPLE VERSION - No infinite loops
    window.updateSelectedStakeholders = function() {
        console.log('🔄 Update selected stakeholders called - SIMPLE VERSION');
        
        // Handle individual stakeholder selection changes
        const individualSelect = document.getElementById('individualStakeholderSelect');
        if (individualSelect) {
            // Get selected options directly
            const selectedOptions = Array.from(individualSelect.selectedOptions);
            window.selectedIndividualStakeholders = selectedOptions.map(option => ({
                id: option.value,
                name: option.dataset.name || option.text,
                organization: option.dataset.organization || '',
                category: option.dataset.category || ''
            }));
            
            console.log(`✅ Selected ${window.selectedIndividualStakeholders.length} individual stakeholders`);
        }
        
        updateSelectedStakeholdersDisplay();
        updateStakeholderFormData();
    };
    
    // GLOBAL FUNCTION: For use by navigation JavaScript
    window.updateStakeholderFormData = function() {
        console.log('🔄 Updating stakeholder form data...');
        
        // Update groups hidden field - FIXED to use proper field
        const groupsField = document.getElementById('stakeholderGroupsHidden');
        if (groupsField) {
            groupsField.value = window.selectedStakeholderGroups.join(', ');
            console.log('✅ Updated StakeholderGroups field:', groupsField.value);
        } else {
            console.error('❌ StakeholderGroups hidden field not found!');
        }
        
        // Update individual stakeholders field
        const individualsField = document.getElementById('selectedIndividualStakeholdersHidden');
        if (individualsField && window.selectedIndividualStakeholders.length > 0) {
            const individualsJson = JSON.stringify(window.selectedIndividualStakeholders);
            individualsField.value = individualsJson;
            console.log('✅ Updated SelectedIndividualStakeholders field:', individualsJson);
        }
    };
    
    // Enhanced display update function
    function updateSelectedStakeholdersDisplay() {
        const container = document.getElementById('selectedStakeholdersContainer');
        if (!container) {
            console.log('⚠️ Selected stakeholders container not found');
            return;
        }
        
        // Build the display HTML
        let html = '';
        
        // Show selected groups
        if (window.selectedStakeholderGroups.length > 0) {
            html += '<div class="mb-2">';
            html += '<h6 class="text-primary mb-1"><i class="fas fa-users"></i> Selected Groups:</h6>';
            window.selectedStakeholderGroups.forEach(groupName => {
                html += `<span class="badge bg-primary me-1 mb-1">${groupName}</span>`;
            });
            html += '</div>';
        }
        
        // Show selected individuals
        if (window.selectedIndividualStakeholders.length > 0) {
            html += '<div class="mb-2">';
            html += '<h6 class="text-info mb-1"><i class="fas fa-user"></i> Individual Stakeholders:</h6>';
            window.selectedIndividualStakeholders.forEach(stakeholder => {
                html += `
                    <div class="badge bg-info me-1 mb-1">
                        ${stakeholder.name}
                        ${stakeholder.organization ? ` (${stakeholder.organization})` : ''}
                    </div>
                `;
            });
            html += '</div>';
        }
        
        // Show message if no selections
        if (window.selectedStakeholderGroups.length === 0 && window.selectedIndividualStakeholders.length === 0) {
            html = '<small class="text-muted"><i class="fas fa-info-circle"></i> No stakeholders selected yet. Select groups or individuals above.</small>';
        }
        
        container.innerHTML = html;
        console.log(`✅ Updated stakeholder display: ${window.selectedStakeholderGroups.length} groups, ${window.selectedIndividualStakeholders.length} individuals`);
    }
    
    // SIMPLE individual stakeholder handler - NO INFINITE LOOP
    const individualSelect = document.getElementById('individualStakeholderSelect');
    if (individualSelect) {
        individualSelect.addEventListener('change', function(event) {
            console.log('🔄 Individual stakeholder selection changed - FIXED SIMPLE handler');
            
            // Get selected options directly
            const selectedOptions = Array.from(this.selectedOptions);
            window.selectedIndividualStakeholders = selectedOptions.map(option => ({
                id: option.value,
                name: option.dataset.name || option.text,
                organization: option.dataset.organization || '',
                category: option.dataset.category || ''
            }));
            
            console.log(`✅ Selected ${window.selectedIndividualStakeholders.length} individual stakeholders`);
            
            // Update display and form data
            updateSelectedStakeholdersDisplay();
            updateStakeholderFormData();
        });
        
        console.log(`✅ Individual stakeholder select initialized with ${individualSelect.options.length} options`);
    } else {
        console.log('⚠️ Individual stakeholder select not found');
    }
    
    // Initialize existing selections from model data
    const existingGroupsField = document.getElementById('stakeholderGroupsHidden');
    if (existingGroupsField && existingGroupsField.value) {
        const existingGroups = existingGroupsField.value.split(',').map(g => g.trim()).filter(g => g);
        window.selectedStakeholderGroups = existingGroups;
        
        // Check the appropriate checkboxes
        existingGroups.forEach(groupName => {
            const checkbox = document.querySelector(`input[value="${groupName}"]`);
            if (checkbox) {
                checkbox.checked = true;
            }
        });
        
        console.log('🔄 Restored existing stakeholder groups:', existingGroups);
    }
    
    // Load existing individual stakeholder selections if any
    const existingIndividualsField = document.getElementById('selectedIndividualStakeholdersHidden');
    if (existingIndividualsField && existingIndividualsField.value) {
        try {
            const existingIndividuals = JSON.parse(existingIndividualsField.value);
            window.selectedIndividualStakeholders = existingIndividuals;
            
            // Select the appropriate options in the select element
            if (individualSelect && existingIndividuals.length > 0) {
                existingIndividuals.forEach(stakeholder => {
                    const option = individualSelect.querySelector(`option[value="${stakeholder.id}"]`);
                    if (option) {
                        option.selected = true;
                    }
                });
            }
            
            console.log('🔄 Restored existing individual stakeholders:', existingIndividuals);
        } catch (e) {
            console.log('⚠️ Could not parse existing individual stakeholders:', e);
        }
    }
    
    // Initial display update
    setTimeout(() => {
        updateSelectedStakeholdersDisplay();
        updateStakeholderFormData();
    }, 100);
    
    // ✅ Initialize Bootstrap popovers for 5M guidance buttons
    if (typeof bootstrap !== 'undefined' && bootstrap.Popover) {
        const popoverTriggerList = document.querySelectorAll('[data-bs-toggle="popover"]');
        const popoverList = [...popoverTriggerList].map(popoverTriggerEl => {
            return new bootstrap.Popover(popoverTriggerEl, {
                html: true,
                trigger: 'click',
                container: 'body'
            });
        });
        console.log(`✅ Initialized ${popoverList.length} popovers`);
    }
    
    // ✅ Initialize 5M Framework auto-save listeners
    const fiveMTextareas = document.querySelectorAll('textarea[id^="FiveM"], textarea[name*="SystemDescription"], textarea[name*="SystemBoundaries"], textarea[name*="SystemPurpose"]');
    fiveMTextareas.forEach(textarea => {
        textarea.addEventListener('input', function() {
            console.log(`📝 5M Framework field changed: ${this.id || this.name}`);
            // Auto-save will be handled by the JSON persistence client
        });
    });
    console.log(`📝 Auto-save listeners added to ${fiveMTextareas.length} 5M Framework fields`);
    
    console.log('✅ Step 1 initialization complete');
});


// Validation before step progression
function validateStep1() {
    const requiredFields = [
        { selector: 'textarea[name*="SystemDescription"]', name: 'System Description' },
        { selector: 'textarea[name*="SystemBoundaries"]', name: 'System Boundaries' },
        { selector: 'textarea[name*="SystemPurpose"]', name: 'System Purpose' },
        { selector: 'textarea[name*="FiveMPersonnel"]', name: '5M Personnel' },
        { selector: 'textarea[name*="FiveMEquipment"]', name: '5M Equipment' },
        { selector: 'textarea[name*="FiveMProcedures"]', name: '5M Procedures' },
        { selector: 'textarea[name*="FiveMResources"]', name: '5M Resources' },
        { selector: 'textarea[name*="FiveMPhysicalEnvironment"]', name: '5M Physical Environment' },
        { selector: 'textarea[name*="FiveMOperationalEnvironment"]', name: '5M Operational Environment' }
    ];
    
    let incompleteFields = [];
    let validationErrors = [];

    requiredFields.forEach(field => {
        const textarea = document.querySelector(field.selector);
        if (textarea) {
            const value = textarea.value.trim();
            
            // Check if field is empty
            if (!value) {
                incompleteFields.push(field.name);
            }
            // Check minimum length requirements (10 characters)
            else if (value.length < 10) {
                validationErrors.push(`${field.name} must be at least 10 characters (currently ${value.length})`);
            }
        }
    });
    
    // Show validation errors
    if (incompleteFields.length > 0) {
        alert(`Please complete the following required fields:\n\n${incompleteFields.join('\n• ')}\n\nAll fields are required for a comprehensive system description.`);
        return false;
    }
    
    if (validationErrors.length > 0) {
        alert(`Please provide more detailed information:\n\n• ${validationErrors.join('\n• ')}\n\nEach field requires at least 10 characters for meaningful analysis.`);
        return false;
    }
    
    return true;
}

// Real-time validation feedback for Step 1
function addStep1RealTimeValidation() {
    const requiredTextareas = document.querySelectorAll('textarea[name*="SystemDescription"], textarea[name*="SystemBoundaries"], textarea[name*="SystemPurpose"], textarea[name*="FiveM"]');
    
    requiredTextareas.forEach(textarea => {
        // Add character counter
        const formText = textarea.nextElementSibling;
        if (formText && formText.classList.contains('form-text')) {
            const counter = document.createElement('small');
            counter.className = 'text-muted ms-2';
            counter.style.fontSize = '0.75em';
            formText.parentNode.insertBefore(counter, formText.nextSibling);
            
            function updateValidation() {
                const length = textarea.value.trim().length;
                const minLength = 10;
                
                // Update counter
                counter.textContent = `${length}/${minLength} characters`;
                
                // Update styling based on validation
                if (length === 0) {
                    textarea.classList.remove('is-valid', 'is-invalid');
                    counter.className = 'text-muted ms-2';
                } else if (length < minLength) {
                    textarea.classList.remove('is-valid');
                    textarea.classList.add('is-invalid');
                    counter.className = 'text-danger ms-2';
                    counter.textContent = `${length}/${minLength} characters (minimum ${minLength} required)`;
                } else {
                    textarea.classList.remove('is-invalid');
                    textarea.classList.add('is-valid');
                    counter.className = 'text-success ms-2';
                    counter.textContent = `${length} characters ✓`;
                }
            }
            
            // Initial validation
            updateValidation();
            
            // Add event listeners
            textarea.addEventListener('input', updateValidation);
            textarea.addEventListener('blur', updateValidation);
        }
    });
}

// Initialize Step 1 validation
document.addEventListener('DOMContentLoaded', function() {
    // Initialize popovers
    initializeStep1Popovers();
    
    // Add real-time validation with character counters
    addStep1RealTimeValidation();
    
    // Hook into form submission for validation
    const form = document.querySelector('form');
    if (form) {
        form.addEventListener('submit', function(e) {
            const submitButton = document.activeElement;
            
            // Only validate for Next Step button, not Save Draft
            if (submitButton && (submitButton.textContent.includes('Next Step') || submitButton.textContent.includes('Continue'))) {
                if (!validateStep1()) {
                    e.preventDefault();
                    return false;
                }
            }
        });
    }
});

function initializeStep1Popovers() {
    // Initialize all popovers
    var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
    var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
        return new bootstrap.Popover(popoverTriggerEl, {
            container: 'body',
            sanitize: false
        });
    });
    
    // Close other popovers when one is opened
    popoverTriggerList.forEach(function(popoverTriggerEl) {
        popoverTriggerEl.addEventListener('show.bs.popover', function () {
            // Hide all other popovers
            popoverList.forEach(function(popoverInstance) {
                if (popoverInstance._element !== popoverTriggerEl) {
                    popoverInstance.hide();
                }
            });
        });
    });
}
</script>

