                                                                <em class="text-muted">No description provided - Please describe the hazard</em>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @if (!string.IsNullOrEmpty(Model.HazardReport.Description))
                                                            {
                                                                <i class="fas fa-check-circle text-success"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="fas fa-times-circle text-danger"></i>
                                                            }
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">
                                                            <i class="fas fa-paperclip text-secondary"></i> Attachments
                                                        </th>
                                                        <td>
                                                           @*  @if (Model.SelectedFiles.Any())
                                                            {
                                                                <div class="attachment-preview">
                                                                    <span class="fw-bold text-success">@Model.SelectedFiles.Count file(s) attached:</span>
                                                                    <ul class="mb-0 mt-1>
                                                                        @foreach (var file in Model.SelectedFiles)
                                                                        {
                                                                            <li>
