                                </form>
                                <div class="mt-2">
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle"></i> Clicking this button will clear the form for a new hazard report
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <!-- Leaflet.js CSS and JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" 
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" 
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <!-- Fix map cursor to show crosshair for location selection -->
    <style>
        #hazardLocationMap {
            cursor: crosshair !important;
        }
        
        .leaflet-container {
            cursor: crosshair !important;
        }
        
        .leaflet-grab {
            cursor: crosshair !important;
        }
        
        .leaflet-dragging .leaflet-grab {
            cursor: move !important;
        }
    </style>

    <!-- Success Modal Fallback -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Check if success modal should be showing
            const showSuccessModal = @Model.ShowFinalSuccessConfirmation.ToString().ToLower();
            const hazardReportId = '@Model.GeneratedHazardId';
            
            // If success modal should be showing but modal element is not found, show fallback alert
            if (showSuccessModal && hazardReportId && hazardReportId.startsWith('HZ-')) {
                // Check if the modal is actually visible after a short delay
                setTimeout(function() {
                    const modalElement = document.querySelector('[data-bs-backdrop="static"][data-bs-keyboard="false"]');
                    
                    // If no modal found or modal is not visible, show fallback
                    if (!modalElement || modalElement.style.display === 'none') {
                        const message = `🎉 HAZARD REPORT SUBMITTED SUCCESSFULLY!\n\n` +
                                      `Your Hazard Report ID: ${hazardReportId}\n\n` +
                                      `✅ Please save this ID for your records\n` +
                                      `✅ Your report will be reviewed within 24-48 hours\n` +
                                      `✅ You will be notified of any status changes\n\n` +
                                      `Contact SMS Team: (503) 555-0100\n` +
                                      `Email: sms@flypdx.com`;
                        
                        alert(message);
                        
                        // Optional: Clear the form after successful submission
                        setTimeout(function() {
                            if (confirm('Would you like to clear the form to submit another report?')) {
                                const clearButton = document.querySelector('button[formaction*="ClearForm"]');
                                if (clearButton) {
                                    clearButton.click();
                                }
                            }
                        }, 1000);
                    }
                }, 500);
            }
        });
    </script>

    @if (Model.ShowMapModal)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                // Initialize map with specific options to ensure click events work
                var map = L.map('hazardLocationMap', {
                    center: [@Model.AirportCenterLatitude, @Model.AirportCenterLongitude],
                    zoom: @Model.DefaultZoomLevel,
                    zoomControl: true,
                    doubleClickZoom: true,
                    closePopupOnClick: true,
                    trackResize: true
                });

                // Ensure map shows crosshair cursor for location selection
                document.getElementById('hazardLocationMap').style.cursor = 'crosshair';

                // Add OpenStreetMap tiles
                var streetMap = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                    maxZoom: 19
                });

                // Add satellite imagery as an option
                var satellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                    attribution: 'Tiles © Esri — Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, and the GIS User Community',
                    maxZoom: 19
                });

                // Add default layer
                streetMap.addTo(map);

                // Layer control
                var baseMaps = {
                    "Street Map": streetMap,
                    "Satellite": satellite
                };
                L.control.layers(baseMaps).addTo(map);

                // Global variables
                window.mapInstance = map;
                window.selectedMarker = null;

                // Function to check if coordinates are within bounds - PROPER PDX AIRPORT BOUNDS
                window.isWithinBounds = function(lat, lng) {
                    // CORRECTED PDX Airport bounds - actual airport property boundaries
                    return lat >= 45.580 && lat <= 45.595 && lng >= -122.610 && lng <= -122.580;
                };

                // Custom icon for selected location
                var selectedIcon = L.divIcon({
                    html: '<div style="background-color: #dc3545; border: 3px solid #fff; border-radius: 50%; width: 24px; height: 24px; box-shadow: 0 3px 6px rgba(0,0,0,0.4); position: relative;"><div style="position: absolute; bottom: -8px; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 6px solid transparent; border-right: 6px solid transparent; border-top: 8px solid #dc3545;"></div></div>',
                    iconSize: [24, 32],
                    iconAnchor: [12, 32],
                    popupAnchor: [0, -32],
                    className: 'custom-red-marker'
                });

                // Function to set map location
                window.setMapLocation = function(lat, lng, description) {
                    // Remove existing selected marker
                    if (window.selectedMarker) {
                        map.removeLayer(window.selectedMarker);
                        window.selectedMarker = null;
                    }
                    
                    // Add new marker
                    window.selectedMarker = L.marker([lat, lng], {icon: selectedIcon})
                        .addTo(map)
                        .bindPopup('<strong>Selected Location</strong><br>' + description + '<br><small>Coordinates: ' + lat.toFixed(6) + ', ' + lng.toFixed(6) + '</small>');
                    
                    // Update form fields
                    var latField = document.getElementById('selectedLatitude');
                    var lngField = document.getElementById('selectedLongitude');
                    var descField = document.getElementById('locationDescription');
                    
                    if (latField) latField.value = lat.toFixed(6);
                    if (lngField) lngField.value = lng.toFixed(6);
                    if (descField) descField.value = description;
                    
                    // Enable the "Use Selected Location" button
                    var useButton = document.getElementById('useLocationButton');
                    if (useButton) {
                        useButton.disabled = false;
                        useButton.innerHTML = '<i class="fas fa-check"></i> Use Selected Location';
                        useButton.classList.remove('btn-outline-secondary');
                        useButton.classList.add('btn-success');
                    }
                    
                    // Update hidden form fields with current main form data
                    var mainForm = document.querySelector('form[method="post"]:not(#locationForm)');
                    if (mainForm) {
                        var hazardTypeField = mainForm.querySelector('[name="HazardReport.HazardType"]');
                        var reportedByField = mainForm.querySelector('[name="HazardReport.ReportedBy"]');
                        var reportedOnField = mainForm.querySelector('[name="HazardReport.ReportedOn"]');
                        var departmentField = mainForm.querySelector('[name="HazardReport.ReportingDepartment"]');
                        var descriptionField = mainForm.querySelector('[name="HazardReport.Description"]');
                        var confidentialField = mainForm.querySelector('[name="HazardReport.IsConfidential"]');
                        var priorityField = mainForm.querySelector('[name="HazardReport.Priority"]');
                        
                        // Update hidden fields in location form
                        var locationForm = document.getElementById('locationForm');
                        if (locationForm) {
                            updateHiddenField(locationForm, 'HazardReport.HazardType', hazardTypeField?.value || '');
                            updateHiddenField(locationForm, 'HazardReport.ReportedBy', reportedByField?.value || '');
                            updateHiddenField(locationForm, 'HazardReport.ReportedOn', reportedOnField?.value || '');
                            updateHiddenField(locationForm, 'HazardReport.ReportingDepartment', departmentField?.value || '');
                            updateHiddenField(locationForm, 'HazardReport.Description', descriptionField?.value || '');
                            updateHiddenField(locationForm, 'HazardReport.IsConfidential', confidentialField?.checked ? 'true' : 'false');
                            updateHiddenField(locationForm, 'HazardReport.Priority', priorityField?.value || '');
                        }
                    }
                };

                // Map click event to set location
                map.on('click', function(e) {
                    // Get clicked coordinates
                    var lat = e.latlng.lat;
                    var lng = e.latlng.lng;
                    
                    // Check if coordinates are within bounds
                    if (window.isWithinBounds(lat, lng)) {
                        // Reverse geocode to get location description
                        fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json&addressdetails=1`)
                            .then(response => response.json())
                            .then(data => {
                                var description = data.display_name || 'Selected location';
                                window.setMapLocation(lat, lng, description);
                            })
                            .catch(error => {
                                console.error('Reverse geocoding error:', error);
                                var description = 'Selected location: Latitude ' + lat.toFixed(6) + ', Longitude ' + lng.toFixed(6);
                                window.setMapLocation(lat, lng, description);
                            });
                    } else {
                        alert('Selected location is out of bounds. Please select a location within the PDX airport area.');
                    }
                });

                // Helper function to update hidden fields
                function updateHiddenField(form, fieldName, value) {
                    var field = form.querySelector('input[name="' + fieldName + '"]');
                    if (field) {
                        field.value = value;
                    }
                }

                // Function to clear map selection
                window.clearMapSelection = function() {
                    // Remove existing selected marker
                    if (window.selectedMarker) {
                        map.removeLayer(window.selectedMarker);
                        window.selectedMarker = null;
                    }
                    
                    // Clear form fields
                    document.getElementById('selectedLatitude').value = '';
                    document.getElementById('selectedLongitude').value = '';
                    document.getElementById('locationDescription').value = '';
                    
                    // Disable the "Use Selected Location" button
                    var useButton = document.getElementById('useLocationButton');
                    if (useButton) {
                        useButton.disabled = true;
                        useButton.innerHTML = '<i class="fas fa-map-marker-alt"></i> Select Location First';
                        useButton.classList.remove('btn-success');
                        useButton.classList.add('btn-outline-secondary');
                    }
                };

                // Set initial marker if coordinates exist
                @if (Model.HasGeoLocation)
                {
                    <text>
                    setTimeout(function() {
                        setMapLocation(@Model.SelectedGeoLocation.Latitude, @Model.SelectedGeoLocation.Longitude, '@Html.Raw(Model.GeoLocationDescription)');
                    }, 500);
                    </text>
                }

                // Initialize button state based on existing coordinates
                setTimeout(function() {
                    var latField = document.getElementById('selectedLatitude');
                    var lngField = document.getElementById('selectedLongitude');
                    var useButton = document.getElementById('useLocationButton');
                    
                    if (useButton) {
                        if (latField && lngField && latField.value && lngField.value && 
                            parseFloat(latField.value) !== 0 && parseFloat(lngField.value) !== 0) {
                            useButton.disabled = false;
                            useButton.innerHTML = '<i class="fas fa-check"></i> Use Selected Location';
                            useButton.classList.remove('btn-outline-secondary');
                            useButton.classList.add('btn-success');
                        } else {
                            useButton.disabled = true;
                            useButton.innerHTML = '<i class="fas fa-map-marker-alt"></i> Select Location First';
                            useButton.classList.remove('btn-success');
                            useButton.classList.add('btn-outline-secondary');
                        }
                    }
                    
                    // If we're showing the modal but already have coordinates, close it
                    var hasGeoLocation = @(Model.HasGeoLocation ? "true" : "false");
                    var showMapModal = @(Model.ShowMapModal ? "true" : "false");
                    
                    console.log('Modal state check:', {
                        hasGeoLocation: hasGeoLocation,
                        showMapModal: showMapModal,
                        latValue: latField ? latField.value : 'no field',
                        lngValue: lngField ? lngField.value : 'no field'
                    });
                    
                    // Force close modal if we have valid coordinates
                    if (hasGeoLocation && !showMapModal) {
                        console.log('Closing modal because we already have location');
                        window.handleLocationSuccess();
                    }
                }, 100);

                // Handle form submission to prevent multiple submissions
                var locationForm = document.getElementById('locationForm');
                if (locationForm) {
                    locationForm.addEventListener('submit', function(e) {
                        var submitButton = e.submitter;
                        if (submitButton && submitButton.id === 'useLocationButton') {
                            // Check if coordinates are actually selected
                            var latField = document.getElementById('selectedLatitude');
                            var lngField = document.getElementById('selectedLongitude');
                            
                            if (!latField.value || !lngField.value || 
                                parseFloat(latField.value) === 0 && parseFloat(lngField.value) === 0) {
                                e.preventDefault();
                                alert('Please select a location on the map first by clicking on the desired location.');
                                return false;
                            }
                            
                            // Show processing state but don't prevent submission
                            submitButton.disabled = true;
                            submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
                            
                            // Add a timeout to reset button if submission hangs
                            setTimeout(function() {
                                if (submitButton.disabled) {
                                    submitButton.disabled = false;
                                    submitButton.innerHTML = '<i class="fas fa-check"></i> Use Selected Location';
                                    alert('Request timed out. Please try again.');
                                }
                            }, 10000); // 10 second timeout
                            
                            // Add debugging to see if form actually submits
                            console.log('Form about to submit with coordinates:', latField.value, lngField.value);
                            
                            // Add a backup mechanism to close modal after submission
                            setTimeout(function() {
                                // If the modal is still visible after 3 seconds, force close it
                                var modal = document.getElementById('locationForm').closest('.modal');
                                if (modal && modal.style.display !== 'none') {
                                    console.log('Force closing modal after timeout');
                                    window.closeModal();
                                }
                            }, 3000);
                            
                            // Form will submit normally to the server
                        }
                    });
                    
                    // Add form success handling
                    window.addEventListener('pageshow', function(event) {
                        // This fires when the page is loaded/reloaded after form submission
                        if (event.persisted || performance.navigation.type === 1) {
                            // Check if we just successfully set a location
                            var hasGeoLocation = @(Model.HasGeoLocation ? "true" : "false");
                            if (hasGeoLocation) {
                                console.log('Location was successfully set, ensuring modal is closed');
                                setTimeout(function() {
                                    window.closeModal();
                                }, 100);
                            }
                        }
                    });
                }

                // Get current location and set map view
                window.getCurrentLocation = function() {
                    var button = document.getElementById('getCurrentLocationBtn');
                    var originalText = button.innerHTML;
                    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Getting Location...';
                    button.disabled = true;
                    
                    if (navigator.geolocation) {
                        navigator.geolocation.getCurrentPosition(function(position) {
                            var lat = position.coords.latitude;
                            var lng = position.coords.longitude;
                            
                            // Set map view and zoom
                            map.setView([lat, lng], 15);
                            

                             // Reverse geocode to get location description
                            fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json&addressdetails=1`)
                                .then(response => response.json())
                                .then(data => {
                                    var description = data.display_name || 'Current location';
                                    
                                    // Set map location with marker
                                    window.setMapLocation(lat, lng, description);
                                    
                                    // Reset button
                                    button.innerHTML = originalText;
                                    button.disabled = false;
                                })
                                .catch(error => {
                                    console.error('Reverse geocoding error:', error);
                                    var description = 'Current location: Latitude ' + lat.toFixed(6) + ', Longitude ' + lng.toFixed(6);
                                    window.setMapLocation(lat, lng, description);
                                    
                                    // Reset button
                                    button.innerHTML = originalText;
                                    button.disabled = false;
                                });
                        }, function(error) {
                            alert('Unable to retrieve your location. Please check your device settings.');
                            
                            // Reset button
                            button.innerHTML = originalText;
                            button.disabled = false;
                        });
                    } else {
                        alert('Geolocation is not supported by this browser.');
                        
                        // Reset button
                        button.innerHTML = originalText;
                        button.disabled = false;
                    }
                };
            });
        </script>
    }
}

<!-- Simple modal close functionality for any remaining modals
        window.closeModal = function() {
            // Find any visible modals and hide them
            var visibleModals = document.querySelectorAll('.modal.show');
            visibleModals.forEach(function(modal) {
                modal.style.display = 'none';
                modal.classList.remove('show');
                modal.classList.remove('d-block');
            });
            
            // Also find modals by specific styling (in case class-based selection fails)
            var styledModals = document.querySelectorAll('.modal[style*="display"]');
            styledModals.forEach(function(modal) {
                modal.style.display = 'none';
            });
            
            // Remove modal backdrop if it exists
            var backdrop = document.querySelector('.modal-backdrop');
            if (backdrop) {
                backdrop.remove();
            }
            
            // Reset body classes
            document.body.classList.remove('modal-open');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
            
            console.log('Modal closed by closeModal function');
        };
        
        // Success message handler
        window.handleLocationSuccess = function() {
            console.log('Location successfully set, closing modal');
            setTimeout(function() {
                window.closeModal();
                
                // Show success feedback
                var locationDisplay = document.getElementById('locationDisplay');
                if (locationDisplay) {
                    locationDisplay.style.backgroundColor = '#d4edda';
                    locationDisplay.style.borderColor = '#c3e6cb';
                    setTimeout(function() {
                        locationDisplay.style.backgroundColor = '';
                        locationDisplay.style.borderColor = '';
                    }, 3000);
                }
            }, 500);
        };

