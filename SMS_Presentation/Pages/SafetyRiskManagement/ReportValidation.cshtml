@page "/SafetyRiskManagement/ReportValidation/{reportId}"
@model SMS.Presentation.Pages.SafetyRiskManagement.ReportValidationModel
@{
    ViewData["Title"] = "SMS Report Validation";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyRiskManagement">Safety Risk Management</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyRiskManagement/HazardProcessing">Report Processing</a></li>
                    <li class="breadcrumb-item active">Report Validation</li>
                </ol>
            </nav>
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="card-title">
                                <i class="fas fa-check-circle"></i> SMS Report Validation &nbsp; <strong>@(Model.ReportDetails?.Code ?? Model.ReportId)</strong>
                            </h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Left Column - Main Form Content -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-clipboard-check"></i> SMS Report Validation Decision</h5>
                </div>
                <div class="card-body">
                    <!-- Report Description Display -->
                    <div class="mb-4">
                        <h6><i class="fas fa-file-text"></i> Report Description</h6>
                        <div class="card bg-light">
                            <div class="card-body">
                                <p class="mb-0">@(Model.ReportDetails?.Description ?? "Report description not available")</p>
                            </div>
                        </div>
                    </div>

                    <form method="post" novalidate id="validationForm">
                        <!-- Hidden fields to maintain state -->
                        <input type="hidden" asp-for="ReportId" />
                        <input type="hidden" asp-for="IsExistingValidation" />
                        <input type="hidden" asp-for="ExistingValidationId" />
                        <input type="hidden" asp-for="ValidationDecision" id="hiddenValidationDecision" />
                        <input type="hidden" asp-for="HazardId" />
                        
                        <!-- Display any validation errors -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <h6><i class="fas fa-exclamation-triangle"></i> Please correct the following errors:</h6>
                                <ul class="mb-0">
                                    @foreach (var modelError in ViewData.ModelState.Where(ms => ms.Value.Errors.Any()))
                                    {
                                        foreach (var error in modelError.Value.Errors)
                                        {
                                            <li>@error.ErrorMessage</li>
                                        }
                                    }
                                </ul>
                            </div>
                        }

                        <!-- SMS Risk Decision -->
                        <div class="mb-4">
                            <h6><i class="fas fa-gavel"></i> Validation Decision <span class="text-danger">*</span></h6>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="card h-100 @(Model.ValidationDecision == "SMS_RISK" ? "border-success bg-light" : "border-light")">
                                        <div class="card-body text-center">
                                            <div class="form-check">
                                                <input class="form-check-input radio-trigger" type="radio" asp-for="ValidationDecision" 
                                                       value="SMS_RISK" id="smsRisk" required>
                                                <label class="form-check-label" for="smsRisk">
                                                    <i class="fas fa-check-circle text-success fa-2x d-block mb-2"></i>
                                                    <strong>SMS Risk</strong>
                                                    <small class="d-block text-muted">Proceed with formal risk assessment</small>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card h-100 @(Model.ValidationDecision == "NOT_SMS_RISK" ? "border-danger bg-light" : "border-light")">
                                        <div class="card-body text-center">
                                            <div class="form-check">
                                                <input class="form-check-input radio-trigger" type="radio" asp-for="ValidationDecision" 
                                                       value="NOT_SMS_RISK" id="notSmsRisk" required>
                                                <label class="form-check-label" for="notSmsRisk">
                                                    <i class="fas fa-times-circle text-danger fa-2x d-block mb-2"></i>
                                                    <strong>Not SMS Risk</strong>
                                                    <small class="d-block text-muted">Refer to other department or close</small>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card h-100 @(Model.ValidationDecision == "NEEDS_INVESTIGATION" ? "border-warning bg-light" : "border-light")">
                                        <div class="card-body text-center">
                                            <div class="form-check">
                                                <input class="form-check-input radio-trigger" type="radio" asp-for="ValidationDecision" 
                                                       value="NEEDS_INVESTIGATION" id="needsInvestigation" required>
                                                <label class="form-check-label" for="needsInvestigation">
                                                    <i class="fas fa-search text-warning fa-2x d-block mb-2"></i>
                                                    <strong>Need More Info</strong>
                                                    <small class="d-block text-muted">Gather additional information first</small>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Validation Comments -->
                        <div class="mb-4">
                            <label class="form-label">Validation Comments <span class="text-danger">*</span></label>
                            <textarea class="form-control" asp-for="ValidationComments" rows="4" 
                                      placeholder="Provide detailed reasoning for your validation decision..." required></textarea>
                            <div class="form-text">Minimum 5 characters required</div>
                        </div>

                        <!-- Conditional Fields for Assessment Assignment (SMS Risk only) -->
                        <div id="smsRiskFields" class="mb-4" style="display: @(Model.ValidationDecision == "SMS_RISK" ? "block" : "none");">
                            <div class="card border-success">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="fas fa-user-check"></i> Assessment Assignment</h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label">Validation Type</label>
                                        <select class="form-select" asp-for="ValidationType">
                                            <option value="Standard">Standard Validation</option>
                                            <option value="Expedited">Expedited Validation</option>
                                            <option value="Complex">Complex Case Validation</option>
                                        </select>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label">Assigned Assessor</label>
                                        <select class="form-select" asp-for="ValidatedBy">
                                            <option value="">Auto-assign based on workload</option>
                                            @if (Model.AvailableAssessors?.Any() == true)
                                            {
                                                @foreach (var assessor in Model.AvailableAssessors)
                                                {
                                                    <option value="@assessor.Id.Value">@assessor.UserName.Value - @assessor.ApplicationRole</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row">
                            <div class="col-12">
                                <hr>
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <a href="/SafetyRiskManagement/HazardProcessing" class="btn btn-outline-secondary">
                                            <i class="fas fa-arrow-left"></i> Back to Processing Queue
                                        </a>
                                    </div>
                                    <div>
                                        <!-- Save Draft button -->
                                        <button type="submit" class="btn btn-outline-info me-2" formaction="?handler=SaveDraft" formnovalidate>
                                            <i class="fas fa-save"></i> Save Draft
                                        </button>
                                                
                                        <!-- Proceed to Risk Assessment button - HIDDEN BY DEFAULT -->
                                        <button type="submit" class="btn btn-success btn-lg me-2" 
                                                id="proceedToAssessmentBtn" 
                                                formaction="?handler=ProceedToAssessmentAsync"
                                                style="display: none;">
                                            <i class="fas fa-arrow-right"></i> Proceed to Risk Assessment
                                        </button>
                                        
                                        <!-- Submit Validation button - VISIBLE BY DEFAULT -->
                                        <button type="submit" class="btn btn-primary btn-lg" 
                                                id="submitValidationBtn">
                                            <i class="fas fa-check-circle"></i> Submit Validation
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <!-- Right Column - Summary and Guidance -->
        <div class="col-lg-4">
            <!-- Report Summary Card -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="fas fa-file-alt"></i> Report Summary</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td class="fw-bold">Report Code:</td>
                                <td>@(Model.ReportId ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Status:</td>
                                <td>
                                    <span class="badge @((Model.CurrentStatus == "Completed") ? "bg-success" : (Model.CurrentStatus == "Draft") ? "bg-warning" : "bg-info")">
                                        @Model.CurrentStatus
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Validator:</td>
                                <td>@(Model.ValidatedBy ?? User?.Identity?.Name ?? "System")</td>
                            </tr>
                            @if (Model.IsUpdate)
                            {
                                <tr>
                                    <td class="fw-bold">Validation Code:</td>
                                    <td>@Model.ValidationCode</td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>
            </div>

            <!-- Validation Guidance -->
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0"><i class="fas fa-lightbulb"></i> Validation Guidance</h6>
                </div>
                <div class="card-body">
                    <h6 class="small">A report should be classified as SMS Risk if:</h6>
                    <ul class="list-unstyled small">
                        <li><i class="fas fa-check text-success"></i> Could affect safety of flight operations</li>
                        <li><i class="fas fa-check text-success"></i> Involves safety-critical systems</li>
                        <li><i class="fas fa-check text-success"></i> Has potential for serious consequences</li>
                        <li><i class="fas fa-check text-success"></i> Indicates system deficiency</li>
                    </ul>

                    <h6 class="small mt-3">Not SMS Risk if:</h6>
                    <ul class="list-unstyled small">
                        <li><i class="fas fa-times text-danger"></i> Routine maintenance issue only</li>
                        <li><i class="fas fa-times text-danger"></i> Administrative matter only</li>
                        <li><i class="fas fa-times text-danger"></i> Outside SMS scope</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🔧 ReportValidation script loading...');
            
            // Get all radio buttons
            const radioButtons = document.querySelectorAll('.radio-trigger');
            const smsRiskFields = document.getElementById('smsRiskFields');
            const proceedToAssessmentBtn = document.getElementById('proceedToAssessmentBtn');
            const submitValidationBtn = document.getElementById('submitValidationBtn');

            console.log('📊 Found elements:', {
                radioButtons: radioButtons.length,
                smsRiskFields: smsRiskFields ? 'found' : 'missing',
                proceedToAssessmentBtn: proceedToAssessmentBtn ? 'found' : 'missing',
                submitValidationBtn: submitValidationBtn ? 'found' : 'missing'
            });

            // Function to update UI based on selection
            function updateUIForSelection(selectedValue) {
                console.log('🎯 Updating UI for selection:', selectedValue);
                
                // Update the hidden field to preserve the selection
                const hiddenField = document.getElementById('hiddenValidationDecision');
                if (hiddenField) {
                    hiddenField.value = selectedValue;
                    console.log('💾 Updated hidden field to:', selectedValue);
                }
                
                // Reset all cards
                document.querySelectorAll('.card.h-100').forEach(card => {
                    card.classList.remove('border-success', 'border-danger', 'border-warning', 'bg-light');
                    card.classList.add('border-light');
                });

                // Apply styling to selected card
                const selectedRadio = document.querySelector(`input[value="${selectedValue}"]`);
                if (selectedRadio) {
                    const card = selectedRadio.closest('.card');
                    if (card) {
                        card.classList.remove('border-light');
                        card.classList.add('bg-light');
                        
                        switch(selectedValue) {
                            case 'SMS_RISK':
                                card.classList.add('border-success');
                                break;
                            case 'NOT_SMS_RISK':
                                card.classList.add('border-danger');
                                break;
                            case 'NEEDS_INVESTIGATION':
                                card.classList.add('border-warning');
                                break;
                        }
                    }
                }

                // Show/hide SMS Risk fields
                if (smsRiskFields) {
                    smsRiskFields.style.display = selectedValue === 'SMS_RISK' ? 'block' : 'none';
                    console.log('📝 SMS Risk fields:', selectedValue === 'SMS_RISK' ? 'shown' : 'hidden');
                }

                // Show/hide appropriate action buttons based on selection
                if (proceedToAssessmentBtn && submitValidationBtn) {
                    if (selectedValue === 'SMS_RISK') {
                        // Show "Proceed to Assessment" button, hide "Submit Validation" button
                        proceedToAssessmentBtn.style.display = 'inline-block';
                        submitValidationBtn.style.display = 'none';
                        console.log('🎯 Buttons: Proceed=shown, Submit=hidden');
                    } else {
                        // Show "Submit Validation" button, hide "Proceed to Assessment" button
                        proceedToAssessmentBtn.style.display = 'none';
                        submitValidationBtn.style.display = 'inline-block';
                        console.log('🎯 Buttons: Proceed=hidden, Submit=shown');
                    }
                }
            }

            // Add event listeners WITH PREVENTION OF DEFAULT BEHAVIOR
            radioButtons.forEach(radio => {
                radio.addEventListener('change', function(event) {
                    console.log('📻 Radio button changed to:', this.value);
                    
                    // Prevent any default form submission
                    event.preventDefault();
                    event.stopPropagation();
                    
                    if (this.checked) {
                        updateUIForSelection(this.value);
                    }
                    
                    // Return false to prevent any further event handling
                    return false;
                });
            });

            // Also prevent click events on labels from causing issues
            const labels = document.querySelectorAll('.form-check-label');
            labels.forEach(label => {
                label.addEventListener('click', function(event) {
                    console.log('🏷️ Label clicked:', this.getAttribute('for'));
                    // Let the label click through to the radio button naturally
                    // but prevent any extra behavior
                });
            });

            // Prevent accidental form submission on radio button changes
            const form = document.getElementById('validationForm');
            if (form) {
                form.addEventListener('submit', function(event) {
                    console.log('🚨 FORM SUBMISSION DETECTED!');
                    console.log('📝 Form action:', this.action);
                    console.log('📝 Submit trigger:', event.submitter?.outerHTML || 'unknown');
                    
                    // Only allow submission if it's from a button click, not radio change
                    if (!event.submitter) {
                        console.log('❌ BLOCKING: No submitter detected (likely radio change)');
                        event.preventDefault();
                        return false;
                    }
                });
            }

            // Initialize on page load
            const checkedRadio = document.querySelector('.radio-trigger:checked');
            if (checkedRadio) {
                console.log('🔄 Initializing with checked radio:', checkedRadio.value);
                updateUIForSelection(checkedRadio.value);
            } else {
                console.log('🔄 No radio checked, showing default state');
                // Default state - show Submit Validation button, hide Proceed to Assessment
                if (submitValidationBtn) submitValidationBtn.style.display = 'inline-block';
                if (proceedToAssessmentBtn) proceedToAssessmentBtn.style.display = 'none';
            }
            
            console.log('✅ ReportValidation script loaded successfully');
        });
    </script>
}



