// Validation before step progression
function validateStep2() {
    const hazardDescriptions = document.querySelectorAll('textarea[name*="Description"]:not([name*="AdditionalComments"])');
    
    let incompleteHazards = [];
    let validationErrors = [];

    hazardDescriptions.forEach((textarea, index) => {
        const description = textarea.value.trim();
        const hazardNumber = index + 1;
        
        // Check if field is empty
        if (!description) {
            incompleteHazards.push(`Hazard ${hazardNumber}`);
        }
        // Check minimum length requirements (10 characters)
        else if (description.length < 10) {
            validationErrors.push(`Hazard ${hazardNumber} description must be at least 10 characters (currently ${description.length})`);
        }
    });
    
    // Show validation errors
    if (incompleteHazards.length > 0) {
        alert(`Please provide descriptions for the following hazards:\n\n• ${incompleteHazards.join('\n• ')}\n\nAll hazard descriptions are required.`);
        return false;
    }
    
    if (validationErrors.length > 0) {
        alert(`Please provide more detailed hazard descriptions:\n\n• ${validationErrors.join('\n• ')}\n\nEach description requires at least 10 characters for meaningful analysis.`);
        return false;
    }
    
    return true;
}

// Real-time validation feedback for Step 2
function addStep2RealTimeValidation() {
    const hazardDescriptions = document.querySelectorAll('textarea[name*="Description"]:not([name*="AdditionalComments"])');
    
    hazardDescriptions.forEach(textarea => {
        // Add character counter
        const formText = textarea.closest('.form-group, .mb-3')?.querySelector('.form-text');
        if (formText) {
            const counter = document.createElement('small');
            counter.className = 'text-muted ms-2';
            counter.style.fontSize = '0.75em';
            formText.parentNode.insertBefore(counter, formText.nextSibling);
            
            function updateValidation() {
                const length = textarea.value.trim().length;
                const minLength = 10;
                
                // Update counter
                counter.textContent = `${length}/${minLength} characters`;
                
                // Update styling based on validation
                if (length === 0) {
                    textarea.classList.remove('is-valid', 'is-invalid');
                    counter.className = 'text-muted ms-2';
                } else if (length < minLength) {
                    textarea.classList.remove('is-valid');
                    textarea.classList.add('is-invalid');
                    counter.className = 'text-danger ms-2';
                    counter.textContent = `${length}/${minLength} characters (minimum ${minLength} required)`;
                } else {
                    textarea.classList.remove('is-invalid');
                    textarea.classList.add('is-valid');
                    counter.className = 'text-success ms-2';
                    counter.textContent = `${length} characters ?`;
                }
            }
            
            // Initial validation
            updateValidation();
            
            // Add event listeners
            textarea.addEventListener('input', updateValidation);
            textarea.addEventListener('blur', updateValidation);
        }
    });
}

// Initialize Step 2 validation when hazards are added/loaded
function initializeStep2Validation() {
    // Add real-time validation with character counters
    setTimeout(() => {
        addStep2RealTimeValidation();
    }, 500); // Small delay to ensure DOM is ready
    
    // Hook into form submission for validation
    const form = document.querySelector('form');
    if (form && !form.hasAttribute('data-validation-attached')) {
        form.setAttribute('data-validation-attached', 'true');
        form.addEventListener('submit', function(e) {
            const submitButton = document.activeElement;
            
            // Only validate for Next Step button, not Save Draft
            if (submitButton && (submitButton.textContent.includes('Next Step') || submitButton.textContent.includes('Continue'))) {
                if (!validateStep2()) {
                    e.preventDefault();
                    return false;
                }
            }
        });
    }
}

// Initialize when page loads
document.addEventListener('DOMContentLoaded', function() {
    initializeStep2Validation();
    
    // Re-initialize validation when hazards are dynamically added
    const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
                // Check if hazard cards were added
                const addedHazards = Array.from(mutation.addedNodes).some(node => 
                    node.nodeType === Node.ELEMENT_NODE && 
                    (node.classList?.contains('hazard-card') || node.querySelector?.('.hazard-card'))
                );
                
                if (addedHazards) {
                    setTimeout(() => {
                        addStep2RealTimeValidation();
                    }, 100);
                }
            }
        });
    });
    
    // Start observing
    const hazardContainer = document.getElementById('hazard-list') || document.querySelector('.hazard-container') || document.body;
    observer.observe(hazardContainer, {
        childList: true,
        subtree: true
    });
});
</script>
