@model SMS.Presentation.Pages.SafetyRiskManagement.RiskAssessmentWizardModel

<!-- SMS Risk Matrix (5x5) Analysis -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="fas fa-table"></i> SMS Risk Matrix (5x5) Reference Guide</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered text-center risk-matrix">
                        <thead>
                            <tr>
                                <th rowspan="2" class="align-middle">Severity ?<br>? Likelihood</th>
                                <th class="bg-light">1<br>Minor</th>
                                <th class="bg-light">2<br>Moderate</th>
                                <th class="bg-light">3<br>Serious</th>
                                <th class="bg-light">4<br>Major</th>
                                <th class="bg-light">5<br>Catastrophic</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th class="bg-light">A - Rare</th>
                                <td class="bg-success text-white">1A<br>Very Low</td>
                                <td class="bg-success text-white">2A<br>Very Low</td>
                                <td class="bg-success text-white">3A<br>Very Low</td>
                                <td class="bg-success text-white">4A<br>Very Low</td>
                                <td class="bg-warning text-dark">5A<br>Low</td>
                            </tr>
                            <tr>
                                <th class="bg-light">B - Unlikely</th>
                                <td class="bg-success text-white">1B<br>Very Low</td>
                                <td class="bg-success text-white">2B<br>Very Low</td>
                                <td class="bg-warning text-dark">3B<br>Low</td>
                                <td class="bg-warning text-dark">4B<br>Low</td>
                                <td class="bg-info text-white">5B<br>Medium</td>
                            </tr>
                            <tr>
                                <th class="bg-light">C - Possible</th>
                                <td class="bg-success text-white">1C<br>Very Low</td>
                                <td class="bg-warning text-dark">2C<br>Low</td>
                                <td class="bg-warning text-dark">3C<br>Low</td>
                                <td class="bg-info text-white">4C<br>Medium</td>
                                <td class="bg-danger text-white">5C<br>High</td>
                            </tr>
                            <tr>
                                <th class="bg-light">D - Likely</th>
                                <td class="bg-success text-white">1D<br>Very Low</td>
                                <td class="bg-warning text-dark">2D<br>Low</td>
                                <td class="bg-info text-white">3D<br>Medium</td>
                                <td class="bg-danger text-white">4D<br>High</td>
                                <td class="bg-danger text-white">5D<br>High</td>
                            </tr>
                            <tr>
                                <th class="bg-light">E - Frequent</th>
                                <td class="bg-warning text-dark">1E<br>Low</td>
                                <td class="bg-info text-white">2E<br>Medium</td>
                                <td class="bg-danger text-white">3E<br>High</td>
                                <td class="bg-danger text-white">4E<br>High</td>
                                <td class="bg-dark text-white">5E<br>Very High</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                <!-- SMS Matrix Guidance -->
                <div class="row mt-3">
                    <div class="col-md-6">
                        <h6><i class="fas fa-info-circle"></i> Severity Levels</h6>
                        <ul class="small">
                            <li><strong>1 - Minor:</strong> First aid only, minor delays</li>
                            <li><strong>2 - Moderate:</strong> Medical treatment, localized disruption</li>
                            <li><strong>3 - Serious:</strong> Hospitalization, temporary closures</li>
                            <li><strong>4 - Major:</strong> Permanent injury, extended closures</li>
                            <li><strong>5 - Catastrophic:</strong> Fatalities, major infrastructure damage</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6><i class="fas fa-clock"></i> Likelihood Levels</h6>
                        <ul class="small">
                            <li><strong>A - Rare:</strong> Less than once per decade</li>
                            <li><strong>B - Unlikely:</strong> Once every 5-10 years</li>
                            <li><strong>C - Possible:</strong> Once per year or few times every 2-5 years</li>
                            <li><strong>D - Likely:</strong> Once per month or several times per year</li>
                            <li><strong>E - Frequent:</strong> At least once per week</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SMS Risk Matrix Analysis Form -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h6 class="mb-0"><i class="fas fa-calculator"></i> SMS Risk Matrix Analysis</h6>
            </div>
            <div class="card-body">
                @if (Model.AssessmentData.IdentifiedHazards?.Any() == true)
                {
                    <form method="post">
                        <!-- Hidden fields to maintain state -->
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="StepNumber" />
                        <input type="hidden" asp-for="AssessmentData.RiskAnalysisMethod" />
                        <input type="hidden" asp-for="AssessmentData.RiskCriteria" />

                        @for (int i = 0; i < Model.AssessmentData.IdentifiedHazards.Count; i++)
                        {
                            var hazard = Model.AssessmentData.IdentifiedHazards[i];
                            var riskLevel = hazard.RiskLevel ?? "";
                            var severity = !string.IsNullOrEmpty(hazard.Severity) ? hazard.Severity : "";
                            var likelihood = !string.IsNullOrEmpty(hazard.Likelihood) ? hazard.Likelihood : "";
                            
                            <!-- Hidden fields to preserve hazard data -->
                            <input type="hidden" name="AssessmentData.IdentifiedHazards[@i].Id" value="@hazard.Id" />
                            <input type="hidden" name="AssessmentData.IdentifiedHazards[@i].Description" value="@hazard.Description" />
                            <input type="hidden" name="AssessmentData.IdentifiedHazards[@i].Category" value="@hazard.Category" />
                            <input type="hidden" name="AssessmentData.IdentifiedHazards[@i].WorstCredibleOutcome" value="@hazard.WorstCredibleOutcome" />
                            
                            <div class="card border-secondary mb-3">
                                <div class="card-header">
                                    <div class="row align-items-center">
                                        <div class="col">
                                            <strong>@hazard.Id: @hazard.Description</strong>
                                            @if (!string.IsNullOrEmpty(hazard.Category))
                                            {
                                                <span class="badge bg-info ms-2">@hazard.Category</span>
                                            }
                                        </div>
                                        <div class="col-auto">
                                            @{
                                                var currentRiskLevel = Model.CalculateRiskLevel(severity, likelihood);
                                            }
                                            @if (!string.IsNullOrEmpty(currentRiskLevel))
                                            {
                                                var riskClass = Model.GetRiskLevelClass(currentRiskLevel);
                                                <span class="badge bg-@riskClass">@currentRiskLevel - @Model.GetRiskLevelText(currentRiskLevel)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Not Analyzed</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label">Severity Level <span class="text-danger">*</span></label>
                                                <select class="form-select severity-select" name="AssessmentData.IdentifiedHazards[@i].Severity">
                                                    <option value="">Select severity...</option>
                                                    <option value="1" selected="@(severity == "1")">1 - Minor</option>
                                                    <option value="2" selected="@(severity == "2")">2 - Moderate</option>
                                                    <option value="3" selected="@(severity == "3")">3 - Serious</option>
                                                    <option value="4" selected="@(severity == "4")">4 - Major</option>
                                                    <option value="5" selected="@(severity == "5")">5 - Catastrophic</option>
                                                </select>
                                                <div class="form-text">
                                                    <small>@Model.GetSeverityDescription(severity)</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label">Likelihood Level <span class="text-danger">*</span></label>
                                                <select class="form-select likelihood-select" name="AssessmentData.IdentifiedHazards[@i].Likelihood">
                                                    <option value="">Select likelihood...</option>
                                                    <option value="A" selected="@(likelihood == "A")">A - Rare</option>
                                                    <option value="B" selected="@(likelihood == "B")">B - Unlikely</option>
                                                    <option value="C" selected="@(likelihood == "C")">C - Possible</option>
                                                    <option value="D" selected="@(likelihood == "D")">D - Likely</option>
                                                    <option value="E" selected="@(likelihood == "E")">E - Frequent</option>
                                                </select>
                                                <div class="form-text">
                                                    <small>@Model.GetLikelihoodDescription(likelihood)</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label">Risk Level</label>
                                                @{
                                                    var calculatedRiskLevel = Model.CalculateRiskLevel(severity, likelihood);
                                                }
                                                <input type="text" class="form-control risk-level-display" name="AssessmentData.IdentifiedHazards[@i].RiskLevel" 
                                                       value="@calculatedRiskLevel" readonly>
                                                <div class="form-text">
                                                    <small class="text-@Model.GetRiskLevelClass(calculatedRiskLevel)">@Model.GetRiskLevelText(calculatedRiskLevel)</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    @if (!string.IsNullOrEmpty(hazard.WorstCredibleOutcome))
                                    {
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="alert alert-warning small">
                                                    <strong>Worst Credible Outcome:</strong> @hazard.WorstCredibleOutcome
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Update Risk Levels Button - FIXED to use JavaScript -->
                        <div class="row mb-3">
                            <div class="col-12 text-center">
                                <button type="button" class="btn btn-primary" onclick="calculateAllRiskLevelsAnalysis()">
                                    <i class="fas fa-calculator"></i> Calculate All Risk Levels
                                </button>
                                <div class="form-text">
                                    Click after changing severity or likelihood values to recalculate all risk levels
                                </div>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                        <p>No hazards identified yet.</p>
                        <p class="small">Please complete Step 2 (Identify Hazards) before proceeding with SMS Risk Matrix analysis.</p>
                        <a href="/SafetyRiskManagement/RiskAssessmentWizard/@Model.Id/step/2" class="btn btn-warning">
                            <i class="fas fa-arrow-left"></i> Go to Step 2
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
// Risk calculation functions for Analysis form
function calculateRiskLevelAnalysis(severity, likelihood) {
    if (!severity || !likelihood) return '';
    return severity + likelihood;
}

function getRiskLevelClassAnalysis(riskLevel) {
    const riskMatrix = {
        '1A': 'success', '1B': 'success', '1C': 'success', '1D': 'success', '1E': 'warning',
        '2A': 'success', '2B': 'success', '2C': 'warning', '2D': 'warning', '2E': 'info',
        '3A': 'success', '3B': 'warning', '3C': 'warning', '3D': 'info', '3E': 'danger',
        '4A': 'success', '4B': 'warning', '4C': 'info', '4D': 'danger', '4E': 'danger',
        '5A': 'warning', '5B': 'info', '5C': 'danger', '5D': 'danger', '5E': 'dark'
    };
    return riskMatrix[riskLevel] || 'secondary';
}

function getRiskLevelTextAnalysis(riskLevel) {
    const riskMatrix = {
        '1A': 'Very Low Risk', '1B': 'Very Low Risk', '1C': 'Very Low Risk', '1D': 'Very Low Risk', '1E': 'Low Risk',
        '2A': 'Very Low Risk', '2B': 'Very Low Risk', '2C': 'Low Risk', '2D': 'Low Risk', '2E': 'Medium Risk',
        '3A': 'Very Low Risk', '3B': 'Low Risk', '3C': 'Low Risk', '3D': 'Medium Risk', '3E': 'High Risk',
        '4A': 'Very Low Risk', '4B': 'Low Risk', '4C': 'Medium Risk', '4D': 'High Risk', '4E': 'High Risk',
        '5A': 'Low Risk', '5B': 'Medium Risk', '5C': 'High Risk', '5D': 'High Risk', '5E': 'Very High Risk'
    };
    return riskMatrix[riskLevel] || '';
}

function calculateAllRiskLevelsAnalysis() {
    // Find all severity and likelihood selects
    const severitySelects = document.querySelectorAll('.severity-select');
    const likelihoodSelects = document.querySelectorAll('.likelihood-select');
    const riskLevelDisplays = document.querySelectorAll('.risk-level-display');
    
    for (let i = 0; i < severitySelects.length; i++) {
        const severity = severitySelects[i].value;
        const likelihood = likelihoodSelects[i].value;
        const riskLevel = calculateRiskLevelAnalysis(severity, likelihood);
        
        // Update the risk level display
        if (riskLevelDisplays[i]) {
            riskLevelDisplays[i].value = riskLevel;
        }
        
        // Update the badge in the card header
        const card = severitySelects[i].closest('.card');
        if (card) {
            const badgeContainer = card.querySelector('.card-header .col-auto');
            if (badgeContainer && riskLevel) {
                const riskClass = getRiskLevelClassAnalysis(riskLevel);
                const riskText = getRiskLevelTextAnalysis(riskLevel);
                badgeContainer.innerHTML = `<span class="badge bg-${riskClass}">${riskLevel} - ${riskText}</span>`;
            } else if (badgeContainer) {
                badgeContainer.innerHTML = '<span class="badge bg-secondary">Not Analyzed</span>';
            }
        }
        
        // Update the form text below risk level
        const formText = riskLevelDisplays[i]?.parentNode?.querySelector('.form-text small');
        if (formText && riskLevel) {
            const riskClass = getRiskLevelClassAnalysis(riskLevel);
            const riskText = getRiskLevelTextAnalysis(riskLevel);
            formText.className = `text-${riskClass}`;
            formText.textContent = riskText;
        }
    }
    
    console.log('All risk levels calculated successfully (Analysis)');
    
    // Show a brief success indicator
    const button = event.target;
    const originalContent = button.innerHTML;
    button.innerHTML = '<i class="fas fa-check"></i> Calculated!';
    button.classList.remove('btn-primary');
    button.classList.add('btn-success');
    
    setTimeout(() => {
        button.innerHTML = originalContent;
        button.classList.remove('btn-success');
        button.classList.add('btn-primary');
    }, 1500);
}

// Auto-calculate when severity or likelihood changes (Analysis version)
document.addEventListener('change', function(e) {
    if (e.target.classList.contains('severity-select') || e.target.classList.contains('likelihood-select')) {
        const card = e.target.closest('.card');
        if (card) {
            const severitySelect = card.querySelector('.severity-select');
            const likelihoodSelect = card.querySelector('.likelihood-select');
            const riskLevelDisplay = card.querySelector('.risk-level-display');
            
            if (severitySelect && likelihoodSelect && riskLevelDisplay) {
                const severity = severitySelect.value;
                const likelihood = likelihoodSelect.value;
                const riskLevel = calculateRiskLevelAnalysis(severity, likelihood);
                
                riskLevelDisplay.value = riskLevel;
                
                // Update badge and form text
                const badgeContainer = card.querySelector('.card-header .col-auto');
                const formText = riskLevelDisplay.parentNode.querySelector('.form-text small');
                
                if (riskLevel) {
                    const riskClass = getRiskLevelClassAnalysis(riskLevel);
                    const riskText = getRiskLevelTextAnalysis(riskLevel);
                    
                    if (badgeContainer) {
                        badgeContainer.innerHTML = `<span class="badge bg-${riskClass}">${riskLevel} - ${riskText}</span>`;
                    }
                    if (formText) {
                        formText.className = `text-${riskClass}`;
                        formText.textContent = riskText;
                    }
                } else {
                    if (badgeContainer) {
                        badgeContainer.innerHTML = '<span class="badge bg-secondary">Not Analyzed</span>';
                    }
                    if (formText) {
                        formText.className = '';
                        formText.textContent = '';
                    }
                }
            }
        }
    }
});
</script>

<style>
.risk-matrix td, .risk-matrix th {
    padding: 8px;
    font-size: 0.85em;
    min-width: 80px;
}
</style>

