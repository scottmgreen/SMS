@page
@model SMS_Presentation.Pages.SafetyRiskManagement.ReportProcessingModel
@{
    ViewData["Title"] = "Report Processing";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyRiskManagement">Safety Risk Management</a></li>
                    <li class="breadcrumb-item active">Report Processing</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="card-title"><i class="fas fa-cogs"></i> Report Processing Workflow</h4>
                            <p class="card-text mb-0">Process reports and manage SMS risk validation workflow</p>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="row text-center">
                                <div class="col-6">
                                    <h3 class="mb-0">@Model.Dashboard.TotalActive</h3>
                                    <small>Active Reports</small>
                                </div>
                                <div class="col-6">
                                    <h3 class="mb-0">@Model.Dashboard.AverageProcessingTime.ToString("F1")</h3>
                                    <small>Avg Days</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Process Flow Dashboard -->
    <div class="row mb-4">
        <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
            <div class="card border-primary text-center">
                <div class="card-body p-2">
                    <h4 class="text-primary mb-1">@Model.Dashboard.PendingValidation</h4>
                    <p class="mb-0 small">Pending Validation</p>
                    <small class="text-muted">SMS Risk Determination</small>
                </div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
            <div class="card border-info text-center">
                <div class="card-body p-2">
                    <h4 class="text-info mb-1">@Model.Dashboard.PendingRiskAssessment</h4>
                    <p class="mb-0 small">Risk Assessment</p>
                    <small class="text-muted">Preliminary Assessment</small>
                </div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
            <div class="card border-purple text-center" style="border-color: #6f42c1 !important;">
                <div class="card-body p-2">
                    <h4 class="mb-1" style="color: #6f42c1;">@Model.Dashboard.PendingInvestigation</h4>
                    <p class="mb-0 small">Investigation</p>
                    <small class="text-muted">Information Needed</small>
                </div>
            </div>
        </div>
       @*  <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
            <div class="card border-warning text-center">
                <div class="card-body p-2">
                    <h4 class="text-warning mb-1">@Model.PendingTRA</h4>
                    <p class="mb-0 small">Pending TRA</p>
                    <small class="text-muted">Technical Risk Assessment</small>
                </div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
            <div class="card border-danger text-center">
                <div class="card-body p-2">
                    <h4 class="text-danger mb-1">@Model.PendingLeadershipApproval</h4>
                    <p class="mb-0 small">Leadership</p>
                    <small class="text-muted">SMS Leadership Approval</small>
                </div>
            </div>
        </div> *@
        <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
            <div class="card border-success text-center">
                <div class="card-body p-2">
                    <h4 class="text-success mb-1">@Model.Dashboard.InMitigation</h4>
                    <p class="mb-0 small">Mitigation</p>
                    <small class="text-muted">Implementation</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Workflow Stages -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" href="#validation" data-bs-toggle="tab">
                                <i class="fas fa-check-circle"></i> Validation (@Model.PendingValidation.Count)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#riskassessment" data-bs-toggle="tab">
                                <i class="fas fa-search"></i> Risk Assessment (@Model.PendingRiskAssessment.Count)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#investigation" data-bs-toggle="tab">
                                <i class="fas fa-search-plus"></i> Investigation (@Model.PendingInvestigation.Count)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#tra" data-bs-toggle="tab">
                                <i class="fas fa-microscope"></i> TRA (@Model.PendingTRA.Count)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#leadership" data-bs-toggle="tab">
                                <i class="fas fa-user-tie"></i> Leadership (@Model.PendingLeadershipApproval.Count)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#mitigation" data-bs-toggle="tab">
                                <i class="fas fa-tools"></i> Mitigation (@Model.InMitigation.Count)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#closed" data-bs-toggle="tab">
                                <i class="fas fa-archive"></i> Closed (@Model.ClosedReferred.Count)
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content">
                        <!-- Validation Tab -->
                        <div class="tab-pane fade show active" id="validation" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5>SMS Risk Validation</h5>
                                <div class="alert alert-info small mb-0 py-2">
                                    <i class="fas fa-info-circle"></i> Determine if reported items constitute SMS risks requiring formal processing
                                </div>
                            </div>
                            
                            @if (Model.PendingValidation.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Report ID</th>
                                                <th>Type</th>
                                                <th>Description</th>
                                                <th>Priority</th>
                                                <th>Reported By</th>
                                                <th>Reported Date</th>
                                                <th>Days Pending</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var report in Model.PendingValidation)
                                            {
                                                <tr>
                                                    <td>
                                                        <strong>@report.DisplayId</strong>
                                                        @if (report.IsConfidential)
                                                        {
                                                            <br><span class="badge bg-warning"><i class="fas fa-lock"></i> Confidential</span>
                                                        }
                                                    </td>
                                                    <td>@report.DisplayType</td>
                                                    <td>
                                                        <div style="max-width: 200px;">
                                                            @(report.HazardDescription.Length > 100 ? 
                                                                report.HazardDescription.Substring(0, 100) + "..." : 
                                                                report.HazardDescription)
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="badge @(report.Priority == "High" ? "bg-danger" : report.Priority == "Medium" ? "bg-warning" : "bg-info")">
                                                            @report.Priority
                                                        </span>
                                                    </td>
                                                    <td>@report.ReportedBy</td>
                                                    <td>@report.ReportedDate.ToString("MM/dd/yyyy")</td>
                                                    <td>
                                                        <span class="badge @(report.DaysInStage > 2 ? "bg-warning" : "bg-secondary")">
                                                            @report.DaysInStage days
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <a href="@report.ValidationUrl" class="btn btn-success">
                                                                <i class="fas fa-check-circle"></i> Validate
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-check-circle fa-3x"></i>
                                    <p class="mt-3">No reports pending validation</p>
                                    <small class="text-muted">New reports will appear here for SMS risk determination</small>
                                </div>
                            }
                        </div>

                        <!-- Risk Assessment Tab -->
                        <div class="tab-pane fade" id="riskassessment" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5>Risk Assessment</h5>
                                <div class="alert alert-warning small mb-0 py-2">
                                    <i class="fas fa-exclamation-triangle"></i> High/Critical risks automatically trigger Technical Risk Assessment (TRA)
                                </div>
                            </div>
                            
                            @if (Model.PendingRiskAssessment.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Report ID</th>
                                                <th>Hazard ID</th>
                                                <th>Type</th>
                                                <th>Priority</th>
                                                <th>Assigned To</th>
                                                <th>Days in Stage</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var report in Model.PendingRiskAssessment)
                                            {
                                                <tr>
                                                    <td><strong>@report.ReportId</strong></td>
                                                    <td><strong>@report.HazardId</strong></td>
                                                    <td>@report.HazardType</td>
                                                    <td>
                                                        <span class="badge @(report.Priority == "High" ? "bg-danger" : report.Priority == "Medium" ? "bg-warning" : "bg-info")">
                                                            @report.Priority
                                                        </span>
                                                    </td>
                                                    <td>@report.AssignedTo</td>
                                                    <td>
                                                        <span class="badge @(report.DaysInStage > 3 ? "bg-danger" : report.DaysInStage > 1 ? "bg-warning" : "bg-secondary")">
                                                            @report.DaysInStage days
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            @if (!string.IsNullOrEmpty(report.HazardId))
                                                            {
                                                                <a href="/SafetyRiskManagement/RiskAssessmentWizard?hazardId=@report.HazardId" class="btn btn-primary">
                                                                    <i class="fas fa-calculator"></i> Start Assessment
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">Awaiting hazard creation</span>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-chart-line fa-3x"></i>
                                    <p class="mt-3">No reports pending risk assessment</p>
                                    <small class="text-muted">Validated SMS risks will appear here</small>
                                </div>
                            }
                        </div>

                        <!-- Investigation Tab -->
                        <div class="tab-pane fade" id="investigation" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5>Investigation Required</h5>
                                <div class="alert alert-info small mb-0 py-2">
                                    <i class="fas fa-search-plus"></i> Additional information needed before SMS risk assessment can proceed
                                </div>
                            </div>
                            
                            @if (Model.PendingInvestigation.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Report ID</th>
                                                <th>Hazard ID</th>
                                                <th>Type</th>
                                                <th>Location</th>
                                                <th>Priority</th>
                                                <th>Reported Date</th>
                                                <th>Days Pending</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var report in Model.PendingInvestigation)
                                            {
                                                <tr>
                                                    <td><strong>@report.ReportId</strong></td>
                                                    <td><strong>@report.HazardId</strong></td>
                                                    <td>@report.HazardType</td>
                                                    <td>@report.Location</td>
                                                    <td>
                                                        <span class="badge @(report.Priority == "High" ? "bg-danger" : report.Priority == "Medium" ? "bg-warning" : "bg-info")">
                                                            @report.Priority
                                                        </span>
                                                    </td>
                                                    <td>@report.ReportedDate.ToString("MM/dd/yyyy")</td>
                                                    <td>
                                                        <span class="badge @(report.DaysInStage > 5 ? "bg-danger" : report.DaysInStage > 2 ? "bg-warning" : "bg-secondary")">
                                                            @report.DaysInStage days
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <a href="/SafetyRiskManagement/HazardInvestigation?reportId=@report.ReportId" class="btn btn-primary">
                                                                <i class="fas fa-search-plus"></i> Investigate
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-search-plus fa-3x"></i>
                                    <p class="mt-3">No reports requiring investigation</p>
                                    <small class="text-muted">Reports needing more information will appear here</small>
                                </div>
                            }
                        </div>

                        <!-- TRA Tab -->
                        <div class="tab-pane fade" id="tra" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5>Technical Risk Assessment (TRA)</h5>
                                <div class="alert alert-danger small mb-0 py-2">
                                    <i class="fas fa-microscope"></i> Formal TRA required for High/Critical risk reports
                                </div>
                            </div>
                            
                            @if (Model.PendingTRA.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Report ID</th>
                                                <th>Hazard ID</th>
                                                <th>Type</th>
                                                <th>Risk Score</th>
                                                <th>Assigned To</th>
                                                <th>Days in Stage</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var report in Model.PendingTRA)
                                            {
                                                <tr>
                                                    <td><strong>@report.ReportId</strong></td>
                                                    <td><strong>@report.HazardId</strong></td>
                                                    <td>@report.HazardType</td>
                                                    <td>
                                                        <span class="badge bg-danger">@report.RiskScore</span>
                                                    </td>
                                                    <td>@report.AssignedTo</td>
                                                    <td>
                                                        <span class="badge @(report.DaysInStage > 5 ? "bg-danger" : report.DaysInStage > 3 ? "bg-warning" : "bg-secondary")">
                                                            @report.DaysInStage days
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <button type="button" class="btn btn-primary">
                                                                <i class="fas fa-microscope"></i> Conduct TRA
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-microscope fa-3x"></i>
                                    <p class="mt-3">No reports requiring TRA</p>
                                    <small class="text-muted">High/Critical risk assessments will appear here</small>
                                </div>
                            }
                        </div>

                        <!-- Leadership Approval Tab -->
                        <div class="tab-pane fade" id="leadership" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5>SMS Leadership Approval</h5>
                                <div class="alert alert-info small mb-0 py-2">
                                    <i class="fas fa-user-tie"></i> SMS Leadership approval required before mitigation implementation
                                </div>
                            </div>
                            
                            @if (Model.PendingLeadershipApproval.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Report ID</th>
                                                <th>Hazard ID</th>
                                                <th>Type</th>
                                                <th>Risk Score</th>
                                                <th>Days Pending</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var report in Model.PendingLeadershipApproval)
                                            {
                                                <tr>
                                                    <td><strong>@report.ReportId</strong></td>
                                                    <td><strong>@report.HazardId</strong></td>
                                                    <td>@report.HazardType</td>
                                                    <td>
                                                        <span class="badge @(report.RiskScore == "Critical" ? "bg-danger" : "bg-warning")">@report.RiskScore</span>
                                                    </td>
                                                    <td>
                                                        <span class="badge @(report.DaysInStage > 3 ? "bg-danger" : "bg-secondary")">
                                                            @report.DaysInStage days
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <button type="button" class="btn btn-success">
                                                                <i class="fas fa-check"></i> Approve
                                                            </button>
                                                            <button type="button" class="btn btn-danger">
                                                                <i class="fas fa-times"></i> Reject
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-user-tie fa-3x"></i>
                                    <p class="mt-3">No reports pending leadership approval</p>
                                    <small class="text-muted">TRA results will appear here</small>
                                </div>
                            }
                        </div>

                        <!-- Mitigation Tab -->
                        <div class="tab-pane fade" id="mitigation" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5>Mitigation Implementation</h5>
                                <div class="alert alert-success small mb-0 py-2">
                                    <i class="fas fa-tools"></i> Track mitigation implementation and effectiveness
                                </div>
                            </div>
                            
                            @if (Model.InMitigation.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Report ID</th>
                                                <th>Hazard ID</th>
                                                <th>Type</th>
                                                <th>Risk Level</th>
                                                <th>Status</th>
                                                <th>Responsible Party</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var report in Model.InMitigation)
                                            {
                                                <tr>
                                                    <td><strong>@report.ReportId</strong></td>
                                                    <td><strong>@report.HazardId</strong></td>
                                                    <td>@report.HazardType</td>
                                                    <td>
                                                        @if (report.RiskScore != null)
                                                        {
                                                            <span class="badge @(report.RiskScore == "Critical" ? "bg-danger" : report.RiskScore == "High" ? "bg-warning" : report.RiskScore == "Medium" ? "bg-info" : "bg-success")">
                                                                @report.RiskScore
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">TBD</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-primary">@report.ProcessStage</span>
                                                        <br>
                                                        <small class="text-muted">@report.DaysInStage days</small>
                                                    </td>
                                                    <td>@report.AssignedTo</td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <button type="button" class="btn btn-primary">
                                                                <i class="fas fa-chart-line"></i> Track
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-tools fa-3x"></i>
                                    <p class="mt-3">No reports in mitigation phase</p>
                                    <small class="text-muted">Approved risk assessments will appear here</small>
                                </div>
                            }
                        </div>

                        <!-- Closed Tab -->
                        <div class="tab-pane fade" id="closed" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5>Closed & Referred Reports</h5>
                                <button type="button" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-download"></i> Export Reports
                                </button>
                            </div>
                            
                            @if (Model.ClosedReferred.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Report ID</th>
                                                <th>Hazard ID</th>
                                                <th>Type</th>
                                                <th>Status</th>
                                                <th>Closed Date</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var report in Model.ClosedReferred.Take(20))
                                            {
                                                <tr>
                                                    <td><strong>@report.ReportId</strong></td>
                                                    <td><strong>@report.HazardId</strong></td>
                                                    <td>@report.HazardType</td>
                                                    <td>
                                                        <span class="badge bg-secondary">@report.EffectiveStatus</span>
                                                    </td>
                                                    <td>@report.ReportedDate.ToString("MM/dd/yyyy")</td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <button type="button" class="btn btn-outline-secondary">
                                                                <i class="fas fa-eye"></i> View
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                
                                @if (Model.ClosedReferred.Count > 20)
                                {
                                    <div class="text-center mt-3">
                                        <small class="text-muted">Showing recent 20 of @Model.ClosedReferred.Count closed reports</small>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-archive fa-3x"></i>
                                    <p class="mt-3">No recently closed reports</p>
                                    <small class="text-muted">Completed reports will appear here</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Report Processing page loaded');
            
            // Check URL hash for active tab
            const hash = window.location.hash;
            if (hash) {
                const targetTab = document.querySelector(`a[href="${hash}"]`);
                if (targetTab) {
                    targetTab.click();
                }
            }
        });
    </script>
}

