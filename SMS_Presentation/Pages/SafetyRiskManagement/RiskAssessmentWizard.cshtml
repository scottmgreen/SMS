@page "/SafetyRiskManagement/RiskAssessmentWizard/{id}/step/{stepNumber:int?}"
@model PDXSMS_Presentation.Pages.SafetyRiskManagement.RiskAssessmentWizardModel
@{
    ViewData["Title"] = $"Risk Assessment Wizard - Step {Model.CurrentStep}";
}

<div class="container-fluid">
    <!-- Header with Progress -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyRiskManagement">Safety Risk Management</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyRiskManagement/RiskAssessment">Risk Assessment</a></li>
                    <li class="breadcrumb-item active">Assessment Wizard</li>
                </ol>
            </nav>
            
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="card-title">
                                <i class="fas fa-clipboard-check"></i> 
                                @Model.AssessmentName
                            </h4>
                            <p class="card-text mb-0">
                                Assessment ID: @Model.AssessmentId | 
                                Lead Assessor: @Model.LeadAssessor
                            </p>
                        </div>
                        @* <div class="col-md-4 text-end">
                            <h3 class="mb-1">Step @Model.CurrentStep of 5</h3>
                            <div class="progress bg-light">
                                <div class="progress-bar bg-warning" style="width: @Model.ProgressPercentage%">
                                    @Model.ProgressPercentage%
                                </div>
                            </div>
                            <small class="text-light">@Model.CurrentStepName</small>
                        </div> *@
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Step Navigation -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row text-center">
                        @for (int i = 1; i <= 5; i++)
                        {
                            var stepClass = i == Model.CurrentStep ? "btn-primary" : 
                                           i < Model.CurrentStep ? "btn-success" : "btn-outline-secondary";
                            var iconClass = i < Model.CurrentStep ? "fa-check-circle" : 
                                           i == Model.CurrentStep ? "fa-edit" : "fa-circle";
                            var isDisabled = i > Model.CurrentStep && !Model.CanSkipToStep(i);
                            
                            <div class="col">
                                <form method="post" style="display: inline;">
                                    <input type="hidden" asp-for="Id" />
                                    <input type="hidden" asp-for="StepNumber" />
                                    @if (isDisabled)
                                    {
                                        <button type="button" class="btn @stepClass btn-sm w-100" disabled>
                                            <i class="fas @iconClass"></i><br>
                                            <small>Step @i</small><br>
                                            <small>@Model.GetStepName(i)</small>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn @stepClass btn-sm w-100" 
                                                formaction="?handler=NavigateToStep" 
                                                name="targetStep" value="@i" 
                                                formnovalidate>
                                            <i class="fas @iconClass"></i><br>
                                            <small>Step @i</small><br>
                                            <small>@Model.GetStepName(i)</small>
                                        </button>
                                    }
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Resume Information (if applicable) -->
    @if (Model.GetLastCompletedStep() > 0)
    {
        @* <div class="row mb-3">
            <div class="col-12">
                <div class="alert alert-primary border-primary">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h6 class="mb-1">
                                <i class="fas fa-history"></i> Assessment Progress Restored
                            </h6>
                            <p class="mb-0">
                                <strong>Last completed:</strong> Step @Model.GetLastCompletedStep() of 5 |
                                <strong>Recommended next:</strong> Step @Model.GetRecommendedStep() |
                                <strong>Hazards identified:</strong> @Model.IdentifiedHazardsCount
                            </p>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="btn-group">
                                <a href="/SafetyRiskManagement/RiskAssessmentWizard/@Model.Id/step/@Model.GetRecommendedStep()" 
                                   class="btn btn-primary btn-sm">
                                    <i class="fas fa-fast-forward"></i> Go to Next Step
                                </a>
                                <a href="/SafetyRiskManagement/RiskAssessmentWizard/@Model.Id/step/1" 
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-step-backward"></i> Review from Start
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div> *@
    }

    <!-- Step Content -->
    <div class="row">
        <div class="col-lg-9">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="fas @Model.GetStepIcon(Model.CurrentStep)"></i> 
                        Step @Model.CurrentStep: @Model.CurrentStepName
                    </h4>
                    @* <p class="mb-0 mt-1">@Model.GetStepDescription()</p> *@
                </div>
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        
                        <!-- Hidden fields to preserve route parameters -->
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="StepNumber" />
                        
                        @if (Model.CurrentStep == 1)
                        {
                            @await Html.PartialAsync("_Step1_DescribeSystem", Model)
                        }
                        else if (Model.CurrentStep == 2)
                        {
                            @await Html.PartialAsync("_Step2_IdentifyHazards", Model)
                        }
                        else if (Model.CurrentStep == 3)
                        {
                            @await Html.PartialAsync("_Step3_AnalyzeRisk", Model)
                        }
                        else if (Model.CurrentStep == 4)
                        {
                            @await Html.PartialAsync("_Step4_AssessRisk", Model)
                        }
                        else if (Model.CurrentStep == 5)
                        {
                            @await Html.PartialAsync("_Step5_MitigateRisk", Model)
                        }

                        <!-- Navigation Buttons -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <hr>
                                
                                <div class="d-flex justify-content-between">
                                    <div>
                                        @if (Model.CurrentStep > 1)
                                        {
                                            <button type="submit" class="btn btn-outline-secondary" 
                                                    formaction="?handler=PreviousStep" formnovalidate>
                                                <i class="fas fa-arrow-left"></i> Previous Step
                                            </button>
                                        }
                                        <a href="/SafetyRiskManagement/RiskAssessment" 
                                           class="btn btn-outline-primary">
                                            <i class="fas fa-list"></i> Back to Assessment List
                                        </a>
                                    </div>
                                    <div>
                                        @* <button type="button" class="btn btn-outline-info" 
                                                onclick="manualSaveCurrentStep()">
                                            <i class="fas fa-save"></i> Save Progress
                                        </button> *@
                                        @if (Model.CurrentStep < 5)
                                        {
                                            <button type="button" class="btn btn-primary"
                                                    onclick="saveAndNavigateNext()">
                                                <i class="fas fa-arrow-right"></i> Next Step
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-success" 
                                                    formaction="?handler=CompleteAssessment">
                                                <i class="fas fa-check-circle"></i> Complete Assessment
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Help Panel -->
        <div class="col-lg-3">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5><i class="fas fa-question-circle"></i> Step @Model.CurrentStep Guidance</h5>
                </div>
                <div class="card-body">
                    @if (Model.CurrentStep == 1)
                    {
                        <h6>System Description Requirements:</h6>
                        <ul class="small">
                            <li>Define system boundaries clearly</li>
                            <li>Document system purpose and objectives</li>
                            <li>Complete 5M framework analysis</li>
                            <li>Identify key stakeholder groups</li>
                            <li>Consider operational context</li>
                        </ul>
                        
                        <button type="button" class="btn btn-primary btn-md" data-bs-toggle="modal" data-bs-target="#fiveMGuidanceModal">
                            <i class="fas fa-question-circle"></i>&nbsp; 5M Framework Guidance
                        </button>
                        
                        <!-- 5M Framework Guidance Modal -->
                        <div class="modal fade" id="fiveMGuidanceModal" tabindex="-1" aria-labelledby="fiveMGuidanceModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-xl">
                                <div class="modal-content">
                                    <div class="modal-header bg-primary text-white">
                                        <h5 class="modal-title" id="fiveMGuidanceModalLabel">
                                            <i class="fas fa-project-diagram"></i> 5M Framework Guide &nbsp;
                                        </h5>
                                        <br />
                                        <small>Use this systematic approach to analyze all critical elements of your system.<br /> </small>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row mb-4">
                                            <div class="col-12">
                                                <div class="alert alert-primary">
                                                    <i class="fas fa-info-circle"></i>
                                                    <strong>5M Framework Purpose:</strong> Use this systematic approach to analyze all critical elements of your system. The 5M methodology ensures comprehensive hazard identification by examining Man (people), Machine (equipment), Method (procedures), Material (resources), and Milieu (environment).
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- 5M Framework Table -->
                                        <div class="table-responsive">
                                            <table class="table table-bordered">
                                                <thead class="table-primary">
                                                    <tr>
                                                        <th width="20%" class="text-center text-primary">
                                                            <i class="fas fa-users fa-lg"></i><br>
                                                            <strong>Man</strong><br>
                                                            <small>(People)</small>
                                                        </th>
                                                        <th width="20%" class="text-center text-success">
                                                            <i class="fas fa-cogs fa-lg"></i><br>
                                                            <strong>Machine</strong><br>
                                                            <small>(Equipment)</small>
                                                        </th>
                                                        <th width="20%" class="text-center text-info">
                                                            <i class="fas fa-clipboard-list fa-lg"></i><br>
                                                            <strong>Method</strong><br>
                                                            <small>(Procedures)</small>
                                                        </th>
                                                        <th width="20%" class="text-center text-warning">
                                                            <i class="fas fa-boxes fa-lg"></i><br>
                                                            <strong>Material</strong><br>
                                                            <small>(Resources)</small>
                                                        </th>
                                                        <th width="20%" class="text-center text-danger">
                                                            <i class="fas fa-globe fa-lg"></i><br>
                                                            <strong>Milieu</strong><br>
                                                            <small>(Environment)</small>
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr class="table-light">
                                                        <td>
                                                            <strong class="text-primary">Key Elements:</strong>
                                                            <ul class="mb-2 small">
                                                                <li>Roles and responsibilities</li>
                                                                <li>Training and competency</li>
                                                                <li>Workload and fatigue factors</li>
                                                                <li>Communication requirements</li>
                                                                <li>Human error potential</li>
                                                                <li>Crew coordination</li>
                                                            </ul>
                                                        </td>
                                                        <td>
                                                            <strong class="text-success">Key Elements:</strong>
                                                            <ul class="mb-2 small">
                                                                <li>Critical equipment and systems</li>
                                                                <li>Backup and redundancy</li>
                                                                <li>Maintenance requirements</li>
                                                                <li>Technology dependencies</li>
                                                                <li>Equipment failure modes</li>
                                                                <li>Performance specifications</li>
                                                            </ul>
                                                        </td>
                                                        <td>
                                                            <strong class="text-info">Key Elements:</strong>
                                                            <ul class="mb-2 small">
                                                                <li>Standard operating procedures</li>
                                                                <li>Emergency procedures</li>
                                                                <li>Regulatory compliance</li>
                                                                <li>Process interfaces</li>
                                                                <li>Procedure adequacy</li>
                                                                <li>Change management</li>
                                                            </ul>
                                                        </td>
                                                        <td>
                                                            <strong class="text-warning">Key Elements:</strong>
                                                            <ul class="mb-2 small">
                                                                <li>Critical materials and supplies</li>
                                                                <li>Resource availability</li>
                                                                <li>Quality specifications</li>
                                                                <li>Supply chain dependencies</li>
                                                                <li>Material handling</li>
                                                                <li>Storage requirements</li>
                                                            </ul>
                                                        </td>
                                                        <td>
                                                            <strong class="text-danger">Key Elements:</strong>
                                                            <ul class="mb-2 small">
                                                                <li>Weather and environmental conditions</li>
                                                                <li>Operational pressures and constraints</li>
                                                                <li>Regulatory and policy environment</li>
                                                                <li>Organizational culture and climate</li>
                                                                <li>External influences and dependencies</li>
                                                                <li>Time pressures and schedules</li>
                                                            </ul>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td class="bg-light">
                                                            <strong class="text-primary">Analysis Questions:</strong>
                                                            <div class="small">
                                                                <div class="alert alert-primary p-2 mb-2">
                                                                    <strong>Who</strong> operates the system? What are their qualifications? How do they coordinate and communicate?
                                                                </div>
                                                                <strong>Consider:</strong>
                                                                <ul class="small mb-0">
                                                                    <li>Staffing levels and shifts</li>
                                                                    <li>Experience and training gaps</li>
                                                                    <li>Decision-making authority</li>
                                                                    <li>Stress and workload factors</li>
                                                                </ul>
                                                            </div>
                                                        </td>
                                                        <td class="bg-light">
                                                            <strong class="text-success">Analysis Questions:</strong>
                                                            <div class="small">
                                                                <div class="alert alert-success p-2 mb-2">
                                                                    <strong>What</strong> could break? What happens if it fails? How is it maintained and monitored?
                                                                </div>
                                                                <strong>Consider:</strong>
                                                                <ul class="small mb-0">
                                                                    <li>Single points of failure</li>
                                                                    <li>Age and condition</li>
                                                                    <li>Maintenance schedules</li>
                                                                    <li>Performance monitoring</li>
                                                                </ul>
                                                            </div>
                                                        </td>
                                                        <td class="bg-light">
                                                            <strong class="text-info">Analysis Questions:</strong>
                                                            <div class="small">
                                                                <div class="alert alert-info p-2 mb-2">
                                                                    <strong>How</strong> are procedures followed? Are they clear? What happens in emergencies or unusual situations?
                                                                </div>
                                                                <strong>Consider:</strong>
                                                                <ul class="small mb-0">
                                                                    <li>Procedure clarity and currency</li>
                                                                    <li>Training on procedures</li>
                                                                    <li>Deviation handling</li>
                                                                    <li>Interface between procedures</li>
                                                                </ul>
                                                            </div>
                                                        </td>
                                                        <td class="bg-light">
                                                            <strong class="text-warning">Analysis Questions:</strong>
                                                            <div class="small">
                                                                <div class="alert alert-warning p-2 mb-2">
                                                                    <strong>What</strong> materials are critical? What if supplies run out? Any quality or contamination issues?
                                                                </div>
                                                                <strong>Consider:</strong>
                                                                <ul class="small mb-0">
                                                                    <li>Critical material availability</li>
                                                                    <li>Supplier reliability</li>
                                                                    <li>Quality control processes</li>
                                                                    <li>Storage and handling</li>
                                                                </ul>
                                                            </div>
                                                        </td>
                                                        <td class="bg-light">
                                                            <strong class="text-danger">Analysis Questions:</strong>
                                                            <div class="small">
                                                                <div class="alert alert-danger p-2 mb-2">
                                                                    <strong>How</strong> do conditions affect operations? What external pressures and constraints exist?
                                                                </div>
                                                                <strong>Consider:</strong>
                                                                <ul class="small mb-0">
                                                                    <li>Weather impact on operations</li>
                                                                    <li>Regulatory changes</li>
                                                                    <li>Organizational pressures</li>
                                                                    <li>Economic constraints</li>
                                                                </ul>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        
                                        <div class="row mt-4">
                                            <div class="col-12">
                                                <div class="card border-success">
                                                    <div class="card-header bg-success text-white">
                                                        <h6 class="mb-0"><i class="fas fa-lightbulb"></i> Analysis Best Practices</h6>
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                <strong>Analysis Tips:</strong>
                                                                <ul class="small mb-0">
                                                                    <li>Be specific and detailed in your analysis</li>
                                                                    <li>Consider both normal and abnormal conditions</li>
                                                                    <li>Think about interactions between the 5M elements</li>
                                                                    <li>Include both current and planned system elements</li>
                                                                </ul>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <strong>Quality Indicators:</strong>
                                                                <ul class="small mb-0">
                                                                    <li>Each section should be at least 10 characters</li>
                                                                    <li>Include specific examples and scenarios</li>
                                                                    <li>Address both routine and exceptional conditions</li>
                                                                    <li>Consider system interfaces and dependencies</li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                            <i class="fas fa-times"></i> Close Guide
                                        </button>
                                        @* <button type="button" class="btn btn-primary" data-bs-dismiss="modal" onclick="focusOnSystemDescription()">
                                            <i class="fas fa-play"></i> Start System Analysis
                                        </button> *@
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (Model.CurrentStep == 2)
                    {
                        <h6>Hazard Identification Tips:</h6>
                        <ul class="small">
                            <li>Review historical incidents</li>
                            <li>Analyze operational data</li>
                            <li>Conduct stakeholder interviews</li>
                            <li>Perform system walkthroughs</li>
                            <li>Use hazard taxonomies</li>
                        </ul>
                    }
                    else if (Model.CurrentStep == 3)
                    {
                        <h6>Risk Analysis Methods:</h6>
                        <ul class="small">
                            <li>Risk Analysis Notes & Assumptions: Record key assumptions and criteria used in this risk analysis</li>
                            <li>Severity determination</li>
                            <li>Existing controls review</li>
                            <li>Risk matrix positioning</li>
                            <li>What-if scenarios</li>
                        </ul>
                        
                    }
                    else if (Model.CurrentStep == 4)
                    {
                        <h6>Risk Assessment Criteria:</h6>
                        <ul class="small">
                            <li>Tolerability thresholds</li>
                            <li>ALARP principles</li>
                            <li>Regulatory requirements</li>
                            <li>Industry standards</li>
                            <li>Organizational policies</li>
                        </ul>
                        <button type="button" class="btn btn-primary btn-md" data-bs-toggle="modal" data-bs-target="#riskMatrixGuidanceModal">
                            <i class="fas fa-question-circle"></i>&nbsp; 5x5 Risk Matrix Guidance
                        </button>
                        <!-- SMS Risk Matrix Reference Modal -->
                        <div class="modal fade" id="riskMatrixGuidanceModal" tabindex="-1" aria-labelledby="riskMatrixGuidanceModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-xl">
                                <div class="modal-content">
                                    <div class="modal-header bg-info text-white">
                                        <h5 class="modal-title" id="riskMatrixGuidanceModalLabel">
                                            <i class="fas fa-table"></i> SMS Risk Matrix (5x5) Reference Guide
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row mb-4">
                                            <div class="col-12">
                                                <div class="alert alert-info">
                                                    <i class="fas fa-info-circle"></i>
                                                    <strong>Risk Matrix Usage:</strong> Use this 5x5 matrix to assess each identified hazard by combining severity (impact) and likelihood (probability) to determine the overall risk level. The resulting risk level helps determine tolerability using ALARP principles.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="table-responsive">
                                            <table class="table table-bordered text-center risk-matrix">
                                                <thead>
                                                    <tr>
                                                        <th rowspan="2" class="align-middle">Severity ?<br>? Likelihood</th>
                                                        <th class="bg-light">1<br>Minor</th>
                                                        <th class="bg-light">2<br>Moderate</th>
                                                        <th class="bg-light">3<br>Serious</th>
                                                        <th class="bg-light">4<br>Major</th>
                                                        <th class="bg-light">5<br>Catastrophic</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <th class="bg-light">A - Rare</th>
                                                        <td class="bg-success text-white">1A<br>Very Low</td>
                                                        <td class="bg-success text-white">2A<br>Very Low</td>
                                                        <td class="bg-success text-white">3A<br>Very Low</td>
                                                        <td class="bg-success text-white">4A<br>Very Low</td>
                                                        <td class="bg-warning text-dark">5A<br>Low</td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">B - Unlikely</th>
                                                        <td class="bg-success text-white">1B<br>Very Low</td>
                                                        <td class="bg-success text-white">2B<br>Very Low</td>
                                                        <td class="bg-warning text-dark">3B<br>Low</td>
                                                        <td class="bg-warning text-dark">4B<br>Low</td>
                                                        <td class="bg-info text-white">5B<br>Medium</td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">B - Possible</th>
                                                        <td class="bg-success text-white">1C<br>Very Low</td>
                                                        <td class="bg-warning text-dark">2C<br>Low</td>
                                                        <td class="bg-warning text-dark">3C<br>Low</td>
                                                        <td class="bg-info text-white">4C<br>Medium</td>
                                                        <td class="bg-danger text-white">5C<br>High</td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">D - Likely</th>
                                                        <td class="bg-success text-white">1D<br>Very Low</td>
                                                        <td class="bg-warning text-dark">2D<br>Low</td>
                                                        <td class="bg-info text-white">3D<br>Medium</td>
                                                        <td class="bg-danger text-white">4D<br>High</td>
                                                        <td class="bg-danger text-white">5D<br>High</td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">E - Frequent</th>
                                                        <td class="bg-warning text-dark">1E<br>Low</td>
                                                        <td class="bg-info text-white">2E<br>Medium</td>
                                                        <td class="bg-danger text-white">3E<br>High</td>
                                                        <td class="bg-danger text-white">4E<br>High</td>
                                                        <td class="bg-dark text-white">5E<br>Very High</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="row mt-4">
                                            <div class="col-md-7">
                                                <div class="card border-primary">
                                                    <div class="card-header bg-primary text-white">
                                                        <h6 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Severity Levels</h6>
                                                    </div>
                                                    <div class="card-body">
                                                        <ul class="mb-0">
                                                            <li><strong>1 - Minor:</strong> First aid only, minor delays, minimal impact</li>
                                                            <li><strong>2 - Moderate:</strong> Medical treatment required, localized disruption</li>
                                                            <li><strong>3 - Serious:</strong> Hospitalization required, temporary closures</li>
                                                            <li><strong>4 - Major:</strong> Permanent injury, extended closures, significant damage</li>
                                                            <li><strong>5 - Catastrophic:</strong> Fatalities, major infrastructure damage, long-term impact</li>
                                                        </ul>
