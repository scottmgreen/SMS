@section Scripts {
    <script>
        // MINIMIZED JavaScript - All navigation logic now handled by C# server-side
        document.addEventListener('DOMContentLoaded', function() {
            console.log('✅ C# handler system initialized - minimal JavaScript');
            
            const assessmentId = '@Model.Id';
            const stepNumber = @Model.StepNumber;
            console.log(`📋 Assessment: ${assessmentId}, Step: ${stepNumber}`);
        });

        // Simplified legacy support for any remaining onclick handlers
        function saveAndNavigateNext() {
            // Find the Save & Next button and trigger form submission to C# handler
            const form = document.querySelector('form[method="post"]');
            if (form) {
                form.action = '?handler=SaveAndNavigateNext';
                form.submit();
            }
        }

        function manualSaveCurrentStep() {
            // Find the Save Progress button and trigger form submission to C# handler
            const form = document.querySelector('form[method="post"]');
            if (form) {
                form.action = '?handler=ManualSaveCurrentStep';
                form.submit();
            }
        }

        console.log('✅ Simplified client-side system - server-side C# handlers manage all logic');
    </script>
}

