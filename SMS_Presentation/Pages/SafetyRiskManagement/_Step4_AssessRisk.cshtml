/**
 * Calculate score when severity or likelihood changes
 */
function calculateScore(rowId) {
    console.log('?? Calculating score for row: ' + rowId);
    
    const row = document.getElementById(rowId);
    if (!row) {
        console.error('? Row not found: ' + rowId);
        return;
    }
    
    const severitySelect = row.querySelector('.severity-select');
    const likelihoodSelect = row.querySelector('.likelihood-select');
    const scoreDisplay = row.querySelector('.score-display');
    const submitButton = row.querySelector('.submit-btn');
    
    if (!severitySelect || !likelihoodSelect || !scoreDisplay || !submitButton) {
        console.error('? Missing elements in row: ' + rowId);
        return;
    }
    
    const severity = parseInt(severitySelect.value);
    const likelihood = parseInt(likelihoodSelect.value);
    
    if (severity && likelihood) {
        const calculatedScore = severity * likelihood;
        
        // Update the score display
        scoreDisplay.textContent = calculatedScore.toFixed(1);
        scoreDisplay.className = 'score-display badge bg-primary fs-6 p-2';
        
        // Enable the submit button
        submitButton.disabled = false;
        
        console.log('? Calculated score: ' + severity + ' × ' + likelihood + ' = ' + calculatedScore);
    } else {
        // Reset display if incomplete
        scoreDisplay.textContent = '-';
        scoreDisplay.className = 'score-display badge bg-secondary fs-6 p-2';
        submitButton.disabled = true;
        
        console.log('? Waiting for both severity and likelihood selections');
    }
}

/**
 * Submit individual panel member score
 */
async function submitScore(memberId, hazardId) {
    console.log('?? Submitting score for member ' + memberId + ' on hazard ' + hazardId);
    
    const rowId = 'scoring-row-' + hazardId + '-' + memberId;
    const row = document.getElementById(rowId);
    
    if (!row) {
        console.error('? Row not found: ' + rowId);
        alert('Error: Could not find scoring row. Please refresh the page.');
        return;
    }
    
    const severitySelect = row.querySelector('.severity-select');
    const likelihoodSelect = row.querySelector('.likelihood-select');
    const submitBtn = row.querySelector('.submit-btn');
    
    if (!severitySelect || !likelihoodSelect || !submitBtn) {
        console.error('? Missing form elements');
        alert('Error: Missing form elements. Please refresh the page.');
        return;
    }
    
    const severity = parseInt(severitySelect.value);
    const likelihood = parseInt(likelihoodSelect.value);
    
    if (!severity || !likelihood) {
        alert('Please select both severity and likelihood before submitting.');
        return;
    }
    
    const score = severity * likelihood;
    
    try {
        // Show loading state
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';
        
        console.log('?? Submitting score: Severity=' + severity + ', Likelihood=' + likelihood + ', Score=' + score);
        
        // Get form data
        const assessmentIdField = document.querySelector('input[name="Id"]');
        const tokenField = document.querySelector('input[name="__RequestVerificationToken"]');
        
        if (!assessmentIdField || !tokenField) {
            throw new Error('Missing form fields');
        }
        
        // Create form data for submission
        const formData = new FormData();
        formData.append('hazardId', hazardId);
        formData.append('memberId', memberId);
        formData.append('severityScore', severity.toString());
        formData.append('likelihoodScore', likelihood.toString());
        formData.append('Id', assessmentIdField.value);
        formData.append('StepNumber', '4');
        formData.append('__RequestVerificationToken', tokenField.value);
        
        console.log('?? Submitting score data for ' + hazardId + '/' + memberId);
        
        // Submit to server
        const response = await fetch(window.location.pathname + '?handler=SubmitScore', {
            method: 'POST',
            body: formData
        });
        
        if (response.ok) {
            const result = await response.json();
            console.log('? Score submission response:', result);
            
            if (result.success) {
                console.log('? Score submitted for ' + hazardId + ': ' + score);
                
                // Refresh page after a short delay to show updated data
                setTimeout(function() {
                    window.location.reload();
                }, 2000);
            } else {
                console.error('? Failed to submit score: ' + (result.message || 'Unknown error'));
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
                alert('Failed to submit score: ' + (result.message || 'Unknown error'));
            }
        } else {
            throw new Error('Server responded with ' + response.status + ': ' + response.statusText);
        }
        
    } catch (error) {
        console.error('?? Error submitting score:', error);
        alert('Error submitting score. Please try again.');
        
        // Restore button
        const submitBtn = row.querySelector('.submit-btn');
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-save"></i> Submit Score';
        }
    }
}

/**
 * Edit existing score (convert back to dropdowns)
 */
function editScore(memberId, hazardId, currentSeverity, currentLikelihood) {
    console.log('?? Editing score for member ' + memberId + ' on hazard ' + hazardId);
    
    const rowId = 'scoring-row-' + hazardId + '-' + memberId;
    const row = document.getElementById(rowId);
    
    if (!row) {
        console.error('? Row not found: ' + rowId);
        return;
    }
    
    // Convert back to editing mode
    row.classList.remove('table-success');
    row.classList.add('table-light');
    
    // Restore dropdown controls
    const severityCell = row.children[1];
    severityCell.innerHTML = 
        '<select class="form-select severity-select" name="severityScore" onchange="calculateScore(\'' + rowId + '\')" required>' +
        '<option value="">Select Severity...</option>' +
