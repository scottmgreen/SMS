        '<option value="2"' + (currentSeverity === 2 ? ' selected' : '') + '>2 - Moderate Impact</option>' +
        '<option value="3"' + (currentSeverity === 3 ? ' selected' : '') + '>3 - Serious Impact</option>' +
        '<option value="4"' + (currentSeverity === 4 ? ' selected' : '') + '>4 - Major Impact</option>' +
        '<option value="5"' + (currentSeverity === 5 ? ' selected' : '') + '>5 - Catastrophic Impact</option>' +
        '</select>' +
        '<small class="text-muted">Choose impact level</small>';
    
    const likelihoodCell = row.children[2];
    likelihoodCell.innerHTML = 
        '<select class="form-select likelihood-select" name="likelihoodScore" onchange="calculateScore(\'' + rowId + '\')" required>' +
        '<option value="">Select Likelihood...</option>' +
        '<option value="1"' + (currentLikelihood === 1 ? ' selected' : '') + '>1 - Rare (A)</option>' +
        '<option value="2"' + (currentLikelihood === 2 ? ' selected' : '') + '>2 - Unlikely (B)</option>' +
        '<option value="3"' + (currentLikelihood === 3 ? ' selected' : '') + '>3 - Possible (C)</option>' +
        '<option value="4"' + (currentLikelihood === 4 ? ' selected' : '') + '>4 - Likely (D)</option>' +
        '<option value="5"' + (currentLikelihood === 5 ? ' selected' : '') + '>5 - Frequent (E)</option>' +
        '</select>' +
        '<small class="text-muted">Choose probability</small>';
    
    const scoreCell = row.children[3];
    scoreCell.innerHTML = 
        '<div class="score-display badge bg-primary fs-6 p-2">' + (currentSeverity * currentLikelihood).toFixed(1) + '</div>' +
        '<br><small class="text-muted">Auto-calculated</small>';
    
    const actionCell = row.children[4];
    actionCell.innerHTML = 
        '<button type="button" class="btn btn-success btn-sm submit-btn" onclick="submitScore(\'' + memberId + '\', \'' + hazardId + '\')">' +
        '<i class="fas fa-save"></i> Submit Score' +
        '</button>';
    
    // Update user info badge
    const userInfoCell = row.children[0];
    const badge = userInfoCell.querySelector('.badge');
    if (badge) {
        badge.className = 'badge bg-warning mt-1';
        badge.innerHTML = '<i class="fas fa-clock"></i> Pending Score';
    }
}
