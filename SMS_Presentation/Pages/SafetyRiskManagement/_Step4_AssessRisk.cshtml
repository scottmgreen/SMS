/**
 * Update scoring panel on server (actual server call)
 */
async function updateScoringPanelOnServer(hazardId, selectedUsers) {
    console.log('?? STARTING updateScoringPanelOnServer');
    console.log('?? Input: hazardId=' + hazardId + ', userCount=' + selectedUsers.length);
    
    try {
        // Get current assessment ID from the form
        console.log('?? Looking for form fields...');
        const assessmentIdField = document.querySelector('input[name="Id"]');
        const tokenField = document.querySelector('input[name="__RequestVerificationToken"]');
        
        console.log('?? Form fields found: assessmentId=' + (assessmentIdField ? 'YES' : 'NO') + ', token=' + (tokenField ? 'YES' : 'NO'));
        
        if (!assessmentIdField) {
            console.error('? Assessment ID field not found');
            throw new Error('Assessment ID not found');
        }
        
        if (!tokenField) {
            console.error('? Anti-forgery token not found');
            throw new Error('Anti-forgery token not found');
        }
        
        const assessmentId = assessmentIdField.value;
        const userIds = selectedUsers.map(function(u) { return u.id; }).join(',');
        
        console.log('?? Request data prepared: assessmentId=' + assessmentId + ', hazardId=' + hazardId + ', userIds=' + userIds);
        
        // Create form data
        console.log('?? Creating FormData...');
        const formData = new FormData();
        formData.append('hazardId', hazardId);
        formData.append('userIds', userIds);
        formData.append('Id', assessmentId);
        formData.append('StepNumber', '4');
        formData.append('__RequestVerificationToken', tokenField.value);
        
        const requestUrl = window.location.pathname + '?handler=AssignScoringPanel';
        console.log('?? Making POST request to: ' + requestUrl);
        
        const response = await fetch(requestUrl, {
            method: 'POST',
            body: formData
        });
        
        console.log('?? Server response received: status=' + response.status + ', ok=' + response.ok);
        
        if (response.ok) {
            const contentType = response.headers.get('content-type');
            console.log('?? Response content type: ' + contentType);
            
            if (contentType && contentType.includes('application/json')) {
                const result = await response.json();
                console.log('? JSON response data:', result);
                return result.success;
            } else {
                const textResponse = await response.text();
                console.log('?? Text response (first 500 chars): ' + textResponse.substring(0, 500));
                console.error('? Expected JSON response but got: ' + contentType);
                return false;
            }
        } else {
            const errorText = await response.text();
            console.error('? Server error response: status=' + response.status + ', error=' + errorText.substring(0, 500));
            throw new Error('Server error: ' + response.status + ' - ' + response.statusText);
        }
    } catch (error) {
        console.error('?? Network/Server error in updateScoringPanelOnServer:', error);
        return false;
    }
}

