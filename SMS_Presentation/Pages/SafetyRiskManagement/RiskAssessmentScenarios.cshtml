@page "{scenarioId?}"
@model PDXSMS_Presentation.Pages.SafetyRiskManagement.RiskAssessmentScenariosModel
@{
    ViewData["Title"] = "Risk Assessment Scenarios - Detailed Use Cases";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="#">Section 1: Safety Risk Management</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyRiskManagement/RiskAssessment">Risk Assessment</a></li>
                    <li class="breadcrumb-item active">Detailed Scenarios</li>
                </ol>
            </nav>
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h4 class="card-title"><i class="fas fa-book-open"></i> Risk Assessment Scenarios</h4>
                    <p class="card-text">Detailed use cases demonstrating the five-step risk assessment process</p>
                </div>
            </div>
        </div>
    </div>

    @if (Model.SelectedScenario == null)
    {
        <!-- Scenario Selection -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4><i class="fas fa-list"></i> Available Scenarios</h4>
                        <p class="mb-0 text-muted">Select a scenario to see detailed step-by-step walkthroughs</p>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var scenario in Model.Scenarios)
                            {
                                <div class="col-lg-4 mb-4">
                                    <div class="card h-100 border-info">
                                        <div class="card-header bg-info bg-opacity-10">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <h6 class="mb-0">@scenario.Category</h6>
                                                <span class="badge bg-@(scenario.Complexity == "High" ? "danger" : scenario.Complexity == "Medium" ? "warning" : "success")">
                                                    @scenario.Complexity
                                                </span>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            <h5 class="card-title">@scenario.Title</h5>
                                            <p class="card-text">@scenario.Description</p>
                                            
                                            <div class="row text-center mb-3">
                                                <div class="col-4">
                                                    <small class="text-muted">Duration</small>
                                                    <br><strong>@scenario.EstimatedDuration</strong>
                                                </div>
                                                <div class="col-4">
                                                    <small class="text-muted">Team Size</small>
                                                    <br><strong>@scenario.TeamSize</strong>
                                                </div>
                                                <div class="col-4">
                                                    <small class="text-muted">Stakeholders</small>
                                                    <br><strong>@scenario.KeyStakeholders.Length</strong>
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <small class="text-muted">Key Stakeholders:</small>
                                                <br>
                                                @foreach (var stakeholder in scenario.KeyStakeholders.Take(3))
                                                {
                                                    <span class="badge bg-secondary me-1">@stakeholder</span>
                                                }
                                                @if (scenario.KeyStakeholders.Length > 3)
                                                {
                                                    <span class="badge bg-light text-dark">+@(scenario.KeyStakeholders.Length - 3) more</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="card-footer">
                                            <a href="/SafetyRiskManagement/RiskAssessmentScenarios/@scenario.Id" class="btn btn-info w-100">
                                                <i class="fas fa-eye"></i> View Detailed Scenario
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Detailed Scenario View -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2>@Model.SelectedScenario.Title</h2>
                        <p class="text-muted mb-0">@Model.SelectedScenario.Description</p>
                    </div>
                    <div>
                        <a href="/SafetyRiskManagement/RiskAssessmentScenarios" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Scenarios
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Scenario Overview -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5><i class="fas fa-info-circle"></i> Scenario Overview</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <h6>Category</h6>
                                <p>@Model.SelectedScenario.Category</p>
                            </div>
                            <div class="col-md-3">
                                <h6>Complexity</h6>
                                <p>
                                    <span class="badge bg-@(Model.SelectedScenario.Complexity == "High" ? "danger" : Model.SelectedScenario.Complexity == "Medium" ? "warning" : "success")">
                                        @Model.SelectedScenario.Complexity
                                    </span>
                                </p>
                            </div>
                            <div class="col-md-3">
                                <h6>Estimated Duration</h6>
                                <p>@Model.SelectedScenario.EstimatedDuration</p>
                            </div>
                            <div class="col-md-3">
                                <h6>Team Size</h6>
                                <p>@Model.SelectedScenario.TeamSize</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <h6>Key Stakeholders</h6>
                                @foreach (var stakeholder in Model.SelectedScenario.KeyStakeholders)
                                {
                                    <span class="badge bg-primary me-2 mb-1">@stakeholder</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Five-Step Process -->
        <div class="row">
            <div class="col-12">
                <!-- Step Navigation -->
                <ul class="nav nav-pills nav-justified mb-3" id="stepTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="step1-tab" data-bs-toggle="pill" data-bs-target="#step1" type="button" role="tab">
                            <i class="fas fa-sitemap"></i><br>
                            <small>Step 1</small><br>
                            <strong>Describe System</strong>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="step2-tab" data-bs-toggle="pill" data-bs-target="#step2" type="button" role="tab">
                            <i class="fas fa-exclamation-triangle"></i><br>
                            <small>Step 2</small><br>
                            <strong>Identify Hazards</strong>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="step3-tab" data-bs-toggle="pill" data-bs-target="#step3" type="button" role="tab">
                            <i class="fas fa-chart-line"></i><br>
                            <small>Step 3</small><br>
                            <strong>Analyze Risk</strong>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="step4-tab" data-bs-toggle="pill" data-bs-target="#step4" type="button" role="tab">
                            <i class="fas fa-balance-scale"></i><br>
                            <small>Step 4</small><br>
                            <strong>Assess Risk</strong>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="step5-tab" data-bs-toggle="pill" data-bs-target="#step5" type="button" role="tab">
                            <i class="fas fa-shield-alt"></i><br>
                            <small>Step 5</small><br>
                            <strong>Mitigate Risk</strong>
                        </button>
                    </li>
                </ul>

                <!-- Step Content -->
                <div class="tab-content" id="stepTabsContent">
                    @if (Model.SelectedScenario.Step1_SystemDescription != null)
                    {
                        <div class="tab-pane fade show active" id="step1" role="tabpanel">
                            @await Html.PartialAsync("_AssessmentStepDetail", Model.SelectedScenario.Step1_SystemDescription)
                        </div>
                    }
                    
                    @if (Model.SelectedScenario.Step2_IdentifyHazards != null)
                    {
                        <div class="tab-pane fade" id="step2" role="tabpanel">
                            @await Html.PartialAsync("_AssessmentStepDetail", Model.SelectedScenario.Step2_IdentifyHazards)
                        </div>
                    }
                    
                    @if (Model.SelectedScenario.Step3_AnalyzeRisk != null)
                    {
                        <div class="tab-pane fade" id="step3" role="tabpanel">
                            @await Html.PartialAsync("_AssessmentStepDetail", Model.SelectedScenario.Step3_AnalyzeRisk)
                        </div>
                    }
                    
                    @if (Model.SelectedScenario.Step4_AssessRisk != null)
                    {
                        <div class="tab-pane fade" id="step4" role="tabpanel">
                            @await Html.PartialAsync("_AssessmentStepDetail", Model.SelectedScenario.Step4_AssessRisk)
                        </div>
                    }
                    
                    @if (Model.SelectedScenario.Step5_MitigateRisk != null)
                    {
                        <div class="tab-pane fade" id="step5" role="tabpanel">
                            @await Html.PartialAsync("_AssessmentStepDetail", Model.SelectedScenario.Step5_MitigateRisk)
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Action Panel -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h5>Ready to Start This Assessment?</h5>
                        <p class="text-muted">Use this scenario as a template for your own risk assessment</p>
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-warning">
                                <i class="fas fa-plus"></i> Create Assessment from Template
                            </button>
                            <button type="button" class="btn btn-outline-primary">
                                <i class="fas fa-download"></i> Export Scenario Guide
                            </button>
                            <button type="button" class="btn btn-outline-secondary">
                                <i class="fas fa-print"></i> Print Scenario
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Auto-advance through steps with previous/next buttons
        function nextStep() {
            const activeTab = document.querySelector('.nav-pills .nav-link.active');
            const nextTab = activeTab.parentElement.nextElementSibling?.querySelector('.nav-link');
            if (nextTab) {
                new bootstrap.Tab(nextTab).show();
            }
        }
        
        function previousStep() {
            const activeTab = document.querySelector('.nav-pills .nav-link.active');
            const prevTab = activeTab.parentElement.previousElementSibling?.querySelector('.nav-link');
            if (prevTab) {
                new bootstrap.Tab(prevTab).show();
            }
        }
    </script>
}}

