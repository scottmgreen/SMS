    <!-- Hazard Details -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-list"></i> Identified Hazards Details (@Model.Assessment.Method Assessment)</h5>
                </div>
                <div class="card-body">
                    @if (Model.IdentifiedHazards.Any())
                    {
                        @foreach (var hazard in Model.IdentifiedHazards)
                        {
                            var riskClass = GetHazardRiskClass(hazard.RiskLevel);
                            <div class="card border-@riskClass mb-3 hazard-card" data-risk-level="@hazard.RiskLevel">
                                <div class="card-header bg-@riskClass @(riskClass == "warning" ? "text-dark" : "text-white") d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@hazard.HazardId: @hazard.Description</strong>
                                        <span class="badge bg-light text-dark ms-2">@hazard.AssessmentMethod</span>
                                    </div>
                                    <div>
                                        <span class="badge bg-white text-dark">@hazard.RiskLevel</span>
                                        <span class="badge bg-light text-dark">@hazard.OverallRisk</span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <strong>Category:</strong><br>
                                                    <span class="text-muted">@hazard.Category</span>
                                                </div>
                                                <div class="col-sm-6">
                                                    <strong>@(hazard.AssessmentMethod == "Simplified" ? "Recommended Actions" : "Worst Credible Outcome"):</strong><br>
                                                    <span class="text-muted">@hazard.WorstCredibleOutcome</span>
                                                </div>
                                            </div>
                                            <div class="row mt-2">
                                                <div class="col-12">
                                                    <strong>Current @(hazard.AssessmentMethod == "Simplified" ? "Controls" : "Mitigations"):</strong><br>
                                                    @foreach (var mitigation in hazard.CurrentMitigations)
                                                    {
                                                        <span class="badge bg-secondary me-1 mb-1">@mitigation</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="text-center">
                                                <div class="row">
                                                    <div class="col-6">
                                                        <div class="border rounded p-2 bg-light">
                                                            <h4 class="text-primary mb-0">@hazard.Likelihood</h4>
                                                            <small class="text-muted">Likelihood</small>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="border rounded p-2 bg-light">
                                                            <h4 class="text-danger mb-0">@hazard.Severity</h4>
                                                            <small class="text-muted">Severity</small>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="mt-2">
                                                    @if (hazard.AssessmentMethod == "Simplified")
                                                    {
                                                        <a href="/SafetyRiskManagement/SimplifiedRiskAssessment/@hazard.HazardId/@Model.AssessmentId" class="btn btn-outline-primary btn-sm">
                                                            <i class="fas fa-eye"></i> View Assessment
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-outline-primary btn-sm" onclick="showMitigationOptions('@hazard.HazardId')">
                                                            <i class="fas fa-shield-alt"></i> Mitigation Options
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-exclamation-triangle fa-3x"></i>
                            <p class="mt-2">No hazards identified yet</p>
                            <a href="/SafetyRiskManagement/RiskAssessmentWizard/@Model.AssessmentId/step/2" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Add Hazards
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });

        // Handle risk matrix cell clicks
        document.querySelectorAll('.risk-cell').forEach(function(cell) {
            cell.addEventListener('click', function() {
                var riskLevel = this.getAttribute('data-risk-level');
                showHazardsForRiskLevel(riskLevel);
            });
        });

        function showHazardsForRiskLevel(riskLevel) {
            // Highlight the selected cell
            document.querySelectorAll('.risk-cell').forEach(function(cell) {
                cell.classList.remove('selected-cell');
            });
            var selectedCell = document.querySelector('[data-risk-level="' + riskLevel + '"]');
            if (selectedCell) {
                selectedCell.classList.add('selected-cell');
            }
            
            // Filter hazard cards
            filterHazardsByRiskLevel(riskLevel);
            
            // Show notification
            var hazardCount = document.querySelectorAll('.hazard-card[style*="block"]').length;
            if (hazardCount > 0) {
                showNotification('Showing ' + hazardCount + ' hazard(s) for risk level ' + riskLevel, 'info');
                // Scroll to first visible hazard
                var firstVisible = document.querySelector('.hazard-card[style*="block"]');
                if (firstVisible) {
                    firstVisible.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            } else {
                showNotification('No hazards found for risk level ' + riskLevel, 'warning');
            }
        }

        function filterHazardsByRiskLevel(targetRiskLevel) {
            var hazardCards = document.querySelectorAll('.hazard-card');
            hazardCards.forEach(function(card) {
                var cardRiskLevel = card.getAttribute('data-risk-level');
                if (!targetRiskLevel || cardRiskLevel === targetRiskLevel) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function showAllHazards() {
            filterHazardsByRiskLevel(null);
            clearSelectedCells();
            showNotification('Showing all hazards', 'success');
        }

        function filterHighRisk() {
            var highRiskLevels = ['3E', '4D', '4E', '5B', '5C', '5D', '5E', '2E', '3C', '3D', '4B', '4C', '5A'];
            filterByRiskLevels(highRiskLevels, 'high and very high risk');
        }

        function filterMediumRisk() {
            var mediumRiskLevels = ['1E', '2C', '2D', '3B', '4A'];
            filterByRiskLevels(mediumRiskLevels, 'medium risk');
        }

        function filterLowRisk() {
            var lowRiskLevels = ['1A', '1B', '1C', '1D', '2A', '2B', '3A'];
            filterByRiskLevels(lowRiskLevels, 'low and very low risk');
        }

        function filterByRiskLevels(riskLevels, description) {
            var hazardCards = document.querySelectorAll('.hazard-card');
            var visibleCount = 0;
            
            hazardCards.forEach(function(card) {
                var cardRiskLevel = card.getAttribute('data-risk-level');
                if (riskLevels.includes(cardRiskLevel)) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            
            clearSelectedCells();
            showNotification('Showing ' + visibleCount + ' ' + description + ' hazard(s)', 'info');
        }

        function clearSelectedCells() {
            document.querySelectorAll('.risk-cell').forEach(function(cell) {
                cell.classList.remove('selected-cell');
            });
        }

        function showNotification(message, type) {
            // Create notification element
            var notification = document.createElement('div');
            notification.className = 'alert alert-' + type + ' alert-dismissible fade show position-fixed';
            notification.style.top = '20px';
            notification.style.right = '20px';
            notification.style.zIndex = '9999';
            notification.style.minWidth = '300px';
            notification.innerHTML = message + 
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
            
            document.body.appendChild(notification);
            
            // Auto-remove after 3 seconds
            setTimeout(function() {
                if (notification.parentNode) {
                    notification.parentNode.removeChild(notification);
                }
            }, 3000);
        }

        function showMitigationOptions(hazardId) {
            // This would typically open a modal with mitigation strategies
            alert('Mitigation options for ' + hazardId + ':\n\n' +
                  '• Engineering Controls (Physical barriers, systems)\n' +
                  '• Administrative Controls (Procedures, training)\n' +
                  '• Personal Protective Equipment (PPE)\n' +
                  '• Emergency Response Plans\n' +
                  '• Monitoring and Surveillance\n\n' +
                  'Click OK to continue to mitigation planning...');
        }

        // Log assessment details for debugging
        console.log('Assessment Details Loaded:', {
            id: '@Model.AssessmentId',
            method: '@Model.Assessment.Method',
            status: '@Model.Assessment.Status',
            hazardCount: @Model.IdentifiedHazards.Count
        });
    </script>
    
    <style>
        .risk-cell {
            transition: all 0.3s ease;
        }
        
        .risk-cell:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }
        
        .selected-cell {
            border: 3px solid #ffff00 !important;
            box-shadow: 0 0 15px rgba(255,255,0,0.5);
        }
        
        .risk-matrix td {
            position: relative;
        }
        
        .risk-matrix .badge {
            font-size: 0.6em;
        }
    </style>
}

@functions {
    private string GetRiskCellClass(int severity, int likelihood)
    {
        // Special case for Rare column (A = likelihood 0)
        if (likelihood == 0)
        {
            if (severity == 5)
                return "bg-warning"; // 5A - Catastrophic/Rare = Yellow
            else
                return "bg-success"; // 4A, 3A, 2A, 1A = Green
        }
        
        // Special case for Unlikely column (B = likelihood 1)
        if (likelihood == 1)
        {
            if (severity == 5)
                return "bg-orange"; // 5B - Catastrophic/Unlikely = Orange
            else if (severity == 4 || severity == 3)
                return "bg-warning"; // 4B, 3B - Major/Serious/Unlikely = Yellow
            else
                return "bg-success"; // 2B, 1B - Moderate/Minor/Unlikely = Green
        }
        
        // Special case for Possible column (C = likelihood 2)
        if (likelihood == 2)
        {
            if (severity == 5)
                return "bg-danger"; // 5C - Catastrophic/Possible = Red
            else if (severity == 4)
                return "bg-orange"; // 4C - Major/Possible = Orange
            else if (severity == 3 || severity == 2)
                return "bg-warning"; // 3C, 2C - Serious/Moderate/Possible = Yellow
            else
                return "bg-success"; // 1C - Minor/Possible = Green
        }
        
        // Special case for Likely column (D = likelihood 3)
        if (likelihood == 3)
        {
            if (severity == 5 || severity == 4)
                return "bg-danger"; // 5D, 4D - Catastrophic/Major/Likely = Red
            else if (severity == 3)
                return "bg-orange"; // 3D - Serious/Likely = Orange
            else if (severity == 2)
                return "bg-warning"; // 2D - Moderate/Likely = Yellow
            else
                return "bg-success"; // 1D - Minor/Likely = Green
        }
        
        // Special case for Frequent column (E = likelihood 4)
        if (likelihood == 4)
        {
            if (severity == 5 || severity == 4 || severity == 3)
                return "bg-danger"; // 5E, 4E, 3E - Catastrophic/Major/Serious/Frequent = Red
            else if (severity == 2)
                return "bg-orange"; // 2E - Moderate/Frequent = Orange
            else
                return "bg-warning"; // 1E - Minor/Frequent = Yellow
        }
        
        // SMS Risk Matrix Logic for other columns (fallback - shouldn't be needed now)
        if ((severity == 1 && likelihood <= 2) || (severity == 2 && likelihood == 0))
            return "bg-success"; // Very Low Risk
        else if ((severity == 1 && likelihood <= 4) || (severity == 2 && likelihood <= 1) || (severity == 3 && likelihood == 0))
            return "bg-warning"; // Low Risk
        else if ((severity == 1 && likelihood == 4) || (severity == 2 && likelihood <= 3) || (severity == 3 && likelihood == 1) || (severity == 4 && likelihood == 0))
            return "bg-primary"; // Medium Risk
        else if ((severity == 2 && likelihood == 4) || (severity == 3 && likelihood <= 3) || (severity == 4 && likelihood <= 2) || (severity == 5 && likelihood == 0))
            return "bg-danger"; // High Risk
        else
            return "bg-dark"; // Very High Risk
    }
    
    private string GetRiskCellTextClass(int severity, int likelihood)
    {
        var bgClass = GetRiskCellClass(severity, likelihood);
        return (bgClass == "bg-warning") ? "text-dark" : "text-white";
    }
    
    private string GetHazardRiskClass(string riskLevel)
    {
        var severity = int.Parse(riskLevel.Substring(0, 1));
        var likelihood = riskLevel[1] - 'A';
        
        // Special case for Rare column (A = likelihood 0)
        if (likelihood == 0)
        {
            if (severity == 5)
                return "warning"; // 5A - Catastrophic/Rare = Yellow
            else
                return "success"; // 4A, 3A, 2A, 1A = Green
        }
        
        // Special case for Unlikely column (B = likelihood 1)
        if (likelihood == 1)
        {
            if (severity == 5)
                return "info"; // 5B - Catastrophic/Unlikely = Orange (using info as orange substitute)
            else if (severity == 4 || severity == 3)
                return "warning"; // 4B, 3B - Major/Serious/Unlikely = Yellow
            else
                return "success"; // 2B, 1B - Moderate/Minor/Unlikely = Green
        }
        
        // Special case for Possible column (C = likelihood 2)
        if (likelihood == 2)
        {
            if (severity == 5)
                return "danger"; // 5C - Catastrophic/Possible = Red
            else if (severity == 4)
                return "info"; // 4C - Major/Possible = Orange (using info as orange substitute)
            else if (severity == 3 || severity == 2)
                return "warning"; // 3C, 2C - Serious/Moderate/Possible = Yellow
            else
                return "success"; // 1C - Minor/Possible = Green
        }
        
        // Special case for Likely column (D = likelihood 3)
        if (likelihood == 3)
        {
            if (severity == 5 || severity == 4)
                return "danger"; // 5D, 4D - Catastrophic/Major/Likely = Red
            else if (severity == 3)
                return "info"; // 3D - Serious/Likely = Orange (using info as orange substitute)
            else if (severity == 2)
                return "warning"; // 2D - Moderate/Likely = Yellow
            else
                return "success"; // 1D - Minor/Likely = Green
        }
        
        // Special case for Frequent column (E = likelihood 4)
        if (likelihood == 4)
        {
            if (severity == 5 || severity == 4 || severity == 3)
                return "danger"; // 5E, 4E, 3E - Catastrophic/Major/Serious/Frequent = Red
            else if (severity == 2)
                return "info"; // 2E - Moderate/Frequent = Orange (using info as orange substitute)
            else
                return "warning"; // 1E - Minor/Frequent = Yellow
        }
        
        if ((severity == 1 && likelihood <= 2) || (severity == 2 && likelihood == 0))
            return "success";
        else if ((severity == 1 && likelihood <= 4) || (severity == 2 && likelihood <= 1) || (severity == 3 && likelihood == 0))
            return "warning";
        else if ((severity == 1 && likelihood == 4) || (severity == 2 && likelihood <= 3) || (severity == 3 && likelihood == 1) || (severity == 4 && likelihood == 0))
            return "primary";
        else if ((severity == 2 && likelihood == 4) || (severity == 3 && likelihood <= 3) || (severity == 4 && likelihood <= 2) || (severity == 5 && likelihood == 0))
            return "danger";
        else
            return "dark";
    }
    
    private string GetRiskLevelText(string riskLevel)
    {
        var severity = int.Parse(riskLevel.Substring(0, 1));
        var likelihood = riskLevel[1] - 'A';
        
        // Special case for Rare column (A = likelihood 0)
        if (likelihood == 0)
        {
            if (severity == 5)
                return "Low Risk"; // 5A - Catastrophic/Rare = Yellow (Low Risk)
            else
                return "Very Low Risk"; // 4A, 3A, 2A, 1A = Green (Very Low Risk)
        }
        
        // Special case for Unlikely column (B = likelihood 1)
        if (likelihood == 1)
        {
            if (severity == 5)
                return "Medium Risk"; // 5B - Catastrophic/Unlikely = Orange (Medium Risk)
            else if (severity == 4 || severity == 3)
                return "Low Risk"; // 4B, 3B - Major/Serious/Unlikely = Yellow (Low Risk)
            else
                return "Very Low Risk"; // 2B, 1B - Moderate/Minor/Unlikely = Green (Very Low Risk)
        }
        
        // Special case for Possible column (C = likelihood 2)
        if (likelihood == 2)
        {
            if (severity == 5)
                return "High Risk"; // 5C - Catastrophic/Possible = Red (High Risk)
            else if (severity == 4)
                return "Medium Risk"; // 4C - Major/Possible = Orange (Medium Risk)
            else if (severity == 3 || severity == 2)
                return "Low Risk"; // 3C, 2C - Serious/Moderate/Possible = Yellow (Low Risk)
            else
                return "Very Low Risk"; // 1C - Minor/Possible = Green (Very Low Risk)
        }
        
        // Special case for Likely column (D = likelihood 3)
        if (likelihood == 3)
        {
            if (severity == 5 || severity == 4)
                return "High Risk"; // 5D, 4D - Catastrophic/Major/Likely = Red (High Risk)
            else if (severity == 3)
                return "Medium Risk"; // 3D - Serious/Likely = Orange (Medium Risk)
            else if (severity == 2)
                return "Low Risk"; // 2D - Moderate/Likely = Yellow (Low Risk)
            else
                return "Very Low Risk"; // 1D - Minor/Likely = Green (Very Low Risk)
        }
        
        // Special case for Frequent column (E = likelihood 4)
        if (likelihood == 4)
        {
            if (severity == 5 || severity == 4 || severity == 3)
                return "Very High Risk"; // 5E, 4E, 3E - Catastrophic/Major/Serious/Frequent = Red (Very High Risk)
            else if (severity == 2)
                return "High Risk"; // 2E - Moderate/Frequent = Orange (High Risk)
            else
                return "Medium Risk"; // 1E - Minor/Frequent = Yellow (Medium Risk)
        }
        
        if ((severity == 1 && likelihood <= 2) || (severity == 2 && likelihood == 0))
            return "Very Low Risk";
        else if ((severity == 1 && likelihood <= 4) || (severity == 2 && likelihood <= 1) || (severity == 3 && likelihood == 0))
            return "Low Risk";
        else if ((severity == 1 && likelihood == 4) || (severity == 2 && likelihood <= 3) || (severity == 3 && likelihood == 1) || (severity == 4 && likelihood == 0))
            return "Medium Risk";
        else if ((severity == 2 && likelihood == 4) || (severity == 3 && likelihood <= 3) || (severity == 4 && likelihood <= 2) || (severity == 5 && likelihood == 0))
            return "High Risk";
        else
            return "Very High Risk";
    }
