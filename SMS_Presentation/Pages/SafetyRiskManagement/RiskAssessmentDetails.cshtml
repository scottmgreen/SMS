@page "{id}"
@model PDXSMS_Presentation.Pages.SafetyRiskManagement.RiskAssessmentDetailsModel
@{
    ViewData["Title"] = $"Risk Assessment Details - {Model.AssessmentId}";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="#">Section 1: Safety Risk Management</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyRiskManagement/RiskAssessment">Risk Assessment</a></li>
                    <li class="breadcrumb-item active">@Model.AssessmentId</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="card-title">
                                <i class="fas fa-clipboard-check"></i> @Model.Assessment.Name
                                <span class="badge bg-light text-primary ms-2">@Model.Assessment.Method</span>
                            </h4>
                            <p class="card-text">Assessment ID: @Model.AssessmentId | Lead: @Model.Assessment.LeadAssessor</p>
                        </div>
                        <div class="text-end">
                            @if (Model.Assessment.Method == "Simplified")
                            {
                                <h3>@(Model.Assessment.Status == "Completed" ? "✅ Complete" : "🔄 In Progress")</h3>
                                <div class="progress" style="width: 200px;">
                                    <div class="progress-bar @(Model.Assessment.Status == "Completed" ? "bg-success" : "bg-warning")" style="width: @Model.Assessment.Progress%">@Model.Assessment.Progress%</div>
                                </div>
                                <small>Simplified Assessment</small>
                            }
                            else
                            {
                                <h3>Step @Model.Assessment.CurrentStep of 5</h3>
                                <div class="progress" style="width: 200px;">
                                    <div class="progress-bar bg-warning" style="width: @Model.Assessment.Progress%">@Model.Assessment.Progress%</div>
                                </div>
                                <small>SMS 5-Step Technical Assessment</small>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Assessment Status -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-info-circle"></i> Assessment Overview</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>System Description:</strong><br>@Model.Assessment.SystemDescription</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Assessment Scope:</strong><br>@Model.Assessment.Scope</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <small class="text-muted">Started:</small><br>
                            <strong>@Model.Assessment.StartDate.ToString("MM/dd/yyyy")</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Status:</small><br>
                            <span class="badge @(Model.Assessment.Status == "Completed" ? "bg-success" : "bg-warning")">@Model.Assessment.Status</span>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Lead Assessor:</small><br>
                            <strong>@Model.Assessment.LeadAssessor</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Hazards Identified:</small><br>
                            <strong>@Model.IdentifiedHazards.Count</strong>
                        </div>
                    </div>
                    @if (Model.Assessment.Status == "Completed" && Model.Assessment.CompletedDate != DateTime.MinValue)
                    {
                        <div class="row mt-2">
                            <div class="col-12">
                                <div class="alert alert-success">
                                    <i class="fas fa-check-circle"></i> <strong>Assessment Completed:</strong> @Model.Assessment.CompletedDate.ToString("MM/dd/yyyy HH:mm")
                                    @if (Model.Assessment.Method == "Simplified")
                                    {
                                        <br><small>This simplified assessment provides initial risk evaluation. Consider full SMS 5-Step assessment for complex hazards.</small>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-info">
                <div class="card-header bg-info text-white">
                    <h5><i class="fas fa-tasks"></i> Progress Tracker</h5>
                </div>
                <div class="card-body">
                    @if (Model.Assessment.Method == "Simplified")
                    {
                        <div class="list-group list-group-flush">
                            <div class="list-group-item list-group-item-success d-flex justify-content-between align-items-center">
                                Risk Level Assessment
                                <i class="fas fa-check-circle text-success"></i>
                            </div>
                            <div class="list-group-item @(Model.Assessment.Status == "Completed" ? "list-group-item-success" : "list-group-item-warning") d-flex justify-content-between align-items-center">
                                Assessment Complete
                                @if (Model.Assessment.Status == "Completed")
                                {
                                    <i class="fas fa-check-circle text-success"></i>
                                }
                                else
                                {
                                    <i class="fas fa-cog fa-spin text-warning"></i>
                                }
                            </div>
                        </div>
                        <div class="mt-3">
                            <a href="/SafetyRiskManagement/SimplifiedRiskAssessment/@Model.IdentifiedHazards.FirstOrDefault()?.HazardId/@Model.AssessmentId" class="btn btn-outline-primary btn-sm w-100">
                                <i class="fas fa-edit"></i> @(Model.Assessment.Status == "Completed" ? "View Details" : "Continue Assessment")
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            <div class="list-group-item d-flex justify-content-between align-items-center @(Model.Assessment.CurrentStep >= 1 ? "list-group-item-success" : "")">
                                Step 1: Describe System
                                @if (Model.Assessment.CurrentStep >= 1)
                                {
                                    <i class="fas fa-check-circle text-success"></i>
                                }
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center @(Model.Assessment.CurrentStep >= 2 ? "list-group-item-success" : "")">
                                Step 2: Identify Hazards
                                @if (Model.Assessment.CurrentStep >= 2)
                                {
                                    <i class="fas fa-check-circle text-success"></i>
                                }
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center @(Model.Assessment.CurrentStep >= 3 ? (Model.Assessment.CurrentStep == 3 ? "list-group-item-warning" : "list-group-item-success") : "")">
                                Step 3: Analyze Risk
                                @if (Model.Assessment.CurrentStep > 3)
                                {
                                    <i class="fas fa-check-circle text-success"></i>
                                }
                                else if (Model.Assessment.CurrentStep == 3)
                                {
                                    <i class="fas fa-cog fa-spin text-warning"></i>
                                }
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center @(Model.Assessment.CurrentStep >= 4 ? (Model.Assessment.CurrentStep == 4 ? "list-group-item-warning" : "list-group-item-success") : "")">
                                Step 4: Assess Risk
                                @if (Model.Assessment.CurrentStep > 4)
                                {
                                    <i class="fas fa-check-circle text-success"></i>
                                }
                                else if (Model.Assessment.CurrentStep == 4)
                                {
                                    <i class="fas fa-cog fa-spin text-warning"></i>
                                }
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center @(Model.Assessment.CurrentStep >= 5 ? "list-group-item-success" : "")">
                                Step 5: Mitigate Risk
                                @if (Model.Assessment.CurrentStep >= 5)
                                {
                                    <i class="fas fa-check-circle text-success"></i>
                                }
                            </div>
                        </div>
                        <div class="mt-3">
                            <a href="/SafetyRiskManagement/RiskAssessmentWizard/@Model.AssessmentId/step/@Model.Assessment.CurrentStep" class="btn btn-outline-primary btn-sm w-100">
                                <i class="fas fa-edit"></i> Continue Assessment
                            </a>
                        </div>
                    }
                    <a href="/SafetyRiskManagement/FiveMMethodology" class="btn btn-outline-secondary btn-sm w-100 mt-2">
                        <i class="fas fa-project-diagram"></i> 5M Framework
                    </a>
                </div>
            </div>
        </div>
    </div>

