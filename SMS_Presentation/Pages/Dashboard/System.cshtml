@page
@model SMS.Presentation.Pages.Dashboard.SystemModel
@{
    ViewData["Title"] = "System Dashboard - PDXSMS";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 text-primary">
                <i class="fas fa-cogs"></i> System Dashboard
            </h1>
            <div class="user-info">
                <span class="badge bg-primary me-2">
                    <i class="fas fa-shield-alt"></i> @Model.PermissionLevel
                </span>
                <strong>@Model.DisplayName</strong>
            </div>
        </div>
    </div>
</div>

<!-- System Metrics Cards -->
<div class="row mb-4">
    <div class="col-lg-4 mb-3">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-users"></i> User Management
                </h5>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="text-primary mb-1">@Model.TotalUsers</h3>
                        <p class="text-muted mb-0">Active Users</p>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-user-friends fa-2x text-primary opacity-50"></i>
                    </div>
                </div>
                <hr>
                <a href="/System/Users" class="btn btn-outline-primary btn-sm w-100">
                    <i class="fas fa-cog"></i> Manage Users
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-3">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-line"></i> System Health
                </h5>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="text-success mb-1">Online</h3>
                        <p class="text-muted mb-0">SMS Backend</p>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-heartbeat fa-2x text-success"></i>
                    </div>
                </div>
                <hr>
                <a href="/System/Health" class="btn btn-outline-info btn-sm w-100">
                    <i class="fas fa-stethoscope"></i> Health Check
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-3">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark">
                <h5 class="card-title mb-0">
                    <i class="fas fa-exclamation-triangle"></i> System Alerts
                </h5>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="text-warning mb-1">@Model.SystemAlerts</h3>
                        <p class="text-muted mb-0">Active Alerts</p>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-bell fa-2x text-warning opacity-50"></i>
                    </div>
                </div>
                <hr>
                <a href="/System/Alerts" class="btn btn-outline-warning btn-sm w-100">
                    <i class="fas fa-list"></i> View Alerts
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions Section -->
<div class="row mb-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="fas fa-tasks"></i> Quick Actions
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="list-group">
                            <h6 class="text-muted mb-2">User Management</h6>
                            <a href="/System/Users" class="list-group-item list-group-item-action">
                                <i class="fas fa-users text-primary me-2"></i>Manage Users
                            </a>
                            <a href="/System/Roles" class="list-group-item list-group-item-action">
                                <i class="fas fa-user-shield text-info me-2"></i>Manage Roles
                            </a>
                            <a href="/System/Permissions" class="list-group-item list-group-item-action">
                                <i class="fas fa-key text-warning me-2"></i>Permissions
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="list-group">
                            <h6 class="text-muted mb-2">System Configuration</h6>
                            <a href="/System/Settings" class="list-group-item list-group-item-action">
                                <i class="fas fa-cog text-secondary me-2"></i>System Settings
                            </a>
                            <a href="/System/Database" class="list-group-item list-group-item-action">
                                <i class="fas fa-database text-success me-2"></i>Database Admin
                            </a>
                            <a href="/System/Logs" class="list-group-item list-group-item-action">
                                <i class="fas fa-file-alt text-dark me-2"></i>System Logs
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-info-circle"></i> System Information
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted">SMS Portal Version</small>
                    <div class="fw-bold">2.0.0</div>
                </div>
                <div class="mb-3">
                    <small class="text-muted">Backend Status</small>
                    <div class="fw-bold text-success">
                        <i class="fas fa-check-circle"></i> Connected
                    </div>
                </div>
                <div class="mb-3">
                    <small class="text-muted">Database</small>
                    <div class="fw-bold">PDXSMS_V2</div>
                </div>
                <div class="mb-0">
                    <small class="text-muted">Active Sessions</small>
                    <div class="fw-bold">@Model.ActiveSessions</div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-link"></i> Quick Links
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/SafetyRiskManagement/HazardReporting" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-exclamation-triangle"></i> Safety Management
                    </a>
                    <a href="/Reports/System" class="btn btn-outline-info btn-sm">
                        <i class="fas fa-chart-bar"></i> Reports
                    </a>
                    <a href="/Account/Logout" class="btn btn-outline-danger btn-sm">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="fas fa-clock"></i> Recent System Activity
                </h5>
            </div>
            <div class="card-body">
                <div class="alert alert-success">
                    <h6 class="alert-heading">
                        <i class="fas fa-check-circle"></i> SMS Portal Operational
                    </h6>
                    <p class="mb-0">
                        System is running normally with direct SMS Backend integration. 
                        All core services are operational and ready for safety management operations.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        console.log('SMS System Dashboard: Admin Access Active');
        console.log('User: @Model.DisplayName (@Model.PermissionLevel)');
        
        // Add some interactive enhancements
        document.addEventListener('DOMContentLoaded', function() {
            // Add hover effects to cards
            const cards = document.querySelectorAll('.card');
            cards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-2px)';
                    this.style.transition = 'transform 0.2s ease-in-out';
                    this.style.boxShadow = '0 4px 8px rgba(0,0,0,0.1)';
                });
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = '';
                });
            });
        });
    </script>
}