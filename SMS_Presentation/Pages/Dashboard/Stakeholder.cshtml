@page
@model SMS.Presentation.Pages.Dashboard.StakeholderModel
@{
    ViewData["Title"] = "Stakeholder Dashboard - PDXSMS";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 text-info">
                <i class="fas fa-handshake"></i> Stakeholder Portal
            </h1>
            <div class="user-info">
                <span class="badge bg-info me-2">
                    <i class="fas fa-building"></i> @Model.Organization
                </span>
                <strong>@Model.DisplayName</strong>
            </div>
        </div>
    </div>
</div>

<!-- Stakeholder Metrics Cards -->
<div class="row mb-4">
    <div class="col-lg-4 mb-3">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-file-alt"></i> Safety Reports
                </h5>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="text-primary mb-1">@Model.SubmittedReports</h3>
                        <p class="text-muted mb-0">Submitted</p>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-clipboard fa-2x text-primary opacity-50"></i>
                    </div>
                </div>
                <hr>
                <a href="/SafetyReporting/Submit" class="btn btn-outline-primary btn-sm w-100">
                    <i class="fas fa-plus"></i> Submit Report
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-3">
        <div class="card border-success">
            <div class="card-header bg-success text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-bar"></i> Safety Data
                </h5>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="text-success mb-1">@Model.AccessibleReports</h3>
                        <p class="text-muted mb-0">Available Reports</p>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-chart-line fa-2x text-success opacity-50"></i>
                    </div>
                </div>
                <hr>
                <a href="/Reports/Public" class="btn btn-outline-success btn-sm w-100">
                    <i class="fas fa-eye"></i> View Data
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-3">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark">
                <h5 class="card-title mb-0">
                    <i class="fas fa-graduation-cap"></i> Training
                </h5>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="text-warning mb-1">@Model.TrainingModules</h3>
                        <p class="text-muted mb-0">Available Modules</p>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-book fa-2x text-warning opacity-50"></i>
                    </div>
                </div>
                <hr>
                <a href="/Training/Resources" class="btn btn-outline-warning btn-sm w-100">
                    <i class="fas fa-play"></i> Start Training
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Stakeholder Actions -->
<div class="row mb-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="fas fa-tasks"></i> Available Actions
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="list-group">
                            <h6 class="text-muted mb-2">Safety Reporting</h6>
                            <a href="/SafetyReporting/Submit" class="list-group-item list-group-item-action">
                                <i class="fas fa-file-alt text-primary me-2"></i>Submit Safety Report
                            </a>
                            <a href="/SafetyReporting/Anonymous" class="list-group-item list-group-item-action">
                                <i class="fas fa-user-secret text-secondary me-2"></i>Anonymous Report
                            </a>
                            <a href="/SafetyReporting/Status" class="list-group-item list-group-item-action">
                                <i class="fas fa-search text-info me-2"></i>Report Status
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="list-group">
                            <h6 class="text-muted mb-2">Resources</h6>
                            <a href="/Reports/Public" class="list-group-item list-group-item-action">
                                <i class="fas fa-chart-bar text-success me-2"></i>Safety Statistics
                            </a>
                            <a href="/Training/Resources" class="list-group-item list-group-item-action">
                                <i class="fas fa-graduation-cap text-warning me-2"></i>Training Materials
                            </a>
                            <a href="/SafetyPolicy/Public" class="list-group-item list-group-item-action">
                                <i class="fas fa-book text-dark me-2"></i>Safety Policies
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-user"></i> Organization Info
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted">Organization</small>
                    <div class="fw-bold">@Model.Organization</div>
                </div>
                <div class="mb-3">
                    <small class="text-muted">Stakeholder Type</small>
                    <div class="fw-bold">@Model.StakeholderType</div>
                </div>
                <div class="mb-0">
                    <small class="text-muted">Access Level</small>
                    <div class="fw-bold">Stakeholder</div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header bg-light">
                <h6 class="card-title mb-0">
                    <i class="fas fa-info-circle"></i> Support
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/Help/UserGuide" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-question-circle"></i> User Guide
                    </a>
                    <a href="/Contact/Support" class="btn btn-outline-info btn-sm">
                        <i class="fas fa-envelope"></i> Contact Support
                    </a>
                    <a href="/Account/Logout" class="btn btn-outline-danger btn-sm">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Welcome Message -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="fas fa-info-circle"></i> Welcome to PDXSMS
                </h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <h6 class="alert-heading">
                        <i class="fas fa-shield-alt"></i> Port of Portland Safety Management System
                    </h6>
                    <p class="mb-2">
                        As a stakeholder in aviation safety at PDX, your participation is vital to maintaining 
                        the highest safety standards. This portal provides access to safety reporting tools, 
                        training resources, and safety data relevant to your organization.
                    </p>
                    <hr>
                    <p class="mb-0">
                        <strong>Need help?</strong> Use the User Guide or contact support for assistance with any safety reporting functions.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        console.log('SMS Stakeholder Dashboard: Active');
        console.log('User: @Model.DisplayName (@Model.Organization)');
        
        // Add some interactive enhancements
        document.addEventListener('DOMContentLoaded', function() {
            // Add hover effects to action cards
            const actionCards = document.querySelectorAll('.list-group-item-action');
            actionCards.forEach(item => {
                item.addEventListener('mouseenter', function() {
                    this.style.backgroundColor = '#f8f9fa';
                    this.style.transition = 'background-color 0.2s ease-in-out';
                });
                item.addEventListener('mouseleave', function() {
                    this.style.backgroundColor = '';
                });
            });
        });
    </script>
}