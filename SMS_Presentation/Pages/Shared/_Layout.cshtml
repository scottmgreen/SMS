    <main class="flex-grow-1">
        <!-- Alert Messages -->
       @*  @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        } *@
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show m-3" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i>@TempData["WarningMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show m-3" role="alert">
                <i class="fas fa-info-circle me-2"></i>@TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Page Content -->
        <div class="container-fluid pdx-main-content">
            <!-- Development Authentication Debug Panel -->
            @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development" && isAuthenticated)
            {
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="card border-info">
                            <div class="card-header bg-info text-white">
                                <button class="btn btn-sm btn-outline-light float-end" type="button" data-bs-toggle="collapse" data-bs-target="#authDebugPanel">
                                    <i class="fas fa-code"></i> Toggle Debug
                                </button>
                                <h6 class="mb-0"><i class="fas fa-bug"></i> Development Authentication Debug</h6>
                            </div>
                            <div class="collapse" id="authDebugPanel">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <h6>Session Data:</h6>
                                            <table class="table table-sm table-bordered">
                                                <tr><td><strong>User ID:</strong></td><td>@(smsUserId ?? "NULL")</td></tr>
                                                <tr><td><strong>Email:</strong></td><td>@(smsEmail ?? "NULL")</td></tr>
                                                <tr>
                                                    <td><strong>User Type:</strong></td>
                                                    <td>
                                                        '@(smsUserType ?? "NULL")' 
                                                        <span class="badge bg-info">@(smsUserType?.Length ?? 0) chars</span>
                                                        @if (!string.IsNullOrEmpty(smsUserType))
                                                        {
                                                            <br>
                                                    
                                                            <small class="text-muted">Bytes: [@(string.Join(", ", global::System.Text.Encoding.UTF8.GetBytes(smsUserType).Select(b => b.ToString())))]</small>
                                                        }
                                                    </td>
                                                </tr>
                                                <tr><td><strong>Display Name:</strong></td><td>@(smsDisplayName ?? "NULL")</td></tr>
                                                <tr><td><strong>First Name:</strong></td><td>@(smsFirstName ?? "NULL")</td></tr>
                                                <tr><td><strong>Last Name:</strong></td><td>@(smsLastName ?? "NULL")</td></tr>
                                            </table>
                                        </div>
                                        <div class="col-md-4">
                                            <h6>Type-Specific Data:</h6>
                                            <table class="table table-sm table-bordered">
                                                @if (isApplication)
                                                {
                                                    <tr><td><strong>Application Role:</strong></td><td>@smsApplicationRole</td></tr>
                                                    <tr><td><strong>Permission Level:</strong></td><td>@smsPermissionLevel</td></tr>
                                                }
                                                @if (isOrganizational)
                                                {
                                                    <tr><td><strong>Department:</strong></td><td>@smsDepartment</td></tr>
                                                    <tr><td><strong>Position:</strong></td><td>@smsPosition</td></tr>
                                                    <tr><td><strong>Organization Level:</strong></td><td>@smsOrganizationLevel</td></tr>
                                                }
                                                @if (isStakeholder)
                                                {
                                                    <tr><td><strong>Organization:</strong></td><td>@smsOrganization</td></tr>
                                                    <tr><td><strong>Stakeholder Type:</strong></td><td>@smsStakeholderType</td></tr>
                                                    <tr><td><strong>Access Level:</strong></td><td>@smsAccessLevel</td></tr>
                                                }
                                            </table>
                                        </div>
                                        <div class="col-md-4">
                                            <h6>Computed Permissions:</h6>
                                            <table class="table table-sm table-bordered">
                                                <tr><td><strong>Is Authenticated:</strong></td><td><span class="badge @(isAuthenticated ? "bg-success" : "bg-danger")">@isAuthenticated</span></td></tr>
                                                <tr><td><strong>Is Application:</strong></td><td><span class="badge @(isApplication ? "bg-success" : "bg-secondary")">@isApplication</span></td></tr>
                                                <tr><td><strong>Is Organizational:</strong></td><td><span class="badge @(isOrganizational ? "bg-success" : "bg-secondary")">@isOrganizational</span></td></tr>
                                                <tr><td><strong>Is Stakeholder:</strong></td><td><span class="badge @(isStakeholder ? "bg-success" : "bg-secondary")">@isStakeholder</span></td></tr>
                                                <tr><td><strong>Is Super Admin:</strong></td><td><span class="badge @(isSuperAdmin ? "bg-danger" : "bg-secondary")">@isSuperAdmin</span></td></tr>
                                                <tr><td><strong>Is Admin:</strong></td><td><span class="badge @(isAdmin ? "bg-warning" : "bg-secondary")">@isAdmin</span></td></tr>
                                                <tr><td><strong>Has Write Access:</strong></td><td><span class="badge @(hasWriteAccess ? "bg-info" : "bg-secondary")">@hasWriteAccess</span></td></tr>
                                                <tr><td><strong>Has Read Access:</strong></td><td><span class="badge @(hasReadAccess ? "bg-success" : "bg-secondary")">@hasReadAccess</span></td></tr>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12">
                                            <h6>Display Values:</h6>
                                            <table class="table table-sm table-bordered">
                                                <tr>
                                                    <td><strong>Display Name:</strong></td><td>@displayName</td>
                                                    <td><strong>User Type Display:</strong></td><td>@userTypeDisplay</td>
                                                    <td><strong>Permission Display:</strong></td><td>@permissionDisplay</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            
            @RenderBody()
        </div>
    </main>

    <footer class="pdx-footer text-center py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-8 mx-auto">
                    <small class="d-block mb-2">
                        <strong>PDXSMS</strong> - Port of Portland Safety Management System
                    </small>
                    <small class="d-block mb-2">
                        &copy; @DateTime.Now.Year Port of Portland. All rights reserved.
                    </small>
                    @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
                    {
                        <small>
                            <span class="badge bg-warning text-dark">Development Environment</span>
                        </small>
                    }
                    
                    <!-- Development Debug Info -->
                    @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development" && isAuthenticated)
                    {
                        <div class="mt-2">
                            <small class="text-muted">
                                <strong>Debug:</strong> User: @smsUserId | Type: @smsUserType | 
                                @if (isApplication) { <text>Role: @smsApplicationRole</text> }
                                @if (isOrganizational) { <text>Level: @smsOrganizationLevel</text> }
                                @if (isStakeholder) { <text>Access: @smsAccessLevel</text> }
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- PDXSMS JavaScript -->
    <script src="~/js/site.js"></script>
    
    <!-- PDXSMS-specific JavaScript -->
    <script>
        // Enhanced alert auto-dismiss with fade effect
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-dismiss alerts after 7 seconds (slightly longer for better UX)
            setTimeout(function() {
                var alerts = document.querySelectorAll('.alert.alert-dismissible');
                alerts.forEach(function(alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    // Add fade effect before closing
                    alert.style.transition = 'opacity 0.5s ease-out';
                    alert.style.opacity = '0.7';
                    setTimeout(() => bsAlert.close(), 500);
                });
            }, 7000);
            
            // Add active state to current navigation item
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
            navLinks.forEach(function(link) {
                if (link.getAttribute('href') === currentPath) {
                    link.classList.add('active');
                }
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

