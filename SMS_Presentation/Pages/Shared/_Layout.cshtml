<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PDXSMS</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- PDXSMS Site CSS with Official Branding -->
    <link href="~/css/site.css" rel="stylesheet">
    
    <!-- PDXSMS-Specific Enhancements -->
    <style>
        /* PDXSMS Official Branding - Port of Portland Colors */
        :root {
            --pdx-primary: #212e61;        /* Official PDX Navy Blue */
            --pdx-primary-rgb: 33, 46, 97;
            --pdx-info: #006AA9;           /* Official PDX Blue */
            --pdx-info-rgb: 0, 106, 169;
            --pdx-success: #198754;
            --pdx-warning: #ffc107;
            --pdx-danger: #dc3545;
            --pdx-light: #f8f9fa;
            --pdx-dark: #212529;
        }
        
        /* Override Bootstrap with PDX Colors */
        .bg-primary { background-color: var(--pdx-primary) !important; }
        .text-primary { color: var(--pdx-primary) !important; }
        .border-primary { border-color: var(--pdx-primary) !important; }
        
        /* PDXSMS Navigation Enhancements */
        .navbar-brand {
            font-weight: 700;
            font-size: 1.6rem;
            letter-spacing: 0.5px;
        }
        
        .navbar-brand i {
            color: #ffd700; /* Gold accent for shield icon */
        }
        
        .user-badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
            font-weight: 600;
        }
        
        /* Enhanced Card Styling for PDX */
        .card {
            border: 1px solid rgba(33, 46, 97, 0.125);
            box-shadow: 0 0.125rem 0.25rem rgba(33, 46, 97, 0.075);
        }
        
        .card-header {
            background-color: rgba(33, 46, 97, 0.03);
            border-bottom: 1px solid rgba(33, 46, 97, 0.125);
            font-weight: 600;
        }
        
        /* PDXSMS-specific Components */
        .pdx-sidebar {
            background: linear-gradient(135deg, var(--pdx-light) 0%, #ffffff 100%);
            min-height: calc(100vh - 56px);
            border-right: 2px solid rgba(33, 46, 97, 0.1);
        }
        
        .pdx-main-content {
            padding: 1.5rem;
            background-color: #fafbfc;
        }
        
        /* Alert Customizations for PDX */
        .alert {
            border: none;
            border-left: 4px solid;
            border-radius: 0.375rem;
        }
        
        .alert-success { border-left-color: var(--pdx-success); }
        .alert-danger { border-left-color: var(--pdx-danger); }
        .alert-warning { border-left-color: var(--pdx-warning); }
        .alert-info { border-left-color: var(--pdx-info); }
        
        /* Footer Styling */
        .pdx-footer {
            background: linear-gradient(135deg, var(--pdx-primary) 0%, #1a2555 100%);
            color: white;
            margin-top: auto;
        }
        
        .pdx-footer small {
            opacity: 0.9;
        }
        
        /* Dropdown Menu Enhancements */
        .dropdown-menu {
            border: 1px solid rgba(33, 46, 97, 0.15);
            box-shadow: 0 0.5rem 1rem rgba(33, 46, 97, 0.175);
        }
        
        .dropdown-item:hover {
            background-color: rgba(33, 46, 97, 0.05);
            color: var(--pdx-primary);
        }
        
        /* Button Enhancements */
        .btn-outline-primary {
            color: var(--pdx-primary);
            border-color: var(--pdx-primary);
        }
        
        .btn-outline-primary:hover {
            background-color: var(--pdx-primary);
            border-color: var(--pdx-primary);
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        // SMS Backend Integration - Fixed Session Access with Debug Logging
        var smsUserId = Context.Session.GetString("SMS_UserId");
        var smsUserType = Context.Session.GetString("SMS_UserType");
        var smsEmail = Context.Session.GetString("SMS_Email");
        var smsDisplayName = Context.Session.GetString("SMS_DisplayName");
        var smsFirstName = Context.Session.GetString("SMS_FirstName");
        var smsLastName = Context.Session.GetString("SMS_LastName");
        
        // Debug: Log session values in development
        if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
        {
            var logger = Context.RequestServices.GetService<ILogger<object>>();
            logger?.LogDebug("Layout Debug - Session Values: UserId={UserId}, UserType='{UserType}' (length={Length}), Email={Email}", 
                smsUserId ?? "NULL", smsUserType ?? "NULL", smsUserType?.Length ?? 0, smsEmail ?? "NULL");
        }
        
        // User type specific session data
        var smsApplicationRole = Context.Session.GetString("SMS_ApplicationRole");
        var smsPermissionLevel = Context.Session.GetString("SMS_PermissionLevel");
        var smsDepartment = Context.Session.GetString("SMS_Department");
        var smsPosition = Context.Session.GetString("SMS_Position");
        var smsOrganizationLevel = Context.Session.GetString("SMS_OrganizationLevel");
        var smsOrganization = Context.Session.GetString("SMS_Organization");
        var smsStakeholderType = Context.Session.GetString("SMS_StakeholderType");
        var smsAccessLevel = Context.Session.GetString("SMS_AccessLevel");
        
        var isAuthenticated = !string.IsNullOrEmpty(smsUserId);
        
        // SMS User Type Permissions (Fixed - using correct session keys with null safety)
        var isApplication = !string.IsNullOrEmpty(smsUserType) && smsUserType == "APPLICATION";
        var isOrganizational = !string.IsNullOrEmpty(smsUserType) && smsUserType == "ORGANIZATIONAL";  
        var isStakeholder = !string.IsNullOrEmpty(smsUserType) && smsUserType == "STAKEHOLDER";
        
        // Permission level checks (fixed for each user type with null safety)
        var isSuperAdmin = isApplication && !string.IsNullOrEmpty(smsApplicationRole) && smsApplicationRole == "SuperAdmin";
        var isAdmin = isApplication && !string.IsNullOrEmpty(smsApplicationRole) && (smsApplicationRole == "Admin" || smsApplicationRole == "SuperAdmin");
        var hasWriteAccess = (isOrganizational && !string.IsNullOrEmpty(smsOrganizationLevel) && smsOrganizationLevel == "Manager") || 
                            (isStakeholder && !string.IsNullOrEmpty(smsAccessLevel) && smsAccessLevel == "Write") ||
                            isAdmin;
        var hasReadAccess = isAuthenticated; // All authenticated users have read access
        
        // Display values (fixed with comprehensive error handling)
        var displayName = smsDisplayName;
        if (string.IsNullOrEmpty(displayName)) 
        {
            var firstName = smsFirstName ?? "";
            var lastName = smsLastName ?? "";
            displayName = $"{firstName} {lastName}".Trim();
            
            if (string.IsNullOrEmpty(displayName)) 
            {
                displayName = smsEmail ?? "User";
            }
        }
        
        // Defensive programming: Handle any unexpected userType values
        var userTypeDisplay = "User";
        try
        {
            userTypeDisplay = smsUserType switch {
                "APPLICATION" => "System Administrator",
                "ORGANIZATIONAL" => "Safety Manager", 
                "STAKEHOLDER" => "Stakeholder",
                null => "Guest",
                _ => $"Unknown ({smsUserType})"
            };
        }
        catch (Exception ex)
        {
            if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
            {
                var logger = Context.RequestServices.GetService<ILogger<object>>();
                logger?.LogError(ex, "Error in userTypeDisplay switch for value: '{UserType}'", smsUserType);
            }
            userTypeDisplay = "Error";
        }
        
        var permissionDisplay = "Unknown";
        try
        {
            if (isApplication)
            {
                permissionDisplay = smsApplicationRole switch {
                    "SuperAdmin" => "Super Administrator",
                    "Admin" => "Administrator",
                    null => "Application User",
                    _ => $"Application ({smsApplicationRole})"
                };
            }
            else if (isOrganizational)
            {
                permissionDisplay = smsOrganizationLevel switch {
                    "Manager" => "Manager",
                    "Officer" => "Officer",
                    null => smsPosition ?? "Staff",
                    _ => smsOrganizationLevel
                };
            }
            else if (isStakeholder)
            {
                permissionDisplay = smsAccessLevel switch {
                    "Write" => "Write Access",
                    "Read" => "Read Access",
                    null => smsStakeholderType ?? "Stakeholder",
                    _ => smsAccessLevel
                };
            }
        }
        catch (Exception ex)
        {
            if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
            {
                var logger = Context.RequestServices.GetService<ILogger<object>>();
                logger?.LogError(ex, "Error in permissionDisplay logic");
            }
            permissionDisplay = "Error";
        }
    }
    
    <header>
        <!-- PDXSMS Navigation -->
