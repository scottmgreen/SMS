                    </ul>
                    
                    <!-- User Information -->
                    <ul class="navbar-nav">
                        @if (isAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-user-circle me-2"></i>
                                        <div class="d-none d-md-block me-2">
                                            <div class="fw-semibold">@displayName</div>
                                        </div>
                                        <span class="badge user-badge @(isApplication ? "bg-info" : isOrganizational ? "bg-success" : "bg-warning text-dark")">
                                            @permissionDisplay
                                        </span>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><h6 class="dropdown-header">@displayName</h6></li>
                                    <li class="dropdown-item-text">
                                        <small class="text-muted">
                                            <strong>Type:</strong> @userTypeDisplay<br>
                                            <strong>Level:</strong> @permissionDisplay
                                            @if (!string.IsNullOrEmpty(smsDepartment))
                                            {
                                                <br><strong>Dept:</strong> @smsDepartment
                                            }
                                            @if (!string.IsNullOrEmpty(smsOrganization))
                                            {
                                                <br><strong>Org:</strong> @smsOrganization
                                            }
                                            @if (!string.IsNullOrEmpty(smsPosition))
                                            {
                                                <br><strong>Position:</strong> @smsPosition
                                            }
                                        </small>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Account/Profile">
                                        <i class="fas fa-user-edit me-2"></i>Profile Settings
                                    </a></li>
                                    <li><a class="dropdown-item" href="/Account/ChangePassword">
                                        <i class="fas fa-lock me-2"></i>Change Password
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="/Account/Logout">
