@page
@model IndexModel
@{
    ViewData["Title"] = "PDXSMS Dashboard";
    var isAuthenticated = HttpContext.Session.GetString("UserId") != null;
    var userName = HttpContext.Session.GetString("UserName") ?? "Guest User";
    var userRole = HttpContext.Session.GetString("UserRole") ?? "Guest";
}

@if (!isAuthenticated)
{
    <style>
        body{
            background-image: url('/images/background_opening.jpg');
            background-size: cover, cover;
            background-position: center center, center center;
            background-repeat: no-repeat, no-repeat;
            background-attachment: fixed, fixed;
            min-height: 100vh;
            position: relative;
        }
        /* ONLY button centering and footer positioning - DO NOT touch background! */
        .button-center-container {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
        }

        
    </style>

    <!-- Not authenticated - show only the centered Access System button -->
    @* <div class="button-center-container">
        <div class="text-center">
            <a href="/Account/Login" class="btn btn-primary btn-lg px-5">
                <i class="fas fa-sign-in-alt"></i> Access System
            </a>
        </div>
    </div> *@
}
else
{
    <!-- Authenticated user - show full dashboard (no background image) -->
    <div class="container-fluid">
        <!-- Welcome Message -->
       @*  @if (TempData["SuccessMessage"] != null)
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            </div>
        } *@

        <!-- SMS Header -->
       @*  <div class="row mb-4">
            <div class="col-12">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col">
                                <h2 class="card-title mb-1">
                                    <i class="fas fa-shield-alt"></i> PDX Safety Management System (PDXSMS)
                                </h2>
                                <p class="card-text mb-0">
                                    Welcome back, <strong>@userName</strong> | Role: @userRole
                                </p>
                            </div>
                            <div class="col-auto">
                                <div class="text-end">
                                    <small class="text-light opacity-75">
                                        <i class="fas fa-clock"></i> @DateTime.Now.ToString("MMM dd, yyyy HH:mm")
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div> *@

        <!-- Quick Stats Dashboard -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center border-danger">
                    <div class="card-body">
                        <h5 class="card-title text-danger">Active Hazards</h5>
                        <h5 class="display-7">@Model.DashboardStats.ActiveHazards</h5>
                        <p class="card-text">Requiring attention</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center border-warning">
                    <div class="card-body">
                        <h5 class="card-title text-warning">Pending Reviews</h5>
                        <h5 class="display-7">@Model.DashboardStats.PendingReviews</h5>
                        <p class="card-text">Awaiting processing</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center border-info">
                    <div class="card-body">
                        <h5 class="card-title text-info">Active Audits</h5>
                        <h5 class="display-7">@Model.DashboardStats.ActiveAudits</h5>
                        <p class="card-text">In progress</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center border-success">
                    <div class="card-body">
                        <h5 class="card-title text-success">Mitigations</h5>
                        <h5 class="display-7">@Model.DashboardStats.MitigationsUnderImplementation</h5>
                        <p class="card-text">Under implementation</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        @* <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-bolt"></i> Quick Actions
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3 mb-2">
                                <a href="/SafetyRiskManagement/HazardReporting" class="btn btn-outline-danger w-100">
                                    <i class="fas fa-plus-circle"></i><br>
                                    <small>Submit Hazard Report</small>
                                </a>
                            </div>
                            <div class="col-md-3 mb-2">
                                <a href="/SafetyRiskManagement/RiskAssessment" class="btn btn-outline-warning w-100">
                                    <i class="fas fa-clipboard-list"></i><br>
                                    <small>Risk Assessment</small>
                                </a>
                            </div>
                            <div class="col-md-3 mb-2">
                                <a href="/SafetyAssurance/SafetyAssuranceReporting" class="btn btn-outline-info w-100">
                                    <i class="fas fa-chart-pie"></i><br>
                                    <small>Safety Reports</small>
                                </a>
                            </div>
                            <div class="col-md-3 mb-2">
                                <a href="/System/UserManagement" class="btn btn-outline-secondary w-100">
                                    <i class="fas fa-users"></i><br>
                                    <small>User Management</small>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div> *@

        <!-- Recent Activity -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4><i class="fas fa-clock"></i> Recent Activity</h4>
                        <small class="text-muted">(@Model.DashboardStats.RecentActivityCount recent items)</small>
                    </div>
                    <div class="card-body">
                        @if (Model.DashboardStats.RecentActivityCount > 0)
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i>
                                <strong>Activity Detected:</strong> There are @Model.DashboardStats.RecentActivityCount recent activities in the system.
                                <br><small>Note: Detailed activity log display is under development. Check specific modules for latest updates.</small>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light">
                                <i class="fas fa-info-circle"></i>
                                <strong>No Recent Activity:</strong> No recent activities recorded in the system.
                                <br><small>This indicates a clean slate testing environment with no mock data.</small>
                            </div>
                        }
                        
                        <div class="mt-3">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="text-center">
                                        <a href="/SafetyRiskManagement/HazardReporting" class="btn btn-outline-primary">
                                            <i class="fas fa-plus-circle"></i><br>
                                            <small>Submit New Hazard Report</small>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="text-center">
                                        <a href="/SafetyRiskManagement/HazardProcessing" class="btn btn-outline-info">
                                            <i class="fas fa-tasks"></i><br>
                                            <small>View Hazard Processing</small>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="text-center">
                                        <a href="/SafetyRiskManagement/RiskAssessment" class="btn btn-outline-success">
                                            <i class="fas fa-clipboard-list"></i><br>
                                            <small>Risk Assessment</small>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="btn-group" role="group">
                            <a href="/SafetyRiskManagement/HazardProcessing" class="btn btn-outline-primary">
                                <i class="fas fa-chart-bar"></i> View All Activities
                            </a>
                            <button type="button" class="btn btn-outline-info">
                                <i class="fas fa-download"></i> Export Data
                            </button>
                            <a href="/System/SystemStatus" class="btn btn-outline-secondary">
                                <i class="fas fa-chart-pie"></i> System Status
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
