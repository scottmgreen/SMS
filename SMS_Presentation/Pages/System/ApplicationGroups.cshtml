@page
@model SMS_Presentation.Pages.System.ApplicationGroupsModel
@{
    ViewData["Title"] = "Application Group Management";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/System">System Administration</a></li>
                    <li class="breadcrumb-item"><a href="/System/UserManagement">User Management</a></li>
                    <li class="breadcrumb-item active">Application Groups</li>
                </ol>
            </nav>
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="card-title"><i class="fas fa-users-cog"></i> Application Group Management</h1>
                            <p class="card-text">Manage SMS Application User Groups for Organizational Structure</p>
                        </div>
                        <div>
                            <a href="/System/UserManagement" class="btn btn-dark me-2">
                                <i class="fas fa-arrow-left"></i> Back to Dashboard
                            </a>
                            @if (!Model.IsEditMode)
                            {
                                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createGroupModal">
                                    <i class="fas fa-plus"></i> Add Group
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Edit Group Form -->
    @if (Model.IsEditMode && Model.CurrentGroup != null)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-warning">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="fas fa-edit"></i> Edit Group: @Model.CurrentGroup.Name</h5>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="Update">
                            <input type="hidden" name="groupCode" value="@Model.CurrentGroup.Code" />
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="editGroupName" class="form-label">Group Name <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="editGroupName" name="groupName" value="@Model.CurrentGroup.Name" required>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="editIsActive" class="form-label">Status</label>
                                        <select class="form-select" id="editIsActive" name="isActive">
                                            <option value="true" selected="@Model.CurrentGroup.IsActive">Active</option>
                                            <option value="false" selected="@(!Model.CurrentGroup.IsActive)">Inactive</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="editDescription" class="form-label">Description</label>
                                <textarea class="form-control" id="editDescription" name="description" rows="3">@Model.CurrentGroup.Description</textarea>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-warning">
                                    <i class="fas fa-save"></i> Update Group
                                </button>
                                <a href="/System/ApplicationGroups" class="btn btn-secondary">
                                    <i class="fas fa-times"></i> Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Groups Display -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-list"></i> Application Groups (@Model.ApplicationGroups.Count())</h5>
                        <div>
                            <button type="button" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-download"></i> Export
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.ApplicationGroups.Any())
                    {
                        <div class="row">
                            @foreach (var group in Model.ApplicationGroups)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card border-warning h-100 @(group.Code == Model.CurrentGroup?.Code ? "bg-warning bg-opacity-10" : "")">
                                        <div class="card-header bg-light">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h6 class="mb-0">
                                                    <i class="fas fa-users-cog text-warning"></i> @group.Name
                                                </h6>
                                                <span class="badge bg-@(group.IsActive ? "success" : "secondary")">
                                                    @(group.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            <p class="card-text small">
                                                @if (!string.IsNullOrEmpty(group.Description))
                                                {
                                                    @group.Description
                                                }
                                                else
                                                {
                                                    <em class="text-muted">No description provided</em>
                                                }
                                            </p>
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <small class="text-muted">
                                                    Code: @group.Code
                                                </small>
                                            </div>
                                            <div class="mb-2">
                                                <small class="text-muted">
                                                    Created: @group.CreatedDate.Value.ToString("MM/dd/yyyy") by @group.CreatedBy
                                                </small>
                                            </div>
                                            @if (group.CreatedDate.HasValue)
                                            {
                                                <div class="mb-2">
                                                    <small class="text-muted">
                                                        Modified: @group.CreatedDate.Value.ToString("MM/dd/yyyy") by @group.CreatedDate
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                        <div class="card-footer bg-light">
                                            <div class="btn-group w-100">
                                                <a href="/System/ApplicationGroups/Edit/@group.Code" class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <button type="button" class="btn btn-outline-info btn-sm" title="Manage Members">
                                                    <i class="fas fa-users"></i> Members
                                                </button>
                                                <button type="button" class="btn btn-outline-danger btn-sm" 
                                                        onclick="confirmDelete('@group.Code', '@group.Name')" title="Delete Group">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-users-cog fa-3x text-muted"></i>
                            <h5 class="mt-3 text-muted">No Application Groups Found</h5>
                            <p class="text-muted">Click "Add Group" to create your first application group.</p>
                            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#createGroupModal">
                                <i class="fas fa-plus"></i> Add First Group
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Group Modal -->
<div class="modal fade" id="createGroupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus"></i> Create Application Group</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="groupName" class="form-label">Group Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="groupName" name="groupName" required 
                               placeholder="Enter group name (e.g., IT Administrators, Safety Team)">
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="description" rows="3"
                                  placeholder="Optional description of the group's purpose or responsibilities"></textarea>
                    </div>
                    <div class="alert alert-info">
                        <small>
                            <i class="fas fa-info-circle"></i> 
                            Application groups help organize internal users by department or function. 
                            Groups can be used for access control and notifications.
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-save"></i> Create Group
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-trash"></i> Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the group <strong id="deleteGroupName"></strong>?</p>
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i> This action cannot be undone and may affect users assigned to this group.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete" style="display: inline;">
                    <input type="hidden" id="deleteGroupCode" name="groupCode" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Delete Group
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
function confirmDelete(groupCode, groupName) {
    document.getElementById('deleteGroupCode').value = groupCode;
    document.getElementById('deleteGroupName').textContent = groupName;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}
</script>

<style>
.card {
    transition: transform 0.2s ease-in-out;
}

.card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.badge {
    font-size: 0.75em;
}
</style>