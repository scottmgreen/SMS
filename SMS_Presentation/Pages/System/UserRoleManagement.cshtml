@page "/System/UserRoleManagement/"
@model SMS_Presentation.Pages.System.UserRoleManagementModel
@{
    ViewData["Title"] = "User Role Definition Management";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/System">System Administration</a></li>
                    <li class="breadcrumb-item"><a href="/System/UserManagement">User Management</a></li>
                    <li class="breadcrumb-item active">Role Definition Management</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="card-title"><i class="fas fa-cog"></i> User Role Definition Management</h1>
                            <p class="card-text">Define and manage SMS user role templates with module-level permissions</p>
                        </div>
                        <div>
                            <a href="/System/UserManagement" class="btn btn-light me-2">
                                <i class="fas fa-arrow-left"></i> Back to User Management
                            </a>
                            <button type="button" class="btn btn-warning" onclick="showCreateForm()">
                                <i class="fas fa-plus"></i> Create Role
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Create/Edit Role Form -->
    <div class="row mb-4" id="roleForm" style="display: @(Model.IsEditMode ? "block" : "none")">
        <div class="col-12">
            <div class="card border-@(Model.IsEditMode ? "warning" : "success")">
                <div class="card-header bg-@(Model.IsEditMode ? "warning" : "success") text-@(Model.IsEditMode ? "dark" : "white")">
                    <h5 class="mb-0">
                        <i class="fas fa-@(Model.IsEditMode ? "edit" : "plus")"></i> 
                        @(Model.IsEditMode ? $"Edit Role: {Model.CurrentRole?.Name}" : "Create New Role")
                    </h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="@(Model.IsEditMode ? "Update" : "Create")">
                        @if (Model.IsEditMode)
                        {
                            <input type="hidden" name="roleCode" value="@Model.CurrentRole?.Code" />
                        }
                        
                        <div class="mb-4">
                            <label for="roleName" class="form-label">Role Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="roleName" name="roleName" 
                                   value="@(Model.CurrentRole?.Name ?? "")" required
                                   placeholder="Enter descriptive role name (e.g., Safety Manager, Report Viewer)">
                        </div>

                        <!-- Permission Matrix -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6><i class="fas fa-shield-alt"></i> Module Permissions</h6>
                                <div>
                                    <button type="button" class="btn btn-primary btn-sm" onclick="toggleAllPermissions(true)">
                                        <i class="fas fa-check-double"></i> Select All
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleAllPermissions(false)">
                                        <i class="fas fa-times"></i> Clear All
                                    </button>
                                </div>
                            </div>
                            
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th width="30%" class="align-middle">SMS Module</th>
                                            <th width="15%" class="text-center">
                                                <i class="fas fa-plus text-success"></i><br>Create
                                            </th>
                                            <th width="15%" class="text-center">
                                                <i class="fas fa-eye text-primary"></i><br>Read
                                            </th>
                                            <th width="15%" class="text-center">
                                                <i class="fas fa-edit text-warning"></i><br>Update
                                            </th>
                                            <th width="15%" class="text-center">
                                                <i class="fas fa-trash text-danger"></i><br>Delete
                                            </th>
                                            <th width="10%" class="text-center">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var module in SMS_Presentation.Pages.System.UserRoleManagementModel.SMSModules)
                                        {
                                            <tr>
                                                <td class="align-middle">
                                                    <strong>@module</strong>
                                                    <br><small class="text-muted">@module.Replace("SMS_", "").Replace("_", " ")</small>
                                                </td>
                                                <td class="text-center">
                                                    <div class="form-check d-flex justify-content-center">
                                                        <input class="form-check-input permission-checkbox create-permission" 
                                                               type="checkbox" 
                                                               name="createPermissions[@module]" 
                                                               value="true" 
                                                               data-module="@module"
                                                               checked="@Model.GetPermissionValue(module, "create")"
                                                               id="create_@module.Replace("_", "")">
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="form-check d-flex justify-content-center">
                                                        <input class="form-check-input permission-checkbox read-permission" 
                                                               type="checkbox" 
                                                               name="readPermissions[@module]" 
                                                               value="true" 
                                                               data-module="@module"
                                                               checked="@Model.GetPermissionValue(module, "read")"
                                                               id="read_@module.Replace("_", "")">
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="form-check d-flex justify-content-center">
                                                        <input class="form-check-input permission-checkbox update-permission" 
                                                               type="checkbox" 
                                                               name="updatePermissions[@module]" 
                                                               value="true" 
                                                               data-module="@module"
                                                               checked="@Model.GetPermissionValue(module, "update")"
                                                               id="update_@module.Replace("_", "")">
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="form-check d-flex justify-content-center">
                                                        <input class="form-check-input permission-checkbox delete-permission" 
                                                               type="checkbox" 
                                                               name="deletePermissions[@module]" 
                                                               value="true" 
                                                               data-module="@module"
                                                               checked="@Model.GetPermissionValue(module, "delete")"
                                                               id="delete_@module.Replace("_", "")">
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="button" class="btn btn-outline-success btn-sm" 
                                                                onclick="toggleModulePermissions('@module', true)"
                                                                title="Grant All">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm" 
                                                                onclick="toggleModulePermissions('@module', false)"
                                                                title="Deny All">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-@(Model.IsEditMode ? "warning" : "success")">
                                <i class="fas fa-save"></i> @(Model.IsEditMode ? "Update Role" : "Create Role")
                            </button>
                            <button type="button" class="btn btn-secondary" onclick="hideForm()">
                                <i class="fas fa-times"></i> Cancel
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Roles Table -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-list"></i> Role Definitions (@Model.UserRoles.Count())</h5>
                        <div>
                            <button type="button" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-download"></i> Export
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.UserRoles.Any())
                    {
                        <div class="accordion" id="rolesAccordion">
                            @{
                                var roleIndex = 0;
                            }
                            @foreach (var role in Model.UserRoles)
                            {
                                var totalPermissions = role.Permissions?.Sum(p => (p.Create ? 1 : 0) + (p.Read ? 1 : 0) + (p.Update ? 1 : 0) + (p.Delete ? 1 : 0)) ?? 0;
                                var maxPermissions = SMS_Presentation.Pages.System.UserRoleManagementModel.SMSModules.Length * 4;
                                var collapseId = $"collapse{roleIndex}";
                                var headingId = $"heading{roleIndex}";

                                <div class="accordion-item @(role.Code == Model.CurrentRole?.Code ? "border-warning" : "")">
                                    <h2 class="accordion-header" id="@headingId">
                                        <button class="accordion-button @(role.Code == Model.CurrentRole?.Code ? "bg-warning" : "") collapsed" type="button" 
                                                data-bs-toggle="collapse" data-bs-target="#@collapseId" 
                                                aria-expanded="false" aria-controls="@collapseId">
                                            <div class="d-flex w-100 justify-content-between align-items-center me-3">
                                                <div class="flex-grow-1">
                                                    <div class="d-flex align-items-center">
                                                        <div>
                                                            <strong class="fs-6">@role.Name</strong>
                                                            <br><small class="text-muted">Code: @role.Code</small>
                                                        </div>
                                                        <div class="ms-3">
                                                            <div class="d-flex align-items-center">
                                                                <div class="progress me-2" style="width: 100px; height: 18px;">
                                                                    <div class="progress-bar bg-@(totalPermissions > maxPermissions * 0.7 ? "success" : totalPermissions > maxPermissions * 0.3 ? "warning" : "danger")" 
                                                                         style="width: @((double)totalPermissions / maxPermissions * 100)%"></div>
                                                                </div>
                                                                <small class="text-muted">@totalPermissions/@maxPermissions permissions</small>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @if (role.CreatedDate != null)
                                                    {
                                                        <small class="text-muted">Created: @role.CreatedDate?.ToString("MM/dd/yyyy") by @(role.CreatedBy ?? "System")</small>
                                                    }
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    @if (role.Permissions?.Any() == true)
                                                    {
                                                        var moduleGroups = role.Permissions
                                                            .Where(p => p.Create || p.Read || p.Update || p.Delete)
                                                            .GroupBy(p => p.SMSModule)
                                                            .Take(3);
                                                        
                                                        <div class="me-3">
                                                            @foreach (var group in moduleGroups)
                                                            {
                                                                <span class="badge bg-info me-1">@group.Key?.Replace("SMS_", "")</span>
                                                            }
                                                            @if (role.Permissions.GroupBy(p => p.SMSModule).Count() > 3)
                                                            {
                                                                <span class="badge bg-secondary">+@(role.Permissions.GroupBy(p => p.SMSModule).Count() - 3)</span>
                                                            }
                                                        </div>
                                                    }
                                                    <div class="btn-group btn-group-sm" onclick="event.stopPropagation();">
                                                        <button type="button" class="btn btn-outline-warning btn-sm" 
                                                                onclick="editRole('@role.Code')" 
                                                                title="Edit Role">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-danger btn-sm" 
                                                                onclick="confirmDelete('@role.Code', '@role.Name')" 
                                                                title="Delete Role">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </button>
                                    </h2>
                                    <div id="@collapseId" class="accordion-collapse collapse" 
                                         aria-labelledby="@headingId" data-bs-parent="#rolesAccordion">
                                        <div class="accordion-body">
                                            @if (role.Permissions?.Any() == true)
                                            {
                                                <div class="row">
                                                    <div class="col-12">
                                                        <h6 class="mb-3"><i class="fas fa-shield-alt text-primary"></i> Module Permissions Detail</h6>
                                                        <div class="table-responsive">
                                                            <table class="table table-sm table-bordered">
                                                                <thead class="table-light">
                                                                    <tr>
                                                                        <th width="30%">SMS Module</th>
                                                                        <th width="17.5%" class="text-center">
                                                                            <i class="fas fa-plus text-success"></i> Create
                                                                        </th>
                                                                        <th width="17.5%" class="text-center">
                                                                            <i class="fas fa-eye text-primary"></i> Read
                                                                        </th>
                                                                        <th width="17.5%" class="text-center">
                                                                            <i class="fas fa-edit text-warning"></i> Update
                                                                        </th>
                                                                        <th width="17.5%" class="text-center">
                                                                            <i class="fas fa-trash text-danger"></i> Delete
                                                                        </th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var module in SMS_Presentation.Pages.System.UserRoleManagementModel.SMSModules)
                                                                    {
                                                                        var permission = role.Permissions?.FirstOrDefault(p => p.SMSModule == module);
                                                                        
                                                                        <tr>
                                                                            <td class="align-middle">
                                                                                <strong>@module</strong>
                                                                                <br><small class="text-muted">@module.Replace("SMS_", "").Replace("_", " ")</small>
                                                                            </td>
                                                                            <td class="text-center align-middle">
                                                                                @if (permission?.Create == true)
                                                                                {
                                                                                    <i class="fas fa-check-circle text-success"></i>
                                                                                    <small class="text-success d-block">Granted</small>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <i class="fas fa-times-circle text-muted"></i>
                                                                                    <small class="text-muted d-block">Denied</small>
                                                                                }
                                                                            </td>
                                                                            <td class="text-center align-middle">
                                                                                @if (permission?.Read == true)
                                                                                {
                                                                                    <i class="fas fa-check-circle text-success"></i>
                                                                                    <small class="text-success d-block">Granted</small>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <i class="fas fa-times-circle text-muted"></i>
                                                                                    <small class="text-muted d-block">Denied</small>
                                                                                }
                                                                            </td>
                                                                            <td class="text-center align-middle">
                                                                                @if (permission?.Update == true)
                                                                                {
                                                                                    <i class="fas fa-check-circle text-success"></i>
                                                                                    <small class="text-success d-block">Granted</small>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <i class="fas fa-times-circle text-muted"></i>
                                                                                    <small class="text-muted d-block">Denied</small>
                                                                                }
                                                                            </td>
                                                                            <td class="text-center align-middle">
                                                                                @if (permission?.Delete == true)
                                                                                {
                                                                                    <i class="fas fa-check-circle text-success"></i>
                                                                                    <small class="text-success d-block">Granted</small>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <i class="fas fa-times-circle text-muted"></i>
                                                                                    <small class="text-muted d-block">Denied</small>
                                                                                }
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                        <div class="mt-3 d-flex justify-content-between align-items-center">
                                                            <div>
                                                                <small class="text-muted">
                                                                    <i class="fas fa-info-circle"></i> 
                                                                    Total: @totalPermissions of @maxPermissions possible permissions granted
                                                                </small>
                                                            </div>
                                                            <div>
                                                                <button type="button" class="btn btn-warning btn-sm" 
                                                                        onclick="editRole('@role.Code')">
                                                                    <i class="fas fa-edit"></i> Edit Permissions
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-center text-muted py-3">
                                                    <i class="fas fa-exclamation-triangle fa-2x mb-2"></i>
                                                    <h6>No Permissions Defined</h6>
                                                    <p>This role has no module permissions assigned.</p>
                                                    <button type="button" class="btn btn-warning btn-sm" 
                                                            onclick="editRole('@role.Code')">
                                                        <i class="fas fa-plus"></i> Add Permissions
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                                roleIndex++;
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-cog fa-3x text-muted"></i>
                            <h5 class="mt-3 text-muted">No Role Definitions Found</h5>
                            <p class="text-muted">Click "Create Role" to define your first user role template.</p>
                            <button type="button" class="btn btn-success" onclick="showCreateForm()">
                                <i class="fas fa-plus"></i> Create First Role
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-trash"></i> Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the role definition <strong id="deleteRoleName"></strong>?</p>
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i> This action cannot be undone and may affect existing user role assignments.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete" style="display: inline;">
                    <input type="hidden" id="deleteRoleCode" name="roleCode" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Delete Role
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
// Form visibility management
function showCreateForm() {
    document.getElementById('roleForm').style.display = 'block';
    document.getElementById('roleName').value = '';
    document.querySelectorAll('.permission-checkbox').forEach(cb => cb.checked = false);
    document.getElementById('roleName').focus();
}

function hideForm() {
    document.getElementById('roleForm').style.display = 'none';
    // Clear any edit mode by redirecting to clean page
    window.location.href = '/System/UserRoleManagement/';
}

function editRole(roleCode) {
    window.location.href = `/System/UserRoleManagement/?code=${roleCode}`;
}

// Permission management functions
function toggleModulePermissions(module, enable) {
    const moduleClean = module.replace(/_/g, '');
    const permissions = ['create', 'read', 'update', 'delete'];
    permissions.forEach(perm => {
        const checkbox = document.getElementById(`${perm}_${moduleClean}`);
        if (checkbox) checkbox.checked = enable;
    });
}

function toggleAllPermissions(enable) {
    document.querySelectorAll('.permission-checkbox').forEach(checkbox => {
        checkbox.checked = enable;
    });
}

// Modal functions
function confirmDelete(roleCode, roleName) {
    document.getElementById('deleteRoleCode').value = roleCode;
    document.getElementById('deleteRoleName').textContent = roleName;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}

function viewPermissions(roleCode, roleName) {
    alert(`Viewing detailed permissions for: ${roleName}\nCode: ${roleCode}\n\nThis could open a detailed permissions viewer modal.`);
}

// Auto-show form if in edit mode
document.addEventListener('DOMContentLoaded', function() {
    @if (Model.IsEditMode)
    {
        <text>
        document.getElementById('roleForm').style.display = 'block';
        </text>
    }
});
</script>

<style>
.table td {
    vertical-align: middle;
}

.form-check {
    margin-bottom: 0;
}

.progress {
    height: 10px;
}

.badge {
    font-size: 0.75em;
}

.permission-checkbox {
    transform: scale(1.2);
}

.btn-group-sm > .btn {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
}

.table-responsive {
    border-radius: 0.5rem;
}

/* Accordion Styling */
.accordion-item {
    border: 1px solid #dee2e6 !important;
    margin-bottom: 0.5rem;
    border-radius: 0.5rem !important;
    overflow: hidden;
}

.accordion-button {
    border-radius: 0.5rem !important;
    font-weight: 500;
    padding: 1rem 1.25rem;
}

.accordion-button:not(.collapsed) {
    color: #0c63e4;
    background-color: #e7f1ff;
    border-color: #86b7fe;
}

.accordion-button:focus {
    z-index: 3;
    border-color: #86b7fe;
    outline: 0;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
}

.accordion-button::after {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin-left: auto;
    content: "";
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='currentColor'%3e%3cpath fill-rule='evenodd' d='M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-size: 1.25rem;
    transition: transform 0.2s ease-in-out;
}

.accordion-button:not(.collapsed)::after {
    transform: rotate(-180deg);
}

.accordion-body {
    padding: 1.25rem;
    background-color: #f8f9fa;
}

/* Role highlight styling */
.accordion-item.border-warning {
    border-color: #ffc107 !important;
    box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
}

.accordion-item.border-warning .accordion-button {
    background-color: rgba(255, 193, 7, 0.1);
    border-color: #ffc107;
}

/* Permission table styling */
.table-sm th,
.table-sm td {
    padding: 0.5rem;
}

.table-bordered th,
.table-bordered td {
    border: 1px solid #dee2e6;
}

.table-light th {
    background-color: #e9ecef;
    border-color: #dee2e6;
    font-weight: 600;
}

/* Button group styling to prevent accordion collapse when clicked */
.btn-group {
    position: relative;
    z-index: 10;
}

/* Progress bar in accordion header */
.accordion-button .progress {
    height: 18px;
}

/* Badge styling in accordion header */
.accordion-button .badge {
    font-size: 0.7em;
    font-weight: 500;
}
</style></style>