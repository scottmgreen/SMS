<!-- Manage Groups Modal -->
<div class="modal fade" id="manageGroupsModal" tabindex="-1" aria-labelledby="manageGroupsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="manageGroupsModalLabel">
                    <i class="fas fa-users me-2"></i>Manage Stakeholder Groups
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- User Info Display -->
                <div class="alert alert-info">
                    <i class="fas fa-user me-2"></i>
                    <strong>Managing groups for:</strong> 
                    <span id="manageGroupsUserName">Select a user</span>
                    <span class="badge bg-primary ms-2" id="manageGroupsUserCode"></span>
                </div>

                <!-- Hidden input to track user code -->
                <input type="hidden" id="manageGroupsUserId">
                
                <!-- Search and Filter Controls -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input type="text" class="form-control" id="searchAvailableGroups" 
                                   placeholder="Search available groups...">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-filter"></i></span>
                            <select class="form-select" id="filterGroupStatus">
                                <option value="">All Groups</option>
                                <option value="active">Active Only</option>
                                <option value="inactive">Inactive Only</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Group Assignment Interface -->
                <div class="row">
                    <!-- Available Groups -->
                    <div class="col-md-5">
                        <div class="card h-100">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">
                                    <i class="fas fa-list me-2"></i>Available Groups 
                                    <span class="badge bg-secondary" id="availableGroupsCount">0</span>
                                </h6>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="selectAllAvailable">
                                    <label class="form-check-label small" for="selectAllAvailable">
                                        Select All
                                    </label>
                                </div>
                            </div>
                            <div class="card-body p-2">
                                <div class="available-groups-container" style="height: 350px; overflow-y: auto;">
                                    <div id="availableGroupsList">
                                        @foreach (var group in Model.ActiveStakeholderGroups)
                                        {
                                            <div class="group-item border rounded mb-2 p-2" data-group-code="@group.Code" data-group-name="@group.GroupName" data-group-status="@(group.IsActive ? "active" : "inactive")">
                                                <div class="form-check">
                                                    <input class="form-check-input available-group-checkbox" type="checkbox" 
                                                           value="@group.Code" id="available-@group.Code">
                                                    <label class="form-check-label w-100" for="available-@group.Code">
                                                        <div class="d-flex justify-content-between align-items-start">
                                                            <div class="flex-grow-1">
                                                                <strong>@group.GroupName</strong>
                                                                <div class="small text-muted">@group.Code</div>
                                                                @if (!string.IsNullOrEmpty(group.Description))
                                                                {
                                                                    <div class="small text-secondary mt-1">@group.Description</div>
                                                                }
                                                            </div>
                                                            <span class="badge bg-@(group.IsActive ? "success" : "secondary") ms-2">
                                                                @(group.IsActive ? "Active" : "Inactive")
                                                            </span>
                                                        </div>
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="col-md-2 d-flex flex-column justify-content-center align-items-center">
                        <button type="button" class="btn btn-success mb-2" id="assignSelectedGroups" disabled>
                            <i class="fas fa-arrow-right"></i><br>
                            <small>Assign</small>
                        </button>
                        <button type="button" class="btn btn-danger mb-2" id="removeSelectedGroups" disabled>
                            <i class="fas fa-arrow-left"></i><br>
                            <small>Remove</small>
                        </button>
                        <hr class="w-100">
                        <button type="button" class="btn btn-warning btn-sm" id="clearAllGroups" disabled>
                            <i class="fas fa-times me-1"></i>Clear All
                        </button>
                    </div>

                    <!-- Current Groups -->
                    <div class="col-md-5">
                        <div class="card h-100">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">
                                    <i class="fas fa-users me-2"></i>Assigned Groups 
                                    <span class="badge bg-primary" id="assignedGroupsCount">0</span>
                                </h6>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="selectAllAssigned">
                                    <label class="form-check-label small" for="selectAllAssigned">
                                        Select All
                                    </label>
                                </div>
                            </div>
                            <div class="card-body p-2">
                                <div class="current-groups-container" style="height: 350px; overflow-y: auto;">
                                    <div id="currentGroupsList">
                                        <!-- Current groups will be populated via JavaScript -->
                                        <div class="text-center text-muted py-5" id="noGroupsMessage">
                                            <i class="fas fa-users fa-2x mb-2"></i>
                                            <p>No groups assigned</p>
                                            <small>Select groups from the left to assign them to this user</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Status -->
                <div class="row mt-3">
                    <div class="col-12">
                        <div id="groupManagementStatus" class="alert alert-info" style="display: none;">
                            <i class="fas fa-info-circle me-2"></i>
                            <span id="statusMessage"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Close
                </button>
                <button type="button" class="btn btn-primary" id="refreshGroupData">
                    <i class="fas fa-sync-alt me-1"></i>Refresh
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.group-item {
    transition: all 0.2s ease;
    cursor: pointer;
}

.group-item:hover {
    background-color: #f8f9fa;
    border-color: #6c757d !important;
}

.group-item.selected {
    border-color: #0d6efd !important;
    background-color: #e3f2fd;
}

.available-groups-container::-webkit-scrollbar,
.current-groups-container::-webkit-scrollbar {
    width: 6px;
}

.available-groups-container::-webkit-scrollbar-track,
.current-groups-container::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 3px;
}

.available-groups-container::-webkit-scrollbar-thumb,
.current-groups-container::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 3px;
}

.available-groups-container::-webkit-scrollbar-thumb:hover,
.current-groups-container::-webkit-scrollbar-thumb:hover {
    background: #a8a8a8;
}
</style>