{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SMS": "Debug"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnectionString": "Data Source=LL001083;Initial Catalog=PDXSMS_V2;Integrated Security=True;Connect Timeout=30;Encrypt=False;TrustServerCertificate=True;ApplicationIntent=ReadWrite;MultiSubnetFailover=False"
  },
 
  "FeatureManagement": {
    "AuditLogEnabled": true,
    "LoggingEnabled": true,
    "DebugEnabled": true
  },

  "SMS": {
    "ApplicationName": "SMS Portal",
    "Version": "2.0.0",
    "Environment": "Development"
  },

  "Session": {
    "TimeoutMinutes": 480,
    "CookieName": "SMS.Session"
  },

  "Security": {
    "RequireHttps": false,
    "PasswordPolicy": {
      "MinLength": 8,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigits": true,
      "RequireSpecialChars": true
    }
  }
}