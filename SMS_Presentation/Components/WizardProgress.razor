@using Microsoft.AspNetCore.Components

@*
BLAZOR PROGRESS BAR COMPONENT
Replaces JavaScript-based progress tracking with server-side state management
*@

<div class="col-md-4 text-end">
    <h3 class="mb-1">Step @CurrentStep of 5</h3>
    <div class="progress bg-light">
        <div class="progress-bar @GetProgressBarClass()" style="width: @GetProgressPercentage()%">
            @GetProgressPercentage()%
        </div>
    </div>
    <small class="text-light">@CurrentStepName</small>
</div>

@code {
    [Parameter] public int CurrentStep { get; set; } = 1;
    [Parameter] public string CurrentStepName { get; set; } = "";
    
    private int GetProgressPercentage()
    {
        return (CurrentStep * 100) / 5;
    }
    
    private string GetProgressBarClass()
    {
        return CurrentStep switch
        {
            5 => "bg-success",
            >= 3 => "bg-info", 
            _ => "bg-warning"
        };
    }
}