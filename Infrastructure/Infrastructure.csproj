<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	<WarningsAsErrors />
	<WarningsNotAsErrors />
    
    <!-- Version Information -->
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyTitle>SMS Infrastructure Layer</AssemblyTitle>
    <Product>PDX Safety Management System</Product>
    <Company>Portland International Airport</Company>
    <Copyright>Copyright © 2024 Portland International Airport</Copyright>
    
	<!-- Suppress common nullable reference type warnings during migration -->
	<NoWarn>$(NoWarn);CS8618;CS8625;CS8604;CS8602;CS8600;CS8601;CS8603;CS8605;CS8607;CS8608;CS8609;CS8610;CS8611;CS8612;CS8613;CS8614;CS8615;CS8616;CS8617;CS8619;CS8620;CS8621;CS8622;CS8623;CS8624;CS8629;CS8631;CS8633;CS8634;CS8635;CS8636;CS8637;CS8638;CS8639;CS8640;CS8641;CS8642;CS8643;CS8644;CS8645;CS8646;CS8647;CS8648;CS8649;CS8653;CS8654;CS8655;CS8667;CS8670;CS8714;CS8762;CS8763;CS8764;CS8765;CS8766;CS8767;CS8768;CS8769;CS8770;CS8774;CS8775;CS8776;CS8777;CS8778;CS8794;CS8819</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Scripts\**" />
    <EmbeddedResource Remove="Scripts\**" />
    <None Remove="Scripts\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Configuration\ServiceCollectionExtensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include=" Microsoft.Extensions.Logging" />
    <Using Include="SMS_Domain.Common" />
    <Using Include="SMS_Domain.Entities" />
    <Using Include="SMS_Domain.Enums" />
    <Using Include="SMS_Domain.ValueObjects" />
    <Using Include="SMS_Infrastructure.Common" />
    <Using Include="SMS_Infrastructure.Persistence" />
    <Using Include="SMS_Infrastructure.Services" />
    <Using Include="SMS_Shared" />
    <Using Include="SMS_Shared.Common" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="System.Data" />
    <Using Include="Microsoft.Data.SqlClient" />
    <Using Include="System.Reflection" />
    <Using Include="System.Xml" />
  </ItemGroup>

</Project>
