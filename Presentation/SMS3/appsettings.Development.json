{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "SMS3": "Information",
      "SMS_Application.Services.SecurityFeatureService": "Information"
    }
  },
  "NotificationSettings": {
    "AllowErrorNotifications": true,
    "AllowSuccessNotifications": false,
    "AllowWarningNotifications": false,
    "AllowInfoNotifications": false
  },
  "SessionConfiguration": {
    "EnableDevelopmentMode": true,
    "TimeoutMinutes": 30
  },
  "FeatureManagement": {
    "AllowHttpCookies": false,
    "AllowHttpInDevelopment": true,
    "EnforceHttpsRedirection": false,
    "SwaggerEnabled": true,
    "ErrorNotifications": true,
    "SuccessNotifications": true,
    "WarningNotifications": true,
    "InfoNotifications": true
  }
}
