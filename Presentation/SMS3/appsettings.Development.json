{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Warning",

      // Suppress Microsoft framework noise
      "Microsoft.AspNetCore": "Error",
      "Microsoft.AspNetCore.Hosting": "Error",
      "Microsoft.AspNetCore.StaticFiles": "Error",
      "Microsoft.AspNetCore.Routing": "Error",
      "Microsoft.Extensions.Hosting": "Error",

      // Suppress ALL authentication noise - PERFORMANCE CRITICAL
      "SMS_Application.Services.StrategyBasedCurrentUserService": "Critical",
      "SMS_Application.Services.AuthenticationStrategyManager": "Critical",
      "SMS_Application.Services.Authentication.CircuitBasedAuthenticationStrategy": "Critical",
      "SMS_Application.Services.UserInstantiationService": "Critical",
      "SMS3.Components.Layout.NavMenu": "Critical",

      // EventBus and Workflow - The stuff we care about! 
      "SMS_Application.Services.EventBusService": "Debug",
      "SMS_Application.EventHandlers": "Information",
      "SMS_Application.Configuration.EventBusExtensions": "Information",
      "SMS3.EventHandlers": "Information",
      "SMS3.Components.Pages.SMSRiskManagement.HazardReporting": "Information",

      // SPI Background Service - Less chatty
      "SMS_Application.BackgroundServices.SPICalculationBackgroundService": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Warning",

        // Only EventBus stuff in console
        "SMS_Application.Services.EventBusService": "Debug",
        "SMS_Application.EventHandlers": "Information",
        "SMS_Application.Configuration.EventBusExtensions": "Information",
        "SMS3.EventHandlers": "Information"
      }
    }
  },

  // SMTP Email Configuration - INTERNAL RELAY
  "SmtpEmailConfiguration": {
    "SmtpHost": "mail.portofportland.com",
    "SmtpPort": 25,
    "EnableSsl": false,
    "Username": "",
    "Password": "",
    "FromEmail": "sms-safety@portofportland.com",
    "FromName": "SMS Safety Management System",
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 2,
    "UseSimulation": true
  },

  "NotificationSettings": {
    "AllowErrorNotifications": true,
    "AllowSuccessNotifications": false,
    "AllowWarningNotifications": false,
    "AllowInfoNotifications": false
  },
  "SessionConfiguration": {
    "EnableDevelopmentMode": true,
    "TimeoutMinutes": 30
  },
  "FeatureManagement": {
    "AllowHttpCookies": true,
    "AllowHttpInDevelopment": true,
    "EnforceHttpsRedirection": false,
    "SwaggerEnabled": true,
    "ErrorNotifications": true,    // ✅ Test error notifications
    "SuccessNotifications": true,  // ✅ Test success notifications  
    "WarningNotifications": true,  // ✅ Test warning notifications
    "InfoNotifications": true      // ✅ Test info notifications
  }
}
