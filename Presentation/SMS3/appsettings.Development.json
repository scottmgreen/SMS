{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting": "Warning",
      "Microsoft.AspNetCore.Routing": "Warning",
      "Microsoft.Extensions.Hosting": "Warning",
      "SMS3": "Warning",
      "SMS_Application.Services.SecurityFeatureService": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "NotificationSettings": {
    "AllowErrorNotifications": true,
    "AllowSuccessNotifications": false,
    "AllowWarningNotifications": false,
    "AllowInfoNotifications": false
  },
  "SessionConfiguration": {
    "EnableDevelopmentMode": true,
    "TimeoutMinutes": 30
  },
  "FeatureManagement": {
    "AllowHttpCookies": true,
    "AllowHttpInDevelopment": true,
    "EnforceHttpsRedirection": false,
    "SwaggerEnabled": true,
    "ErrorNotifications": true,
    "SuccessNotifications": false,
    "WarningNotifications": false,
    "InfoNotifications": false
  }
}
