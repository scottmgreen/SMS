{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting": "Warning",
      "Microsoft.AspNetCore.Routing": "Warning",
      "Microsoft.Extensions.Hosting": "Warning",
      "SMS3": "Information",

      // EventBus and related services - Enable detailed logging for testing
      "SMS_Application.Services.EventBusService": "Information",
      "SMS_Application.EventHandlers": "Information",
      "SMS_Application.Services.SPIEventCoordinator": "Information",
      "SMS3.Components.Pages.SMSRiskManagement.HazardReporting": "Information",

      // Existing services
      "SMS_Application.Services.SecurityFeatureService": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",

        // EventBus specific console logging
        "SMS_Application.Services.EventBusService": "Information",
        "SMS_Application.EventHandlers": "Information"
      }
    }
  },
  "NotificationSettings": {
    "AllowErrorNotifications": true,
    "AllowSuccessNotifications": false,
    "AllowWarningNotifications": false,
    "AllowInfoNotifications": false
  },
  "SessionConfiguration": {
    "EnableDevelopmentMode": true,
    "TimeoutMinutes": 30
  },
  "FeatureManagement": {
    "AllowHttpCookies": true,
    "AllowHttpInDevelopment": true,
    "EnforceHttpsRedirection": false,
    "SwaggerEnabled": true,
    "ErrorNotifications": true,
    "SuccessNotifications": false,
    "WarningNotifications": false,
    "InfoNotifications": false
  }
}
