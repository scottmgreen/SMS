<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Enable XML documentation generation for Swagger -->
    <!--<GenerateDocumentationFile>true</GenerateDocumentationFile>-->
    <NoWarn>$(NoWarn);1591;CA1873</NoWarn> <!-- Suppress missing XML comment warnings and costly logging argument analyzer noise -->
    
    <!-- Version Information -->
    <Version>1.1.8</Version>
    <AssemblyVersion>1.1.8.0</AssemblyVersion>
    <FileVersion>1.1.8.0</FileVersion>
    <AssemblyTitle>SMS Presentation Layer</AssemblyTitle>
    <Product>PDX Safety Management System</Product>
    <Company>Portland International Airport</Company>
    <Copyright>Copyright © 2026 Portland International Airport</Copyright>
  </PropertyGroup>

  

  

  

  <ItemGroup>
	  <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" />
	  <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
    <PackageReference Include="QuestPDF" Version="2025.7.3" />
    <PackageReference Include="Radzen.Blazor" Version="10.4.5" />
	<PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Application\Application.csproj" />
    <ProjectReference Include="..\..\Domain\Domain.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Components\Pages\SMSPromotion\" />
    <Folder Include="logs\" />
    <Folder Include="wwwroot\uploads\" />
  </ItemGroup>

</Project>
