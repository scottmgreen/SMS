@page "/SMSRiskManagement/HazardReporting"
@page "/SMSRiskManagement/HazardReporting/{HazardCode}"

@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Pages.SMSRiskManagement.Models

<PageTitle>Submit Hazard Report - SMS3</PageTitle>

<!-- SMS Page Header using reusable component -->
<PageHeader Title="@PageTitle"
           Subtitle="@PageSubtitle"
           Icon="fas fa-exclamation-triangle" />

@if (IsLoading)
{
    <!-- Loading State -->
    <div class="text-center py-5">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        <p class="mt-3 text-muted">Processing your report...</p>
    </div>
}
else if (ShowFinalSuccessConfirmation)
{
   
    <!-- Final Success Modal -->
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-success">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-success">
                    <h5 class="sms-modal-title">
                        <i class="fas fa-check-circle"></i> SMS Hazard Report Successfully Submitted!
                    </h5>
                </div>
                <div class="sms-modal-body">
                        <div class="mb-3">
                            @* <h6 class="text-primary mb-2">
                                <i class="fas fa-info-circle"></i> Report Summary
                            </h6>
                            <hr /> *@
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeLG="12">
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Tracking ID: </strong>@GeneratedTrackingId</RadzenText>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeLG="12">
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Report ID: </strong> @GeneratedReportId</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Hazard ID: </strong> @GeneratedHazardId</RadzenText>
                                </RadzenColumn>
                            </RadzenRow>
                            <br />
                            <br />
                            
                        </div>
                    
                    <div class="row">
                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-center gap-3 flex-wrap">
                                <RadzenButton ButtonStyle="ButtonStyle.Warning"
                                              Click="PrintConfirmation"
                                              Text="Print Details"
                                              Icon="print"
                                              Size="ButtonSize.Medium" />

                                <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                              Click="CloseFinalConfirmation"
                                              Text="Continue"
                                              Icon="check"
                                              Size="ButtonSize.Medium" />
                            </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

}
else
{
    <!-- Main Content -->
    <RadzenRow Gap="1rem">
        <!-- Form Column -->
        <RadzenColumn Size="8">
            <RadzenCard>
                <RadzenStack Gap="1rem" Class="rz-p-3">
                    @if (ShowConfidentialInfo)
                    {
                        <RadzenAlert Size="AlertSize.Small" Variant="Variant.Flat">
                            <strong>Confidential Protection:</strong> Your identity will be protected and access to this report will be restricted to authorized SMS personnel only.
                            <br><strong>Benefits:</strong> Enhanced protection from retaliation, restricted access, anonymous follow-up options.
                            <br><strong>Note:</strong> Confidential reports may take longer to process due to additional security measures.
                        </RadzenAlert>
                    }

                    @* EDIT MODE VALIDATION ALERT *@
                    @if (ShowEditValidationAlert)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Size="AlertSize.Medium" Variant="Variant.Flat" class="rz-mb-3 default-validation-alert">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                @* <RadzenIcon Icon="error" Style="font-size: 1.5rem; color: #dc3545;" /> *@
                                <div>
                                    <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0; color: #721c24;">
                                        <strong>@EditValidationAlertTitle</strong>
                                    </RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; color: #721c24;">
                                        @EditValidationAlertMessage
                                    </RadzenText>
                                </div>
                            </RadzenStack>
                        </RadzenAlert>
                    }
                    <RadzenTemplateForm Data="@HazardReport" Submit="@HandleFormSubmit" TItem="HazardReportForm">
                        <RadzenRow>
                            <RadzenColumn Size="3">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="0.5rem">
                                    <RadzenCheckBox @bind-Value="@HazardReport.IsAnonymous"
                                                    Name="IsAnonymous"
                                                    TriState="false" />
                                    <RadzenLabel Style="font-weight:600" Text="Submit as Anonymous" Component="IsAnonymous" />
                                </RadzenStack>
                            </RadzenColumn>

                            
                        </RadzenRow>
                        <!-- Row 0: Anonymous, Submitted By, Department and Job Function-->
                        <RadzenRow Gap="1rem" Class="rz-mb-3">
                            

                            @if (!HazardReport.IsAnonymous)
                            {
                                <RadzenCard>
                                    <RadzenColumn Size="3">
                                        <RadzenFormField AllowFloatingLabel="false" Text="Contact Name *" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenTextBox @bind-Value="@HazardReport.ReportContactName"
                                                           Placeholder="Name and position (e.g., 'John Smith - Ground Operations Supervisor')"
                                                           Name="ContactName"
                                                           MaxLength="60"
                                                           Style="width: 100%;min-width: 100%;" />
                                            <RadzenRegexValidator Component="ContactName"
                                                                  Text="Please enter a valid name (letters, spaces, hyphens, and apostrophes only)"
                                                                  Pattern="^[a-zA-Z\s\-'\.]+$" />
                                        </RadzenFormField>
                                    
                                    </RadzenColumn>
                                    <RadzenColumn Size="3">
                                        <RadzenFormField AllowFloatingLabel="false" Text="Contact Mobile" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenMask Mask="(***) ***-****" CharacterPattern="[0-9]"
                                                        Placeholder="(000) 000-0000" Name="ContactCell" @bind-Value=@HazardReport.ReportContactCell )
                                                        Style="width: 100%;" aria-label="ContactCell" />
                                            <RadzenRegexValidator Component="ContactCell" Text="Must be in (***)***-**** format" 
                                                Pattern="^(\(\d{3}\)|\d{3})[-.\s]?\d{3}[-.\s]?\d{4}$" />
                                        
                                        </RadzenFormField>
                                    
                                    
                                    </RadzenColumn>
                                    <RadzenColumn Size="3">
                                        <RadzenFormField AllowFloatingLabel="false" Text="Contact Email" Variant="Variant.Outlined" Style="width: 100%;">
                                                <RadzenTextBox @bind-Value="@HazardReport.ReportContactEmail"
                                                           @oninput="@OnEmailInput"
                                                           Placeholder="Enter email ..."
                                                           Name="ContactEmail"
                                                           MaxLength="254"
                                                           Style="display: block; width: 100%;" />
                                        </RadzenFormField>
                                        <RadzenEmailValidator Component="ContactEmail" Text="Invalid email address" />
                                        @if (!string.IsNullOrEmpty(EmailValidationMessage))
                                        {
                                            <div class="text-danger small mt-1">
                                                <i class="fas fa-exclamation-circle me-1"></i>
                                                @EmailValidationMessage
                                            </div>
                                        }
                                    </RadzenColumn>
                                    <RadzenColumn Size="3">
                                        <RadzenFormField AllowFloatingLabel="false" Text="Contact Company" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenTextBox @bind-Value="@HazardReport.ReportContactCompany"
                                                           Placeholder="Company Name"
                                                           Name="ContactCompany"
                                                           MaxLength="60"
                                                           Style="width: 100%;min-width: 100%;" />
                                            <RadzenRegexValidator Component="ContactCompany"
                                                                  Text="Please enter a valid name (letters, spaces, hyphens, and apostrophes only)"
                                                                  Pattern="^[a-zA-Z\s\-'\.]+$" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenCard>
                            }
                            else
                            {
                                HazardReport.ReportContactName = string.Empty;
                                HazardReport.ReportContactCell =string.Empty;
                                HazardReport.ReportContactEmail = string.Empty;
                                HazardReport.ReportContactCompany = string.Empty;
                            } 

                        <RadzenCard>
                                <RadzenColumn Size="2">
                                    <RadzenFormField Text="Submitted On *" Variant="Variant.Outlined">
                                        <RadzenDatePicker @bind-Value="@HazardReport.SubmittedDate"
                                                          ShowTime="true"
                                                          DateFormat="MM/dd/yyyy HH:mm"
                                                          Style="width: 100%;" 
                                                          ReadOnly="true"
                                                          
                                                          />
                                        
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="3">
                                   
                                    @* <RadzenRequiredValidator Component="SubmittedBy" Text="Report Source required" /> *@
                                </RadzenColumn>
                                @if (!HazardReport.IsAnonymous)
                                {
                                    <RadzenColumn Size="3">
                                        <RadzenFormField Text="Submitting Department" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">

                                            <RadzenDropDown @bind-Value="@HazardReport.SubmittingDepartment"
                                            Data="@DepartmentOptions"
                                            TextProperty="Text"
                                            ValueProperty="Value"
                                            Placeholder="Select submitting department..."
                                            Name="SubmittingDepartment"
                                            Change="@(async (object value) => await OnDepartmentChanged(value?.ToString()))"
                                            Style="width: 50%; min-width: 50%;" />
                                        </RadzenFormField>
                                        @* <RadzenRequiredValidator Component="SubmittingDepartment" Text="Reporting Department by is required" /> *@
                                    </RadzenColumn>
                                    <RadzenColumn Size="5">
                                        <RadzenFormField Text="Job Function" AllowFloatingLabel="false"  Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenTextArea @bind-Value="@HazardReport.SubmittingDepartmentJobFunction"
                                            Placeholder="Enter reporting department or organization..."
                                            Name="SubmittingDepartmentJobFunction"
                                            MaxLength="200"
                                            Style="width: 100%; min-width: 100%;"
                                            Rows="2" Cols="100" />
                                        </RadzenFormField>
                                        @* <RadzenRequiredValidator Component="SubmittingDepartmentJobFunction" Text="Reporting Department by is required" /> *@
                                    </RadzenColumn>
                                }
                            </RadzenCard>
                        
                        </RadzenRow>
                  
                        <RadzenRow Gap="1rem" Class="rz-mb-3">
                            <RadzenColumn Size="12" class="rz-col-2">
                            <!-- Row 2: Hazard Category and Hazard Type -->
                            <RadzenCard class="@((IsEditMode && HasDefaultHazardClassification) ? "default-validation-alert" : string.Empty)">
                            
                            <RadzenRow Gap="1rem" Class="rz-mb-3">
                                <RadzenColumn Size="2">
                                    <RadzenFormField Text="Incident Date/Time" Variant="Variant.Outlined">
                                        <RadzenDatePicker @bind-Value="@HazardReport.IncidentDateTime"
                                                              ShowTime="true"
                                                              DateFormat="MM/dd/yyyy HH:mm"
                                                              Style="width: 100%;" />

                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Hazard Category *" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false" 
                                                     class="@(IsHazardCategoryDefault ? "validation-error-field" : "")">
                                        <RadzenDropDown @bind-Value="@HazardReport.HazardCategory"
                                                      Data="@HazardCategoryOptions" 
                                                      TextProperty="Text" 
                                                      ValueProperty="Value"
                                                      Placeholder="Select hazard category..."
                                                      Name="HazardCategory"
                                                      Change="@(async (object value) => await OnHazardCategoryChanged(value?.ToString()))"
                                                      AllowClear="true"
                                                      class="@(IsHazardCategoryDefault ? "default-validation-dropdown" : "")"
                                                      Style="width: 100%; min-width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="HazardCategory" Text="Hazard category is required" />
                                   
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenFormField Text="Hazard Type *" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false" class="@(IsHazardTypeDefault ? "validation-error-field" : "")">
                                        <RadzenDropDown @bind-Value="@HazardReport.HazardType" 
                                                      Data="@HazardTypeOptions" 
                                                      TextProperty="Text" 
                                                      ValueProperty="Value"
                                                      Placeholder="Select hazard type..."
                                                      Change="@(async (object value) => await OnHazardTypeChanged(value?.ToString()))"
                                                      Disabled="@(HazardTypeOptions.Count == 0)"
                                                      AllowClear="true"
                                                      class="@(IsHazardTypeDefault ? "default-validation-dropdown" : "")"
                                                      Style="width: 100%; min-width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="HazardType" Text="Hazard type is required" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem" Class="rz-mb-3">
                                <RadzenColumn Size="2"></RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenCard Variant="Variant.Text" Class="sms-guidance-mini">
                                        <RadzenStack Gap="0.5rem" Class="rz-p-2">
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                                <RadzenIcon Icon="category" Style="color: var(--rz-primary); font-size: 1rem;" />
                                                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; color: var(--rz-primary);">Hazard Category Guidance</RadzenText>
                                            </RadzenStack>
                                            @if (!string.IsNullOrEmpty(SelectedHazardCategory) && HazardReport.HazardCategory != HazardCategory.Default.Value)
                                            {
                                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; font-size: 0.85rem;">
                                                    @GetHazardCategoryDescription(SelectedHazardCategory)
                                                </RadzenText>
                                            }
                                            else
                                            {
                                                <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: var(--rz-info);">
                                                    Select a Hazard Category to view guidance.
                                                </RadzenText>
                                            }
                                        </RadzenStack>
                                    </RadzenCard>
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenCard Variant="Variant.Text" Class="sms-guidance-mini">
                                        <RadzenStack Gap="0.5rem" Class="rz-p-2">
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                                <RadzenIcon Icon="info" Style="color: var(--rz-primary); font-size: 1rem;" />
                                                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; color: var(--rz-primary);">Hazard Type Guidance</RadzenText>
                                            </RadzenStack>
                                            @if (HazardReport.HazardType != HazardType.Default.Value)
                                            {
                                                @if (RequiresRegulatoryReporting(HazardReport.HazardType))
                                                {
                                                    <RadzenAlert AlertStyle="AlertStyle.Warning" Size="AlertSize.Small" Variant="Variant.Flat">
                                                        <strong>Regulatory Reporting Required</strong>
                                                    </RadzenAlert>
                                                }

                                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; font-size: 0.85rem;">
                                                    @GetHazardTypeGuidance(HazardReport.HazardType)
                                                </RadzenText>
                                            }
                                            else
                                            {
                                                <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: var(--rz-info);">
                                                    Select a Hazard Type to view guidance.
                                                </RadzenText>
                                            }
                                        </RadzenStack>
                                    </RadzenCard>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenCard>
                        </RadzenColumn>
                        </RadzenRow>
                        <!-- Row 3: Hazard Description  -->

                        <RadzenRow Gap="1rem" Class="rz-mb-3">
                            <RadzenColumn Size="12" class="rz-col-2">
                                
                                <RadzenCard class="@(IsHazardTitleValidationAlert ? "default-validation-alert" : string.Empty)">
                                    <RadzenFormField Text="Hazard Title *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;" class="@(IsHazardTitleValidationAlert ? "validation-error-field" : string.Empty)">
                                        <RadzenTextBox @bind-Value="HazardReport.HazardTitle"
                                                           Name="HazardTitle"
                                                           MaxLength="60"
                                                           class="@(IsHazardTitleValidationAlert ? "default-validation-dropdown" : string.Empty)"
                                                           Placeholder="Enter a short hazard title (5-6 words)..."
                                                           Style="width: 50%; min-width: 50%;" />
                                        
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="HazardTitle" Text="Hazard title is required" />
                                        <RadzenText TextStyle="TextStyle.Caption"
                                                    Class="@($"rz-mt-1 {(HazardTitleCharacterCount > 55 ? "rz-color-danger" : HazardTitleCharacterCount > 45 ? "rz-color-warning" : "rz-color-base-500")}")">
                                            @HazardTitleCharacterCount/60 characters
                                        </RadzenText>
                                </RadzenCard>
                            </RadzenColumn>
                        </RadzenRow>





                        <RadzenRow Gap="1rem" Class="rz-mb-3">
                            <RadzenColumn Size="12" class="rz-col-2">
                                
                                <RadzenCard>
                                    <RadzenFormField Text="Hazard Description *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                        <RadzenStack Gap="0.75rem" Class="rz-py-2 rz-px-2 rz-pb-2">
                                            <RadzenHtmlEditor @bind-Value="@HazardReport.Description" Class="hazard-description-editor" Style="width: 100%; height: 260px;">
                                                <RadzenHtmlEditorUndo />
                                                <RadzenHtmlEditorRedo />
                                                <RadzenHtmlEditorSeparator />
                                                <RadzenHtmlEditorBold />
                                                <RadzenHtmlEditorItalic />
                                                <RadzenHtmlEditorUnderline />
                                                <RadzenHtmlEditorStrikeThrough />
                                                <RadzenHtmlEditorSeparator />
                                                <RadzenHtmlEditorColor />
                                                <RadzenHtmlEditorBackground />
                                                <RadzenHtmlEditorRemoveFormat />
                                            </RadzenHtmlEditor>

                                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Class="rz-mt-1">
                                                <RadzenRequiredValidator Component="Description" Text="Description is required" />
                                                <RadzenText TextStyle="TextStyle.Caption"
                                                            Class="@(DescriptionCharacterCount > 1950 ? "rz-color-danger" : DescriptionCharacterCount > 1800 ? "rz-color-warning" : "rz-color-base-500")">
                                                    @DescriptionCharacterCount/2000 characters
                                                </RadzenText>
                                            </RadzenStack>
                                        </RadzenStack>
                                    </RadzenFormField>
                                </RadzenCard>
                            </RadzenColumn>
                        </RadzenRow>
                
                        <!-- Row 4: Location Selection -->

                        <RadzenRow Gap="1rem" Class="rz-mb-3">
                            <RadzenColumn Size="12" class="rz-col-2">
                                <RadzenCard class="@((IsEditMode && RequiresLocationValidation) ? "default-validation-alert" : string.Empty)">
                                    <RadzenFormField Text="Hazard Location" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenStack Gap="0.75rem" Class="rz-py-2 rz-px-2 rz-pb-2 hazard-location-grid">
                                        <RadzenRow Gap="1rem" AlignItems="AlignItems.End">
                                            <RadzenColumn Size="12" SizeMD="3" Class="location-action-col">
                                                <RadzenButton ButtonStyle="@(IsEditMode && RequiresLocationValidation ? ButtonStyle.Danger : ButtonStyle.Primary)"
                                                              Click="OpenMapSelector"
                                                              Text="@LocationSelectionButtonText"
                                                              Icon="map"
                                                              Size="ButtonSize.Medium"
                                                              Style="width: 100%; height: 42px;"
                                                              class="@(RequiresLocationValidation ? "default-validation-dropdown" : string.Empty)" />
                                            </RadzenColumn>

                                            <RadzenColumn Size="12" SizeMD="2" Class="location-field-col">
                                                <RadzenFormField Text="Latitude" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                                    <RadzenTextBox Value="@SelectedLatitudeText"
                                                                   ReadOnly="true"
                                                                   Placeholder=""
                                                                   class="@(RequiresLocationValidation ? "default-validation-dropdown" : string.Empty)"
                                                                   Style="background-color: #f8f9fa; border-color: #dee2e6; width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>

                                            <RadzenColumn Size="12" SizeMD="2" Class="location-field-col">
                                                <RadzenFormField Text="Longitude" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                                    <RadzenTextBox Value="@SelectedLongitudeText"
                                                                   ReadOnly="true"
                                                                   Placeholder=""
                                                                   class="@(RequiresLocationValidation ? "default-validation-dropdown" : string.Empty)"
                                                                   Style="background-color: #f8f9fa; border-color: #dee2e6; width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>

                                            <RadzenColumn Size="12" SizeMD="5" Class="location-field-col">
                                                <RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                                    <RadzenTextBox @bind-Value="@SelectedLocationDescription"
                                                                   Placeholder="Optional description (e.g., 'Terminal A, Gate 5, near security checkpoint')"
                                                                   class="@(RequiresLocationValidation ? "default-validation-dropdown" : string.Empty)"
                                                                   Style="width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>
                                        </RadzenStack>
                                    </RadzenFormField>
                                </RadzenCard>
                            </RadzenColumn>
                        </RadzenRow>
                        
                        
                        <!-- Row 5: Supporting Documents @* Change=@OnInputFileChange  *@-->
                        <RadzenRow Gap="1rem" Class="rz-mb-3">
                            <RadzenColumn Size="12">
                                <RadzenCard>
                                    <RadzenFormField Text="Supporting Documents" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenStack Gap="0.75rem" Class="rz-py-2 rz-px-2 rz-pb-2">
                                            <RadzenUpload Multiple="true"
                                                          Change=@OnInputFileChange
                                                          ChooseText="📄 Choose Files"
                                                          Class="hazard-upload"
                                                          Style="width: 100%;padding: 0.5rem; border: 1px solid #ccc; border-radius: 0.25rem;"
                                                          Accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.txt"
                                                          MaxFileSize="10485760" />

                                            <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-base-500">
                                                <RadzenIcon Icon="attach_file" Style="font-size: 0.9rem;" />
                                                Supported: JPG, PNG, PDF, DOC, DOCX, TXT (Max 10MB per file)
                                            </RadzenText>
                                            <!--Supporting Documents Queue-->
                                            @if (AttachedFiles.Any())
                                            {
                                                <RadzenStack Gap="1rem" Class="rz-px-2 rz-pb-2">
                                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                                        <strong>Queued files (@AttachedFiles.Count):</strong>
                                                        <RadzenButton ButtonStyle="ButtonStyle.Base"
                                                                      Variant="Variant.Text"
                                                                      Icon="clear_all"
                                                                      Text="Clear All"
                                                                      Size="ButtonSize.ExtraSmall"
                                                                      Click="ClearAllFiles" />
                                                    </RadzenStack>

                                                    <RadzenStack Gap="0.5rem">
                                                        @for (int i = 0; i < AttachedFiles.Count; i++)
                                                        {
                                                            var file = AttachedFiles[i];
                                                            var fileIndex = i;
                                                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center"
                                                                         Style="padding: 0.25rem 0.5rem; border: 1px solid #dee2e6; border-radius: 0.25rem; background-color: #f8f9fa;">
                                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                                    <RadzenIcon Icon="attach_file" Style="color: var(--sms-blue-dark-bold); font-size: 0.9rem;" />
                                                                    @if (ShouldUseStoredExternalPath(file))
                                                                    {
                                                                        <RadzenLink Text="@GetAttachedFileDisplayName(file)"
                                                                                    Style="font-size: 0.95rem; font-weight: 500; color: var(--rz-primary);"
                                                                                    Path="@ResolveExternalFilePath(file.FilePath)"
                                                                                    Target="_blank"
                                                                                    title="Click to open file in a new tab" />
                                                                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: var(--rz-text-secondary-color);">
                                                                            (@file.SizeDisplay)
                                                                        </RadzenText>
                                                                    }
                                                                    else
                                                                    {
                                                                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                                                                            @GetAttachedFileDisplayName(file) (@file.SizeDisplay)
                                                                        </RadzenText>
                                                                    }
                                                                </RadzenStack>
                                                                <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                                                              Variant="Variant.Text"
                                                                              Icon="close"
                                                                              Size="ButtonSize.ExtraSmall"
                                                                              Click="@(() => RemoveFile(fileIndex))"
                                                                              Text="" />
                                                            </RadzenStack>
                                                        }
                                                    </RadzenStack>
                                                </RadzenStack>
                                            }
                                        </RadzenStack>
                                    </RadzenFormField>
                                </RadzenCard>
                                
                                
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Row 6: Confidential Flag at Bottom -->
                        <RadzenRow Gap="1rem" Class="rz-border-top-1 rz-pt-3">
                            
                            
                            
                            
                            <RadzenColumn>
                                @if (!ShowSubmissionConfirmation && !ShowFinalSuccessConfirmation)
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                                        @if (IsEditMode)
                                        {
                                            <RadzenButton ButtonStyle="ButtonStyle.Light"
                                                        Icon="close"
                                                        Text="Cancel"
                                                        Size="ButtonSize.Medium"
                                                        Click="CancelEdit" />
                                        }
                                        
                                        @if (!IsExternalSystemSubmittedReport)
                                        {
                                            <RadzenButton ButtonStyle="ButtonStyle.Warning" 
                                                        Icon="clear"
                                                        Text="Clear Form"
                                                        Size="ButtonSize.Medium"
                                                        Click="ClearForm" />
                                        }
                                        <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                                    Icon="send"
                                                    Text="@(IsEditMode ? "Update Report" : "Submit Report")"
                                                    Size="ButtonSize.Medium"
                                                    Click="ShowSubmissionConfirmationDialog"
                                                    Disabled="@(!IsFormValidForSubmission() || IsUpdateBlockedByValidation)" />
                                    </RadzenStack>
                                }
                                else
                                {
                                    <!-- Placeholder when buttons are hidden -->
                                    <div class="text-muted text-end">
                                        <small><em>Complete modal action to continue...</em></small>
                                    </div>
                                }
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTemplateForm>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <!-- Guidance Panel -->
        <RadzenColumn Size="4">
            <RadzenCard Variant="Variant.Outlined" Class="sms-guidance-panel" >
                <RadzenStack Gap="1rem" Class="rz-p-3">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Class="rz-mb-3 rz-pb-2 rz-border-bottom-1" Style="border-bottom: 1px solid var(--rz-border-color); padding-bottom: 0.5rem; background: var(--rz-warning-lighter); margin: -1rem -1rem 1rem -1rem; padding: 1rem;">
                        <RadzenIcon Icon="help" Style="color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Reporting Guidelines</RadzenText>
                    </RadzenStack>

                    <RadzenStack Gap="1rem">
                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-primary); margin: 0;">What to Report:</RadzenText>
                            <RadzenStack Gap="0.25rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="check" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Actual incidents or accidents</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="check" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Near-miss events</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="check" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Unsafe conditions</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="check" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Equipment malfunctions</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="check" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Procedural violations</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="check" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Security concerns</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="check" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Environmental hazards</RadzenText>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenStack>

                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-primary); margin: 0;">Confidential Reporting:</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Use when concerned about:</RadzenText>
                            <RadzenStack Gap="0.25rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="security" Style="color: var(--rz-info); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Personal safety or retaliation</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="security" Style="color: var(--rz-info); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Sensitive operational information</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="security" Style="color: var(--rz-info); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Personnel-related issues</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="security" Style="color: var(--rz-info); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Management or supervisory concerns</RadzenText>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenStack>

                        <RadzenAlert AlertStyle="AlertStyle.Base" Size="AlertSize.Small" Variant="Variant.Flat">
                            <RadzenStack Gap="0.5rem" AlignItems="AlignItems.Center">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">Need Help?</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; text-align: center;">SMS Team: (503) 555-0100</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; text-align: center;">sms@flypdx.com</RadzenText>
                            </RadzenStack>
                        </RadzenAlert>
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
}

<!-- Map Modal -->
@if (ShowMapModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-xl">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-map-marked-alt"></i> @MapModalTitle
                        </h5>
                        <div class="d-flex align-items-center gap-2">
                            <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                        Variant="Variant.Text"
                                        Icon="close"
                                        Size="ButtonSize.Small"
                                        Click="CloseMapSelector" />
                        </div>
                    </div>
                </div>
                <div class="sms-modal-body p-0">
                    <!-- Map Container -->
                    <div id="hazardLocationMap" style="height: 500px; width: 100%;"></div>
                    
                    <!-- Location Form and Controls -->
                    <div class="p-4">
                        <!-- Selected Coordinates Display -->
                            <div class="location-row rz-mt-1">
                                <div class="location-coordinate">
                                <RadzenFormField Text="Latitude" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                        <RadzenTextBox Value="@SelectedLatitudeText"
                                                       ReadOnly="true"
                                                       Placeholder=""
                                                       class="@(!HasValidCoordinates ? "default-validation-dropdown" : string.Empty)"
                                                       Style="background-color: #f8f9fa; border-color: #dee2e6; width: 100%;" />
                                    </RadzenFormField>
                                </div>

                                <div class="location-coordinate">
                                <RadzenFormField Text="Longitude" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                        <RadzenTextBox Value="@SelectedLongitudeText"
                                                       ReadOnly="true"
                                                       Placeholder=""
                                                       class="@(!HasValidCoordinates ? "default-validation-dropdown" : string.Empty)"
                                                       Style="background-color: #f8f9fa; border-color: #dee2e6; width: 100%;" />
                                    </RadzenFormField>
                                </div>

                                <div class="location-description">
                                <RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        <RadzenTextBox @bind-Value="@SelectedLocationDescription"
                                                       Placeholder="Required location description"
                                                       ReadOnly="@IsMapReadOnlyMode"
                                                       class="@(!HasLocationDescription ? "default-validation-dropdown" : string.Empty)"
                                                       Style="width: 100%;" />
                                    </RadzenFormField>
                                @if (!HasLocationDescription)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger); margin-top: 0.35rem; display: block;">
                                        Location description is required.
                                    </RadzenText>
                                }
                                </div>
                            </div>
                            <br />
                        <!-- Current Selection Display -->
                                                
                        <div class="d-flex justify-content-end gap-2">
                            <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                        Text="Cancel" 
                                        Icon="close"
                                        Size="ButtonSize.Medium"
                                        Click="CloseMapSelector" />
                            @if (IsMapReadOnlyMode)
                            {
                                <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                              Text="Edit Location"
                                              Icon="edit"
                                              Size="ButtonSize.Medium"
                                              Click="EnableLocationEditMode" />
                            }
                            <RadzenButton ButtonStyle="ButtonStyle.Warning" 
                                        Text="Clear Selection" 
                                        Icon="clear"
                                        Size="ButtonSize.Medium"
                                        Click="ClearMapSelection"
                                        Disabled="@(!CanClearMapSelection)" />
                            <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                        Text="@MapModalConfirmButtonText" 
                                        Icon="check"
                                        Size="ButtonSize.Medium"
                                        Click="UseSelectedLocation"
                                        Disabled="@(!CanUseSelectedMapLocation)" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Submission Confirmation Modal -->
@if (ShowSubmissionConfirmation)
    {
        <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-submission">
                <div class="sms-modal-content">
                    <div class="sms-modal-header sms-header-warning">
                        <h5 class="sms-modal-title">
                            <i class="fas fa-exclamation-triangle"></i> Confirm @(IsEditMode ? "Report Update" : "Hazard Report Submission")
                        </h5>
                    </div>
                    <div class="sms-modal-body">
                        <!-- Report Summary - 3 Column Layout -->
                        <div class="mb-3">
                            @* <h6 class="text-primary mb-2">
                                <i class="fas fa-file-alt"></i> Report Summary
                            </h6> 
                            <hr />*@
                                <RadzenRow Gap="1rem">
                                   <RadzenColumn Size="6" SizeLG="6">
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Hazard Category: </strong>@GetHazardCategoryDisplay(HazardReport.HazardCategory)</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Hazard Type: </strong>@GetHazardTypeDisplay(HazardReport.HazardType)</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Hazard Latitude: </strong>@GetHazardTypeDisplay(SelectedLatitudeText)</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Hazard Longitude: </strong>@GetHazardTypeDisplay(SelectedLongitudeText)</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Hazard Longitude: </strong>@GetHazardTypeDisplay(SelectedLocationDescription)</RadzenText>

                                        </RadzenStack>
                                    </RadzenColumn>
                                    @if (!HazardReport.IsAnonymous && (!string.IsNullOrEmpty(HazardReport.ReportContactName) || !string.IsNullOrEmpty(HazardReport.ReportContactCell) || !string.IsNullOrEmpty(HazardReport.ReportContactEmail)))
                                    {
                                        <RadzenColumn Size="6" SizeLG="6">
                                            <RadzenStack Gap="0.25rem">
                                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Name: </strong> @HazardReport.ReportContactName</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Phone: </strong> @HazardReport.ReportContactCell</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Email: </strong> @HazardReport.ReportContactEmail</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Company: </strong> @HazardReport.ReportContactCompany</RadzenText>
                                            </RadzenStack>
                                        </RadzenColumn>
                                    }
                                </RadzenRow>
                        
                        
                       
                        </div>
                        <br/>
                        <div class="row">
                            <div class="d-flex justify-content-center gap-3">

                                <RadzenButton ButtonStyle="ButtonStyle.Warning"
                                              Text="No, Continue Editing"
                                              Icon="edit"
                                              Click="CancelSubmission"
                                              Size="ButtonSize.Medium" />

                                <RadzenButton ButtonStyle="ButtonStyle.Success"
                                              Text="@(IsEditMode ? "Yes, Update Report" : "Yes, Submit Report")"
                                              Icon="check"
                                              Click="SubmitReportConfirmed"
                                              Size="ButtonSize.Medium" />

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }


<style>
/* =============================================================================
   SMS HAZARD REPORTING - FULL STYLING
   ============================================================================= */

/* Modal Overlay and Dialog */
.modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.6); /* Increased opacity from 0.5 to 0.6 */
        backdrop-filter: blur(3px); /* Add blur effect to background */
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 1rem;
        animation: fadeIn 0.3s ease-in-out; /* Smooth fade-in animation */
