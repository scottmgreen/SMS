@page "/SafetyRiskManagement/SimplifiedRiskAssessment/{hazardId}/{assessmentId}"
@model SMS_Presentation.Pages.SafetyRiskManagement.SimplifiedRiskAssessmentModel
@{
    ViewData["Title"] = "Simplified Risk Assessment";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyRiskManagement">Safety Risk Management</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyRiskManagement/ReportProcessing">Report Processing</a></li>
                    <li class="breadcrumb-item active">Preliminary Risk Assessment</li>
                </ol>
            </nav>
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="card-title"><i class="fas fa-tachometer-alt"></i> Simplified Risk Assessment</h4>
                            <p class="card-text">Streamlined risk assessment for moderate complexity hazards</p>
                            <p class="mb-0"><strong>Assessment ID:</strong> @Model.AssessmentId | <strong>Hazard:</strong> @Model.HazardId</p>
                        </div>
                        <div class="col-md-4 text-end">
                            <h3 class="mb-1">@Model.ProgressPercentage%</h3>
                            <div class="progress bg-light">
                                <div class="progress-bar bg-warning" style="width: @Model.ProgressPercentage%">
                                    Complete
                                </div>
                            </div>
                            <small class="text-light">@Model.CurrentSection</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Assessment Form -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-clipboard-check"></i> Simplified Risk Assessment Form</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="HazardId" />
                        <input type="hidden" asp-for="AssessmentId" />

                        <!-- Hazard Summary -->
                        @if (Model.Hazard != null)
                        {
                            <div class="card mb-4 bg-light">
                                <div class="card-body">
                                    <h6><i class="fas fa-exclamation-triangle"></i> Hazard Summary</h6>
                                    <p class="mb-1"><strong>Type:</strong> @Model.Hazard.HazardType</p>
                                    <p class="mb-1"><strong>Location:</strong> @Model.Hazard.Location</p>
                                    <p class="mb-0"><strong>Description:</strong> @Model.Hazard.Description</p>
                                </div>
                            </div>
                        }

                        <!-- Section 1: Immediate Risk Level -->
                        <div class="mb-4">
                            <h6><i class="fas fa-thermometer-half"></i> 1. Immediate Risk Level Assessment</h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="form-label">Likelihood of Occurrence</label>
                                    <select asp-for="Likelihood" class="form-select" required>
                                        <option value="">Select likelihood...</option>
                                        <option value="Very Low">Very Low (< 1% chance)</option>
                                        <option value="Low">Low (1-10% chance)</option>
                                        <option value="Medium">Medium (10-50% chance)</option>
                                        <option value="High">High (50-90% chance)</option>
                                        <option value="Very High">Very High (> 90% chance)</option>
                                    </select>
                                    <span asp-validation-for="Likelihood" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Severity of Consequences</label>
                                    <select asp-for="Severity" class="form-select" required>
                                        <option value="">Select severity...</option>
                                        <option value="Negligible">Negligible (Minor inconvenience)</option>
                                        <option value="Minor">Minor (Temporary disruption)</option>
                                        <option value="Moderate">Moderate (Significant impact)</option>
                                        <option value="Major">Major (Serious consequences)</option>
                                        <option value="Catastrophic">Catastrophic (Severe/fatal consequences)</option>
                                    </select>
                                    <span asp-validation-for="Severity" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Section 2: Current Controls -->
                        <div class="mb-4">
                            <h6><i class="fas fa-shield-alt"></i> 2. Current Risk Controls</h6>
                            <div class="mb-3">
                                <label class="form-label">Existing Safety Measures</label>
                                <textarea asp-for="ExistingControls" class="form-control" rows="3" 
                                          placeholder="List current safety controls, procedures, or barriers in place..."></textarea>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="form-label">Control Effectiveness</label>
                                    <select asp-for="ControlEffectiveness" class="form-select">
                                        <option value="">Select effectiveness...</option>
                                        <option value="Highly Effective">Highly Effective (90%+ risk reduction)</option>
                                        <option value="Effective">Effective (70-90% risk reduction)</option>
                                        <option value="Moderately Effective">Moderately Effective (50-70% risk reduction)</option>
                                        <option value="Limited Effectiveness">Limited Effectiveness (30-50% risk reduction)</option>
                                        <option value="Ineffective">Ineffective (< 30% risk reduction)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Residual Risk Level <span class="text-danger">*</span></label>
                                    <select asp-for="ResidualRisk" class="form-select" required>
                                        <option value="">Select residual risk...</option>
                                        <option value="Low">Low (Acceptable with monitoring)</option>
                                        <option value="Medium">Medium (Requires additional controls)</option>
                                        <option value="High">High (Requires immediate action)</option>
                                        <option value="Critical">Critical (Stop operations until mitigated)</option>
                                    </select>
                                    <span asp-validation-for="ResidualRisk" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Section 3: Recommended Actions -->
                        <div class="mb-4">
                            <h6><i class="fas fa-tools"></i> 3. Recommended Risk Mitigation</h6>
                            <div class="mb-3">
                                <label class="form-label">Recommended Actions</label>
                                <textarea asp-for="RecommendedActions" class="form-control" rows="4" 
                                          placeholder="Describe specific actions to reduce or eliminate the risk..." required></textarea>
                                <span asp-validation-for="RecommendedActions" class="text-danger"></span>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="form-label">Implementation Priority</label>
                                    <select asp-for="Priority" class="form-select" required>
                                        <option value="">Select priority...</option>
                                        <option value="Immediate">Immediate (Within 24 hours)</option>
                                        <option value="Urgent">Urgent (Within 1 week)</option>
                                        <option value="High">High (Within 1 month)</option>
                                        <option value="Medium">Medium (Within 3 months)</option>
                                        <option value="Low">Low (Within 6 months)</option>
                                    </select>
                                    <span asp-validation-for="Priority" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Estimated Cost</label>
                                    <select asp-for="EstimatedCost" class="form-select">
                                        <option value="">Select cost range...</option>
                                        <option value="Minimal">Minimal (< $1,000)</option>
                                        <option value="Low">Low ($1,000 - $10,000)</option>
                                        <option value="Medium">Medium ($10,000 - $50,000)</option>
                                        <option value="High">High ($50,000 - $100,000)</option>
                                        <option value="Very High">Very High (> $100,000)</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Section 4: Assessment Summary -->
                        <div class="mb-4">
                            <h6><i class="fas fa-clipboard"></i> 4. Assessment Summary</h6>
                            <div class="mb-3">
                                <label class="form-label">Assessor Comments</label>
                                <textarea asp-for="AssessorComments" class="form-control" rows="3" 
                                          placeholder="Additional observations, concerns, or recommendations..."></textarea>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="form-label">Assessment Confidence</label>
                                    <select asp-for="AssessmentConfidence" class="form-select">
                                        <option value="">Select confidence level...</option>
                                        <option value="High">High (Sufficient data, clear analysis)</option>
                                        <option value="Medium">Medium (Some uncertainty, additional data helpful)</option>
                                        <option value="Low">Low (Limited data, requires further investigation)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Follow-up Required</label>
                                    <select asp-for="RequiresFollowUp" class="form-select">
                                        <option value="No">No - Assessment complete</option>
                                        <option value="Monitoring">Monitoring - Track implementation</option>
                                        <option value="Review">Review - Reassess after actions</option>
                                        <option value="TRA">TRA - Requires Technical Risk Assessment</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row">
                            <div class="col-12">
                                <hr>
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <a href="/SafetyRiskManagement/ReportProcessing" class="btn btn-outline-secondary">
                                            <i class="fas fa-arrow-left"></i> Back to Processing Queue
                                        </a>
                                    </div>
                                    <div>
                                        <button type="submit" class="btn btn-outline-info" formaction="?handler=SaveDraft">
                                            <i class="fas fa-save"></i> Save as Draft
                                        </button>
                                        <button type="submit" class="btn btn-success btn-lg">
                                            <i class="fas fa-check-circle"></i> Complete Assessment
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Help Panel -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h6><i class="fas fa-question-circle"></i> Assessment Guidelines</h6>
                </div>
                <div class="card-body">
                    <h6>Risk Matrix</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered text-center">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th class="small">Negligible</th>
                                    <th class="small">Minor</th>
                                    <th class="small">Moderate</th>
                                    <th class="small">Major</th>
                                    <th class="small">Catastrophic</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <th class="small">Very High</th>
                                    <td class="bg-warning">Medium</td>
                                    <td class="bg-warning">Medium</td>
                                    <td class="bg-danger text-white">High</td>
                                    <td class="bg-danger text-white">High</td>
                                    <td class="bg-danger text-white">Critical</td>
                                </tr>
                                <tr>
                                    <th class="small">High</th>
                                    <td class="bg-success text-white">Low</td>
                                    <td class="bg-warning">Medium</td>
                                    <td class="bg-warning">Medium</td>
                                    <td class="bg-danger text-white">High</td>
                                    <td class="bg-danger text-white">High</td>
                                </tr>
                                <tr>
                                    <th class="small">Medium</th>
                                    <td class="bg-success text-white">Low</td>
                                    <td class="bg-success text-white">Low</td>
                                    <td class="bg-warning">Medium</td>
                                    <td class="bg-warning">Medium</td>
                                    <td class="bg-danger text-white">High</td>
                                </tr>
                                <tr>
                                    <th class="small">Low</th>
                                    <td class="bg-success text-white">Low</td>
                                    <td class="bg-success text-white">Low</td>
                                    <td class="bg-success text-white">Low</td>
                                    <td class="bg-warning">Medium</td>
                                    <td class="bg-warning">Medium</td>
                                </tr>
                                <tr>
                                    <th class="small">Very Low</th>
                                    <td class="bg-success text-white">Low</td>
                                    <td class="bg-success text-white">Low</td>
                                    <td class="bg-success text-white">Low</td>
                                    <td class="bg-success text-white">Low</td>
                                    <td class="bg-warning">Medium</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <h6 class="mt-3">Control Hierarchy</h6>
                    <ol class="small">
                        <li><strong>Elimination:</strong> Remove the hazard</li>
                        <li><strong>Substitution:</strong> Replace with safer alternative</li>
                        <li><strong>Engineering:</strong> Physical safeguards</li>
                        <li><strong>Administrative:</strong> Procedures and training</li>
                        <li><strong>PPE:</strong> Personal protective equipment</li>
                    </ol>

                    <h6 class="mt-3">ALARP Principle</h6>
                    <p class="small">Risks should be reduced to <strong>As Low As Reasonably Practicable</strong> (ALARP), considering cost-benefit and available technology.</p>
                </div>
            </div>

            <!-- Assessment Progress -->
            <div class="card mt-3">
                <div class="card-header">
                    <h6><i class="fas fa-chart-bar"></i> Assessment Progress</h6>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <small class="text-muted">Risk Level Assessment</small>
                        <div class="progress">
                            <div class="progress-bar bg-success" style="width: 25%"></div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted">Current Controls</small>
                        <div class="progress">
                            <div class="progress-bar bg-success" style="width: 25%"></div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted">Recommended Actions</small>
                        <div class="progress">
                            <div class="progress-bar bg-success" style="width: 25%"></div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted">Assessment Summary</small>
                        <div class="progress">
                            <div class="progress-bar bg-success" style="width: 25%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Pure C# Razor Pages - No JavaScript -->
}

