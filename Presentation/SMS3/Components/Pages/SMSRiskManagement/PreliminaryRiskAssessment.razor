@page "/SMSRiskManagement/PreliminaryRiskAssessment"
@page "/SMSRiskManagement/PreliminaryRiskAssessment/{AssessmentId}"
@page "/SMSRiskManagement/PreliminaryRiskAssessment/{AssessmentId}/{HazardId}"
@using SMS_Application.Messaging.Commands
@using SMS_Application.Messaging.Queries
@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using SMS_Domain.ValueObjects
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared

<PageTitle>Preliminary Risk Assessment - SMS3</PageTitle>

<!-- SMS Page Header using reusable component -->
<PageHeader Title="Preliminary Risk Assessment"
           Subtitle="Conduct initial risk evaluation and severity classification for reported hazards"
           Icon="fas fa-chart-line" />

<!-- Breadcrumb -->

@if (IsLoading)
{
    <RadzenCard>
        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.H6" Text="Loading assessment..." />
        </RadzenStack>
    </RadzenCard>
}
else
{
    <RadzenRow Gap="1rem">
        <!-- Main Form -->
        <RadzenColumn Size="12" SizeLG="8">
            <RadzenCard>
                <RadzenStack Gap="1.5rem">
                    <RadzenText TextStyle="TextStyle.H5" Style="color: var(--rz-success); margin: 0;">
                        <RadzenIcon Icon="assignment" Style="margin-right: 0.5rem;" />
                        @if (!string.IsNullOrWhiteSpace(HazardId) && Hazard != null)
                        {
                            <text>Preliminary Risk Assessment - Report @(Hazard.ReportCode) - Hazard @HazardId</text>
                        }
                        else if (!string.IsNullOrWhiteSpace(HazardId))
                        {
                            <text>Preliminary Risk Assessment - Hazard @HazardId</text>
                        }
                        else
                        {
                            <text>Preliminary Risk Assessment</text>
                        }
                    </RadzenText>

                    <!-- Hazard Summary - Collapsible -->
                    @if (Hazard != null)
                    {
                        <RadzenAccordion>
                            <Items>
                                <RadzenAccordionItem Text="Hazard Summary" Icon="warning" IconColor="@Colors.Warning">
                                    <RadzenCard Variant="Variant.Text" Style="background-color: #f8f9fa; margin: 0;">
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Type:</strong> @Hazard.HazardType</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Location:</strong> @Hazard.Location</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Description:</strong> @Hazard.Description</RadzenText>
                                            @if (!string.IsNullOrWhiteSpace(Hazard.ReportedBy))
                                            {
                                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Reported By:</strong> @Hazard.ReportedBy</RadzenText>
                                            }
                                            @if (Hazard.ReportedOn != default)
                                            {
                                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Reported On:</strong> @Hazard.ReportedOn.ToString("MM/dd/yyyy HH:mm")</RadzenText>
                                            }
                                        </RadzenStack>
                                    </RadzenCard>
                                </RadzenAccordionItem>
                            </Items>
                        </RadzenAccordion>
                    }

                    <!-- Section 1: Immediate Risk Level -->
                    <RadzenFieldset Text="1. Immediate Risk Level Assessment">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Likelihood of Occurrence *" Variant="Variant.Outlined">
                                    <RadzenDropDown @bind-Value="@Model.Likelihood" Data="@LikelihoodOptions" 
                                                    Placeholder="Select likelihood..." Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenText TextStyle="TextStyle.Caption" Text="Probability this hazard will occur" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Severity of Consequences *" Variant="Variant.Outlined">
                                    <RadzenDropDown @bind-Value="@Model.Severity" Data="@SeverityOptions" 
                                                    Placeholder="Select severity..." Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenText TextStyle="TextStyle.Caption" Text="Impact if this hazard occurs" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenFieldset>

                    <!-- Section 2: Current Controls -->
                    <RadzenFieldset Text="2. Current Risk Controls">
                        <RadzenStack Gap="1rem">
                            <RadzenFormField Text="Existing Safety Measures" Variant="Variant.Outlined">
                                <RadzenTextArea @bind-Value="@Model.ExistingControls" Rows="3"
                                                Placeholder="List current safety controls, procedures, or barriers in place..."
                                                Style="width: 100%;" />
                            </RadzenFormField>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Control Effectiveness" Variant="Variant.Outlined">
                                        <RadzenDropDown @bind-Value="@Model.ControlEffectiveness" Data="@EffectivenessOptions"
                                                        Placeholder="Select effectiveness..." Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Residual Risk Level *" Variant="Variant.Outlined">
                                        <RadzenDropDown @bind-Value="@Model.ResidualRisk" Data="@ResidualRiskOptions"
                                                        Placeholder="Select residual risk..." Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Section 3: Recommended Actions -->
                    <RadzenFieldset Text="3. Recommended Risk Mitigation">
                        <RadzenStack Gap="1rem">
                            <RadzenFormField Text="Recommended Actions *" Variant="Variant.Outlined">
                                <RadzenTextArea @bind-Value="@Model.RecommendedActions" Rows="4"
                                                Placeholder="Describe specific actions to reduce or eliminate the risk..."
                                                Style="width: 100%;" />
                            </RadzenFormField>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Implementation Priority *" Variant="Variant.Outlined">
                                        <RadzenDropDown @bind-Value="@Model.Priority" Data="@PriorityOptions"
                                                        Placeholder="Select priority..." Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Estimated Cost" Variant="Variant.Outlined">
                                        <RadzenDropDown @bind-Value="@Model.EstimatedCost" Data="@CostOptions"
                                                        Placeholder="Select cost range..." Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Section 4: Assessment Summary -->
                    <RadzenFieldset Text="4. Assessment Summary">
                        <RadzenStack Gap="1rem">
                            <RadzenFormField Text="Assessor Comments" Variant="Variant.Outlined">
                                <RadzenTextArea @bind-Value="@Model.AssessorComments" Rows="3"
                                                Placeholder="Additional observations, concerns, or recommendations..."
                                                Style="width: 100%;" />
                            </RadzenFormField>

                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Assessment Confidence" Variant="Variant.Outlined">
                                        <RadzenDropDown @bind-Value="@Model.AssessmentConfidence" Data="@ConfidenceOptions"
                                                        Placeholder="Select confidence level..." Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Follow-up Required" Variant="Variant.Outlined">
                                        <RadzenDropDown @bind-Value="@Model.RequiresFollowUp" Data="@FollowUpOptions"
                                                        Placeholder="Select follow-up..." Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>

                    <!-- Action Buttons -->
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="border-top: 1px solid #ddd; padding-top: 1rem;">
                        <RadzenButton Text="Back to Processing Queue" Icon="arrow_back" ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => Navigation.NavigateTo("/SMSRiskManagement/ReportProcessing"))" />
                        
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenButton Text="Save as Draft" Icon="save" ButtonStyle="ButtonStyle.Secondary"
                                          Click="@SaveDraft" Disabled="@IsSaving" />
                            <RadzenButton Text="Complete Assessment" Icon="check_circle" ButtonStyle="ButtonStyle.Success"
                                          Size="ButtonSize.Large" Click="@CompleteAssessment" Disabled="@IsSaving" />
                        </RadzenStack>
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <!-- Help Panel -->
        <RadzenColumn Size="12" SizeLG="4">
            <RadzenStack Gap="1rem">
                <!-- Risk Matrix -->
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-success); margin: 0;">
                            <RadzenIcon Icon="help" Style="margin-right: 0.5rem;" />
                            Assessment Guidelines
                        </RadzenText>

                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Risk Matrix" Style="margin: 0;" />
                        <div style="overflow-x: auto;">
                            <table class="table table-bordered table-sm text-center">
                                <thead>
                                    <tr>
                                        <th style="font-size: 0.75rem;"></th>
                                        <th style="font-size: 0.75rem;">Negligible</th>
                                        <th style="font-size: 0.75rem;">Minor</th>
                                        <th style="font-size: 0.75rem;">Moderate</th>
                                        <th style="font-size: 0.75rem;">Major</th>
                                        <th style="font-size: 0.75rem;">Catastrophic</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <th style="font-size: 0.75rem;">Very High</th>
                                        <td style="background-color: #ffc107; font-size: 0.75rem;">Medium</td>
                                        <td style="background-color: #ffc107; font-size: 0.75rem;">Medium</td>
                                        <td style="background-color: #dc3545; color: white; font-size: 0.75rem;">High</td>
                                        <td style="background-color: #dc3545; color: white; font-size: 0.75rem;">High</td>
                                        <td style="background-color: #dc3545; color: white; font-size: 0.75rem;">Critical</td>
                                    </tr>
                                    <tr>
                                        <th style="font-size: 0.75rem;">High</th>
                                        <td style="background-color: #28a745; color: white; font-size: 0.75rem;">Low</td>
                                        <td style="background-color: #ffc107; font-size: 0.75rem;">Medium</td>
                                        <td style="background-color: #ffc107; font-size: 0.75rem;">Medium</td>
                                        <td style="background-color: #dc3545; color: white; font-size: 0.75rem;">High</td>
                                        <td style="background-color: #dc3545; color: white; font-size: 0.75rem;">High</td>
                                    </tr>
                                    <tr>
                                        <th style="font-size: 0.75rem;">Medium</th>
                                        <td style="background-color: #28a745; color: white; font-size: 0.75rem;">Low</td>
                                        <td style="background-color: #28a745; color: white; font-size: 0.75rem;">Low</td>
                                        <td style="background-color: #ffc107; font-size: 0.75rem;">Medium</td>
                                        <td style="background-color: #ffc107; font-size: 0.75rem;">Medium</td>
                                        <td style="background-color: #dc3545; color: white; font-size: 0.75rem;">High</td>
                                    </tr>
                                    <tr>
                                        <th style="font-size: 0.75rem;">Low</th>
                                        <td style="background-color: #28a745; color: white; font-size: 0.75rem;">Low</td>
                                        <td style="background-color: #28a745; color: white; font-size: 0.75rem;">Low</td>
                                        <td style="background-color: #28a745; color: white; font-size: 0.75rem;">Low</td>
                                        <td style="background-color: #ffc107; font-size: 0.75rem;">Medium</td>
                                        <td style="background-color: #ffc107; font-size: 0.75rem;">Medium</td>
                                    </tr>
                                    <tr>
                                        <th style="font-size: 0.75rem;">Very Low</th>
                                        <td style="background-color: #28a745; color: white; font-size: 0.75rem;">Low</td>
                                        <td style="background-color: #28a745; color: white; font-size: 0.75rem;">Low</td>
                                        <td style="background-color: #28a745; color: white; font-size: 0.75rem;">Low</td>
                                        <td style="background-color: #28a745; color: white; font-size: 0.75rem;">Low</td>
                                        <td style="background-color: #ffc107; font-size: 0.75rem;">Medium</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Control Hierarchy" Style="margin: 0;" />
                        <ol style="font-size: 0.875rem;">
                            <li><strong>Elimination:</strong> Remove the hazard</li>
                            <li><strong>Substitution:</strong> Replace with safer alternative</li>
                            <li><strong>Engineering:</strong> Physical safeguards</li>
                            <li><strong>Administrative:</strong> Procedures and training</li>
                            <li><strong>PPE:</strong> Personal protective equipment</li>
                        </ol>

                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="ALARP Principle" Style="margin: 0;" />
                        <RadzenText TextStyle="TextStyle.Caption">
                            Risks should be reduced to <strong>As Low As Reasonably Practicable</strong> (ALARP), considering cost-benefit and available technology.
                        </RadzenText>
                    </RadzenStack>
                </RadzenCard>

                <!-- Assessment Progress -->
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-primary); margin: 0;">
                            <RadzenIcon Icon="analytics" Style="margin-right: 0.5rem;" />
                            Assessment Progress
                        </RadzenText>

                        <RadzenStack Gap="0.5rem">
                            <div>
                                <RadzenText TextStyle="TextStyle.Caption" Text="Risk Level Assessment" Style="margin: 0;" />
                                <RadzenProgressBar Value="@GetSectionProgress(1)" Style="width: 100%;" />
                            </div>
                            <div>
                                <RadzenText TextStyle="TextStyle.Caption" Text="Current Controls" Style="margin: 0;" />
                                <RadzenProgressBar Value="@GetSectionProgress(2)" Style="width: 100%;" />
                            </div>
                            <div>
                                <RadzenText TextStyle="TextStyle.Caption" Text="Recommended Actions" Style="margin: 0;" />
                                <RadzenProgressBar Value="@GetSectionProgress(3)" Style="width: 100%;" />
                            </div>
                            <div>
                                <RadzenText TextStyle="TextStyle.Caption" Text="Assessment Summary" Style="margin: 0;" />
                                <RadzenProgressBar Value="@GetSectionProgress(4)" Style="width: 100%;" />
                            </div>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
}