@page "/SMSRiskManagement/TechnicalAssessment"
@page "/SMSRiskManagement/TechnicalAssessment/{ReportId}"
@page "/SMSRiskManagement/TechnicalAssessment/{ReportId}/{HazardId}"
@page "/SMSRiskManagement/TechnicalAssessment/{ReportId}/{HazardId}/{StepNumber}"

@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Pages.SMSRiskManagement.Components
@using SMS3.Components.Shared
@using SMS_Application.Commands
@using SMS_Application.Queries
@using SMS_Domain.Entities
@using SMS_Domain.Enums

<PageTitle>Technical Assessment - SMS3</PageTitle>

<!-- SMS Page Header using reusable component -->
<PageHeader Title="Technical Assessment" 
           Subtitle="@($"{AssessmentName}")"
           Icon="fas fa-cogs" />

<RadzenRow Gap="1rem">
    <RadzenColumn Size="12">
        <!-- Assessment Header -->
        <RadzenCard Variant="Variant.Outlined" Style="margin-bottom: 1rem;">
            <RadzenCard>
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="0.25rem">
                            <RadzenText TextStyle="TextStyle.H5" Style="margin: 0;">
                                <RadzenIcon Icon="@GetStepIcon(CurrentStep)" Style="margin-right: 0.5rem;" />
                                 Step @CurrentStep: @GetStepName(CurrentStep)
                            </RadzenText>
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem">
                            <RadzenButton Text="Report Description"
                                          Icon="description"
                                          ButtonStyle="ButtonStyle.Base"
                                          Variant="Variant.Filled"
                                          Size="ButtonSize.Small"
                                          Title="Click to view full description"
                                          Class="description-button"
                                          Click="@ShowDescriptionDialog" />
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                            Lead Assessor :
                            @if (!string.IsNullOrWhiteSpace(LeadAssessorName))
                            {
                               <RadzenBadge Text="@LeadAssessorName" IsPill="true" BadgeStyle="BadgeStyle.Success" />
                            }
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        </RadzenCard>

        <!-- Progress Bar -->
        <RadzenCard Variant="Variant.Outlined" Style="margin-bottom: 1rem;">
            <RadzenCard Style="padding: 1rem;">
                <RadzenRow>
                    <RadzenColumn Size="12">
                        <RadzenProgressBar Value="@((double)CurrentStep / 5 * 100)" ShowValue="false" Style="height: 8px;" />
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="margin-top: 0.5rem;">
                            @for (int step = 1; step <= 5; step++)
                            {
                                var stepNumber = step; // Capture for lambda
                                var isCurrentStep = step == CurrentStep;
                                var isCompleted = step < CurrentStep;
                                var buttonStyle = isCurrentStep ? ButtonStyle.Primary : (isCompleted ? ButtonStyle.Success : ButtonStyle.Light);
                                var icon = isCompleted ? "check_circle" : (isCurrentStep ? "edit" : "radio_button_unchecked");

                                <RadzenButton Text="@($"Step {step} {GetStepName(step)}")"
                                              Icon="@icon"
                                            ButtonStyle="@buttonStyle" 
                                            Size="ButtonSize.Medium"
                                            Click="@(() => NavigateToStep(stepNumber))"
                                            Disabled="@IsSaving"
                                            title="@($"Step {step}: {GetStepName(step)}")" />
                            }
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        </RadzenCard>

        <!-- Step Content -->
        <RadzenCard>
            <RadzenCard>
                @if (IsLoading)
                {
                    <RadzenStack AlignItems="AlignItems.Center" Style="padding: 2rem;">
                        <RadzenProgressBarCircular ShowValue="false" />
                        <RadzenText Text="Loading assessment data..." />
                    </RadzenStack>
                }
                else if (TechRiskAssessment is null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Icon="error" Title="Assessment Not Found">
                        The requested assessment could not be loaded. Please check the assessment ID and try again.
                    </RadzenAlert>
                }
                else
                {
                    <!-- Render Current Step -->
                    @switch (CurrentStep)
                    {
                        case 1:
                            <TechnicalAssessmentStep1 Step1="@Step1" 
                                                     Step1Changed="@UpdateStep1"
                                                     AvailableAssessors="AvailableAssessors"
                                                     StakeholderGroups="StakeholderGroups"
                                                     AvailableStakeholders="AvailableStakeholders" />
                            break;
                        case 2:
                            <TechnicalAssessmentStep2 Step1="@Step1"
                                                     Step2="@Step2" 
                                                     Step2Changed="@UpdateStep2"
                                                     Step2Hazards="@ReportedHazards"
                                                     ReportId="@ReportId"
                                                     RiskAssessmentId="@TechRiskAssessment.Code"
                                                     InitialHazardId="@HazardId"
                                                     OnHazardAdded="@AddHazard"
                                                     OnHazardUpdated="@UpdateHazard"
                                                     OnHazardDeleted="@DeleteHazard" />
                            break;
                        case 3:
                            <TechnicalAssessmentStep3 Step1="@Step1"
                                                     Step3="@Step3" 
                                                     Step3Changed="@UpdateStep3"
                                                     Step3Hazards="@ReportedHazards" />
                            break;
                        case 4:
                            <TechnicalAssessmentStep4 Step4="@Step4" 
                                                     Step4Changed="@UpdateStep4"
                                                     Step4Hazards="@ReportedHazards"
                                                     AvailableStakeholders="@AvailableStakeholders"
                                                     AvailableAssessors="@AvailableAssessors"
                                                     CurrentStep="@CurrentStep"
                                                     CurrentRiskAssessment="@TechRiskAssessment"
                                                     RiskAssessmentId="@(TechRiskAssessment?.Id is not null ? new RiskAssessmentID(TechRiskAssessment.Id.Value) : null)" />
                            break;
                        case 5:
                            <TechnicalAssessmentStep5 Step4="@Step4"
                                                     Step5="@Step5" 
                                                     Step5Changed="@UpdateStep5"
                                                     Step5Hazards="@ReportedHazards"
                                                     AvailableStakeholders="AvailableStakeholders"
                                                     AvailableAssessors="AvailableAssessors"
                                                     CurrentStep="@CurrentStep"
                                                     CurrentRiskAssessment="@TechRiskAssessment"
                                                      />
                            break;
                        default:
                            <RadzenAlert AlertStyle="AlertStyle.Warning" Text="Invalid step number. Please select a valid step." />
                            break;
                    }
                }
            </RadzenCard>
        </RadzenCard>

        <!-- Navigation Buttons -->
        @if (TechRiskAssessment is not null && !IsLoading)
        {
            <RadzenCard Style="margin-top: 1rem;">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                        <!-- Previous Button -->
                        <RadzenButton Text="Previous Step" 
                                     Icon="arrow_back" 
                                     ButtonStyle="ButtonStyle.Light"
                                     Disabled="@(CurrentStep <= 1 || IsSaving)"
                                     Click="@PreviousStep" />

                                                

                        <!-- Next/Complete Button -->
                        @if (CurrentStep < 5)
                        {
                            <RadzenButton Text="Next Step" 
                                         Icon="arrow_forward" 
                                         ButtonStyle="ButtonStyle.Success"
                                         Disabled="IsSaving"
                                         Click="@NextStep" />
                        }
                        else
                        {
                            <RadzenButton Text="Submit Assessment" 
                                         Icon="check_circle" 
                                         ButtonStyle="ButtonStyle.Primary"
                                         Disabled="IsSaving"
                                         Click="@SubmitAssessment" />
                        }
                    </RadzenStack>
                </RadzenCard>
            </RadzenCard>
        }
    </RadzenColumn>
</RadzenRow>

@if (ShowDescriptionModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-md">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-file-alt"></i> Report Description - @SelectedReportId
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Text"
                                      Icon="close"
                                      Size="ButtonSize.Small"
                                      Click="@CloseDescriptionModal" />
                    </div>
                </div>
                <div class="sms-modal-body">
                    <RadzenCard Variant="Variant.Outlined">
                        <div class="p-3">
                            <RadzenText TextStyle="TextStyle.Body1" Style="line-height: 1.6; white-space: pre-wrap;">
                                @SelectedDescription
                            </RadzenText>
                        </div>
                    </RadzenCard>
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end">
                        <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                      Text="Close"
                                      Icon="close"
                                      Click="@CloseDescriptionModal"
                                      Size="ButtonSize.Medium" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<style>
    .sms-modal-xxl {
        max-width: 1400px;
        width: 95%;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 1rem;
    }

    .sms-modal-dialog {
        position: relative;
        margin: 0 auto;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
    }

    .sms-modal-md {
        max-width: 700px;
        width: 100%;
    }

    .sms-modal-content {
        background: white;
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    }

    .sms-modal-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e9ecef;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .sms-header-primary {
        background-color: #212e61; /* SMS Blue Dark Bold */
        color: white;
    }

    .sms-modal-title {
        margin: 0;
        font-weight: 600;
    }

    .sms-modal-body {
        max-height: calc(100vh - 200px);
        overflow-y: auto;
    }

    .sms-modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid #e9ecef;
        border-radius: 0 0 0.5rem 0.5rem;
    }

</style>