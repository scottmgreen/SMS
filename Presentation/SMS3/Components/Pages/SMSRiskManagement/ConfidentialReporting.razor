@page "/SMSRiskManagement/ConfidentialReporting"
@layout SMS3.Components.Layout.AnonymousLayout

@using SMS3.Components.Shared
@using SMS3.Components.Pages.SMSRiskManagement.Models
@using SMS_Application.Messaging.Commands
@using SMS_Application.Messaging.Queries
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@using SMS_Domain.Enums

<PageTitle>Submit Confidential Report - SMS3</PageTitle>

<!-- SMS Page Header using reusable component -->
<PageHeader Title="@PageTitle"
           Subtitle="@PageSubtitle"
           Icon="fas fa-user-secret" />

@if (IsLoading)
{
    <!-- Loading State -->
    <div class="text-center py-5">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        <p class="mt-3 text-muted">Processing your confidential report...</p>
    </div>
}
else if (ShowFinalSuccessConfirmation)
{
    <!-- Final Success Modal -->
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-lg">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-success">
                    <h5 class="sms-modal-title">
                        <i class="fas fa-check-circle"></i> Confidential Report Successfully Submitted!
                    </h5>
                </div>
                <div class="sms-modal-body">
                    
                    <!-- Report Details -->
                    <RadzenCard Variant="Variant.Outlined" Class="mb-3">
                        <div class="p-3">
                            <h6 class="text-primary mb-2">
                                <i class="fas fa-info-circle"></i> Report Summary
                            </h6>
                            <div class="row">
                                <div class="col-sm-6">
                                    <strong>Tracking ID:</strong> @GeneratedTrackingId<br>
                                    <strong>Hazard ID:</strong> @GeneratedHazardId<br>
                                    <strong>Status:</strong> <RadzenBadge Text="Submitted" BadgeStyle="BadgeStyle.Success" />
                                </div>
                                <div class="col-sm-6">
                                    <strong>Submitted:</strong> @SubmissionDateTime?.ToString("MM/dd/yyyy HH:mm")<br>
                                    <strong>Confidential:</strong> Yes
                                </div>
                            </div>
                        </div>
                    </RadzenCard>

                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Class="mb-3">
                        <h6 class="mb-1">
                            <i class="fas fa-shield-alt"></i> Your Identity is Protected
                        </h6>
                        <p class="mb-0">Your confidential report has been submitted anonymously and will be reviewed by authorized SMS personnel only. Save your tracking ID for future reference.</p>
                    </RadzenAlert>

                    <div class="text-center">
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                    Click="CloseFinalConfirmation" 
                                    Text="Continue & Clear Form" 
                                    Icon="check"
                                    Size="ButtonSize.Medium" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Main Content -->
    <RadzenRow Gap="1rem">
        <!-- Form Column -->
        <RadzenColumn Size="8">
            <RadzenCard>
                <RadzenStack Gap="1rem" Class="rz-p-3">
                    <!-- Confidentiality Notice -->
                    <RadzenAlert Size="AlertSize.Small" Variant="Variant.Flat">
                        <strong>Confidential Protection:</strong> Your identity will be protected and access to this report will be restricted to authorized SMS personnel only.
                        <br><strong>Benefits:</strong> Enhanced protection from retaliation, restricted access, anonymous follow-up options.
                        <br><strong>Note:</strong> Confidential reports may take longer to process due to additional security measures.
                    </RadzenAlert>

                    <RadzenTemplateForm Data="@HazardReport" Submit="@HandleFormSubmit" TItem="HazardReportForm">
                        <!-- Row 1: Reported On and Reported By and Reporting Department -->
                        <RadzenRow Gap="1rem" Class="rz-mb-3">
                            <RadzenColumn Size="2">
                                <RadzenFormField Text="Reported On *" Variant="Variant.Outlined">
                                    <RadzenDatePicker @bind-Value="@HazardReport.ReportedOn" 
                                                    ShowTime="true"
                                                    DateFormat="MM/dd/yyyy HH:mm"
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="4">
                                <RadzenFormField Text="Reported By *" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenTextBox @bind-Value="@HazardReport.ReportedBy" 
                                                 Placeholder="Name and position (e.g., 'John Smith - Ground Operations Supervisor')"
                                                 Name="ReportedBy"
                                                 MaxLength="60"
                                                 Style="width: 100%;min-width: 100%;" 
                                                 ReadOnly ="true"
                                                 />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="ReportedBy" Text="Reported by is required" />
                            </RadzenColumn>
                            @* <RadzenColumn Size="6">
                                <RadzenFormField Text="Reporting Department *" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="@HazardReport.ReportingDepartment"
                                                Placeholder="Enter reporting department or organization..."
                                                Name="ReportingDepartment"
                                                MaxLength="200"
                                                Style="width: 100%; min-width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="ReportingDepartment" Text="Reporting Department by is required" />
                            </RadzenColumn> *@
                        </RadzenRow>

                        <!-- Row 2: Hazard Category and Hazard Type -->
                        <RadzenRow Gap="1rem" Class="rz-mb-3">
                            
                            <RadzenColumn Size="3">
                                <RadzenFormField Text="Hazard Category *" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenDropDown @bind-Value="@HazardReport.HazardCategory"
                                                  Data="@HazardCategoryOptions" 
                                                  TextProperty="Text" 
                                                  ValueProperty="Value"
                                                  Placeholder="Select hazard category..."
                                                  Name="HazardCategory"
                                                  Change="@(async (object value) => await OnHazardCategoryChanged(value?.ToString()))"
                                                  AllowClear="true"
                                                  Style="width: 100%; min-width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="HazardCategory" Text="Hazard category is required" />
                            </RadzenColumn>
                            <RadzenColumn Size="3">
                                <RadzenFormField Text="Hazard Type *" Variant="Variant.Outlined" Style="width: 100%;">
                                    <RadzenDropDown @bind-Value="@HazardReport.HazardType" 
                                                  Data="@HazardTypeOptions" 
                                                  TextProperty="Text" 
                                                  ValueProperty="Value"
                                                  Placeholder="Select hazard type..."
                                                  Name="HazardType"
                                                  Change="@(async (object value) => await OnHazardTypeChanged(value?.ToString()))"
                                                  Disabled="@(HazardTypeOptions.Count == 0)"
                                                  AllowClear="true"
                                                  Style="width: 100%; min-width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="HazardType" Text="Hazard type is required" />
                                @if (HazardTypeOptions.Count == 0 && string.IsNullOrEmpty(SelectedHazardCategory))
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-info rz-mt-1">
                                        <RadzenIcon Icon="info" Style="font-size: 0.9rem;" />
                                        Select a category first to see hazard types
                                    </RadzenText>
                                }
                            </RadzenColumn>
                            <RadzenRow>
                                <RadzenColumn Size="12">
                                    @* Guidance Panel for Selected Hazard Type *@
                                    @if (!string.IsNullOrEmpty(HazardReport.HazardType))
                                    {
                                        <RadzenCard Variant="Variant.Text" Class="sms-guidance-mini">
                                            <RadzenStack Gap="0.5rem" Class="rz-p-2">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                                    <RadzenIcon Icon="info" Style="color: var(--rz-primary); font-size: 1rem;" />
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; color: var(--rz-primary);">Hazard Type Guidance</RadzenText>
                                                </RadzenStack>

                                                @if (RequiresRegulatoryReporting(HazardReport.HazardType))
                                                {
                                                    <RadzenAlert AlertStyle="AlertStyle.Warning" Size="AlertSize.Small" Variant="Variant.Flat">
                                                        <strong>Regulatory Reporting Required</strong>
                                                    </RadzenAlert>
                                                }

                                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; font-size: 0.85rem;">
                                                    @GetHazardTypeGuidance(HazardReport.HazardType)
                                                </RadzenText>

                                                @if (!string.IsNullOrEmpty(SelectedHazardCategory))
                                                {
                                                    <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; font-style: italic; color: var(--rz-text-secondary-color);">
                                                        Category: @GetHazardCategoryDescription(SelectedHazardCategory)
                                                    </RadzenText>
                                                }
                                            </RadzenStack>
                                        </RadzenCard>
                                    }
                                    else if (!string.IsNullOrEmpty(SelectedHazardCategory))
                                    {
                                        <RadzenCard Variant="Variant.Text" Class="sms-guidance-mini">
                                            <RadzenStack Gap="0.5rem" Class="rz-p-2">
                                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                                    <RadzenIcon Icon="category" Style="color: var(--rz-primary); font-size: 1rem;" />
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; color: var(--rz-primary);">Category Information</RadzenText>
                                                </RadzenStack>
                                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; font-size: 0.85rem;">
                                                    @GetHazardCategoryDescription(SelectedHazardCategory)
                                                </RadzenText>
                                                <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: var(--rz-info);">
                                                    <RadzenIcon Icon="arrow_forward" Style="font-size: 0.8rem;" />
                                                    Select a hazard type for specific guidance
                                                </RadzenText>
                                            </RadzenStack>
                                        </RadzenCard>
                                    }
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenRow>

                        <!-- Row 3: Hazard Description  -->
                        <RadzenRow Gap="1rem" Class="rz-mb-3">
                            <RadzenColumn Size="12">
                                <RadzenFormField Text="Detailed Description *" Variant="Variant.Outlined">
                                    <RadzenTextArea @bind-Value="@HazardReport.Description" 
                                                  Rows="4" Cols="200"
                                                  Name="Description"
                                                  Placeholder="Provide a detailed description of the hazard including what happened, when, who was involved, conditions, immediate actions taken, and potential consequences..."
                                                  Style="width: 100%;min-width:100%" />
                                </RadzenFormField>
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Class="rz-mt-1">
                                    <RadzenRequiredValidator Component="Description" Text="Description is required" />
                                    <RadzenText TextStyle="TextStyle.Caption" 
                                              Class="@(DescriptionCharacterCount > 1950 ? "rz-color-danger" : DescriptionCharacterCount > 1800 ? "rz-color-warning" : "rz-color-base-500")">
                                        @DescriptionCharacterCount/2000 characters
                                    </RadzenText>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>

                        
                        <!-- Row 4: Location Selection -->
                        <RadzenFieldset Text="Hazard Location" Style="margin-bottom: 1rem;">
                            <div class="location-row rz-mt-1">
                                <div class="location-button">
                                    <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                                  Click="OpenMapSelector"
                                                  Text="Select on Map"
                                                  Icon="map"
                                                  Size="ButtonSize.Medium"
                                                  Style="width:100%;min-width:100%; height: 42px;" />
                                </div>

                                <div class="location-coordinate">
                                    <RadzenFormField Text="Latitude" Variant="Variant.Outlined">
                                        <RadzenTextBox Value="@SelectedLatitudeText"
                                                       ReadOnly="true"
                                                       Placeholder="Select location first"
                                                       Style="background-color: #f8f9fa; border-color: #dee2e6; width: 100%;" />
                                    </RadzenFormField>
                                </div>

                                <div class="location-coordinate">
                                    <RadzenFormField Text="Longitude" Variant="Variant.Outlined">
                                        <RadzenTextBox Value="@SelectedLongitudeText"
                                                       ReadOnly="true"
                                                       Placeholder="Select location first"
                                                       Style="background-color: #f8f9fa; border-color: #dee2e6; width: 100%;" />
                                    </RadzenFormField>
                                </div>

                                <div class="location-description">
                                    <RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width: 100%;">
                                        <RadzenTextBox @bind-Value="@LocationDescription"
                                                       Placeholder="Optional description (e.g., 'Terminal A, Gate 5, near security checkpoint')"
                                                       Style="width: 100%;" />
                                    </RadzenFormField>
                                </div>
                            </div>
                        </RadzenFieldset>


                        <!-- Row 5: Supporting Documents -->
                        <RadzenRow Gap="1rem" Class="rz-mb-3">
                            <RadzenColumn Size="12">
                                <RadzenFormField Text="Supporting Documents" Variant="Variant.Outlined" Style="width: 100%;">
                                    <InputFile OnChange="@OnInputFileChange" 
                                             multiple 
                                             accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.txt"
                                             style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 0.25rem;" />
                                            
                                </RadzenFormField>
                                <br />
                                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-base-500 rz-mt-1">
                                    <RadzenIcon Icon="attach_file" Style="font-size: 0.9rem;" /> 
                                    Supported: JPG, PNG, PDF, DOC, DOCX, TXT (Max 10MB per file)
                                    
                                </RadzenText>
                                @if (AttachedFiles.Any())
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Base" Size="AlertSize.Small" Variant="Variant.Flat" Class="rz-mt-6">
                                        <RadzenStack Gap="1rem">
                                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                                <strong>Queued files (@AttachedFiles.Count):</strong>
                                                <RadzenButton ButtonStyle="ButtonStyle.Base" 
                                                            Variant="Variant.Text"
                                                            Icon="clear_all" 
                                                            Text="Clear All"
                                                            Size="ButtonSize.ExtraSmall"
                                                            Click="ClearAllFiles" />
                                            </RadzenStack>
                                            
                                            <RadzenStack Gap="0.5rem">
                                                @for (int i = 0; i < AttachedFiles.Count; i++)
                                                {
                                                    var file = AttachedFiles[i];
                                                    var fileIndex = i;
                                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" 
                                                               Style="padding: 0.25rem 0.5rem; border: 1px solid #dee2e6; border-radius: 0.25rem; background-color: #f8f9fa;">
                                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                            <RadzenIcon Icon="attach_file" Style="color: var(--sms-blue-dark-bold); font-size: 0.9rem;" />
                                                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                                                                @file.FileName (@file.SizeDisplay)
                                                            </RadzenText>
                                                        </RadzenStack>
                                                        <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                                                    Variant="Variant.Text"
                                                                    Icon="close" 
                                                                    Size="ButtonSize.ExtraSmall"
                                                                    Click="@(() => RemoveFile(fileIndex))"
                                                                    Text="" />
                                                    </RadzenStack>
                                                }
                                            </RadzenStack>
                                        </RadzenStack>
                                    </RadzenAlert>
                                }
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Form Actions -->
                        <!-- Row 6: Confidential Flag at Bottom -->
                        <RadzenRow Gap="1rem" Class="rz-border-top-1 rz-pt-3">
                            <RadzenColumn>
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="0.5rem">
                                    <RadzenCheckBox @bind-Value="@HazardReport.IsConfidential"
                                                    Name="IsConfidential"
                                                    TriState="false" />
                                    <RadzenLabel Style="font-weight:600"  Text="Submit as Confidential Report" Component="IsConfidential" />
                                </RadzenStack>
                            </RadzenColumn>
                            
                            <RadzenColumn>
                                @if (!ShowSubmissionConfirmation && !ShowFinalSuccessConfirmation)
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                                        
                                        <RadzenButton ButtonStyle="ButtonStyle.Warning" 
                                                    Icon="clear"
                                                    Text="Clear Form"
                                                    Size="ButtonSize.Medium"
                                                    Click="ClearForm" />
                                        <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                                    Icon="send"
                                                    Text="Submit Report"
                                                    Size="ButtonSize.Medium"
                                                    Click="ShowSubmissionConfirmationDialog"
                                                    Disabled="@(!IsFormValidForSubmission)" />
                                    </RadzenStack>
                                }
                                else
                                {
                                    <!-- Placeholder when buttons are hidden -->
                                    <div class="text-muted text-end">
                                        <small><em>Complete modal action to continue...</em></small>
                                    </div>
                                }
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTemplateForm>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <!-- Guidance Panel -->
        <RadzenColumn Size="4">
            <RadzenCard Variant="Variant.Outlined" Class="sms-guidance-panel" >
                <RadzenStack Gap="1rem" Class="rz-p-3">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Class="rz-mb-3 rz-pb-2 rz-border-bottom-1" Style="border-bottom: 1px solid var(--rz-border-color); padding-bottom: 0.5rem; background: var(--rz-warning-lighter); margin: -1rem -1rem 1rem -1rem; padding: 1rem;">
                        <RadzenIcon Icon="help" Style="color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Confidential Reporting Guidelines</RadzenText>
                    </RadzenStack>

                    <RadzenStack Gap="1rem">
                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-primary); margin: 0;">What to Report:</RadzenText>
                            <RadzenStack Gap="0.25rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="check" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Actual incidents or accidents</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="check" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Near-miss events</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="check" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Unsafe conditions</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="check" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Equipment malfunctions</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="check" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Procedural violations</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="check" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Security concerns</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="check" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Environmental hazards</RadzenText>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenStack>

                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-primary); margin: 0;">Confidential Protection:</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Use when concerned about:</RadzenText>
                            <RadzenStack Gap="0.25rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="security" Style="color: var(--rz-info); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Personal safety or retaliation</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="security" Style="color: var(--rz-info); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Sensitive operational information</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="security" Style="color: var(--rz-info); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Personnel-related issues</RadzenText>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenIcon Icon="security" Style="color: var(--rz-info); font-size: 0.9rem;" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Management or supervisory concerns</RadzenText>
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenStack>

                        <RadzenAlert AlertStyle="AlertStyle.Base" Size="AlertSize.Small" Variant="Variant.Flat">
                            <RadzenStack Gap="0.5rem" AlignItems="AlignItems.Center">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">Confidential Hotline</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; text-align: center;">(503) 555-0199</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; text-align: center;">confidential@flypdx.com</RadzenText>
                            </RadzenStack>
                        </RadzenAlert>
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
}

<!-- Map Modal -->
@if (ShowMapModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-xl">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-map-marked-alt"></i> Select Hazard Location
                        </h5>
                        <div class="d-flex align-items-center gap-2">
                            <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                        Variant="Variant.Text"
                                        Icon="close"
                                        Size="ButtonSize.Small"
                                        Click="CloseMapSelector" />
                        </div>
                    </div>
                </div>
                <div class="sms-modal-body p-0">
                    <!-- Map Container -->
                    <div id="hazardLocationMap" style="height: 500px; width: 100%;"></div>
                    
                    <!-- Location Form and Controls -->
                    <div class="p-4">
                        <!-- Selected Coordinates Display -->
                        <div class="row mb-3">
                            <div class="rz-w-25">
                                <RadzenFormField Text="Selected Latitude" Variant="Variant.Outlined">
                                    <RadzenTextBox Value="@SelectedLatitudeText"
                                                   ReadOnly="true"
                                                   Placeholder="Select location first"
                                                   Style="background-color: #f8f9fa; border-color: #dee2e6; width: 100%;" />
                                </RadzenFormField>
                            </div>
                            <div class="rz-w-25">
                                <RadzenFormField Text="Selected Longitude" Variant="Variant.Outlined">
                                    <RadzenTextBox Value="@SelectedLongitudeText"
                                                   ReadOnly="true"
                                                   Placeholder="Select location first"
                                                   Style="background-color: #f8f9fa; border-color: #dee2e6; width: 100%;" />
                                </RadzenFormField>
                            </div>
                            <div class="rz-w-50">
                                <RadzenFormField Text="Location Description" Variant="Variant.Outlined">
                                    <RadzenTextBox @bind-Value="@LocationDescription" 
                                                 Placeholder="Optional description"
                                                   Style="width: 100%;min-width: 100%;" />
                                </RadzenFormField>
                            </div>
                        </div>
                        
                        <!-- Current Selection Display -->
                        @if (HasGeoLocation)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Success" Size="AlertSize.Small" Variant="Variant.Flat" Class="mb-3">
                                <h6 class="alert-heading"><i class="fas fa-map-pin"></i> Current Selection</h6>
                                <p class="mb-1">
                                    <strong>Coordinates:</strong> @GeoLocationDisplay
                                </p>
                                @if (!string.IsNullOrEmpty(SelectedGeoLocation.Description))
                                {
                                    <p class="mb-1">
                                        <strong>Description:</strong> @SelectedGeoLocation.Description
                                    </p>
                                }
                            </RadzenAlert>
                        }
                        
                        <div class="d-flex justify-content-end gap-2">
                            <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                        Text="Cancel" 
                                        Icon="close"
                                        Size="ButtonSize.Medium"
                                        Click="CloseMapSelector" />
                            <RadzenButton ButtonStyle="ButtonStyle.Warning" 
                                        Text="Clear Selection" 
                                        Icon="clear"
                                        Size="ButtonSize.Medium"
                                        Click="ClearMapSelection" />
                            <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                        Text="Use Selected Location" 
                                        Icon="check"
                                        Size="ButtonSize.Medium"
                                        Click="UseSelectedLocation"
                                        Disabled="@(!HasValidCoordinates)" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Submission Confirmation Modal -->
@if (ShowSubmissionConfirmation)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-lg">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-warning">
                    <h5 class="sms-modal-title">
                        <i class="fas fa-exclamation-triangle"></i> Confirm Confidential Report Submission
                    </h5>
                </div>
                <div class="sms-modal-body">

                    <!-- Report Summary -->
                    <div class="mb-3">
                        <h6 class="text-primary mb-2">Report Summary:</h6>
                        <div class="small">
                            <p class="mb-1"><strong>Department:</strong> @HazardReport.ReportingDepartment</p>
                            <p class="mb-1"><strong>Category:</strong> @GetHazardCategoryDisplay(HazardReport.HazardCategory)</p>
                            <p class="mb-1"><strong>Type:</strong> @GetHazardTypeDisplay(HazardReport.HazardType)</p>
                            <p class="mb-1"><strong>Location:</strong> @LocationDisplayText</p>
                            <p class="mb-1"><strong>Reported By:</strong> @HazardReport.ReportedBy</p>
                            <p class="mb-1"><strong>Reported On:</strong> @HazardReport.ReportedOn.ToString("dddd, MMMM dd, yyyy 'at' h:mm tt")</p>
                            <p class="mb-0"><strong>Confidential:</strong> Yes</p>
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-center gap-3">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenCheckBox @bind-Value="@HazardReport.IsConfidential"
                                            Name="IsConfidential"
                                            TriState="false" />
                            <RadzenLabel Text="Submit as Confidential Report" Component="IsConfidential" />
                        </RadzenStack>
                        <RadzenButton ButtonStyle="ButtonStyle.Warning"
                                      Text="No, Continue Editing"
                                      Icon="edit"
                                      Click="CancelSubmission"
                                      Size="ButtonSize.Medium"
                                       />

                        <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                    Text="Yes, Submit Report" 
                                    Icon="check"
                                    Click="SubmitReportConfirmed"
                                    Size="ButtonSize.Medium" />
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Preview Modal -->
@if (ShowPreview)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-xl">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-eye"></i> Confidential Report Preview
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                    Variant="Variant.Text"
                                    Icon="close"
                                    Size="ButtonSize.Small"
                                    Click="HidePreview" />
                    </div>
                </div>
                <div class="sms-modal-body">
                    <!-- Preview Content -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th width="25%" class="text-primary">Field</th>
                                    <th class="text-primary">Details</th>
                                    <th width="10%" class="text-center text-primary">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <th class="bg-light">
                                        <i class="fas fa-exclamation-triangle text-danger"></i> Hazard Type
                                    </th>
                                    <td>
                                        @if (!string.IsNullOrEmpty(HazardReport.HazardType))
                                        {
                                            <span class="fw-bold">@GetHazardTypeDisplay(HazardReport.HazardType)</span>
                                        }
                                        else
                                        {
                                            <em class="text-muted">Not selected - Please select a hazard type</em>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(HazardReport.HazardType))
                                        {
                                            <i class="fas fa-check-circle text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-times-circle text-danger"></i>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th class="bg-light">
                                        <i class="fas fa-map-marker-alt text-primary"></i> Location
                                    </th>
                                    <td>
                                        @if (HasGeoLocation || !string.IsNullOrEmpty(HazardReport.Location))
                                        {
                                            <span class="fw-bold">@LocationDisplayText</span>
                                        }
                                        else
                                        {
                                            <em class="text-muted">Not specified - Please select or enter a location</em>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (HasGeoLocation || !string.IsNullOrEmpty(HazardReport.Location))
                                        {
                                            <i class="fas fa-check-circle text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-times-circle text-danger"></i>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th class="bg-light">
                                        <i class="fas fa-user text-info"></i> Reported By
                                    </th>
                                    <td>
                                        @if (!string.IsNullOrEmpty(HazardReport.ReportedBy))
                                        {
                                            <span class="fw-bold">@HazardReport.ReportedBy</span>
                                        }
                                        else
                                        {
                                            <em class="text-muted">Not specified - Please enter who is reporting this hazard</em>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(HazardReport.ReportedBy))
                                        {
                                            <i class="fas fa-check-circle text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-times-circle text-danger"></i>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th class="bg-light">
                                        <i class="fas fa-file-alt text-success"></i> Description
                                    </th>
                                    <td>
                                        @if (!string.IsNullOrEmpty(HazardReport.Description))
                                        {
                                            <div class="description-preview">
                                                <div style="white-space: pre-wrap; max-height: 150px; overflow-y: auto; border: 1px solid #dee2e6; padding: 0.5rem; border-radius: 0.25rem; background-color: #f8f9fa;">@HazardReport.Description</div>
                                                <small class="text-muted mt-1 d-block">
                                                    <i class="fas fa-chart-bar"></i> 
                                                    Character count: @DescriptionCharacterCount/2000
                                                </small>
                                            </div>
                                        }
                                        else
                                        {
                                            <em class="text-muted">No description provided - Please describe the hazard</em>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(HazardReport.Description))
                                        {
                                            <i class="fas fa-check-circle text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-times-circle text-danger"></i>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th class="bg-light">
                                        <i class="fas fa-paperclip text-secondary"></i> Attachments
                                    </th>
                                    <td>
                                        @if (AttachedFiles.Any())
                                        {
                                            <div class="attachment-preview">
                                                <span class="fw-bold text-success">@AttachedFiles.Count file(s) attached:</span>
                                                <ul class="mb-0 mt-1">
                                                    @foreach (var file in AttachedFiles)
                                                    {
                                                        <li>
                                                            <i class="fas fa-file"></i> 
                                                            <strong>@file.FileName</strong> 
                                                            <small class="text-muted">(@file.SizeDisplay)</small>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                        else
                                        {
                                            <em class="text-muted">No files attached (Optional)</em>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <i class="fas fa-info-circle text-info" title="Optional field"></i>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Validation Summary -->
                    @if (!IsFormValidForSubmission)
                    {
                        <div class="mt-3">
                            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
                                <h6><i class="fas fa-exclamation-triangle"></i> Required Fields Missing</h6>
                                <p class="mb-2">The following required fields need to be completed before submission:</p>
                                <ul class="mb-0">
                                    @if (string.IsNullOrEmpty(HazardReport.HazardType))
                                    {
                                        <li><strong>Hazard Type</strong> - Please select the type of hazard being reported</li>
                                    }
                                    @if (!HasGeoLocation && string.IsNullOrEmpty(HazardReport.Location))
                                    {
                                        <li><strong>Location</strong> - Please specify where the hazard occurred using the map</li>
                                    }
                                    @if (string.IsNullOrEmpty(HazardReport.Description))
                                    {
                                        <li><strong>Description</strong> - Please provide details about the hazard</li>
                                    }
                                    @if (string.IsNullOrEmpty(HazardReport.ReportedBy))
                                    {
                                        <li><strong>Reported By</strong> - Please specify who is reporting this hazard</li>
                                    }
                                </ul>
                            </RadzenAlert>
                        </div>
                    }
                    else
                    {
                        <div class="mt-3">
                            <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat">
                                <h6><i class="fas fa-check-circle"></i> Report Ready for Submission</h6>
                                <p class="mb-0">All required fields have been completed. Your confidential report is ready to be submitted to the SMS system.</p>
                            </RadzenAlert>
                        </div>
                    }
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end gap-2">
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                    Text="Continue Editing" 
                                    Icon="edit"
                                    Click="HidePreview"
                                    Size="ButtonSize.Medium" />
                        @if (IsFormValidForSubmission)
                        {
                            <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                        Text="Submit Report" 
                                        Icon="send"
                                        Click="ShowSubmissionConfirmationDialog"
                                        Size="ButtonSize.Medium" />
                        }
                        else
                        {
                            <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                        Text="Complete Required Fields" 
                                        Icon="exclamation-triangle"
                                        Disabled="true"
                                        Size="ButtonSize.Medium" />
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
/* =============================================================================
   SMS CONFIDENTIAL REPORTING - FULL STYLING MATCHING HAZARD REPORTING
   ============================================================================= */

/* Modal Overlay and Dialog */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
    padding: 1rem;
}

.sms-modal-dialog {
    position: relative;
    margin: 0 auto;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
}

.sms-modal-lg {
    max-width: 1100px;
    width: 100%;
}

.sms-modal-xl {
    max-width: 1200px;
    width: 100%;
}

.sms-modal-content {
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
}

.sms-modal-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e9ecef;
    border-radius: 0.5rem 0.5rem 0 0;
}

.sms-header-success {
    background-color: #0d8944; /* SMS Green Primary */
    color: white;
}

.sms-header-warning {
    background-color: #fa9a46; /* SMS Orange Accent */
    color: #212e61; /* SMS Blue Dark Bold */
}

.sms-header-primary {
    background-color: #212e61; /* SMS Blue Dark Bold */
    color: white;
}

.sms-modal-title {
    margin: 0;
    font-weight: 600;
}

.sms-modal-body {
    padding: 1.5rem;
}

.sms-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid #e9ecef;
    border-radius: 0 0 0.5rem 0.5rem;
}

/* Guidance Panel - Consistent with other SMS pages */
.sms-guidance-panel {
    background: linear-gradient(135deg, rgba(201, 227, 237, 0.05) 0%, rgba(205, 235, 241, 0.05) 100%);
    border-color: #c9e3ed !important; /* SMS Blue Light */
}

.sms-guidance-panel .text-primary {
    color: #212e61 !important; /* SMS Blue Dark Bold */
}

.sms-guidance-panel .text-success {
    color: #0d8944 !important; /* SMS Green Primary */
}

.sms-guidance-panel .text-info {
    color: #006AA9 !important; /* SMS Blue Primary */
}

/* Mini Guidance Panel for Hazard Type */
.sms-guidance-mini {
    background: linear-gradient(135deg, rgba(201, 227, 237, 0.08) 0%, rgba(205, 235, 241, 0.08) 100%);
    border-color: #c9e3ed !important; /* SMS Blue Light */
    max-height: 250px;
    overflow-y: auto;
}

.sms-guidance-mini .text-primary {
    color: #212e61 !important; /* SMS Blue Dark Bold */
}

.sms-guidance-mini .text-secondary {
    color: #6c757d !important;
}

/* Map styling */
#hazardLocationMap {
    cursor: crosshair !important;
}

.leaflet-container {
    cursor: crosshair !important;
}

.leaflet-grab {
    cursor: crosshair !important;
}

.leaflet-dragging .leaflet-grab {
    cursor: move !important;
}

/* Character count styling */
.text-warning {
    color: #fa9a46 !important; /* SMS Orange Accent */
}

.text-danger {
    color: #d91e3e !important; /* SMS Red Primary */
}

/* Location selection styling for RadzenStack horizontal layout */
::deep .rz-stack-horizontal .rz-button,
::deep .rz-stack-horizontal .rz-textbox {
    height: 42px !important;
    align-items: center !important;
}

::deep .rz-stack-horizontal .rz-button {
    flex-shrink: 0 !important;
    white-space: nowrap !important;
}

/* Ensure proper input sizing with Radzen */
::deep .rz-textbox,
::deep .rz-dropdown,
::deep .rz-textarea,
::deep .rz-datepicker {
    width: 100% !important;
    min-width: 100% !important;
}

/* Ensure FormField containers take full width */
::deep .rz-formfield {
    width: 100% !important;
}

/* Specific dropdown styling for full width */
::deep .rz-dropdown-panel {
    min-width: 100% !important;
}

::deep .rz-dropdown .rz-dropdown-label {
    width: calc(100% - 32px) !important;
}

/* Make sure dropdowns are responsive and fill container */
::deep .rz-dropdown {
    display: block !important;
    width: 100% !important;
}

    .location-row {
        display: flex !important;
        align-items: flex-end !important;
        gap: 1rem !important;
        width: 100% !important;
    }

    .location-button {
        flex: 0 0 200px !important;
    }

    .location-coordinate {
        flex: 0 0 120px !important;
    }

    .location-description {
        flex: 1 !important;
        min-width: 0 !important;
    }
</style>

