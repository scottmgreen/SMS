@page "/SMSRiskManagement/Investigations"
@page "/SMSRiskManagement/Investigations/{InvestigationId}"
@page "/SMSRiskManagement/Investigations/{InvestigationId}/{HazardId}"
@using SMS3.Components.Pages.SMSRiskManagement.Components
@using SMS_Application.Messaging.Commands
@using SMS_Application.Messaging.Queries
@using SMS_Domain.Entities
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared

<PageTitle>SMS Investigation - SMS3</PageTitle>

<!-- SMS Page Header using reusable component -->


@if (IsLoading)
{

    <div class="loading-container">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        <RadzenText TextStyle="TextStyle.H6" Style="margin-top: 1rem;">Loading investigation data...</RadzenText>
    </div>
}
else
{
    <PageHeader Title="@($"SMS Investigation {InvestigationEntity.Code} for Hazard: {InvestigationEntity.HazardCode}")"
                Subtitle="Conduct comprehensive investigations into safety incidents and hazard reports"
                Icon="fas fa-search" />



    <!-- Standard 8x4 Layout with Investigation Content and Guidance -->
    <RadzenRow Gap="1rem">
        <!-- Main Content Column (8/12) -->
        <RadzenColumn Size="8">
            @if (InvestigationEntity == null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenText TextStyle="TextStyle.H6">Investigation Not Found</RadzenText>
                    <RadzenText>The requested investigation could not be found.</RadzenText>
                    <RadzenButton Text="Back to Investigations" Icon="arrow_back" ButtonStyle="ButtonStyle.Secondary" 
                                  Click="NavigateToListings" Style="margin-top: 1rem;" />
                </RadzenAlert>
            }
            else
            {
                <!-- Investigation Form Content -->
                <RadzenCard>
                    <RadzenStack Gap="1.5rem">
                                                
                        <!-- Main Form Tabs -->
                        <RadzenTabs @bind-SelectedIndex="selectedTabIndex" RenderMode="TabRenderMode.Client">
                            <Tabs>
                                <!-- Investigation Details Tab -->
                                <RadzenTabsItem Text="Investigation Details" Style="font-size:larger;font-weight:500;">
                                    <RadzenStack Gap="1rem" Style="padding: 1rem;">
                                      
                                        <RadzenRow Gap="0.5rem">
                                            <RadzenColumn Size="4" SizeMD="4">
                                                <RadzenFormField Text="Assigned Investigator" Variant="Variant.Outlined">
                                                    <RadzenDropDown @bind-Value="InvestigationEntity.AssignedInvestigatorId" 
                                                                   Data="AvailableInvestigators"
                                                                    TextProperty="DisplayName"
                                                                    ValueProperty="Code" 
                                                                   AllowClear="false" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="6" SizeMD="6">
                                                <RadzenFormField Text="Investigation Status" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                    <RadzenDropDown @bind-Value="InvestigationStatusId"
                                                                    Data="StatusOptions" 
                                                                   TextProperty="Text"
                                                                    ValueProperty="Value" 
                                                                    Style="width: 100%; min-width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            @if (InvestigationStatusId == InvestigationStatus.InvestigationComplete.Value)
                                            {
                                                <RadzenColumn Size="6">
                                                    <RadzenFormField Text="Investigation Decision" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                                        <RadzenDropDown @bind-Value="InvestigationEntity.DecisionType"
                                                                        Data="DecisionTypeOptions"
                                                                        TextProperty="Text"
                                                                        ValueProperty="Value"
                                                                        AllowClear="true"
                                                                        Placeholder="Select a decision type..."
                                                                        Style="width: 100%;" />
                                                    </RadzenFormField>
                                                </RadzenColumn>
                                            }
                                            @* <RadzenColumn Size="6">
                                                <RadzenFormField Text="Investigation Decision" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                                <RadzenDropDown @bind-Value="InvestigationEntity.DecisionType"
                                                                Data="DecisionTypeOptions"
                                                                TextProperty="Text"
                                                                ValueProperty="Value"
                                                                AllowClear="true"
                                                                Placeholder="Select a decision type..."
                                                                Style="width: 100%;" />
                                            </RadzenFormField>
                                            </RadzenColumn> *@
                                        </RadzenRow>

                                        <RadzenFormField Text="Investigation Objectives" Variant="Variant.Outlined">
                                            <RadzenTextArea @bind-Value="InvestigationEntity.InvestigationObjectives" 
                                                           Rows="3" Style="width: 100%;" />
                                        </RadzenFormField>

                                        <RadzenFormField Text="Investigation Plan" Variant="Variant.Outlined">
                                            <RadzenTextArea @bind-Value="InvestigationEntity.InvestigationPlan" 
                                                           Rows="4" Style="width: 100%;" />
                                        </RadzenFormField>

                                        <RadzenFormField Text="Investigation Notes" Variant="Variant.Outlined">
                                            <RadzenTextArea @bind-Value="InvestigationEntity.InvestigationNotes" 
                                                           Rows="5" Style="width: 100%;" />
                                        </RadzenFormField>

                                        <!-- Action Buttons -->
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                                           <!--NEEDS SMART LABEL-->
                                            <RadzenButton Text="Save Changes" Icon="save" ButtonStyle="ButtonStyle.Success"
                                                          Click="HandleSave" Disabled="@IsSaving" />
                                        </RadzenStack>
                                    </RadzenStack>
                                </RadzenTabsItem>

                                @* <!-- Decision Tab -->
                                <RadzenTabsItem Text="Investigation Decision">
                                    <RadzenStack Gap="1rem" Style="padding: 1rem;">
                                        @if (InvestigationEntity.DecisionDate.HasValue)
                                        {
                                            <!-- Existing Decision Display - Only show when decision is actually recorded -->
                                            <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat">
                                                <RadzenText TextStyle="TextStyle.H6">Decision Recorded</RadzenText>
                                                <RadzenText><strong>Decision:</strong> @InvestigationEntity.DecisionType</RadzenText>
                                                <RadzenText><strong>Decision Maker:</strong> @InvestigationEntity.DecisionMaker</RadzenText>
                                                <RadzenText><strong>Decision Date:</strong> @InvestigationEntity.DecisionDate?.ToString("yyyy-MM-dd HH:mm")</RadzenText>
                                                <RadzenText><strong>Rationale:</strong> @InvestigationEntity.DecisionRationale</RadzenText>
                                                @if (!string.IsNullOrEmpty(InvestigationEntity.NextSteps))
                                                {
                                                    <RadzenText><strong>Next Steps:</strong> @InvestigationEntity.NextSteps</RadzenText>
                                                }
                                                @if (!string.IsNullOrEmpty(InvestigationEntity.ReferralDetails))
                                                {
                                                    <RadzenText><strong>Referral Details:</strong> @InvestigationEntity.ReferralDetails</RadzenText>
                                                }
                                            </RadzenAlert>
                                            
                                            <!-- Allow editing of recorded decision if needed -->
                                            <RadzenButton Text="Edit Decision" Icon="edit" ButtonStyle="ButtonStyle.Secondary" 
                                                         Click="EditDecision" Size="ButtonSize.Small" />
                                        }
                                        else
                                        {
                                            <!-- Decision Form - Always shown unless decision is recorded -->
                                            

                                            <RadzenFormField Text="Decision Rationale" Variant="Variant.Outlined">
                                                <RadzenTextArea @bind-Value="InvestigationEntity.DecisionRationale" 
                                                               Rows="4" Style="width: 100%;" 
                                                               Placeholder="Provide detailed rationale for the decision..." />
                                            </RadzenFormField>

                                            <RadzenFormField Text="Decision Maker" Variant="Variant.Outlined">
                                                <RadzenTextBox @bind-Value="InvestigationEntity.DecisionMaker" 
                                                              Placeholder="Decision maker name" />
                                            </RadzenFormField>

                                            <RadzenFormField Text="Next Steps" Variant="Variant.Outlined">
                                                <RadzenTextArea @bind-Value="InvestigationEntity.NextSteps" 
                                                               Rows="3" Style="width: 100%;" 
                                                               Placeholder="Describe next steps..." />
                                            </RadzenFormField>

                                            <RadzenFormField Text="Referral Details" Variant="Variant.Outlined">
                                                <RadzenTextArea @bind-Value="InvestigationEntity.ReferralDetails" 
                                                               Rows="3" Style="width: 100%;" 
                                                               Placeholder="If referring externally, provide details..." />
                                            </RadzenFormField>

                                            <!-- Decision Action Buttons -->
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                                                <RadzenButton Text="Record Decision" Icon="gavel" ButtonStyle="ButtonStyle.Warning" 
                                                             Click="RecordDecision" Disabled="@IsSaving" />
                                            </RadzenStack>
                                        }
                                    </RadzenStack>
                                </RadzenTabsItem> *@

                                <!-- Interviews Tab -->
                                <RadzenTabsItem Text="@($"Interviews ({Interviews.Count})")">
                                    <div style="padding: 1rem;">
                                        <InterviewsManager @ref="interviewsManager" 
                                                         InvestigationCode="@InvestigationEntity.Code"
                                                         OnInterviewsChanged="@OnInterviewsChanged" />
                                    </div>
                                </RadzenTabsItem>

                                <!-- Evidence Tab -->
                                <RadzenTabsItem Text="@($"Evidence ({GetFileCountText()})")">
                                    <div style="padding: 1rem;">
                                        <EvidenceFilesManager @ref="evidenceFilesManager" 
                                                            HazardCode="@InvestigationEntity.HazardCode"
                                                            InvestigationCode="@InvestigationEntity.Code" />
                                    </div>
                                </RadzenTabsItem>
                            </Tabs>
                        </RadzenTabs>

                        <!-- Investigation Actions -->
                        @* <RadzenCard Style="background-color: var(--rz-base-100);">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenButton Text="Start Investigation" Icon="play_arrow" ButtonStyle="ButtonStyle.Success" 
                                                 Click="@(() => InvestigationEntity.Start())" 
                                                 Disabled="@(!InvestigationEntity.IsAssigned || IsSaving)" />
                                    <RadzenButton Text="Put On Hold" Icon="pause" ButtonStyle="ButtonStyle.Warning" 
                                                 Click="@(() => InvestigationEntity.PutOnHold())" 
                                                 Disabled="@(InvestigationEntity.IsCompleted || IsSaving)" />
                                    <RadzenButton Text="Cancel Investigation" Icon="cancel" ButtonStyle="ButtonStyle.Danger" 
                                                 Click="@(() => InvestigationEntity.Cancel())" 
                                                 Disabled="@(InvestigationEntity.IsCompleted || IsSaving)" />
                                </RadzenStack>
                                
                                @if (InvestigationEntity.HasDecision && !InvestigationEntity.IsCompleted)
                                {
                                    <RadzenButton Text="Complete Investigation" Icon="check_circle" ButtonStyle="ButtonStyle.Primary" 
                                                 Click="CompleteInvestigation" Disabled="@IsSaving" Size="ButtonSize.Large" />
                                }
                            </RadzenStack>
                        </RadzenCard> *@
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenColumn>

        <!-- Guidance Panel Column (4/12) -->
        <RadzenColumn Size="4">
            <InvestigationsGuidance />
        </RadzenColumn>
    </RadzenRow>
}

<style>
.loading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 400px;
}
</style>