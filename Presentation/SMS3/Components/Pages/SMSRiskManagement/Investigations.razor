@page "/SMSRiskManagement/Investigations"
@page "/SMSRiskManagement/Investigations/{InvestigationId}"
@page "/SMSRiskManagement/Investigations/{InvestigationId}/{HazardId}"
@using SMS3.Components.Pages.SMSRiskManagement.Components
@using SMS_Application.Messaging.Commands
@using SMS_Application.Messaging.Queries
@using SMS_Domain.Entities
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared

<PageTitle>SMS Investigation - SMS3</PageTitle>

<!-- SMS Page Header using reusable component -->


@if (IsLoading)
{

    <div class="loading-container">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        <RadzenText TextStyle="TextStyle.H6" Style="margin-top: 1rem;">Loading investigation data...</RadzenText>
    </div>
}
else
{
    <PageHeader Title="@($"SMS Investigation {InvestigationEntity.Code} for Hazard: {InvestigationEntity.HazardCode}")"
                Subtitle="@GetInvestigationSubtitle()"
                Icon="fas fa-search" />



    <!-- Standard 8x4 Layout with Investigation Content and Guidance -->
    <RadzenRow Gap="1rem">
        <!-- Main Content Column (8/12) -->
        <RadzenColumn Size="8">
            @if (InvestigationEntity == null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenText TextStyle="TextStyle.H6">Investigation Not Found</RadzenText>
                    <RadzenText>The requested investigation could not be found.</RadzenText>
                    <RadzenButton Text="Back to Investigations" Icon="arrow_back" ButtonStyle="ButtonStyle.Secondary" 
                                  Click="NavigateToListings" Style="margin-top: 1rem;" />
                </RadzenAlert>
            }
            else
            {
                <!-- Investigation Form Content -->
                <RadzenCard>
                    <RadzenStack Gap="1.5rem">
                                                
                        <!-- Main Form Tabs -->
                        <RadzenTabs @bind-SelectedIndex="selectedTabIndex" RenderMode="TabRenderMode.Client">
                            <Tabs>
                                <!-- Investigation Details Tab -->
                                <RadzenTabsItem Text="Investigation Details" Style="font-size:larger;font-weight:500;">
                                    <RadzenStack Gap="1rem" Style="padding: 0.5rem;">
                                      
                                        <RadzenRow Gap="0.5rem">
                                            <RadzenColumn Size="3" SizeMD="3">
                                                <RadzenFormField Text="Assigned Investigator" Variant="Variant.Outlined">
                                                    <RadzenDropDown @bind-Value="InvestigationEntity.AssignedInvestigatorId" 
                                                                   Data="AvailableInvestigators"
                                                                   TextProperty="DisplayName"
                                                                   ValueProperty="UserName.Value" 
                                                                   AllowClear="false"
                                                                   Placeholder="Select an investigator..."
                                                                   Style="width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="4" SizeMD="4">
                                                <RadzenFormField Text="Investigation Status" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                    <RadzenDropDown @bind-Value="InvestigationStatusId"
                                                                    Data="StatusOptions" 
                                                                   TextProperty="Text"
                                                                    ValueProperty="Value" 
                                                                    Style="width: 100%; min-width: 100%;" />
                                                </RadzenFormField>
                                                <!-- Warning when trying to set status to complete with incomplete interviews -->
                                                @if (InvestigationStatusId == InvestigationStatus.InvestigationComplete.Value && !CanCompleteInvestigation())
                                                {
                                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: #dc3545; font-size: 0.75rem; margin-top: 0.25rem;">
                                                        <RadzenIcon Icon="warning" Style="font-size: 0.75rem;" />
                                                        Cannot complete: @GetIncompleteInterviewsCount() interview(s) still pending
                                                    </RadzenText>
                                                }
                                            </RadzenColumn>
                                            @if (InvestigationStatusId == InvestigationStatus.InvestigationComplete.Value)
                                            {
                                                <RadzenColumn Size="2" SizeMD="2">
                                                    <RadzenFormField Text="Investigation Decision" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                                        <RadzenDropDown @bind-Value="InvestigationEntity.DecisionType"
                                                                        Data="DecisionTypeOptions"
                                                                        TextProperty="Text"
                                                                        ValueProperty="Value"
                                                                        AllowClear="true"
                                                                        Placeholder="Select a decision type..."
                                                                        Style="width: 100%;" />
                                                    </RadzenFormField>
                                                </RadzenColumn>
                                            }
                                           
                                        </RadzenRow>

                                        <RadzenFormField Text="Investigation Objectives" Variant="Variant.Outlined">
                                            <RadzenTextArea @bind-Value="InvestigationEntity.InvestigationObjectives" 
                                                           Rows="3" Style="width: 100%;" />
                                        </RadzenFormField>

                                        <RadzenFormField Text="Investigation Plan" Variant="Variant.Outlined">
                                            <RadzenTextArea @bind-Value="InvestigationEntity.InvestigationPlan" 
                                                           Rows="4" Style="width: 100%;" />
                                        </RadzenFormField>

                                        <RadzenFormField Text="Investigation Notes" Variant="Variant.Outlined">
                                            <RadzenTextArea @bind-Value="InvestigationEntity.InvestigationNotes" 
                                                           Rows="5" Style="width: 100%;" />
                                        </RadzenFormField>

                                        <!-- Action Buttons -->
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                                           <!--NEEDS SMART LABEL-->
                                            <RadzenButton Text="Save Changes" Icon="save" ButtonStyle="ButtonStyle.Success"
                                                          Click="HandleSave" Disabled="@IsSaving" />
                                        </RadzenStack>
                                    </RadzenStack>
                                </RadzenTabsItem>

                                                                

                                <!-- Interviews Tab -->
                                <RadzenTabsItem Text="@($"Interviews ({Interviews.Count})")">
                                    <div style="padding: 1rem;">
                                        <!-- Interview Completion Status Alert -->
                                        @if (Interviews.Any())
                                        {
                                            var incompleteCount = GetIncompleteInterviewsCount();
                                            if (incompleteCount > 0)
                                            {
                                                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Style="margin-bottom: 1rem;">
                                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                        <RadzenIcon Icon="warning" Style="color: #856404;" />
                                                        <RadzenText TextStyle="TextStyle.Body1" Style="color: #856404;">
                                                            <strong>@GetInterviewCompletionStatus()</strong><br/>
                                                            Investigation cannot be completed until all interviews are finished.
                                                        </RadzenText>
                                                    </RadzenStack>
                                                </RadzenAlert>
                                            }
                                            else
                                            {
                                                <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Style="margin-bottom: 1rem;">
                                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                        <RadzenIcon Icon="check_circle" Style="color: #155724;" />
                                                        <RadzenText TextStyle="TextStyle.Body1" Style="color: #155724;">
                                                            <strong>@GetInterviewCompletionStatus()</strong><br/>
                                                            All interviews are complete. Investigation can be closed.
                                                        </RadzenText>
                                                    </RadzenStack>
                                                </RadzenAlert>
                                            }
                                        }
                                        
                                        <InterviewsManager @ref="interviewsManager" 
                                                         InvestigationCode="@InvestigationEntity.Code"
                                                         OnInterviewsChanged="@OnInterviewsChanged" />
                                    </div>
                                </RadzenTabsItem>

                                <!-- Evidence Tab -->
                                <RadzenTabsItem Text="@($"Evidence ({GetFileCountText()})")">
                                    <div style="padding: 1rem;">
                                        <EvidenceFilesManager @ref="evidenceFilesManager" 
                                                            HazardCode="@InvestigationEntity.HazardCode"
                                                            InvestigationCode="@InvestigationEntity.Code" />
                                    </div>
                                </RadzenTabsItem>
                            </Tabs>
                        </RadzenTabs>

                        <!-- Investigation Actions -->
                        @* <RadzenCard Style="background-color: var(--rz-base-100);">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenButton Text="Start Investigation" Icon="play_arrow" ButtonStyle="ButtonStyle.Success" 
                                                 Click="@(() => InvestigationEntity.Start())" 
                                                 Disabled="@(!InvestigationEntity.IsAssigned || IsSaving)" />
                                    <RadzenButton Text="Put On Hold" Icon="pause" ButtonStyle="ButtonStyle.Warning" 
                                                 Click="@(() => InvestigationEntity.PutOnHold())" 
                                                 Disabled="@(InvestigationEntity.IsCompleted || IsSaving)" />
                                    <RadzenButton Text="Cancel Investigation" Icon="cancel" ButtonStyle="ButtonStyle.Danger" 
                                                 Click="@(() => InvestigationEntity.Cancel())" 
                                                 Disabled="@(InvestigationEntity.IsCompleted || IsSaving)" />
                                </RadzenStack>
                                
                                @if (InvestigationEntity.HasDecision && !InvestigationEntity.IsCompleted)
                                {
                                    <RadzenButton Text="Complete Investigation" Icon="check_circle" ButtonStyle="ButtonStyle.Primary" 
                                                 Click="CompleteInvestigation" Disabled="@IsSaving" Size="ButtonSize.Large" />
                                }
                            </RadzenStack>
                        </RadzenCard> *@
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenColumn>

        <!-- Guidance Panel Column (4/12) -->
        <RadzenColumn Size="4">
            <InvestigationsGuidance />
        </RadzenColumn>
    </RadzenRow>
}

<!-- Custom Return to Validation Confirmation Modal -->
@if (showReturnToValidationModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog" style="max-width: 700px; width: 90%;">
            <div class="sms-modal-content">
                <div class="sms-modal-header" style="background-color: #dc3545; color: white;">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-exclamation-triangle"></i> Confirm Return to Validation
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                    Variant="Variant.Text"
                                    Icon="close"
                                    Size="ButtonSize.Small"
                                    Click="CancelReturnToValidationConfirmation" 
                                    Style="color: white;" />
                    </div>
                </div>
                <div class="sms-modal-body" style="padding: 1.5rem;">
                    <div class="return-to-validation-confirmation-message">
                        @returnToValidationMessage
                    </div>
                    <div class="return-to-validation-warning-final">
                        @GetReturnToValidationFinalWarning()
                    </div>
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end gap-2">
                        <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                    Text="Cancel" 
                                    Icon="close"
                                    Click="CancelReturnToValidationConfirmation"
                                    Size="ButtonSize.Medium" />
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                    Text="Yes, Return to Validation" 
                                    Icon="refresh"
                                    Click="HandleReturnToValidationConfirmation"
                                    Size="ButtonSize.Medium"
                                    Disabled="@IsSaving" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
.loading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 400px;
}

.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
    padding: 1rem;
}

.sms-modal-dialog {
    position: relative;
    margin: 0 auto;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
}

.sms-modal-content {
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
}

.sms-modal-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e9ecef;
    border-radius: 0.5rem 0.5rem 0 0;
}

.sms-modal-title {
    margin: 0;
    font-weight: 600;
}

.sms-modal-body {
    max-height: calc(100vh - 200px);
    overflow-y: auto;
}

.sms-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid #e9ecef;
    border-radius: 0 0 0.5rem 0.5rem;
}

/* Enhanced styles for return to validation confirmation modal */
.return-to-validation-confirmation-message {
    white-space: pre-wrap;
    line-height: 1.6;
    font-size: 14px;
    font-family: 'Segoe UI', system-ui, sans-serif;
}

.return-to-validation-warning-final {
    text-align: center;
    font-weight: bold;
    color: #dc3545;
    font-size: 16px;
    margin-top: 1rem;
    padding: 0.75rem;
    background-color: #f8d7da;
    border: 1px solid #f5c6cb;
    border-radius: 0.25rem;
}
</style>