@page "/SMSRiskManagement/Hazards"
@using SMS3.Components.Shared

<PageTitle>SMS Hazards Management - PDXSMS</PageTitle>

<!-- SMS Page Header using reusable component -->
<PageHeader Title="SMS Hazards Management"
           Subtitle="Comprehensive listing and management of all SMS hazards and safety risks"
           Icon="fas fa-exclamation-triangle" />

@if (!IsAuthenticated)
{
    <!-- Unauthorized Access -->
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
        <strong>Access Denied:</strong> You must be logged in to view SMS hazards.
    </RadzenAlert>
}
else if (IsLoading)
{
    <!-- Loading State -->
    <div class="text-center py-5">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        <p class="mt-3 text-muted">Loading SMS hazards...</p>
    </div>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
    <!-- Error State -->
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
        <strong>Error:</strong> @ErrorMessage
        <div class="mt-2">
            <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                         Text="Try Again" 
                         Click="RefreshAsync" 
                         Size="ButtonSize.Small" 
                         Icon="refresh" />
        </div>
    </RadzenAlert>
}
else
{
    <!-- Main Content -->
    <div class="row">
        <div class="col-12">
            <RadzenCard>
                <!-- Toolbar -->
                <div class="row mb-3 align-items-center">
                    <div class="col">
                        <h5 class="mb-0">
                            <i class="fas fa-list me-2"></i>Hazards List
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" 
                                        Text="@AllHazards.Count.ToString()" 
                                        Variant="Variant.Flat" 
                                        Class="ms-2" />
                        </h5>
                    </div>
                    <div class="col-auto">
                        <div class="d-flex align-items-center gap-3">
                            <!-- Create New Hazard Button -->
                            <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                        Text="Create New Hazard" 
                                        Click="@ShowCreateHazardDialog" 
                                        Size="ButtonSize.Medium" 
                                        Icon="add" />
                            
                            <!-- Page Size Selector -->
                            <div class="d-flex align-items-center">
                                <small class="text-muted me-2">Show:</small>
                                <RadzenDropDown @bind-Value="PageSize" 
                                               Data="@PageSizeOptions" 
                                               Change="OnPageSizeChanged"
                                               Style="width: 80px;" />
                            </div>
                            
                            <!-- Refresh Button -->
                            <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                         Text="Refresh" 
                                         Click="RefreshAsync" 
                                         Size="ButtonSize.Small" 
                                         Icon="refresh" />
                        </div>
                    </div>
                </div>

                @if (!AllHazards.Any())
                {
                    <!-- Empty State -->
                    <div class="text-center py-5">
                        <i class="fas fa-exclamation-triangle text-muted" style="font-size: 4rem;"></i>
                        <h5 class="mt-3 text-muted">No Hazards Found</h5>
                        <p class="text-muted">There are currently no hazards in the system.</p>
                        <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                    Text="Create Your First Hazard" 
                                    Click="ShowCreateHazardDialog" 
                                    Size="ButtonSize.Large" 
                                    Icon="add" />
                    </div>
                }
                else
                {
                    <!-- Paged Hazards List -->
                    <RadzenDataList @ref="hazardsDataList"
                                   WrapItems="false" 
                                   AllowPaging="true" 
                                   Data="@AllHazards" 
                                   TItem="Hazard"
                                   PageSize="@PageSize"
                                   Count="@AllHazards.Count"
                                   PagerHorizontalAlign="HorizontalAlign.Left"
                                   ShowPagingSummary="true"
                                   PagingSummaryFormat="Showing {0} to {1} of {2} hazards"
                                   PageSizeText="Hazards per page">
                        
                        <Template Context="hazard">
                            <!-- Hazard Card Template -->
                            <div class="mb-3">
                                <RadzenCard>
                                    <div class="row align-items-center">
                                        <!-- Expand/Collapse Button -->
                                        <div class="col-auto">
                                            <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                                        Size="ButtonSize.Small" 
                                                        Click="@(() => ToggleRowExpansion(hazard))" 
                                                        title="@(IsRowExpanded(hazard) ? "Hide Details" : "Show Details")"
                                                        Variant="Variant.Text">
                                                <Template>
                                                    <i class="fas @(IsRowExpanded(hazard) ? "fa-chevron-up" : "fa-chevron-down")"></i>
                                                </Template>
                                            </RadzenButton>
                                        </div>

                                        <!-- Hazard Code -->
                                        <div class="col-auto">
                                            <strong class="text-primary">@hazard.Code</strong>
                                        </div>

                                        <!-- Hazard Name & Description -->
                                        <div class="col">
                                            <div class="d-flex flex-column">
                                                <strong>@(hazard.Name ?? "Unnamed Hazard")</strong>
                                                @if (!string.IsNullOrEmpty(hazard.Description))
                                                {
                                                    <small class="text-muted" title="@hazard.Description">
                                                        @(hazard.Description.Length > 80 ? hazard.Description[..77] + "..." : hazard.Description)
                                                    </small>
                                                }
                                            </div>
                                        </div>

                                        <!-- Category -->
                                        <div class="col-auto">
                                            @if (!string.IsNullOrEmpty(hazard.HazardCategory))
                                            {
                                                <RadzenBadge Text="@hazard.HazardCategory" 
                                                           BadgeStyle="BadgeStyle.Light" 
                                                           Variant="Variant.Flat" />
                                            }
                                        </div>

                                        <!-- Status -->
                                        <div class="col-auto">
                                            @if (hazard.Status != null)
                                            {
                                                <RadzenBadge Text="@hazard.Status.Name" 
                                                           BadgeStyle="@GetStatusBadgeStyle(hazard.Status.Name)" 
                                                           Variant="Variant.Flat" />
                                            }
                                        </div>

                                        

                                        <!-- Reported Date -->
                                        <div class="col-auto">
                                            @* <small class="text-muted">
                                                <i class="fas fa-calendar-alt me-1"></i>
                                                @hazard.SubmittedDate.ToString("MM/dd/yyyy")
                                            </small> *@
                                        </div>

                                        <!-- Actions -->
                                        <div class="col-auto">
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                                <RadzenButton ButtonStyle="ButtonStyle.Info" 
                                                            Size="ButtonSize.Small"
                                                            Click="@(() => OnViewHazardAsync(hazard))" 
                                                            title="View Details"
                                                            Icon="visibility" />
                                                <RadzenButton ButtonStyle="ButtonStyle.Warning" 
                                                            Size="ButtonSize.Small"
                                                            Click="@(() => OnEditHazardAsync(hazard))" 
                                                            title="Edit Hazard"
                                                            Icon="edit" />
                                                <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                                            Size="ButtonSize.Small"
                                                            Click="@(() => OnDeleteHazardAsync(hazard))" 
                                                            title="Delete Hazard"
                                                            Icon="delete" />
                                            </RadzenStack>
                                        </div>
                                    </div>

                                    <!-- Additional Details Row -->
                                    <div class="row mt-2">
                                        @* <div class="col">
                                            <small class="text-muted">
                                                <strong>Reported by:</strong> @(hazard.SubmittedBy ?? "Unknown") 
                                                @if (!string.IsNullOrEmpty(hazard.ReportingDepartment))
                                                {
                                                    <span>(@hazard.ReportingDepartment)</span>
                                                }
                                            </small>
                                        </div> *@
                                    </div>

                                    <!-- Expandable Hazard Details -->
                                    @if (IsRowExpanded(hazard))
                                    {
                                        <div class="mt-3 pt-3 border-top">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <h6 class="text-primary">
                                                        <i class="fas fa-info-circle me-1"></i>
                                                        Hazard Details
                                                    </h6>
                                                    <dl class="row">
                                                        
                                                        
                                                        <dt class="col-sm-4">Hazard Type:</dt>
                                                        <dd class="col-sm-8">@(hazard.HazardType ?? "Not specified")</dd>
                                                        
                                                        <dt class="col-sm-4">Risk Level:</dt>
                                                        <dd class="col-sm-8">@(hazard.RiskLevel ?? "Not assessed")</dd>
                                                        
                                                        <dt class="col-sm-4">Root Cause:</dt>
                                                        <dd class="col-sm-8">@(hazard.InitialRootCause ?? "Not identified")</dd>
                                                    </dl>
                                                </div>
                                                <div class="col-md-6">
                                                    <h6 class="text-primary">
                                                        <i class="fas fa-search me-1"></i>
                                                        Investigation Status
                                                    </h6>
                                                    <dl class="row">
                                                        <dt class="col-sm-6">Requires Investigation:</dt>
                                                        <dd class="col-sm-6">
                                                            <RadzenBadge Text="@(hazard.RequiresInvestigation ? "Yes" : "No")" 
                                                                       BadgeStyle="@(hazard.RequiresInvestigation ? BadgeStyle.Warning : BadgeStyle.Success)" 
                                                                       Variant="Variant.Flat" />
                                                        </dd>
                                                        
                                                        @if (hazard.InvestigationCompletedDate.HasValue)
                                                        {
                                                            <dt class="col-sm-6">Investigation Completed:</dt>
                                                            <dd class="col-sm-6">@hazard.InvestigationCompletedDate.Value.ToString("MM/dd/yyyy")</dd>
                                                        }
                                                        
                                                        @if (!string.IsNullOrEmpty(hazard.InvestigationNotes))
                                                        {
                                                            <dt class="col-sm-12">Investigation Notes:</dt>
                                                            <dd class="col-sm-12">@hazard.InvestigationNotes</dd>
                                                        }
                                                    </dl>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </RadzenCard>
                            </div>
                        </Template>
                        
                        <EmptyTemplate>
                            <div class="text-center py-5">
                                <i class="fas fa-exclamation-triangle text-muted" style="font-size: 4rem;"></i>
                                <h5 class="mt-3 text-muted">No Hazards Found</h5>
                                <p class="text-muted">There are currently no hazards in the system.</p>
                            </div>
                        </EmptyTemplate>
                    </RadzenDataList>
                }
            </RadzenCard>
        </div>
    </div>
}
