<h3>Hazards</h3>


@page "/SMSRiskManagement/Hazards"

<PageTitle>SMS Hazards Management - PDXSMS</PageTitle>



@if (!IsAuthenticated)
{
    <!-- Unauthorized Access -->
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
        <strong>Access Denied:</strong> You must be logged in to view SMS hazards.
    </RadzenAlert>
}
else if (IsLoading)
{
    <!-- Loading State -->
    <div class="text-center py-5">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        <p class="mt-3 text-muted">Loading SMS hazards...</p>
    </div>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
    <!-- Error State -->
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
        <strong>Error:</strong> @ErrorMessage
        <div class="mt-2">
            <button type="button" class="btn btn-danger" @onclick="RefreshAsync">
                <i class="fas fa-sync-alt me-1"></i>Try Again
            </button>
        </div>
    </RadzenAlert>
}
else
{
    <!-- Main Content -->
    <div class="row">
        <div class="col-12">
            <RadzenCard>
                <!-- Toolbar -->
                <div class="row mb-3 align-items-center">
                    <div class="col">
                        <h5 class="mb-0">
                            <i class="fas fa-list me-2"></i>Hazards List
                            <span class="badge bg-info ms-2">@AllHazards.Count</span>
                        </h5>
                    </div>
                    <div class="col-auto">
                        <div class="d-flex align-items-center gap-3">
                            <!-- Create New Hazard Button -->
                            <button type="button" class="btn btn-success" @onclick="ShowCreateHazardDialog">
                                <i class="fas fa-plus-circle me-1"></i>Create New Hazard
                            </button>
                            
                            <!-- Page Size Selector -->
                            <div class="d-flex align-items-center">
                                <small class="text-muted me-2">Show:</small>
                                <RadzenDropDown @bind-Value="PageSize" 
                                               Data="@PageSizeOptions" 
                                               Change="OnPageSizeChanged"
                                               Style="width: 80px;" />
                            </div>
                            
                            <!-- Refresh Button -->
                            <button type="button" class="btn btn-primary" @onclick="RefreshAsync">
                                <i class="fas fa-sync-alt me-1"></i>Refresh
                            </button>
                        </div>
                    </div>
                </div>

                @if (!AllHazards.Any())
                {
                    <!-- Empty State -->
                    <div class="text-center py-5">
                        <i class="fas fa-exclamation-triangle text-muted" style="font-size: 4rem;"></i>
                        <h5 class="mt-3 text-muted">No Hazards Found</h5>
                        <p class="text-muted">There are currently no hazards in the system.</p>
                        <button type="button" class="btn btn-success btn-lg" @onclick="ShowCreateHazardDialog">
                            <i class="fas fa-plus-circle me-1"></i>Create Your First Hazard
                        </button>
                    </div>
                }
                else
                {
                    <!-- Paged Hazards List -->
                    <RadzenDataList @ref="hazardsDataList"
                                   WrapItems="false" 
                                   AllowPaging="true" 
                                   Data="@AllHazards" 
                                   TItem="Hazard"
                                   PageSize="@PageSize"
                                   Count="@AllHazards.Count"
                                   PagerHorizontalAlign="HorizontalAlign.Left"
                                   ShowPagingSummary="true"
                                   PagingSummaryFormat="Showing {0} to {1} of {2} hazards"
                                   PageSizeText="Hazards per page">
                        
                        <Template Context="hazard">
                            <!-- Hazard Card Template -->
                            <div class="mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <!-- Expand/Collapse Button -->
                                            <div class="col-auto">
                                                <button type="button" class="btn btn-light btn-sm" @onclick="@(() => ToggleRowExpansion(hazard))" 
                                                        title="@(IsRowExpanded(hazard) ? "Hide Details" : "Show Details")">
                                                    <i class="fas @(IsRowExpanded(hazard) ? "fa-chevron-up" : "fa-chevron-down")"></i>
                                                </button>
                                            </div>

                                            <!-- Hazard Code -->
                                            <div class="col-auto">
                                                <strong class="text-primary">@hazard.Code</strong>
                                            </div>

                                            <!-- Hazard Name & Description -->
                                            <div class="col">
                                                <div class="d-flex flex-column">
                                                    <strong>@(hazard.Name ?? "Unnamed Hazard")</strong>
                                                    @if (!string.IsNullOrEmpty(hazard.Description))
                                                    {
                                                        <small class="text-muted" title="@hazard.Description">
                                                            @(hazard.Description.Length > 80 ? hazard.Description[..77] + "..." : hazard.Description)
                                                        </small>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Category -->
                                            <div class="col-auto">
                                                @if (!string.IsNullOrEmpty(hazard.Category))
                                                {
                                                    <span class="badge bg-light text-dark">@hazard.Category</span>
                                                }
                                            </div>

                                            <!-- Status -->
                                            <div class="col-auto">
                                                @if (hazard.Status != null)
                                                {
                                                    <RadzenBadge Text="@hazard.Status.Name" 
                                                               BadgeStyle="@GetStatusBadgeStyle(hazard.Status.Name)" 
                                                               Variant="Variant.Flat" />
                                                }
                                            </div>

                                            <!-- Priority -->
                                            <div class="col-auto">
                                                @if (hazard.Priority != null)
                                                {
                                                    <RadzenBadge Text="@hazard.Priority.Name" 
                                                               BadgeStyle="@GetPriorityBadgeStyle(hazard.Priority.Name)" 
                                                               Variant="Variant.Flat" />
                                                }
                                            </div>

                                            <!-- Reported Date -->
                                            <div class="col-auto">
                                                <small class="text-muted">
                                                    @hazard.ReportedOn.ToString("MM/dd/yyyy")
                                                </small>
                                            </div>

                                            <!-- Actions -->
                                            <div class="col-auto">
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-info btn-sm" @onclick="@(() => OnViewHazardAsync(hazard))" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-warning btn-sm" @onclick="@(() => OnEditHazardAsync(hazard))" title="Edit Hazard">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-danger btn-sm" @onclick="@(() => OnDeleteHazardAsync(hazard))" title="Delete Hazard">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Additional Details Row -->
                                        <div class="row mt-2">
                                            <div class="col">
                                                <small class="text-muted">
                                                    <strong>Reported by:</strong> @(hazard.ReportedBy ?? "Unknown") 
                                                    @if (!string.IsNullOrEmpty(hazard.ReportingDepartment))
                                                    {
                                                        <span>(@hazard.ReportingDepartment)</span>
                                                    }
                                                </small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Expandable Hazard Details -->
                                    @if (IsRowExpanded(hazard))
                                    {
                                        <div class="card-footer">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <h6>Hazard Details</h6>
                                                    <dl class="row">
                                                        <dt class="col-sm-4">Five M Component:</dt>
                                                        <dd class="col-sm-8">@(hazard.FiveMComponent?.Name ?? "Not specified")</dd>
                                                        
                                                        <dt class="col-sm-4">Hazard Type:</dt>
                                                        <dd class="col-sm-8">@(hazard.HazardType ?? "Not specified")</dd>
                                                        
                                                        <dt class="col-sm-4">Risk Level:</dt>
                                                        <dd class="col-sm-8">@(hazard.RiskLevel ?? "Not assessed")</dd>
                                                        
                                                        <dt class="col-sm-4">Root Cause:</dt>
                                                        <dd class="col-sm-8">@(hazard.RootCause ?? "Not identified")</dd>
                                                    </dl>
                                                </div>
                                                <div class="col-md-6">
                                                    <h6>Investigation Status</h6>
                                                    <dl class="row">
                                                        <dt class="col-sm-6">Requires Investigation:</dt>
                                                        <dd class="col-sm-6">@(hazard.RequiresInvestigation ? "Yes" : "No")</dd>
                                                        
                                                        @if (hazard.InvestigationCompletedDate.HasValue)
                                                        {
                                                            <dt class="col-sm-6">Investigation Completed:</dt>
                                                            <dd class="col-sm-6">@hazard.InvestigationCompletedDate.Value.ToString("MM/dd/yyyy")</dd>
                                                        }
                                                        
                                                        @if (!string.IsNullOrEmpty(hazard.InvestigationNotes))
                                                        {
                                                            <dt class="col-sm-12">Investigation Notes:</dt>
                                                            <dd class="col-sm-12">@hazard.InvestigationNotes</dd>
                                                        }
                                                    </dl>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </Template>
                        
                        <EmptyTemplate>
                            <div class="text-center py-5">
                                <i class="fas fa-exclamation-triangle text-muted" style="font-size: 4rem;"></i>
                                <h5 class="mt-3 text-muted">No Hazards Found</h5>
                                <p class="text-muted">There are currently no hazards in the system.</p>
                            </div>
                        </EmptyTemplate>
                    </RadzenDataList>
                }
            </RadzenCard>
        </div>
    </div>
}
