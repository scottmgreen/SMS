@page "/ConfidentialReporting/TrackStatus/{TrackingCode}"
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Application.Messaging.Queries
@using SMS3.Components.Shared
@layout SMS3.Components.Layout.AnonymousLayout
@inherits ComponentBase

<PageTitle>Report Status - @TrackingCode</PageTitle>

<!-- SMS Page Header using standard component -->
<PageHeader Title="@PageTitle"
           Subtitle="@PageSubtitle"
           Icon="fas fa-clipboard-list"
           AdditionalContent="@AdditionalHeaderContent" />

<!-- Loading State -->
@if (IsLoading)
{
    <div class="text-center py-5">
        <RadzenProgressBarCircular ShowValue="false" class="mb-3" />
        <h6 class="text-muted">Loading report status...</h6>
    </div>
}
else if (ReportDetails != null)
{
    <!-- Tracking Information Card -->
    <RadzenCard class="mb-4">
        <div class="tracking-header">
            <h5 class="mb-3">
                <RadzenIcon Icon="track_changes" class="me-2" />
                Tracking Information
            </h5>
            
            <div class="row g-3">
                <div class="col-lg-6">
                    <div class="info-item">
                        <label class="info-label">Tracking ID</label>
                        <div class="info-value tracking-id">@TrackingCode</div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="info-item">
                        <label class="info-label">Report Type</label>
                        <div class="info-value">@(ReportDetails.HazardType ?? "Confidential Safety Report")</div>
                    </div>
                </div>
            </div>
        </div>
    </RadzenCard>

    <!-- Basic Information Card -->
    <RadzenCard class="mb-4">
        <h5 class="mb-3">
            <RadzenIcon Icon="info" class="me-2" />
            Report Information
        </h5>
        
        <div class="row g-3">
            <div class="col-lg-6">
                <div class="info-item">
                    <label class="info-label">Submitted</label>
                    <div class="info-value">
                        @ReportDetails.ReportedOn.ToString("dddd, MMMM dd, yyyy 'at' h:mm tt")
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="info-item">
                    <label class="info-label">Reporter</label>
                    <div class="info-value">
                        <i class="fas fa-shield-alt me-2 text-success"></i>
                        Anonymous (Identity Protected)
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div class="info-item">
                    <label class="info-label">Report Description</label>
                    <div class="info-value">
                        @if (ReportDetails.IsConfidential)
                        {
                            <span class="text-muted">
                                <i class="fas fa-lock me-2"></i>
                                Confidential report - details available to authorized safety personnel only
                            </span>
                        }
                        else
                        {
                            <span>@(ReportDetails.Description ?? "Report details under review")</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </RadzenCard>

    <!-- Status Information Card -->
    <RadzenCard class="mb-4">
        <h5 class="mb-3">
            <RadzenIcon Icon="assignment_turned_in" class="me-2" />
            Current Status
        </h5>
        
        <div class="row g-3">
            <div class="col-lg-6">
                <div class="info-item">
                    <label class="info-label">Processing Status</label>
                    <div class="info-value">
                        <RadzenBadge Text="@ReportDetails.CurrentStatus" 
                                     BadgeStyle="@GetStatusBadgeStyle(ReportDetails.CurrentStatus)" 
                                     class="status-badge-large" />
                    </div>
                </div>
            </div>
            
            @if (!string.IsNullOrEmpty(ReportDetails.ValidationDecision))
            {
                <div class="col-lg-6">
                    <div class="info-item">
                        <label class="info-label">SMS Review Decision</label>
                        <div class="info-value">
                            <RadzenBadge Text="@GetValidationDecisionDisplay(ReportDetails.ValidationDecision)" 
                                         BadgeStyle="@GetValidationBadgeStyle(ReportDetails.ValidationDecision)" 
                                         class="status-badge-large" />
                        </div>
                    </div>
                </div>
            }
        </div>
        
        @if (ReportDetails.ValidationDate.HasValue)
        {
            <div class="row g-3 mt-2">
                <div class="col-lg-6">
                    <div class="info-item">
                        <label class="info-label">Review Completed</label>
                        <div class="info-value">
                            @ReportDetails.ValidationDate.Value.ToString("MMMM dd, yyyy")
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="info-item">
                        <label class="info-label">Reviewed By</label>
                        <div class="info-value">SMS Safety Team</div>
                    </div>
                </div>
            </div>
        }
    </RadzenCard>

    <!-- Processing Timeline -->
    <RadzenCard class="mb-4">
        <h5 class="mb-3">
            <RadzenIcon Icon="timeline" class="me-2" />
            Processing Timeline
        </h5>
        
        <div class="processing-timeline">
            <!-- Report Submitted -->
            <div class="timeline-item completed">
                <div class="timeline-icon">
                    <i class="fas fa-file-alt"></i>
                </div>
                <div class="timeline-content">
                    <h6 class="mb-1">Report Submitted</h6>
                    <p class="mb-0 text-muted">
                        @ReportDetails.ReportedOn.ToString("MMMM dd, yyyy 'at' h:mm tt")
                    </p>
                    <small class="text-success">? Complete</small>
                </div>
            </div>

            <!-- Initial Review -->
            <div class="timeline-item @(IsStepCompleted("InitialReview") ? "completed" : "current")">
                <div class="timeline-icon">
                    <i class="fas fa-search"></i>
                </div>
                <div class="timeline-content">
                    <h6 class="mb-1">Initial Review</h6>
                    <p class="mb-0 text-muted">
                        Safety team reviewing report details and categorization
                    </p>
                    @if (IsStepCompleted("InitialReview"))
                    {
                        <small class="text-success">? Complete</small>
                    }
                    else
                    {
                        <small class="text-primary">?? In Progress</small>
                    }
                </div>
            </div>

            <!-- SMS Risk Assessment -->
            <div class="timeline-item @(IsStepCompleted("RiskAssessment") ? "completed" : "current")">
                <div class="timeline-icon">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <div class="timeline-content">
                    <h6 class="mb-1">SMS Risk Assessment</h6>
                    <p class="mb-0 text-muted">
                        Evaluating if report qualifies as SMS risk requiring formal action
                    </p>
                    @if (IsStepCompleted("RiskAssessment"))
                    {
                        <small class="text-success">? Complete</small>
                    }
                    else
                    {
                        <small class="text-primary">?? In Progress</small>
                    }
                </div>
            </div>

            <!-- Final Processing -->
            <div class="timeline-item @(IsStepCompleted("FinalProcessing") ? "completed" : "current")">
                <div class="timeline-icon">
                    <i class="fas fa-flag-checkered"></i>
                </div>
                <div class="timeline-content">
                    <h6 class="mb-1">Final Processing</h6>
                    <p class="mb-0 text-muted">
                        Implementation of corrective actions and process closure
                    </p>
                    @if (IsStepCompleted("FinalProcessing"))
                    {
                        <small class="text-success">? Complete</small>
                    }
                    else
                    {
                        <small class="text-primary">?? In Progress</small>
                    }
                </div>
            </div>
        </div>
    </RadzenCard>

    <!-- Location Information Card -->
    @if (HazardLocation != null)
    {
        <RadzenCard class="mb-4">
            <h5 class="mb-3">
                <RadzenIcon Icon="place" class="me-2" />
                Location Information
            </h5>
            
            <RadzenRow>
                <RadzenColumn Size="8">
                    <div class="row g-3">
                        @if (HazardLocation.Latitude.HasValue && HazardLocation.Longitude.HasValue)
                        {
                            <div class="col-lg-6">
                                <div class="info-item">
                                    <label class="info-label">Coordinates</label>
                                    <div class="info-value coordinates">
                                        <i class="fas fa-map-marker-alt me-2"></i>
                                        @HazardLocation.Latitude.Value.ToString("F6"), @HazardLocation.Longitude.Value.ToString("F6")
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="info-item">
                                    <label class="info-label">Location Code</label>
                                    <div class="info-value">@HazardLocation.Code</div>
                                </div>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(HazardLocation.Description))
                        {
                            <div class="col-12">
                                <div class="info-item">
                                    <label class="info-label">Description</label>
                                    <div class="info-value">@HazardLocation.Description</div>
                                </div>
                            </div>
                        }

                        @if (HazardLocation.CreatedDate.HasValue)
                        {
                            <div class="col-lg-6">
                                <div class="info-item">
                                    <label class="info-label">Location Recorded</label>
                                    <div class="info-value">@HazardLocation.CreatedDate.Value.ToString("MM/dd/yyyy")</div>
                                </div>
                            </div>
                        }
                    </div>
                </RadzenColumn>
                <RadzenColumn Size="4">
                    @if (HazardLocation.Latitude.HasValue && HazardLocation.Longitude.HasValue)
                    {
                        <div class="text-center">
                            <ReadOnlyLocationMap Latitude="@HazardLocation.Latitude.Value"
                                               Longitude="@HazardLocation.Longitude.Value"
                                               LocationDescription="@(HazardLocation.Description ?? ReportDetails?.HazardCode ?? "Location")"
                                               MapHeight="200px"
                                               ShowZoomControls="false"
                                               ShowCoordinates="false"
                                               ShowLocationDetails="false"
                                               ZoomLevel="16" />
                            <small class="text-muted d-block mt-2">
                                <i class="fas fa-info-circle me-1"></i>
                                Interactive map view
                            </small>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted p-4">
                            <i class="fas fa-map-marker-alt fa-3x mb-3" style="color: #dee2e6;"></i>
                            <div><strong>No Coordinates Available</strong></div>
                            <small>Location data does not include geographic coordinates</small>
                        </div>
                    }
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>
    }
    else if (ReportDetails != null && (!string.IsNullOrEmpty(ReportDetails.LocationArea) || !string.IsNullOrEmpty(ReportDetails.LocationSubArea)))
    {
        <!-- Fallback Location Card for text-based location info -->
        <RadzenCard class="mb-4">
            <h5 class="mb-3">
                <RadzenIcon Icon="place" class="me-2" />
                Location Information
            </h5>
            
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true">
                <strong>Text-Based Location:</strong> This report contains location information but no geographic coordinates for mapping.
            </RadzenAlert>
            
            <div class="row g-3 mt-2">
                @if (!string.IsNullOrEmpty(ReportDetails.LocationArea))
                {
                    <div class="col-lg-6">
                        <div class="info-item">
                            <label class="info-label">Location Area</label>
                            <div class="info-value">@ReportDetails.LocationArea</div>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(ReportDetails.LocationSubArea))
                {
                    <div class="col-lg-6">
                        <div class="info-item">
                            <label class="info-label">Location Sub-Area</label>
                            <div class="info-value">@ReportDetails.LocationSubArea</div>
                        </div>
                    </div>
                }
            </div>
        </RadzenCard>
    }

    <!-- Contact Information -->
    <RadzenCard class="mb-4">
        <h5 class="mb-3">
            <RadzenIcon Icon="contact_phone" class="me-2" />
            Need More Information?
        </h5>
        
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
            <div class="row">
                <div class="col-md-6">
                    <h6 class="mb-2">Confidential Safety Hotline</h6>
                    <p class="mb-2">
                        <i class="fas fa-phone me-2"></i>
                        <strong>(503) 555-0199</strong>
                    </p>
                    <p class="mb-0 small">
                        Available 24/7 for questions about your confidential report
                    </p>
                </div>
                <div class="col-md-6">
                    <h6 class="mb-2">Email Support</h6>
                    <p class="mb-2">
                        <i class="fas fa-envelope me-2"></i>
                        <strong>safety@pdxairport.com</strong>
                    </p>
                    <p class="mb-0 small">
                        Reference your tracking ID: <strong>@TrackingCode</strong>
                    </p>
                </div>
            </div>
        </RadzenAlert>
    </RadzenCard>
}
else
{
    <!-- Error State -->
    <RadzenCard>
        <div class="text-center py-5">
            <RadzenIcon Icon="error" Style="font-size: 3rem; color: var(--rz-danger);" class="mb-3" />
            <h5 class="text-danger mb-3">Report Not Found</h5>
            <p class="text-muted mb-4">
                We couldn't find a report with tracking ID: <strong>@TrackingCode</strong>
            </p>
            
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" class="text-start mb-4">
                <h6 class="mb-2">Please verify:</h6>
                <ul class="mb-2">
                    <li>Tracking ID is entered correctly (format: HT-YYYY-NNNN)</li>
                    <li>Report was submitted recently (may take a few minutes to appear)</li>
                    <li>You have the complete tracking ID from your submission confirmation</li>
                </ul>
            </RadzenAlert>
            
            <div class="d-flex justify-content-center gap-3">
                <RadzenButton Text="Try Different ID" 
                              Icon="search" 
                              ButtonStyle="ButtonStyle.Primary" 
                              Click="@BackToSearch" />
                <RadzenButton Text="Submit New Report" 
                              Icon="add" 
                              ButtonStyle="ButtonStyle.Success" 
                              Click="@NavigateToReporting" />
            </div>
        </div>
    </RadzenCard>
}

<style>
    .info-item {
        margin-bottom: 1rem;
    }

    .info-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 0.25rem;
        display: block;
    }

    .info-value {
        font-size: 1rem;
        font-weight: 500;
        color: #212e61;
    }

    .tracking-id {
        font-family: 'Courier New', monospace;
        font-size: 1.2rem;
        color: #0d6efd;
        font-weight: 700;
    }

    .status-badge-large {
        font-size: 1rem !important;
        padding: 0.5rem 1rem !important;
    }

    .coordinates {
        font-family: 'Courier New', monospace;
        font-weight: 600;
    }

    /* Processing Timeline Styles */
    .processing-timeline {
        position: relative;
        padding-left: 3rem;
    }

    .processing-timeline::before {
        content: '';
        position: absolute;
        left: 1rem;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #e9ecef;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 2rem;
    }

    .timeline-icon {
        position: absolute;
        left: -2rem;
        top: 0;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        z-index: 1;
    }

    .timeline-item.completed .timeline-icon {
        background: #28a745;
        color: white;
        border: 3px solid white;
        box-shadow: 0 0 0 3px #28a745;
    }

    .timeline-item.current .timeline-icon {
        background: #007bff;
        color: white;
        border: 3px solid white;
        box-shadow: 0 0 0 3px #007bff;
    }

    .timeline-content {
        margin-left: 0.5rem;
    }

    .timeline-content h6 {
        color: #212e61;
        margin-bottom: 0.5rem;
    }

    @@media (max-width: 768px) {
        .processing-timeline {
            padding-left: 1.5rem;
        }

        .timeline-icon {
            left: -2rem;
            width: 2rem;
            height: 2rem;
        }

        .timeline-content {
            margin-left: 0.5rem;
        }
    }
</style>