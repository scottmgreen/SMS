<!-- Report Creation Component - Modal Dialog -->
<RadzenDialog />

@if (IsLoading)
{
    <!-- Loading State -->
    <div class="text-center py-5">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        <p class="mt-3 text-muted">Processing your report...</p>
    </div>
}
else if (ShowSuccessConfirmation)
{
    <!-- Success Modal - Properly sized -->
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-sm">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-success">
                    <h5 class="sms-modal-title">
                        <i class="fas fa-check-circle"></i> Hazard Report Successfully Submitted!
                    </h5>
                </div>
                <div class="sms-modal-body">
                    <!-- Success Message -->
                    <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Class="mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-clipboard-check fa-2x me-3"></i>
                            <div>
                                <h6 class="mb-1">Report Successfully Submitted!</h6>
                                <p class="mb-1"><strong>Your Hazard Report ID:</strong></p>
                                <h5 class="text-success mb-0">
                                    <i class="fas fa-id-badge"></i> @GeneratedHazardId
                                </h5>
                            </div>
                        </div>
                    </RadzenAlert>

                    <!-- Compact Report Details -->
                    <RadzenCard Variant="Variant.Outlined" Class="mb-3">
                        <div class="p-3">
                            <h6 class="text-primary mb-2">
                                <i class="fas fa-info-circle"></i> Report Summary
                            </h6>
                            <div class="row">
                                <div class="col-sm-6">
                                    <small><strong>Hazard ID:</strong> @GeneratedHazardId</small><br>
                                    <small><strong>Tracking ID:</strong> @GeneratedReportId</small><br>
                                    <small><strong>Status:</strong> <RadzenBadge Text="Submitted" BadgeStyle="BadgeStyle.Success" /></small>
                                </div>
                                <div class="col-sm-6">
                                    <small><strong>Submitted:</strong> @DateTime.Now.ToString("MM/dd/yyyy HH:mm")</small><br>
                                    <small><strong>Confidential:</strong> @(HazardReportData.IsConfidential ? "Yes" : "No")</small>
                                </div>
                            </div>
                        </div>
                    </RadzenCard>

                    <!-- Next Steps - Compact -->
                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Size="AlertSize.Small" Class="mb-3">
                        <h6 class="mb-2"><i class="fas fa-route"></i> What Happens Next:</h6>
                        <ul class="small mb-0">
                            <li>Email confirmation within 5 minutes</li>
                            <li>SMS review within 24-48 hours</li>
                            <li>Risk assessment if validated</li>
                        </ul>
                    </RadzenAlert>

                    <div class="text-center">
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                    Click="ResetForm" 
                                    Text="Continue & Clear Form" 
                                    Icon="check"
                                    Size="ButtonSize.Medium" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Main Content - Properly sized for modal -->
    <div class="sms-report-create-container">
        <div class="row">
            <!-- Form Column - Larger in modal -->
            <div class="col-xl-9 col-lg-8">
                <RadzenCard Variant="Variant.Outlined">
                    <div class="p-3">
                        <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                            <i class="fas fa-edit text-primary me-2" style="font-size: 1.2rem;"></i>
                            <h5 class="mb-0">Hazard Report Details</h5>
                        </div>

                        <RadzenTemplateForm Data="@HazardReportData" Submit="@HandleFormSubmit" TItem="ReportHazardData">
                            <!-- Hazard Type -->
                            <div class="mb-3">
                                <RadzenFormField Text="Hazard Type *" Variant="Variant.Outlined">
                                    <RadzenDropDown @bind-Value="@HazardReportData.HazardType" 
                                                  Data="@HazardTypeOptions" 
                                                  TextProperty="Text" 
                                                  ValueProperty="Value"
                                                  Placeholder="Select hazard type..."
                                                  Name="HazardType"
                                                  Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="HazardType" Text="Hazard type is required" />
                            </div>

                            <!-- Reported By and Reported On -->
                            <div class="row mb-3">
                                <div class="col-md-8">
                                    <RadzenFormField Text="Reported By *" Variant="Variant.Outlined">
                                        <RadzenTextBox @bind-Value="@HazardReportData.ReportedBy" 
                                                     Placeholder="Name and position (e.g., 'John Smith - Ground Operations')"
                                                     Name="ReportedBy"
                                                     Style="width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenRequiredValidator Component="ReportedBy" Text="Reported by is required" />
                                </div>
                                <div class="col-md-4">
                                    <RadzenFormField Text="Reported On *" Variant="Variant.Outlined">
                                        <RadzenDatePicker @bind-Value="@HazardReportData.ReportedOn" 
                                                        ShowTime="true"
                                                        DateFormat="MM/dd/yyyy HH:mm"
                                                        Style="width: 100%;" />
                                    </RadzenFormField>
                                </div>
                            </div>

                            <!-- Department -->
                            <div class="mb-3">
                                <RadzenFormField Text="Reporting Department" Variant="Variant.Outlined">
                                    <RadzenDropDown @bind-Value="@HazardReportData.ReportingDepartment" 
                                                  Data="@DepartmentOptions" 
                                                  TextProperty="Text" 
                                                  ValueProperty="Value"
                                                  Placeholder="Select your department..."
                                                  AllowClear="true"
                                                  Style="width: 100%;" />
                                </RadzenFormField>
                            </div>

                            <!-- Location - Compact -->
                            <div class="mb-3">
                                <RadzenFormField Text="Location *" Variant="Variant.Outlined">
                                    <div class="d-flex gap-2">
                                        <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                                    Click="ShowLocationSelectorPanel"
                                                    Text="Select Location" 
                                                    Icon="map" 
                                                    Size="ButtonSize.Small" />
                                        <RadzenTextBox Value="@LocationDisplayText" 
                                                     ReadOnly="true"
                                                     Placeholder="No location selected"
                                                     Style="flex: 1;" />
                                    </div>
                                </RadzenFormField>
                                @if (HasGeoLocation)
                                {
                                    <small class="text-success">
                                        <i class="fas fa-map-pin"></i> Location set: @LocationDisplayText
                                    </small>
                                }
                            </div>

                            <!-- Compact Location Selector -->
                            @if (ShowLocationSelector)
                            {
                                <div class="mb-3">
                                    <RadzenCard Variant="Variant.Outlined" Class="sms-compact-location-selector">
                                        <div class="p-3">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="mb-0">
                                                    <i class="fas fa-map-marker-alt text-primary"></i> Select Location
                                                </h6>
                                                <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                                            Variant="Variant.Text"
                                                            Icon="close"
                                                            Size="ButtonSize.Small"
                                                            Click="@(() => ShowLocationSelector = false)" />
                                            </div>
                                            
                                            <!-- Quick Options -->
                                            <div class="mb-2">
                                                <small class="text-muted">Quick Locations:</small>
                                                <div class="d-flex flex-wrap gap-1 mt-1">
                                                    <RadzenButton Text="Terminal" Size="ButtonSize.ExtraSmall" 
                                                                Click="@(() => SetQuickLocation("PDX Terminal Area"))" />
                                                    <RadzenButton Text="Runway 28L" Size="ButtonSize.ExtraSmall" 
                                                                Click="@(() => SetQuickLocation("Runway 28L"))" />
                                                    <RadzenButton Text="Cargo Area" Size="ButtonSize.ExtraSmall" 
                                                                Click="@(() => SetQuickLocation("Cargo Operations"))" />
                                                    <RadzenButton Text="Other" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                                                Click="ShowDetailedLocationSelector" />
                                                </div>
                                            </div>
                                            
                                            <!-- Manual Description -->
                                            <RadzenFormField Text="Or describe location" Variant="Variant.Outlined">
                                                <RadzenTextArea @bind-Value="@ManualLocationDescription" 
                                                              Rows="2"
                                                              Placeholder="Describe the specific location..."
                                                              Style="width: 100%;" />
                                            </RadzenFormField>
                                            
                                            <div class="d-flex justify-content-end gap-2 mt-2">
                                                <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                                            Text="Use Location" 
                                                            Icon="check"
                                                            Size="ButtonSize.Small"
                                                            Click="ConfirmLocationSelection"
                                                            Disabled="@(string.IsNullOrWhiteSpace(ManualLocationDescription) && string.IsNullOrWhiteSpace(SelectedQuickLocation))" />
                                                <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                                            Text="Cancel" 
                                                            Size="ButtonSize.Small"
                                                            Click="@(() => ShowLocationSelector = false)" />
                                            </div>
                                        </div>
                                    </RadzenCard>
                                </div>
                            }

                            <!-- Description -->
                            <div class="mb-3">
                                <RadzenFormField Text="Hazard Description *" Variant="Variant.Outlined">
                                    <RadzenTextArea @bind-Value="@HazardReportData.Description" 
                                                  Rows="5"
                                                  Name="Description"
                                                  Placeholder="Provide a detailed description of the hazard..."
                                                  Style="width: 100%;" />
                                </RadzenFormField>
                                <div class="d-flex justify-content-between align-items-center">
                                    <RadzenRequiredValidator Component="Description" Text="Description is required" />
                                    <small class="@(DescriptionCharacterCount > 1950 ? "text-danger" : DescriptionCharacterCount > 1800 ? "text-warning" : "text-muted")">
                                        @DescriptionCharacterCount/2000 characters
                                    </small>
                                </div>
                            </div>

                            <!-- Confidential Flag -->
                            <div class="mb-3">
                                <RadzenCard Variant="Variant.Text" Class="border border-info">
                                    <div class="p-2">
                                        <div class="form-check">
                                            <RadzenCheckBox @bind-Value="@HazardReportData.IsConfidential" 
                                                          Name="IsConfidential" 
                                                          TriState="false" />
                                            <RadzenLabel Text="Submit as Confidential Report" Component="IsConfidential" Class="form-check-label ms-2" />
                                        </div>
                                        @if (HazardReportData.IsConfidential)
                                        {
                                            <small class="text-info">
                                                <i class="fas fa-shield-alt"></i> 
                                                Your identity will be protected and access restricted to authorized SMS personnel.
                                            </small>
                                        }
                                    </div>
                                </RadzenCard>
                            </div>

                            <!-- File Attachments -->
                            <div class="mb-3">
                                <RadzenFormField Text="Supporting Documents" Variant="Variant.Outlined">
                                    <RadzenFileInput @bind-Value="@SelectedFiles" 
                                                   Multiple="true"
                                                   Accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.txt"
                                                   MaxFileSize="10485760"
                                                   Style="width: 100%;" />
                                </RadzenFormField>
                                <small class="text-muted">
                                    <i class="fas fa-paperclip"></i> Supported: JPG, PNG, PDF, DOC, DOCX, TXT (Max 10MB)
                                </small>
                            </div>

                            <!-- Form Actions -->
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <RadzenButton ButtonStyle="ButtonStyle.Info" 
                                            Variant="Variant.Outlined"
                                            Icon="preview"
                                            Text="Preview"
                                            Size="ButtonSize.Medium"
                                            Click="ShowPreview"
                                            Disabled="@(!IsFormValidForPreview)" />
                                <div class="d-flex gap-2">
                                    <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                                Icon="clear"
                                                Text="Clear Form"
                                                Size="ButtonSize.Medium"
                                                Click="ClearForm" />
                                    <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                                Icon="send"
                                                Text="Submit Report"
                                                Size="ButtonSize.Medium"
                                                Click="ShowSubmissionConfirmationDialog"
                                                Disabled="@(!IsFormValidForSubmission)" />
                                </div>
                            </div>
                        </RadzenTemplateForm>
                    </div>
                </RadzenCard>
            </div>

            <!-- Compact Guidance Panel -->
            <div class="col-xl-3 col-lg-4">
                <RadzenCard Variant="Variant.Outlined" Class="sms-guidance-panel">
                    <div class="p-3">
                        <div class="d-flex align-items-center mb-2 pb-2 border-bottom">
                            <i class="fas fa-info-circle text-primary me-2"></i>
                            <h6 class="mb-0">Reporting Guidelines</h6>
                        </div>

                        <div class="mb-3">
                            <h6 class="text-primary mb-2" style="font-size: 0.9rem;">What to Report:</h6>
                            <ul class="list-unstyled small">
                                <li><i class="fas fa-check text-success me-1"></i> Incidents or accidents</li>
                                <li><i class="fas fa-check text-success me-1"></i> Near-miss events</li>
                                <li><i class="fas fa-check text-success me-1"></i> Unsafe conditions</li>
                                <li><i class="fas fa-check text-success me-1"></i> Equipment issues</li>
                                <li><i class="fas fa-check text-success me-1"></i> Procedure violations</li>
                            </ul>
                        </div>

                        <div class="mb-3">
                            <h6 class="text-primary mb-2" style="font-size: 0.9rem;">Confidential Reporting:</h6>
                            <p class="small mb-2">Use when concerned about:</p>
                            <ul class="list-unstyled small">
                                <li><i class="fas fa-shield-alt text-info me-1"></i> Personal safety</li>
                                <li><i class="fas fa-shield-alt text-info me-1"></i> Retaliation</li>
                                <li><i class="fas fa-shield-alt text-info me-1"></i> Sensitive information</li>
                            </ul>
                        </div>

                        <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" Variant="Variant.Flat">
                            <div class="text-center">
                                <h6 class="small mb-1">Need Help?</h6>
                                <p class="small mb-1">SMS Team: (503) 555-0100</p>
                                <p class="small mb-0">sms@flypdx.com</p>
                            </div>
                        </RadzenAlert>
                    </div>
                </RadzenCard>
            </div>
        </div>
    </div>
}

<!-- Submission Confirmation Modal - Compact -->
@if (ShowSubmissionConfirmation)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-md">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-warning">
                    <h5 class="sms-modal-title">
                        <i class="fas fa-exclamation-triangle"></i> Confirm Submission
                    </h5>
                </div>
                <div class="sms-modal-body">
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Class="mb-3">
                        <h6 class="mb-1">Submit this hazard report?</h6>
                        <p class="mb-0 small">Once submitted, this report will enter the SMS workflow.</p>
                    </RadzenAlert>

                    <!-- Compact Summary -->
                    <div class="mb-3">
                        <h6 class="text-primary mb-2">Report Summary:</h6>
                        <div class="small">
                            <p class="mb-1"><strong>Type:</strong> @GetHazardTypeDisplay(HazardReportData.HazardType)</p>
                            <p class="mb-1"><strong>Location:</strong> @LocationDisplayText</p>
                            <p class="mb-1"><strong>Reported By:</strong> @HazardReportData.ReportedBy</p>
                            <p class="mb-0"><strong>Confidential:</strong> @(HazardReportData.IsConfidential ? "Yes" : "No")</p>
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-center gap-3">
                        <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                    Text="Submit Report" 
                                    Icon="check"
                                    Click="SubmitReportConfirmed"
                                    Size="ButtonSize.Medium" />
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                    Text="Continue Editing" 
                                    Icon="edit"
                                    Click="CancelSubmission"
                                    Size="ButtonSize.Medium"
                                    Variant="Variant.Outlined" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
/* =============================================================================
   SMS REPORT CREATE - MODAL OPTIMIZED STYLING
   ============================================================================= */

.sms-report-create-container {
    max-width: 100%;
    margin: 0;
    padding: 0.5rem;
}

/* Modal Overlay and Dialog */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
    padding: 1rem;
}

.sms-modal-dialog {
    position: relative;
    margin: 0 auto;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
}

.sms-modal-lg {
    max-width: 900px;
    width: 100%;
}

.sms-modal-md {
    max-width: 600px;
    width: 100%;
}

.sms-modal-content {
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
}

.sms-modal-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e9ecef;
    border-radius: 0.5rem 0.5rem 0 0;
}

.sms-header-success {
    background-color: #0d8944; /* SMS Green Primary */
    color: white;
}

.sms-header-warning {
    background-color: #fa9a46; /* SMS Orange Accent */
    color: #212e61; /* SMS Blue Dark Bold */
}

.sms-modal-title {
    margin: 0;
    font-weight: 600;
}

.sms-modal-body {
    padding: 1.5rem;
}

/* Compact Location Selector */
.sms-compact-location-selector {
    border-color: #4ac6f7 !important; /* SMS Blue Accent */
}

/* Guidance Panel - Consistent with other SMS pages */
.sms-guidance-panel {
    background: linear-gradient(135deg, rgba(201, 227, 237, 0.05) 0%, rgba(205, 235, 241, 0.05) 100%);
    border-color: #c9e3ed !important; /* SMS Blue Light */
}

.sms-guidance-panel .text-primary {
    color: #212e61 !important; /* SMS Blue Dark Bold */
}

.sms-guidance-panel .text-success {
    color: #0d8944 !important; /* SMS Green Primary */
}

.sms-guidance-panel .text-info {
    color: #006AA9 !important; /* SMS Blue Primary */
}

/* Form Field Styling */
.form-check-label {
    font-weight: 500;
    color: #212e61; /* SMS Blue Dark Bold */
}

/* Responsive adjustments */
@@media (max-width: 992px) {
    .sms-report-create-container {
        padding: 0.25rem;
    }
    
    .modal-overlay {
        padding: 0.5rem;
    }
    
    .sms-modal-dialog {
        max-height: calc(100vh - 1rem);
    }
    
    .sms-modal-body {
        padding: 1rem;
    }
}

@@media (max-width: 768px) {
    .sms-modal-lg {
        max-width: 100%;
    }
    
    .sms-modal-md {
        max-width: 100%;
    }
    
    .sms-modal-header {
        padding: 0.75rem 1rem;
    }
    
    .sms-modal-body {
        padding: 1rem 0.75rem;
    }
}

/* Ensure proper input sizing */
::deep .rz-textbox,
::deep .rz-dropdown,
::deep .rz-textarea,
::deep .rz-datepicker {
    width: 100% !important;
}

/* Character count styling */
.text-warning {
    color: #fa9a46 !important; /* SMS Orange Accent */
}

.text-danger {
    color: #d91e3e !important; /* SMS Red Primary */
}

/* =============================================================================
   END SMS REPORT CREATE STYLING
   ============================================================================= */
</style>