<!-- Enhanced Hazard Location Selection Component with OpenLayers (OpenStreetMap) -->
<div class="hazard-location-container">
    @if (ShowLocationPanel)
    {
        <RadzenCard Variant="Variant.Outlined" Class="mt-3">
            <RadzenStack Gap="1rem">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <RadzenIcon Icon="map" Style="color: var(--rz-primary); font-size: 1.5rem;" />
                        <h5 class="mb-0">Select Hazard Location</h5>
                    </div>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                Variant="Variant.Text"
                                Icon="close"
                                Size="ButtonSize.Small"
                                Click="CloseLocationPanel"
                                title="Close location selector" />
                </div>

                <!-- Location Selection Methods -->
                <RadzenCard Variant="Variant.Text">
                    <RadzenRadioButtonList @bind-Value="LocationSelectionMode" 
                                         TValue="string" 
                                         Orientation="Orientation.Horizontal"
                                         Change="OnLocationModeChanged">
                        <Items>
                            <RadzenRadioButtonListItem Text="Interactive Map" Value="@("map")" />
                            <RadzenRadioButtonListItem Text="Current Location" Value="@("current")" />
                            <RadzenRadioButtonListItem Text="Enter Coordinates" Value="@("coordinates")" />
                            <RadzenRadioButtonListItem Text="Text Description" Value="@("description")" />
                        </Items>
                    </RadzenRadioButtonList>
                </RadzenCard>

                @if (LocationSelectionMode == "map")
                {
                    <!-- OpenLayers Map Integration -->
                    <RadzenCard>
                        <RadzenStack Gap="1rem">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">Click on the map to select location</h6>
                                <RadzenBadge Text="OpenStreetMap" BadgeStyle="BadgeStyle.Success" />
                            </div>
                            
                            <!-- Map Container -->
                            <div id="@MapContainerId" style="height: 400px; border: 1px solid #ddd; border-radius: 4px;" class="map-container">
                                <!-- Map will be initialized here via JavaScript -->
                            </div>

                            <!-- Map Instructions -->
                            <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small">
                                <strong>Instructions:</strong> Click anywhere on the map to place a location marker. The red marker shows your selected hazard location.
                            </RadzenAlert>

                            <!-- Quick Location Buttons -->
                            <div class="d-flex gap-2 flex-wrap">
                                <RadzenButton Text="PDX Terminal" Size="ButtonSize.Small" 
                                            Click="@(() => SetMapLocation(45.5898, -122.5951, "PDX Terminal Area"))" />
                                <RadzenButton Text="Runway 28L" Size="ButtonSize.Small" 
                                            Click="@(() => SetMapLocation(45.5895, -122.6015, "Runway 28L Area"))" />
                                <RadzenButton Text="Cargo Area" Size="ButtonSize.Small" 
                                            Click="@(() => SetMapLocation(45.5901, -122.5980, "Cargo Operations Area"))" />
                                <RadzenButton Text="Reset View" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                            Click="ResetMapView" />
                            </div>
                        </RadzenStack>
                    </RadzenCard>
                }
                else if (LocationSelectionMode == "current")
                {
                    <!-- Current Location -->
                    <RadzenCard>
                        <RadzenStack Gap="1rem">
                            <div class="d-flex align-items-center gap-2">
                                <RadzenIcon Icon="my_location" Style="color: var(--rz-primary);" />
                                <h6 class="mb-0">Use Current GPS Location</h6>
                            </div>
                            <p class="text-muted mb-2">Click the button below to automatically detect your current location using GPS.</p>
                            <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                        Icon="gps_fixed"
                                        Text="@(IsGettingLocation ? "Getting Location..." : "Get Current Location")"
                                        Click="GetCurrentLocation"
                                        Disabled="@IsGettingLocation" />
                        </RadzenStack>
                    </RadzenCard>
                }
                else if (LocationSelectionMode == "coordinates")
                {
                    <!-- Manual Coordinates Entry -->
                    <RadzenCard>
                        <RadzenStack Gap="1rem">
                            <h6>Enter Coordinates Manually</h6>
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Latitude" Variant="Variant.Outlined">
                                        <RadzenNumeric @bind-Value="@ManualLatitude" 
                                                     Step="0.000001M"
                                                     Min="-90M"
                                                     Max="90M"
                                                     Placeholder="45.589800"
                                                     Style="width: 100%;" />
                                    </RadzenFormField>
                                    <small class="text-muted">Valid range: -90 to 90</small>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Longitude" Variant="Variant.Outlined">
                                        <RadzenNumeric @bind-Value="@ManualLongitude" 
                                                     Step="0.000001M"
                                                     Min="-180M"
                                                     Max="180M"
                                                     Placeholder="-122.595100"
                                                     Style="width: 100%;" />
                                    </RadzenFormField>
                                    <small class="text-muted">Valid range: -180 to 180</small>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenFormField Text="Location Description (Optional)" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="@ManualDescription" 
                                             Placeholder="Describe the specific location (e.g., 'Terminal A, Gate 5')..."
                                             Style="width: 100%;" />
                            </RadzenFormField>
                            <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                        Icon="check"
                                        Text="Use These Coordinates"
                                        Click="UseManualCoordinates"
                                        Disabled="@(!HasValidManualCoordinates)" />
                        </RadzenStack>
                    </RadzenCard>
                }
                else if (LocationSelectionMode == "description")
                {
                    <!-- Text Description Only -->
                    <RadzenCard>
                        <RadzenStack Gap="1rem">
                            <h6>Describe Location</h6>
                            <RadzenFormField Text="Location Description" Variant="Variant.Outlined">
                                <RadzenTextArea @bind-Value="@LocationDescription" 
                                              Rows="4"
                                              Placeholder="Provide a detailed description of where the hazard occurred:&#10;&#10;Examples:&#10;• Terminal A, Gate 5, near security checkpoint&#10;• Runway 28L, approximately 2000ft from threshold&#10;• Maintenance hangar, east side, near equipment storage&#10;• Baggage claim area, carousel #3"
                                              Style="width: 100%;" />
                            </RadzenFormField>
                            <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                        Icon="check"
                                        Text="Use Description"
                                        Click="UseLocationDescription"
                                        Disabled="@(string.IsNullOrWhiteSpace(LocationDescription))" />
                        </RadzenStack>
                    </RadzenCard>
                }

                <!-- Current Selection Display -->
                @if (HasSelectedLocation)
                {
                    <RadzenCard Variant="Variant.Outlined" Style="border-left: 4px solid var(--rz-success);">
                        <RadzenStack Gap="1rem">
                            <div class="d-flex align-items-center gap-2">
                                <RadzenIcon Icon="location_on" Style="color: var(--rz-success); font-size: 1.5rem;" />
                                <h6 class="mb-0 text-success">Selected Location</h6>
                            </div>
                            @if (SelectedLocation.Latitude != 0 && SelectedLocation.Longitude != 0)
                            {
                                <p class="mb-1"><strong>Coordinates:</strong> @SelectedLocation.Latitude.ToString("F6"), @SelectedLocation.Longitude.ToString("F6")</p>
                            }
                            @if (!string.IsNullOrEmpty(SelectedLocation.Description))
                            {
                                <p class="mb-1"><strong>Description:</strong> @SelectedLocation.Description</p>
                            }
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                            Icon="save"
                                            Text="Confirm This Location"
                                            Click="ConfirmLocation" />
                                <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                            Icon="edit"
                                            Text="Modify"
                                            Click="() => {}" />
                                <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                            Icon="clear"
                                            Text="Clear"
                                            Click="ClearSelection" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                }
            </RadzenStack>
        </RadzenCard>
    }
</div>

<style>
    .hazard-location-container {
        width: 100%;
    }
    
    .map-container {
        border-radius: 4px;
        position: relative;
    }
</style>

@code {
    [Parameter] public EventCallback<GeoLocation> OnLocationSelected { get; set; }
    [Parameter] public GeoLocation? InitialLocation { get; set; }

    public string MapContainerId { get; set; } = $"map-{Guid.NewGuid():N}";
    public bool ShowLocationPanel { get; set; } = false;
    public string LocationSelectionMode { get; set; } = "map";
    public bool IsGettingLocation { get; set; } = false;
    
    public decimal? ManualLatitude { get; set; }
    public decimal? ManualLongitude { get; set; }
    public string ManualDescription { get; set; } = string.Empty;
    public string LocationDescription { get; set; } = string.Empty;
    
    public GeoLocation SelectedLocation { get; set; } = new GeoLocation();
    public bool HasSelectedLocation => SelectedLocation.Latitude != 0 || SelectedLocation.Longitude != 0 || !string.IsNullOrEmpty(SelectedLocation.Description);
    public bool HasValidManualCoordinates => ManualLatitude.HasValue && ManualLongitude.HasValue;

    private void OnLocationModeChanged(object value)
    {
        LocationSelectionMode = value?.ToString() ?? "map";
        StateHasChanged();
    }

    private void SetMapLocation(double lat, double lng, string description)
    {
        SelectedLocation = new GeoLocation
        {
            Latitude = (decimal)lat,
            Longitude = (decimal)lng,
            Description = description
        };
        StateHasChanged();
    }

    private void ResetMapView()
    {
        ClearSelection();
    }

    private void GetCurrentLocation()
    {
        // Placeholder - would use JS interop in real implementation
        SelectedLocation = new GeoLocation
        {
            Latitude = 45.5898m,
            Longitude = -122.5951m,
            Description = "Current Location"
        };
        StateHasChanged();
    }

    private void UseManualCoordinates()
    {
        if (HasValidManualCoordinates)
        {
            SelectedLocation = new GeoLocation
            {
                Latitude = ManualLatitude.Value,
                Longitude = ManualLongitude.Value,
                Description = ManualDescription
            };
            StateHasChanged();
        }
    }

    private void UseLocationDescription()
    {
        if (!string.IsNullOrWhiteSpace(LocationDescription))
        {
            SelectedLocation = new GeoLocation
            {
                Latitude = 0,
                Longitude = 0,
                Description = LocationDescription
            };
            StateHasChanged();
        }
    }

    private async Task ConfirmLocation()
    {
        if (OnLocationSelected.HasDelegate)
        {
            await OnLocationSelected.InvokeAsync(SelectedLocation);
        }
        CloseLocationPanel();
    }

    private void ClearSelection()
    {
        SelectedLocation = new GeoLocation();
        ManualLatitude = null;
        ManualLongitude = null;
        ManualDescription = string.Empty;
        LocationDescription = string.Empty;
        StateHasChanged();
    }

    public void OpenLocationSelector()
    {
        ShowLocationPanel = true;
        StateHasChanged();
    }

    public void CloseLocationPanel()
    {
        ShowLocationPanel = false;
        StateHasChanged();
    }

    public class GeoLocation
    {
        public decimal Latitude { get; set; }
        public decimal Longitude { get; set; }
        public string Description { get; set; } = string.Empty;

        public override string ToString()
        {
            if (Latitude != 0 && Longitude != 0)
            {
                return $"Lat: {Latitude:F6}, Lng: {Longitude:F6}";
            }
            return Description;
        }
    }
}