@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using SMS_Domain.ValueObjects
@using Radzen
@using Radzen.Blazor

@if (IsVisible)
{
    <div class="modal-overlay">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <RadzenIcon Icon="@(IsEditMode ? "edit" : "add_circle")" Style="margin-right: 0.5rem;" />
                        @_modalTitle
                    </h5>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                  Icon="close" Size="ButtonSize.Small"
                                  Click="@CloseModal" />
                </div>
                <div class="modal-body">
                    <RadzenStack Gap="1rem">
                        
                        
                        <!-- Category and Hazard Type -->
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Hazard Category *" Variant="Variant.Outlined" class="@(IsHazardCategoryDefault ? "validation-error-field" : "")">
                                    <RadzenDropDown @bind-Value="@NewHazardCategory"
                                                    Data="@HazardCategoryOptions"
                                                    TextProperty="Text"
                                                    ValueProperty="Value"
                                                    Placeholder="Select hazard category..."
                                                    Change="@(async (object value) => await OnHazardCategoryChanged(value?.ToString()))"
                                                    class="@(IsHazardCategoryDefault ? "default-validation-dropdown" : "")"
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Hazard Type *" Variant="Variant.Outlined" class="@(IsHazardTypeDefault ? "validation-error-field" : "")">
                                    <RadzenDropDown @bind-Value="@NewHazardType"
                                                    Data="@HazardTypeOptions"
                                                    TextProperty="Text"
                                                    ValueProperty="Value"
                                                    Placeholder="Select hazard type..."
                                                    Change="@(async (object value) => await OnHazardTypeChanged(value?.ToString()))"
                                                    Disabled="@(HazardTypeOptions.Count == 0)"
                                                    class="@(IsHazardTypeDefault ? "default-validation-dropdown" : "")"
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                                @if (HazardTypeOptions.Count == 0 && string.IsNullOrEmpty(NewHazardCategory))
                                {
                                    <br/>
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-info);">
                                        <RadzenIcon Icon="info" Style="font-size: 0.9rem;" />
                                        Select a category first to see hazard types
                                    </RadzenText>
                                }
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem" Class="rz-mb-1">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenCard Variant="Variant.Text" Class="sms-guidance-mini">
                                    <RadzenStack Gap="0.5rem" Class="rz-p-2">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                            <RadzenIcon Icon="category" Style="color: var(--rz-primary); font-size: 1rem;" />
                                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; color: var(--rz-primary);">Hazard Category Guidance</RadzenText>
                                        </RadzenStack>
                                        @if (!IsHazardCategoryDefault)
                                        {
                                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; font-size: 0.85rem;">
                                                @GetHazardCategoryDescription(NewHazardCategory)
                                            </RadzenText>
                                        }
                                        else
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: var(--rz-info);">
                                                Select a Hazard Category to view guidance.
                                            </RadzenText>
                                        }
                                    </RadzenStack>
                                </RadzenCard>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenCard Variant="Variant.Text" Class="sms-guidance-mini">
                                    <RadzenStack Gap="0.5rem" Class="rz-p-2">
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                            <RadzenIcon Icon="info" Style="color: var(--rz-primary); font-size: 1rem;" />
                                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; color: var(--rz-primary);">Hazard Type Guidance</RadzenText>
                                        </RadzenStack>
                                        @if (!IsHazardTypeDefault)
                                        {
                                            @if (RequiresRegulatoryReporting(NewHazardType))
                                            {
                                                <RadzenAlert AlertStyle="AlertStyle.Warning" Size="AlertSize.Small" Variant="Variant.Flat">
                                                    <strong>Regulatory Reporting Required</strong>
                                                </RadzenAlert>
                                            }

                                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; font-size: 0.85rem;">
                                                @GetHazardTypeGuidance(NewHazardType)
                                            </RadzenText>
                                        }
                                        else
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: var(--rz-info);">
                                                Select a Hazard Type to view guidance.
                                            </RadzenText>
                                        }
                                    </RadzenStack>
                                </RadzenCard>
                            </RadzenColumn>
                        </RadzenRow>
                        <!-- Hazard Description -->
                        <RadzenFormField Text="Hazard Description *" AllowFloatingLabel="false"    Variant="Variant.Outlined" class="@(IsHazardDescriptionInvalid ? "validation-error-field" : "")">
                            <RadzenTextArea @bind-Value="@NewHazardDescription" Rows="3"
                                            Placeholder="Describe the hazard clearly and specifically..."
                                            class="@(IsHazardDescriptionInvalid ? "default-validation-dropdown" : "")"
                                            Style="width: 100%;" />
                        </RadzenFormField>
                        @if (IsHazardDescriptionInvalid)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger);">
                                @if (string.IsNullOrWhiteSpace(NewHazardDescription))
                                {
                                    <span>Hazard description is required.</span>
                                }
                                else
                                {
                                    <span>Description must be at least 10 characters (currently @(NewHazardDescription.Trim().Length))</span>
                                }
                            </RadzenText>
                        }
                        <!-- Location Selection - EXACTLY like HazardReporting -->
                        <RadzenFieldset Text="Location Selection *" Style="margin-bottom: 1rem;" class="@(IsHazardLocationInvalid ? "default-validation-alert" : "")">
                            <div class="location-row rz-mt-1">
                                <div class="location-button">
                                    <RadzenButton ButtonStyle="@(IsHazardLocationInvalid ? ButtonStyle.Danger : ButtonStyle.Primary)"
                                                  Click="OpenMapSelector"
                                                  Text="Select on Map"
                                                  Icon="map"
                                                  Size="ButtonSize.Medium"
                                                  Style="width: 100%; height: 42px;" />
                                </div>

                                <div class="location-coordinate">
                                    <RadzenFormField Text="Latitude" Variant="Variant.Outlined" class="@(IsHazardLocationInvalid ? "validation-error-field" : "")">
                                        <RadzenTextBox Value="@SelectedLatitudeText"
                                                       ReadOnly="true"
                                                       Placeholder="Select location first"
                                                       class="@(IsHazardLocationInvalid ? "default-validation-dropdown" : "")"
                                                       Style="background-color: #f8f9fa; border-color: #dee2e6; width: 100%;" />
                                    </RadzenFormField>
                                </div>

                                <div class="location-coordinate">
                                    <RadzenFormField Text="Longitude" Variant="Variant.Outlined" class="@(IsHazardLocationInvalid ? "validation-error-field" : "")">
                                        <RadzenTextBox Value="@SelectedLongitudeText"
                                                       ReadOnly="true"
                                                       Placeholder="Select location first"
                                                       class="@(IsHazardLocationInvalid ? "default-validation-dropdown" : "")"
                                                       Style="background-color: #f8f9fa; border-color: #dee2e6; width: 100%;" />
                                    </RadzenFormField>
                                </div>

                                <div class="location-description">
                                    <RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width: 100%;" class="@(IsHazardLocationInvalid ? "validation-error-field" : "")">
                                        <RadzenTextBox @bind-Value="@LocationDescription"
                                                       Placeholder="Optional description (e.g., 'Terminal A, Gate 5, near security checkpoint')"
                                                       class="@(IsHazardLocationInvalid ? "default-validation-dropdown" : "")"
                                                       Style="width: 100%;" />
                                    </RadzenFormField>
                                </div>
                            </div>
                            @if (IsHazardLocationInvalid)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger); margin-top: 0.5rem; display: block;">
                                    Hazard location is required. Select a location on the map to continue.
                                </RadzenText>
                            }
                        </RadzenFieldset>

                        
                    </RadzenStack>
                </div>
                <div class="modal-footer">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" 
                                  Click="@CloseModal" 
                                  Disabled="@IsSubmitting" />
                    <RadzenButton Text="@ActionButtonText" 
                                  Icon="@ActionButtonIcon" 
                                  ButtonStyle="ButtonStyle.Success" 
                                  Click="@AddHazard" 
                                  Disabled="@(!IsFormValid || IsSubmitting)" />
                </div>
            </div>
        </div>
    </div>
}

<!-- Map Modal -  -->
@if (_showMapModal)
{
    <div class="modal-overlay" style="z-index: 2000;">
        <div class="sms-modal-dialog sms-modal-xl">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-map-marked-alt"></i> Select Hazard Location
                        </h5>
                        <div class="d-flex align-items-center gap-2">
                            <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                        Variant="Variant.Text"
                                        Icon="close"
                                        Size="ButtonSize.Small"
                                        Click="CloseMapSelector" />
                        </div>
                    </div>
                </div>
                <div class="sms-modal-body p-0">
                    <!-- Map Container - EXACTLY like HazardReporting -->
                    <div id="hazardLocationMap" style="height: 500px; width: 100%;"></div>
                    
                    <!-- Location Form and Controls -->
                    <div class="p-4">
                        <!-- Selected Coordinates Display -->
                        <div class="location-row rz-mt-1">
                            <div class="location-coordinate">
                                <RadzenFormField Text="Latitude" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                    <RadzenTextBox Value="@SelectedLatitudeText"
                                                   ReadOnly="true"
                                                   Placeholder=""
                                                   Style="background-color: #f8f9fa; border-color: #dee2e6; width: 100%;" />
                                </RadzenFormField>
                            </div>

                            <div class="location-coordinate">
                                <RadzenFormField Text="Longitude" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                    <RadzenTextBox Value="@SelectedLongitudeText"
                                                   ReadOnly="true"
                                                   Placeholder=""
                                                   Style="background-color: #f8f9fa; border-color: #dee2e6; width: 100%;" />
                                </RadzenFormField>
                            </div>

                            <div class="location-description">
                                <RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                    <RadzenTextBox @bind-Value="@LocationDescription"
                                                   Placeholder="Optional description (e.g., 'Terminal A, Gate 5, near security checkpoint')"
                                                   Style="width: 100%;" />
                                </RadzenFormField>
                            </div>
                        </div>
                        <br />
                        
                        
                        
                        
                        <div class="d-flex justify-content-end gap-2">
                            <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                        Text="Cancel" 
                                        Icon="close"
                                        Size="ButtonSize.Medium"
                                        Click="CloseMapSelector" />
                            @* <RadzenButton ButtonStyle="ButtonStyle.Warning" 
                                        Text="Clear Selection" 
                                        Icon="clear"
                                        Size="ButtonSize.Medium"
                                        Click="ClearMapSelection" /> *@
                            <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                        Text="Use Selected Location" 
                                        Icon="check"
                                        Size="ButtonSize.Medium"
                                        Click="UseSelectedLocation"
                                        Disabled="@(!HasValidCoordinates)" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
/* =============================================================================
   MODAL AND LAYOUT - EXACTLY like HazardReporting
   ============================================================================= */

/* Modal Overlay and Dialog */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
    padding: 1rem;
}

.modal-dialog {
    position: relative;
    margin: 0 auto;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
}

.modal-lg {
    max-width: 1000px;
    width: 100%;
}

.sms-modal-dialog {
    position: relative;
    margin: 0 auto;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
}

.sms-modal-xl {
    max-width: 1000px;
    width: 100%;
}

.modal-content, .sms-modal-content {
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
}

.modal-header, .sms-modal-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e9ecef;
    border-radius: 0.5rem 0.5rem 0 0;
}

.sms-header-primary {
    background-color: #212e61; /* SMS Blue Dark Bold */
    color: white;
}

.modal-title, .sms-modal-title {
    margin: 0;
    font-weight: 600;
}

.modal-body, .sms-modal-body {
    padding: 1.5rem;
}

.modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid #e9ecef;
    border-radius: 0 0 0.5rem 0.5rem;
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
}

/* Default validation dropdown styling */
.default-validation-dropdown {
    border: 2px solid #dc3545 !important;
    background-color: #fff5f5 !important;
    box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
}

/* Form field error state enhancement */
.validation-error-field .rz-dropdown {
    border-color: #dc3545 !important;
    box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
}

.validation-error-field .rz-textarea,
.validation-error-field .rz-textbox {
    border-color: #dc3545 !important;
    box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
}

.default-validation-alert {
    border-left: 5px solid #dc3545;
    background: #f8f9fa;
}

/* Mini Guidance Panel for Hazard Type/Category */
.sms-guidance-mini {
    background: linear-gradient(135deg, rgba(201, 227, 237, 0.08) 0%, rgba(205, 235, 241, 0.08) 100%);
    border-color: #c9e3ed !important;
    max-height: 250px;
    overflow-y: auto;
}

.sms-guidance-mini .text-primary {
    color: #212e61 !important;
}

/* Map styling */
#hazardLocationMap {
    cursor: crosshair !important;
}

.leaflet-container {
    cursor: crosshair !important;
}

.leaflet-grab {
    cursor: crosshair !important;
}

.leaflet-dragging .leaflet-grab {
    cursor: move !important;
}

/* Location selection styling - EXACTLY like HazardReporting */
.location-row {
    display: flex !important;
    align-items: flex-end !important;
    gap: 1rem !important;
    width: 100% !important;
}

.location-button {
    flex: 0 0 180px !important;
}

.location-coordinate {
    flex: 0 0 120px !important;
}

.location-description {
    flex: 1 !important;
    min-width: 0 !important;
}

/* Ensure proper input sizing with Radzen - EXACTLY like HazardReporting */
::deep .rz-textbox,
::deep .rz-dropdown,
::deep .rz-textarea,
::deep .rz-datepicker {
    width: 100% !important;
    min-width: 100% !important;
}

::deep .rz-formfield {
    width: 100% !important;
}

::deep .rz-dropdown-panel {
    min-width: 100% !important;
}

::deep .rz-dropdown .rz-dropdown-label {
    width: calc(100% - 32px) !important;
}

::deep .rz-dropdown {
    display: block !important;
    width: 100% !important;
}

::deep .rz-stack-horizontal .rz-button,
::deep .rz-stack-horizontal .rz-textbox {
    height: 42px !important;
    align-items: center !important;
}

::deep .rz-stack-horizontal .rz-button {
    flex-shrink: 0 !important;
    white-space: nowrap !important;
}
</style>

<!-- Leaflet.js CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" 
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<!-- Leaflet.js JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" 
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>