@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Pages.SMSRiskManagement
@using SMS3.Components.Pages.SMSRiskManagement.Components
@using SMS3.Components.Pages.SMSRiskManagement.Models
@using SMS3.Components.Shared
@using SMS_Application.Interfaces
@using SMS_Application.Commands
@using SMS_Application.Queries
@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using global::System.Text.Json

@inject IBaseMediator Mediator
@inject ILogger<TechnicalAssessmentStep5> Logger

<style>
    .collapsible-header {
        transition: background-color 0.2s ease;
    }
    
    .collapsible-header:hover {
        background-color: rgba(0, 0, 0, 0.03);
        border-radius: 4px;
    }
    
    .collapse-button {
        transition: transform 0.2s ease;
    }
    
    .collapse-button:hover {
        transform: scale(1.1);
    }
    
    .collapsible-content {
        animation: fadeIn 0.3s ease-in-out;
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<RadzenRow Gap="1rem">
    <!-- Main Content Column -->
    <RadzenColumn Size="8" SizeLG="8">
        <RadzenStack Gap="0.5rem">
            
            @if (Step5Hazards?.Any() == true)
            {
                @foreach (var hazard in Step5Hazards)
                {
                    var needsMitigation = DetermineIfNeedsMitigation(hazard);
                    var hasMitigations = HasMitigations(hazard);

                    <RadzenCard Variant="Variant.Outlined" Style="border-left: 4px solid #212e61; margin-bottom: 1rem;">
                        <RadzenStack Gap="0.5rem">
                            <!-- Hazard Header -->
                            <RadzenRow AlignItems="AlignItems.Center">

                                <RadzenColumn Size="2" SizeMD="2">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Start">
                                            <RadzenText TextStyle="TextStyle.Subtitle1">
                                                <strong>Hazard: </strong>  @hazard.Code
                                            </RadzenText>
                                        </RadzenStack>
                                
                                    </RadzenColumn>


                                <RadzenColumn Size="5" SizeMD="5">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                            <RadzenText TextStyle="TextStyle.Subtitle1"
                                                        Text="@GetHazardDisplayText(hazard)"
                                                        Style="margin: 0; color: var(--rz-primary);" />
                                        </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="5" SizeMD="5">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" >
                                        <!-- ✅ NEW: Collapse All / Expand All Button -->
                                        <RadzenButton Icon="@(AreAllSectionsCollapsed(hazard.Code) ? "expand_more" : "expand_less")"
                                                      ButtonStyle="ButtonStyle.Light" 
                                                      Size="ButtonSize.Small"
                                                      Click="@(() => ToggleAllSections(hazard.Code))" />

                                        
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                            <!-- Monitoring for Acceptable Risks -->
                            @if (!needsMitigation)
                            {
                                <RadzenCard Variant="Variant.Text" Style="background-color: #e8f5e8; border: 1px solid #a5d6a7;">
                                    <RadzenStack Gap="1rem">
                                        <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0; color: #2e7d32;">
                                            <RadzenIcon Icon="visibility" Style="margin-right: 0.5rem;" />
                                            Monitoring & Review Requirements
                                        </RadzenText>

                                        <RadzenRow Gap="1rem">
                                            <RadzenColumn Size="12" SizeMD="4">
                                                <RadzenFormField Text="Monitoring Frequency" Variant="Variant.Outlined">
                                                    <RadzenDropDown Value="@GetMonitoringFrequency(hazard)"
                                                                    Data="@MonitoringFrequencyOptions"
                                                                    Placeholder="Select frequency..."
                                                                    Style="width: 100%;"
                                                                    ValueChanged="@((string value) => SetMonitoringFrequency(hazard, value))" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="12" SizeMD="4">
                                                <RadzenFormField Text="Responsible Department" Variant="Variant.Outlined">
                                                    <RadzenDropDown Value="@GetMonitoringDepartment(hazard)"
                                                                    Data="@Departments"
                                                                    Placeholder="Select department..."
                                                                    Style="width: 100%;"
                                                                    ValueChanged="@((string value) => SetMonitoringDepartment(hazard, value))" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="12" SizeMD="4">
                                                <RadzenFormField Text="Review Trigger" Variant="Variant.Outlined">
                                                    <RadzenTextBox Value="@GetReviewTrigger(hazard)"
                                                                   Placeholder="What triggers a review?"
                                                                   Style="width: 100%;"
                                                                   ValueChanged="@((string value) => SetReviewTrigger(hazard, value))" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </RadzenStack>
                                </RadzenCard>
                            }
                            <!-- ✅ SECTION 1: Mitigation Strategies (Collapsible) -->
                            @if (needsMitigation)
                            {
                                <RadzenCard Variant="Variant.Text" Style="background-color: #fff3cd; border: 1px solid #ffeaa7;">
                                    <RadzenStack Gap="1rem">
                                        <!-- ✅ Collapsible Header -->
                                        <RadzenRow AlignItems="AlignItems.Center" 
                                                   class="collapsible-header"
                                                   style="cursor: pointer; padding: 0.5rem; margin: -0.5rem;" 
                                                   @onclick="@(() => ToggleSectionCollapse(hazard.Code, "mitigation"))">
                                            <RadzenColumn Size="10">
                                                <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0; color:#212e61;">
                                                    <RadzenIcon Icon="build" Style="margin-right: 0.5rem;" />
                                                    <strong>Mitigation Strategies</strong>
                                                </RadzenText>
                                            </RadzenColumn>
                                            
                                        </RadzenRow>
                                        
                                        <!-- ✅ Collapsible Content -->
                                        @if (!IsSectionCollapsed(hazard.Code, "mitigation"))
                                        {
                                            AvailableStakeholders = AvailableStakeholders.Where(predicate => predicate.IsPOPEmployee == true).ToList();
                                            <div class="collapsible-content">
                                                <HazardMitigationPanel Hazard="@hazard"
                                                                      Step4="@Step4"
                                                                      Step5="@Step5"
                                                                      NeedsMitigation="@needsMitigation"
                                                                      AvailableStakeholders="@AvailableStakeholders"
                                                                      AvailableAssessors="@AvailableAssessors"
                                                                      CurrentRiskAssessment="@CurrentRiskAssessment"
                                                                      OnMitigationUpdated="@OnMitigationUpdated"
                                                                      OnResidualHazardScored="@HandleResidualHazardScored" />
                                            </div>
                                        }
                                    </RadzenStack>
                                </RadzenCard>
                            }
                            <!-- ✅ SECTION 2: Hazard Scoring Panel (Collapsible) -->
                            @if (hasMitigations)
                            {
                                <RadzenCard Variant="Variant.Text" Style="background-color: #f3e5f5; border: 1px solid #ce93d8;">
                                    <RadzenStack Gap="1rem">
                                        <!-- ✅ Collapsible Header -->
                                        <RadzenRow AlignItems="AlignItems.Center" 
                                                   class="collapsible-header"
                                                   style="cursor: pointer; padding: 0.5rem; margin: -0.5rem;" 
                                                   @onclick="@(() => ToggleSectionCollapse(hazard.Code, "scoring"))">
                                            <RadzenColumn Size="10">
                                                
                                                    <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0; color: #212e61;">
                                                        <RadzenIcon Icon="people" Style="margin-right: 0.5rem;" />
                                                        <strong>Hazard Scoring Panel</strong>
                                                    </RadzenText>
                                                
                                            </RadzenColumn>
                                            
                                        </RadzenRow>
                                        
                                        <!-- ✅ Collapsible Content -->
                                        @if (!IsSectionCollapsed(hazard.Code, "scoring"))
                                        {
                                            <div class="collapsible-content">
                                                <HazardScoringPanel Hazard="@hazard"
                                                                   Step4="@Step4"
                                                                   Step5="@Step5"
                                                                   AvailableStakeholders="@AvailableStakeholders"
                                                                   AvailableAssessors="@AvailableAssessors"
                                                                   CurrentRiskAssessment="@CurrentRiskAssessment"
                                                                   CurrentStep="5"
                                                                   OnHazardScored="@HandleResidualHazardScored" />
                                            </div>
                                        }
                                    </RadzenStack>
                                </RadzenCard>
                            }

                            <!-- ✅ SECTION 3: Residual Risk Analysis (Collapsible) -->
                            @if (hasMitigations && CurrentRiskAssessment is not null)
                            {
                                <RadzenCard Variant="Variant.Text" Style="background-color: #e3f2fd; border: 1px solid #90caf9;">
                                    <RadzenStack Gap="1rem">
                                        <!-- ✅ Collapsible Header -->
                                        <RadzenRow AlignItems="AlignItems.Center" 
                                                   class="collapsible-header"
                                                   style="cursor: pointer; padding: 0.5rem; margin: -0.5rem;" 
                                                   @onclick="@(() => ToggleSectionCollapse(hazard.Code, "analysis"))">
                                            <RadzenColumn Size="10">
                                                <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0; color:#212e61;">
                                                    <RadzenIcon Icon="analytics" Style="margin-right: 0.5rem;" />
                                                    <strong>Residual Risk Analysis</strong>
                                                </RadzenText>
                                            </RadzenColumn>
                                          
                                        </RadzenRow>
                                        
                                        <!-- ✅ Collapsible Content -->
                                        @if (!IsSectionCollapsed(hazard.Code, "analysis"))
                                        {
                                            <div class="collapsible-content">
                                                <RadzenRow AlignItems="AlignItems.Center">
                                                    <RadzenColumn Size="3">
                                                        <RadzenStack Gap="0.25rem">
                                                            <RadzenText TextStyle="TextStyle.Subtitle1">
                                                                <strong>Hazard: </strong>  @hazard.Code
                                                            </RadzenText>
                                                        </RadzenStack>
                                                    </RadzenColumn>
                                                    <RadzenColumn Size="5">
                                                        <RadzenStack Gap="0.25rem">
                                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                                <RadzenText TextStyle="TextStyle.Subtitle1"
                                                                            Text="@GetHazardDisplayText(hazard)"
                                                                            Style="margin: 0; color: var(--rz-primary);" />
                                                            </RadzenStack>
                                                        </RadzenStack>
                                                    </RadzenColumn>
                                                </RadzenRow>
                                                <br />
                                                <!-- Risk Analysis Fields for Residual Risk -->
                                                <RadzenRow Gap="1rem">
                                                    <RadzenColumn Size="12" SizeMD="6">
                                                        <RadzenStack Gap="0.5rem">
                                                            <RadzenFormField Text="Residual Worst Credible Outcome *" Variant="Variant.Outlined">
                                                                <RadzenTextArea @bind-Value="@(Step5.GetHazardResidualAnalysis(hazard.Code).ResidualWorstCredibleOutcome)"
                                                                                @oninput="@((args) => OnAnalysisFieldChanged(hazard.Code, "WorstCredibleOutcome", args))"
                                                                                Rows="3"
                                                                                Placeholder="After mitigation implementation, what is the worst outcome that could still occur..."
                                                                                Style="width: 100%;" />
                                                            </RadzenFormField>
                                                            <RadzenText TextStyle="TextStyle.Caption" Text="Consider the effectiveness of planned mitigation strategies" />
                                                        </RadzenStack>
                                                    </RadzenColumn>
                                                    <RadzenColumn Size="12" SizeMD="6">
                                                        <RadzenStack Gap="0.5rem">
                                                            <RadzenFormField Text="Residual Root Cause Analysis *" Variant="Variant.Outlined">
                                                                <RadzenTextArea @bind-Value="@(Step5.GetHazardResidualAnalysis(hazard.Code).ResidualRootCause)"
                                                                                @oninput="@((args) => OnAnalysisFieldChanged(hazard.Code, "RootCause", args))"
                                                                                Rows="3"
                                                                                Placeholder="What root causes remain after mitigation implementation..."
                                                                                Style="width: 100%;" />
                                                            </RadzenFormField>
                                                            <RadzenText TextStyle="TextStyle.Caption" Text="Identify root causes that mitigation strategies do not fully address" />
                                                        </RadzenStack>
                                                    </RadzenColumn>
                                                </RadzenRow>
                                                <br />
                                                <RadzenRow>
                                                    <RadzenColumn Size="12" SizeMD="12">
                                                        <RadzenFormField Text="Additional Residual Analysis Comments" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                                            <RadzenTextArea @bind-Value="@(Step5.GetHazardResidualAnalysis(hazard.Code).ResidualAdditionalComments)"
                                                                            @oninput="@((args) => OnAnalysisFieldChanged(hazard.Code, "AdditionalComments", args))"
                                                                            Rows="2"
                                                                            Placeholder="Document assumptions about mitigation effectiveness, residual vulnerabilities, or monitoring requirements..."
                                                                            Style="width: 100%;min-width:100%" />
                                                        </RadzenFormField>
                                                    </RadzenColumn>
                                                </RadzenRow>
                                                <br />
                                                <RadzenRow>
                                                    <RadzenColumn Size="12" SizeMD="12">
                                                        
                                                    </RadzenColumn>
                                                </RadzenRow>
                                            </div>
                                        }
                                    </RadzenStack>
                                </RadzenCard>
                            }

                            
                        </RadzenStack>
                    </RadzenCard>
                }
            }
            else
            {
                <RadzenCard Style="text-align: center; padding: 2rem;">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenIcon Icon="warning" Style="font-size: 3rem; color: var(--rz-warning);" />
                        <RadzenText TextStyle="TextStyle.H5" Text="No hazards found" />
                        <RadzenText TextStyle="TextStyle.Body2" Text="Please complete the previous steps before proceeding with mitigation planning." />
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    </RadzenColumn>

    <!-- Guidance Panel -->
    <RadzenColumn Size="4" SizeLG="4">
        <TechnicalAssessmentGuidancePanel StepNumber="5" />
    </RadzenColumn>
</RadzenRow>

@code {
    [Parameter] public Step4Model Step4 { get; set; } = default!;
    [Parameter] public Step5Model Step5 { get; set; } = default!;
    [Parameter] public EventCallback<Step5Model> Step5Changed { get; set; }
    [Parameter] public List<Hazard> Step5Hazards { get; set; } = new();
    [Parameter] public List<SMSStakeholderUser> AvailableStakeholders { get; set; } = new();
    [Parameter] public List<SMSApplicationUser> AvailableAssessors { get; set; } = new();
    [Parameter] public RiskAssessment? CurrentRiskAssessment { get; set; } // For unified assessment access

    [Parameter] public int CurrentStep { get; set; } = 5; // Current step parameter

    // ? NEW: Store residual risk analysis data per hazard
    private Dictionary<string, string> ResidualWorstOutcomes { get; set; } = new();
    private Dictionary<string, string> ResidualRootCauses { get; set; } = new();
    private Dictionary<string, string> ResidualAdditionalComments { get; set; } = new();
    private Dictionary<string, string> MonitoringFrequencies { get; set; } = new();
    private Dictionary<string, string> MonitoringDepartments { get; set; } = new();
    private Dictionary<string, string> ReviewTriggers { get; set; } = new();

    // ✅ NEW: Collapsible state tracking per hazard and section
    private Dictionary<string, bool> MitigationSectionsCollapsed { get; set; } = new();
    private Dictionary<string, bool> ScoringPanelSectionsCollapsed { get; set; } = new();
    private Dictionary<string, bool> AnalysisSectionsCollapsed { get; set; } = new();
    // Note: Analysis is now back in TechnicalAssessmentStep5

    private List<string> ImplementationStrategies = new()
    {
        "Immediate Implementation",
        "Phased Implementation", 
        "Risk-Based Priority",
        "Resource-Based Priority"
    };

    private List<string> MonitoringFrequencyOptions = new()
    {
        "Continuous", "Daily", "Weekly", "Monthly", "Quarterly", "Annually"
    };

    // ✅ UPDATED: Replace hardcoded department list with SMSDepartment enum
    private List<string> Departments => SMSDepartment.GetAllDepartments()
        .Select(d => d.Name)
        .OrderBy(name => name)
        .ToList();
    private string GetHazardCategoryDisplay(string? categoryValue)
    {
        if (string.IsNullOrEmpty(categoryValue)) return "";

        var category = HazardCategory.FromValue(categoryValue);
        return category?.Name ?? categoryValue.Replace("_", " ");
    }

    private string GetHazardTypeDisplay(string? typeValue)
    {
        if (string.IsNullOrEmpty(typeValue)) return "";

        var hazardType = HazardType.FromValue(typeValue);
        return hazardType?.Name ?? typeValue.Replace("_", " ");
    }

    private string GetHazardDisplayText(Hazard hazard)
    {
        var category = GetHazardCategoryDisplay(hazard.HazardCategory);
        var type = GetHazardTypeDisplay(hazard.HazardType);
        return $"{category.ToUpper()} - {type.ToUpper()}";
    }
    protected override async Task OnInitializedAsync()
    {
        // ✅ Load existing mitigations for all hazards
        await LoadExistingMitigationsForAllHazards();

        // Note: Residual risk analysis data loading is now handled by Step5Model.LoadExistingResidualRiskAnalysesAsync
        // which is called from the parent component's LoadStepDataFromAssessment method
    }



    /// <summary>
    /// ✅ NEW: Load existing mitigations for all hazards to populate Step5 model data
    /// </summary>
    private async Task LoadExistingMitigationsForAllHazards()
    {
        if (Step5Hazards?.Any() != true) return;

        try
        {
            Logger.LogInformation("Loading existing mitigations for {Count} hazards in Step5", Step5Hazards.Count);

            // Initialize dictionaries if needed
            if (Step5.HazardMitigations == null)
                Step5.HazardMitigations = new Dictionary<string, List<Mitigation>>();
            if (Step5.SavedMitigationStrategies == null)
                Step5.SavedMitigationStrategies = new Dictionary<string, List<string>>();

            // Load mitigations for each hazard
            foreach (var hazard in Step5Hazards)
            {
                try
                {
                    var query = new GetMitigationsByHazardCodeQuery(hazard.Code);
                    var result = await Mediator.SendAsync(query, CancellationToken.None);

                    if (result.IsSuccess && result.Value?.Any() == true)
                    {
                        var mitigations = result.Value.ToList();

                        // ✅ FIXED: Now using correct Mitigation entities
                        Step5.HazardMitigations[hazard.Code] = mitigations;
                        Step5.SavedMitigationStrategies[hazard.Code] = mitigations.Select(m => m.Name ?? "Unnamed Mitigation").ToList();

                        Logger.LogInformation("Loaded {Count} existing mitigations for hazard {HazardCode}", 
                            mitigations.Count, hazard.Code);
                    }
                    else
                    {
                        Logger.LogInformation("No existing mitigations found for hazard {HazardCode}", hazard.Code);
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error loading mitigations for hazard {HazardCode}", hazard.Code);
                }
            }

            Logger.LogInformation("Completed loading existing mitigations for all hazards");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading existing mitigations for all hazards");
        }
    }


    private bool DetermineIfNeedsMitigation(Hazard hazard)
    {
        // Check if this hazard has a high risk score that needs mitigation
        // if (Step4.HazardAverageScores.ContainsKey(hazard.Code))
        // {
        //     var averageScore = Step4.HazardAverageScores[hazard.Code];
        //     // Assume scores > 10 need mitigation (adjust based on your 5x5 matrix)
        //     return averageScore > 10;
        // }
        // SET TO AWLAYS REQUIRE
        // Default to needing mitigation if no score available
        return true;
    }

    private bool HasMitigations(Hazard hazard)
    {
        // ✅ IMPROVED: Use multiple data sources and prioritize Step5 model data first
        Logger.LogInformation("🔍 HasMitigations DEBUG for hazard {HazardCode}:", hazard.Code);

        // First check Step5 HazardMitigations dictionary (most reliable after sync)
        var hazardMitigationsHas = Step5.HazardMitigations?.ContainsKey(hazard.Code) == true && 
                                  Step5.HazardMitigations[hazard.Code]?.Any() == true;
        Logger.LogInformation("  - Step5.HazardMitigations[{HazardCode}]: {HasMitigations} (Count: {Count})", 
            hazard.Code, hazardMitigationsHas, 
            Step5.HazardMitigations?.GetValueOrDefault(hazard.Code)?.Count ?? 0);

        // Check Step5 saved mitigation strategies
        var savedStrategiesHas = Step5.SavedMitigationStrategies?.ContainsKey(hazard.Code) == true && 
                                Step5.SavedMitigationStrategies[hazard.Code]?.Any() == true;
        Logger.LogInformation("  - Step5.SavedMitigationStrategies[{HazardCode}]: {HasMitigations} (Count: {Count})", 
            hazard.Code, savedStrategiesHas,
            Step5.SavedMitigationStrategies?.GetValueOrDefault(hazard.Code)?.Count ?? 0);

        // Use the most reliable source (HazardMitigations first, then SavedMitigationStrategies)
        var hasMitigationsResult = hazardMitigationsHas || savedStrategiesHas;

        Logger.LogInformation("  - FINAL RESULT: {HasMitigations}", hasMitigationsResult);

        return hasMitigationsResult;
    }

    private string GetInitialRiskLevel(Hazard hazard)
    {
        if (Step4.HazardRiskLevels.ContainsKey(hazard.Code))
        {
            return Step4.HazardRiskLevels[hazard.Code];
        }
        return "Unknown";
    }

