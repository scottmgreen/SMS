    #region ✅ Residual Risk Analysis Methods - REFACTORED to use @bind-Value pattern

    /// <summary>
    /// ✅ Handle residual risk analysis field changes using proper Domain Entities - Updated to match Step3 pattern
    /// </summary>
    private async Task OnAnalysisFieldChanged(string hazardCode, string fieldName, ChangeEventArgs args)
    {
        try
        {
            var newValue = args.Value?.ToString() ?? string.Empty;
            newValue = newValue.Trim();
            if (Step5.HazardResidualRiskAnalyses.TryGetValue(hazardCode, out var analysis))
            {


                // ✅ Update the domain entity properties
                switch (fieldName)
                {
                    case "WorstCredibleOutcome":
                        analysis.ResidualWorstCredibleOutcome = newValue.Trim();
                        break;
                    case "RootCause":
                        analysis.ResidualRootCause = newValue.Trim();
                        break;
                    case "AdditionalComments":
                        analysis.ResidualAdditionalComments = newValue.Trim();
                        break;
                }

                // ✅ Ensure the updated entity is maintained in the dictionary
                Step5.HazardResidualRiskAnalyses[hazardCode] = analysis;
            }

            // Trigger UI update and notify parent component
            await InvokeAsync(StateHasChanged);
            await Step5Changed.InvokeAsync(Step5);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Error updating residual analysis field {FieldName} for hazard {HazardCode}", fieldName, hazardCode);
        }
    }




    /// <summary>
    /// ✅ Save residual risk analysis using proper RiskAnalysis domain entity and CQRS
    /// </summary>
    private async Task SaveResidualAnalysisToDatabase(RiskAnalysis analysis)
    {
        if (CurrentRiskAssessment is null || analysis is null) return;

        try
        {
            Logger.LogInformation("💾 Saving residual risk analysis for hazard {HazardCode} to ResidualRiskAssessment {AssessmentCode}", analysis.HazardCode, CurrentRiskAssessment.Code);

            // ✅ Use proper CQRS commands - check if entity exists first
            if (string.IsNullOrEmpty(analysis.Code) || analysis.Code == "RA-0000")
            {
                Logger.LogInformation("🆕 Creating new residual RiskAnalysis for hazard {HazardCode}", analysis.HazardCode);

                // Create new RiskAnalysis
                var createCommand = new CreateRiskAnalysisCommand(analysis);
                var createResult = await Mediator.SendAsync(createCommand, CancellationToken.None);

                if (createResult.IsSuccess && createResult.Value is not null)
                {
                    // Update the Step5 model with the saved entity (which has a proper ID/Code)
                    Step5.HazardResidualRiskAnalyses[analysis.HazardCode ?? ""] = createResult.Value;
                    Logger.LogInformation("✅ Created new residual RiskAnalysis for hazard {HazardCode} with code {Code}", 
                        analysis.HazardCode, createResult.Value.Code);
                }
                else
                {
                    Logger.LogError("❌ Failed to create residual RiskAnalysis for hazard {HazardCode}: {Error}", 
                        analysis.HazardCode, createResult.Error?.Message ?? "Unknown error");
                }
            }
            else
            {
                Logger.LogInformation("🔄 Updating existing residual RiskAnalysis {Code} for hazard {HazardCode}", 
                    analysis.Code, analysis.HazardCode);

                // Update existing RiskAnalysis
                var updateCommand = new UpdateRiskAnalysisCommand(analysis);
                var updateResult = await Mediator.SendAsync(updateCommand, CancellationToken.None);

                if (updateResult.IsSuccess && updateResult.Value is not null)
                {
                    // Update the Step5 model with the updated entity
                    Step5.HazardResidualRiskAnalyses[analysis.HazardCode ?? ""] = updateResult.Value;
                    Logger.LogInformation("✅ Updated residual RiskAnalysis for hazard {HazardCode} with code {Code}", analysis.HazardCode, updateResult.Value.Code);
                }
                else
                {
                    Logger.LogError("❌ Failed to update residual RiskAnalysis for hazard {HazardCode}: {Error}", analysis.HazardCode, updateResult.Error?.Message ?? "Unknown error");
                }
            }

            // ✅ Notify parent about Step5 changes
            await Step5Changed.InvokeAsync(Step5);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Error saving residual risk analysis for hazard {HazardCode}", analysis.HazardCode ?? "Unknown");
        }
    }

    #endregion

    #region Monitoring Methods

    private string GetMonitoringFrequency(Hazard hazard) => MonitoringFrequencies.GetValueOrDefault(hazard.Code, string.Empty);
    private string GetMonitoringDepartment(Hazard hazard) => MonitoringDepartments.GetValueOrDefault(hazard.Code, string.Empty);
    private string GetReviewTrigger(Hazard hazard) => ReviewTriggers.GetValueOrDefault(hazard.Code, string.Empty);

    private async Task SetMonitoringFrequency(Hazard hazard, string value)
    {
        MonitoringFrequencies[hazard.Code] = value ?? string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetMonitoringDepartment(Hazard hazard, string value)
    {
        MonitoringDepartments[hazard.Code] = value ?? string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetReviewTrigger(Hazard hazard, string value)
    {
        ReviewTriggers[hazard.Code] = value ?? string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    #endregion

    private int GetHazardsNeedingMitigation()
    {
        return Step5Hazards?.Count(h => DetermineIfNeedsMitigation(h)) ?? 0;
    }

    private async Task OnMitigationUpdated(string hazardId)
    {
        try
        {
            // ✅ ENHANCED: Load mitigations from database and sync with Step5 model
            Logger.LogInformation("🔄 OnMitigationUpdated called for hazard {HazardCode}", hazardId);

            // Load mitigations from database
            var query = new GetMitigationsByHazardCodeQuery(hazardId);
            var result = await Mediator.SendAsync(query, CancellationToken.None);

            if (result.IsSuccess && result.Value?.Any() == true)
            {
                // ✅ SYNC: Update Step5.SavedMitigationStrategies as a simple indicator
                if (Step5.SavedMitigationStrategies == null)
                {
                    Step5.SavedMitigationStrategies = new Dictionary<string, List<string>>();
                }

                var mitigations = result.Value.ToList();

                // Store mitigation names as simple strings for Step5 model compatibility
                var mitigationNames = mitigations.Select(m => m.Name ?? "Unnamed Mitigation").ToList();
                Step5.SavedMitigationStrategies[hazardId] = mitigationNames;

                Logger.LogInformation("✅ Synced {Count} mitigations to Step5.SavedMitigationStrategies[{HazardCode}]: {Names}", 
                    mitigationNames.Count, hazardId, string.Join(", ", mitigationNames));

                // ✅ CRITICAL: Update Step5.HazardMitigations with correct Mitigation entities
                if (Step5.HazardMitigations == null)
                {
                    Step5.HazardMitigations = new Dictionary<string, List<Mitigation>>();
                }
                Step5.HazardMitigations[hazardId] = mitigations;
                
                // ✅ FIXED: DO NOT trigger hazard scoring recalculation when adding mitigations
                // The risk level should only change when residual scoring panels are submitted, not when mitigations are added
                Logger.LogInformation("✅ Mitigation added successfully - Risk level preserved (no scoring recalculation triggered)");
            }
            else
            {
                // Clear mitigations if none found
                if (Step5.SavedMitigationStrategies?.ContainsKey(hazardId) == true)
                {
                    Step5.SavedMitigationStrategies.Remove(hazardId);
                }
                if (Step5.HazardMitigations?.ContainsKey(hazardId) == true)
                {
                    Step5.HazardMitigations.Remove(hazardId);
                }
                
                Logger.LogInformation("❌ Cleared Step5 mitigation data for {HazardCode} - no mitigations found", hazardId);
            }
            
            // Notify parent component of changes
            await Step5Changed.InvokeAsync(Step5);
            await InvokeAsync(StateHasChanged);
            
            Logger.LogInformation("✅ Completed mitigation sync and state refresh for hazard {HazardCode}", hazardId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in OnMitigationUpdated for hazard {HazardCode}", hazardId);
        }
    }

    /// <summary>
    /// ✅ REFACTORED: Simplified to use HazardScoringPanel's existing logic and read from updated hazard entities
    /// </summary>
    private async Task HandleResidualHazardScored()
    {
        try
        {
            Logger.LogInformation("Residual risk assessment completed for current hazard scoring session");
            
            // ✅ Update Step5 model from all hazard entities (which HazardScoringPanel already updated)
            await UpdateStep5FromAllHazardEntities();
            
            // Trigger Step5 model update
            await Step5Changed.InvokeAsync(Step5);
            
            // Refresh UI
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling residual hazard scored");
        }
    }

    /// <summary>
    /// ✅ NEW: Update Step5 model from hazard entities that were already updated by HazardScoringPanel
    /// This eliminates the need to duplicate complex residual scoring calculation logic
    /// </summary>
    private async Task UpdateStep5FromAllHazardEntities()
    {
        if (Step5Hazards?.Any() != true) return;

        try
        {
            Logger.LogInformation("Updating Step5 model from hazard entities for {Count} hazards", Step5Hazards.Count);

            foreach (var hazard in Step5Hazards)
            {
                try
                {
                    // Reload hazard to get latest calculated values from HazardScoringPanel
                    var hazardQuery = new GetHazardByCodeQuery(new HazardID(hazard.Code));
                    var hazardResult = await Mediator.SendAsync(hazardQuery, CancellationToken.None);

                    if (hazardResult.IsSuccess && hazardResult.Value is not null)
                    {
                        var updatedHazard = hazardResult.Value;

                        // Update the local hazard reference with latest data
                        var hazardIndex = Step5Hazards.FindIndex(h => h.Code == hazard.Code);
                        if (hazardIndex >= 0)
                        {
                            Step5Hazards[hazardIndex] = updatedHazard;
                        }

                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error updating hazard {HazardCode} from entity", hazard.Code);
                }
            }

            Logger.LogInformation("✅ Completed Step5 model update from hazard entities");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating Step5 from hazard entities");
        }
    }

    #region Collapsible Section Helper Methods

    private bool IsSectionCollapsed(string hazardCode, string sectionType)
    {
        return sectionType switch
        {
            "mitigation" => MitigationSectionsCollapsed.GetValueOrDefault(hazardCode, false),
            "scoring" => ScoringPanelSectionsCollapsed.GetValueOrDefault(hazardCode, false),
            "analysis" => AnalysisSectionsCollapsed.GetValueOrDefault(hazardCode, false),
            _ => false
        };
    }

    private async Task ToggleSectionCollapse(string hazardCode, string sectionType)
    {
        try
        {
            switch (sectionType)
            {
                case "mitigation":
                    MitigationSectionsCollapsed[hazardCode] = !MitigationSectionsCollapsed.GetValueOrDefault(hazardCode, false);
                    break;
                case "scoring":
                    ScoringPanelSectionsCollapsed[hazardCode] = !ScoringPanelSectionsCollapsed.GetValueOrDefault(hazardCode, false);
                    break;
                case "analysis":
                    AnalysisSectionsCollapsed[hazardCode] = !AnalysisSectionsCollapsed.GetValueOrDefault(hazardCode, false);
                    break;
            }

            await InvokeAsync(StateHasChanged);
            Logger.LogInformation("Toggled {SectionType} section for hazard {HazardCode} to {IsCollapsed}", 
                sectionType, hazardCode, IsSectionCollapsed(hazardCode, sectionType) ? "collapsed" : "expanded");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling section collapse for {HazardCode} {SectionType}", hazardCode, sectionType);
        }
    }

    private bool AreAllSectionsCollapsed(string hazardCode)
    {
        var mitigationCollapsed = MitigationSectionsCollapsed.GetValueOrDefault(hazardCode, false);
        var scoringCollapsed = ScoringPanelSectionsCollapsed.GetValueOrDefault(hazardCode, false);
        var analysisCollapsed = AnalysisSectionsCollapsed.GetValueOrDefault(hazardCode, false);
        
        return mitigationCollapsed && scoringCollapsed && analysisCollapsed;
    }

    private async Task ToggleAllSections(string hazardCode)
    {
        try
        {
            bool shouldCollapseAll = !AreAllSectionsCollapsed(hazardCode);

            MitigationSectionsCollapsed[hazardCode] = shouldCollapseAll;
            ScoringPanelSectionsCollapsed[hazardCode] = shouldCollapseAll;
            AnalysisSectionsCollapsed[hazardCode] = shouldCollapseAll;

            await InvokeAsync(StateHasChanged);
            
            Logger.LogInformation("Toggled all sections for hazard {HazardCode} to {State}", 
                hazardCode, shouldCollapseAll ? "collapsed" : "expanded");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling all sections for hazard {HazardCode}", hazardCode);
        }
    }

    #endregion
}