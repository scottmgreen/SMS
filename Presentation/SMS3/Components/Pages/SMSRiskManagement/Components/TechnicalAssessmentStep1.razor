@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using SMS3.Components.Pages.SMSRiskManagement
@using SMS3.Components.Shared
@using global::System.Text.Json
@using Radzen
@using Radzen.Blazor

<RadzenStack Gap="1.5rem">
    <RadzenRow Gap="1rem">
        <!-- Main Content Column - 8 columns on large screens -->
        <RadzenColumn Size="12" SizeLG="8">
            <RadzenStack Gap="1.5rem">
                <!-- System Overview Section -->
                <RadzenFieldset Text="System Overview" Style="color: #212e61; margin: 0; font-size:x-large ; font-weight: 600; border-bottom: 2px solid #212e61; padding-bottom: 0.5rem;">
                    <ChildContent>
                        @* <!-- Custom styled header -->
                        <div style="margin-bottom: 1.5rem;">
                            <RadzenText TextStyle="TextStyle.H6" Style="color: #212e61; margin: 0; font-size: large; font-weight: 600; border-bottom: 2px solid #212e61; padding-bottom: 0.5rem;" 
                                        Text="System Overview" />
                        </div> *@
                        
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.5rem">
                                    <RadzenFormField Text="Lead Assessor *" Variant="Variant.Outlined">
                                        @if (AvailableAssessors != null && AvailableAssessors.Any())
                                        {
                                            <RadzenDropDown @bind-Value="@Step1.LeadAssessor" 
                                                            Data="@AvailableAssessors"
                                                            TextProperty="DisplayName" 
                                                            ValueProperty="Code"
                                                            Placeholder="Select the lead assessor..." 
                                                            Style="width: 100%;"
                                                            AllowClear="false"
                                                            AllowFiltering="true"
                                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                            title="Person responsible for conducting this risk assessment"
                                                            Change="@OnLeadAssessorChanged" />
                                        }
                                        else
                                        {
                                            <RadzenTextBox Value="No Safety Team members available" 
                                                          ReadOnly="true" 
                                                          Style="width: 100%; background-color: #f5f5f5;" />
                                        }
                                    </RadzenFormField>
                                    <RadzenText TextStyle="TextStyle.Caption" Text="Person responsible for conducting this risk assessment" />
                                    <RadzenText TextStyle="TextStyle.Caption" Text="@GetLeadAssessorValidation()" />
                                </RadzenStack>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.5rem">
                                    <RadzenFormField Text="System Description *" Variant="Variant.Outlined">
                                        <RadzenTextArea @bind-Value="@Step1.SystemDescription" Rows="4" Placeholder="Provide a comprehensive description of the system being assessed..." Style="width: 100%;"
                                                    title="Describe what the system does, its primary functions, and operational context" />
                                    </RadzenFormField>
                                    <RadzenText TextStyle="TextStyle.Caption" Text="Describe what the system does, its primary functions, and operational context" />
                                    <RadzenText TextStyle="TextStyle.Caption" Text="@GetFieldValidation(Step1.SystemDescription, 10)" />
                                </RadzenStack>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenStack Gap="0.5rem">
                                    <RadzenFormField Text="System Boundaries *" Variant="Variant.Outlined">
                                        <RadzenTextArea @bind-Value="@Step1.SystemBoundaries" Rows="4" Placeholder="Define what is included and excluded from this assessment..." Style="width: 100%;"
                                                    title="Clearly define the scope - what's in and what's out of this assessment" />
                                    </RadzenFormField>
                                    <RadzenText TextStyle="TextStyle.Caption" Text="Clearly define the scope - what's in and what's out of this assessment" />
                                    <RadzenText TextStyle="TextStyle.Caption" Text="@GetFieldValidation(Step1.SystemBoundaries, 10)" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                        
                        <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                            <RadzenColumn Size="12">
                                <RadzenStack Gap="0.5rem">
                                    <RadzenFormField Text="System Purpose & Objectives" Variant="Variant.Outlined">
                                        <RadzenTextArea @bind-Value="@Step1.SystemPurpose" Rows="3" Placeholder="What is the system designed to achieve? What are its key objectives?" Style="width: 100%;"
                                                    title="Define the intended purpose and key performance objectives" />
                                    </RadzenFormField>
                                    <RadzenText TextStyle="TextStyle.Caption" Text="Define the intended purpose and key performance objectives" />
                                    <RadzenText TextStyle="TextStyle.Caption" Text="@GetFieldValidation(Step1.SystemPurpose, 5)" />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </ChildContent>
                </RadzenFieldset>

                <!-- 5M Framework Analysis -->
                <RadzenFieldset Text="5M Framework Analysis" Style="color: #212e61; margin: 0; font-size: large; font-weight: 600; border-bottom: 2px solid #212e61; padding-bottom: 0.5rem;">
                    <ChildContent>
                        @* <!-- Custom styled header -->
                        <div style="margin-bottom: 1.5rem;">
                            <RadzenText TextStyle="TextStyle.H6" Style="color: #212e61; margin: 0; font-size: large; font-weight: 600; border-bottom: 2px solid #212e61; padding-bottom: 0.5rem;" 
                                        Text="5M Framework Analysis" />
                        </div> *@
                        
                        <RadzenStack Gap="0.5rem">
                            <!-- Man (People) -->
                            <RadzenCard Style="border-left: 4px solid var(--rz-primary);">
                                <RadzenStack Gap=".5rem" Style="padding: .5rem;">
                                    <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-primary); margin: 0;">
                                        <RadzenIcon Icon="people" Style="margin-right: 0.5rem;" />
                                        Man (People)
                                    </RadzenText>
                                    <RadzenStack Gap="0.5rem">
                                        <RadzenFormField Text="Personnel & Human Factors *" Variant="Variant.Outlined">
                                            <RadzenTextArea @bind-Value="@Step1.FiveMPersonnel" Rows="4" Placeholder="Who are the people involved? What human factors apply?" Style="width: 100%;" />
                                        </RadzenFormField>
                                        <RadzenText TextStyle="TextStyle.Caption" Text="@GetFieldValidation(Step1.FiveMPersonnel, 10)" />
                                    </RadzenStack>
                                </RadzenStack>
                            </RadzenCard>

                            <!-- Machine (Equipment) -->
                            <RadzenCard Style="border-left: 4px solid var(--rz-success);">
                                <RadzenStack Gap="0.5rem" Style="padding: 0.5rem;">
                                    <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-success); margin: 0;">
                                        <RadzenIcon Icon="settings" Style="margin-right: 0.5rem;" />
                                        Machine (Equipment)
                                    </RadzenText>
                                    <RadzenStack Gap="0.5rem">
                                        <RadzenFormField Text="Equipment & Technology *" Variant="Variant.Outlined">
                                            <RadzenTextArea @bind-Value="@Step1.FiveMEquipment" Rows="4" Placeholder="What equipment and technology is involved?" Style="width: 100%;" />
                                        </RadzenFormField>
                                        <RadzenText TextStyle="TextStyle.Caption" Text="@GetFieldValidation(Step1.FiveMEquipment, 10)" />
                                    </RadzenStack>
                                </RadzenStack>
                            </RadzenCard>

                            <!-- Method (Procedures) -->
                            <RadzenCard Style="border-left: 4px solid var(--rz-info);">
                                <RadzenStack Gap="0.5rem" Style="padding: 0.5rem;">
                                    <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-info); margin: 0;">
                                        <RadzenIcon Icon="list_alt" Style="margin-right: 0.5rem;" />
                                        Method (Procedures)
                                    </RadzenText>
                                    <RadzenStack Gap="0.5rem">
                                        <RadzenFormField Text="Procedures & Processes *" Variant="Variant.Outlined">
                                            <RadzenTextArea @bind-Value="@Step1.FiveMProcedures" Rows="4" Placeholder="What procedures and processes are followed?" Style="width: 100%;" />
                                        </RadzenFormField>
                                        <RadzenText TextStyle="TextStyle.Caption" Text="@GetFieldValidation(Step1.FiveMProcedures, 10)" />
                                    </RadzenStack>
                                </RadzenStack>
                            </RadzenCard>

                            <!-- Material (Resources) -->
                            <RadzenCard Style="border-left: 4px solid var(--rz-warning);">
                                <RadzenStack Gap="0.5rem" Style="padding: 0.5rem;">
                                    <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-warning); margin: 0;">
                                        <RadzenIcon Icon="inventory" Style="margin-right: 0.5rem;" />
                                        Material (Resources)
                                    </RadzenText>
                                    <RadzenStack Gap="0.5rem">
                                        <RadzenFormField Text="Materials & Resources *" Variant="Variant.Outlined">
                                            <RadzenTextArea @bind-Value="@Step1.FiveMResources" Rows="4" Placeholder="What materials and resources are required?" Style="width: 100%;" />
                                        </RadzenFormField>
                                        <RadzenText TextStyle="TextStyle.Caption" Text="@GetFieldValidation(Step1.FiveMResources, 10)" />
                                    </RadzenStack>
                                </RadzenStack>
                            </RadzenCard>

                            <!-- Milieu (Environment) -->
                            <RadzenCard Style="border-left: 4px solid var(--rz-danger);">
                                <RadzenStack Gap="0.5rem" Style="padding: 0.5rem;">
                                    <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-danger); margin: 0;">
                                        <RadzenIcon Icon="public" Style="margin-right: 0.5rem;" />
                                        Milieu (Environment)
                                    </RadzenText>
                                    <RadzenRow Gap="0.5rem">
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <RadzenStack Gap="0.5rem">
                                                <RadzenFormField Text="Physical Environment *" Variant="Variant.Outlined">
                                                    <RadzenTextArea @bind-Value="@Step1.FiveMPhysicalEnvironment" Rows="3" Placeholder="Physical environmental factors..." Style="width: 100%;" />
                                                </RadzenFormField>
                                                <RadzenText TextStyle="TextStyle.Caption" Text="@GetFieldValidation(Step1.FiveMPhysicalEnvironment, 10)" />
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <RadzenStack Gap="0.5rem">
                                                <RadzenFormField Text="Operational Environment *" Variant="Variant.Outlined">
                                                    <RadzenTextArea @bind-Value="@Step1.FiveMOperationalEnvironment" Rows="3" Placeholder="Operational environmental factors..." Style="width: 100%;" />
                                                </RadzenFormField>
                                                <RadzenText TextStyle="TextStyle.Caption" Text="@GetFieldValidation(Step1.FiveMOperationalEnvironment, 10)" />
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenCard>
                        </RadzenStack>
                    </ChildContent>
                </RadzenFieldset>

                <!-- Stakeholder Selection -->
                <RadzenFieldset Text="Stakeholder Selection">
                    <ChildContent>
                        <!-- Custom styled header -->
                        <div style="margin-bottom: 1.5rem;">
                            <RadzenText TextStyle="TextStyle.H6" Style="color: #212e61; margin: 0; font-size: large; font-weight: 600; border-bottom: 2px solid #212e61; padding-bottom: 0.5rem;" 
                                        Text="Stakeholder Selection" />
                        </div>
                        
                        <RadzenRow Gap="1rem">
                            <!-- Left Column: Stakeholder Groups -->
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="1rem">
                                    <!-- Current Selected Stakeholder Groups -->
                                    <RadzenCard>
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenText TextStyle="TextStyle.H6" Text="Selected Stakeholder Groups" Style="margin-bottom: 0.5rem; color: var(--rz-primary);" />
                                            <div style="min-height: 60px; padding: 0.5rem; border: 1px dashed var(--rz-border-color); border-radius: 4px;">
                                                @if (Step1?.SelectedStakeholderGroupIds?.Any() == true)
                                                {
                                                    @foreach (var groupId in Step1.SelectedStakeholderGroupIds)
                                                    {
                                                        var group = StakeholderGroups?.FirstOrDefault(g => g.Code == groupId);
                                                        if (group != null)
                                                        {
                                                            <RadzenBadge Text="@group.Name" BadgeStyle="BadgeStyle.Primary" Style="margin: 0.2rem;" />
                                                        }
                                                    }
                                                }
                                                else
                                                {
                                                    <RadzenText TextStyle="TextStyle.Body2" Text="No stakeholder groups selected" Style="color: var(--rz-text-secondary-color); font-style: italic;" />
                                                }
                                            </div>
                                        </RadzenStack>
                                    </RadzenCard>

                                    <!-- Available Stakeholder Groups -->
                                    <RadzenCard>
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenText TextStyle="TextStyle.H6" Text="Available Stakeholder Groups" Style="margin-bottom: 0.5rem; color: var(--rz-secondary);" />
                                            @if (StakeholderGroups != null && StakeholderGroups.Any())
                                            {
                                                <RadzenDataGrid Data="@StakeholderGroups" TItem="SMSStakeholderGroup" AllowFiltering="false" AllowPaging="false" Style="height: 300px;">
                                                    <Columns>
                                                        <RadzenDataGridColumn TItem="SMSStakeholderGroup" Property="Name" Title="Group Name" Width="50%" />
                                                        <RadzenDataGridColumn TItem="SMSStakeholderGroup" Property="Description" Title="Description" Width="30%" />
                                                        <RadzenDataGridColumn TItem="SMSStakeholderGroup" Title="Action" Width="20%">
                                                            <Template Context="group">
                                                                @if (Step1.SelectedStakeholderGroupIds != null && !Step1.SelectedStakeholderGroupIds.Contains(group.Code))
                                                                {
                                                                    <RadzenButton Text="Add" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" 
                                                                                  Click="@(() => AddStakeholderGroup(group.Code))" />
                                                                }
                                                                else
                                                                {
                                                                    <RadzenButton Text="Remove" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" 
                                                                                  Click="@(() => RemoveStakeholderGroup(group.Code))" />
                                                                }
                                                            </Template>
                                                        </RadzenDataGridColumn>
                                                    </Columns>
                                                </RadzenDataGrid>
                                            }
                                            else
                                            {
                                                <RadzenText TextStyle="TextStyle.Body2" Text="No stakeholder groups available" Style="color: var(--rz-text-secondary-color); font-style: italic;" />
                                            }
                                        </RadzenStack>
                                    </RadzenCard>
                                </RadzenStack>
                            </RadzenColumn>
                            
                            <!-- Right Column: Individual Stakeholders -->
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Gap="1rem">
                                    <!-- Current Selected Individual Stakeholders -->
                                    <RadzenCard>
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenText TextStyle="TextStyle.H6" Text="Selected Individual Stakeholders" Style="margin-bottom: 0.5rem; color: var(--rz-primary);" />
                                            <div style="min-height: 60px; padding: 0.5rem; border: 1px dashed var(--rz-border-color); border-radius: 4px;">
                                                @if (Step1?.SelectedIndividualStakeholderIds?.Any() == true)
                                                {
                                                    @foreach (var stakeholderId in Step1.SelectedIndividualStakeholderIds)
                                                    {
                                                        var stakeholder = AvailableStakeholders?.FirstOrDefault(s => s.Code == stakeholderId);
                                                        if (stakeholder != null)
                                                        {
                                                            <RadzenBadge Text="@stakeholder.DisplayName" BadgeStyle="BadgeStyle.Info" Style="margin: 0.2rem;" />
                                                        }
                                                    }
                                                }
                                                else
                                                {
                                                    <RadzenText TextStyle="TextStyle.Body2" Text="No individual stakeholders selected" Style="color: var(--rz-text-secondary-color); font-style: italic;" />
                                                }
                                            </div>
                                        </RadzenStack>
                                    </RadzenCard>

                                    <!-- Available Individual Stakeholders -->
                                    <RadzenCard>
                                        <RadzenStack Gap="0.5rem">
                                            <RadzenText TextStyle="TextStyle.H6" Text="Available Individual Stakeholders" Style="margin-bottom: 0.5rem; color: var(--rz-secondary);" />
                                            @if (AvailableStakeholders != null && AvailableStakeholders.Any())
                                            {
                                                <RadzenDataGrid Data="@AvailableStakeholders" TItem="SMSStakeholderUser" AllowFiltering="false" AllowPaging="false" Style="height: 300px;">
                                                    <Columns>
                                                        <RadzenDataGridColumn TItem="SMSStakeholderUser" Property="DisplayName" Title="Name" Width="40%" />
                                                        <RadzenDataGridColumn TItem="SMSStakeholderUser" Property="Organization" Title="Organization" Width="30%" />
                                                        <RadzenDataGridColumn TItem="SMSStakeholderUser" Title="Action" Width="20%">
                                                            <Template Context="stakeholder">
                                                                @if (Step1.SelectedIndividualStakeholderIds != null && !Step1.SelectedIndividualStakeholderIds.Contains(stakeholder.Code))
                                                                {
                                                                    <RadzenButton Text="Add" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" 
                                                                                  Click="@(() => AddIndividualStakeholder(stakeholder.Code))" />
                                                                }
                                                                else
                                                                {
                                                                    <RadzenButton Text="Remove" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" 
                                                                                  Click="@(() => RemoveIndividualStakeholder(stakeholder.Code))" />
                                                                }
                                                            </Template>
                                                        </RadzenDataGridColumn>
                                                    </Columns>
                                                </RadzenDataGrid>
                                            }
                                            else
                                            {
                                                <RadzenText TextStyle="TextStyle.Body2" Text="No individual stakeholders available" Style="color: var(--rz-text-secondary-color); font-style: italic;" />
                                            }
                                        </RadzenStack>
                                    </RadzenCard>
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                    </ChildContent>
                </RadzenFieldset>
            </RadzenStack>
        </RadzenColumn>

        <!-- Guidance Panel -->
        <RadzenColumn Size="12" SizeLG="4">
            <TechnicalAssessmentGuidancePanel StepNumber="1" />
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

@code {
    [Parameter] public Step1Model Step1 { get; set; } = new();
    [Parameter] public EventCallback<Step1Model> Step1Changed { get; set; }
    [Parameter] public List<SMSApplicationUser> AvailableAssessors { get; set; } = new();
    [Parameter] public List<SMSStakeholderGroup> StakeholderGroups { get; set; } = new();
    [Parameter] public List<SMSStakeholderUser> AvailableStakeholders { get; set; } = new();

    protected override void OnInitialized()
    {
        // Ensure Step1 and its collections are initialized
        if (Step1 == null)
        {
            Step1 = new Step1Model();
        }
        
        if (Step1.SelectedStakeholderGroupIds == null)
        {
            Step1.SelectedStakeholderGroupIds = new List<string>();
        }
        
        if (Step1.SelectedIndividualStakeholderIds == null)
        {
            Step1.SelectedIndividualStakeholderIds = new List<string>();
        }
    }

    private string GetFieldValidation(string? text, int minLength)
    {
        var length = text?.Trim().Length ?? 0;
        
        if (length == 0)
            return $"0/{minLength} characters";
        else if (length < minLength)
            return $"{length}/{minLength} characters (minimum {minLength} required)";
        else
            return $"{length} characters ✓";
    }

    private string GetLeadAssessorValidation()
    {
        if (string.IsNullOrEmpty(Step1.LeadAssessor))
        {
            return "Please select a lead assessor";
        }

        var selectedAssessor = AvailableAssessors?.FirstOrDefault(a => a.Code == Step1.LeadAssessor);
        if (selectedAssessor != null)
        {
            return $"Selected: {selectedAssessor.DisplayName} ✓";
        }

        return "Invalid assessor selection";
    }

    private async Task OnLeadAssessorChanged(object value)
    {
        if (value != null)
        {
            Step1.LeadAssessor = value.ToString() ?? string.Empty;
            await Step1Changed.InvokeAsync(Step1);
        }
    }

    private async Task AddStakeholderGroup(string groupCode)
    {
        if (!Step1.SelectedStakeholderGroupIds.Contains(groupCode))
        {
            Step1.SelectedStakeholderGroupIds.Add(groupCode);
            UpdateStakeholderGroupsString();
            await Step1Changed.InvokeAsync(Step1);
        }
    }

    private async Task RemoveStakeholderGroup(string groupCode)
    {
        if (Step1.SelectedStakeholderGroupIds.Contains(groupCode))
        {
            Step1.SelectedStakeholderGroupIds.Remove(groupCode);
            UpdateStakeholderGroupsString();
            await Step1Changed.InvokeAsync(Step1);
        }
    }

    private async Task AddIndividualStakeholder(string stakeholderCode)
    {
        if (!Step1.SelectedIndividualStakeholderIds.Contains(stakeholderCode))
        {
            Step1.SelectedIndividualStakeholderIds.Add(stakeholderCode);
            UpdateIndividualStakeholdersString();
            await Step1Changed.InvokeAsync(Step1);
        }
    }

    private async Task RemoveIndividualStakeholder(string stakeholderCode)
    {
        if (Step1.SelectedIndividualStakeholderIds.Contains(stakeholderCode))
        {
            Step1.SelectedIndividualStakeholderIds.Remove(stakeholderCode);
            UpdateIndividualStakeholdersString();
            await Step1Changed.InvokeAsync(Step1);
        }
    }

    private void UpdateStakeholderGroupsString()
    {
        if (Step1?.SelectedStakeholderGroupIds != null && StakeholderGroups != null)
        {
            var groupNames = Step1.SelectedStakeholderGroupIds
                .Select(id => StakeholderGroups?.FirstOrDefault(g => g.Code == id)?.Name)
                .Where(name => !string.IsNullOrEmpty(name));
            
            Step1.StakeholderGroups = string.Join(", ", groupNames!);
        }
    }

    private void UpdateIndividualStakeholdersString()
    {
        if (Step1?.SelectedIndividualStakeholderIds != null && AvailableStakeholders != null)
        {
            var stakeholderNames = Step1.SelectedIndividualStakeholderIds
                .Select(id => AvailableStakeholders?.FirstOrDefault(s => s.Code == id)?.DisplayName)
                .Where(name => !string.IsNullOrEmpty(name));
            
            Step1.SelectedIndividualStakeholders = string.Join(", ", stakeholderNames!);
        }
    }
}