<!-- Report Edit Component -->
<RadzenTemplateForm Data="@ReportData" Submit="@SaveChanges" TItem="EditReportData">
    <RadzenCard>
        <!-- Header -->
        <div class="mb-3">
            <h5>
                <RadzenIcon Icon="edit" Class="me-2" />
                Edit Report - @ReportData.Code
            </h5>
        </div>

        <!-- Form Fields -->
        <div class="row">
            <!-- Report Code (Read-only) -->
            <div class="col-12 mb-3">
                <RadzenFormField Text="Report Code" Variant="Variant.Outlined">
                    <RadzenTextBox Value="@ReportData.Code" ReadOnly="true" Style="width: 100%;" />
                </RadzenFormField>
                <small class="text-muted">Report code cannot be changed</small>
            </div>

            <!-- Report Name -->
            <div class="col-12 mb-3">
                <RadzenFormField Text="Report Name" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@ReportData.Name" 
                                 Placeholder="Enter report name..."
                                 Style="width: 100%;" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Name" Text="Report name is required" />
            </div>

            <!-- Description -->
            <div class="col-12 mb-3">
                <RadzenFormField Text="Description" Variant="Variant.Outlined">
                    <RadzenTextArea @bind-Value="@ReportData.Description" 
                                  Rows="4"
                                  Placeholder="Enter report description..."
                                  Style="width: 100%;" />
                </RadzenFormField>
            </div>

            <!-- Status -->
            <div class="col-md-6 mb-3">
                <RadzenFormField Text="Status" Variant="Variant.Outlined">
                    <RadzenDropDown @bind-Value="@ReportData.Status" 
                                  Data="@StatusOptions" 
                                  TextProperty="Text" 
                                  ValueProperty="Value"
                                  Placeholder="Select status..."
                                  Style="width: 100%;" />
                </RadzenFormField>
            </div>

            <!-- Stage -->
            <div class="col-md-6 mb-3">
                <RadzenFormField Text="Stage" Variant="Variant.Outlined">
                    <RadzenDropDown @bind-Value="@ReportData.Stage" 
                                  Data="@StageOptions" 
                                  TextProperty="Text" 
                                  ValueProperty="Value"
                                  Placeholder="Select stage..."
                                  Style="width: 100%;" />
                </RadzenFormField>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex justify-content-end gap-2 mt-4">
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                        Variant="Variant.Outlined"
                        Text="Cancel" 
                        Click="Cancel" />
            <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                        Icon="save"
                        Text="Save Changes"
                        ButtonType="ButtonType.Submit" />
        </div>
    </RadzenCard>
</RadzenTemplateForm>

@code {
    [Parameter] public EditReportData ReportData { get; set; } = new();
    [Parameter] public EventCallback<EditReportData> OnSave { get; set; }
    [Inject] public DialogService DialogService { get; set; } = default!;

    // Dropdown options
    public List<DropdownOption> StatusOptions { get; set; } = new List<DropdownOption>
    {
        new() { Value = "Active", Text = "Active" },
        new() { Value = "Pending", Text = "Pending" },
        new() { Value = "Closed", Text = "Closed" },
        new() { Value = "Cancelled", Text = "Cancelled" }
    };

    public List<DropdownOption> StageOptions { get; set; } = new List<DropdownOption>
    {
        new() { Value = "Initial", Text = "Initial" },
        new() { Value = "Validation", Text = "Validation" },
        new() { Value = "Assessment", Text = "Assessment" },
        new() { Value = "Mitigation", Text = "Mitigation" },
        new() { Value = "Closure", Text = "Closure" }
    };

    private async Task SaveChanges(EditReportData data)
    {
        if (OnSave.HasDelegate)
        {
            await OnSave.InvokeAsync(data);
        }
        DialogService.Close(true);
    }

    private void Cancel()
    {
        DialogService.Close(false);
    }

    public class DropdownOption
    {
        public string Value { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
    }
}