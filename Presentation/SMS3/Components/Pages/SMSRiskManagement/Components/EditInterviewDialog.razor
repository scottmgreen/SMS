@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Domain.Enums
@using SMS_Application.Messaging.Commands
@using SMS_Application.Interfaces
@using SMS_Shared.Common
@using Radzen
@using Radzen.Blazor

<div class="modal-overlay" @onclick:stopPropagation="true">
    <div class="sms-modal-dialog sms-modal-xl" @onclick:stopPropagation="true">
        <div class="sms-modal-content">
            
            <!-- Modal Header -->
            <div class="sms-modal-header sms-header-primary">
                <h4 class="sms-modal-title">
                    <RadzenIcon Icon="@GetInterviewIcon()" Style="margin-right: 0.5rem;" />
                    @GetDialogTitle()
                </h4>
            </div>

            <!-- Modal Body -->
            <div class="sms-modal-body">
                <RadzenStack Gap="0.75rem">
                    
                    <!-- Interview Status and Quick Actions -->
                    <RadzenCard Variant="Variant.Outlined" Style="background-color: var(--rz-base-50); padding: 0.75rem;">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                                <RadzenText TextStyle="TextStyle.Caption">
                                   Scheduled For : @(Model.InterviewDate?.ToString("MMM dd, yyyy HH:mm") ?? "Not Scheduled")
                                </RadzenText>
                               
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                @if (CanStartInterview)
                                {
                                    <RadzenButton Text="Start Interview" Icon="play_arrow" ButtonStyle="ButtonStyle.Success" 
                                                Size="ButtonSize.Small" Click="StartInterview" />
                                }
                                @if (CanCompleteInterview)
                                {
                                    <RadzenButton Text="Complete Interview" Icon="check_circle" ButtonStyle="ButtonStyle.Primary" 
                                                Size="ButtonSize.Small" Click="CompleteInterview" />
                                }
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>

                    <!-- Compact Layout with Tabs -->
                    <RadzenTabs @bind-SelectedIndex="@selectedTabIndex" RenderMode="TabRenderMode.Client" Style="min-height: 400px;">
                        <Tabs>
                            <!-- Basic Information Tab -->
                            <RadzenTabsItem Text="Basic Info" Icon="person" >
                                <RadzenFieldset Text="Interview Basics" Style=" height:470px;">
                                    <RadzenFieldset Text="Interview Details">
                                        <RadzenRow Gap="1rem">
                                            <RadzenColumn Size="4" SizeMD="4">
                                                <RadzenFormField Text="Person to Interview *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                    <RadzenTextBox @bind-Value="@Model.PersonInterviewed"
                                                                   Placeholder="Enter the name of person to interview"
                                                                   Style="width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="4" SizeMD="4">
                                                <RadzenFormField Text="Role/Position" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                    <RadzenTextBox @bind-Value="@Model.PersonInterviewedRole"
                                                                   Placeholder="e.g., Ground Crew, Pilot, Supervisor"
                                                                   Style="width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="3">
                                                <RadzenFormField Text="Department *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">

                                                    <RadzenDropDown @bind-Value="@Model.PersonInterviewedDepartmentId"
                                                                    Data="@DepartmentOptions"
                                                                    TextProperty="Text"
                                                                    ValueProperty="Value"
                                                                    Name="SubmittingDepartment"
                                                                    Change="@(async (object value) => await OnDepartmentChanged(value?.ToString()))"
                                                                    Style="width: 100%; min-width: 100%;" />
                                                </RadzenFormField>
                                                <RadzenRequiredValidator Component="ReportingDepartment" Text="Reporting Department by is required" />
                                            </RadzenColumn>

                                        </RadzenRow>

                                    </RadzenFieldset>

                                    <RadzenFieldset Text="Interview Schedule">
                                        <RadzenRow Gap="1rem">
                                            <RadzenColumn Size="3">
                                                <RadzenFormField Text="Interview Type" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                    <RadzenDropDown @bind-Value="@Model.InterviewTypeId"
                                                                    Data="@InterviewTypeOptions"
                                                                    TextProperty="Text"
                                                                    ValueProperty="Value"
                                                                    Change="@(async (object value) => await OnWitnessInterviewTypeChanged(value?.ToString()))"
                                                                    Style="width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="3">
                                                <RadzenFormField Text="Interview Status" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                    <RadzenDropDown @bind-Value="@Model.Status"
                                                                    Data="@InterviewStatusOptions"
                                                                    TextProperty="Name"
                                                                    ValueProperty="Status"
                                                                    Style="width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="3" SizeMD="3">
                                                <RadzenFormField Text="Interview Date & Time" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                    <RadzenDatePicker @bind-Value="@Model.InterviewDate"
                                                                      ShowTime="true"
                                                                      DateFormat="MM/dd/yyyy HH:mm"
                                                                      Style="width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="3" SizeMD="3">
                                                <RadzenFormField Text="Location" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                    <RadzenTextBox @bind-Value="@Model.InterviewLocation"
                                                                   Placeholder="Conference room, office, etc."
                                                                   Style="width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </RadzenFieldset>

                                </RadzenFieldset>
                                
                                    
                            </RadzenTabsItem>

                            <!-- Preparation Tab -->
                            <RadzenTabsItem Text="Preparation" Icon="edit_note" >
                                <RadzenFieldset Text="Preparation Notes" Style="height:470px;">
                                    <RadzenRow Gap="1rem">
                                        <RadzenFormField Text="Preparation Notes" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                <RadzenTextArea @bind-Value="@Model.PreparationNotes" 
                                                        Rows="3" 
                                                        Placeholder="Notes to prepare for the interview..."
                                                        Style="width: 100%;" />
                                            </RadzenFormField>


                                        <RadzenFormField Text="Questions to Ask" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                            <RadzenTextArea @bind-Value="@Model.QuestionsToAsk" 
                                                          Rows="3" 
                                                          Placeholder="Key questions to ask during the interview..."
                                                          Style="width: 100%;" />
                                        </RadzenFormField>

                                        <RadzenFormField Text="Background Information" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                            <RadzenTextArea @bind-Value="@Model.BackgroundInformation" 
                                                          Rows="3" 
                                                          Placeholder="Background information about the person or incident..."
                                                          Style="width: 100%;" />
                                        </RadzenFormField>
                                        
                                    </RadzenRow>
                                </RadzenFieldset>
                            </RadzenTabsItem>

                            <!-- Conducting Interview Tab -->
                            <RadzenTabsItem Text="@GetConductingTabText()" Icon="record_voice_over">
                                
                                <RadzenFieldset Text="Interview Notes" Style="height:470px;">
                                    <RadzenStack Gap="0.75rem" Style="padding: 1rem;">
                                        @if (Model.Status.Equals(InterviewStatus.InterviewInProgress) || Model.Status.Equals(InterviewStatus.InterviewComplete))
                                        {
                                            <!-- Interview Notes Side by Side -->
                                            <RadzenRow Gap="0.75rem">
                                                <RadzenColumn Size="6">
                                                    <RadzenFormField Text="Interviewee Notes/Responses" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                        <RadzenTextArea @bind-Value="@Model.PersonInterviewedNotes"
                                                                        Rows="6"
                                                                        Placeholder="Notes and responses from the interviewee..."
                                                                        Style="width: 100%;" />
                                                    </RadzenFormField>
                                                </RadzenColumn>
                                                <RadzenColumn Size="6">
                                                    <RadzenFormField Text="Investigator Observations" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                        <RadzenTextArea @bind-Value="@Model.InvestigatorNotes"
                                                                        Rows="6"
                                                                        Placeholder="Your observations and analysis..."
                                                                        Style="width: 100%;" />
                                                    </RadzenFormField>
                                                </RadzenColumn>
                                            </RadzenRow>

                                            <!-- Key Findings -->
                                            <RadzenFormField Text="Key Findings *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                <RadzenTextArea @bind-Value="@Model.KeyFindings"
                                                                Rows="3"
                                                                Placeholder="Key findings and important information discovered..."
                                                                Style="width: 100%;" />
                                            </RadzenFormField>

                                            <!-- Follow-up and Witnesses -->
                                            <RadzenRow Gap="0.75rem">
                                                <RadzenColumn Size="6">
                                                    <RadzenFormField Text="Follow-Up Required" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                        <RadzenTextArea @bind-Value="@Model.FollowUpRequired"
                                                                        Rows="2"
                                                                        Placeholder="Any follow-up actions needed..."
                                                                        Style="width: 100%;" />
                                                    </RadzenFormField>
                                                </RadzenColumn>
                                                <RadzenColumn Size="6">
                                                    <RadzenFormField Text="Additional Witnesses Mentioned" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                        <RadzenTextArea @bind-Value="@Model.AdditionalWitnesses"
                                                                        Rows="2"
                                                                        Placeholder="Other witnesses mentioned..."
                                                                        Style="width: 100%;" />
                                                    </RadzenFormField>
                                                </RadzenColumn>
                                            </RadzenRow>
                                        }
                                        else
                                        {
                                            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
                                                <RadzenText TextStyle="TextStyle.H6">Interview Not Started</RadzenText>
                                                <RadzenText>Start the interview to begin recording notes and findings.</RadzenText>
                                                @if (CanStartInterview)
                                                {
                                                    <RadzenButton Text="Start Interview Now" Icon="play_arrow" ButtonStyle="ButtonStyle.Success"
                                                                  Click="StartInterview" Style="margin-top: 0.75rem;" />
                                                }
                                            </RadzenAlert>
                                        }
                                    </RadzenStack>
                                </RadzenFieldset>
                                
                                
                                
                            </RadzenTabsItem>
                        </Tabs>
                    </RadzenTabs>

                </RadzenStack>
            </div>

            <!-- Modal Footer -->
            <div class="sms-modal-footer">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <!-- Left side - Cancel Interview button -->
                    <div class="d-flex gap-2">
                        @if (Model.Status.Equals(InterviewStatus.InterviewScheduled))
                        {
                            <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                        Text="Cancel Interview" 
                                        Icon="cancel"
                                        Click="@CancelInterview"
                                          Size="ButtonSize.Medium"
                                        Variant="Variant.Outlined" />
                        }
                    </div>

                                       
                    <!-- Right side - Close and Save Changes buttons -->
                    <div class="d-flex gap-2">
                        <RadzenButton ButtonStyle="ButtonStyle.Base" 
                                    Text="Close" 
                                    Icon="close"
                                    Click="@(() => DialogService.Close(false))"
                                    Size="ButtonSize.Medium" />
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                    Text="Save Changes" 
                                    Icon="save"
                                    Click="@UpdateInterview"
                                    Size="ButtonSize.Medium"
                                    Disabled="@IsSaving" />
                    </div>
                    
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Compact Modal Styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999; /* Increased to ensure it's above NavMenu */
        padding: 1rem;
    }

    .sms-modal-dialog {
        position: relative;
        margin: 0 auto;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
        z-index: 10000; /* Ensure dialog content is above overlay */
    }

    .sms-modal-xl {
        max-width: 1200px;
        width: 90%;
    }

    .sms-modal-content {
        background: white;
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
        position: relative;
        z-index: 10001; /* Highest z-index for modal content */
    }

    .sms-modal-header {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #e9ecef;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .sms-header-primary {
        background-color: #212e61;
        color: white;
    }

    .sms-modal-title {
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
    }

    .sms-modal-body {
        padding: 1rem;
        max-height: calc(100vh - 200px);
        overflow-y: auto;
    }

    .sms-modal-footer {
        padding: 0.75rem 1rem;
        border-top: 1px solid #e9ecef;
        border-radius: 0 0 0.5rem 0.5rem;
        background-color: #f8f9fa;
    }

    /* Compact form spacing */
    :deep .rz-formfield {
        margin-bottom: 0;
    }

    :deep .rz-textarea, :deep .rz-textbox, :deep .rz-dropdown {
        font-size: 0.875rem;
    }

    :deep .rz-tabs .rz-tabs-nav {
        border-bottom: 1px solid #e9ecef;
    }

    :deep .rz-tabs .rz-tabview-panel {
        padding: 0;
        border: none;
    }
</style>