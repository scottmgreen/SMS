@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Domain.Enums
@using SMS_Application.Messaging.Commands
@using SMS_Application.Interfaces
@using SMS_Shared.Common
@using Radzen
@using Radzen.Blazor

<div class="modal-overlay" @onclick:stopPropagation="true">
    <div class="sms-modal-dialog sms-modal-xl" @onclick:stopPropagation="true">
        <div class="sms-modal-content">
            
            <!-- Modal Header -->
            <div class="sms-modal-header sms-header-primary">
                <h4 class="sms-modal-title">
                    <RadzenIcon Icon="@GetInterviewIcon()" Style="margin-right: 0.5rem;" />
                    @GetDialogTitle()
                </h4>
            </div>

            <!-- Modal Body -->
            <div class="sms-modal-body">
                <RadzenStack Gap="0.75rem">
                    
                    <!-- Interview Status and Quick Actions -->
                    <RadzenCard Variant="Variant.Outlined" Style="background-color: var(--rz-base-50); padding: 0.75rem;">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                                <RadzenBadge Text="@Model.Status.ToString()" BadgeStyle="@GetStatusBadgeStyle()" />
                                <RadzenText TextStyle="TextStyle.Caption">
                                    @(Model.InterviewDate?.ToString("MMM dd, yyyy HH:mm") ?? "Not Scheduled")
                                </RadzenText>
                                @if (Model.DurationMinutes.HasValue)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption">
                                        Duration: @Model.DurationMinutes min
                                    </RadzenText>
                                }
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                @if (CanStartInterview)
                                {
                                    <RadzenButton Text="Start Interview" Icon="play_arrow" ButtonStyle="ButtonStyle.Success" 
                                                Size="ButtonSize.Small" Click="StartInterview" />
                                }
                                @if (CanCompleteInterview)
                                {
                                    <RadzenButton Text="Complete Interview" Icon="check_circle" ButtonStyle="ButtonStyle.Primary" 
                                                Size="ButtonSize.Small" Click="CompleteInterview" />
                                }
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>

                    <!-- Compact Layout with Tabs -->
                    <RadzenTabs @bind-SelectedIndex="@selectedTabIndex" RenderMode="TabRenderMode.Client" Style="min-height: 400px;">
                        <Tabs>
                            <!-- Basic Information Tab -->
                            <RadzenTabsItem Text="Basic Info" Icon="person">
                                <RadzenStack Gap="0.75rem" Style="padding: 1rem;">
                                    <!-- Person and Role - Compact Row -->
                                    <RadzenRow Gap="0.75rem">
                                        <RadzenColumn Size="6">
                                            <RadzenFormField Text="Person Interviewed *" Variant="Variant.Outlined">
                                                <RadzenTextBox @bind-Value="@Model.PersonInterviewed" 
                                                             Placeholder="Enter name"
                                                             Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn Size="3">
                                            <RadzenFormField Text="Role" Variant="Variant.Outlined">
                                                <RadzenTextBox @bind-Value="@Model.PersonInterviewedRole" 
                                                             Placeholder="Position"
                                                             Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn Size="3">
                                            <RadzenFormField Text="Department" Variant="Variant.Outlined">
                                                <RadzenTextBox @bind-Value="@Model.PersonInterviewedDepartment" 
                                                             Placeholder="Department"
                                                             Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <!-- Type, Status, Date - Compact Row -->
                                    <RadzenRow Gap="0.75rem">
                                        <RadzenColumn Size="3">
                                            <RadzenFormField Text="Type" Variant="Variant.Outlined">
                                                <RadzenDropDown @bind-Value="@Model.Type" 
                                                              Data="@InterviewTypeOptions" 
                                                              TextProperty="Text" 
                                                              ValueProperty="Value"
                                                              Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn Size="3">
                                            <RadzenFormField Text="Status" Variant="Variant.Outlined">
                                                <RadzenDropDown @bind-Value="@Model.Status" 
                                                              Data="@InterviewStatusOptions" 
                                                              TextProperty="Text" 
                                                              ValueProperty="Value"
                                                              Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn Size="4">
                                            <RadzenFormField Text="Interview Date & Time" Variant="Variant.Outlined">
                                                <RadzenDatePicker @bind-Value="@Model.InterviewDate" 
                                                                ShowTime="true" 
                                                                DateFormat="MM/dd/yyyy HH:mm"
                                                                Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn Size="2">
                                            <RadzenFormField Text="Duration (min)" Variant="Variant.Outlined">
                                                <RadzenNumeric @bind-Value="@Model.DurationMinutes" 
                                                             Min="0" Max="600"
                                                             Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <!-- Location and Confidential -->
                                    <RadzenRow Gap="0.75rem">
                                        <RadzenColumn Size="8">
                                            <RadzenFormField Text="Location" Variant="Variant.Outlined">
                                                <RadzenTextBox @bind-Value="@Model.InterviewLocation" 
                                                             Placeholder="Conference room, office, etc."
                                                             Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                        <RadzenColumn Size="4" Style="display: flex; align-items: end; padding-bottom: 0.5rem;">
                                            <RadzenCheckBox @bind-Value="@Model.IsConfidential" Name="confidential" />
                                            <RadzenLabel Text="Confidential Interview" Component="confidential" Style="margin-left: 0.5rem;" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenTabsItem>

                            <!-- Preparation Tab -->
                            <RadzenTabsItem Text="Preparation" Icon="edit_note">
                                <RadzenStack Gap="0.75rem" Style="padding: 1rem;">
                                    <RadzenFormField Text="Preparation Notes" Variant="Variant.Outlined">
                                        <RadzenTextArea @bind-Value="@Model.PreparationNotes" 
                                                      Rows="3" 
                                                      Placeholder="Notes to prepare for the interview..."
                                                      Style="width: 100%;" />
                                    </RadzenFormField>

                                    <RadzenFormField Text="Questions to Ask" Variant="Variant.Outlined">
                                        <RadzenTextArea @bind-Value="@Model.QuestionsToAsk" 
                                                      Rows="4" 
                                                      Placeholder="Key questions to ask during the interview..."
                                                      Style="width: 100%;" />
                                    </RadzenFormField>

                                    <RadzenFormField Text="Background Information" Variant="Variant.Outlined">
                                        <RadzenTextArea @bind-Value="@Model.BackgroundInformation" 
                                                      Rows="3" 
                                                      Placeholder="Background information about the person or incident..."
                                                      Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenStack>
                            </RadzenTabsItem>

                            <!-- Conducting Interview Tab -->
                            <RadzenTabsItem Text="@GetConductingTabText()" Icon="record_voice_over">
                                <RadzenStack Gap="0.75rem" Style="padding: 1rem;">
                                    @if (Model.Status.Equals(InterviewStatus.InterviewInProgress) || Model.Status.Equals(InterviewStatus.InterviewComplete))
                                    {
                                        <!-- Interview Notes Side by Side -->
                                        <RadzenRow Gap="0.75rem">
                                            <RadzenColumn Size="6">
                                                <RadzenFormField Text="Interviewee Notes/Responses" Variant="Variant.Outlined">
                                                    <RadzenTextArea @bind-Value="@Model.PersonInterviewedNotes" 
                                                                  Rows="6" 
                                                                  Placeholder="Notes and responses from the interviewee..."
                                                                  Style="width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="6">
                                                <RadzenFormField Text="Investigator Observations" Variant="Variant.Outlined">
                                                    <RadzenTextArea @bind-Value="@Model.InvestigatorNotes" 
                                                                  Rows="6" 
                                                                  Placeholder="Your observations and analysis..."
                                                                  Style="width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>

                                        <!-- Key Findings -->
                                        <RadzenFormField Text="Key Findings *" Variant="Variant.Outlined">
                                            <RadzenTextArea @bind-Value="@Model.KeyFindings" 
                                                          Rows="3" 
                                                          Placeholder="Key findings and important information discovered..."
                                                          Style="width: 100%;" />
                                        </RadzenFormField>

                                        <!-- Follow-up and Witnesses -->
                                        <RadzenRow Gap="0.75rem">
                                            <RadzenColumn Size="6">
                                                <RadzenFormField Text="Follow-Up Required" Variant="Variant.Outlined">
                                                    <RadzenTextArea @bind-Value="@Model.FollowUpRequired" 
                                                                  Rows="2" 
                                                                  Placeholder="Any follow-up actions needed..."
                                                                  Style="width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="6">
                                                <RadzenFormField Text="Additional Witnesses Mentioned" Variant="Variant.Outlined">
                                                    <RadzenTextArea @bind-Value="@Model.AdditionalWitnesses" 
                                                                  Rows="2" 
                                                                  Placeholder="Other witnesses mentioned..."
                                                                  Style="width: 100%;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    }
                                    else
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
                                            <RadzenText TextStyle="TextStyle.H6">Interview Not Started</RadzenText>
                                            <RadzenText>Start the interview to begin recording notes and findings.</RadzenText>
                                            @if (CanStartInterview)
                                            {
                                                <RadzenButton Text="Start Interview Now" Icon="play_arrow" ButtonStyle="ButtonStyle.Success" 
                                                            Click="StartInterview" Style="margin-top: 0.75rem;" />
                                            }
                                        </RadzenAlert>
                                    }
                                </RadzenStack>
                            </RadzenTabsItem>
                        </Tabs>
                    </RadzenTabs>

                </RadzenStack>
            </div>

            <!-- Modal Footer -->
            <div class="sms-modal-footer">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex gap-2">
                        @if (Model.Status.Equals(InterviewStatus.InterviewScheduled))
                        {
                            <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                        Text="Cancel Interview" 
                                        Icon="cancel"
                                        Click="@CancelInterview"
                                        Size="ButtonSize.Small"
                                        Variant="Variant.Outlined" />
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                    Text="Close" 
                                    Icon="close"
                                    Click="@(() => DialogService.Close(false))"
                                    Size="ButtonSize.Medium" />
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                    Text="Save Changes" 
                                    Icon="save"
                                    Click="@UpdateInterview"
                                    Size="ButtonSize.Medium"
                                    Disabled="@IsSaving" />
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Compact Modal Styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 1rem;
    }

    .sms-modal-dialog {
        position: relative;
        margin: 0 auto;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
    }

    .sms-modal-xl {
        max-width: 1200px;
        width: 90%;
    }

    .sms-modal-content {
        background: white;
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    }

    .sms-modal-header {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #e9ecef;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .sms-header-primary {
        background-color: #212e61;
        color: white;
    }

    .sms-modal-title {
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
    }

    .sms-modal-body {
        padding: 1rem;
        max-height: calc(100vh - 200px);
        overflow-y: auto;
    }

    .sms-modal-footer {
        padding: 0.75rem 1rem;
        border-top: 1px solid #e9ecef;
        border-radius: 0 0 0.5rem 0.5rem;
        background-color: #f8f9fa;
    }

    /* Compact form spacing */
    :deep .rz-formfield {
        margin-bottom: 0;
    }

    :deep .rz-textarea, :deep .rz-textbox, :deep .rz-dropdown {
        font-size: 0.875rem;
    }

    :deep .rz-tabs .rz-tabs-nav {
        border-bottom: 1px solid #e9ecef;
    }

    :deep .rz-tabs .rz-tabview-panel {
        padding: 0;
        border: none;
    }
</style>