@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Application.Commands
@using SMS_Application.Interfaces
@using SMS_Shared.Common
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor

<!-- Modal Overlay -->
<div class="modal-overlay">
    <div class="sms-modal-dialog sms-modal-evidence">
        <div class="sms-modal-content">
            <!-- SMS Awesome Modal Header -->
            <div class="sms-modal-header sms-header-primary">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <h5 class="sms-modal-title">
                        <RadzenIcon Icon="cloud_upload" Style="margin-right: 0.75rem; font-size: 1.25rem;" />
                        Upload Evidence Files
                    </h5>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                Variant="Variant.Text"
                                Icon="close"
                                Size="ButtonSize.Small"
                                Click="@(() => DialogService.Close(false))"
                                Style="color: white; border-color: rgba(255,255,255,0.3);"
                                Disabled="@IsUploading" />
                </div>
            </div>

            <!-- Modal Body -->
            <div class="sms-modal-body">
                <RadzenTemplateForm Data="@Model" Submit="@UploadFiles" TItem="UploadFileModel">
                    <RadzenStack Gap="1rem">
                        <RadzenFormField Text="Supporting Documents" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                            <RadzenStack Gap="0.75rem" Class="rz-py-2 rz-px-2 rz-pb-2">
                                <RadzenUpload Multiple="true"
                                              Change=@OnInputFileChange
                                              ChooseText="📄 Choose Files"
                                              Class="hazard-upload"
                                              Style="width: 100%;padding: 0.5rem; border: 1px solid #ccc; border-radius: 0.25rem;"
                                              Accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.txt"
                                              MaxFileSize="10485760" />

                                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-base-500">
                                    <RadzenIcon Icon="attach_file" Style="font-size: 0.9rem;" />
                                    Supported: JPG, PNG, PDF, DOC, DOCX, TXT (Max 10MB per file)
                                </RadzenText>
                            </RadzenStack>
                        </RadzenFormField>

                        @if (AttachedFiles.Any())
                        {
                            <RadzenStack Gap="1rem" Class="rz-px-2 rz-pb-2">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                    <strong>Queued files (@AttachedFiles.Count):</strong>
                                    <RadzenButton ButtonStyle="ButtonStyle.Base"
                                                  Variant="Variant.Text"
                                                  Icon="clear_all"
                                                  Text="Clear All"
                                                  Size="ButtonSize.ExtraSmall"
                                                  Click="ClearAllFiles" />
                                </RadzenStack>

                                <RadzenStack Gap="0.5rem">
                                    @for (int i = 0; i < AttachedFiles.Count; i++)
                                    {
                                        var file = AttachedFiles[i];
                                        var fileIndex = i;
                                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center"
                                                     Style="padding: 0.25rem 0.5rem; border: 1px solid #dee2e6; border-radius: 0.25rem; background-color: #f8f9fa;">
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                <RadzenIcon Icon="attach_file" Style="color: var(--sms-blue-dark-bold); font-size: 0.9rem;" />
                                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                                                    @file.FileName (@file.SizeDisplay)
                                                </RadzenText>
                                            </RadzenStack>
                                            <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                                          Variant="Variant.Text"
                                                          Icon="close"
                                                          Size="ButtonSize.ExtraSmall"
                                                          Click="@(() => RemoveFile(fileIndex))"
                                                          Text="" />
                                        </RadzenStack>
                                    }
                                </RadzenStack>
                            </RadzenStack>
                        }

                        @if (AttachedFiles.Any() && !IsUploading)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Success" Size="AlertSize.Small" Variant="Variant.Flat" Icon="check_circle">
                                <strong>Ready to Upload:</strong> @AttachedFiles.Count file(s) selected, total size @GetTotalSizeDisplay()
                            </RadzenAlert>
                        }
                    </RadzenStack>
                </RadzenTemplateForm>
            </div>

            <!-- Modal Footer -->
            <div class="sms-modal-footer">
                <div class="d-flex justify-content-end gap-2">
                    <RadzenButton Text="Cancel" 
                                Icon="cancel"
                                ButtonStyle="ButtonStyle.Secondary" 
                                Size="ButtonSize.Medium"
                                Click="@(() => DialogService.Close(false))"
                                Disabled="@IsUploading" />
                    <RadzenButton Text="@GetUploadButtonText()" 
                                Icon="@(IsUploading ? "upload" : "cloud_upload")"
                                ButtonStyle="ButtonStyle.Primary" 
                                ButtonType="ButtonType.Submit"
                                Size="ButtonSize.Medium"
                                Click="@(() => UploadFiles(Model))"
                                Disabled="@(IsUploading || !AttachedFiles.Any())" />
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* =============================================================================
   SMS UPLOAD EVIDENCE DIALOG - AWESOME MODAL STYLING
   ============================================================================= */

/* Modal Overlay and Dialog */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
    padding: 1rem;
}

.sms-modal-dialog {
    position: relative;
    margin: 0 auto;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
}

.sms-modal-evidence {
    width: 1098px;
    min-height: 584px;
    max-width: 95vw; /* Responsive fallback */
}

.sms-modal-content {
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    height: 584px; /* Fixed height */
}

.sms-modal-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e9ecef;
    border-radius: 0.5rem 0.5rem 0 0;
    flex-shrink: 0; /* Prevent shrinking */
}

.sms-header-primary {
    background-color: #212e61; /* SMS Blue Dark Bold */
    color: white;
}

.sms-modal-title {
    margin: 0;
    font-weight: 600;
    display: flex;
    align-items: center;
    font-size: 1.1rem;
}

.sms-modal-body {
    padding: 1.5rem;
    overflow-y: auto;
    flex: 1; /* Take remaining space */
    color: #212e61; /* SMS Blue Dark Bold text */
}

.sms-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid #e9ecef;
    border-radius: 0 0 0.5rem 0.5rem;
    background-color: #f8f9fa;
    flex-shrink: 0; /* Prevent shrinking */
}

/* Progress animation */
@@keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.7; }
    100% { opacity: 1; }
}

.uploading-animation {
    animation: pulse 2s ease-in-out infinite;
}

/* File type badges */
.file-badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
}

.file-badge-pdf { background-color: #ffebee; color: #c62828; }
.file-badge-image { background-color: #e8f5e8; color: #2e7d32; }
.file-badge-video { background-color: #e3f2fd; color: #1565c0; }
.file-badge-audio { background-color: #fff3e0; color: #ef6c00; }
.file-badge-document { background-color: #f3e5f5; color: #7b1fa2; }
.file-badge-other { background-color: #f5f5f5; color: #616161; }

/* Responsive adjustments */
@@media (max-width: 1150px) {
    .sms-modal-evidence {
        width: 95vw;
        min-height: 500px;
    }
    
    .sms-modal-content {
        height: auto;
        min-height: 500px;
        max-height: 90vh;
    }
}

@@media (max-width: 768px) {
    .sms-modal-evidence {
        width: 98vw;
        min-height: 400px;
    }
    
    .modal-overlay {
        padding: 0.5rem;
    }
    
    .sms-modal-header,
    .sms-modal-body,
    .sms-modal-footer {
        padding: 1rem;
    }
    
    .sms-modal-title {
        font-size: 1rem;
    }
}

/* =============================================================================
   END SMS UPLOAD EVIDENCE DIALOG STYLING
   ============================================================================= */
</style>