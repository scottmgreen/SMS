@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Application.Commands
@using SMS_Application.Interfaces
@using SMS_Shared.Common
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor

<!-- Modal Overlay -->
<div class="modal-overlay">
    <div class="sms-modal-dialog sms-modal-evidence">
        <div class="sms-modal-content">
            <!-- SMS Awesome Modal Header -->
            <div class="sms-modal-header sms-header-primary">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <h5 class="sms-modal-title">
                        <RadzenIcon Icon="cloud_upload" Style="margin-right: 0.75rem; font-size: 1.25rem;" />
                        Upload Evidence Files
                    </h5>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                Variant="Variant.Text"
                                Icon="close"
                                Size="ButtonSize.Small"
                                Click="@(() => DialogService.Close(false))"
                                Style="color: white; border-color: rgba(255,255,255,0.3);"
                                Disabled="@IsUploading" />
                </div>
            </div>

            <!-- Modal Body -->
            <div class="sms-modal-body">
                <RadzenTemplateForm Data="@Model" Submit="@UploadFiles" TItem="UploadFileModel">
                    <RadzenStack Gap="1rem">
                        
                        <!-- File Selection - Multiple Files Support -->
                        <RadzenFormField Text="Select Evidence Files *" Variant="Variant.Outlined">
                            <InputFile OnChange="OnInputFileChange" 
                                     multiple 
                                     accept=".jpg,.jpeg,.png,.gif,.bmp,.pdf,.doc,.docx,.txt,.xlsx,.xls,.zip,.rar,.mp4,.avi,.mov,.wmv,.mp3,.wav"
                                     style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 0.25rem;" />
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); margin-top: 0.5rem;">
                                <RadzenIcon Icon="attach_file" Style="font-size: 0.9rem;" /> 
                                <strong>Supported formats:</strong> Images (JPG, PNG, GIF), Documents (PDF, DOC, DOCX, TXT), Spreadsheets (XLS, XLSX), 
                                Videos (MP4, AVI, MOV), Audio (MP3, WAV), Archives (ZIP, RAR)
                                <br/>
                                <RadzenIcon Icon="info" Style="font-size: 0.9rem;" /> 
                                <strong>File size limit:</strong> 50MB per file | <strong>Multiple files:</strong> Up to 10 files at once
                                @if (AttachedFiles.Any())
                                {
                                    <br/>
                                    <span style="margin-left: 1rem; color: var(--rz-success);">
                                        <RadzenIcon Icon="check_circle" Style="font-size: 0.9rem;" />
                                        @AttachedFiles.Count file(s) queued for upload
                                    </span>
                                }
                            </RadzenText>
                        </RadzenFormField>

                        <!-- Selected Files Preview -->
                        @if (AttachedFiles.Any())
                        {
                            <RadzenFormField Text="Selected Files" Variant="Variant.Outlined">
                                <RadzenCard Variant="Variant.Text" Style="background-color: #f8f9fa; border: 1px solid #e9ecef; max-height: 200px; overflow-y: auto;">
                                    <RadzenStack Gap="0.5rem">
                                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="color: var(--rz-primary);">
                                                <RadzenIcon Icon="folder_open" Style="margin-right: 0.5rem;" />
                                                @AttachedFiles.Count file(s) ready for upload
                                            </RadzenText>
                                            <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                                        Variant="Variant.Text"
                                                        Icon="clear_all" 
                                                        Text="Clear All"
                                                        Size="ButtonSize.ExtraSmall"
                                                        Click="ClearAllFiles" />
                                        </RadzenStack>
                                        
                                        @for (int i = 0; i < AttachedFiles.Count; i++)
                                        {
                                            var file = AttachedFiles[i];
                                            var fileIndex = i;
                                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" 
                                                       Style="padding: 0.25rem 0.5rem; border: 1px solid #dee2e6; border-radius: 0.25rem; background-color: #ffffff;">
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                    <RadzenIcon Icon="@GetFileIcon(file.FileName)" Style="@($"color: {GetFileIconColor(file.FileName)}; font-size: 1.1rem;")" />
                                                    <RadzenStack Gap="0.1rem">
                                                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; font-weight: 500;">@file.FileName</RadzenText>
                                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); margin: 0;">
                                                            @file.SizeDisplay | @GetFileTypeDisplay(file.FileName)
                                                        </RadzenText>
                                                    </RadzenStack>
                                                </RadzenStack>
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                                    <RadzenBadge Text="Ready" BadgeStyle="BadgeStyle.Success" />
                                                    <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                                                Variant="Variant.Text"
                                                                Icon="close" 
                                                                Size="ButtonSize.ExtraSmall"
                                                                Click="@(() => RemoveFile(fileIndex))"
                                                                title="Remove this file" />
                                                </RadzenStack>
                                            </RadzenStack>
                                        }
                                        
                                        <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" Variant="Variant.Flat">
                                            <RadzenIcon Icon="info" /> 
                                            <strong>Total size:</strong> @GetTotalSizeDisplay() | 
                                            <strong>Evidence types:</strong> @GetFileTypeSummary()
                                        </RadzenAlert>
                                    </RadzenStack>
                                </RadzenCard>
                            </RadzenFormField>
                        }

                        <!-- Evidence Description -->
                        <RadzenFormField Text="Evidence Description *" Variant="Variant.Outlined">
                            <RadzenTextArea @bind-Value="@Model.Description" 
                                          Rows="3" 
                                          Placeholder="Provide a detailed description of this evidence and its relevance to the investigation..."
                                          Style="width: 100%;" />
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="margin-top: 0.5rem;">
                                <RadzenRequiredValidator Component="Description" Text="Evidence description is required" />
                                <RadzenText TextStyle="TextStyle.Caption" 
                                          Style="@(DescriptionCharacterCount > 950 ? "color: var(--rz-danger);" : DescriptionCharacterCount > 800 ? "color: var(--rz-warning);" : "color: var(--rz-text-secondary-color);")">
                                    @DescriptionCharacterCount/1000 characters
                                </RadzenText>
                            </RadzenStack>
                        </RadzenFormField>

                        <!-- Evidence Category and Security in Row -->
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Evidence Category" Variant="Variant.Outlined">
                                    <RadzenDropDown @bind-Value="@Model.Category" 
                                                  Data="@CategoryOptions" 
                                                  TextProperty="Text" 
                                                  ValueProperty="Value"
                                                  Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenFormField Text="Security Classification" Variant="Variant.Outlined">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                                        <RadzenCheckBox @bind-Value="@Model.IsConfidential" Name="confidential" />
                                        <RadzenLabel Text="Mark as confidential" Component="confidential" />
                                        <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                                    Variant="Variant.Text"
                                                    Icon="info"
                                                    Size="ButtonSize.ExtraSmall"
                                                    Click="ToggleConfidentialInfo" />
                                    </RadzenStack>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Confidential Info Alert -->
                        @if (ShowConfidentialInfo)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" Variant="Variant.Flat">
                                <RadzenIcon Icon="security" /> 
                                <strong>Confidential Evidence:</strong> Access restricted to authorized investigation personnel only. 
                                Evidence will be protected from unauthorized disclosure and excluded from general reports unless specifically authorized.
                            </RadzenAlert>
                        }

                        @if (Model.IsConfidential)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" Icon="warning" Title="Confidential Evidence" Size="AlertSize.Small" Variant="Variant.Flat">
                                This evidence will be restricted to authorized investigation personnel only and excluded from public reports.
                            </RadzenAlert>
                        }

                        <!-- Upload Progress -->
                        @if (IsUploading)
                        {
                            <RadzenCard Variant="Variant.Outlined" Style="background: linear-gradient(135deg, rgba(33, 150, 243, 0.05) 0%, rgba(33, 150, 243, 0.1) 100%); border-color: var(--rz-info);">
                                <RadzenStack Gap="1rem" Style="padding: 1rem;">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Gap="1rem">
                                        <RadzenProgressBarCircular Value="@UploadProgress" ShowValue="true" ProgressBarStyle="ProgressBarStyle.Info" Size="ProgressBarCircularSize.Medium" />
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0; font-weight: 600;">Uploading Evidence Files...</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color); margin: 0;">@CurrentUploadStatus</RadzenText>
                                        </RadzenStack>
                                    </RadzenStack>
                                    
                                    @if (!string.IsNullOrEmpty(CurrentFileName))
                                    {
                                        <RadzenProgressBar Value="@FileProgress" ShowValue="false" ProgressBarStyle="ProgressBarStyle.Info" />
                                        <RadzenText TextStyle="TextStyle.Caption" Style="text-align: center; color: var(--rz-text-secondary-color);">
                                            Processing: @CurrentFileName (@(CurrentFileIndex + 1) of @AttachedFiles.Count)
                                        </RadzenText>
                                    }
                                </RadzenStack>
                            </RadzenCard>
                        }

                        <!-- Upload Summary -->
                        @if (AttachedFiles.Any() && !IsUploading)
                        {
                            <RadzenAlert AlertStyle="@(CanUpload() ? AlertStyle.Success : AlertStyle.Warning)" 
                                        Size="AlertSize.Small" Variant="Variant.Flat"
                                        Icon="@(CanUpload() ? "check_circle" : "warning")">
                                @if (CanUpload())
                                {
                                    <text><strong>Ready to Upload:</strong> @AttachedFiles.Count file(s) selected, total size @GetTotalSizeDisplay()</text>
                                }
                                else
                                {
                                    <text><strong>Missing Information:</strong> @GetValidationMessage()</text>
                                }
                            </RadzenAlert>
                        }
                    </RadzenStack>
                </RadzenTemplateForm>
            </div>

            <!-- Modal Footer -->
            <div class="sms-modal-footer">
                <div class="d-flex justify-content-end gap-2">
                    <RadzenButton Text="Cancel" 
                                Icon="cancel"
                                ButtonStyle="ButtonStyle.Secondary" 
                                Size="ButtonSize.Medium"
                                Click="@(() => DialogService.Close(false))"
                                Disabled="@IsUploading" />
                    <RadzenButton Text="@GetUploadButtonText()" 
                                Icon="@(IsUploading ? "upload" : "cloud_upload")"
                                ButtonStyle="ButtonStyle.Primary" 
                                ButtonType="ButtonType.Submit"
                                Size="ButtonSize.Medium"
                                Click="@(() => UploadFiles(Model))"
                                Disabled="@(IsUploading || !CanUpload())" />
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* =============================================================================
   SMS UPLOAD EVIDENCE DIALOG - AWESOME MODAL STYLING
   ============================================================================= */

/* Modal Overlay and Dialog */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
    padding: 1rem;
}

.sms-modal-dialog {
    position: relative;
    margin: 0 auto;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
}

.sms-modal-evidence {
    width: 1098px;
    min-height: 584px;
    max-width: 95vw; /* Responsive fallback */
}

.sms-modal-content {
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    height: 584px; /* Fixed height */
}

.sms-modal-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e9ecef;
    border-radius: 0.5rem 0.5rem 0 0;
    flex-shrink: 0; /* Prevent shrinking */
}

.sms-header-primary {
    background-color: #212e61; /* SMS Blue Dark Bold */
    color: white;
}

.sms-modal-title {
    margin: 0;
    font-weight: 600;
    display: flex;
    align-items: center;
    font-size: 1.1rem;
}

.sms-modal-body {
    padding: 1.5rem;
    overflow-y: auto;
    flex: 1; /* Take remaining space */
    color: #212e61; /* SMS Blue Dark Bold text */
}

.sms-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid #e9ecef;
    border-radius: 0 0 0.5rem 0.5rem;
    background-color: #f8f9fa;
    flex-shrink: 0; /* Prevent shrinking */
}

/* Progress animation */
@@keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.7; }
    100% { opacity: 1; }
}

.uploading-animation {
    animation: pulse 2s ease-in-out infinite;
}

/* File type badges */
.file-badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
}

.file-badge-pdf { background-color: #ffebee; color: #c62828; }
.file-badge-image { background-color: #e8f5e8; color: #2e7d32; }
.file-badge-video { background-color: #e3f2fd; color: #1565c0; }
.file-badge-audio { background-color: #fff3e0; color: #ef6c00; }
.file-badge-document { background-color: #f3e5f5; color: #7b1fa2; }
.file-badge-other { background-color: #f5f5f5; color: #616161; }

/* Responsive adjustments */
@@media (max-width: 1150px) {
    .sms-modal-evidence {
        width: 95vw;
        min-height: 500px;
    }
    
    .sms-modal-content {
        height: auto;
        min-height: 500px;
        max-height: 90vh;
    }
}

@@media (max-width: 768px) {
    .sms-modal-evidence {
        width: 98vw;
        min-height: 400px;
    }
    
    .modal-overlay {
        padding: 0.5rem;
    }
    
    .sms-modal-header,
    .sms-modal-body,
    .sms-modal-footer {
        padding: 1rem;
    }
    
    .sms-modal-title {
        font-size: 1rem;
    }
}

/* =============================================================================
   END SMS UPLOAD EVIDENCE DIALOG STYLING
   ============================================================================= */
</style>