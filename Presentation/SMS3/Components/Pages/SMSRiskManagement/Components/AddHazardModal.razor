@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using SMS_Domain.ValueObjects
@using Radzen
@using Radzen.Blazor

@if (IsVisible)
{
    <div class="modal-overlay">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <RadzenIcon Icon="add_circle" Style="margin-right: 0.5rem;" />
                        Add New Hazard
                    </h5>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                  Icon="close" Size="ButtonSize.Small"
                                  Click="@CloseModal" />
                </div>
                <div class="modal-body">
                    <RadzenStack Gap="1rem">
                        <!-- Hazard Description -->
                        <RadzenFormField Text="Hazard Description *" Variant="Variant.Outlined">
                            <RadzenTextArea @bind-Value="@NewHazardDescription" Rows="3" 
                                            Placeholder="Describe the hazard clearly and specifically..." 
                                            Style="width: 100%;" />
                        </RadzenFormField>
                        @if (!string.IsNullOrWhiteSpace(NewHazardDescription) && NewHazardDescription.Trim().Length < 10)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger);">
                                Description must be at least 10 characters (currently @(NewHazardDescription.Trim().Length))
                            </RadzenText>
                        }
                        
                        <!-- Category and 5M Framework -->
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Hazard Category" Variant="Variant.Outlined">
                                    <RadzenDropDown @bind-Value="@NewHazardCategory" Data="@HazardCategories" 
                                                    Placeholder="Select category..." Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="5M Framework Component" Variant="Variant.Outlined">
                                    <RadzenDropDown @bind-Value="@NewHazardFiveM" Data="@FiveMOptions" 
                                                    ValueProperty="Value" TextProperty="Text"
                                                    Placeholder="Select 5M component..." Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- Location Selection -->
                        <RadzenFormField Text="Location *" Variant="Variant.Outlined">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Stretch">
                                <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                            Click="OpenMapSelector"
                                            Text="Select on Map" 
                                            Icon="map" 
                                            Size="ButtonSize.Medium"
                                            Style="width: 200px; min-width: 200px; flex-shrink: 0;" />
                                <RadzenTextBox Value="@LocationDisplayText" 
                                             ReadOnly="true"
                                             Placeholder="No location selected - click 'Select on Map'"
                                             Style="width: 100%; min-width: 300px;" />
                            </RadzenStack>
                        </RadzenFormField>
                        @if (HasGeoLocation)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-success);">
                                <RadzenIcon Icon="location_on" />
                                Location set: @LocationDisplayText
                            </RadzenText>
                        }
                    </RadzenStack>
                </div>
                <div class="modal-footer">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" 
                                  Click="@CloseModal" 
                                  Disabled="@IsSubmitting" />
                    <RadzenButton Text="@(IsSubmitting ? "Adding..." : "Add Hazard")" 
                                  Icon="@(IsSubmitting ? "hourglass_empty" : "add")" 
                                  ButtonStyle="ButtonStyle.Success" 
                                  Click="@AddHazard" 
                                  Disabled="@(!IsFormValid || IsSubmitting)" />
                </div>
            </div>
        </div>
    </div>
}

<!-- Map Modal -->
@if (ShowMapModal)
{
    <div class="modal-overlay" style="z-index: 2000;">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <RadzenIcon Icon="map" Style="margin-right: 0.5rem;" />
                        Select Hazard Location
                    </h5>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                  Icon="close" Size="ButtonSize.Small"
                                  Click="@CloseMapSelector" />
                </div>
                <div class="modal-body p-0">
                    <!-- Map Container -->
                    <div id="hazardLocationMap" style="height: 500px; width: 100%;"></div>
                    
                    <!-- Location Controls -->
                    <div class="p-4">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="4">
                                <RadzenFormField Text="Latitude" Variant="Variant.Outlined">
                                    <RadzenNumeric @bind-Value="@SelectedLatitude" 
                                                 ReadOnly="true"
                                                 Step="0.000001M"
                                                 Format="0.000000"
                                                 Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="4">
                                <RadzenFormField Text="Longitude" Variant="Variant.Outlined">
                                    <RadzenNumeric @bind-Value="@SelectedLongitude" 
                                                 ReadOnly="true"
                                                 Step="0.000001M"
                                                 Format="0.000000"
                                                 Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="4">
                                <RadzenFormField Text="Description" Variant="Variant.Outlined">
                                    <RadzenTextBox @bind-Value="@LocationDescription" 
                                                 Placeholder="Optional description"
                                                 Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                        
                        @if (HasValidCoordinates)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Success" Size="AlertSize.Small" Variant="Variant.Flat" Class="mt-3">
                                <strong>Selected Location:</strong> @GeoLocationDisplay
                                @if (!string.IsNullOrEmpty(LocationDescription))
                                {
                                    <br><strong>Description:</strong> @LocationDescription
                                }
                            </RadzenAlert>
                        }
                        
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                        Text="Cancel" 
                                        Click="CloseMapSelector" />
                            <RadzenButton ButtonStyle="ButtonStyle.Warning" 
                                        Text="Clear Selection" 
                                        Click="ClearMapSelection" />
                            <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                        Text="Use Selected Location" 
                                        Click="UseSelectedLocation"
                                        Disabled="@(!HasValidCoordinates)" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
    padding: 1rem;
}

.modal-dialog {
    position: relative;
    margin: 0 auto;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
}

.modal-lg {
    max-width: 900px;
    width: 100%;
}

.modal-xl {
    max-width: 1200px;
    width: 100%;
}

.modal-content {
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
}

.modal-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e9ecef;
    border-radius: 0.5rem 0.5rem 0 0;
    background-color: #212e61;
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-title {
    margin: 0;
    font-weight: 600;
}

.modal-body {
    padding: 1.5rem;
}

.modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid #e9ecef;
    border-radius: 0 0 0.5rem 0.5rem;
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
}

#hazardLocationMap {
    cursor: crosshair;
}
</style>

<!-- Leaflet.js CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" 
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<!-- Leaflet.js JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" 
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
window.initializeHazardLocationMap = function(mapElementId, dotNetHelper, centerLat, centerLng, zoom) {
    if (typeof L === 'undefined') {
        console.error('Leaflet is not loaded');
        return;
    }

    // Remove existing map if it exists
    const mapContainer = document.getElementById(mapElementId);
    if (mapContainer._leaflet_id) {
        mapContainer._leaflet_map.remove();
    }

    // Create map
    const map = L.map(mapElementId).setView([centerLat, centerLng], zoom);
    mapContainer._leaflet_map = map;

    // Add tile layer
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    let marker = null;

    // Handle map clicks
    map.on('click', function(e) {
        const lat = e.latlng.lat;
        const lng = e.latlng.lng;

        // Remove existing marker
        if (marker) {
            map.removeLayer(marker);
        }

        // Add new marker
        marker = L.marker([lat, lng]).addTo(map);

        // Notify Blazor component
        dotNetHelper.invokeMethodAsync('OnLocationSelectedFromMap', lat, lng);
    });
};
</script>