@using Radzen
@using Radzen.Blazor

<RadzenStack Gap="1rem">
    <div style="background-color: #212e61 !important; color: white; padding: 1rem 1.25rem; margin: -1rem -1rem 0 -1rem; border-radius: 8px 8px 0 0;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <i class="@GetHeaderIcon()" style="font-size: 1.25rem; opacity: 0.9;"></i>
            <div>
                <h5 style="margin: 0; font-weight: 600; font-size: 1.1rem;">
                    @GetHeaderText()
                </h5>
            </div>
        </div>
    </div>

    <RadzenFormField Text="Rationale" Variant="Variant.Outlined" AllowFloatingLabel="@IsReadOnly">
        <RadzenTextArea Value="@CurrentRationale"
                        ValueChanged="@OnRationaleChanged"
                        ReadOnly="@IsReadOnly"
                        Rows="@(IsReadOnly ? 4 : 6)"
                        Style="@GetTextAreaStyle()"
                        Placeholder="@(IsReadOnly ? string.Empty : "Enter your rationale for this risk assessment score...")" />
    </RadzenFormField>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        @if (IsReadOnly)
        {
            <RadzenButton Text="Close"
                          Icon="close"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@HandleClose" />
        }
        else
        {
            <RadzenButton Text="Cancel"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@HandleCancel" />

            <RadzenButton Text="Submit Score"
                          Icon="save"
                          ButtonStyle="ButtonStyle.Success"
                          Click="@HandleSubmit"
                          Disabled="@string.IsNullOrWhiteSpace(CurrentRationale)" />
        }
    </RadzenStack>
</RadzenStack>

