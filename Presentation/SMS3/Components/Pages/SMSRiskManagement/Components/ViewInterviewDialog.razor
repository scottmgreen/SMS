@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using Radzen
@using Radzen.Blazor

<div class="modal-overlay" @onclick:stopPropagation="true">
    <div class="sms-modal-dialog sms-modal-xxl" @onclick:stopPropagation="true">
        <div class="sms-modal-content">
            
            <!-- Modal Header -->
            <div class="sms-modal-header sms-header-primary">
                <h4 class="sms-modal-title">
                    <RadzenIcon Icon="visibility" Style="margin-right: 0.5rem;" />
                    Interview Details: @(Interview?.PersonInterviewed ?? "Unknown Person")
                    @if (Interview?.IsConfidential == true)
                    {
                        <RadzenBadge Text="CONFIDENTIAL" BadgeStyle="BadgeStyle.Warning" Style="margin-left: 0.5rem;" />
                    }
                </h4>
            </div>

            <!-- Modal Body -->
            <div class="sms-modal-body" style="padding: 1.5rem;">
                @if (Interview != null)
                {
                    <RadzenStack Gap="1.5rem">
                        
                        <!-- Status and Type Badges -->
                        <div class="d-flex justify-content-start gap-2 flex-wrap">
                            <RadzenBadge Text="@Interview.Status.Name" BadgeStyle="@GetStatusBadge()" IsPill="true" />
                            <RadzenBadge Text="@Interview.Type.Name" BadgeStyle="BadgeStyle.Info" IsPill="true" />
                            @if (Interview.IsConfidential)
                            {
                                <RadzenBadge Text="Confidential" BadgeStyle="BadgeStyle.Warning" IsPill="true" />
                            }
                        </div>

                        <!-- Interview Information -->
                        <RadzenCard Variant="Variant.Outlined" Style="border: 1px solid #e9ecef;">
                            <RadzenFieldset Text="Interview Information">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <div class="info-item">
                                            <RadzenText TextStyle="TextStyle.Overline" Text="PERSON INTERVIEWED" />
                                            <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 500;">@Interview.PersonInterviewed</RadzenText>
                                        </div>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <div class="info-item">
                                            <RadzenText TextStyle="TextStyle.Overline" Text="ROLE/POSITION" />
                                            <RadzenText TextStyle="TextStyle.Body1">@(Interview.PersonInterviewedRole ?? "Not specified")</RadzenText>
                                        </div>
                                    </RadzenColumn>
                                </RadzenRow>
                                <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <div class="info-item">
                                            <RadzenText TextStyle="TextStyle.Overline" Text="DEPARTMENT" />
                                            <RadzenText TextStyle="TextStyle.Body1">@(Interview.PersonInterviewedDepartment ?? "Not specified")</RadzenText>
                                        </div>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <div class="info-item">
                                            <RadzenText TextStyle="TextStyle.Overline" Text="INTERVIEW TYPE" />
                                            <RadzenText TextStyle="TextStyle.Body1">@Interview.Type.Name</RadzenText>
                                        </div>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenFieldset>
                        </RadzenCard>

                        @if (Interview.InterviewDate.HasValue)
                        {
                            <!-- Schedule Information -->
                            <RadzenCard Variant="Variant.Outlined" Style="border: 1px solid #e9ecef;">
                                <RadzenFieldset Text="Schedule Information">
                                    <RadzenRow Gap="1rem">
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <div class="info-item">
                                                <RadzenText TextStyle="TextStyle.Overline" Text="DATE & TIME" />
                                                <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 500;">@Interview.InterviewDate.Value.ToString("MMM dd, yyyy 'at' h:mm tt")</RadzenText>
                                            </div>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <div class="info-item">
                                                <RadzenText TextStyle="TextStyle.Overline" Text="LOCATION" />
                                                <RadzenText TextStyle="TextStyle.Body1">@(Interview.InterviewLocation ?? "Not specified")</RadzenText>
                                            </div>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    @if (Interview.DurationMinutes.HasValue)
                                    {
                                        <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                            <RadzenColumn Size="12" SizeMD="6">
                                                <div class="info-item">
                                                    <RadzenText TextStyle="TextStyle.Overline" Text="DURATION" />
                                                    <RadzenText TextStyle="TextStyle.Body1">@Interview.DurationMinutes.Value minutes</RadzenText>
                                                </div>
                                            </RadzenColumn>
                                            @if (Interview.CompletedDate.HasValue)
                                            {
                                                <RadzenColumn Size="12" SizeMD="6">
                                                    <div class="info-item">
                                                        <RadzenText TextStyle="TextStyle.Overline" Text="COMPLETED" />
                                                        <RadzenText TextStyle="TextStyle.Body1">@Interview.CompletedDate.Value.ToString("MMM dd, yyyy 'at' h:mm tt")</RadzenText>
                                                    </div>
                                                </RadzenColumn>
                                            }
                                        </RadzenRow>
                                    }
                                </RadzenFieldset>
                            </RadzenCard>
                        }

                        <!-- Preparation Notes -->
                        @if (!string.IsNullOrEmpty(Interview.PreparationNotes))
                        {
                            <RadzenCard Variant="Variant.Outlined" Style="border: 1px solid #e9ecef;">
                                <RadzenFieldset Text="Preparation Notes">
                                    <div class="notes-content">
                                        <RadzenText TextStyle="TextStyle.Body1">@Interview.PreparationNotes</RadzenText>
                                    </div>
                                </RadzenFieldset>
                            </RadzenCard>
                        }

                        <!-- Questions to Ask -->
                        @if (!string.IsNullOrEmpty(Interview.QuestionsToAsk))
                        {
                            <RadzenCard Variant="Variant.Outlined" Style="border: 1px solid #e9ecef;">
                                <RadzenFieldset Text="Questions to Ask">
                                    <div class="notes-content">
                                        <RadzenText TextStyle="TextStyle.Body1">@Interview.QuestionsToAsk</RadzenText>
                                    </div>
                                </RadzenFieldset>
                            </RadzenCard>
                        }

                        <!-- Background Information -->
                        @if (!string.IsNullOrEmpty(Interview.BackgroundInformation))
                        {
                            <RadzenCard Variant="Variant.Outlined" Style="border: 1px solid #e9ecef;">
                                <RadzenFieldset Text="Background Information">
                                    <div class="notes-content">
                                        <RadzenText TextStyle="TextStyle.Body1">@Interview.BackgroundInformation</RadzenText>
                                    </div>
                                </RadzenFieldset>
                            </RadzenCard>
                        }

                        <!-- Interview Notes -->
                        @if (!string.IsNullOrEmpty(Interview.PersonInterviewedNotes) || !string.IsNullOrEmpty(Interview.InvestigatorNotes))
                        {
                            <RadzenCard Variant="Variant.Outlined" Style="border: 1px solid #e9ecef;">
                                <RadzenFieldset Text="Interview Notes">
                                    @if (!string.IsNullOrEmpty(Interview.PersonInterviewedNotes))
                                    {
                                        <div class="info-item" style="margin-bottom: 1rem;">
                                            <RadzenText TextStyle="TextStyle.Overline" Text="INTERVIEWEE NOTES" />
                                            <div class="notes-content">
                                                <RadzenText TextStyle="TextStyle.Body1">@Interview.PersonInterviewedNotes</RadzenText>
                                            </div>
                                        </div>
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(Interview.InvestigatorNotes))
                                    {
                                        <div class="info-item">
                                            <RadzenText TextStyle="TextStyle.Overline" Text="INVESTIGATOR NOTES" />
                                            <div class="notes-content">
                                                <RadzenText TextStyle="TextStyle.Body1">@Interview.InvestigatorNotes</RadzenText>
                                            </div>
                                        </div>
                                    }
                                </RadzenFieldset>
                            </RadzenCard>
                        }

                        <!-- Key Findings -->
                        @if (!string.IsNullOrEmpty(Interview.KeyFindings))
                        {
                            <RadzenCard Variant="Variant.Outlined" Style="border: 1px solid #e9ecef; border-left: 4px solid #28a745;">
                                <RadzenFieldset Text="Key Findings">
                                    <div class="notes-content">
                                        <RadzenText TextStyle="TextStyle.Body1">@Interview.KeyFindings</RadzenText>
                                    </div>
                                </RadzenFieldset>
                            </RadzenCard>
                        }

                        <!-- Follow-up Required -->
                        @if (!string.IsNullOrEmpty(Interview.FollowUpRequired))
                        {
                            <RadzenCard Variant="Variant.Outlined" Style="border: 1px solid #e9ecef; border-left: 4px solid #ffc107;">
                                <RadzenFieldset Text="Follow-up Required">
                                    <div class="notes-content">
                                        <RadzenText TextStyle="TextStyle.Body1">@Interview.FollowUpRequired</RadzenText>
                                    </div>
                                </RadzenFieldset>
                            </RadzenCard>
                        }

                        <!-- Additional Witnesses -->
                        @if (!string.IsNullOrEmpty(Interview.AdditionalWitnesses))
                        {
                            <RadzenCard Variant="Variant.Outlined" Style="border: 1px solid #e9ecef; border-left: 4px solid #17a2b8;">
                                <RadzenFieldset Text="Additional Witnesses Mentioned">
                                    <div class="notes-content">
                                        <RadzenText TextStyle="TextStyle.Body1">@Interview.AdditionalWitnesses</RadzenText>
                                    </div>
                                </RadzenFieldset>
                            </RadzenCard>
                        }

                    </RadzenStack>
                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Icon="warning" Title="Interview Not Found">
                        The interview details could not be loaded.
                    </RadzenAlert>
                }
            </div>

            <!-- Modal Footer -->
            <div class="sms-modal-footer">
                <div class="d-flex justify-content-end gap-2">
                    <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                Text="Close" 
                                Icon="close"
                                Click="@(() => DialogService.Close())"
                                Size="ButtonSize.Medium" />
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Modal Styles - Same as other dialogs */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 1rem;
    }

    .sms-modal-dialog {
        position: relative;
        margin: 0 auto;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
    }

    .sms-modal-xxl {
        max-width: 1400px;
        width: 95%;
    }

    .sms-modal-content {
        background: white;
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    }

    .sms-modal-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e9ecef;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .sms-header-primary {
        background-color: #212e61; /* SMS Blue Dark Bold */
        color: white;
    }

    .sms-modal-title {
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
    }

    .sms-modal-body {
        max-height: calc(100vh - 200px);
        overflow-y: auto;
    }

    .sms-modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid #e9ecef;
        border-radius: 0 0 0.5rem 0.5rem;
        background-color: #f8f9fa;
    }

    /* Content Styling */
    .info-item {
        margin-bottom: 0.75rem;
    }

    .info-item:last-child {
        margin-bottom: 0;
    }

    .notes-content {
        background-color: #f8f9fa;
        padding: 0.75rem;
        border-radius: 0.375rem;
        border: 1px solid #e9ecef;
        margin-top: 0.5rem;
        white-space: pre-wrap;
        word-wrap: break-word;
    }
</style>