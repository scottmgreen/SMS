@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using Radzen
@using Radzen.Blazor

<div class="modal-overlay" @onclick:stopPropagation="true">
    <div class="sms-modal-dialog sms-modal-xl" @onclick:stopPropagation="true">
        <div class="sms-modal-content">

            <!-- Modal Header -->
            <div class="sms-modal-header sms-header-primary">
                <h4 class="sms-modal-title">
                    <RadzenIcon Icon="visibility" Style="margin-right: 0.5rem;" />
                    View Interview: @(Interview?.PersonInterviewed ?? "Unknown Person")
                    @if (Interview?.IsConfidential == true)
                    {
                        <RadzenBadge Text="CONFIDENTIAL" BadgeStyle="BadgeStyle.Warning" Style="margin-left: 0.5rem;" />
                    }
                </h4>
            </div>

            <!-- Modal Body -->
            <div class="sms-modal-body">
                @if (Interview is not null)
                {
                    <RadzenStack Gap="0.75rem">

                        <!-- Interview Status Display -->
                        <RadzenCard Variant="Variant.Outlined" Style="background-color: var(--rz-base-50); padding: 0.75rem;">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                                    <RadzenBadge Text="@Interview.Status.Name" BadgeStyle="@GetStatusBadgeStyle()" />
                                    <RadzenText TextStyle="TextStyle.Caption">
                                        Scheduled For: @(Interview.InterviewDate?.ToString("MMM dd, yyyy HH:mm") ?? "Not Scheduled")
                                    </RadzenText>
                                    @if (Interview.DurationMinutes.HasValue)
                                    {
                                        <RadzenText TextStyle="TextStyle.Caption">
                                            Duration: @Interview.DurationMinutes min
                                        </RadzenText>
                                    }
                                </RadzenStack>
                                @if (Interview.CompletedDate.HasValue)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-success);">
                                        <RadzenIcon Icon="check_circle" Style="margin-right: 0.25rem;" />
                                        Completed: @Interview.CompletedDate.Value.ToString("MMM dd, yyyy HH:mm")
                                    </RadzenText>
                                }
                            </RadzenStack>
                        </RadzenCard>

                        <!-- Tabbed Layout (Same as Edit Dialog but Read-Only) -->
                        <RadzenTabs RenderMode="TabRenderMode.Client" Style="min-height: 400px;">
                            <Tabs>
                                <!-- Basic Information Tab -->
                                <RadzenTabsItem Text="Basic Info" Icon="person">
                                    <RadzenFieldset Text="Interview Details">
                                        <RadzenRow Gap="1rem">
                                            <RadzenColumn Size="4" SizeMD="4">
                                                <RadzenFormField Text="Person Interviewed" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                    <RadzenTextBox Value="@Interview.PersonInterviewed"
                                                                   ReadOnly="true"
                                                                   Style="width: 100%; background-color: #f8f9fa;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="4" SizeMD="4">
                                                <RadzenFormField Text="Role/Position" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                    <RadzenTextBox Value="@(Interview.PersonInterviewedRole ?? "Not specified")"
                                                                   ReadOnly="true"
                                                                   Style="width: 100%; background-color: #f8f9fa;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="4">
                                                <RadzenFormField Text="Department" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                    <RadzenTextBox Value="@(Interview.PersonInterviewedDepartment ?? "Not specified")"
                                                                   ReadOnly="true"
                                                                   Style="width: 100%; background-color: #f8f9fa;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </RadzenFieldset>

                                    <RadzenFieldset Text="Interview Schedule">
                                        <RadzenRow Gap="1rem">
                                            <RadzenColumn Size="3">
                                                <RadzenFormField Text="Interview Type" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                    <RadzenTextBox Value="@(Interview.Type?.Name ?? "Not specified")"
                                                                   ReadOnly="true"
                                                                   Style="width: 100%; background-color: #f8f9fa;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="3" SizeMD="3">
                                                <RadzenFormField Text="Interview Date & Time" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                    <RadzenTextBox Value="@(Interview.InterviewDate?.ToString("MM/dd/yyyy HH:mm") ?? "Not scheduled")"
                                                                   ReadOnly="true"
                                                                   Style="width: 100%; background-color: #f8f9fa;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                            <RadzenColumn Size="6" SizeMD="6">
                                                <RadzenFormField Text="Location" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                    <RadzenTextBox Value="@(Interview.InterviewLocation ?? "Not specified")"
                                                                   ReadOnly="true"
                                                                   Style="width: 100%; background-color: #f8f9fa;" />
                                                </RadzenFormField>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </RadzenFieldset>
                                </RadzenTabsItem>

                                <!-- Preparation Tab -->
                                <RadzenTabsItem Text="Preparation" Icon="edit_note">
                                    <RadzenFieldset Text="Interview Preparation">
                                        <RadzenRow Gap="1rem">
                                            <RadzenFormField Text="Preparation Notes" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                <RadzenTextArea Value="@(Interview.PreparationNotes ?? "No preparation notes")"
                                                                ReadOnly="true"
                                                                Rows="3"
                                                                Style="width: 100%; background-color: #f8f9fa;" />
                                            </RadzenFormField>

                                            <RadzenFormField Text="Questions to Ask" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                <RadzenTextArea Value="@(Interview.QuestionsToAsk ?? "No questions specified")"
                                                                ReadOnly="true"
                                                                Rows="3"
                                                                Style="width: 100%; background-color: #f8f9fa;" />
                                            </RadzenFormField>

                                            <RadzenFormField Text="Background Information" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                <RadzenTextArea Value="@(Interview.BackgroundInformation ?? "No background information")"
                                                                ReadOnly="true"
                                                                Rows="3"
                                                                Style="width: 100%; background-color: #f8f9fa;" />
                                            </RadzenFormField>
                                        </RadzenRow>
                                    </RadzenFieldset>
                                </RadzenTabsItem>

                                <!-- Interview Results Tab -->
                                <RadzenTabsItem Text="Interview Results" Icon="record_voice_over">
                                    <RadzenStack Gap="0.75rem" Style="padding: 1rem;">
                                        @if (Interview.Status.Value == "COMPLETED" || Interview.Status.Value == "IN_PROGRESS")
                                        {
                                            <!-- Interview Notes Side by Side -->
                                            <RadzenRow Gap="0.75rem">
                                                <RadzenColumn Size="6">
                                                    <RadzenFormField Text="Interviewee Notes/Responses" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                        <RadzenTextArea Value="@(Interview.PersonInterviewedNotes ?? "No interviewee notes recorded")"
                                                                        ReadOnly="true"
                                                                        Rows="6"
                                                                        Style="width: 100%; background-color: #f8f9fa;" />
                                                    </RadzenFormField>
                                                </RadzenColumn>
                                                <RadzenColumn Size="6">
                                                    <RadzenFormField Text="Investigator Observations" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                        <RadzenTextArea Value="@(Interview.InvestigatorNotes ?? "No investigator observations recorded")"
                                                                        ReadOnly="true"
                                                                        Rows="6"
                                                                        Style="width: 100%; background-color: #f8f9fa;" />
                                                    </RadzenFormField>
                                                </RadzenColumn>
                                            </RadzenRow>

                                            <!-- Key Findings -->
                                            <RadzenFormField Text="Key Findings" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                <RadzenTextArea Value="@(Interview.KeyFindings ?? "No key findings recorded")"
                                                                ReadOnly="true"
                                                                Rows="3"
                                                                Style="width: 100%; background-color: #f8f9fa;" />
                                            </RadzenFormField>

                                            <!-- Follow-up and Witnesses -->
                                            <RadzenRow Gap="0.75rem">
                                                <RadzenColumn Size="6">
                                                    <RadzenFormField Text="Follow-Up Required" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                        <RadzenTextArea Value="@(Interview.FollowUpRequired ?? "No follow-up required")"
                                                                        ReadOnly="true"
                                                                        Rows="2"
                                                                        Style="width: 100%; background-color: #f8f9fa;" />
                                                    </RadzenFormField>
                                                </RadzenColumn>
                                                <RadzenColumn Size="6">
                                                    <RadzenFormField Text="Additional Witnesses Mentioned" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                                        <RadzenTextArea Value="@(Interview.AdditionalWitnesses ?? "No additional witnesses mentioned")"
                                                                        ReadOnly="true"
                                                                        Rows="2"
                                                                        Style="width: 100%; background-color: #f8f9fa;" />
                                                    </RadzenFormField>
                                                </RadzenColumn>
                                            </RadzenRow>
                                        }
                                        else
                                        {
                                            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
                                                <RadzenText TextStyle="TextStyle.H6">Interview Not Yet Conducted</RadzenText>
                                                <RadzenText>This interview has not been started yet. Interview results will be available after the interview is conducted.</RadzenText>
                                            </RadzenAlert>
                                        }
                                    </RadzenStack>
                                </RadzenTabsItem>
                            </Tabs>
                        </RadzenTabs>

                    </RadzenStack>
                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Icon="warning" Title="Interview Not Found">
                        The interview details could not be loaded.
                    </RadzenAlert>
                }
            </div>

            <!-- Modal Footer -->
            <div class="sms-modal-footer">
                <div class="d-flex justify-content-end gap-2">
                    <RadzenButton ButtonStyle="ButtonStyle.Secondary"
                                  Text="Close"
                                  Icon="close"
                                  Click="@(() => DialogService.Close())"
                                  Size="ButtonSize.Medium" />
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Compact Modal Styles - Same as Edit Dialog */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 1rem;
    }

    .sms-modal-dialog {
        position: relative;
        margin: 0 auto;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
    }

    .sms-modal-xl {
        max-width: 1200px;
        width: 90%;
    }

    .sms-modal-content {
        background: white;
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    }

    .sms-modal-header {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #e9ecef;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .sms-header-primary {
        background-color: #212e61;
        color: white;
    }

    .sms-modal-title {
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
    }

    .sms-modal-body {
        padding: 1rem;
        max-height: calc(100vh - 200px);
        overflow-y: auto;
    }

    .sms-modal-footer {
        padding: 0.75rem 1rem;
        border-top: 1px solid #e9ecef;
        border-radius: 0 0 0.5rem 0.5rem;
        background-color: #f8f9fa;
    }

    /* Compact form spacing */
    :deep .rz-formfield {
        margin-bottom: 0;
    }

    :deep .rz-textarea, :deep .rz-textbox, :deep .rz-dropdown {
        font-size: 0.875rem;
    }

    :deep .rz-tabs .rz-tabs-nav {
        border-bottom: 1px solid #e9ecef;
    }

    :deep .rz-tabs .rz-tabview-panel {
        padding: 0;
        border: none;
    }

    /* Read-only field styling */
    :deep .rz-textbox[readonly], :deep .rz-textarea[readonly] {
        background-color: #f8f9fa !important;
        border-color: #e9ecef !important;
        color: #495057 !important;
    }
</style>

@code {
    // [Parameter] public Interview Interview { get; set; } = default!;
    // [Inject] private DialogService DialogService { get; set; } = default!;

    private BadgeStyle GetStatusBadgeStyle()
    {
        return Interview?.Status?.Value switch
        {
            "SCHEDULED" => BadgeStyle.Info,
            "IN_PROGRESS" => BadgeStyle.Warning,
            "COMPLETED" => BadgeStyle.Success,
            "CANCELLED" => BadgeStyle.Danger,
            _ => BadgeStyle.Light
        };
    }
}