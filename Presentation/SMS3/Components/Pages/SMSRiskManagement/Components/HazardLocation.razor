@using SMS_Domain.Entities
@inject DialogService DialogService
@inject NotificationService NotificationService

<!-- Enhanced Hazard Location Selection Component with Map Support -->
<div class="hazard-location-container">
    @if (ShowLocationPanel)
    {
        <RadzenCard Variant="Variant.Outlined" Class="mt-3">
            <RadzenStack Gap="1rem">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <RadzenIcon Icon="map" Style="color: var(--rz-primary); font-size: 1.5rem;" />
                        <h5 class="mb-0">Select Hazard Location</h5>
                    </div>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                Variant="Variant.Text"
                                Icon="close"
                                Size="ButtonSize.Small"
                                Click="CloseLocationPanel"
                                title="Close location selector" />
                </div>

                <!-- Location Selection Methods -->
                <RadzenCard Variant="Variant.Text">
                    <RadzenRadioButtonList @bind-Value="LocationSelectionMode" 
                                         TValue="string" 
                                         Orientation="Orientation.Horizontal"
                                         Change="OnLocationModeChanged">
                        <Items>
                            <RadzenRadioButtonListItem Text="Interactive Map" Value="@("map")" />
                            <RadzenRadioButtonListItem Text="Current Location" Value="@("current")" />
                            <RadzenRadioButtonListItem Text="Enter Coordinates" Value="@("coordinates")" />
                            <RadzenRadioButtonListItem Text="Text Description" Value="@("description")" />
                        </Items>
                    </RadzenRadioButtonList>
                </RadzenCard>

                @if (LocationSelectionMode == "map")
                {
                    <!-- Google Map Integration -->
                    <RadzenCard>
                        <RadzenStack Gap="1rem">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">Click on the map to select location</h6>
                                <RadzenBadge Text="@($"Zoom: {CurrentZoom}")" BadgeStyle="BadgeStyle.Info" />
                            </div>
                            
                            <!-- Map Container -->
                            <div style="height: 400px; border: 1px solid #ddd; border-radius: 4px;" class="map-container">
                                @if (string.IsNullOrEmpty(GoogleMapsApiKey) || GoogleMapsApiKey == "YOUR_GOOGLE_MAPS_API_KEY")
                                {
                                    <!-- Fallback Map Placeholder -->
                                    <div class="d-flex align-items-center justify-content-center h-100 bg-light">
                                        <RadzenStack Gap="1rem" Class="text-center">
                                            <RadzenIcon Icon="map" Style="font-size: 4rem; color: #6c757d;" />
                                            <div>
                                                <h6>Google Maps Integration</h6>
                                                <p class="text-muted mb-0">Google Maps API key required for interactive map</p>
                                                <small class="text-muted">Click coordinates below to simulate map selection</small>
                                            </div>
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.Center">
                                                <RadzenButton Text="PDX Terminal" Size="ButtonSize.Small" 
                                                            Click="@(() => SimulateMapClick(45.5898, -122.5951, "PDX Terminal Area"))" />
                                                <RadzenButton Text="Runway Area" Size="ButtonSize.Small" 
                                                            Click="@(() => SimulateMapClick(45.5895, -122.6015, "Runway 28L/10R Area"))" />
                                                <RadzenButton Text="Cargo Area" Size="ButtonSize.Small" 
                                                            Click="@(() => SimulateMapClick(45.5901, -122.5980, "Cargo Operations Area"))" />
                                            </RadzenStack>
                                        </RadzenStack>
                                    </div>
                                }
                                else
                                {
                                    <RadzenGoogleMap @bind-Zoom="CurrentZoom" 
                                                   @bind-Center="MapCenter" 
                                                   Style="height: 100%; width: 100%;"
                                                   MapClick="OnMapClick"
                                                   ApiKey="@GoogleMapsApiKey">
                                        @if (MapMarkers.Any())
                                        {
                                            @foreach (var marker in MapMarkers)
                                            {
                                                <RadzenGoogleMapMarker Position="marker.Position" 
                                                                     Title="@marker.Title"
                                                                     OnClick="@(() => OnMarkerClick(marker))" />
                                            }
                                        }
                                    </RadzenGoogleMap>
                                }
                            </div>

                            <!-- Map Instructions -->
                            <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small">
                                <strong>Instructions:</strong> Click anywhere on the map to place a location marker. The red marker shows your selected hazard location.
                            </RadzenAlert>
                        </RadzenStack>
                    </RadzenCard>
                }
                else if (LocationSelectionMode == "current")
                {
                    <!-- Current Location -->
                    <RadzenCard>
                        <RadzenStack Gap="1rem">
                            <div class="d-flex align-items-center gap-2">
                                <RadzenIcon Icon="my_location" Style="color: var(--rz-primary);" />
                                <h6 class="mb-0">Use Current GPS Location</h6>
                            </div>
                            <p class="text-muted mb-2">Click the button below to automatically detect your current location using GPS.</p>
                            <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                        Icon="gps_fixed"
                                        Text="@(IsGettingLocation ? "Getting Location..." : "Get Current Location")"
                                        Click="GetCurrentLocation"
                                        Disabled="@IsGettingLocation" />
                        </RadzenStack>
                    </RadzenCard>
                }
                else if (LocationSelectionMode == "coordinates")
                {
                    <!-- Manual Coordinates Entry -->
                    <RadzenCard>
                        <RadzenStack Gap="1rem">
                            <h6>Enter Coordinates Manually</h6>
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Latitude" Variant="Variant.Outlined">
                                        <RadzenNumeric @bind-Value="@ManualLatitude" 
                                                     Step="0.000001M"
                                                     Min="-90M"
                                                     Max="90M"
                                                     Placeholder="45.589800"
                                                     Style="width: 100%;" />
                                    </RadzenFormField>
                                    <small class="text-muted">Valid range: -90 to 90</small>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenFormField Text="Longitude" Variant="Variant.Outlined">
                                        <RadzenNumeric @bind-Value="@ManualLongitude" 
                                                     Step="0.000001M"
                                                     Min="-180M"
                                                     Max="180M"
                                                     Placeholder="-122.595100"
                                                     Style="width: 100%;" />
                                    </RadzenFormField>
                                    <small class="text-muted">Valid range: -180 to 180</small>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenFormField Text="Location Description (Optional)" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="@ManualDescription" 
                                             Placeholder="Describe the specific location (e.g., 'Terminal A, Gate 5')..."
                                             Style="width: 100%;" />
                            </RadzenFormField>
                            <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                        Icon="check"
                                        Text="Use These Coordinates"
                                        Click="UseManualCoordinates"
                                        Disabled="@(!HasValidManualCoordinates)" />
                        </RadzenStack>
                    </RadzenCard>
                }
                else if (LocationSelectionMode == "description")
                {
                    <!-- Text Description Only -->
                    <RadzenCard>
                        <RadzenStack Gap="1rem">
                            <h6>Describe Location</h6>
                            <RadzenFormField Text="Location Description" Variant="Variant.Outlined">
                                <RadzenTextArea @bind-Value="@LocationDescription" 
                                              Rows="4"
                                              Placeholder="Provide a detailed description of where the hazard occurred:&#10;&#10;Examples:&#10;• Terminal A, Gate 5, near security checkpoint&#10;• Runway 28L, approximately 2000ft from threshold&#10;• Maintenance hangar, east side, near equipment storage&#10;• Baggage claim area, carousel #3"
                                              Style="width: 100%;" />
                            </RadzenFormField>
                            <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                        Icon="check"
                                        Text="Use Description"
                                        Click="UseLocationDescription"
                                        Disabled="@(string.IsNullOrWhiteSpace(LocationDescription))" />
                        </RadzenStack>
                    </RadzenCard>
                }

                <!-- Current Selection Display -->
                @if (HasSelectedLocation)
                {
                    <RadzenCard Variant="Variant.Outlined" Style="border-left: 4px solid var(--rz-success);">
                        <RadzenStack Gap="1rem">
                            <div class="d-flex align-items-center gap-2">
                                <RadzenIcon Icon="location_on" Style="color: var(--rz-success); font-size: 1.5rem;" />
                                <h6 class="mb-0 text-success">Selected Location</h6>
                            </div>
                            @if (SelectedLocation.Latitude != 0 && SelectedLocation.Longitude != 0)
                            {
                                <p class="mb-1"><strong>Coordinates:</strong> @SelectedLocation.Latitude.ToString("F6"), @SelectedLocation.Longitude.ToString("F6")</p>
                            }
                            @if (!string.IsNullOrEmpty(SelectedLocation.Description))
                            {
                                <p class="mb-1"><strong>Description:</strong> @SelectedLocation.Description</p>
                            }
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                            Icon="save"
                                            Text="Confirm This Location"
                                            Click="ConfirmLocation" />
                                <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                            Icon="edit"
                                            Text="Modify"
                                            Click="() => {}" />
                                <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                            Icon="clear"
                                            Text="Clear"
                                            Click="ClearSelection" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                }
            </RadzenStack>
        </RadzenCard>
    }
</div>

<style>
    .hazard-location-container {
        width: 100%;
    }
    
    .rz-googlemap {
        border-radius: 4px;
    }
</style>

@code {
    [Parameter] public EventCallback<SMS3.Components.Pages.SMSRiskManagement.Components.GeoLocationData> OnLocationSelected { get; set; }
    [Parameter] public SMS3.Components.Pages.SMSRiskManagement.Components.GeoLocationData? InitialLocation { get; set; }

    // UI State
    public bool ShowLocationPanel { get; set; }
    public string LocationSelectionMode { get; set; } = "map";
    public bool IsGettingLocation { get; set; }

    // Manual Entry
    public decimal ManualLatitude { get; set; }
    public decimal ManualLongitude { get; set; }
    public string ManualDescription { get; set; } = string.Empty;
    public string LocationDescription { get; set; } = string.Empty;

    // Map State
    public double CurrentZoom { get; set; } = 15;
    public Radzen.GoogleMapPosition MapCenter { get; set; } = new Radzen.GoogleMapPosition() { Lat = 45.5898, Lng = -122.5951 }; // PDX Airport
    public List<MapMarker> MapMarkers { get; set; } = new();

    // Selected Location
    public SMS3.Components.Pages.SMSRiskManagement.Components.GeoLocationData SelectedLocation { get; set; } = new();

    // Configuration
    public string GoogleMapsApiKey => "YOUR_GOOGLE_MAPS_API_KEY"; // TODO: Move to configuration

    // Computed Properties
    public bool HasValidManualCoordinates => ManualLatitude != 0 && ManualLongitude != 0 && 
                                           ManualLatitude >= -90 && ManualLatitude <= 90 &&
                                           ManualLongitude >= -180 && ManualLongitude <= 180;

    public bool HasSelectedLocation => SelectedLocation.IsValid || !string.IsNullOrEmpty(SelectedLocation.Description);

    protected override Task OnInitializedAsync()
    {
        if (InitialLocation != null)
        {
            SelectedLocation = InitialLocation;
            // Update map center if we have coordinates
            if (InitialLocation.Latitude != 0 && InitialLocation.Longitude != 0)
            {
                MapCenter = new Radzen.GoogleMapPosition() { Lat = (double)InitialLocation.Latitude, Lng = (double)InitialLocation.Longitude };
                MapMarkers.Add(new MapMarker 
                { 
                    Position = MapCenter, 
                    Title = "Hazard Location",
                    Description = InitialLocation.Description ?? "Selected hazard location" 
                });
            }
        }
        return Task.CompletedTask;
    }

    public void OpenLocationPanel()
    {
        ShowLocationPanel = true;
        StateHasChanged();
    }

    public void CloseLocationPanel()
    {
        ShowLocationPanel = false;
        StateHasChanged();
    }

    public void ShowLocationSelector()
    {
        OpenLocationPanel();
    }

    private void OnLocationModeChanged(object value)
    {
        // Clear previous selections when mode changes
        ClearSelection();
        StateHasChanged();
    }

    private void OnMapClick(Radzen.GoogleMapClickEventArgs args)
    {
        try
        {
            // Clear existing markers
            MapMarkers.Clear();
            
            // Add new marker at clicked position
            var newMarker = new MapMarker
            {
                Position = args.Position,
                Title = "Hazard Location",
                Description = $"Lat: {args.Position.Lat:F6}, Lng: {args.Position.Lng:F6}"
            };
            MapMarkers.Add(newMarker);

            // Update selected location
            SelectedLocation = new SMS3.Components.Pages.SMSRiskManagement.Components.GeoLocationData
            {
                Latitude = (decimal)args.Position.Lat,
                Longitude = (decimal)args.Position.Lng,
                Description = $"Map location: {args.Position.Lat:F6}, {args.Position.Lng:F6}",
                SelectedDateTime = DateTime.UtcNow
            };

            StateHasChanged();

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Location Selected",
                Detail = $"Location set to: {args.Position.Lat:F6}, {args.Position.Lng:F6}",
                Duration = 3000
            });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Map Error",
                Detail = "Error processing map click. Please try again.",
                Duration = 3000
            });
        }
    }

    private void OnMarkerClick(MapMarker marker)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = "Marker Info",
            Detail = marker.Description ?? "Hazard location marker",
            Duration = 3000
        });
    }

    private async Task GetCurrentLocation()
    {
        try
        {
            IsGettingLocation = true;
            StateHasChanged();

            // Simulate getting current location (in real implementation, use JSInterop for geolocation)
            await Task.Delay(2000);

            // For demo, set to PDX coordinates with some randomness
            var random = new Random();
            var lat = 45.5898M + (decimal)(random.NextDouble() - 0.5) * 0.01M;
            var lng = -122.5951M + (decimal)(random.NextDouble() - 0.5) * 0.01M;

            SelectedLocation = new SMS3.Components.Pages.SMSRiskManagement.Components.GeoLocationData
            {
                Latitude = lat,
                Longitude = lng,
                Description = "Current GPS location",
                SelectedDateTime = DateTime.UtcNow
            };

            // Update map
            MapCenter = new Radzen.GoogleMapPosition() { Lat = (double)lat, Lng = (double)lng };
            MapMarkers.Clear();
            MapMarkers.Add(new MapMarker 
            { 
                Position = MapCenter, 
                Title = "Current Location",
                Description = "Your current GPS location" 
            });

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Location Found",
                Detail = "Current location has been determined.",
                Duration = 3000
            });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Location Error",
                Detail = "Could not determine current location. Please try manual entry.",
                Duration = 5000
            });
        }
        finally
        {
            IsGettingLocation = false;
            StateHasChanged();
        }
    }

    private void UseManualCoordinates()
    {
        if (!HasValidManualCoordinates) return;

        SelectedLocation = new SMS3.Components.Pages.SMSRiskManagement.Components.GeoLocationData
        {
            Latitude = ManualLatitude,
            Longitude = ManualLongitude,
            Description = string.IsNullOrEmpty(ManualDescription) ? 
                $"Manual coordinates: {ManualLatitude:F6}, {ManualLongitude:F6}" : 
                ManualDescription,
            SelectedDateTime = DateTime.UtcNow
        };

        // Update map
        MapCenter = new Radzen.GoogleMapPosition() { Lat = (double)ManualLatitude, Lng = (double)ManualLongitude };
        MapMarkers.Clear();
        MapMarkers.Add(new MapMarker 
        { 
            Position = MapCenter, 
            Title = "Manual Location",
            Description = SelectedLocation.Description 
        });

        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Coordinates Set",
            Detail = "Manual coordinates have been set.",
            Duration = 3000
        });

        StateHasChanged();
    }

    private void UseLocationDescription()
    {
        if (string.IsNullOrWhiteSpace(LocationDescription)) return;

        SelectedLocation = new SMS3.Components.Pages.SMSRiskManagement.Components.GeoLocationData
        {
            Latitude = 0, // No coordinates, description only
            Longitude = 0,
            Description = LocationDescription.Trim(),
            SelectedDateTime = DateTime.UtcNow
        };

        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Description Set",
            Detail = "Location description has been set.",
            Duration = 3000
        });

        StateHasChanged();
    }

    private async Task ConfirmLocation()
    {
        if (!HasSelectedLocation) return;

        if (OnLocationSelected.HasDelegate)
        {
            await OnLocationSelected.InvokeAsync(SelectedLocation);
        }

        CloseLocationPanel();

        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Location Confirmed",
            Detail = "Location has been set for the hazard report.",
            Duration = 3000
        });
    }

    private void ClearSelection()
    {
        SelectedLocation = new SMS3.Components.Pages.SMSRiskManagement.Components.GeoLocationData();
        ManualLatitude = 0;
        ManualLongitude = 0;
        ManualDescription = string.Empty;
        LocationDescription = string.Empty;
        MapMarkers.Clear();
        StateHasChanged();
    }

    private void SimulateMapClick(double lat, double lng, string description)
    {
        try
        {
            // Simulate a map click with predefined coordinates
            var position = new Radzen.GoogleMapPosition { Lat = lat, Lng = lng };
            
            // Clear existing markers
            MapMarkers.Clear();
            
            // Add new marker at simulated position
            var newMarker = new MapMarker
            {
                Position = position,
                Title = "Hazard Location",
                Description = description
            };
            MapMarkers.Add(newMarker);

            // Update selected location
            SelectedLocation = new SMS3.Components.Pages.SMSRiskManagement.Components.GeoLocationData
            {
                Latitude = (decimal)lat,
                Longitude = (decimal)lng,
                Description = description,
                SelectedDateTime = DateTime.UtcNow
            };

            StateHasChanged();

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Location Selected",
                Detail = $"Location set to: {description}",
                Duration = 3000
            });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Selection Error",
                Detail = "Error setting location. Please try again.",
                Duration = 3000
            });
        }
    }

    // Supporting classes
    public class MapMarker
    {
        public Radzen.GoogleMapPosition Position { get; set; } = new();
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }

    public class GoogleMapClickEventArgs
    {
        public GoogleMapPosition Position { get; set; } = new();
    }
}