
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Pages.SMSRiskManagement
@using SMS3.Components.Pages.SMSRiskManagement.Models
@using SMS3.Components.Shared
@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using global::System.Text.Json

<RadzenRow Gap="1rem">
    <!-- Main Content Column -->
    <RadzenColumn Size="12" SizeLG="8">
        <RadzenStack Gap="1.5rem">
            <!-- System Context from Step 1 -->
            <RadzenCard Variant="Variant.Outlined" Style="border-left: 4px solid var(--rz-info);">
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H6" Style="color: #212e61; margin: 0;">
                        <RadzenIcon Icon="map" Style="margin-right: 0.5rem;" />
                        System Context (From Step 1)
                    </RadzenText>
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenText TextStyle="TextStyle.Body2">
                                <strong>Description:</strong> @Step1.SystemDescription
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">
                                <strong>Boundaries:</strong> @Step1.SystemBoundaries
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">
                                <strong>Purpose and Objectives:</strong> @Step1.SystemPurpose
                            </RadzenText>
                        </RadzenColumn>
                        @* <RadzenColumn Size="12" SizeMD="6">
                            
                        </RadzenColumn> *@
                    </RadzenRow>
                </RadzenStack>
            </RadzenCard>

            <!-- Hazards Section - Always show, even if no hazards exist -->
            <RadzenCard>
                <RadzenStack Gap="1rem">
                    <!-- Header Row with Button -->
                    <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenColumn Size="8">
                            <RadzenText TextStyle="TextStyle.H6" Style="color: #212e61; margin: 0;">
                                <RadzenIcon Icon="list" Style="margin-right: 0.5rem;" />
                                Identified Hazards
                                <RadzenBadge Text="@Step2Hazards.Count.ToString()" BadgeStyle="BadgeStyle.Light" Style="margin-left: 0.5rem;" />
                            </RadzenText>
                        </RadzenColumn>
                        <RadzenColumn Size="4" Style="text-align: right;">
                            <RadzenButton Text="Add New Hazard" Icon="add" ButtonStyle="ButtonStyle.Success"
                                          Click="@OpenAddHazardDialog" />
                        </RadzenColumn>
                    </RadzenRow>
                    
                    <!-- Content: Either Data Grid or Empty State -->
                    @if (Step2Hazards?.Any() == true)
                    {
                        <RadzenDataGrid Data="@Step2Hazards" TItem="Hazard" AllowFiltering="true" AllowPaging="true" PageSize="10">
                            <Columns>
                                <RadzenDataGridColumn TItem="Hazard" Property="Code" Title="Hazard ID" Width="125px">
                                    <Template Context="hazard">
                                        <RadzenText TextStyle="TextStyle.Caption" Text=@hazard.Code/>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Hazard" Title="Description" Width="100px" Sortable="false" Filterable="false">
                                    <Template Context="hazard">
                                        <RadzenButton Text=""
                                                      Icon="description"
                                                      ButtonStyle="ButtonStyle.Base"
                                                      Variant="Variant.Text"
                                                      Size="ButtonSize.ExtraSmall"
                                                      Title="Click to view full description"
                                                      Class="description-button"
                                                      Click="@(() => ShowDescriptionDialog(hazard))" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Hazard" Property="Category" Title="Category">
                                    <Template Context="hazard">
                                        <RadzenText TextStyle="TextStyle.Caption" Text="@(hazard.HazardCategory ?? "Not specified")"  />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Hazard" Property="Type" Title="Type">
                                    <Template Context="hazard">
                                        <RadzenText TextStyle="TextStyle.Caption" Text=@(hazard.HazardType ?? "Not specified")" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Hazard" Property="HazardLocation" Title="Location">
                                    <Template Context="hazard">
                                        @if (hazard.HazardLocation is not null && hazard.HazardLocation.Latitude.HasValue && hazard.HazardLocation.Longitude.HasValue)
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" Text="@($"{hazard.HazardLocation.Latitude.Value}, {hazard.HazardLocation.Longitude.Value}")" />
                                        }
                                        
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Hazard" Title="Actions">
                                    <Template Context="hazard">
                                        @if (hazard.IsInitialHazard)
                                        {
                                            <RadzenBadge Text="Initial Hazard" BadgeStyle="BadgeStyle.Base" />
                                        }
                                        else
                                        {
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                                <RadzenButton Text="Edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" 
                                                              Click="@(() => EditHazard(hazard))" />
                                                <RadzenButton Text="Delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" 
                                                              Click="@(() => DeleteHazard(hazard))" />
                                            </RadzenStack>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                    else
                    {
                        <!-- Empty State -->
                        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 2rem;">
                            <RadzenIcon Icon="warning" Style="font-size: 3rem; color: var(--rz-warning);" />
                            <RadzenText TextStyle="TextStyle.H6" Text="No hazards identified yet" Style="color: var(--rz-text-secondary-color);" />
                            <RadzenText TextStyle="TextStyle.Body2" Text="Click 'Add New Hazard' above to identify potential hazards in this system" Style="color: var(--rz-text-secondary-color); text-align: center;" />
                        </RadzenStack>
                    }
                </RadzenStack>
            </RadzenCard>
        </RadzenStack>
    </RadzenColumn>

    <!-- Guidance Panel -->
    <RadzenColumn Size="12" SizeLG="4">
        <TechnicalAssessmentGuidancePanel StepNumber="2" />
    </RadzenColumn>
</RadzenRow>

@if (_showDescriptionModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-md">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-file-alt"></i> Hazard Description - @_selectedHazardId
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Text"
                                      Icon="close"
                                      Size="ButtonSize.Small"
                                      Click="@CloseDescriptionModal" />
                    </div>
                </div>
                <div class="sms-modal-body">
                    <RadzenCard Variant="Variant.Outlined">
                        <div class="p-3">
                            <div style="line-height: 1.6; white-space: normal;">
                                @((MarkupString)(_selectedDescription ?? "No description available"))
                            </div>
                        </div>
                    </RadzenCard>
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end">
                        <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                      Text="Close"
                                      Icon="close"
                                      Click="@CloseDescriptionModal"
                                      Size="ButtonSize.Medium" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Add Hazard Modal -->
<AddHazardDialog IsVisible="@ShowAddHazardDialog" 
                IsVisibleChanged="@OnModalVisibilityChanged"
                OnHazardAdded="@OnHazardAdded"
                OnHazardUpdated="@OnHazardUpdated"
                ReportId="@ReportId"
                RiskAssessmentId="@RiskAssessmentId"
                EditingHazard="@EditingHazard"
                IsEditMode="@IsEditMode" />

@code {
    [Parameter] public Step1Model Step1 { get; set; } = new();
    [Parameter] public Step2Model Step2 { get; set; } = new();
    [Parameter] public EventCallback<Step2Model> Step2Changed { get; set; }
    [Parameter] public List<Hazard> Step2Hazards { get; set; } = new();
    [Parameter] public EventCallback<Hazard> OnHazardAdded { get; set; }
    [Parameter] public EventCallback<Hazard> OnHazardUpdated { get; set; }
    [Parameter] public EventCallback<Hazard> OnHazardDeleted { get; set; }
    [Parameter] public string? ReportId { get; set; }
    [Parameter] public string? InitialHazardId { get; set; }
    [Parameter] public string? RiskAssessmentId { get; set; }
    [Inject] private ILogger<TechnicalAssessmentStep2>? Logger { get; set; }

    private bool ShowAddHazardDialog { get; set; } = false;
    private bool IsEditMode { get; set; } = false; // NEW: Track if we're in edit mode
    private Hazard? EditingHazard { get; set; } = null; // NEW: Hazard being edited
    private bool _showDescriptionModal = false;
    private string _selectedDescription = string.Empty;
    private string _selectedHazardId = string.Empty;

    private void ShowDescriptionDialog(Hazard hazard)
    {
        _selectedDescription = hazard.Description ?? "No description available";
        _selectedHazardId = hazard.Code;
        _showDescriptionModal = true;
    }

    private void CloseDescriptionModal()
    {
        _showDescriptionModal = false;
        _selectedDescription = string.Empty;
        _selectedHazardId = string.Empty;
    }

    private void OpenAddHazardDialog()
    {
        IsEditMode = false;
        EditingHazard = null;
        ShowAddHazardDialog = true;
    }

    private async Task OnModalVisibilityChanged(bool isVisible)
    {
        ShowAddHazardDialog = isVisible;
        
        // Reset edit mode when dialog closes
        if (!isVisible)
        {
            IsEditMode = false;
            EditingHazard = null;
        }
        
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Determine if a hazard is the initial hazard that should not be deleted
    /// </summary>
    private bool IsInitialHazard(Hazard hazard)
    {
        // Check if this is the initial hazard based on:
        // 1. HazardId parameter match
        // 2. If it's the first/primary hazard
        // 3. If it has special indicators

        if (!string.IsNullOrEmpty(InitialHazardId) && hazard.Code == InitialHazardId)
        {
            return true;
        }

        return false;
    }

    private async Task EditHazard(Hazard hazard)
    {
        try
        {
            IsEditMode = true;
            EditingHazard = hazard;
            ShowAddHazardDialog = true;
            
            await InvokeAsync(StateHasChanged);
            
            Logger?.LogInformation("Opening edit dialog for hazard: {HazardCode}", hazard.Code);
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Error opening edit dialog for hazard: {HazardCode}", hazard.Code);
        }
    }

    private async Task DeleteHazard(Hazard hazard)
    {
        if (IsInitialHazard(hazard))
        {
            // Should not reach here due to UI logic, but safety check
            return;
        }

        try
        {
            // Invoke the parent's delete callback
            await OnHazardDeleted.InvokeAsync(hazard);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting hazard {hazard.Code}: {ex.Message}");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Force UI refresh when AvailableHazards parameter changes
        await InvokeAsync(StateHasChanged);
    }
}