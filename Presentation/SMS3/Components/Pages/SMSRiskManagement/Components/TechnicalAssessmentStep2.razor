@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using SMS3.Components.Pages.SMSRiskManagement
@using SMS3.Components.Shared
@using global::System.Text.Json
@using Radzen
@using Radzen.Blazor

<RadzenRow Gap="1rem">
    <!-- Main Content Column -->
    <RadzenColumn Size="12" SizeLG="8">
        <RadzenStack Gap="1.5rem">
            <!-- System Context from Step 1 -->
            <RadzenCard Variant="Variant.Outlined" Style="border-left: 4px solid var(--rz-info);">
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-info); margin: 0;">
                        <RadzenIcon Icon="map" Style="margin-right: 0.5rem;" />
                        System Context (From Step 1)
                    </RadzenText>
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenText TextStyle="TextStyle.Body2">
                                <strong>System:</strong> @Step1.SystemDescription
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">
                                <strong>Boundaries:</strong> @Step1.SystemBoundaries
                            </RadzenText>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenText TextStyle="TextStyle.Body2">
                                <strong>Purpose:</strong> @Step1.SystemPurpose
                            </RadzenText>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenCard>

            <!-- Existing Hazards Display -->
            @if (AvailableHazards?.Any() == true)
            {
                <RadzenCard>
                    <RadzenStack Gap="1rem">
                        <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-primary); margin: 0;">
                            <RadzenIcon Icon="list" Style="margin-right: 0.5rem;" />
                            Identified Hazards
                            <RadzenBadge Text="@AvailableHazards.Count.ToString()" BadgeStyle="BadgeStyle.Light" Style="margin-left: 0.5rem;" />
                        </RadzenText>
                        
                        <RadzenDataGrid Data="@AvailableHazards" TItem="Hazard" AllowFiltering="true" AllowPaging="true" PageSize="10">
                            <Columns>
                                <RadzenDataGridColumn TItem="Hazard" Property="Code" Title="Hazard ID">
                                    <Template Context="hazard">
                                        <RadzenBadge Text="@hazard.Code" BadgeStyle="BadgeStyle.Primary" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Hazard" Property="Description" Title="Description" />
                                <RadzenDataGridColumn TItem="Hazard" Property="Category" Title="Category">
                                    <Template Context="hazard">
                                        <RadzenBadge Text="@(hazard.Category ?? "Not specified")" BadgeStyle="BadgeStyle.Secondary" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Hazard" Title="Actions">
                                    <Template Context="hazard">
                                        <RadzenButton Text="Edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" 
                                                      Click="@(() => EditHazard(hazard))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </RadzenStack>
                </RadzenCard>
            }

            <!-- Add New Hazard Form -->
            <RadzenCard>
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-success); margin: 0;">
                        <RadzenIcon Icon="add_circle" Style="margin-right: 0.5rem;" />
                        Add New Hazard
                    </RadzenText>
                    
                    <RadzenFormField Text="Hazard Description *" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@NewHazardDescription" Rows="3" 
                                        Placeholder="Describe the hazard clearly and specifically..." Style="width: 100%;" />
                    </RadzenFormField>
                    @if (!string.IsNullOrWhiteSpace(NewHazardDescription) && NewHazardDescription.Trim().Length < 10)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger);">
                            Description must be at least 10 characters (currently @(NewHazardDescription.Trim().Length))
                        </RadzenText>
                    }
                    
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Hazard Category" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@NewHazardCategory" Data="@HazardCategories" 
                                                Placeholder="Select category..." Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="5M Framework Component" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@NewHazardFiveM" Data="@FiveMOptions" 
                                                ValueProperty="Value" TextProperty="Text"
                                                Placeholder="Select 5M component..." Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                    
                    <RadzenButton Text="Add Hazard" Icon="add" ButtonStyle="ButtonStyle.Success" 
                                  Click="@AddNewHazard" 
                                  Disabled="@(IsSaving || !IsAddHazardFormValid)" />
                </RadzenStack>
            </RadzenCard>
        </RadzenStack>
    </RadzenColumn>

    <!-- Guidance Panel -->
    <RadzenColumn Size="12" SizeLG="4">
        <TechnicalAssessmentGuidancePanel StepNumber="2" />
    </RadzenColumn>
</RadzenRow>

@code {
    [Parameter] public Step1Model Step1 { get; set; } = new();
    [Parameter] public Step2Model Step2 { get; set; } = new();
    [Parameter] public EventCallback<Step2Model> Step2Changed { get; set; }
    [Parameter] public List<Hazard> AvailableHazards { get; set; } = new();
    [Parameter] public EventCallback<Hazard> OnHazardAdded { get; set; }
    [Parameter] public EventCallback<Hazard> OnHazardUpdated { get; set; }
    [Parameter] public string? ReportId { get; set; } // Add ReportId parameter

    private bool IsSaving { get; set; } = false;

    // Simple properties for form binding
    private string NewHazardDescription { get; set; } = string.Empty;
    private string NewHazardCategory { get; set; } = string.Empty;
    private string NewHazardFiveM { get; set; } = string.Empty;

    // VALIDATION: Check if form is ready for submission
    private bool IsAddHazardFormValid => 
        !string.IsNullOrWhiteSpace(NewHazardDescription?.Trim()) && 
        NewHazardDescription.Trim().Length >= 10 &&
        !string.IsNullOrWhiteSpace(NewHazardCategory) && 
        !string.IsNullOrWhiteSpace(NewHazardFiveM);

    private List<string> HazardCategories = new()
    {
        "Aircraft Operations",
        "Ground Operations", 
        "Security Operations",
        "Weather Related",
        "Equipment Failure",
        "Human Factors",
        "Environmental",
        "Procedural",
        "Communication",
        "Infrastructure",
        "Other"
    };

    private List<FiveMOption> FiveMOptions = new()
    {
        new() { Value = "MAN", Text = "Man (Human)" },
        new() { Value = "MACHINE", Text = "Machine (Equipment)" },
        new() { Value = "METHOD", Text = "Method (Procedures)" },
        new() { Value = "MATERIAL", Text = "Material (Resources)" },
        new() { Value = "MILIEU", Text = "Milieu (Environment)" }
    };

    private async Task AddNewHazard()
    {
        if (!IsAddHazardFormValid)
            return;

        try
        {
            IsSaving = true;
            StateHasChanged();

            // Create hazard using the proper domain constructor
            HazardID hazardID = new HazardID("HZ-0000");
            Hazard hazard = new Hazard(hazardID);

            // Set all the required properties properly
            hazard.Code = "HZ-0000"; // Database will generate the actual code
            hazard.Name = NewHazardDescription.Trim(); 
            hazard.Description = NewHazardDescription.Trim();
            hazard.Category = NewHazardCategory;
            hazard.ReportCode = ReportId ?? ""; 
            hazard.ReportedBy = "Technical Assessment User"; 
            hazard.ReportingDepartment = "Technical Assessment";
            hazard.HazardType = NewHazardCategory;
            hazard.FiveMComponent = GetFiveMComponent(NewHazardFiveM);
            hazard.IsConfidential = false;
            hazard.IsAnonymous = false;
            hazard.Status = HazardStatus.Active; 
            hazard.Priority = HazardPriority.Medium; 
            hazard.ReportedOn = DateTime.UtcNow;

            // Call the parent's AddHazard method
            await OnHazardAdded.InvokeAsync(hazard);
            
            // RESET FORM IMMEDIATELY - This ensures clean state
            NewHazardDescription = string.Empty;
            NewHazardCategory = string.Empty;
            NewHazardFiveM = string.Empty;
            
            // Update Step2 model and notify parent
            await Step2Changed.InvokeAsync(Step2);
            
            // Force immediate UI refresh
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding hazard: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
            StateHasChanged();
        }
    }

    private void EditHazard(Hazard hazard)
    {
        // Simple edit - for now just log
        Console.WriteLine($"Edit hazard: {hazard.Code}");
    }

    private FiveMComponent? GetFiveMComponent(string? value)
    {
        if (string.IsNullOrEmpty(value)) return null;
        
        return value switch
        {
            "MAN" => FiveMComponent.Man,
            "MACHINE" => FiveMComponent.Machine,
            "METHOD" => FiveMComponent.Method,
            "MATERIAL" => FiveMComponent.Material,
            "MILIEU" => FiveMComponent.Milieu,
            _ => null
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        // Force UI refresh when AvailableHazards parameter changes
        await InvokeAsync(StateHasChanged);
    }

    public class FiveMOption
    {
        public string Value { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
    }
}