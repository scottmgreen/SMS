@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Pages.SMSRiskManagement
@using SMS3.Components.Pages.SMSRiskManagement.Models
@using SMS3.Components.Shared
@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using global::System.Text.Json

<RadzenRow Gap="1rem">
    <!-- Main Content Column -->
    <RadzenColumn Size="12" SizeLG="8">
        <RadzenStack Gap="1.5rem">
                       

            <!-- Hazard Risk Analysis Section -->
           
                <RadzenStack Gap="1rem">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="8">
                            <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-secondary); margin: 0;">
                                <RadzenIcon Icon="assignment" Style="margin-right: 0.5rem;" />
                                    Hazard Risk Analysis (@GetAnalyzedCount()/@(Step3Hazards?.Count ?? 0) completed)
                            </RadzenText>
                        </RadzenColumn>
                        @* <RadzenColumn Size="4">
                            
                        </RadzenColumn> *@
                    </RadzenRow>

                @if (Step3Hazards?.Any() == true)
                    {
                    @foreach (var hazard in Step3Hazards)
                        {
                            var analysis = Step3.GetHazardAnalysis(hazard.Code);
                            
                            <RadzenCard Variant="Variant.Outlined" Style="border-left: 4px solid var(--rz-secondary);">
                                <RadzenStack Gap="1rem">
                                    <!-- Hazard Header Information -->
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="2">
                                            <RadzenStack Gap="0.25rem">
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                    <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0; color: var(--rz-primary);">
                                                        <strong>Hazard:</strong> @hazard.Code
                                                    </RadzenText>
                                                </RadzenStack>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="10">
                                            <RadzenStack Gap="0.25rem">
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                    <RadzenText 
                                                        TextStyle="TextStyle.Subtitle1" 
                                                        Text="@GetHazardDisplayText(hazard)"
                                                        Style="margin: 0; color: var(--rz-primary);" />
                                                </RadzenStack>
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    
                                    <!-- Hazard Description -->
                                    <RadzenRow Gap="1rem">
                                        <RadzenColumn Size="12" SizeMD="12">
                                            <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0;">
                                                <strong>Description:</strong> @hazard.Description
                                            </RadzenText>
                                        </RadzenColumn>
                                    </RadzenRow>
                                    
                                    <!-- Risk Analysis Input Fields -->
                                    <RadzenRow Gap="1rem">
                                        <!-- Worst Credible Outcome -->
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <RadzenStack Gap="0.5rem">
                                                <RadzenFormField Text="Worst Credible Outcome *"
                                                                 Variant="Variant.Outlined"
                                                                 class="@(IsInitialFieldInvalid(analysis.InitialWorstCredibleOutcome) ? "validation-error-field" : string.Empty)">
                                                    <RadzenTextArea @bind-Value="@analysis.InitialWorstCredibleOutcome"
                                                                    @oninput="@((args) => OnAnalysisFieldChanged(hazard.Code, "WorstCredibleOutcome", args))"
                                                                    Rows="3"
                                                                    Placeholder="Describe the worst reasonable outcome that could result from this hazard..."
                                                                    Style="width: 100%;"
                                                                    class="@(IsInitialFieldInvalid(analysis.InitialWorstCredibleOutcome) ? "default-validation-textarea" : string.Empty)" />
                                                </RadzenFormField>
                                                <RadzenText TextStyle="TextStyle.Caption" Text="Focus on the most severe but realistic consequence - what could actually happen?" />
                                            <RadzenText TextStyle="TextStyle.Caption" Text="@GetFieldValidation(analysis.InitialWorstCredibleOutcome, 10)" />
                                            </RadzenStack>
                                        </RadzenColumn>
                                        
                                        <!-- Root Cause Analysis -->
                                        <RadzenColumn Size="12" SizeMD="6">
                                            <RadzenStack Gap="0.5rem">
                                                <RadzenFormField Text="Root Cause Analysis *"
                                                                 Variant="Variant.Outlined"
                                                                 class="@(IsInitialFieldInvalid(analysis.InitialRootCause) ? "validation-error-field" : string.Empty)">
                                                <RadzenTextArea @bind-Value="@analysis.InitialRootCause"
                                                                    @oninput="@((args) => OnAnalysisFieldChanged(hazard.Code, "RootCause", args))"
                                                                    Rows="3"
                                                                    Placeholder="Identify the underlying root causes that could lead to this hazard..."
                                                                    Style="width: 100%;"
                                                                    class="@(IsInitialFieldInvalid(analysis.InitialRootCause) ? "default-validation-textarea" : string.Empty)" />
                                                </RadzenFormField>
                                                <RadzenText TextStyle="TextStyle.Caption" Text="Identify underlying causes, not just symptoms - ask 'why' multiple times" />
                                            <RadzenText TextStyle="TextStyle.Caption" Text="@GetFieldValidation(analysis.InitialRootCause, 10)" />
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>

                                    <!-- Additional Comments -->
                                    <RadzenFormField Text="Additional Analysis Comments *"
                                                     Variant="Variant.Outlined"
                                                     class="@(IsInitialFieldInvalid(analysis.InitialAdditionalComments) ? "validation-error-field" : string.Empty)">
                                    <RadzenTextArea @bind-Value="@analysis.InitialAdditionalComments"
                                                        @oninput="@((args) => OnAnalysisFieldChanged(hazard.Code, "AdditionalComments", args))"
                                                        Rows="2"
                                                        Placeholder="Document any additional context, assumptions, or observations..."
                                                        Style="width: 100%;"
                                                        class="@(IsInitialFieldInvalid(analysis.InitialAdditionalComments) ? "default-validation-textarea" : string.Empty)" />
                                    </RadzenFormField>
                                    <RadzenText TextStyle="TextStyle.Caption" Text="Document any additional context, assumptions, or observations relevant to this hazard" />
                                </RadzenStack>
                            </RadzenCard>
                        }
                    }
                    else
                    {
                        <!-- No Hazards Available State -->
                        <RadzenCard Style="text-align: center; padding: 2rem;">
                            <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
                                <RadzenIcon Icon="warning" Style="font-size: 3rem; color: var(--rz-warning);" />
                                <RadzenText TextStyle="TextStyle.H5" Text="No hazards identified yet" />
                                <RadzenText TextStyle="TextStyle.Body2" Text="Please complete Step 2 (Identify Hazards) before proceeding with risk analysis." />
                                @* <RadzenButton Text="Go to Step 2" Icon="arrow_back" ButtonStyle="ButtonStyle.Warning" 
                                              Click="@GoToStep2" /> *@
                            </RadzenStack>
                        </RadzenCard>
                    }
                </RadzenStack>
            
        </RadzenStack>
    </RadzenColumn>

    <!-- Guidance Panel -->
    <RadzenColumn Size="12" SizeLG="4">
        <TechnicalAssessmentGuidance StepNumber="3" />
    </RadzenColumn>
</RadzenRow>

<style>
    .validation-error-field .rz-textarea,
    .default-validation-textarea {
        border: 2px solid #dc3545 !important;
        background-color: #fff5f5 !important;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
    }
</style>

