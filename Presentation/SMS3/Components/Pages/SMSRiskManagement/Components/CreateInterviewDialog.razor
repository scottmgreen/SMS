@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Domain.Enums
@using SMS_Application.Messaging.Commands
@using SMS_Application.Interfaces
@using SMS_Shared.Common
@using Radzen
@using Radzen.Blazor

<div class="modal-overlay" @onclick:stopPropagation="true">
    <div class="sms-modal-dialog sms-modal-xxl" @onclick:stopPropagation="true">
        <div class="sms-modal-content">
            
            <!-- Modal Header -->
            <div class="sms-modal-header sms-header-primary">
                <h4 class="sms-modal-title">
                    <RadzenIcon Icon="add" Style="margin-right: 0.5rem;" />
                    @($"Schedule New Interview - Investigation {Model.InvestigationCode}")
                </h4>
            </div>

            <!-- Modal Body -->
            <div class="sms-modal-body" style="padding: 1.5rem;">
                <RadzenStack Gap="1rem">
                    <RadzenFieldset Text="Interviewee ">
                        <RadzenRow Gap="1rem">
                        <RadzenColumn Size="4" SizeMD="4">
                            <RadzenFormField Text="Person to Interview *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="@Model.PersonInterviewed"
                                               Placeholder="Enter the name of person to interview"
                                               Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="4" SizeMD="4">
                            <RadzenFormField Text="Role/Position" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="@Model.PersonInterviewedRole"
                                               Placeholder="e.g., Ground Crew, Pilot, Supervisor"
                                               Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="3">
                            <RadzenFormField Text="Submitting Department *" Variant="Variant.Outlined" AllowFloatingLabel="false"  Style="width: 100%;">

                                <RadzenDropDown @bind-Value="@Model.PersonInterviewedDepartment"
                                                Data="@DepartmentOptions"
                                                TextProperty="Text"
                                                ValueProperty="Value"
                                                Placeholder="Select submitting department..."
                                                Name="SubmittingDepartment"
                                                Change="@(async (object value) => await OnDepartmentChanged(value?.ToString()))"
                                                Style="width: 100%; min-width: 100%;" />
                            </RadzenFormField>
                            <RadzenRequiredValidator Component="ReportingDepartment" Text="Reporting Department by is required" />
                        </RadzenColumn>
                        
                    </RadzenRow>             

                    </RadzenFieldset>
                                       
                                       

                    <!-- Scheduling -->
                    <RadzenFieldset Text="Schedule Interview (Optional)">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="3">
                                <RadzenFormField Text="Interview Type" Variant="Variant.Outlined" AllowFloatingLabel="false"  Style="width: 100%;">
                                    <RadzenDropDown @bind-Value="@Model.InterviewTypeId"
                                                    Data="@InterviewTypeOptions"
                                                    TextProperty="Text"
                                                    ValueProperty="Value"
                                                    Change="@(async (object value) => await OnWitnessInterviewTypeChanged(value?.ToString()))"
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="3" SizeMD="3">
                                <RadzenFormField Text="Interview Date & Time" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                    <RadzenDatePicker @bind-Value="@Model.InterviewDate" 
                                                    ShowTime="true" 
                                                    DateFormat="MM/dd/yyyy HH:mm"
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="6" SizeMD="6">
                                <RadzenFormField Text="Location" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                    <RadzenTextBox @bind-Value="@Model.InterviewLocation" 
                                                 Placeholder="Conference room, office, etc."
                                                 Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenFieldset>

                    <!-- Interview Preparation Section -->
                    <RadzenFieldset Text="Interview Preparation">
                        
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="4" SizeMD="4">
                                <!-- Preparation Notes -->
                                <RadzenFormField Text="Preparation Notes" Variant="Variant.Outlined" AllowFloatingLabel="false"  Style="width: 100%;margin-bottom: 1rem;">
                                    <RadzenTextArea @bind-Value="@Model.PreparationNotes"
                                                    Rows="3"
                                                    Placeholder="Notes to prepare for the interview..."
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="4" SizeMD="4">
                                <!-- Questions to Ask -->
                                <RadzenFormField Text="Questions to Ask" Variant="Variant.Outlined" AllowFloatingLabel="false"  Style="width: 100%;margin-bottom: 1rem;">
                                    <RadzenTextArea @bind-Value="@Model.QuestionsToAsk"
                                                    Rows="3"
                                                    Placeholder="List key questions to ask during the interview..."
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="4" SizeMD="4">
                                <!-- Background Information -->
                                <RadzenFormField Text="Background Information" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;margin-bottom: 1rem;">
                                    <RadzenTextArea @bind-Value="@Model.BackgroundInformation"
                                                    Rows="3"
                                                    Placeholder="Background information about the person or incident..."
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                        
                        </RadzenRow>

                    </RadzenFieldset>

      

                </RadzenStack>
            </div>

            <!-- Modal Footer -->
            <div class="sms-modal-footer">
                <div class="d-flex justify-content-end gap-2">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        <RadzenCheckBox @bind-Value="@Model.IsConfidential" Name="confidential" />
                        <RadzenLabel Text="Mark this interview as confidential" Component="confidential" />
                    </RadzenStack>
                    <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                Text="Cancel" 
                                Icon="close"
                                Click="@(() => DialogService.Close(false))"
                                Size="ButtonSize.Medium" />
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                Text="Schedule Interview" 
                                Icon="schedule"
                                Click="@CreateInterview"
                                Size="ButtonSize.Medium"
                                Disabled="@IsSaving" />
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Modal Styles - Same as InterviewCalendar */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 1rem;
    }

    .sms-modal-dialog {
        position: relative;
        margin: 0 auto;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
    }

    .sms-modal-xxl {
        max-width: 1400px;
        width: 95%;
    }

    .sms-modal-content {
        background: white;
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    }

    .sms-modal-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e9ecef;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .sms-header-primary {
        background-color: #212e61; /* SMS Blue Dark Bold */
        color: white;
    }

    .sms-modal-title {
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
    }

    .sms-modal-body {
        max-height: calc(100vh - 200px);
        overflow-y: auto;
    }

    .sms-modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid #e9ecef;
        border-radius: 0 0 0.5rem 0.5rem;
        background-color: #f8f9fa;
    }
</style>