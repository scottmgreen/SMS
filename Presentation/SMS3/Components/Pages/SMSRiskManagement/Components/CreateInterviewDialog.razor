@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Domain.Enums
@using SMS_Application.Messaging.Commands
@using SMS_Application.Interfaces
@using SMS_Shared.Common
@using Radzen
@using Radzen.Blazor

<RadzenTemplateForm Data="@Model" Submit="@CreateInterview" TItem="CreateInterviewModel">
    <RadzenStack Gap="1rem">
        
        <!-- Person Interviewed -->
        <RadzenFormField Text="Person to Interview *" Variant="Variant.Outlined">
            <RadzenTextBox @bind-Value="@Model.PersonInterviewed" 
                         Placeholder="Enter the name of person to interview"
                         Style="width: 100%;" />
        </RadzenFormField>

        <!-- Role and Department -->
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Role/Position" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@Model.PersonInterviewedRole" 
                                 Placeholder="e.g., Ground Crew, Pilot, Supervisor"
                                 Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Department" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@Model.PersonInterviewedDepartment" 
                                 Placeholder="e.g., Operations, Maintenance"
                                 Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <!-- Interview Type -->
        <RadzenFormField Text="Interview Type" Variant="Variant.Outlined">
            <RadzenDropDown @bind-Value="@Model.Type" 
                          Data="@InterviewTypeOptions" 
                          TextProperty="Text" 
                          ValueProperty="Value"
                          Style="width: 100%;" />
        </RadzenFormField>

        <!-- Scheduling -->
        <RadzenFieldset Text="Schedule Interview (Optional)">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Interview Date & Time" Variant="Variant.Outlined">
                        <RadzenDatePicker @bind-Value="@Model.InterviewDate" 
                                        ShowTime="true" 
                                        DateFormat="MM/dd/yyyy HH:mm"
                                        Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Location" Variant="Variant.Outlined">
                        <RadzenTextBox @bind-Value="@Model.InterviewLocation" 
                                     Placeholder="Conference room, office, etc."
                                     Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>

        <!-- Preparation Notes -->
        <RadzenFormField Text="Preparation Notes" Variant="Variant.Outlined">
            <RadzenTextArea @bind-Value="@Model.PreparationNotes" 
                          Rows="3" 
                          Placeholder="Notes to prepare for the interview..."
                          Style="width: 100%;" />
        </RadzenFormField>

        <!-- Confidential Flag -->
        <RadzenFormField Text="Confidentiality" Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <RadzenCheckBox @bind-Value="@Model.IsConfidential" Name="confidential" />
                <RadzenLabel Text="Mark this interview as confidential" Component="confidential" />
            </RadzenStack>
        </RadzenFormField>

        <!-- Action Buttons -->
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
            <RadzenButton Text="Cancel" 
                        ButtonStyle="ButtonStyle.Secondary" 
                        Click="@(() => DialogService.Close(false))" />
            <RadzenButton Text="Schedule Interview" 
                        ButtonStyle="ButtonStyle.Primary" 
                        ButtonType="ButtonType.Submit"
                        Disabled="@IsSaving" />
        </RadzenStack>

    </RadzenStack>
</RadzenTemplateForm>