@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Pages.SMSRiskManagement
@using SMS3.Components.Pages.SMSRiskManagement.Components
@using SMS3.Components.Pages.SMSRiskManagement.Models
@using SMS3.Components.Shared
@using SMS_Application.Interfaces
@using SMS_Application.Queries
@using SMS_Domain.Entities
@using SMS_Domain.Enums

<RadzenRow Gap="1rem">
    <!-- Main Content Column -->
    <RadzenColumn Size="12" SizeLG="8">
        <RadzenStack Gap="1.5rem">
            
            <!-- Hazard Scoring Panels -->
            @if (Step4Hazards?.Any() == true)
            {
                <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-success); margin: 0;">
                    <RadzenIcon Icon="assignment" Style="margin-right: 0.5rem;" />
                    Hazard Risk Scoring (@Step4Hazards.Count Hazards)
                </RadzenText>
                <RadzenFormField Text="Additional Comments *"
                                 Variant="Variant.Outlined"
                                 AllowFloatingLabel="false"
                                 class="@(IsAdditionalCommentsInvalid() ? "validation-error-field" : string.Empty)">
                    <RadzenTextArea @bind-Value="@Step4.AdditionalComments"
                                    Name="AdditionalComments"
                                    @oninput="OnAdditionalCommentsChanged"
                                    Rows="4" Placeholder="Provide additional comments..." Style="width: 100%;"
                                    title="Additional Comments"
                                    class="@(IsAdditionalCommentsInvalid() ? "default-validation-textarea" : string.Empty)" />
                    <RadzenRequiredValidator Component="AdditionalComments" Text="Additional Comments is required." Popup="false" Style="position: static; display: block;" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Caption" Text="@GetFieldValidation(Step4.AdditionalComments, 10)" />
                @foreach (var hazard in Step4Hazards)
                {
                    AvailableStakeholders = AvailableStakeholders.Where(predicate => predicate.IsPOPEmployee == true).ToList();
                    <HazardScoring @key="@($"panel-{hazard.Code}")" 
                                        Hazard="@hazard" 
                                        Step4="@Step4"
                                        AvailableStakeholders="@AvailableStakeholders"
                                        AvailableAssessors="@AvailableAssessors"
                                        CurrentRiskAssessment="@CurrentRiskAssessment"
                                        CurrentStep="4"
                                        OnHazardScored="@(() => HandleHazardScored(hazard.Code))" />
                }
            }
            else
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Icon="warning" ShowIcon="true">
                    <RadzenText TextStyle="TextStyle.Body2" Text="No hazards available for scoring. Please complete Step 2 (Hazard Identification) first." />
                </RadzenAlert>
            }
        </RadzenStack>
    </RadzenColumn>

    <!-- Guidance Panel -->
    <RadzenColumn Size="12" SizeLG="4">
        <RadzenStack Gap="1rem">
            <!-- 5x5 Risk Matrix Visualization -->
            @if (Step4Hazards?.Any() == true)
            {
                <RiskAssessmentMatrix Title="Risk Assessment Matrix"
                                      ShowRiskLevelsLegend="true"
                                      SeverityLabelProvider="@GetSeverityLabel"
                                      HazardsAtMatrixCodeProvider="@GetHazardsAtMatrixCode" />
            }

            

            <!-- Guidance Panel -->
            <TechnicalAssessmentGuidance StepNumber="4" />
        </RadzenStack>
    </RadzenColumn>
</RadzenRow>

<style>
    .validation-error-field .rz-textarea,
    .default-validation-textarea {
        border: 2px solid #dc3545 !important;
        background-color: #fff5f5 !important;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
    }
</style>

