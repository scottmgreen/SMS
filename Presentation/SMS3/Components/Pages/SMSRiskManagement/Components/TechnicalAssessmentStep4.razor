<RadzenRow Gap="1rem">
    <!-- Main Content Column -->
    <RadzenColumn Size="12" SizeLG="8">
        <RadzenStack Gap="1.5rem">
            <!-- Header -->
            <RadzenCard Variant="Variant.Outlined" Style="border-left: 4px solid var(--rz-primary);">
                <RadzenStack Gap="1rem">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="10">
                            <RadzenText TextStyle="TextStyle.H5" Style="color: var(--rz-primary); margin: 0;">
                                <RadzenIcon Icon="trending_up" Style="margin-right: 0.5rem;" />
                                Step 4: Assess Risk Level & Tolerability
                            </RadzenText>
                        </RadzenColumn>
                        <RadzenColumn Size="2">
                            <RadzenBadge Text="@($"{AvailableHazards?.Count ?? 0} Hazards")" BadgeStyle="BadgeStyle.Light" />
                        </RadzenColumn>
                    </RadzenRow>
                    
                    <RadzenText TextStyle="TextStyle.Body2">
                        Use the 5x5 risk matrix to assess each identified hazard. Each panel member scores independently using severity (impact) and likelihood (probability) 
                        to determine their individual risk assessment. The system calculates average scores per hazard.
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>

            <!-- Hazard Scoring Panels -->
            @if (AvailableHazards?.Any() == true)
            {
                @foreach (var hazard in AvailableHazards)
                {
                    <HazardScoringPanel Hazard="@hazard" 
                                       Step4="@Step4"
                                       AvailableStakeholders="@AvailableStakeholders"
                                       AvailableAssessors="@AvailableAssessors"
                                       ExistingScoringPanels="@GetScoringPanelsForHazard(hazard.Code)"
                                       PanelMemberData="@GetPanelMemberDataForHazard(hazard.Code)"
                                       OnPanelUpdated="@OnPanelUpdated" 
                                       OnScoreSubmitted="@OnScoreSubmitted"
                                       OnPanelDataRefresh="@LoadAllScoringPanels" />
                }
            }
            else
            {
                <RadzenCard Style="text-align: center; padding: 2rem;">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenIcon Icon="warning" Style="font-size: 3rem; color: var(--rz-warning);" />
                        <RadzenText TextStyle="TextStyle.H5" Text="No hazards identified yet" />
                        <RadzenText TextStyle="TextStyle.Body2" Text="Please complete Step 2 (Identify Hazards) before proceeding with risk assessment." />
                        <RadzenButton Text="Go to Step 2" Icon="arrow_back" ButtonStyle="ButtonStyle.Warning" 
                                      Click="@GoToStep2" />
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    </RadzenColumn>
    <!-- Help Panel -->
    <RadzenColumn Size="12" SizeLG="4">
        <RadzenStack Gap="1rem">
            <!-- Enhanced Risk Matrix with Highlighting -->
            <RadzenCard>
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-success); margin: 0;">
                        <RadzenIcon Icon="help" Style="margin-right: 0.5rem;" />
                        Assessment Guidelines
                    </RadzenText>

                    <RadzenText TextStyle="TextStyle.Subtitle2" Text="5x5 Risk Matrix" Style="margin: 0;" />
                    
                    <!-- Interactive Risk Matrix -->
                    <div style="overflow-x: auto;">
                        <table class="table table-bordered text-center risk-matrix-enhanced" style="margin: 0; font-size: 0.875rem;">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="vertical-align: middle; background-color: var(--rz-base-200);">
                                        Severity ?<br/>? Likelihood
                                    </th>
                                    <th style="background-color: var(--rz-base-100);">1<br/>Minor</th>
                                    <th style="background-color: var(--rz-base-100);">2<br/>Moderate</th>
                                    <th style="background-color: var(--rz-base-100);">3<br/>Serious</th>
                                    <th style="background-color: var(--rz-base-100);">4<br/>Major</th>
                                    <th style="background-color: var(--rz-base-100);">5<br/>Catastrophic</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in GetRiskMatrixRows())
                                {
                                    <tr>
                                        <th style="background-color: var(--rz-base-100);">@row.Label</th>
                                        @foreach (var cell in row.Cells)
                                        {
                                            <td class="risk-cell @GetRiskCellClass(cell.RiskLevel)" 
                                                style="position: relative; @GetCellStyle(cell)"
                                                title="Severity: @cell.Severity, Likelihood: @cell.Likelihood, Risk: @cell.RiskLevel">
                                                
                                                @cell.CellLabel
                                                
                                                <!-- Show badges for average scores that fall in this cell -->
                                                @foreach (var badge in GetBadgesForCell(cell.Severity, cell.Likelihood))
                                                {
                                                    <div style="position: absolute; top: 2px; right: 2px;">
                                                        <RadzenBadge Text="@badge.Text" 
                                                                    BadgeStyle="BadgeStyle.Dark" 
                                                                    Style="font-size: 0.7rem; opacity: 0.9;" 
                                                                    title="@badge.HazardDescription" />
                                                    </div>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <RadzenText TextStyle="TextStyle.Subtitle2" Text="Control Hierarchy" Style="margin: 0;" />
                    <ol style="font-size: 0.875rem;">
                        <li><strong>Elimination:</strong> Remove the hazard</li>
                        <li><strong>Substitution:</strong> Replace with safer alternative</li>
                        <li><strong>Engineering:</strong> Physical safeguards</li>
                        <li><strong>Administrative:</strong> Procedures and training</li>
                        <li><strong>PPE:</strong> Personal protective equipment</li>
                    </ol>

                    <RadzenText TextStyle="TextStyle.Subtitle2" Text="ALARP Principle" Style="margin: 0;" />
                    <RadzenText TextStyle="TextStyle.Caption">
                        Risks should be reduced to <strong>As Low As Reasonably Practicable</strong> (ALARP), considering cost-benefit and available technology.
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>

            <!-- Guidance Panel -->
            <TechnicalAssessmentGuidancePanel StepNumber="4" />
        </RadzenStack>
    </RadzenColumn>
    <!-- Debug Panel -->
    
</RadzenRow>

@code {
    [Parameter] public Step4Model Step4 { get; set; } = new();
    [Parameter] public EventCallback<Step4Model> Step4Changed { get; set; }
    [Parameter] public List<Hazard> AvailableHazards { get; set; } = new();
    [Parameter] public List<SMSStakeholderUser> AvailableStakeholders { get; set; } = new();
    [Parameter] public List<SMSApplicationUser> AvailableAssessors { get; set; } = new();

    // Centralized scoring panel data for all hazards
    private Dictionary<string, List<ScoringPanel>> AllScoringPanels = new();
    private Dictionary<string, List<PanelMemberData>> AllPanelMemberData = new();

    [Inject] private IMediator Mediator { get; set; } = default!;
    [Inject] private ILogger<TechnicalAssessmentStep4> Logger { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        // Load scoring panels when hazards change
        if (AvailableHazards?.Any() == true)
        {
            await LoadAllScoringPanels();
        }
    }

    private async Task LoadAllScoringPanels()
    {
        AllScoringPanels.Clear();
        AllPanelMemberData.Clear();

        foreach (var hazard in AvailableHazards)
        {
            try
            {
                var query = new GetScoringPanelsByHazardCodeQuery(hazard.Code);
                var result = await Mediator.SendAsync(query, CancellationToken.None);

                if (result.IsSuccess && result.Value != null)
                {
                    AllScoringPanels[hazard.Code] = result.Value.ToList();
                    
                    // Create stable PanelMemberData objects for this hazard
                    var panelMembers = GetPanelMembersForHazard(hazard.Code);
                    AllPanelMemberData[hazard.Code] = CreatePanelMemberData(hazard.Code, panelMembers);
                }
                else
                {
                    AllScoringPanels[hazard.Code] = new List<ScoringPanel>();
                    AllPanelMemberData[hazard.Code] = new List<PanelMemberData>();
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error loading scoring panels for hazard {HazardCode}", hazard.Code);
                AllScoringPanels[hazard.Code] = new List<ScoringPanel>();
                AllPanelMemberData[hazard.Code] = new List<PanelMemberData>();
            }
        }
    }

    private List<string> GetPanelMembersForHazard(string hazardCode)
    {
        return Step4.HazardPanelMembers.ContainsKey(hazardCode) 
            ? Step4.HazardPanelMembers[hazardCode] 
            : new List<string>();
    }

    private List<PanelMemberData> CreatePanelMemberData(string hazardCode, List<string> panelMembers)
    {
        var existingPanels = AllScoringPanels[hazardCode];
        
        Console.WriteLine($"?? CreatePanelMemberData for {hazardCode}:");
        Console.WriteLine($"   Panel Members: {string.Join(", ", panelMembers)}");
        Console.WriteLine($"   Existing Panels: {string.Join(", ", existingPanels.Select(p => $"[{p.Code}:{p.SMSUserCode}, S:{p.Severity}, L:{p.Likelihood}, Score:{p.Score}]"))}");
        
        return panelMembers.Select(memberId =>
        {
            var stakeholder = AvailableStakeholders.FirstOrDefault(s => s.Code == memberId);
            var assessor = AvailableAssessors.FirstOrDefault(a => a.Id.Value == memberId);
            
            // CRITICAL FIX: Find existing panel by SMSUserCode, regardless of whether it has scores
            var existingPanel = existingPanels.FirstOrDefault(p => p.SMSUserCode == memberId);
            
            Console.WriteLine($"   Member {memberId}: Found panel = {existingPanel?.Code ?? "NULL"}");
            
            var memberData = new PanelMemberData
            {
                MemberId = memberId,
                Name = stakeholder?.DisplayName ?? assessor?.DisplayName ?? "Unknown",
                Role = stakeholder?.StakeholderType ?? assessor?.UserRole.Name ?? "Unknown",
                
                // CRITICAL FIX: Use null-safe operators and preserve 0 as a valid unselected state
                SeverityScore = existingPanel?.Severity ?? 0,
                LikelihoodScore = existingPanel?.Likelihood ?? 0,
                CalculatedScore = (double)(existingPanel?.Score ?? 0),
                
                // CRITICAL FIX: Panel is completed ONLY if it has actual scores AND they're not zero
                // This ensures placeholder records with NULL values don't show as completed
                IsCompleted = existingPanel != null && 
                             existingPanel.Severity.HasValue && existingPanel.Severity.Value > 0 &&
                             existingPanel.Likelihood.HasValue && existingPanel.Likelihood.Value > 0 &&
                             existingPanel.Score.HasValue && existingPanel.Score.Value > 0
            };
            
            Console.WriteLine($"   Result: S:{memberData.SeverityScore}, L:{memberData.LikelihoodScore}, Completed:{memberData.IsCompleted}, CanSubmit:{memberData.CanSubmit}");
            
            return memberData;
        }).ToList();
    }

    public List<ScoringPanel> GetScoringPanelsForHazard(string hazardCode)
    {
        return AllScoringPanels.ContainsKey(hazardCode) 
            ? AllScoringPanels[hazardCode] 
            : new List<ScoringPanel>();
    }

    public List<PanelMemberData> GetPanelMemberDataForHazard(string hazardCode)
    {
        return AllPanelMemberData.ContainsKey(hazardCode) 
            ? AllPanelMemberData[hazardCode] 
            : new List<PanelMemberData>();
    }

    private void GoToStep2()
    {
        Console.WriteLine("Navigate to Step 2");
    }

    private string GetTotalPanelMembers()
    {
        return Step4.SelectedPanelMembers?.Count.ToString() ?? "0";
    }

    private string GetCompletedScores()
    {
        return Step4.CompletedScores?.Count.ToString() ?? "0";
    }

    private string GetPendingScores()
    {
        return Step4.PendingScores?.Count.ToString() ?? "0";
    }

    private int GetScoringProgress()
    {
        var totalRequired = (AvailableHazards?.Count ?? 0) * (Step4.SelectedPanelMembers?.Count ?? 0);
        if (totalRequired == 0) return 0;
        
        var completed = Step4.CompletedScores?.Count ?? 0;
        return (completed * 100) / totalRequired;
    }

    private async Task OnPanelUpdated(string hazardId)
    {
        await Step4Changed.InvokeAsync(Step4);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnScoreSubmitted(Step4Model.PanelMemberScoreData scoreData)
    {
        Console.WriteLine($"?? Parent received score submission notification for {scoreData.MemberId}");
        
        // SMART UPDATE: Only update the Step4 model data for average calculations
        // Do NOT reload all panel data from database as this would clear pending UI states
        Step4.AddPanelMemberScore(scoreData.HazardId, scoreData);
        
        // Recalculate averages for this hazard without full reload
        Step4.RecalculateHazardAverage(scoreData.HazardId);
        
        Console.WriteLine($"? Parent updated averages without full panel reload - pending scores preserved");
        
        await Step4Changed.InvokeAsync(Step4);
        await InvokeAsync(StateHasChanged);
        
        // CRITICAL: Do NOT call LoadAllScoringPanels() here as it would reload everything from database
    }

    #region Risk Matrix Enhancement

    private List<RiskMatrixRow> GetRiskMatrixRows()
    {
        return new List<RiskMatrixRow>
        {
            new() { Label = "A - Rare", LikelihoodValue = 1, Cells = GetRowCells(1) },
            new() { Label = "B - Unlikely", LikelihoodValue = 2, Cells = GetRowCells(2) },
            new() { Label = "C - Possible", LikelihoodValue = 3, Cells = GetRowCells(3) },
            new() { Label = "D - Likely", LikelihoodValue = 4, Cells = GetRowCells(4) },
            new() { Label = "E - Frequent", LikelihoodValue = 5, Cells = GetRowCells(5) }
        };
    }

    private List<RiskMatrixCell> GetRowCells(int likelihood)
    {
        var cells = new List<RiskMatrixCell>();
        for (int severity = 1; severity <= 5; severity++)
        {
            var riskLevel = GetRiskLevel(severity, likelihood);
            var cellLabel = $"{severity}{(char)('A' + likelihood - 1)}\n{riskLevel}";
            
            cells.Add(new RiskMatrixCell
            {
                Severity = severity,
                Likelihood = likelihood,
                RiskLevel = riskLevel,
                CellLabel = cellLabel
            });
        }
        return cells;
    }

    private string GetRiskLevel(int severity, int likelihood)
    {
        var score = severity * likelihood;
        return score switch
        {
            <= 4 => "Very Low",
            <= 8 => "Low", 
            <= 12 => "Medium",
            <= 20 => "High",
            _ => "Very High"
        };
    }

    private string GetRiskCellClass(string riskLevel)
    {
        return riskLevel switch
        {
            "Very Low" => "risk-very-low",
            "Low" => "risk-low",
            "Medium" => "risk-medium", 
            "High" => "risk-high",
            "Very High" => "risk-very-high",
            _ => ""
        };
    }

    private string GetCellStyle(RiskMatrixCell cell)
    {
        var baseStyle = "";
        
        // Check if any hazard average scores fall in this cell
        var hasScores = GetBadgesForCell(cell.Severity, cell.Likelihood).Any();
        if (hasScores)
        {
            baseStyle += "border: 3px solid var(--rz-primary) !important; box-shadow: 0 0 10px rgba(0,123,255,0.5);";
        }
        
        return baseStyle;
    }

    private List<CellBadge> GetBadgesForCell(int severity, int likelihood)
    {
        var badges = new List<CellBadge>();
        
        if (Step4.HazardAverageScores?.Any() == true)
        {
            foreach (var hazardScore in Step4.HazardAverageScores)
            {
                // Calculate which cell this average score falls into
                var hazardSeverity = GetSeverityFromScore(hazardScore.Value);
                var hazardLikelihood = GetLikelihoodFromScore(hazardScore.Value, hazardSeverity);
                
                if (Math.Abs(hazardSeverity - severity) < 0.5 && Math.Abs(hazardLikelihood - likelihood) < 0.5)
                {
                    var hazard = AvailableHazards?.FirstOrDefault(h => h.Code == hazardScore.Key);
                    badges.Add(new CellBadge
                    {
                        Text = $"{hazardScore.Key}: {hazardScore.Value:F1}",
                        HazardDescription = hazard?.Description ?? "Unknown hazard"
                    });
                }
            }
        }
        
        return badges;
    }

    private int GetSeverityFromScore(double averageScore)
    {
        // This is a simplified approach - in reality you'd want to store the actual severity/likelihood values
        // For now, estimate based on common patterns in a 5x5 matrix
        if (averageScore <= 5) return (int)Math.Ceiling(averageScore);
        if (averageScore <= 10) return (int)Math.Ceiling(averageScore / 2);
        if (averageScore <= 15) return (int)Math.Ceiling(averageScore / 3);
        if (averageScore <= 20) return (int)Math.Ceiling(averageScore / 4);
        return 5;
    }

    private int GetLikelihoodFromScore(double averageScore, int severity)
    {
        if (severity == 0) return 1;
        return (int)Math.Ceiling(averageScore / severity);
    }

    public class RiskMatrixRow
    {
        public string Label { get; set; } = "";
        public int LikelihoodValue { get; set; }
        public List<RiskMatrixCell> Cells { get; set; } = new();
    }

    public class RiskMatrixCell
    {
        public int Severity { get; set; }
        public int Likelihood { get; set; }
        public string RiskLevel { get; set; } = "";
        public string CellLabel { get; set; } = "";
    }

    public class CellBadge
    {
        public string Text { get; set; } = "";
        public string HazardDescription { get; set; } = "";
    }

    // Shared PanelMemberData class for consistent object identity
    public class PanelMemberData
    {
        public int SeverityScore { get; set; }
        public int LikelihoodScore { get; set; }
        public double CalculatedScore { get; set; }
        public bool IsCompleted { get; set; }
        public string MemberId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;

        public bool CanSubmit => SeverityScore > 0 && LikelihoodScore > 0 && !IsCompleted;
        public double PreviewScore => SeverityScore > 0 && LikelihoodScore > 0 ? SeverityScore * LikelihoodScore : 0;
    }

    #endregion
}