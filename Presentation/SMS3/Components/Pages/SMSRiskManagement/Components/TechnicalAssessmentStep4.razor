@using SMS3.Components.Shared
@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using SMS3.Components.Pages.SMSRiskManagement.Components
@using SMS_Application.Messaging.Queries
@using SMS_Application.Interfaces
@using Radzen
@using Radzen.Blazor

<RadzenRow Gap="1rem">
    <!-- Main Content Column -->
    <RadzenColumn Size="12" SizeLG="8">
        <RadzenStack Gap="1.5rem">
            
            <!-- Step 4 Introduction -->
            <RadzenCard Variant="Variant.Outlined" Style="border-left: 4px solid var(--rz-primary);">
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-primary); margin: 0;">
                        <RadzenIcon Icon="balance" Style="margin-right: 0.5rem;" />
                        Step 4: Risk Assessment & Scoring Panel
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2">
                        Assemble stakeholder panels to score each identified hazard using severity and likelihood ratings. 
                        Panel consensus will determine the overall risk level for each hazard.
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>

            <!-- Risk Assessment Framework -->
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-info); margin: 0;">
                        <RadzenIcon Icon="settings" Style="margin-right: 0.5rem;" />
                        Assessment Framework
                    </RadzenText>
                    
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Tolerability Framework" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="@Step4.TolerabilityFramework" 
                                             Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Risk Acceptance Criteria" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="@Step4.RiskAcceptanceCriteria" 
                                             Placeholder="Define risk acceptance criteria..."
                                             Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenCard>

            <!-- Hazard Scoring Panels -->
            @if (AvailableHazards?.Any() == true)
            {
                <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-success); margin: 0;">
                    <RadzenIcon Icon="assignment" Style="margin-right: 0.5rem;" />
                    Hazard Risk Scoring (@AvailableHazards.Count Hazards)
                </RadzenText>

                @foreach (var hazard in AvailableHazards)
                {
                    <HazardScoringPanel @key="@($"panel-{hazard.Code}")" 
                                        Hazard="@hazard" 
                                        AvailableStakeholders="@AvailableStakeholders"
                                        RiskAssessmentId="@RiskAssessmentId"
                                        OnHazardScored="@(() => HandleHazardScored(hazard.Code))" />
                }

                <!-- Overall Progress Summary -->
                @* @if (GetCompletedHazardCount() > 0)
                {
                    <RadzenCard Style="border-left: 4px solid var(--rz-success);">
                        <RadzenStack Gap="1rem">
                            <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-success); margin: 0;">
                                <RadzenIcon Icon="analytics" Style="margin-right: 0.5rem;" />
                                Assessment Progress: @GetCompletedHazardCount() / @AvailableHazards.Count Hazards Completed
                            </RadzenText>
                            
                            <RadzenProgressBar Value="@((double)GetCompletedHazardCount() / AvailableHazards.Count * 100)" 
                                             ShowValue="true" 
                                             Text="@($"{GetCompletedHazardCount()}/{AvailableHazards.Count} Hazards")" />
                            
                            @if (GetCompletedHazardCount() == AvailableHazards.Count)
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Success" Icon="check_circle">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" 
                                                Text="🎉 All hazards have been assessed! Risk assessment is complete and ready for Step 5." />
                                </RadzenAlert>
                            }
                        </RadzenStack>
                    </RadzenCard>
                } *@
            }
            else
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Icon="warning" ShowIcon="true">
                    <RadzenText TextStyle="TextStyle.Body2" Text="No hazards available for scoring. Please complete Step 2 (Hazard Identification) first." />
                </RadzenAlert>
            }
        </RadzenStack>
    </RadzenColumn>

    <!-- Guidance Panel -->
    <RadzenColumn Size="12" SizeLG="4">
        <RadzenStack Gap="1rem">
            <!-- 5x5 Risk Matrix Visualization -->
            @if (AvailableHazards?.Any() == true && Step4.HazardAverageScores.Any())
            {
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Gap="1rem">
                        <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-primary); margin: 0;">
                            <RadzenIcon Icon="grid_on" Style="margin-right: 0.5rem;" />
                            Risk Assessment Matrix
                        </RadzenText>
                        
                        <!-- Aviation Risk Matrix Grid -->
                        <div style="display: grid; grid-template-columns: auto repeat(5, 1fr); gap: 1px; font-size: 0.8rem; border: 2px solid #000;">
                            <!-- Header Row -->
                            <div style="background: #f8f9fa; padding: 8px; border: 1px solid #000; font-weight: bold; text-align: center;">
                                Severity ↓<br/>Likelihood →
                            </div>
                            <div style="text-align: center; font-weight: bold; padding: 8px; background: #f9f9fa; border: 1px solid #000;">
                                <strong>A</strong><br/>RARE
                            </div>
                            <div style="text-align: center; font-weight: bold; padding: 8px; background: #f9f9fa; border: 1px solid #000;">
                                <strong>B</strong><br/>UNLIKELY
                            </div>
                            <div style="text-align: center; font-weight: bold; padding: 8px; background: #f9f9fa; border: 1px solid #000;">
                                <strong>C</strong><br/>POSSIBLE
                            </div>
                            <div style="text-align: center; font-weight: bold; padding: 8px; background: #f9f9fa; border: 1px solid #000;">
                                <strong>D</strong><br/>LIKELY
                            </div>
                            <div style="text-align: center; font-weight: bold; padding: 8px; background: #f9f9fa; border: 1px solid #000;">
                                <strong>E</strong><br/>FREQUENT
                            </div>
                            
                            <!-- Matrix Rows (Severity 5 to 1) -->
                            @for (int severity = 5; severity >= 1; severity--)
                            {
                                <!-- Row Header -->
                                <div style="font-weight: bold; padding: 8px; background: #f9f9fa; border: 1px solid #000; text-align: center;">
                                    <strong>@severity</strong><br/>@GetSeverityLabel(severity).ToUpper()
                                </div>
                                
                                <!-- Matrix Cells -->
                                @for (int likelihood = 1; likelihood <= 5; likelihood++)
                                {
                                    var matrixCode = GetMatrixCode(severity, likelihood);
                                    var cellStyle = GetAviationMatrixCellStyle(severity, likelihood);
                                    var hazardsAtThisCode = GetHazardsAtMatrixCode(severity, likelihood);
                                    
                                    <div style="@cellStyle min-height: 60px; position: relative; border: 1px solid #000;" 
                                         title="@($"{matrixCode} - {GetAviationRiskLevel(severity, likelihood)} Risk - {hazardsAtThisCode.Count} hazard(s)")">
                                        <div style="position: absolute; top: 4px; left: 4px; font-size: 0.9rem; font-weight: bold; color: #000;">
                                            @matrixCode
                                        </div>
                                        @if (hazardsAtThisCode.Any())
                                        {
                                            <div style="position: absolute; bottom: 4px; right: 4px; display: flex; flex-wrap: wrap; gap: 2px; max-width: 80%;">
                                                @foreach (var hazard in hazardsAtThisCode.Take(3))
                                                {
                                                    <span style="background: rgba(0,0,0,0.8); color: white; padding: 2px 4px; border-radius: 3px; font-size: 0.7rem; line-height: 1; font-weight: bold;">
                                                        @hazard
                                                    </span>
                                                }
                                                @if (hazardsAtThisCode.Count > 3)
                                                {
                                                    <span style="background: rgba(0,0,0,0.9); color: white; padding: 2px 4px; border-radius: 3px; font-size: 0.7rem; line-height: 1; font-weight: bold;">
                                                        +@(hazardsAtThisCode.Count - 3)
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                        
                        <!-- Aviation Risk Matrix Legend -->
                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Text="Risk Assessment Categories:" Style="margin: 0;" />
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <div style="width: 20px; height: 16px; background: #dc3545; border: 1px solid #000;"></div>
                                    <RadzenText TextStyle="TextStyle.Caption" Text="High Risk" />
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <div style="width: 20px; height: 16px; background: #fd7e14; border: 1px solid #000;"></div>
                                    <RadzenText TextStyle="TextStyle.Caption" Text="Medium Risk" />
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <div style="width: 20px; height: 16px; background: #ffc107; border: 1px solid #000;"></div>
                                    <RadzenText TextStyle="TextStyle.Caption" Text="Low Risk" />
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <div style="width: 20px; height: 16px; background: #28a745; border: 1px solid #000;"></div>
                                    <RadzenText TextStyle="TextStyle.Caption" Text="Acceptable Risk" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenStack>
                        
                       @*  @if (Step4.HazardAverageScores.Any())
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small">
                                <RadzenText TextStyle="TextStyle.Caption" Text="@($"{Step4.HazardAverageScores.Count} of {AvailableHazards.Count} hazards assessed. Results shown as Severity-Likelihood codes (e.g., 3B, 5A).")" />
                            </RadzenAlert>
                        } *@
                    </RadzenStack>
                </RadzenCard>
            }

            <!-- Risk Matrix Guide -->
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-info); margin: 0;">
                        <RadzenIcon Icon="info" Style="margin-right: 0.5rem;" />
                        Risk Scoring Guide
                    </RadzenText>
                    
                    <RadzenStack Gap="0.5rem">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Severity Scale:" Style="margin: 0;" />
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                            • <strong>5 - Catastrophic:</strong> Multiple fatalities, total loss<br/>
                            • <strong>4 - Major:</strong> Single fatality, major damage<br/>
                            • <strong>3 - Serious:</strong> Serious injury, significant damage<br/>
                            • <strong>2 - Moderate:</strong> Minor injury, minor damage<br/>
                            • <strong>1 - Minor:</strong> No injury, negligible damage
                        </RadzenText>
                    </RadzenStack>
                    
                    <RadzenStack Gap="0.5rem">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Likelihood Scale:" Style="margin: 0;" />
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                            • <strong>5 - Frequent:</strong> Will occur repeatedly<br/>
                            • <strong>4 - Likely:</strong> Will occur several times<br/>
                            • <strong>3 - Possible:</strong> Will occur sometimes<br/>
                            • <strong>2 - Unlikely:</strong> Will occur rarely<br/>
                            • <strong>1 - Rare:</strong> Will occur very rarely
                        </RadzenText>
                    </RadzenStack>
                    
                    <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small">
                        <strong>Risk Score = Severity × Likelihood</strong><br/>
                        Click on matrix cells to see which hazards fall into each risk category.
                    </RadzenAlert>
                </RadzenStack>
            </RadzenCard>

            <!-- Guidance Panel -->
            <TechnicalAssessmentGuidancePanel StepNumber="4" />
        </RadzenStack>
    </RadzenColumn>
</RadzenRow>

@code {
    [Parameter] public Step4Model Step4 { get; set; } = new();
    [Parameter] public EventCallback<Step4Model> Step4Changed { get; set; }
    [Parameter] public List<Hazard> AvailableHazards { get; set; } = new();
    [Parameter] public List<SMSStakeholderUser> AvailableStakeholders { get; set; } = new();
    [Parameter] public List<SMSApplicationUser> AvailableAssessors { get; set; } = new();
    [Parameter] public string RiskAssessmentId { get; set; } = string.Empty; // NEW: Pass assessment ID from parent

    [Inject] private IMediator Mediator { get; set; } = default!;
    [Inject] private ILogger<TechnicalAssessmentStep4> Logger { get; set; } = default!;

    private bool _isInitialized = false;
    private bool _isRefreshing = false;
    private string _lastHazardListHash = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!_isInitialized)
        {
            await InitializeStep4Data();
            _isInitialized = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var currentHazardListHash = GetHazardListHash();
        if (currentHazardListHash != _lastHazardListHash && !_isRefreshing)
        {
            _lastHazardListHash = currentHazardListHash;
            await InitializeStep4Data();
        }
    }

    private string GetHazardListHash()
    {
        if (AvailableHazards?.Any() != true) return "empty";
        var codes = string.Join(",", AvailableHazards.Select(h => h.Code).OrderBy(c => c));
        return $"{AvailableHazards.Count}:{codes.GetHashCode()}";
    }

    private async Task InitializeStep4Data()
    {
        if (_isRefreshing) return;
        
        try
        {
            _isRefreshing = true;
            await LoadHazardAverages();
            Logger.LogInformation("Initialized Step 4 data for {Count} hazards", AvailableHazards?.Count ?? 0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing Step 4 data");
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private async Task HandleHazardScored(string hazardCode)
    {
        try
        {
            Logger.LogInformation("Handling hazard scored: {HazardCode}", hazardCode);
            await LoadHazardAverages();
            
            // CRITICAL: Save Step 4 assessment data whenever hazard scores are updated
            await SaveCurrentRiskAssessmentAsync();
            
            if (Step4Changed.HasDelegate)
            {
                await Step4Changed.InvokeAsync(Step4);
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling hazard scored for {HazardCode}", hazardCode);
        }
    }

    /// <summary>
    /// Save the current risk assessment data when hazard scores are updated
    /// </summary>
    private async Task SaveCurrentRiskAssessmentAsync()
    {
        try
        {
            if (AvailableHazards?.Any() != true || !Step4.HazardAverageScores.Any())
            {
                Logger.LogInformation("Skipping risk assessment save - no completed hazard assessments");
                return;
            }

            // Calculate overall final scores from all hazard averages
            var (finalSeverity, finalLikelihood, finalRiskLevel, assessmentRationale) = CalculateOverallRiskAssessment();

            // Get the risk assessment ID from the current context
            var riskAssessmentId = GetCurrentRiskAssessmentId();
            if (string.IsNullOrEmpty(riskAssessmentId))
            {
                Logger.LogWarning("Cannot save risk assessment - no assessment ID available");
                return;
            }

            // Save Step 4 risk assessment data
            var saveStep4Command = new SaveStep4Command(
                riskAssessmentId,
                Step4.TolerabilityFramework,
                Step4.RiskAcceptanceCriteria,
                finalSeverity,
                finalLikelihood,
                finalRiskLevel,
                DetermineRiskTolerability(finalRiskLevel),
                assessmentRationale);

            var result = await Mediator.SendAsync(saveStep4Command, CancellationToken.None);

            if (result.IsSuccess)
            {
                Logger.LogInformation("Successfully saved Step 4 risk assessment data after hazard score update");
            }
            else
            {
                Logger.LogError("Failed to save Step 4 risk assessment: {Error}", result.Error?.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving current risk assessment");
        }
    }

    /// <summary>
    /// Calculate overall risk assessment from all completed hazard assessments
    /// </summary>
    private (int? finalSeverity, int? finalLikelihood, string finalRiskLevel, string assessmentRationale) CalculateOverallRiskAssessment()
    {
        var completedHazards = Step4.HazardAverageScores.Keys.ToList();
        
        if (!completedHazards.Any())
        {
            return (null, null, "Unknown", "No hazard assessments completed yet.");
        }

        // Use highest risk approach for final severity/likelihood
        var highestRiskHazard = Step4.HazardAverageScores.OrderByDescending(kvp => kvp.Value).First();
        var highestRiskHazardCode = highestRiskHazard.Key;

        // Get the matrix code for the highest risk hazard
        var highestRiskMatrixCode = Step4.HazardMatrixCodes.GetValueOrDefault(highestRiskHazardCode, "Unknown");

        // Parse matrix code back to severity/likelihood
        var (severity, likelihood) = ParseMatrixCode(highestRiskMatrixCode);
        
        // Determine final risk level using the centralized calculator
        var finalRiskLevel = severity.HasValue && likelihood.HasValue 
            ? AviationRiskMatrixCalculator.GetAviationRiskLevel(severity.Value, likelihood.Value)
            : "Unknown";

        // Calculate summary statistics
        var avgScores = Step4.HazardAverageScores.Values.ToList();
        var avgScore = avgScores.Average();
        var maxScore = avgScores.Max();

        // Build comprehensive assessment rationale
        var matrixCodesSummary = string.Join(", ", Step4.HazardMatrixCodes.Select(kvp => $"{kvp.Key}:{kvp.Value}"));
        var riskLevelsSummary = string.Join(", ", Step4.HazardRiskLevels.Select(kvp => $"{kvp.Key}:{kvp.Value}"));

        var rationale = $"Risk assessment based on {completedHazards.Count} hazard(s). " +
                       $"Highest risk hazard: {highestRiskHazardCode} (Matrix: {highestRiskMatrixCode}, Risk Level: {Step4.HazardRiskLevels.GetValueOrDefault(highestRiskHazardCode, "Unknown")}). " +
                       $"Score statistics: Average={avgScore:F2}, Maximum={maxScore:F2}. " +
                       $"Matrix codes: {matrixCodesSummary}. " +
                       $"Risk levels: {riskLevelsSummary}. " +
                       $"Final assessment: {finalRiskLevel} risk based on worst-case scenario approach. " +
                       $"Assessment completed on {DateTime.UtcNow:yyyy-MM-dd HH:mm} UTC.";

        return (severity, likelihood, finalRiskLevel, rationale);
    }

    /// <summary>
    /// Parse matrix code back to severity and likelihood values
    /// </summary>
    private (int? severity, int? likelihood) ParseMatrixCode(string matrixCode)
    {
        if (string.IsNullOrEmpty(matrixCode) || matrixCode.Length < 2) 
            return (null, null);

        // Extract severity (first part) and likelihood letter (last part)
        var severityPart = matrixCode.Substring(0, matrixCode.Length - 1);
        var likelihoodLetter = matrixCode.Substring(matrixCode.Length - 1);

        if (!int.TryParse(severityPart, out int severity))
            return (null, null);

        var likelihood = likelihoodLetter.ToUpper() switch
        {
            "A" => 1, "B" => 2, "C" => 3, "D" => 4, "E" => 5, _ => (int?)null
        };

        return (severity, likelihood);
    }

    /// <summary>
    /// Determine risk tolerability based on risk level
    /// </summary>
    private string DetermineRiskTolerability(string riskLevel)
    {
        return riskLevel switch
        {
            "High" => "Unacceptable",
            "Medium" => "Tolerable",
            "Low" => "Acceptable", 
            "Acceptable" => "Acceptable",
            _ => "Under Review"
        };
    }

    /// <summary>
    /// Get the current risk assessment ID from the parent context
    /// </summary>
    private string GetCurrentRiskAssessmentId()
    {
        if (!string.IsNullOrEmpty(RiskAssessmentId))
        {
            return RiskAssessmentId;
        }
        
        // Fallback - this should not happen in normal operation
        Logger.LogWarning("No RiskAssessmentId parameter provided to TechnicalAssessmentStep4");
        return string.Empty;
    }

    private string GetSeverityLabel(int severity)
    {
        return severity switch
        {
            5 => "Catastrophic", 4 => "Major", 3 => "Serious", 2 => "Moderate", 1 => "Minor", _ => ""
        };
    }

    private List<string> GetHazardsAtMatrixCode(int severity, int likelihood)
    {
        var targetMatrixCode = AviationRiskMatrixCalculator.GetMatrixCode(severity, likelihood);
        return Step4.HazardMatrixCodes
            .Where(kvp => kvp.Value == targetMatrixCode)
            .Select(kvp => kvp.Key)
            .OrderBy(h => h)
            .ToList();
    }

    private string GetMatrixCode(int severity, int likelihood)
    {
        return AviationRiskMatrixCalculator.GetMatrixCode(severity, likelihood);
    }
    
    private string GetAviationMatrixCellStyle(int severity, int likelihood)
    {
        return AviationRiskMatrixCalculator.GetMatrixCellStyle(severity, likelihood);
    }
    
    private string GetAviationRiskLevel(int severity, int likelihood)
    {
        return AviationRiskMatrixCalculator.GetAviationRiskLevel(severity, likelihood);
    }

    private async Task LoadHazardAverages()
    {
        if (AvailableHazards?.Any() != true) return;
        
        try
        {
            Step4.HazardAverageScores.Clear();
            Step4.HazardRiskLevels.Clear();
            Step4.HazardMatrixCodes.Clear();

            foreach (var hazard in AvailableHazards)
            {
                var query = new GetScoringPanelsByHazardCodeQuery(hazard.Code);
                var result = await Mediator.SendAsync(query, CancellationToken.None);

                if (result.IsSuccess && result.Value?.Any() == true)
                {
                    var completedPanels = result.Value
                        .Where(p => p.Severity.HasValue && p.Likelihood.HasValue && p.Score.HasValue)
                        .ToList();

                    if (completedPanels.Any())
                    {
                        // Use centralized calculator for consistency
                        var matrixCode = AviationRiskMatrixCalculator.CalculateHazardMatrixCodeWithDebug(
                            hazard.Code, 
                            completedPanels, 
                            msg => Logger.LogInformation(msg));
                        
                        // Calculate other values using centralized methods
                        var avgSeverity = completedPanels.Average(p => p.Severity!.Value);
                        var avgLikelihood = completedPanels.Average(p => p.Likelihood!.Value);
                        var avgScore = completedPanels.Average(p => (double)p.Score!.Value);
                        
                        var roundedSeverity = (int)Math.Round(avgSeverity);
                        var roundedLikelihood = (int)Math.Round(avgLikelihood);
                        
                        Step4.HazardAverageScores[hazard.Code] = avgScore;
                        Step4.HazardRiskLevels[hazard.Code] = AviationRiskMatrixCalculator.GetAviationRiskLevel(roundedSeverity, roundedLikelihood);
                        Step4.HazardMatrixCodes[hazard.Code] = matrixCode;
                    }
                }
            }
            
            Logger.LogInformation("Loaded averages for {Count} hazards", Step4.HazardAverageScores.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading hazard averages");
        }
    }
}