@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Pages.SMSRiskManagement
@using SMS3.Components.Pages.SMSRiskManagement.Models
@using SMS3.Components.Shared.UIHelpers
@using SMS_Application.Interfaces
@using SMS_Application.Commands
@using SMS_Application.Queries
@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using SMS_Domain.ValueObjects
@using SMS_Shared.Common
@using SMS3.Configuration
@using global::System.Text.Json

@inject IBaseMediator Mediator
@inject ILogger<HazardMitigationCard> Logger
@inject NotificationService NotificationService

<style>
    .analysis-header-hover:hover {
        background-color: rgba(0, 0, 0, 0.03);
        border-radius: 4px;
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@{
    var cardColorClass = NeedsMitigation ? (HasMitigations() ? "var(--rz-base)" : "var(--rz-warning)") : "var(--rz-success)";
    var initialRiskLevel = GetInitialRiskLevel();
}
<!-- Header -->
@* <div style="background-color: #212e61 !important; color: white; padding: 1rem 1.25rem; margin: -1rem -1rem 0 -1rem; border-radius: 8px 8px 0 0;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <i class="fas fa-user-check" style="font-size: 1.25rem; opacity: 0.9;"></i>
        <div>
            <h5 style="margin: 0; font-weight: 600; font-size: 1.1rem;">
                Rationale for @HazardCode risk assessment @MatrixCode score
            </h5>
        </div>
    </div>
</div> *@
<RadzenCard Variant="Variant.Outlined" Style="">
    <RadzenStack Gap="1rem">
        <!-- Hazard Header -->
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="8">
               
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenStack AlignItems="AlignItems.End" Gap="0.25rem">
                    <RadzenButton Text="Add Strategy" Icon="build" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Medium"
                                  Click="@AddMitigationStrategy" Style="float: right;" Disabled="@(IsLoading || DisableAddMitigation)" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        @if (NeedsMitigation)
        {
            <!-- Mitigation Strategies Section -->
            <RadzenFieldset Text="" Style="font-weight: bold; margin: 0;">
                <RadzenStack Gap="1rem">
                    
                    <!-- Mitigation Strategies List -->
                    @if (IsLoading)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Base" Icon="hourglass_empty" ShowIcon="true">
                            <RadzenText TextStyle="TextStyle.Body2" Text="Loading mitigation strategies..." />
                        </RadzenAlert>
                    }
                    else if (LoadedMitigations.Any())
                    {
                        <br />
                        @foreach (var mitigation in LoadedMitigations.OrderBy(m => m.TargetDate))
                        {
                            <RadzenRow>
                                <RadzenColumn Size="3">
                                    <RadzenStack Gap="0.25rem">
                                        <RadzenText TextStyle="TextStyle.Subtitle1">
                                            <strong>Mitigation: </strong>  @mitigation.Code
                                        </RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="9">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.25rem">
                                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                                      Click="@(() => EditMitigation(mitigation))" Disabled="@(IsLoading || DisableAddMitigation)" />
                                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                      Click="@(() => DeleteMitigation(mitigation))" Disabled="@(IsLoading || DisableAddMitigation)" />
                                    </RadzenStack>
                                </RadzenColumn>
                               
                            </RadzenRow>
                            <RadzenCard Style="background-color: #fff8e1; border-left: 4px solid #ff9800;">
                                <RadzenStack Gap="1rem">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="9">
                                            <RadzenStack Gap="0.25rem">
                                                <RadzenText TextStyle="TextStyle.Subtitle2" Text="@($"{mitigation.Name}")" Style="margin: 0; color: #212e61;" />
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                                    <RadzenBadge Text="@($"Status: {mitigation.Status?.Name ?? mitigation.Status?.Value ?? "Unknown"}")"
                                                                 BadgeStyle="BadgeStyle.Primary" />
                                                    
                                                   
                                                    <RadzenBadge Text="@($"{mitigation.Progress}% Complete")" BadgeStyle="BadgeStyle.Base" />
                                                    
                                                </RadzenStack>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        
                                    </RadzenRow>

                                    <RadzenText TextStyle="TextStyle.Body2" Text="@mitigation.Description" />

                                    @if (mitigation.TargetDate.HasValue || !string.IsNullOrEmpty(mitigation.AssignedDepartment))
                                    {
                                        <RadzenRow Gap="1rem">
                                            @if (mitigation.TargetDate.HasValue)
                                            {
                                                <RadzenColumn Size="6">
                                                    <RadzenText TextStyle="TextStyle.Caption" Text="@($"Target: {mitigation.TargetDate.Value:MMM dd, yyyy}")" />
                                                </RadzenColumn>
                                            }
                                            @if (!string.IsNullOrEmpty(mitigation.AssignedDepartment))
                                            {
                                                <RadzenColumn Size="6">
                                                    <RadzenText TextStyle="TextStyle.Caption" Text="@($"Assigned Organization: {mitigation.AssignedDepartment}")" />
                                                </RadzenColumn>
                                            }
                                        </RadzenRow>
                                    }

                                    @if (mitigation.EstimatedCost.HasValue )
                                    {
                                        <RadzenRow Gap="1rem">
                                            @if (mitigation.EstimatedCost.HasValue)
                                            {
                                                <RadzenColumn Size="6">
                                                    <RadzenText TextStyle="TextStyle.Caption" Text="@($"Est. Cost: {mitigation.EstimatedCost.Value:C}")" />
                                                </RadzenColumn>
                                            }
                                           
                                        </RadzenRow>
                                    }
                                </RadzenStack>
                            </RadzenCard>
                        }
                    }
                    else
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info" Icon="info" ShowIcon="true">
                            <RadzenText TextStyle="TextStyle.Body2" Text="Add mitigation strategies above. Each strategy can include cost estimates, priorities, and organization assignments." />
                        </RadzenAlert>
                    }
                </RadzenStack>
            </RadzenFieldset>

            <!-- Residual Risk Assessment Section (only show if we have mitigations) -->
            
        }
        else
        {
            <!-- Monitoring Only for Acceptable Risks -->
            <RadzenFieldset Text="Monitoring & Review Requirements">
                <RadzenAlert AlertStyle="AlertStyle.Success" Icon="visibility" ShowIcon="true">
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Monitoring Frequency" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@MonitoringFrequency" Data="@MonitoringFrequencies"
                                                Placeholder="Select frequency..." Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Responsible Organization" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@MonitoringDepartment" Data="@Departments"
                                                Placeholder="Select organization..." Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Review Trigger" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="@ReviewTrigger" Placeholder="What triggers a review?" Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenAlert>
            </RadzenFieldset>
        }
    </RadzenStack>
</RadzenCard>

<!-- Mitigation Edit/Add Dialog -->
@if (ShowMitigationDialog)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <RadzenCard Style="width: 1250px; max-width: 96vw; max-height: 92vh; overflow-y: auto;">
            <RadzenStack Gap="1rem">
                <RadzenRow AlignItems="AlignItems.Center" Style="background-color: #212e61 !important; color: white; padding: 1rem 1.25rem; margin: -1rem -1rem 0 -1rem; border-radius: 8px 8px 0 0;">
                    <RadzenColumn Size="10">
                        <RadzenText TextStyle="TextStyle.H6" Style="color:white; margin: 0;">
                            <RadzenIcon Icon="@(IsEditMode ? "edit" : "add")" Style="margin-right: 0.5rem;" />
                            @(IsEditMode ? $"Edit Mitigation: {CurrentMitigation?.Code}" : $"Add New Mitigation for {Hazard.Code}")
                        </RadzenText>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="0.5rem" Style="width: 100%; margin: 0;">
                    <RadzenColumn Size="9" SizeMD="9" Style="padding-right: 0.25rem;">
                        <MitigationEditorFields Model="@CurrentMitigation"
                                                DisableInputs="@DisableAddMitigation"
                                                EnableStatusEdit="true"
                                                ControlTypeOptions="@ControlTypes"
                                                StatusOptions="@StatusLevels"
                                                DepartmentOptions="@Departments" />
                    </RadzenColumn>
                    <RadzenColumn Size="3" SizeMD="3" Style="padding-left: 0.25rem; min-width: 260px;">
                        <div style="max-height: 74vh; overflow-y: auto;">
                            <MitigationGuidance />
                        </div>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseMitigationDialog" />
                    <RadzenButton Text="@(IsEditMode ? "Update" : "Create")" Icon="@(IsEditMode ? "save" : "add")" 
                                  ButtonStyle="ButtonStyle.Primary" Click="@SaveMitigation" Disabled="@(IsSaving || DisableAddMitigation)" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </div>
}

<!-- Residual Panel Management Dialog -->
@if (ShowResidualPanelDialog)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <RadzenCard Style="width: 800px; max-width: 90vw; max-height: 80vh; overflow-y: auto;">
            <RadzenStack Gap="1rem">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="10">
                        <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-info); margin: 0;">
                            <RadzenIcon Icon="people" Style="margin-right: 0.5rem;" />
                            Manage Residual Risk Panel for @Hazard.Code
                        </RadzenText>
                    </RadzenColumn>
                    <RadzenColumn Size="2">
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" 
                                      Click="@(() => ShowResidualPanelDialog = false)" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenAlert AlertStyle="AlertStyle.Info" Icon="info" ShowIcon="true">
                    <RadzenText TextStyle="TextStyle.Body2" Text="@($"Managing residual risk panel for: {Hazard.Code} - {Hazard.Description}")" />
                </RadzenAlert>

                <!-- Available Stakeholders -->
                <RadzenDataGrid Data="@GetResidualStakeholdersForSelection()" TItem="ResidualStakeholderSelectionItem" AllowPaging="false">
                    <Columns>
                        <RadzenDataGridColumn TItem="ResidualStakeholderSelectionItem" Title="Select">
                            <Template Context="stakeholder">
                                <RadzenCheckBox @bind-Value="@stakeholder.IsSelected" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ResidualStakeholderSelectionItem" Property="Name" Title="Name" />
                        <RadzenDataGridColumn TItem="ResidualStakeholderSelectionItem" Property="Organization" Title="Organization" />
                        <RadzenDataGridColumn TItem="ResidualStakeholderSelectionItem" Property="Role" Title="Role" />
                    </Columns>
                </RadzenDataGrid>

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => ShowResidualPanelDialog = false)" />
                    <RadzenButton Text="Update Panel" Icon="save" ButtonStyle="ButtonStyle.Info" Click="@UpdateResidualPanel" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </div>
}

