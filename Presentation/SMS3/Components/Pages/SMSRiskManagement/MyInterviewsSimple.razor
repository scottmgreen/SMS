@page "/SMSRiskManagement/MyInterviews"
@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared

<PageTitle>My Interviews - SMS3</PageTitle>

<!-- SMS Page Header -->
<PageHeader Title="My Interviews"
           Subtitle="Manage and conduct your assigned investigation interviews"
           Icon="fas fa-user-friends" />

<!-- Standard 8x4 Layout -->
<RadzenRow Gap="1rem">
    <!-- Main Content Column (8/12) -->
    <RadzenColumn Size="8">
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <!-- Filter and Summary Section -->
                <RadzenCard Variant="Variant.Outlined" Style="background-color: var(--rz-base-50); padding: 1rem;">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">
                            Interview Dashboard
                        </RadzenText>
                        <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Light" 
                                    Click="@RefreshInterviews" Title="Refresh" Size="ButtonSize.Small" />
                    </RadzenStack>
                </RadzenCard>

                @if (IsLoading)
                {
                    <div style="text-align: center; padding: 3rem;">
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
                        <RadzenText TextStyle="TextStyle.H6" Style="margin-top: 1rem;">Loading your interviews...</RadzenText>
                    </div>
                }
                else if (!FilteredInterviews.Any())
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" Icon="info" Title="No Interviews Found">
                        You don't have any assigned interviews at the moment.
                    </RadzenAlert>
                }
                else
                {
                    <!-- All Interviews Section -->
                    <RadzenCard Variant="Variant.Text">
                        <RadzenStack Gap="0.75rem">
                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">
                                All Assigned Interviews (@FilteredInterviews.Count)
                            </RadzenText>
                            
                            <RadzenDataList Data="@FilteredInterviews" TItem="Interview">
                                <Template Context="interview">
                                    <RadzenCard Variant="Variant.Outlined" Style="margin-bottom: 1rem;">
                                        <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
                                            <RadzenColumn Size="12" SizeMD="7">
                                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                                                    <!-- Person and Investigation Info -->
                                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                                        <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0; font-weight: 600;">
                                                            @interview.PersonInterviewed
                                                        </RadzenText>
                                                        <RadzenBadge Text="@interview.Status.Name" BadgeStyle="@GetInterviewStatusBadge(interview)" IsPill="true" />
                                                    </RadzenStack>
                                                    
                                                    <!-- Investigation Reference -->
                                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-info);">
                                                        <RadzenIcon Icon="folder" Style="font-size: 12px; margin-right: 0.25rem;" />
                                                        Investigation: @interview.InvestigationCode
                                                    </RadzenText>
                                                </RadzenStack>
                                            </RadzenColumn>
                                            
                                            <!-- Action Buttons -->
                                            <RadzenColumn Size="12" SizeMD="5" Style="text-align: end;">
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                                                    @if (interview.IsScheduled)
                                                    {
                                                        <RadzenButton Text="Start Interview"
                                                                    Icon="play_arrow" 
                                                                    ButtonStyle="ButtonStyle.Success" 
                                                                    Size="ButtonSize.Small"
                                                                    Click="@(() => StartInterview(interview))" />
                                                    }
                                                    
                                                    @if (interview.IsInProgress)
                                                    {
                                                        <RadzenButton Text="Conduct"
                                                                    Icon="record_voice_over" 
                                                                    ButtonStyle="ButtonStyle.Warning" 
                                                                    Size="ButtonSize.Small"
                                                                    Click="@(() => ConductInterview(interview))" />
                                                    }
                                                    
                                                    <RadzenButton Icon="edit" 
                                                                ButtonStyle="ButtonStyle.Primary" 
                                                                Size="ButtonSize.Small"
                                                                Click="@(() => EditInterview(interview))" 
                                                                Title="Edit Interview" />
                                                </RadzenStack>
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </RadzenCard>
                                </Template>
                            </RadzenDataList>
                        </RadzenStack>
                    </RadzenCard>
                }
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>

    <!-- Guidance Panel Column (4/12) -->
    <RadzenColumn Size="4">
        <InvestigationsGuidance />
    </RadzenColumn>
</RadzenRow>