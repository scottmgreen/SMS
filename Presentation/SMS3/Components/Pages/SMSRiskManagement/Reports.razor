@page "/SMSRiskManagement/Reports"
@using SMS3.Components.Shared

<PageTitle>SMS Reports Management - PDXSMS</PageTitle>

<!-- SMS Page Header using reusable component -->
<PageHeader Title="SMS Reports Management"
           Subtitle="Comprehensive listing of all SMS reports with expandable hazard details"
           Icon="fas fa-file-alt" />

@if (!IsAuthenticated)
{
    <!-- Unauthorized Access -->
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
        <strong>Access Denied:</strong> You must be logged in to view SMS reports.
    </RadzenAlert>
}
else if (IsLoading)
{
    <!-- Loading State -->
    <div class="text-center py-5">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        <p class="mt-3 text-muted">Loading SMS reports...</p>
    </div>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
    <!-- Error State -->
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
        <strong>Error:</strong> @ErrorMessage
        <div class="mt-2">
            <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                         Text="Try Again" 
                         Click="RefreshAsync" 
                         Size="ButtonSize.Small" />
        </div>
    </RadzenAlert>
}
else
{
    <!-- Main Content -->
    <div class="row">
        <div class="col-12">
            <RadzenCard>
                <!-- Toolbar -->
                <div class="row mb-3 align-items-center">
                    <div class="col">
                        <h5 class="mb-0">
                            <i class="fas fa-list me-2"></i>Reports List
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" 
                                        Text="@AllReports.Count.ToString()" 
                                        Variant="Variant.Flat" 
                                        Class="ms-2" />
                        </h5>
                    </div>
                    <div class="col-auto">
                        <div class="d-flex align-items-center gap-3">
                            <!-- Create New Report Button -->
                            <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                        Text="Create New Report" 
                                        Click="@NavigateToHazardReporting" 
                                        Size="ButtonSize.Medium" />
                            
                            <!-- Page Size Selector -->
                            <div class="d-flex align-items-center">
                                <small class="text-muted me-2">Show:</small>
                                <RadzenDropDown @bind-Value="PageSize" 
                                               Data="@PageSizeOptions" 
                                               Change="OnPageSizeChanged"
                                               Style="width: 80px;" />
                            </div>
                            
                            <!-- Refresh Button -->
                            <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                         Text="Refresh" 
                                         Click="RefreshAsync" 
                                         Size="ButtonSize.Small" />
                        </div>
                    </div>
                </div>

                @if (!AllReports.Any())
                {
                    <!-- Empty State -->
                    <div class="text-center py-5">
                        <i class="fas fa-file-alt text-muted" style="font-size: 4rem;"></i>
                        <h5 class="mt-3 text-muted">No Reports Found</h5>
                        <p class="text-muted">There are currently no reports in the system.</p>
                        <RadzenButton ButtonStyle="ButtonStyle.Success" 
                                    Text="Create Your First Report" 
                                    Click="NavigateToHazardReporting" 
                                    Size="ButtonSize.Large" />
                    </div>
                }
                else
                {
                    <!-- Pagination Controls (Top) -->
                    <div class="row align-items-center mb-3">
                        <div class="col">
                            <small class="text-muted">
                                Showing @((CurrentPage - 1) * PageSize + 1) to @(Math.Min(CurrentPage * PageSize, AllReports.Count)) of @AllReports.Count reports
                            </small>
                        </div>
                        <div class="col-auto">
                            <RadzenPager Count="@AllReports.Count" 
                                       PageSize="@PageSize" 
                                       PageNumbersCount="5"
                                       PageChanged="@(async (args) => await OnPageChanged(args.PageIndex))" />
                        </div>
                    </div>

                    <!-- Reports Accordion -->
                    <div class="rz-p-sm-12">
                        <RadzenAccordion class="sms-report-accordion" Multiple="true">
                            <Items>
                                @foreach (var report in GetPaginatedReports())
                                {
                                    <RadzenAccordionItem Text="@GetReportDisplayText(report)" Icon="assignment">

                                        <!-- Hazard Details Content -->
                                        <div class="p-3">
                                            <!-- Report Header with Action Buttons -->
                                            <div class="d-flex align-items-start justify-content-between mb-3 p-2 bg-light rounded">
                                                <div class="me-3">
                                                    <strong class="text-primary">Report Details</strong>
                                                </div>
                                                
                                                <!-- Action Buttons - Right Justified -->
                                                <div class="d-flex align-items-end gap-1 ms-auto">
                                                    <RadzenButton ButtonStyle="ButtonStyle.Info" 
                                                                Size="ButtonSize.Small"
                                                                Click="@(() => OnViewReportAsync(report))"
                                                                title="View Details">
                                                        <Template>
                                                            <i class="fas fa-eye"></i>
                                                        </Template>
                                                    </RadzenButton>
                                                    <RadzenButton ButtonStyle="ButtonStyle.Warning" 
                                                                Size="ButtonSize.Small"
                                                                Click="@(() => OnEditReportAsync(report))"
                                                                title="Edit Report">
                                                        <Template>
                                                            <i class="fas fa-edit"></i>
                                                        </Template>
                                                    </RadzenButton>
                                                    <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                                                Size="ButtonSize.Small"
                                                                Click="@(() => OnDeleteReportAsync(report))"
                                                                title="Delete Report">
                                                        <Template>
                                                            <i class="fas fa-trash"></i>
                                                        </Template>
                                                    </RadzenButton>
                                                </div>
                                            </div>

                                            <!-- Hazard Details -->
                                            <SMS3.Components.Pages.SMSRiskManagement.Components.HazardDetails 
                                                ReportCode="@report.Code"
                                                OnViewHazardCallback="@((hazard) => OnViewHazard(hazard))"
                                                OnEditHazardCallback="@((hazard) => OnEditHazard(hazard))" />
                                        </div>
                                    </RadzenAccordionItem>
                                }
                            </Items>
                        </RadzenAccordion>
                    </div>

                    <!-- Pagination Controls (Bottom) -->
                    <div class="row align-items-center mt-3">
                        <div class="col">
                            <small class="text-muted">
                                Page @CurrentPage of @TotalPages
                            </small>
                        </div>
                        <div class="col-auto">
                            <RadzenPager Count="@AllReports.Count" 
                                       PageSize="@PageSize" 
                                       PageNumbersCount="5"
                                       PageChanged="@(async (args) => await OnPageChanged(args.PageIndex))" />
                        </div>
                    </div>
                }
            </RadzenCard>
        </div>
    </div>
}
