@page "/SMSRiskManagement/HazardMitigation/Edit/{MitigationCode}"

@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS_Application.Interfaces
@using SMS_Application.Commands
@using SMS_Application.Queries
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Shared.Common

<PageTitle>@PageTitle</PageTitle>

<!-- SMS Page Header -->
<PageHeader Title="@PageTitle"
           Subtitle="@PageSubtitle"
            Icon="fas fa-exclamation-triangle" />

<RadzenCard Variant="Variant.Outlined" Style="margin-bottom: 1rem;">
    <RadzenCard>
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="12">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem">
                    <RadzenButton Text="Hazard Description"
                                  Icon="description"
                                  ButtonStyle="ButtonStyle.Base"
                                  Variant="Variant.Filled"
                                  Size="ButtonSize.Small"
                                  Title="Click to view related hazard description"
                                  Class="description-button"
                                  Click="@ShowHazardDescriptionDialog" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>
</RadzenCard>

@if (IsLoading)
{
    <div class="text-center py-5">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        <p class="mt-3 text-muted">Loading hazard mitigation...</p>
    </div>
}
else
{
    <!-- 8x4 Layout with Form and Guidance Panel -->
    <RadzenRow Gap="1rem">
        <!-- Form Column (8/12) -->
        <RadzenColumn Size="8">
            <RadzenCard>
                <RadzenStack Gap="1rem" Class="rz-p-3">
                    <RadzenTemplateForm Data="@CurrentMitigation" Submit="@HandleFormSubmit" TItem="SMS_Domain.Entities.Mitigation">
                        
                        <!-- Basic Information Section -->
                        <RadzenFieldset Text="Basic Information" Style="margin-bottom: 1rem;">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenFormField Text="Mitigation Name *" Variant="Variant.Outlined" Style="width: 100%;">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenTextBox @bind-Value="@CurrentMitigation.Name" 
                                                         Placeholder="Enter mitigation name..."
                                                         Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Type" Variant="Variant.Outlined" Style="width: 100%;">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenDropDown @bind-Value="@CurrentMitigation.Type" Data="@ControlTypes"
                                                            Placeholder="Select type..."
                                                            Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                <RadzenColumn Size="12">
                                    <RadzenFormField Text="Description *" Variant="Variant.Outlined" Style="width: 100%;">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenTextArea @bind-Value="@CurrentMitigation.Description" Rows="4"
                                                          Placeholder="Describe the mitigation strategy in detail..."
                                                          Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenFieldset>

                        <!-- Timeline Section -->
                        <RadzenFieldset Text="Priority & Timeline" Style="margin-bottom: 1rem;">
                            <RadzenRow Gap="1rem">
                                
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Status" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            @if (_isEditMode)
                                            {
                                                <RadzenDropDown @bind-Value="@_selectedMitigationStatus"
                                                                Data="@_mitigationStatusOptions"
                                                                Placeholder="Select status..."
                                                                Style="width: 100%; min-width: 100%;" />
                                            }
                                            else
                                            {
                                                <RadzenTextBox Value="@CurrentMitigation.Status.Value"
                                                               ReadOnly="true"
                                                               Style="width: 100%; min-width: 100%;" />
                                            }
                                        }
                                        @* <RadzenTextBox @bind-Value="@(CurrentMitigation?.Status "
                                                       Placeholder="Enter mitigation name..."
                                                       Style="width: 100%; min-width: 100%;" </RadzenTextBox> *@
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Approved By" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @* <RadzenText>@(CurrentMitigation?.ApprovedBy ?? "Not Assigned")</RadzenText> *@
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenTextBox Value="@CurrentMitigation.ApprovedBy"
                                                           Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Progress %" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenNumeric @bind-Value="@CurrentMitigation.Progress" Min="0" Max="100" 
                                                         Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Target Date" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenDatePicker @bind-Value="@CurrentMitigation.TargetDate" DateFormat="yyyy-MM-dd" 
                                                            Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                                
                            </RadzenRow>
                        </RadzenFieldset>

                        <!-- Assignment & Resources Section -->
                        <RadzenFieldset Text="Assignment & Resources" Style="margin-bottom: 1rem;">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Assigned Department" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenDropDown @bind-Value="@CurrentMitigation.AssignedDepartment" Data="@Departments"
                                                            Placeholder="Select department..."
                                                            Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Assigned To" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenTextBox @bind-Value="@CurrentMitigation.AssignedTo" 
                                                         Placeholder="Person responsible..."
                                                         Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Estimated Cost" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenNumeric @bind-Value="@CurrentMitigation.EstimatedCost" Format="c" 
                                                         Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Estimated Hours" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenNumeric @bind-Value="@CurrentMitigation.EstimatedHours" 
                                                         Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                <RadzenColumn Size="12">
                                    <RadzenFormField Text="Resource Requirements" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenTextArea @bind-Value="@CurrentMitigation.ResourceRequirements" Rows="3"
                                                          Placeholder="Describe required resources..."
                                                          Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenFieldset>

                        <!-- Action Buttons -->
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                            <RadzenButton Text="Cancel" Icon="cancel" ButtonStyle="ButtonStyle.Danger"
                                        Click="@CancelAndReturn" />
                            
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenButton Text="@GetSaveButtonText()" 
                                            Icon="@GetSaveButtonIcon()" 
                                            ButtonStyle="ButtonStyle.Primary"
                                            Click="@SaveMitigation" Disabled="@IsSaving" />
                                
                                @if (IsSaving)
                                {
                                    <RadzenProgressBarCircular ShowValue="false" Size="ProgressBarCircularSize.Small" />
                                }
                            </RadzenStack>
                        </RadzenStack>

                    </RadzenTemplateForm>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <!-- Guidance Panel Column (4/12) -->
        <RadzenColumn Size="4">
            <MitigationGuidance />
        </RadzenColumn>
    </RadzenRow>
}

@if (_showHazardDescriptionModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-md">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-exclamation-triangle"></i> Hazard Description - @_selectedHazardCode
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Text"
                                      Icon="close"
                                      Size="ButtonSize.Small"
                                      Click="@CloseHazardDescriptionModal" />
                    </div>
                </div>
                <div class="sms-modal-body">
                    <RadzenCard Variant="Variant.Outlined">
                        <div class="p-3">
                            <div style="line-height: 1.6; white-space: normal;">
                                @((MarkupString)_selectedHazardDescription)
                            </div>
                        </div>
                    </RadzenCard>
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end">
                        <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                      Text="Close"
                                      Icon="close"
                                      Click="@CloseHazardDescriptionModal"
                                      Size="ButtonSize.Medium" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 1rem;
    }

    .sms-modal-dialog {
        position: relative;
        margin: 0 auto;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
    }

    .sms-modal-md {
        max-width: 700px;
        width: 100%;
    }

    .sms-modal-content {
        background: white;
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    }

    .sms-modal-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e9ecef;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .sms-header-primary {
        background-color: #212e61;
        color: white;
    }

    .sms-modal-title {
        margin: 0;
        font-weight: 600;
    }

    .sms-modal-body {
        max-height: calc(100vh - 200px);
        overflow-y: auto;
    }

    .sms-modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid #e9ecef;
        border-radius: 0 0 0.5rem 0.5rem;
    }

    .text-muted {
        color: var(--rz-text-disabled-color);
        font-style: italic;
    }

    /* Ensure proper input sizing with Radzen 
    ::deep .rz-textbox,
    ::deep .rz-dropdown,
    ::deep .rz-textarea,
    ::deep .rz-datepicker,
    ::deep .rz-numeric {
        width: 100% !important;
        min-width: 100% !important;
    }

    Ensure FormField containers take full width 
    ::deep .rz-formfield {
        width: 100% !important;
    }

    Make sure dropdowns are responsive and fill container 
    ::deep .rz-dropdown {
        display: block !important;
        width: 100% !important;
    }
        */
</style>