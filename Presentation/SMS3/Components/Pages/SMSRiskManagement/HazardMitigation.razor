@page "/SMSRiskManagement/HazardMitigation/Edit/{MitigationCode}"

@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS_Application.Interfaces
@using SMS_Application.Messaging.Commands
@using SMS_Application.Messaging.Queries
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Shared.Common

<PageTitle>@PageTitle</PageTitle>

<!-- SMS Page Header -->
<PageHeader Title="@PageTitle"
           Subtitle="@PageSubtitle"
           Icon="fas fa-shield-alt" />

@if (IsLoading)
{
    <div class="text-center py-5">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        <p class="mt-3 text-muted">Loading hazard mitigation...</p>
    </div>
}
else
{
    <!-- 8x4 Layout with Form and Guidance Panel -->
    <RadzenRow Gap="1rem">
        <!-- Form Column (8/12) -->
        <RadzenColumn Size="8">
            <RadzenCard>
                <RadzenStack Gap="1rem" Class="rz-p-3">
                    
                    @if (IsEditMode && CurrentMitigation is not null)
                    {
                        <!-- Edit Mode Header -->
                        <RadzenAlert Size="AlertSize.Small" Variant="Variant.Flat" AlertStyle="AlertStyle.Info">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenIcon Icon="edit" />
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">
                                        <strong>Editing Mitigation:</strong> @CurrentMitigation.Code
                                    </RadzenText>
                                    @if (!string.IsNullOrEmpty(CurrentMitigation.HazardCode))
                                    {
                                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                                            <span>Hazard: @CurrentMitigation.HazardCode</span>
                                        </RadzenText>
                                    }
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenAlert>
                    }

                    <RadzenTemplateForm Data="@CurrentMitigation" Submit="@HandleFormSubmit" TItem="SMS_Domain.Entities.Mitigation">
                        
                        <!-- Basic Information Section -->
                        <RadzenFieldset Text="Basic Information" Style="margin-bottom: 1rem;">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenFormField Text="Mitigation Name *" Variant="Variant.Outlined" Style="width: 100%;">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenTextBox @bind-Value="@CurrentMitigation.Name" 
                                                         Placeholder="Enter mitigation name..."
                                                         Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Type" Variant="Variant.Outlined" Style="width: 100%;">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenDropDown @bind-Value="@CurrentMitigation.Type" Data="@ControlTypes"
                                                            Placeholder="Select type..."
                                                            Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                <RadzenColumn Size="12">
                                    <RadzenFormField Text="Description *" Variant="Variant.Outlined" Style="width: 100%;">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenTextArea @bind-Value="@CurrentMitigation.Description" Rows="4"
                                                          Placeholder="Describe the mitigation strategy in detail..."
                                                          Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenFieldset>

                        <!-- Timeline Section -->
                        <RadzenFieldset Text="Priority & Timeline" Style="margin-bottom: 1rem;">
                            <RadzenRow Gap="1rem">
                                
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Status" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenTextBox Value="@CurrentMitigation.Status.ToString()"
                                                           Style="width: 100%; min-width: 100%;" />
                                        }
                                        @* <RadzenTextBox @bind-Value="@(CurrentMitigation?.Status "
                                                       Placeholder="Enter mitigation name..."
                                                       Style="width: 100%; min-width: 100%;" </RadzenTextBox> *@
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Approved By" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @* <RadzenText>@(CurrentMitigation?.ApprovedBy ?? "Not Assigned")</RadzenText> *@
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenTextBox Value="@CurrentMitigation.ApprovedBy"
                                                           Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Progress %" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenNumeric @bind-Value="@CurrentMitigation.Progress" Min="0" Max="100" 
                                                         Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Target Date" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenDatePicker @bind-Value="@CurrentMitigation.TargetDate" DateFormat="yyyy-MM-dd" 
                                                            Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                                
                            </RadzenRow>
                        </RadzenFieldset>

                        <!-- Assignment & Resources Section -->
                        <RadzenFieldset Text="Assignment & Resources" Style="margin-bottom: 1rem;">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Assigned Department" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenDropDown @bind-Value="@CurrentMitigation.AssignedDepartment" Data="@Departments"
                                                            Placeholder="Select department..."
                                                            Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Assigned To" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenTextBox @bind-Value="@CurrentMitigation.AssignedTo" 
                                                         Placeholder="Person responsible..."
                                                         Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Estimated Cost" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenNumeric @bind-Value="@CurrentMitigation.EstimatedCost" Format="c" 
                                                         Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Estimated Hours" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenNumeric @bind-Value="@CurrentMitigation.EstimatedHours" 
                                                         Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                <RadzenColumn Size="12">
                                    <RadzenFormField Text="Resource Requirements" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                        @if (CurrentMitigation is not null)
                                        {
                                            <RadzenTextArea @bind-Value="@CurrentMitigation.ResourceRequirements" Rows="3"
                                                          Placeholder="Describe required resources..."
                                                          Style="width: 100%; min-width: 100%;" />
                                        }
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenFieldset>

                        <!-- Action Buttons -->
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                            <RadzenButton Text="Cancel" Icon="cancel" ButtonStyle="ButtonStyle.Secondary"
                                        Click="@CancelAndReturn" />
                            
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                <RadzenButton Text="@GetSaveButtonText()" 
                                            Icon="@GetSaveButtonIcon()" 
                                            ButtonStyle="ButtonStyle.Primary"
                                            Click="@SaveMitigation" Disabled="@IsSaving" />
                                
                                @if (IsSaving)
                                {
                                    <RadzenProgressBarCircular ShowValue="false" Size="ProgressBarCircularSize.Small" />
                                }
                            </RadzenStack>
                        </RadzenStack>

                    </RadzenTemplateForm>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <!-- Guidance Panel Column (4/12) -->
        <RadzenColumn Size="4">
            <GuidancePanel Title="Mitigation Guidelines" Icon="shield">
                
                <!-- Mitigation Types Guidance -->
                <RadzenStack Gap="1rem">
                    <RadzenStack Gap="0.5rem">
                        <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-primary); margin: 0;">Mitigation Types:</RadzenText>
                        <RadzenStack Gap="0.25rem">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <RadzenIcon Icon="block" Style="color: var(--rz-danger); font-size: 0.9rem;" />
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Eliminate:</strong> Remove the hazard completely</RadzenText>
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <RadzenIcon Icon="engineering" Style="color: var(--rz-warning); font-size: 0.9rem;" />
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Engineering:</strong> Physical controls (barriers, alarms)</RadzenText>
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <RadzenIcon Icon="policy" Style="color: var(--rz-info); font-size: 0.9rem;" />
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Administrative:</strong> Procedures, training, signs</RadzenText>
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <RadzenIcon Icon="security" Style="color: var(--rz-success); font-size: 0.9rem;" />
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>PPE:</strong> Personal protective equipment</RadzenText>
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenStack>

                    <!-- Priority Guidelines -->
                    <RadzenStack Gap="0.5rem">
                        <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-primary); margin: 0;">Priority Levels:</RadzenText>
                        <RadzenStack Gap="0.25rem">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <RadzenBadge Text="Critical" BadgeStyle="BadgeStyle.Danger" />
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Immediate action required</RadzenText>
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <RadzenBadge Text="High" BadgeStyle="BadgeStyle.Warning" />
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Within 30 days</RadzenText>
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <RadzenBadge Text="Medium" BadgeStyle="BadgeStyle.Info" />
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Within 90 days</RadzenText>
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <RadzenBadge Text="Low" BadgeStyle="BadgeStyle.Success" />
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Within 1 year</RadzenText>
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenStack>

                    <!-- Best Practices -->
                    <RadzenStack Gap="0.5rem">
                        <RadzenText TextStyle="TextStyle.Subtitle1" Style="color: var(--rz-primary); margin: 0;">Best Practices:</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Follow the hierarchy of controls:</RadzenText>
                        <RadzenStack Gap="0.25rem">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; color: var(--rz-text-secondary-color);">1.</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Eliminate hazards first</RadzenText>
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; color: var(--rz-text-secondary-color);">2.</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Use engineering controls</RadzenText>
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; color: var(--rz-text-secondary-color);">3.</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Implement administrative controls</RadzenText>
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; color: var(--rz-text-secondary-color);">4.</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">Use PPE as last resort</RadzenText>
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenStack>

                    <!-- Implementation Tips -->
                    <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" Variant="Variant.Flat">
                        <RadzenStack Gap="0.5rem" AlignItems="AlignItems.Center">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">Implementation Tips:</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; text-align: center;">
                                • Set realistic target dates<br/>
                                • Assign clear responsibilities<br/>
                                • Define measurable outcomes<br/>
                                • Monitor progress regularly
                            </RadzenText>
                        </RadzenStack>
                    </RadzenAlert>

                    <!-- Contact Info -->
                    <RadzenAlert AlertStyle="AlertStyle.Base" Size="AlertSize.Small" Variant="Variant.Flat">
                        <RadzenStack Gap="0.5rem" AlignItems="AlignItems.Center">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">Need Help?</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; text-align: center;">SMS Team: (503) 555-0100</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; text-align: center;">sms@flypdx.com</RadzenText>
                        </RadzenStack>
                    </RadzenAlert>

                </RadzenStack>

            </GuidancePanel>
        </RadzenColumn>
    </RadzenRow>
}

<style>
    .text-muted {
        color: var(--rz-text-disabled-color);
        font-style: italic;
    }

    /* Ensure proper input sizing with Radzen 
    ::deep .rz-textbox,
    ::deep .rz-dropdown,
