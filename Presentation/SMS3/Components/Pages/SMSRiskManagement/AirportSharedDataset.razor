@page "/SMSRiskManagement/AirportSharedDataset/{ReportId}"
@page "/SMSRiskManagement/AirportSharedDataset/{ReportId}/{HazardId}"
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Application.Messaging.Queries
@using SMS_Application.Messaging.Commands
@using SMS_Application.Interfaces
@using SMS_Shared.Common
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared

<PageTitle>@(IsEditMode ? $"Edit Dataset {ExistingDataset?.Code}" : "Airport Shared Dataset") - SMS3</PageTitle>

<!-- SMS Page Header using reusable component -->
<PageHeader Title="@(IsEditMode ? "Edit Airport Shared Dataset" : "Airport Shared Dataset")"
           Subtitle="@(IsEditMode ? $"Modify ADAM dataset {ExistingDataset?.Code}" : "Manage and access shared airport operational data and safety metrics")"
           Icon="fas fa-database" />

@if (IsLoading)
{
    <RadzenCard>
        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.H6" Text="@(IsEditMode ? "Loading dataset for editing..." : "Loading dataset...")" />
        </RadzenStack>
    </RadzenCard>
}
else
{
    <div class="container-fluid">
        <RadzenRow Gap="0.5rem">
            <!-- Left Column - Main Form (8 columns) -->
            <RadzenColumn Size="12" SizeLG="8">
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Gap="0.5rem" Style="padding: 0.5rem;">
                        
                        <!-- Edit Mode Indicator -->
                        @if (IsEditMode && ExistingDataset != null)
                        {
                            <RadzenAlert Variant="Variant.Outlined" AlertStyle="AlertStyle.Info" AllowClose="false" Style="margin-bottom: 1rem;">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenIcon Icon="edit" Style="color: var(--rz-info);" />
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                                        <strong>Editing Dataset:</strong> @ExistingDataset.Code
                                        @if (!string.IsNullOrEmpty(ExistingDataset.ReportCode))
                                        {
                                            <span> | Report: @ExistingDataset.ReportCode</span>
                                        }
                                        @if (!string.IsNullOrEmpty(ExistingDataset.HazardCode))
                                        {
                                            <span> | Hazard: @ExistingDataset.HazardCode</span>
                                        }
                                    </RadzenText>
                                </RadzenStack>
                            </RadzenAlert>
                        }

                        <!-- Report Context Display (for create mode) -->
                        @if (!IsEditMode && (ReportDetails != null || HazardDetails != null))
                        {
                            <RadzenCard Variant="Variant.Outlined" Style="background: var(--rz-base-50);">
                                <RadzenStack Gap="1rem" Style="padding: 1rem;">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="border-bottom: 1px solid var(--rz-border-color); padding-bottom: 0.5rem;">
                                        <RadzenIcon Icon="description" Style="color: var(--rz-info);" />
                                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Source Report Information</RadzenText>
                                    </RadzenStack>
                                    
                                    <RadzenRow Gap="1rem">
                                        <RadzenColumn Size="12" SizeLG="6">
                                            <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0; padding: 0.5rem; background: white; border-radius: 4px; border: 1px solid var(--rz-border-color); min-height: 80px;">
                                                @(ReportDetails?.Description ?? HazardDetails?.Description ?? "Description not available")
                                            </RadzenText>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeLG="3">
                                            <RadzenStack Gap="0.25rem">
                                                <RadzenText TextStyle="TextStyle.Body2" Style="font-weight: 600; margin: 0;">Report Code:</RadzenText>
                                                @if (HazardDetails != null)
                                                {
                                                    <RadzenText TextStyle="TextStyle.Body2" Style="font-weight: 600; margin: 0;">Hazard Code:</RadzenText>
                                                }
                                                <RadzenText TextStyle="TextStyle.Body2" Style="font-weight: 600; margin: 0;">Created On:</RadzenText>
                                            </RadzenStack>
                                        </RadzenColumn>
                                        <RadzenColumn Size="12" SizeLG="3">
                                            <RadzenStack Gap="0.25rem" AlignItems="AlignItems.Start">
                                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">@(ReportId ?? "N/A")</RadzenText>
                                                @if (HazardDetails != null)
                                                {
                                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">@(HazardId ?? "N/A")</RadzenText>
                                                }
                                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">@((ReportDetails?.CreatedDate ?? HazardDetails?.CreatedDate)?.ToString("MM/dd/yyyy HH:mm") ?? "N/A")</RadzenText>
                                            </RadzenStack>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenStack>
                            </RadzenCard>
                        }

                        <!-- Dataset Form -->
                        <RadzenTemplateForm Data="@Model" Submit="@HandleFormSubmit" TItem="AirportSharedDatasetModel">
                            
                            <!-- General Information Section -->
                            <RadzenFieldset Text="General Information" Style="margin-bottom: 1rem;">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Date and Time *" Variant="Variant.Outlined">
                                            <RadzenDatePicker @bind-Value="@Model.DateTime" ShowTime="true" 
                                                            DateFormat="MM/dd/yyyy HH:mm" Style="width: 100%;" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Location *" Variant="Variant.Outlined">
                                            <RadzenDropDown @bind-Value="@Model.Location" Data="@LocationOptions"
                                                            Placeholder="Select a Location" Style="width: 100%;min-width: 100%;"
                                                          Change="@OnLocationChange" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                @if (Model.Location == "Other")
                                {
                                    <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Text="Other Location Details" Variant="Variant.Outlined">
                                                <RadzenTextBox @bind-Value="@Model.LocationOther" 
                                                             Placeholder="Please specify the location"
                                                               Style="width: 100%;min-width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                }

                                <RadzenRow Gap="1rem" Class="rz-mb-3">
                                    <RadzenColumn Size="12" SizeMD="12">
                                        <RadzenFormField Text="Weather" Variant="Variant.Outlined">
                                            <RadzenTextBox @bind-Value="@Model.Weather" 
                                                         Placeholder="Weather conditions at time of incident"
                                                           Style="width: 100%;min-width: 100%;" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Private Narrative" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenTextArea @bind-Value="@Model.PrivateNarrative" Rows="4"
                                                          Placeholder="This text can only be viewed by users from your airport"
                                                          Style="width: 100%; min-width: 100%;" />
                                        </RadzenFormField>
                                        <RadzenText TextStyle="TextStyle.Caption" Text="This text can only be viewed by users from your airport." />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Shared Narrative" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenTextArea @bind-Value="@Model.SharedNarrative" Rows="4"
                                                          Placeholder="This text is displayed to all authorized users of ADAM"
                                                          Style="width: 100%; min-width: 100%;" />
                                        </RadzenFormField>
                                        <RadzenText TextStyle="TextStyle.Caption" Text="Where needed to anonymize individuals, airlines, vendor names, etc., use [an identifier in square brackets]." />
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenFieldset>

                            <!-- Triggering Event Section -->
                            <RadzenFieldset Text="Triggering Event" Style="margin-bottom: 1rem;">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12">
                                        <RadzenFormField Text="Category Path" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenTextBox @bind-Value="@Model.TriggeringEvent" 
                                                         Placeholder="Enter category path (e.g., 12.2)" 
                                                         Style="width: 100%; min-width: 100%;" />
                                        </RadzenFormField>
                                        <RadzenText TextStyle="TextStyle.Caption" Text="Use the standardized event classification system." />
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenFieldset>

                            <!-- Contributing Factors Section -->
                            <RadzenFieldset Text="Contributing Factors" Style="margin-bottom: 1rem;">
                                <RadzenRow Gap="0.5rem">
                                    <RadzenColumn Size="12" SizeSM="6" SizeLG="4" SizeXL="3">
                                        <RadzenCheckBox @bind-Value="@Model.Fatigue" Name="fatigue" />
                                        <RadzenLabel Text="Fatigue" Component="fatigue" Style="margin-left: 0.5rem;" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeSM="6" SizeLG="4" SizeXL="3">
                                        <RadzenCheckBox @bind-Value="@Model.Speed" Name="speed" />
                                        <RadzenLabel Text="Speed" Component="speed" Style="margin-left: 0.5rem;" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeSM="6" SizeLG="4" SizeXL="3">
                                        <RadzenCheckBox @bind-Value="@Model.WeatherFactor" Name="weather-factor" />
                                        <RadzenLabel Text="Weather" Component="weather-factor" Style="margin-left: 0.5rem;" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeSM="6" SizeLG="4" SizeXL="3">
                                        <RadzenCheckBox @bind-Value="@Model.Lighting" Name="lighting" />
                                        <RadzenLabel Text="Lighting" Component="lighting" Style="margin-left: 0.5rem;" />
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow Gap="0.5rem" Style="margin-top: 0.5rem;">
                                    <RadzenColumn Size="12" SizeSM="6" SizeLG="4" SizeXL="3">
                                        <RadzenCheckBox @bind-Value="@Model.Signage" Name="signage" />
                                        <RadzenLabel Text="Signage/Markings" Component="signage" Style="margin-left: 0.5rem;" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeSM="6" SizeLG="4" SizeXL="3">
                                        <RadzenCheckBox @bind-Value="@Model.Training" Name="training" />
                                        <RadzenLabel Text="Training" Component="training" Style="margin-left: 0.5rem;" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeSM="6" SizeLG="4" SizeXL="3">
                                        <RadzenCheckBox @bind-Value="@Model.Construction" Name="construction" />
                                        <RadzenLabel Text="Construction" Component="construction" Style="margin-left: 0.5rem;" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeSM="6" SizeLG="4" SizeXL="3">
                                        <RadzenCheckBox @bind-Value="@Model.Administrative" Name="admin" />
                                        <RadzenLabel Text="Administrative Controls" Component="admin" Style="margin-left: 0.5rem;" />
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow Gap="0.5rem" Style="margin-top: 0.5rem;">
                                    <RadzenColumn Size="12" SizeSM="6" SizeLG="4" SizeXL="3">
                                        <RadzenCheckBox @bind-Value="@Model.HumanFactors" Name="human" />
                                        <RadzenLabel Text="Human Factors" Component="human" Style="margin-left: 0.5rem;" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeSM="6" SizeLG="4" SizeXL="3">
                                        <RadzenCheckBox @bind-Value="@Model.Engineering" Name="engineering" />
                                        <RadzenLabel Text="Engineering" Component="engineering" Style="margin-left: 0.5rem;" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeSM="6" SizeLG="4" SizeXL="3">
                                        <RadzenCheckBox @bind-Value="@Model.Mechanical" Name="mechanical" />
                                        <RadzenLabel Text="Mechanical" Component="mechanical" Style="margin-left: 0.5rem;" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeSM="6" SizeLG="4" SizeXL="3">
                                        <RadzenCheckBox @bind-Value="@Model.OtherFactor" Name="other-factor" />
                                        <RadzenLabel Text="Other" Component="other-factor" Style="margin-left: 0.5rem;" />
                                    </RadzenColumn>
                                </RadzenRow>

                                @if (Model.OtherFactor)
                                {
                                    <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Text="Other Factors (comma-separated)" Variant="Variant.Outlined">
                                                <RadzenTextBox @bind-Value="@Model.FactorsOtherDescription" 
                                                             Placeholder="Please specify other contributing factors" 
                                                             Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                }
                            </RadzenFieldset>

                            <!-- Operational Impact Section -->
                            <RadzenFieldset Text="Operational Impact" Style="margin-bottom: 1rem;">
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12">
                                        <RadzenFormField Text="Airline/Company/Operator(s) Involved" Variant="Variant.Outlined" Style="width: 100%;">
                                            <RadzenTextArea @bind-Value="@Model.AirlineCompanyOperator" Rows="3"
                                                          Placeholder="List airlines, companies, or operators involved"
                                                          Style="width: 100%; min-width: 100%;" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                    <RadzenColumn Size="12" SizeLG="6" SizeXL="3">
                                        <RadzenFormField Text="Were operators authorized?" Variant="Variant.Outlined">
                                            <RadzenDropDown @bind-Value="@Model.OperatorsAuthorized" 
                                                          Data="@YesNoNAOptions"
                                                          Style="width: 100%;" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeLG="6" SizeXL="3">
                                        <RadzenFormField Text="Was there a flight delay?" Variant="Variant.Outlined">
                                            <RadzenDropDown @bind-Value="@Model.FlightDelay" 
                                                          Data="@YesNoNAOptions"
                                                          Style="width: 100%;" Change="@OnFlightDelayChange" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeLG="6" SizeXL="3">
                                        <RadzenFormField Text="Was equipment removed from service?" Variant="Variant.Outlined">
                                            <RadzenDropDown @bind-Value="@Model.EquipmentRemovedFromService" 
                                                          Data="@YesNoNAOptions"
                                                          Style="width: 100%;" Change="@OnEquipmentRemovedChange" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeLG="6" SizeXL="3">
                                        <RadzenFormField Text="Was a police report taken?" Variant="Variant.Outlined">
                                            <RadzenDropDown @bind-Value="@Model.PoliceReport" 
                                                          Data="@YesNoNAOptions"
                                                          Style="width: 100%;" Change="@OnPoliceReportChange" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>

                                <!-- Conditional Detail Fields -->
                                @if (Model.FlightDelay == "Yes")
                                {
                                    <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Text="Flight Delay Details" Variant="Variant.Outlined">
                                                <RadzenTextArea @bind-Value="@Model.FlightDelayDetails" Rows="3"
                                                              Placeholder="Provide details about the flight delays"
                                                              Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                }

                                @if (Model.EquipmentRemovedFromService == "Yes")
                                {
                                    <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Text="Equipment Removal Details" Variant="Variant.Outlined">
                                                <RadzenTextArea @bind-Value="@Model.EquipmentRemovalDetails" Rows="3"
                                                              Placeholder="Provide details about equipment removed from service"
                                                              Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                }

                                @if (Model.PoliceReport == "Yes")
                                {
                                    <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                        <RadzenColumn Size="12">
                                            <RadzenFormField Text="Police Report Details" Variant="Variant.Outlined">
                                                <RadzenTextArea @bind-Value="@Model.PoliceReportDetails" Rows="3"
                                                              Placeholder="Provide details about the police report"
                                                              Style="width: 100%;" />
                                            </RadzenFormField>
                                        </RadzenColumn>
                                    </RadzenRow>
                                }
                            </RadzenFieldset>

                            <!-- Advanced Options (Collapsible) -->
                            <RadzenAccordion Style="margin-bottom: 1rem;">
                                <Items>
                                    <RadzenAccordionItem Text="Advanced Dataset Options" Icon="settings">
                                        
                                        <!-- Involved Components -->
                                        <RadzenFieldset Text="Involved Components" Style="margin-bottom: 1.5rem;">
                                            <RadzenRow Gap="1rem">
                                                <RadzenColumn Size="12" SizeSM="6" SizeLG="3">
                                                    <RadzenCheckBox @bind-Value="@Model.AircraftInvolved" Name="aircraft" />
                                                    <RadzenLabel Text="Aircraft Involved" Component="aircraft" Style="margin-left: 0.5rem;" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="12" SizeSM="6" SizeLG="3">
                                                    <RadzenCheckBox @bind-Value="@Model.PoweredEquipmentInvolved" Name="powered" />
                                                    <RadzenLabel Text="Powered Equipment" Component="powered" Style="margin-left: 0.5rem;" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="12" SizeSM="6" SizeLG="3">
                                                    <RadzenCheckBox @bind-Value="@Model.NonPoweredEquipmentInvolved" Name="nonpowered" />
                                                    <RadzenLabel Text="Non-Powered Equipment" Component="nonpowered" Style="margin-left: 0.5rem;" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="12" SizeSM="6" SizeLG="3">
                                                    <RadzenCheckBox @bind-Value="@Model.PedestrianInvolved" Name="pedestrian" />
                                                    <RadzenLabel Text="Pedestrian(s)" Component="pedestrian" Style="margin-left: 0.5rem;" />
                                                </RadzenColumn>
                                            </RadzenRow>
                                            
                                            <RadzenRow Gap="1rem" Style="margin-top: 0.5rem;">
                                                <RadzenColumn Size="12" SizeSM="6">
                                                    <RadzenCheckBox @bind-Value="@Model.OtherInvolved" Name="other-involved" />
                                                    <RadzenLabel Text="Other Components" Component="other-involved" Style="margin-left: 0.5rem;" />
                                                </RadzenColumn>
                                            </RadzenRow>

                                            @if (Model.OtherInvolved)
                                            {
                                                <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                                    <RadzenColumn Size="12">
                                                        <RadzenFormField Text="Other Component Description" Variant="Variant.Outlined">
                                                            <RadzenTextBox @bind-Value="@Model.OtherDescription" 
                                                                         Placeholder="Describe other involved components" 
                                                                         Style="width: 100%;" />
                                                        </RadzenFormField>
                                                    </RadzenColumn>
                                                </RadzenRow>
                                            }
                                        </RadzenFieldset>

                                        <!-- Resulting Issues -->
                                        <RadzenFieldset Text="Resulting Issues" Style="margin-bottom: 1.5rem;">
                                            <RadzenRow Gap="1rem">
                                                <RadzenColumn Size="12" SizeSM="6" SizeLG="3">
                                                    <RadzenCheckBox @bind-Value="@Model.PropertyDamage" Name="property" />
                                                    <RadzenLabel Text="Property Damage" Component="property" Style="margin-left: 0.5rem;" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="12" SizeSM="6" SizeLG="3">
                                                    <RadzenCheckBox @bind-Value="@Model.PersonalInjury" Name="injury" />
                                                    <RadzenLabel Text="Personal Injury" Component="injury" Style="margin-left: 0.5rem;" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="12" SizeSM="6" SizeLG="3">
                                                    <RadzenCheckBox @bind-Value="@Model.Fatality" Name="fatality" />
                                                    <RadzenLabel Text="Fatality" Component="fatality" Style="margin-left: 0.5rem;" />
                                                </RadzenColumn>
                                                <RadzenColumn Size="12" SizeSM="6" SizeLG="3">
                                                    <RadzenCheckBox @bind-Value="@Model.OtherIssues" Name="other-issues" />
                                                    <RadzenLabel Text="Other Issues" Component="other-issues" Style="margin-left: 0.5rem;" />
                                                </RadzenColumn>
                                            </RadzenRow>

                                            <!-- Conditional Comments for Issues -->
                                            @if (Model.PropertyDamage)
                                            {
                                                <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                                    <RadzenColumn Size="12">
                                                        <RadzenFormField Text="Property Damage Comments" Variant="Variant.Outlined">
                                                            <RadzenTextArea @bind-Value="@Model.PropertyDamageComments" Rows="3"
                                                                          Placeholder="Describe property damage details"
                                                                          Style="width: 100%;" />
                                                        </RadzenFormField>
                                                    </RadzenColumn>
                                                </RadzenRow>
                                            }

                                            @if (Model.PersonalInjury)
                                            {
                                                <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                                    <RadzenColumn Size="12">
                                                        <RadzenFormField Text="Personal Injury Comments" Variant="Variant.Outlined">
                                                            <RadzenTextArea @bind-Value="@Model.PersonalInjuryComments" Rows="3"
                                                                          Placeholder="Describe personal injury details"
                                                                          Style="width: 100%;" />
                                                        </RadzenFormField>
                                                    </RadzenColumn>
                                                </RadzenRow>
                                            }

                                            @if (Model.Fatality)
                                            {
                                                <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                                    <RadzenColumn Size="12">
                                                        <RadzenFormField Text="Fatality Comments" Variant="Variant.Outlined">
                                                            <RadzenTextArea @bind-Value="@Model.FatalityComments" Rows="3"
                                                                          Placeholder="Describe fatality details"
                                                                          Style="width: 100%;" />
                                                        </RadzenFormField>
                                                    </RadzenColumn>
                                                </RadzenRow>
                                            }

                                            @if (Model.OtherIssues)
                                            {
                                                <RadzenRow Gap="1rem" Style="margin-top: 1rem;">
                                                    <RadzenColumn Size="12">
                                                        <RadzenFormField Text="Other Issues Description" Variant="Variant.Outlined">
                                                            <RadzenTextArea @bind-Value="@Model.OtherIssuesDescription" Rows="3"
                                                                          Placeholder="Describe other issues"
                                                                          Style="width: 100%;" />
                                                        </RadzenFormField>
                                                    </RadzenColumn>
                                                </RadzenRow>
                                            }
                                        </RadzenFieldset>

                                    </RadzenAccordionItem>
                                </Items>
                            </RadzenAccordion>

                            <!-- Action Buttons -->
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                                <RadzenButton Text="Cancel" Icon="cancel" ButtonStyle="ButtonStyle.Secondary"
                                            Click="@CancelAndReturn" />
                                
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenButton Text="@GetSaveButtonText()" 
                                                Icon="@GetSaveButtonIcon()" 
                                                ButtonStyle="ButtonStyle.Primary"
                                                Click="@SaveDataset" Disabled="@IsSaving" />
                                    
                                    @if (IsSaving)
                                    {
                                        <RadzenProgressBarCircular ShowValue="false" Size="ProgressBarCircularSize.Small" />
                                    }
                                </RadzenStack>
                            </RadzenStack>

                        </RadzenTemplateForm>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <!-- Right Column - Guidance (4 columns) -->
            <RadzenColumn Size="12" SizeLG="4">
                <AirportSharedDataGuidance />
            </RadzenColumn>
        </RadzenRow>
    </div>
}

<style>
    .text-muted {
        color: var(--rz-text-disabled-color);
        font-style: italic;
    }

    /* Ensure proper input sizing with Radzen - copied from HazardReporting.razor */
    ::deep .rz-textbox,
    ::deep .rz-dropdown,
    ::deep .rz-textarea,
    ::deep .rz-datepicker {
        width: 100% !important;
        min-width: 100% !important;
    }

    /* Ensure FormField containers take full width */
    ::deep .rz-formfield {
        width: 100% !important;
    }

    /* Specific dropdown styling for full width */
    ::deep .rz-dropdown-panel {
        min-width: 100% !important;
    }

    ::deep .rz-dropdown .rz-dropdown-label {
        width: calc(100% - 32px) !important;
    }

    /* Make sure dropdowns are responsive and fill container */
    ::deep .rz-dropdown {
        display: block !important;
        width: 100% !important;
    }
</style>