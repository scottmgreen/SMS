@page "/pdx"
@using SMS3.Components.Layout
@using SMS3.Configuration.Extensions
@using SMS3.Security
@layout MainLayout
@inject NavigationManager Navigation
@inject ISecureRoutingService SecureRoutingService

<PageTitle>PDX SMS - Internal Access</PageTitle>

<!-- Home background - positioned to cover entire viewport -->
<div class="home-background">
    <div class="sms-pdx-card">
        <!-- Header - matching Login page style -->
        <div class="sms-login-header">
            <i class="fas fa-shield-alt sms-login-icon"></i>
            <h2 class="sms-login-title">PDX SMS Portal</h2>
            <p class="sms-login-subtitle-text">Portland International Airport</p>
        </div>

        <!-- Disclaimer Content -->
        <div class="sms-disclaimer-content">
            <div class="alert alert-info sms-info-alert">
                <h5 class="alert-heading">
                    <i class="fas fa-info-circle me-2"></i>Internal Staff Access
                </h5>
                <p class="mb-0"><strong>This system is restricted to authorized Port of Portland personnel only.</strong>
                </p>
            </div>

            <div class="sms-terms-section">
                <p class="sms-terms-text"><strong>By proceeding, you acknowledge that:</strong></p>

                <ul class="sms-terms-list">
                    <li><strong>Unauthorized access is strictly prohibited</strong> and may be subject to criminal prosecution
                        under applicable federal and state laws.</li>
                    <li><strong>All activities are monitored and logged.</strong> Your access and usage may be audited.</li>
                    <li><strong>You have authorized access</strong> to this system as a Port of Portland employee.</li>
                    <li><strong>You agree to comply</strong> with all Port of Portland IT policies and SMS procedures.</li>
                    <li><strong>Confidential safety information</strong> must be handled according to established security
                        protocols.</li>
                </ul>

                @* <div class="sms-requirements-box">
                    <h6 class="sms-requirements-title">
                        <i class="fas fa-check-circle me-2"></i>Access Requirements:
                    </h6>
                    <ul class="sms-requirements-list">
                        <li>Valid Port of Portland employee credentials</li>
                        <li>Authorized SMS system account</li>
                        <li>Current safety training certification</li>
                        <li>Supervisor approval for system access</li>
                    </ul>
                </div> *@
            </div>

            <!-- Proceed Button -->
            <div class="d-grid mt-4">
                <button type="button" class="btn btn-lg sms-login-button sms-proceed-button" @onclick="ProceedToLogin">
                    <i class="fas fa-check-circle me-2"></i>
                    I Have Read and Understand These Terms
                </button>
            </div>
        </div>

        <!-- Footer -->
        <div class="sms-disclaimer-footer">
            <small class="text-muted">
                <i class="fas fa-phone me-1"></i> IT Support:
                <a href="mailto:it-support@flypdx.com">it-support@flypdx.com</a> |
                <i class="fas fa-envelope me-1"></i> SMS Support:
                <a href="mailto:sms-support@flypdx.com">sms-support@flypdx.com</a>
            </small>
        </div>
    </div>
</div>

<style>
    /* =============================================================================
       SMS PDX DISCLAIMER PAGE - MATCHING LOGIN STYLING
       ============================================================================= */

    /* Copy Login Card Styling for Consistency */
    .sms-pdx-card {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 1rem 3rem rgba(33, 46, 97, 0.15);
        padding: 2.5rem;
        width: 100%;
        max-width: 800px !important;;
        border: 1px solid var(--sms-blue-light);
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 10000;
        pointer-events: auto;
    }

    

    /* Login Header Styling */
    .sms-login-header {
        text-align: center;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--sms-blue-light);
    }

    .sms-login-icon {
        font-size: 3.5rem;
        color: var(--sms-blue-dark-bold);
        margin-bottom: 1rem;
        display: block;
        text-shadow: 0 0.125rem 0.25rem black;
    }

    .sms-login-title {
        color: var(--sms-blue-dark-bold);
        font-weight: 700;
        font-size: 1.75rem;
        margin-bottom: 0.5rem;
    }

    .sms-login-subtitle-text {
        color: var(--sms-blue-dark-bold);
        font-weight: 500;
        font-size: 1rem;
        margin-bottom: 0;
    }

    .sms-disclaimer-content {
        margin-bottom: 2rem;
    }

    .sms-info-alert {
        background-color: rgba(13, 110, 253, 0.1) !important;
        border: 1px solid rgba(13, 110, 253, 0.2) !important;
        color: var(--sms-blue-dark-bold) !important;
        border-radius: 0.5rem !important;
        margin-bottom: 1.5rem !important;
    }

    .sms-terms-section {
        margin: 1.5rem 0;
    }

    .sms-terms-text {
        color: var(--sms-blue-dark-bold);
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .sms-terms-list {
        color: var(--sms-blue-dark-bold);
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
    }

    .sms-terms-list li {
        margin-bottom: 0.75rem;
        line-height: 1.4;
    }

    .sms-requirements-box {
        background-color: rgba(108, 117, 125, 0.1);
        border: 1px solid rgba(108, 117, 125, 0.2);
        border-radius: 0.5rem;
        padding: 1.25rem;
        margin-top: 1.5rem;
    }

    .sms-requirements-title {
        color: var(--sms-blue-dark-bold);
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .sms-requirements-list {
        margin-bottom: 0;
        padding-left: 1.5rem;
        color: var(--sms-blue-dark-bold);
    }

    .sms-requirements-list li {
        margin-bottom: 0.5rem;
    }

    .sms-proceed-button {
        min-width: 100% !important;
        padding: 1rem 1.5rem !important;
        font-weight: 600 !important;
        border-radius: 0.5rem !important;
        font-size: 1.1rem !important;
        background-color: var(--sms-blue-dark-bold) !important;
        border-color: var(--sms-btn-primary-bg) !important;
        color: white !important;
        box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.1) !important;
        transition: all 0.2s ease-in-out !important;
    }

    .sms-proceed-button:hover {
        background-color: var(--sms-btn-primary-hover) !important;
        border-color: var(--sms-btn-primary-hover) !important;
        transform: translateY(-1px) !important;
        box-shadow: 0 0.375rem 0.75rem rgba(0, 0, 0, 0.15) !important;
    }

    .sms-disclaimer-footer {
        text-align: center;
        padding-top: 1.5rem;
        border-top: 1px solid var(--sms-blue-light);
        margin-top: 2rem;
    }

    .sms-disclaimer-footer a {
        color: var(--sms-blue-dark-bold);
        text-decoration: none;
    }

    .sms-disclaimer-footer a:hover {
        text-decoration: underline;
    }

    /* =============================================================================
       END SMS PDX DISCLAIMER STYLING
       ============================================================================= */
</style>

@code {
    /// <summary>
    /// Navigate to login using secure navigation when user accepts terms
    /// </summary>
    private void ProceedToLogin()
    {
        // Use NavigateToSecure to encrypt the /login URL
        Navigation.NavigateToSecure("/login");
    }
}