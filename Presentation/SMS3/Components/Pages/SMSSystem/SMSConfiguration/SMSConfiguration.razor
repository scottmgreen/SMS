@page "/SMSSystem/SMSConfiguration/SMSConfiguration"
@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Nodes
@using SMS3.Components.Shared
@inject ICurrentUserService _currentUserService
@inject IWebHostEnvironment Environment
@inject ILogger<SMSConfiguration> Logger

<PageTitle>SMS Configuration - SMS3</PageTitle>

<PageHeader Title="SMS Configuration"
            Subtitle="Edit appsettings.json values by category (auto-save on change)"
            Icon="settings" />

<div class="container-fluid">
    @if (_isLoading)
    {
        <div class="alert alert-info">Loading configuration...</div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="alert alert-success">@_statusMessage</div>
        }

        @foreach (var group in _settings.GroupBy(s => s.TopLevelCategory).OrderBy(g => g.Key))
        {
            <div class="card mb-3">
                <div class="card-header fw-bold">@group.Key</div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped align-middle mb-0 config-table">
                            <colgroup>
                                <col style="width: 45%;" />
                                <col style="width: 55%;" />
                            </colgroup>
                            @* <thead>
                                <tr>
                                    <th>Label</th>
                                    <th>Control</th>
                                </tr>
                            </thead> *@
                            <tbody>
                                @foreach (var setting in group.OrderBy(s => s.Path))
                                {
                                    <tr>
                                        <td class="fw-semibold">@setting.Path</td>
                                        <td>
                                            @if (setting.SettingType == ConfigSettingType.Boolean)
                                            {
                                                <div class="form-check m-0">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           checked="@setting.BooleanValue"
                                                           disabled="@_isSaving"
                                                           @onchange="@(async e => await OnBooleanChangedAsync(setting, e))" />
                                                </div>
                                            }
                                            else if (setting.SettingType == ConfigSettingType.Array)
                                            {
                                                <textarea class="form-control"
                                                          rows="3"
                                                          disabled="@_isSaving"
                                                          @onchange="@(async e => await OnTextChangedAsync(setting, e))">@setting.TextValue</textarea>
                                            }
                                            else
                                            {
                                                <input class="form-control"
                                                       type="@(setting.SettingType == ConfigSettingType.Number ? "number" : "text")"
                                                       value="@setting.TextValue"
                                                       disabled="@_isSaving"
                                                       @onchange="@(async e => await OnTextChangedAsync(setting, e))" />
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .config-table td,
    .config-table th {
        padding: 0.85rem;
    }
</style>

