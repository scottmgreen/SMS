@page "/SMSSystem/UserSupport/Organizations"

@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS_Domain.Enums

<PageTitle>Organization Management - SMS3</PageTitle>

<PageHeader Title="Organization Management"
            Subtitle="@($"Maintain SMS organizations ({_organizations.Count})")"
            Icon="fas fa-sitemap">
    <AdditionalContent>
        <div class="d-flex justify-content-end align-items-center w-100">
            <RadzenButton Text="New Organization" Icon="add" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                          Click="@OpenCreateModal" />
        </div>
    </AdditionalContent>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" class="mb-3">
        <RadzenIcon Icon="error" Style="margin-right: 0.5rem;" />
        @_errorMessage
    </RadzenAlert>
}

<RadzenCard>
    <RadzenDataGrid @ref="_organizationsGrid" Data="@_organizations" TItem="SMSOrganization"
                    AllowFiltering="true" AllowColumnResize="true" AllowSorting="true"
                    PageSize="15" AllowPaging="true" ShowPagingSummary="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
        <Columns>
            <RadzenDataGridColumn TItem="SMSOrganization" Property="Value" Title="Value" Width="280px" />
            <RadzenDataGridColumn TItem="SMSOrganization" Property="Name" Title="Name" Width="280px" />
            <RadzenDataGridColumn TItem="SMSOrganization" Property="Description" Title="Description" Width="520px" />
            <RadzenDataGridColumn TItem="SMSOrganization" Title="Actions" Width="120px" Sortable="false" Filterable="false">
                <Template Context="organization">
                    <div class="d-flex gap-1">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.ExtraSmall"
                                      Click="@(() => OpenEditModal(organization))" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                      Click="@(() => DeleteOrganization(organization))" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@if (_showCreateModal)
{
    <div class="modal-backdrop">
        <div class="modal-dialog user-mgmt-modal">
            <RadzenCard class="modal-content">
                <div class="modal-header" style="background-color: #212e61; color: white; padding: 1rem; margin: -1rem -1rem 1rem -1rem; border-radius: 6px 6px 0 0;">
                    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: white;">
                        <RadzenIcon Icon="add" Style="margin-right: 0.5rem;" />
                        New Organization
                    </RadzenText>
                </div>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Value *" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="_newValue" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Name *" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="_newName" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem" class="mt-2">
                    <RadzenColumn Size="12">
                        <RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width: 100%;">
                            <RadzenTextArea @bind-Value="_newDescription" Rows="4" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseCreateModal" />
                    <RadzenButton Text="Create Organization" Icon="save" ButtonStyle="ButtonStyle.Primary"
                                  Click="@CreateOrganization" Disabled="@(string.IsNullOrWhiteSpace(_newValue) || string.IsNullOrWhiteSpace(_newName) || _isSaving)"
                                  Style="background-color: #212e61; border-color: #212e61;" />
                </div>
            </RadzenCard>
        </div>
    </div>
}

@if (_showEditModal)
{
    <div class="modal-backdrop">
        <div class="modal-dialog user-mgmt-modal">
            <RadzenCard class="modal-content">
                <div class="modal-header" style="background-color: #212e61; color: white; padding: 1rem; margin: -1rem -1rem 1rem -1rem; border-radius: 6px 6px 0 0;">
                    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: white;">
                        <RadzenIcon Icon="edit" Style="margin-right: 0.5rem;" />
                        Edit Organization @_editValue
                    </RadzenText>
                </div>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Value *" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="_editValue" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Name *" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="_editName" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem" class="mt-2">
                    <RadzenColumn Size="12">
                        <RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width: 100%;">
                            <RadzenTextArea @bind-Value="_editDescription" Rows="4" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseEditModal" />
                    <RadzenButton Text="Update Organization" Icon="save" ButtonStyle="ButtonStyle.Primary"
                                  Click="@UpdateOrganization" Disabled="@(string.IsNullOrWhiteSpace(_editValue) || string.IsNullOrWhiteSpace(_editName) || _isSaving)"
                                  Style="background-color: #212e61; border-color: #212e61;" />
                </div>
            </RadzenCard>
        </div>
    </div>
}

<style>
.modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1050;
    display: flex;
    justify-content: center;
    align-items: center;
}

.modal-dialog {
    width: 90%;
    max-width: 500px;
    margin: 2rem;
    overflow-x: hidden;
}

.modal-dialog.user-mgmt-modal {
    width: min(92vw, 900px);
    max-width: 900px;
    margin: 1rem;
}
</style>
