@page "/SMSSystem/UserManagement/OrganizationalUsers"
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS3.Components.Shared.UIHelpers
@using SMS_Domain.Entities
@using SMS_Domain.Enums

<PageTitle>Organizational User Management - SMS3</PageTitle>

<!-- SMS Page Header -->
<PageHeader Title="Organizational User Management"
            Subtitle="@($"Manage SMS Organizational Users ({@OrganizationalUsersList.Count()})")"
           Icon="fas fa-user-tie">

           <AdditionalContent>
                <div class="d-flex justify-content-end align-items-center w-100">
                    <div class="d-flex gap-2">
                        <RadzenButton Text="Add User" Icon="add" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                      Click="@OpenCreateModal" />
                    </div>
                </div>
           </AdditionalContent>
</PageHeader>

<!-- Success/Error Messages -->
@if (!string.IsNullOrEmpty(_successMessage))
{
    <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter" class="mb-3">
        <RadzenIcon Icon="check_circle" Style="margin-right: 0.5rem;" />
        @_successMessage
    </RadzenAlert>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" class="mb-3">
        <RadzenIcon Icon="error" Style="margin-right: 0.5rem;" />
        @_errorMessage
    </RadzenAlert>
}

<!-- Users Display -->

    <RadzenCard>
        @if (OrganizationalUsersList.Any())
        {
            <RadzenDataGrid @ref="_usersGrid" Data="@OrganizationalUsersList" TItem="SMSOrganizationalUser" 
                            AllowFiltering="true" AllowColumnResize="true" AllowSorting="true" 
                            PageSize="10" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" 
                            ShowPagingSummary="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                
                <Columns>
                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="Code" Title="User ID" Width="75px" Sortable="true" Filterable="true">
                        <Template Context="user">
                            <div class="d-flex align-items-center">
                                <strong>@user.Code</strong>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    
                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="DisplayName" Title="User" Width="120px" Sortable="true" Filterable="true">
                        <Template Context="user">
                            <div class="d-flex align-items-center">
                                <div>
                                    <div><strong>@user.DisplayName</strong></div>
                                    @if (IsEmailFormat(user.UserName?.Value))
                                    {
                                        <small>
                                            <a href="@($"mailto:{user.UserName?.Value}")" style="color: var(--rz-text-secondary-color);">
                                                @user.UserName?.Value
                                            </a>
                                        </small>
                                    }
                                    else
                                    {
                                        <small style="color: var(--rz-text-secondary-color);">@user.UserName?.Value</small>
                                    }
                                </div>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="Company" Title="Company" Width="160px" Sortable="true" Filterable="true">
                        <Template Context="user">
                            @(SMSCompany.FromValue(user.Company ?? string.Empty)?.Company ?? user.Company)
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="Organization" Title="Organization" Width="150px" Sortable="true" Filterable="true" SortProperty="Organization" FilterProperty="Organization">
                        <Template Context="user">
                            @((SMSOrganization.FromValue(user.Organization ?? string.Empty)?.Name
                                ?? user.Department?.Name
                                ?? user.Organization
                                ?? string.Empty).ToUpper())
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="Title" Title="Title" Width="150px" Sortable="true" Filterable="true">
                        <Template Context="user">
                            @(SMSJobTitle.FromValue(string.IsNullOrWhiteSpace(user.Title) ? user.Position : user.Title)?.Name
                                ?? (string.IsNullOrWhiteSpace(user.Title) ? user.Position : user.Title))
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="JobFunction" Title="Job Function" Width="150px" Sortable="true" Filterable="true" />

                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="OrganizationLevel.Name" Title="SMS Organization Level" Width="250px" Sortable="true" Filterable="true" SortProperty="OrganizationLevel.Name" FilterProperty="OrganizationLevel.Name">
                        <Template Context="user">
                            @if (user.OrganizationLevel !=null)
                            {
                                @GetOrganizationLevelDisplayText(user.OrganizationLevel.Name).ToUpper() 
                            }
                            else
                            {
                                <em style="color: var(--rz-text-secondary-color);">No SMS role</em>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="UserRole" Title="SMS Role/Permissions" Width="170px" Sortable="false" Filterable="false">
                        <Template Context="user">
                            @if (user.UserRole is not null)
                            {
                                @user.UserRole.Name
                            }
                            else
                            {
                                <RadzenBadge Variant="Variant.Filled" BadgeStyle="BadgeStyle.Light" Text="No Role Assigned" />
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="TwoFactorEnabled" Title="2FA Required" Width="120px">
                        <Template Context="user">
                            <RadzenIcon Icon="@(user.TwoFactorEnabled ? "check_box" : "check_box_outline_blank")"
                                        Style="@(user.TwoFactorEnabled ? "color: var(--rz-success);" : "color: var(--rz-danger);")" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="IsActive" Title="Active" Width="75px" Sortable="true" Filterable="true">
                        <Template Context="user">
                            <RadzenIcon Icon="@(user.IsActive ? "check_box" : "check_box_outline_blank")"
                                        Style="@(user.IsActive ? "color: var(--rz-success);" : "color: var(--rz-danger);")" />
                        </Template>
                    </RadzenDataGridColumn>

                    
                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Title="Actions" Width="200px" Sortable="false" Filterable="false">
                        <Template Context="user">
                            <div class="d-flex gap-1">
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                              Click="@(() => EditUser(user.Code))" title="Edit User" />

                                <!-- Role Assignment Button -->
                                <RadzenButton Icon="admin_panel_settings" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                              Click="@(() => OpenRoleAssignmentModal(user.Code, user.DisplayName, user.UserRole?.Code))"
                                              title="Assign Role" />

                                <RadzenButton Icon="vpn_key" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                              Click="@(() => OpenPasswordModal(user.Code, user.DisplayName))" title="Change Password" />
                                <RadzenButton Icon="group" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                              Click="@(() => ManageGroups(user.Code, user.DisplayName))" title="Manage Groups" />
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                              Click="@(() => ConfirmDelete(user.Code, user.DisplayName))" title="Delete User" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else
        {
            <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 3rem;">
                <RadzenIcon Icon="corporate_fare" Style="font-size: 4rem; color: var(--rz-text-disabled-color);" />
                <RadzenText TextStyle="TextStyle.H5" Style="color: var(--rz-text-disabled-color);">
                    No Organizational Users Found
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-disabled-color);">
                    Click "Add User" to create your first organizational user.
                </RadzenText>
                <RadzenButton Text="Add First User" Icon="add" ButtonStyle="ButtonStyle.Success"
                              Click="@OpenCreateModal" />
            </RadzenStack>
        }
    </RadzenCard>


<!-- Create User Modal - UPDATED TO MATCH EDIT MODAL LAYOUT -->
@if (_showCreateModal)
{
    <div class="modal-backdrop">
        <div class="modal-dialog user-mgmt-modal">
            <RadzenCard class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header" style="background-color: #212e61; color: white; padding: 1rem; margin: -1rem -1rem 1rem -1rem; border-radius: 6px 6px 0 0;">
                    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: white;">
                        <RadzenIcon Icon="person_add" Style="margin-right: 0.5rem;" />
                        Create Organizational User
                    </RadzenText>
                </div>
                
                <!-- Modal Body -->
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="First Name *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value="@_newFirstName" Placeholder="Enter first name" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Last Name *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value="@_newLastName" Placeholder="Enter last name" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="User Name *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value="@_newUserName" Placeholder="Enter user name" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Password *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenPassword @bind-Value="@_newPassword" Placeholder="Enter password" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Confirm Password *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenPassword @bind-Value="@_confirmPassword" Placeholder="Confirm password" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Company" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_newCompany" Data="@CompanyOptions"
                                            TextProperty="Text" ValueProperty="Value"
                                            Style="width: 100%;" Placeholder="Select company" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Organization *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_newDepartmentId" Data="@OrganizationOptions"
                                            TextProperty="Text" ValueProperty="Value"
                                            Style="width: 100%;" Placeholder="Select organization" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Title" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_newPosition" Data="@TitleOptions"
                                            TextProperty="Text" ValueProperty="Value"
                                            Style="width: 100%;" Placeholder="Select title" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Job Function" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value="@_newJobFunction" Placeholder="Enter job function" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="5">
                        <RadzenFormField Text="SMS Role *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_newUserRoleCode" Data="@SMSRoleOptions"
                                            TextProperty="Text" ValueProperty="Value"
                                            Style="width: 100%;" Placeholder="Select SMS role" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenFormField Text="SMS Organizational Level" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_newOrganizationLevelId" Data="@_organizationLevelOptions"
                                            TextProperty="Text" ValueProperty="Value"
                                            Style="width: 100%;" Placeholder="Select SMS organizational role"
                                            title="Select the Organization Level that determines authority and approval permissions" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenFormField Text="Require 2FA" Variant="Variant.Outlined">
                            <div class="d-flex align-items-center p-2">
                                <RadzenCheckBox @bind-Value="@_newTwoFactorEnabled" Name="_newTwoFactorEnabled" />
                                <RadzenLabel Text="Require 2FA" Component="_newTwoFactorEnabled" Style="width:120px;margin-left: 0.5rem; cursor: pointer;" />
                            </div>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenFormField Text="Active" Variant="Variant.Outlined">
                            <div class="d-flex align-items-center p-2">
                                <RadzenCheckBox @bind-Value="@_newIsActive" Name="_newIsActive" />
                                <RadzenLabel Text="Active" Component="_newIsActive" Style="width:120px;margin-left: 0.5rem; cursor: pointer;" />
                            </div>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                                
                <!-- Modal Footer -->
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseCreateModal" />
                    <RadzenButton Text="Create User" Icon="save" ButtonStyle="ButtonStyle.Primary" 
                                  Click="@CreateUser" Disabled="@(!_isCreateFormValid || _isSaving)"
                                  Style="background-color: #212e61; border-color: #212e61;" />
                </div>
            </RadzenCard>
        </div>
    </div>
}

<!-- Edit User Modal -->
@if (_showEditModal && _currentUser is not null)
{
    <div class="modal-backdrop">
        <div class="modal-dialog user-mgmt-modal">
            <RadzenCard class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header" style="background-color: #212e61; color: white; padding: 1rem; margin: -1rem -1rem 1rem -1rem; border-radius: 6px 6px 0 0;">
                    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: white;">
                        <RadzenIcon Icon="edit" Style="margin-right: 0.5rem;" />
                        Edit Organizational User
                    </RadzenText>
                </div>
                
                <!-- Modal Body -->
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="First Name *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value="@_editFirstName"
                                           Placeholder="Enter first name"
                                           Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Last Name *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value="@_editLastName"
                                           Placeholder="Enter last name"
                                           Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Username" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox Value="@_currentUser.UserName?.Value" ReadOnly="true"
                                           Style="width: 100%; background-color: #f8f9fa;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Company" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_editCompany" Data="@CompanyOptions"
                                            TextProperty="Text" ValueProperty="Value"
                                            Style="width: 100%;" Placeholder="Select company" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Organization *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_editDepartmentId" Data="@OrganizationOptions"
                                            TextProperty="Text" ValueProperty="Value"
                                            Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Title" Variant="Variant.Outlined">
                            <RadzenDropDown @bind-Value="@_editPosition" Data="@TitleOptions"
                                            TextProperty="Text" ValueProperty="Value"
                                            Placeholder="Select title"
                                            Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Job Function" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value="@_editJobFunction" Placeholder="Enter job function" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="5">
                        <RadzenFormField Text="SMS User Role/Permissions *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_editUserRoleCode" Data="@SMSRoleOptions"
                                            TextProperty="Text" ValueProperty="Value"
                                            Style="width: 100%;" Placeholder="Select SMS role" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenFormField Text="SMS Organization Level" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_editOrganizationLevelId" Data="@_organizationLevelOptions"
                                            TextProperty="Text" ValueProperty="Value"
                                            Style="width: 100%;"
                                            title="Select the SMS role that determines authority and approval permissions" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenFormField Text="Require 2FA" Variant="Variant.Outlined">
                            <div class="d-flex align-items-center p-2">
                                <RadzenCheckBox @bind-Value="@_editTwoFactorEnabled" Name="TwoFactorEnabled" />
                                <RadzenLabel Text="Require 2FA" Component="TwoFactorEnabled" Style="width:120px;margin-left: 0.5rem; cursor: pointer;" />
                            </div>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenFormField Text="Active" Variant="Variant.Outlined">
                            <div class="d-flex align-items-center p-2">
                                <RadzenCheckBox @bind-Value="@_editIsActive" Name="IsActive" />
                                <RadzenLabel Text="Active" Component="IsActive" Style="width:120px;margin-left: 0.5rem; cursor: pointer;" />
                            </div>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                
                               
                <!-- Modal Footer -->
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseEditModal" />
                    <RadzenButton Text="Update User" Icon="save" ButtonStyle="ButtonStyle.Primary" 
                                  Click="@UpdateUser" Disabled="@(!_isEditFormValid || _isSaving)"
                                  Style="background-color: #212e61; border-color: #212e61;" />
                </div>
            </RadzenCard>
        </div>
    </div>
}

