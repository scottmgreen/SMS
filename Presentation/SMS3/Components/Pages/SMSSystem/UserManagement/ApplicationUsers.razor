@page "/SMSSystem/UserManagement/ApplicationUsers"
@page "/SMSSystem/UserManagement/ApplicationUsers/Edit/{Id?}"

@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS3.Components.Shared.UIHelpers
@using SMS_Application.Commands
@using SMS_Application.Queries
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects

<PageTitle>Application User Management - SMS3</PageTitle>
<!-- SMS Page Header -->
<PageHeader Title="Application User Management"
            Subtitle="@($"Manage SMS Application Users ({@ApplicationUsersList.Count()})")"
            Icon="fas fa-user-tie">
            <AdditionalContent>
                <div class="d-flex justify-content-end align-items-center w-100">
                    <div class="d-flex gap-2">
                <RadzenButton Text="Add User" Icon="add" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                      Click="@ShowCreateDialog" />
                    </div>
                </div>
            </AdditionalContent>

</PageHeader>
    <!-- Messages -->
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <RadzenRow Gap="1rem" class="rz-mb-3">
            <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenIcon Icon="check_circle" Style="margin-right: 0.5rem;" />
                    @_successMessage
                </RadzenAlert>
            </RadzenColumn>
        </RadzenRow>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <RadzenRow Gap="1rem" class="rz-mb-3">
            <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenIcon Icon="error" Style="margin-right: 0.5rem;" />
                    @_errorMessage
                </RadzenAlert>
            </RadzenColumn>
        </RadzenRow>
    }

    <!-- Users DataGrid -->

               <RadzenCard>
                    @if (ApplicationUsersList.Any())
                    {
                        <RadzenDataGrid @ref="_usersGrid" Data="@ApplicationUsersList" TItem="SMSApplicationUser"
                                        AllowFiltering="true" AllowSorting="true" AllowPaging="true"
                                        PageSize="10" ShowPagingSummary="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                            <Columns>
                                <RadzenDataGridColumn TItem="SMSApplicationUser" Property="Code" Title="User ID" Width="125px" Sortable="true" Filterable="true">
                                    <Template Context="user">
                                        <div class="d-flex align-items-center">
                                            <strong>@user.Code</strong>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="SMSApplicationUser" Property="DisplayName" Title="User" Width="200px" Sortable="true" Filterable="true">
                                    <Template Context="user">
                                        <div class="d-flex align-items-center">
                                            <div>
                                                <div><strong>@user.DisplayName</strong></div>
                                                @if (IsEmailFormat(user.UserName?.Value))
                                                {
                                                    <small>
                                                        <a href="@($"mailto:{user.UserName?.Value}")" style="color: var(--rz-text-secondary-color);">
                                                            @user.UserName?.Value
                                                        </a>
                                                    </small>
                                                }
                                                else
                                                {
                                                    <small style="color: var(--rz-text-secondary-color);">@user.UserName?.Value</small>
                                                }
                                            </div>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SMSApplicationUser" Property="Company" Title="Company" Width="180px" Sortable="true" Filterable="true">
                                    <Template Context="user">
                                        @(SMSCompany.FromValue(user.Company ?? string.Empty)?.Company ?? user.Company)
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SMSApplicationUser" Property="Organization" Title="Organization" Width="180px" Sortable="true" Filterable="true">
                                    <Template Context="user">
                                        @(SMSOrganization.FromValue(user.Organization ?? string.Empty)?.Name ?? user.Organization)
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SMSApplicationUser" Property="Title" Title="Title" Width="160px" Sortable="true" Filterable="true">
                                    <Template Context="user">
                                        @(SMSJobTitle.FromValue(user.Title ?? string.Empty)?.Name ?? user.Title)
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SMSApplicationUser" Property="JobFunction" Title="Job Function" Width="180px" Sortable="true" Filterable="true" />
                                <RadzenDataGridColumn TItem="SMSApplicationUser" Property="UserRole" Title="SMS Role/Permissions " Sortable="false" Filterable="false">
                                    <Template Context="user">
                                        @if (user.UserRole is not null)
                                        {
                                            @user.UserRole.Name 
                                        }
                                        else
                                        {
                                            <RadzenBadge Variant="Variant.Filled" BadgeStyle="BadgeStyle.Light" Text="No Role Assigned" />
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SMSApplicationUser" Property="TwoFactorEnabled" Title="2FA Required" Width="160px">
                                    <Template Context="user">
                                        <RadzenIcon Icon="@(user.TwoFactorEnabled ? "check_box" : "check_box_outline_blank")"
                                                    Style="@(user.TwoFactorEnabled ? "color: var(--rz-success);" : "color: var(--rz-danger);")" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SMSApplicationUser" Property="IsActive" Title="Active" Width="125px">
                                    <Template Context="user">
                                        <RadzenIcon Icon="@(user.IsActive ? "check_box" : "check_box_outline_blank")"
                                                    Style="@(user.IsActive ? "color: var(--rz-success);" : "color: var(--rz-danger);")" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SMSApplicationUser" Title="Actions" Width="200px" Sortable="false" Filterable="false">
                                    <Template Context="user">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                                          Click="@(() => EditUser(user.Code))"
                                                          title="Edit User" />

                                            <!-- NEW: Role Assignment Button -->
                                            <RadzenButton Icon="admin_panel_settings" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                                          Click="@(() => OpenRoleAssignmentModal(user.Code, user.DisplayName, user.UserRole?.Code))"
                                                          title="Assign Role" />

                                            <RadzenButton Icon="group" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                                          Click="@(() => ManageGroups(user.Code, user.DisplayName))" title="Manage Groups" />
                                            <RadzenButton Icon="lock" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                          Click="@(() => OpenPasswordChangeModal(user.Code, user.DisplayName))"
                                                          title="Change Password" />
                                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                          Click="@(() => ShowDeleteDialog(user.Code, user.DisplayName))"
                                                          title="Delete User" />
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                    else
                    {
                        <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 3rem;">
                            <RadzenIcon Icon="people" Style="font-size: 4rem; color: var(--rz-text-disabled-color);" />
                            <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-text-disabled-color);">
                                No Application Users Found
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-disabled-color);">
                                Click "Add User" to create your first application user.
                            </RadzenText>
                            <RadzenButton Text="Add First User" Icon="add" ButtonStyle="ButtonStyle.Primary"
                                          Click="@ShowCreateDialog" />
                        </RadzenStack>
                    }
                </RadzenCard>
    


<!-- Role Assignment Modal -->
@if (_showRoleAssignmentModal)
{
    <div class="modal-backdrop">
        <div class="modal-dialog modal-lg">
            <RadzenCard class="modal-content">
                <div class="modal-header" style="background-color: #212e61; color: white; padding: 1rem; margin: -1rem -1rem 1rem -1rem; border-radius: 6px 6px 0 0; flex-shrink: 0;">
                    <h5 class="modal-title" style="margin: 0; color: white;">
                        <i class="fas fa-user-shield"></i> Assign Role: @_roleAssignmentUserDisplayName
                    </h5>
                </div>
                <div class="modal-body" style="flex: 1; overflow-y: auto; padding-bottom: 1rem;">
                    <RadzenStack>
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Current Role" Variant="Variant.Outlined">
                                <RadzenTextBox Value="@(_currentUserRoleCode ?? "No role assigned")"
                                               ReadOnly="true"
                                               Style="background-color: #f8f9fa;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenFormField Text="Select Role" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@_selectedRoleCode"
                                                Data="@AvailableRoles"
                                                TextProperty="Name"
                                                ValueProperty="Code"
                                                Placeholder="Select a role..."
                                                Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                    </RadzenStack>
                    <br>
                    @if (!string.IsNullOrEmpty(_selectedRoleCode))
                    {
                        var selectedRole = AvailableRoles.FirstOrDefault(r => r.Code == _selectedRoleCode);
                        @if (selectedRole?.Permissions?.Any() == true)
                        {
                        <div style="max-height: 300px; overflow-y: auto; border: 1px solid #e0e0e0; border-radius: 4px;">
                            <RadzenDataGrid Data="@_smsModules" TItem="string" AllowPaging="false" class="permission-view-grid" 
                                            Style="height: auto; min-height: auto;">
                            <Columns>
                                <RadzenDataGridColumn TItem="string" Title="Module" Width="30%">
                                    <Template Context="module">
                                        <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 600;">@module</RadzenText>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="string" Title="Create" Width="17.5%">
                                    <Template Context="module">
                                        <div class="text-center">
                                            @if (IsPermissionGranted(selectedRole, module, "Create"))
                                            {
                                                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                <div><small class="text-success">Granted</small></div>
                                            }
                                            else
                                            {
                                                <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                <div><small class="text-muted">Denied</small></div>
                                            }
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="string" Title="Read" Width="17.5%">
                                    <Template Context="module">
                                        <div class="text-center">
                                            @if (IsPermissionGranted(selectedRole, module, "Read"))
                                            {
                                                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                <div><small class="text-success">Granted</small></div>
                                            }
                                            else
                                            {
                                                <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                <div><small class="text-muted">Denied</small></div>
                                            }
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="string" Title="Update" Width="17.5%">
                                    <Template Context="module">
                                        <div class="text-center">
                                            @if (IsPermissionGranted(selectedRole, module, "Update"))
                                            {
                                                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                <div><small class="text-success">Granted</small></div>
                                            }
                                            else
                                            {
                                                <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                <div><small class="text-muted">Denied</small></div>
                                            }
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="string" Title="Delete" Width="17.5%">
                                    <Template Context="module">
                                        <div class="text-center">
                                                @if (IsPermissionGranted(selectedRole, module, "Delete"))
                                            {
                                                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                <div><small class="text-success">Granted</small></div>
                                            }
                                            else
                                            {
                                                <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                <div><small class="text-muted">Denied</small></div>
                                            }
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                            </RadzenDataGrid>
                        </div>
                        }
                        else
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
                                <RadzenIcon Icon="info" Style="margin-right: 0.5rem;" />
                                Selected role has no specific permissions defined.
                            </RadzenAlert>
                        }
                    }
                </div>
                <div class="d-flex justify-content-end align-items-center mt-4" style="flex-shrink: 0; padding-top: 1rem; border-top: 1px solid #e0e0e0;">
                    <div class="d-flex gap-2">
                        <RadzenButton Text="Cancel"
                                      Icon="cancel"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Click="@CloseRoleAssignmentModal" />

                        <RadzenButton Text="Assign Role"
                                      Icon="person_add"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="@AssignUserRole"
                                      Disabled="@(string.IsNullOrEmpty(_selectedRoleCode) || _isSaving)" />
                    </div>
                </div>
            </RadzenCard>
        </div>
    </div>
}

<!-- Edit User Modal -->
@if (_isEditMode && _currentUser is not null)
{
    <div class="modal-backdrop">
        <div class="modal-dialog sms-modal-body">
            <RadzenCard class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header" style="background-color: #212e61; color: white; padding: 1rem; margin: -1rem -1rem 1rem -1rem; border-radius: 6px 6px 0 0;">
                    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: white;">
                        <RadzenIcon Icon="edit" Style="margin-right: 0.5rem;" />
                        Edit Application User - @_currentUser.Code
                    </RadzenText>
                </div>
                
                <!-- Modal Body -->
                <RadzenRow Gap=".5rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="First Name *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value="@_editUser.FirstName" Placeholder="Enter first name" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Last Name *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value="@_editUser.LastName" Placeholder="Enter last name" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap=".5rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Username" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox Value="@_currentUser.UserName?.Value" ReadOnly="true" Style="width: 100%; background-color: #f8f9fa;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap=".5rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Company" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_editUser.Company"
                                            Data="@CompanyOptions"
                                            TextProperty="Text"
                                            ValueProperty="Value"
                                            Placeholder="Select company"
                                            Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap=".5rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Organization" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_editUser.Organization"
                                            Data="@OrganizationOptions"
                                            TextProperty="Text"
                                            ValueProperty="Value"
                                            Placeholder="Select organization"
                                            Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap=".5rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Title" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_editUser.Title"
                                            Data="@TitleOptions"
                                            TextProperty="Text"
                                            ValueProperty="Value"
                                            Placeholder="Select title"
                                            Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap=".5rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Job Function" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value="@_editUser.JobFunction" Placeholder="Enter job function" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap=".5rem">
                    <RadzenColumn Size="12" SizeMD="5">
                        <RadzenFormField Text="SMS User Role/Permissions *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_editUserRoleCode"
                                            Data="@AvailableRoles"
                                            TextProperty="Name"
                                            ValueProperty="Code"
                                            Style="width: 100%;" Placeholder="Select a role" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="5">
                        <RadzenFormField Text="Require 2FA" Variant="Variant.Outlined">
                            <div class="d-flex align-items-center p-2">
                                <RadzenCheckBox @bind-Value="@_currentUser.TwoFactorEnabled" Name="TwoFactorEnabled" />
                                <RadzenLabel Text="Require 2FA" Component="TwoFactorEnabled" Style="width:120px;margin-left: 0.5rem; cursor: pointer;" />
                            </div>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenFormField Text="Active" Variant="Variant.Outlined">
                            <div class="d-flex align-items-center p-2">
                                <RadzenCheckBox @bind-Value="@_currentUser.IsActive" Name="IsActive" />
                                <RadzenLabel Text="Active" Component="IsActive" Style="width:120px;margin-left: 0.5rem; cursor: pointer;" />
                            </div>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                
                <!-- Modal Footer -->
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CancelEdit" />
                    <RadzenButton Text="Update User" Icon="save" ButtonStyle="ButtonStyle.Primary" 
                                  Click="@(() => UpdateUser(_editUser))"
                                  Style="background-color: #212e61; border-color: #212e61;" />
                </div>
            </RadzenCard>
        </div>
    </div>
}

<!-- Shared Password Change Modal -->
<PasswordChangeDialog IsVisible="@_showPasswordModal"
                     UserCode="@_passwordUserCode"
                     UserDisplayName="@_passwordUserDisplayName"
                     UserType="Application"
                     OnPasswordChanged="@OnPasswordChangedSuccess"
                     OnCancel="@ClosePasswordChangeModal" />

<!-- Create User Modal -->
@if (_showCreateModal)
{
    <div class="modal-backdrop">
        <div class="modal-dialog sms-modal-body">
            <RadzenCard class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header" style="background-color: #212e61; color: white; padding: 1rem; margin: -1rem -1rem 1rem -1rem; border-radius: 6px 6px 0 0;">
                    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: white;">
                        <RadzenIcon Icon="person_add" Style="margin-right: 0.5rem;" />
                        Create Application User
                    </RadzenText>
                </div>
                
                <!-- Modal Body -->
                <RadzenRow Gap=".5rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="First Name *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value="@_newUser.FirstName" Placeholder="Enter first name" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="Last Name *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value="@_newUser.LastName" Placeholder="Enter last name" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="User Name *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value="@_newUser.UserName" Placeholder="Enter user name" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap=".5rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Password *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenPassword @bind-Value="@_newUser.Password" Placeholder="Enter password" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Confirm Password *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenPassword @bind-Value="@_newUser.ConfirmPassword" Placeholder="Confirm password" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap=".5rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Company" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_newUser.Company"
                                            Data="@CompanyOptions"
                                            TextProperty="Text"
                                            ValueProperty="Value"
                                            Placeholder="Select company"
                                            Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap=".5rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Organization" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_newUser.Organization"
                                            Data="@OrganizationOptions"
                                            TextProperty="Text"
                                            ValueProperty="Value"
                                            Placeholder="Select organization"
                                            Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap=".5rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Title" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_newUser.Title"
                                            Data="@TitleOptions"
                                            TextProperty="Text"
                                            ValueProperty="Value"
                                            Placeholder="Select title"
                                            Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap=".5rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Job Function" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value="@_newUser.JobFunction" Placeholder="Enter job function" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow Gap=".5rem">
                    <RadzenColumn Size="12" SizeMD="5">
                        <RadzenFormField Text="SMS Role *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                            <RadzenDropDown @bind-Value="@_newUser.UserRoleCode"
                                            Data="@AvailableRoles"
                                            TextProperty="Name"
                                            ValueProperty="Code"
                                            Style="width: 100%;" Placeholder="Select a role" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="5">
                        <RadzenFormField Text="Require 2FA" Variant="Variant.Outlined">
                            <div class="d-flex align-items-center p-2">
                            <RadzenCheckBox @bind-Value="@_newUser.TwoFactorEnabled" Name="NewUserTwoFactorEnabled" />
                                <RadzenLabel Text="Require 2FA" Component="NewUserTwoFactorEnabled" Style="width:120px;margin-left: 0.5rem; cursor: pointer;" />
                            </div>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenFormField Text="Active" Variant="Variant.Outlined">
                            <div class="d-flex align-items-center p-2">
                                <RadzenCheckBox @bind-Value="@_newIsActive" Name="NewIsActive" />
                                <RadzenLabel Text="Active" Component="NewIsActive" Style="width:120px;margin-left: 0.5rem; cursor: pointer;" />
                            </div>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                
                <!-- Modal Footer -->
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseCreateModal" />
                    <RadzenButton Text="Create User" Icon="save" ButtonStyle="ButtonStyle.Primary" 
                                  Click="@CreateUser" Disabled="@(!_isCreateFormValid || _isSaving)"
                                  Style="background-color: #212e61; border-color: #212e61;" />
                </div>
            </RadzenCard>
        </div>
    </div>
}

<!-- Group Management Modal -->
@if (_showGroupsModal && !string.IsNullOrEmpty(_groupManagementUserCode))
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-lg">
            <div class="sms-modal-content">
                <!-- Modal Header -->
                <div class="sms-modal-header sms-header-primary">
                    <h5 class="sms-modal-title">
                        <i class="fas fa-users"></i> Manage Groups: @_groupManagementUserDisplayName
                    </h5>
                </div>

                <!-- Modal Body -->
                <div class="sms-modal-body">
                    <RadzenRow Gap="1rem" Style="height: 500px;">
                        <!-- Current User Groups -->
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenCard Style="height: 100%;">
                                <RadzenCard Style="background-color: #e8f5e8; margin: -0.5rem -0.5rem 1rem -0.5rem; padding: 0.5rem;">
                                    <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0; color: #28a745;">
                                        <RadzenIcon Icon="groups" Style="margin-right: 0.5rem;" />
                                        @($"Currently Assigned {EntityDisplayNameHelper.GetPluralEntityName<SMSApplicationGroup>()}")
                                    </RadzenText>
                                </RadzenCard>
                                <div style="height: 400px; overflow-y: auto;">
                                    @if (UserCurrentGroups.Any())
                                    {
                                        @foreach (var group in UserCurrentGroups.OrderBy(g => g.Name))
                                        {
                                            <RadzenCard class="mb-2" Style="background-color: #f8f9fa;">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0;">
                                                            @group.Name
                                                        </RadzenText>
                                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                            @group.Code
                                                        </RadzenText>
                                                        @if (!string.IsNullOrEmpty(group.Description))
                                                        {
                                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                                @group.Description
                                                            </RadzenText>
                                                        }
                                                    </div>
                                                    <RadzenButton Icon="group_remove" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                                  Click="@(() => RemoveUserFromGroup(group.Code))" title="Remove from group" />
                                                </div>
                                            </RadzenCard>
                                        }
                                    }
                                    else
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
                                            This user is not currently assigned to any application groups.
                                        </RadzenAlert>
                                    }
                                </div>
                            </RadzenCard>
                        </RadzenColumn>

                        <!-- Available Groups -->
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenCard Style="height: 100%;">
                                <RadzenCard Style="background-color: #e3f2fd; margin: -0.5rem -0.5rem 1rem -0.5rem; padding: 0.5rem;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0; color: #007bff;">
                                            <RadzenIcon Icon="group_add" Style="margin-right: 0.5rem;" />
                                            @($"Available {EntityDisplayNameHelper.GetPluralEntityName<SMSApplicationGroup>()}")
                                        </RadzenText>
                                        <RadzenButton Text="Assign Selected" Icon="group_add" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                                      Click="@AssignMultipleGroups" Disabled="@(!SelectedGroups.Any(s => s.Value))" />
                                    </div>
                                </RadzenCard>
                                <div style="height: 400px; overflow-y: auto;">
                                    @if (AvailableGroups.Any())
                                    {
                                        @foreach (var group in AvailableGroups.OrderBy(g => g.Name))
                                        {
                                            <RadzenCard class="mb-2">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="d-flex align-items-center">
                                                        <RadzenCheckBox @bind-Value="SelectedGroups[group.Code]" class="me-2" />
                                                        <div>
                                                            <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0;">
                                                                @group.Name
                                                            </RadzenText>
                                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                                @group.Code
                                                            </RadzenText>
                                                            @if (!string.IsNullOrEmpty(group.Description))
                                                            {
                                                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                                    @group.Description
                                                                </RadzenText>
                                                            }
                                                        </div>
                                                    </div>
                                                    <RadzenButton Icon="group_add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                                                  Click="@(() => AssignUserToGroup(group.Code))" title="Assign to group" />
                                                </div>
                                            </RadzenCard>
                                        }
                                    }
                                    else
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
                                            <RadzenIcon Icon="warning" Style="margin-right: 0.5rem;" />
                                            This user is already assigned to all available application groups.
                                        </RadzenAlert>
                                    }
                                </div>
                            </RadzenCard>
                        </RadzenColumn>
                    </RadzenRow>
                </div>

                <!-- Modal Footer -->
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end align-items-center">
                        <div class="d-flex gap-2">
                            <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" Click="@CloseGroupsModal" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

