@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq
@using SMS3.Components.Pages.SMSSystem.Models


@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IEmailSender EmailSender

@inherits EmailComposeDialogBase

<RadzenTemplateForm Data="@Model" Submit="@SendAsync" TItem="EmailComposeModel" class="compose-root">

    <!-- Title bar -->
    <div class="compose-titlebar">
        <div class="compose-title">@DialogTitle</div>
    </div>

    <!-- Header fields (Outlook-like) -->
    <div class="compose-header">
        <!-- TO -->
        
            <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center">
                <RadzenColumn Size="1" class="text-end">
                    <RadzenLabel>To:</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="11" class="text-start">
                    <div class="to-recipient-container @(Model.HasToValidationError ? "to-recipient-validation-error" : string.Empty)">
                        @foreach (string recipient in Model.To)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Base" Text="@recipient" class="me-2" />
                        }

                        @if (!Model.To.Any())
                        {
                            <span class="text-muted">No To recipients resolved.</span>
                        }
                    </div>

                    @if (Model.HasToValidationError && !string.IsNullOrWhiteSpace(Model.ToValidationMessage))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" class="mt-2">
                            <RadzenIcon Icon="error" Style="margin-right: 0.5rem;" />
                            @Model.ToValidationMessage
                        </RadzenAlert>
                    }
                </RadzenColumn>
            </RadzenRow>
        

        <!-- CC (toggleable) -->
        
        @if (ShowCc)
        {
            <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center" class="mt-2">
                <RadzenColumn Size="1" class="text-end">
                    <RadzenLabel>Cc:</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="11" class="text-start">
                    @if (!PreviewOnly)
                    {
                        <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center" class="mb-2">
                            <RadzenColumn Size="10">
                                <RadzenTextBox @bind-Value="CcEntryText" Placeholder="Add CC email and press Enter" Style="width:100%;" @onkeydown="@AddCcRecipientOnEnter" />
                            </RadzenColumn>
                            <RadzenColumn Size="2">
                                <RadzenButton Icon="add" Text="Add" ButtonStyle="ButtonStyle.Light" Click="@AddCcRecipient" />
                            </RadzenColumn>
                        </RadzenRow>
                    }

                    @if (Model.Cc.Any())
                    {
                        <div>
                            @foreach (var cc in Model.Cc)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Base" Text="@cc" class="me-2 mb-2" />
                                @if (!PreviewOnly)
                                {
                                    <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Base" Click="@(() => RemoveCcRecipient(cc))" class="me-2 mb-2" />
                                }
                            }
                        </div>
                    }
                </RadzenColumn>
            </RadzenRow>
        }

        @if (ShowBcc)
        {
            <div class="compose-row">
                <label class="compose-label">Bcc</label>
                <div class="compose-field">
                    
                </div>
            </div>
        }

        <!-- Subject -->
        <br />
        <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center">
            <RadzenColumn Size="1" class="text-end">
                <RadzenLabel>Subject</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="11" class="text-start">
                
                    <RadzenTextBox @bind-Value="Model.Subject" Placeholder="Add a subject" class="subject-input" Disabled="@PreviewOnly" />
                
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center" class="mt-2">
            <RadzenColumn Size="1" class="text-end">
                <i class="fas fa-paperclip"></i>
            </RadzenColumn>
            <RadzenColumn Size="11" class="text-start">
                @if (!PreviewOnly)
                {
                    <label class="rz-button rz-button-md rz-button-light rz-shade-default mb-2" for="email-attachments-input">
                        <span class="rz-button-icon-left rzi rzi-attach_file"></span>
                        <span class="rz-button-text">Attach</span>
                    </label>
                    <InputFile id="email-attachments-input" OnChange="@AddAttachmentAsync" multiple style="display:none" />
                }

                @if (Model.Attachments.Any())
                {
                    <div>
                        @foreach (var attachment in Model.Attachments)
                        {
                            <RadzenBadge Text="@attachment.FileName" BadgeStyle="BadgeStyle.Base" class="me-2 mb-2" />
                            @if (!PreviewOnly)
                            {
                                <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => RemoveAttachment(attachment))" class="me-2 mb-2" />
                            }
                        }
                    </div>
                }
            </RadzenColumn>
        </RadzenRow>

       
    </div>

    <!-- Editor (Outlook-style compact) -->
    <div class="compose-editor">
        <RadzenHtmlEditor @bind-Value="Model.BodyHtml" class="editor" Height="280px" Disabled="@PreviewOnly">
            
                <RadzenHtmlEditorUndo />
                <RadzenHtmlEditorRedo />
                <RadzenHtmlEditorSeparator />
                <RadzenHtmlEditorBold />
                <RadzenHtmlEditorItalic />
                <RadzenHtmlEditorUnderline />
                <RadzenHtmlEditorStrikeThrough />
                <RadzenHtmlEditorSeparator />
                <RadzenHtmlEditorColor />
                <RadzenHtmlEditorBackground />
                <RadzenHtmlEditorRemoveFormat />
            
        </RadzenHtmlEditor>
    </div>

    <!-- Actions -->
    <div class="compose-actions">
        @if (!PreviewOnly)
        {
            <RadzenButton Text="Send" Icon="send" ButtonStyle="ButtonStyle.Primary" Click="@SendAsync" Disabled="@IsSending" />
            <RadzenButton Text="Discard" Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@Close" class="ms-8" />
        }
        else
        {
            <RadzenButton Text="Close" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@Close" class="ms-8" />
        }
        @if (IsSending)
        {
            <span class="sending-indicator">Sending…</span>
        }
    </div>

</RadzenTemplateForm>