@using Radzen
@using Radzen.Blazor
@using SMS_Domain.Entities

<RadzenStack Gap="1rem">
    <RadzenFormField Text="User" Variant="Variant.Outlined">
        <RadzenTextBox Value="@DisplayName" Disabled="true" />
    </RadzenFormField>

    <RadzenFormField Text="Select Role" Variant="Variant.Outlined">
        <RadzenDropDown @bind-Value="@SelectedRoleCode" Data="@UserRoles" 
                      ValueProperty="Code" TextProperty="Name" 
                      Placeholder="-- Remove Role Assignment --" AllowClear="true" />
    </RadzenFormField>
    <RadzenText TextStyle="TextStyle.Caption">Select a role to assign permissions and access levels</RadzenText>

    @if (!string.IsNullOrEmpty(CurrentRoleCode))
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter">
            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                <strong>Current Role:</strong> @GetCurrentRoleName()
            </RadzenText>
        </RadzenAlert>
    }

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-4">
        <RadzenButton Text="Cancel" Variant="Variant.Text" Click="@Cancel" />
        <RadzenButton Text="Assign Role" Icon="admin_panel_settings" ButtonStyle="ButtonStyle.Success" 
                    Click="@AssignRole" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter] public string UserId { get; set; } = "";
    [Parameter] public string DisplayName { get; set; } = "";
    [Parameter] public string CurrentRoleCode { get; set; } = "";
    [Parameter] public IEnumerable<SMSUserRole> UserRoles { get; set; } = new List<SMSUserRole>();
    [CascadingParameter] public DialogService? DialogService { get; set; }

    private string SelectedRoleCode { get; set; } = "";

    protected override void OnInitialized()
    {
        SelectedRoleCode = CurrentRoleCode;
    }

    private void AssignRole()
    {
        DialogService?.Close(SelectedRoleCode);
    }

    private void Cancel()
    {
        DialogService?.Close();
    }

    private string GetCurrentRoleName()
    {
        var role = UserRoles.FirstOrDefault(r => r.Code == CurrentRoleCode);
        return role?.Name ?? CurrentRoleCode;
    }
}
