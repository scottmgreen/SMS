@using Radzen
@using Radzen.Blazor

<RadzenStack Gap="1rem">
    <RadzenText>
        Changing password for: <strong>@DisplayName</strong>
    </RadzenText>
    
    <RadzenFormField Text="New Password *" Variant="Variant.Outlined">
        <RadzenPassword @bind-Value="@NewPassword" 
                       Placeholder="Enter new password" 
                       Style="width: 100%;" />
    </RadzenFormField>
    
    <RadzenFormField Text="Confirm Password *" Variant="Variant.Outlined">
        <RadzenPassword @bind-Value="@ConfirmPassword" 
                       Placeholder="Confirm new password" 
                       Style="width: 100%;" />
    </RadzenFormField>
    
    @if (!string.IsNullOrEmpty(ValidationMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter">
            <RadzenIcon Icon="warning" Style="margin-right: 0.5rem;" />
            @ValidationMessage
        </RadzenAlert>
    }
</RadzenStack>

<div class="d-flex justify-content-end gap-2 mt-3">
    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => dialogService.Close())" />
    <RadzenButton Text="Update Password" Icon="save" ButtonStyle="ButtonStyle.Primary" 
                  Click="@UpdatePassword" Disabled="@(!IsValid)" />
</div>

@code {
    [Inject] private DialogService dialogService { get; set; } = default!;

    [Parameter] public string UserId { get; set; } = string.Empty;
    [Parameter] public string DisplayName { get; set; } = string.Empty;

    private string NewPassword { get; set; } = string.Empty;
    private string ConfirmPassword { get; set; } = string.Empty;
    private string ValidationMessage { get; set; } = string.Empty;

    private bool IsValid => 
        !string.IsNullOrWhiteSpace(NewPassword) &&
        !string.IsNullOrWhiteSpace(ConfirmPassword) &&
        NewPassword == ConfirmPassword &&
        NewPassword.Length >= 8;

    private void UpdatePassword()
    {
        ValidationMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(NewPassword) || string.IsNullOrWhiteSpace(ConfirmPassword))
        {
            ValidationMessage = "Both password fields are required.";
            return;
        }

        if (NewPassword != ConfirmPassword)
        {
            ValidationMessage = "Passwords do not match.";
            return;
        }

        if (NewPassword.Length < 8)
        {
            ValidationMessage = "Password must be at least 8 characters long.";
            return;
        }

        // Return the new password to the calling component
        dialogService.Close(NewPassword);
    }
}
