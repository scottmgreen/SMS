@page "/SMSSystem/EventBus/DataSourceDiscovery"
@using SMS_Application.Common
@using static SMS_Application.Common.SPIConstants

<PageTitle>Dynamic Event Data Source Discovery</PageTitle>

<div class="container-fluid">
    <RadzenRow Gap="1rem" class="mb-4">
        <RadzenColumn Size="12">
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">
                    <RadzenIcon Icon="search" Style="margin-right: 0.5rem;" />
                    Dynamic Event Data Source Discovery
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle1" class="text-muted">
                    Demonstrates automatic discovery of domain events implementing IEventDataSource
                </RadzenText>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    @if (_isLoading)
    {
        <RadzenCard>
            <div class="d-flex justify-content-center p-4">
                <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" />
                <span class="ms-3">Discovering event data sources...</span>
            </div>
        </RadzenCard>
    }
    else
    {
        <!-- Summary Statistics -->
        <RadzenRow Gap="1rem" class="mb-4">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard class="stat-card primary">
                    <div class="stat-content">
                        <div class="stat-number">@_eventDataSources.Count</div>
                        <div class="stat-label">Event Data Sources</div>
                    </div>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard class="stat-card success">
                    <div class="stat-content">
                        <div class="stat-number">@_groupedSources.Count</div>
                        <div class="stat-label">Categories</div>
                    </div>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard class="stat-card info">
                    <div class="stat-content">
                        <div class="stat-number">@_eventDataSources.Count(eds => eds.IsAutomatic)</div>
                        <div class="stat-label">Automatic Sources</div>
                    </div>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <!-- Event Data Sources by Category -->
        @foreach (var category in _groupedSources)
        {
            <RadzenCard class="mb-4">
                <RadzenText TextStyle="TextStyle.H5">
                    ?? @category.Key Category
                </RadzenText>
                <RadzenDataGrid Data="@category.Value" TItem="EventDataSourceInfo" 
                               AllowPaging="false" AllowSorting="true" class="mt-3">
                    <Columns>
                        <RadzenDataGridColumn TItem="EventDataSourceInfo" Property="DisplayName" Title="Display Name">
                            <Template Context="source">
                                <strong>@source.DisplayName</strong>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="EventDataSourceInfo" Property="EventTypeName" Title="Event Type">
                            <Template Context="source">
                                <code>@source.EventTypeName</code>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="EventDataSourceInfo" Property="Description" Title="Description">
                            <Template Context="source">
                                <small class="text-muted">@source.Description</small>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="EventDataSourceInfo" Property="Priority" Title="Priority" Width="100px">
                            <Template Context="source">
                                <RadzenBadge BadgeStyle="@GetPriorityBadgeStyle(source.Priority)" 
                                           Text="@source.Priority.ToString()" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="EventDataSourceInfo" Property="IsAutomatic" Title="Auto" Width="80px">
                            <Template Context="source">
                                @if (source.IsAutomatic)
                                {
                                    <RadzenIcon Icon="check_circle" Style="color: green;" Title="Automatic Data Source" />
                                }
                                else
                                {
                                    <RadzenIcon Icon="radio_button_unchecked" Style="color: gray;" Title="Manual Data Source" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenCard>
        }

        <!-- Dropdown Preview -->
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.H5">
                ?? SPI Configuration Dropdown Preview
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Subtitle2" class="text-muted mb-3">
                This is what users would see in the SPI Edit Dialog data source dropdown:
            </RadzenText>
            <RadzenFormField Text="Data Source" Style="width: 400px;">
                <RadzenDropDown Data="@_dataSourceNames" @bind-Value="@_selectedDataSource" 
                               Placeholder="Select a data source..." 
                               AllowClear="true" />
            </RadzenFormField>

            @if (!string.IsNullOrEmpty(_selectedDataSource))
            {
                var selectedInfo = _eventDataSources.FirstOrDefault(eds => eds.DisplayName == _selectedDataSource);
                if (selectedInfo != null)
                {
                    <div class="mt-3 p-3" style="background-color: #f8f9fa; border-radius: 4px;">
                        <strong>Selected:</strong> @selectedInfo.DisplayName<br/>
                        <strong>Event Type:</strong> <code>@selectedInfo.EventTypeName</code><br/>
                        <strong>Category:</strong> @selectedInfo.Category<br/>
                        <strong>Description:</strong> @selectedInfo.Description
                    </div>
                }
            }
        </RadzenCard>
    }
</div>

<style>
    .stat-card {
        border-left: 4px solid var(--rz-primary);
        transition: transform 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
    }

    .stat-card.primary { border-left-color: #0d6efd; }
    .stat-card.success { border-left-color: #198754; }
    .stat-card.info { border-left-color: #0dcaf0; }

    .stat-content {
        text-align: center;
        padding: 1rem;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: bold;
        color: var(--rz-primary);
    }

    .stat-label {
        font-size: 0.9rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
</style>