@page "/auth-complete"
@inject NavigationManager Navigation
@inject ISMSSessionService SessionService
@inject ILogger<AuthComplete> Logger
@using Microsoft.AspNetCore.WebUtilities
@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using SMS3.Components.Pages

<PageTitle>Completing Login...</PageTitle>

@if (!string.IsNullOrEmpty(_redirectUrl))
{
    <script>
        setTimeout(function() {
            window.location.href = '@_redirectUrl';
        }, 500);
    </script>
}

<div class="text-center mt-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Completing login...</span>
    </div>
    <p class="mt-3">Completing your login...</p>
</div>

@code {
    private string? _redirectUrl = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Get the auth token from query string
            var uri = new Uri(Navigation.Uri);
            var query = QueryHelpers.ParseQuery(uri.Query);
            var token = query.TryGetValue("token", out var tokenValue) ? tokenValue.FirstOrDefault() : null;

            if (string.IsNullOrEmpty(token))
            {
                Logger.LogWarning("No auth token provided to auth-complete page");
                _redirectUrl = "/login?error=invalid-token";
                return;
            }

            // Retrieve the auth data
            var authData = Login.TempAuthCache.Get<dynamic>(token);
            if (authData == null)
            {
                Logger.LogWarning("Invalid or expired auth token: {Token}", token);
                _redirectUrl = "/login?error=expired-token";
                return;
            }

            // Extract user data
            var user = authData.User as BaseUser;
            var userType = (SMSUserType)authData.UserType;

            if (user == null)
            {
                Logger.LogError("Invalid user data in auth token: {Token}", token);
                _redirectUrl = "/login?error=invalid-data";
                return;
            }

            // Create session with the user data that already includes permissions
            await SessionService.CreateSMSSessionAsync(user, userType);
            Logger.LogInformation("Session created successfully for user: {UserCode}", user.Code);

            // Verify session was created
            var isAuthenticated = SessionService.IsAuthenticated();
            if (!isAuthenticated)
            {
                Logger.LogError("Session verification failed after creation for user: {UserCode}", user.Code);
                _redirectUrl = "/login?error=session-failed";
                return;
            }

            // Clean up the temporary auth data
            Login.TempAuthCache.Remove(token);

            // Record successful authentication audit (fire and forget)
            _ = Task.Run(async () =>
            {
                try
                {
                    Logger.LogInformation("Authentication completed successfully for user: {UserCode}", user.Code);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to record authentication completion audit");
                }
            });

            // Success - redirect to home
            _redirectUrl = "/";
            Logger.LogInformation("Authentication flow completed, redirecting to home page");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in auth completion flow");
            _redirectUrl = "/login?error=completion-failed";
        }
    }
}

<style>
    .spinner-border {
        width: 3rem;
        height: 3rem;
    }
</style>