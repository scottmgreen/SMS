@page "/s/{*encryptedUrl}"
@using SMS3.Security
@using global::System.Reflection
@using Microsoft.AspNetCore.Components
@inject ICurrentUserService _currentUserService
@inject ISecureRoutingService SecureRoutingService
@inject NavigationManager Navigation

@if (ComponentToRender != null)
{
    <DynamicComponent Type="@ComponentToRender" Parameters="@ComponentParameters" />
}
else if (IsLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading secure content...</span>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <h3>Secure Route Not Found</h3>
        <p>The requested secure route could not be resolved.</p>
        <button class="btn btn-primary" @onclick="GoHome">Go Home</button>
    </div>
}

