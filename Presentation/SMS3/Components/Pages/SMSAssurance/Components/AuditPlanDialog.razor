@using Radzen
@using Radzen.Blazor
@using SMS_Domain.Entities
@using SMS3.Components.Shared

<!-- SMS Page Header with Additional Content -->
<PageHeader Title="@(IsNew ? "Create New Audit Plan" : "Edit Audit Plan")"
           Subtitle="@(IsNew ? "Plan and define audit scope, objectives, and requirements" : $"Editing audit plan: {AuditPlan?.Name}")"
           Icon="fas fa-clipboard-list">
    <AdditionalContent>
        <div class="d-flex gap-2">
            <RadzenButton ButtonStyle="ButtonStyle.Light" 
                         Text="Generate Code" 
                         Icon="auto_fix_high"
                         Size="ButtonSize.Small"
                         Click="@GenerateCode"
                         Disabled="@(!IsNew)" />
            <RadzenButton ButtonStyle="ButtonStyle.Info" 
                         Text="Help" 
                         Icon="help"
                         Size="ButtonSize.Small" />
        </div>
    </AdditionalContent>
</PageHeader>

<RadzenStack Orientation="Orientation.Vertical" Gap="1.5rem">
    <!-- Form Header -->
    @* <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
        <RadzenText TextStyle="TextStyle.H5" Style="margin: 0;">
            @(IsNew ? "Create New Audit Plan" : "Edit Audit Plan")
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color); margin: 0;">
            Plan and define audit scope, objectives, and requirements
        </RadzenText>
    </RadzenStack> *@

    <!-- Validation Message -->
    @if (!IsValid)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat">
            @ValidationMessage
        </RadzenAlert>
    }

    <!-- Form Content -->
    <RadzenTabs @bind-SelectedIndex="selectedTabIndex" RenderMode="TabRenderMode.Client">
        <Tabs>
            <!-- Basic Information Tab -->
            <RadzenTabsItem Text="Basic Information" Icon="info">
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="padding: 1rem;">
                    <!-- Code and Name Row -->
                    <RadzenRow Gap="1rem">
                        @* <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Audit Plan Code" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="@Code" 
                                             Placeholder="e.g., INT-2024-001"
                                             Style="width: 100%;" />
                            </RadzenFormField>
                            <RadzenButton Text="Generate" 
                                        ButtonStyle="ButtonStyle.Light" 
                                        Size="ButtonSize.ExtraSmall"
                                        Click="@GenerateCode" 
                                        Style="margin-top: 0.25rem;" />
                        </RadzenColumn> *@
                        <RadzenColumn Size="12" SizeMD="12">
                            <RadzenFormField Text="Audit Plan Name" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="@Name" 
                                             Placeholder="Enter audit plan name"
                                             Style="width: 100%;min-width:100%" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Description -->
                    <RadzenFormField Text="Description" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@Description" 
                                      Placeholder="Describe the purpose and background of this audit"
                                      Rows="3" 
                                      Style="width: 100%;" />
                    </RadzenFormField>

                    <!-- Type and Department Row -->
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Audit Type" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@AuditType" 
                                              Data="@AuditTypeOptions" 
                                              Placeholder="Select audit type"
                                              Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Responsible Department" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@ResponsibleDepartment" 
                                              Data="@DepartmentOptions" 
                                              Placeholder="Select department"
                                              Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Priority and Status Row -->
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Priority" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@Priority" 
                                              Data="@PriorityOptions" 
                                              Placeholder="Select priority"
                                              Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Status" Variant="Variant.Outlined">
                                <RadzenDropDown Value="@Status" 
                                              Data="@StatusOptions" 
                                              Placeholder="Select status"
                                              ValueChanged="@((string value) => OnStatusChanged(value))"
                                              Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="0.5rem" Style="height: 100%; justify-content: center;">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenCheckBox Value="@RequiresApproval"
                                                    ValueChanged="@((bool value) => OnRequiresApprovalChanged(value))"
                                                    Name="RequiresApprovalCheckbox" />
                                    <RadzenLabel Text="Requires Approval" Component="RequiresApprovalCheckbox" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Help and Guidelines Section -->
                    @if (RequiresApproval)
                    {
                        <RadzenCard Variant="Variant.Text" Style="background-color: #f8f9fa; border-left: 4px solid var(--rz-info);">
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                <RadzenText TextStyle="TextStyle.Subtitle2">
                                    <i class="fas fa-info-circle"></i> Approval Process Guidelines
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2">
                                    To get this audit plan approved, ensure all required fields are completed and use the Approval Workflow tab to manage approval details.
                                </RadzenText>
                            </RadzenStack>
                        </RadzenCard>
                    }
                </RadzenStack>
            </RadzenTabsItem>

            <!-- Scope & Objectives Tab -->
            <RadzenTabsItem Text="Scope & Objectives" Icon="target">
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="padding: 1rem;">
                    <!-- Scope -->
                    <RadzenFormField Text="Audit Scope" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@Scope" 
                                      Placeholder="Define what areas, processes, or departments will be audited"
                                      Rows="4" 
                                      Style="width: 100%;" />
                    </RadzenFormField>

                    <!-- Objectives -->
                    <RadzenFormField Text="Audit Objectives" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@Objectives" 
                                      Placeholder="List the specific objectives and goals of this audit"
                                      Rows="4" 
                                      Style="width: 100%;" />
                    </RadzenFormField>

                    <!-- Regulatory Requirements -->
                    <RadzenFormField Text="Regulatory Requirements" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@RegulatoryRequirements" 
                                      Placeholder="14 CFR Part 139 requirements, ICAO standards, or other applicable regulations"
                                      Rows="3" 
                                      Style="width: 100%;" />
                    </RadzenFormField>

                    <!-- Success Criteria -->
                    <RadzenFormField Text="Success Criteria" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@SuccessCriteria" 
                                      Placeholder="Define how success will be measured for this audit"
                                      Rows="3" 
                                      Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenTabsItem>

            <!-- Team & Schedule Tab -->
            <RadzenTabsItem Text="Team & Schedule" Icon="schedule">
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="padding: 1rem;">
                    <!-- Lead Auditor and Team Row -->
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Lead Auditor" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="@LeadAuditor" 
                                             Placeholder="Enter lead auditor name"
                                             Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Estimated Hours" Variant="Variant.Outlined">
                                <RadzenNumeric @bind-Value="@EstimatedHours" 
                                             Placeholder="Total audit hours"
                                             Min="1" Max="1000"
                                             Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Auditor Team and Contact Person -->
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenFormField Text="Auditor Team" Variant="Variant.Outlined">
                                <RadzenTextArea @bind-Value="@AuditorTeam" 
                                              Placeholder="List team members and their roles"
                                              Rows="3" 
                                              Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Contact Person" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="@ContactPerson" 
                                             Placeholder="Primary contact"
                                             Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Date Range Row -->
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Planned Start Date" Variant="Variant.Outlined">
                                <RadzenDatePicker @bind-Value="@PlannedStartDate" 
                                                DateFormat="MM/dd/yyyy"
                                                Change="@OnStartDateChanged"
                                                Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Planned End Date" Variant="Variant.Outlined">
                                <RadzenDatePicker @bind-Value="@PlannedEndDate" 
                                                DateFormat="MM/dd/yyyy"
                                                Change="@OnEndDateChanged"
                                                Style="width: 100%;" />
                            </RadzenFormField>
                            </RadzenColumn>
                    </RadzenRow>

                    <!-- Recurrence and Next Scheduled Date Row -->
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Recurrence Pattern" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@RecurrencePattern" 
                                              Data="@RecurrencePatternOptions" 
                                              Placeholder="Select recurrence"
                                              Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Next Scheduled Date" Variant="Variant.Outlined">
                                <RadzenDatePicker @bind-Value="@NextScheduledDate" 
                                                DateFormat="MM/dd/yyyy"
                                                Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Resources -->
                    <RadzenFormField Text="Required Resources" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@Resources" 
                                      Placeholder="Equipment, documents, access requirements, etc."
                                      Rows="3" 
                                      Style="width: 100%;" />
                    </RadzenFormField>

                    <!-- Deliverables -->
                    <RadzenFormField Text="Expected Deliverables" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@Deliverables" 
                                      Placeholder="Reports, findings, recommendations, presentations, etc."
                                      Rows="3" 
                                      Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenTabsItem>

            <!-- Notes Tab -->
            <RadzenTabsItem Text="Additional Notes" Icon="notes">
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="padding: 1rem;">
                    <RadzenFormField Text="Additional Notes" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@Notes" 
                                      Placeholder="Any additional information, special considerations, or requirements"
                                      Rows="8" 
                                      Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenTabsItem>

            <!-- Approval Workflow Tab - Always present but content controlled by RequiresApproval -->
            <RadzenTabsItem Text="Approval Workflow" Icon="approval" Disabled="@(!RequiresApproval)">
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="padding: 1rem;">
                    @if (RequiresApproval)
                    {
                        <!-- Current Approval Status -->
                        @if (Status == "Approved")
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat">
                                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">
                                    <i class="fas fa-check-circle"></i> Audit Plan Approved
                                </RadzenText>
                            </RadzenAlert>
                        }
                        else
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
                                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">
                                    <i class="fas fa-hourglass-half"></i> Pending Approval
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0.5rem 0 0 0;">
                                    Current Status: <RadzenBadge Text="@Status" BadgeStyle="BadgeStyle.Info" />
                                </RadzenText>
                            </RadzenAlert>
                        }

                        <!-- Approval Fields - Always available when RequiresApproval is checked -->
                        <RadzenCard Variant="Variant.Outlined">
                            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                                <RadzenText TextStyle="TextStyle.Subtitle1">
                                    <i class="fas fa-user-check"></i> Approval Information
                                </RadzenText>
                                
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Approved By" Variant="Variant.Outlined">
                                            <RadzenTextBox @bind-Value="@ApprovedBy" 
                                                         Placeholder="Enter approver name"
                                                         Style="width: 100%;" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Approved Date" Variant="Variant.Outlined">
                                            <RadzenDatePicker @bind-Value="@ApprovedDate" 
                                                            DateFormat="MM/dd/yyyy HH:mm"
                                                            ShowTime="true"
                                                            Style="width: 100%;" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>
                                
                                <RadzenFormField Text="Approval Notes" Variant="Variant.Outlined">
                                    <RadzenTextArea @bind-Value="@ApprovalNotes" 
                                                  Placeholder="Enter approval notes or conditions"
                                                  Rows="3" 
                                                  Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenStack>
                        </RadzenCard>

                        <!-- Approval History (placeholder for future implementation) -->
                        <RadzenCard Variant="Variant.Outlined">
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                <RadzenText TextStyle="TextStyle.Subtitle1">
                                    <i class="fas fa-history"></i> Approval History
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                                    No approval history available yet.
                                </RadzenText>
                                <!-- Future: Add approval history timeline here -->
                            </RadzenStack>
                        </RadzenCard>
                    }
                    else
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" AlignItems="AlignItems.Center">
                                <RadzenIcon Icon="block" Style="font-size: 3rem; color: var(--rz-warning);" />
                                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; text-align: center;">
                                    Approval Workflow Disabled
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" Style="text-align: center;">
                                    This audit plan does not require approval. Check "Requires Approval" in the Basic Information tab to enable the approval workflow.
                                </RadzenText>
                            </RadzenStack>
                        </RadzenAlert>
                    }
                </RadzenStack>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>

    <!-- Action Buttons -->
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End" 
                class="border-top pt-3">
        <RadzenButton Text="Cancel" 
                    ButtonStyle="ButtonStyle.Light" 
                    Click="@Cancel"
                    Disabled="@IsSubmitting" />
        <RadzenButton Text="@(IsNew ? "Create Plan" : "Update Plan")" 
                    Icon="@(IsNew ? "add" : "save")"
                    ButtonStyle="ButtonStyle.Primary" 
                    Click="@SaveAuditPlan"
                    IsBusy="@IsSubmitting" />
    </RadzenStack>
</RadzenStack>

@code {
    // Component logic is in the code-behind file
}