@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using Radzen
@using Radzen.Blazor

<RadzenStack Gap="1rem">
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="Code" Variant="Variant.Outlined">
                <RadzenTextBox @bind-Value="@SPI.Code" 
                              ReadOnly="@(IsEditMode)" 
                              Placeholder="Auto-generated" 
                              Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="Status" Variant="Variant.Outlined">
                <RadzenDropDown @bind-Value="@SelectedStatus" 
                               Data="@AvailableStatuses" 
                               TextProperty="Name" 
                               ValueProperty="Value"
                               Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <RadzenFormField Text="Name *" Variant="Variant.Outlined">
        <RadzenTextBox @bind-Value="@SPI.Name" 
                      Placeholder="Enter SPI name" 
                      Style="width: 100%;" />
    </RadzenFormField>

    <RadzenFormField Text="Description" Variant="Variant.Outlined">
        <RadzenTextArea @bind-Value="@SPI.Description" 
                       Rows="3" 
                       Placeholder="Describe this safety performance indicator..." 
                       Style="width: 100%;" />
    </RadzenFormField>

    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="Indicator Type *" Variant="Variant.Outlined">
                <RadzenDropDown @bind-Value="@SelectedIndicatorType" 
                               Data="@GetTypeDisplayItems()" 
                               TextProperty="DisplayText" 
                               ValueProperty="Value"
                               Placeholder="Select indicator type..."
                               Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="Measurement Frequency" Variant="Variant.Outlined">
                <RadzenDropDown @bind-Value="@SelectedFrequency" 
                               Data="@AvailableFrequencies" 
                               TextProperty="Name" 
                               ValueProperty="Value"
                               Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="Measurement Unit" Variant="Variant.Outlined">
                <RadzenTextBox @bind-Value="@SPI.MeasurementUnit" 
                              Placeholder="e.g., %, Count, Rate" 
                              Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="Data Source" Variant="Variant.Outlined">
                <RadzenTextBox @bind-Value="@SPI.DataSource" 
                              Placeholder="e.g., SMS Reports, Training Records" 
                              Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <RadzenFieldset Text="Targets & Thresholds">
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Target Value" Variant="Variant.Outlined">
                    <RadzenNumeric @bind-Value="@SPI.TargetValue" 
                                  Format="0.####" 
                                  Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Acceptable Range" Variant="Variant.Outlined">
                    <RadzenNumeric @bind-Value="@SPI.AcceptableRange" 
                                  Format="0.####" 
                                  Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Warning Threshold" Variant="Variant.Outlined">
                    <RadzenNumeric @bind-Value="@SPI.WarningThreshold" 
                                  Format="0.####" 
                                  Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="Critical Threshold" Variant="Variant.Outlined">
                    <RadzenNumeric @bind-Value="@SPI.CriticalThreshold" 
                                  Format="0.####" 
                                  Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
    </RadzenFieldset>

    <RadzenFieldset Text="Ownership & Review">
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Responsible Department" Variant="Variant.Outlined">
                    <RadzenDropDown @bind-Value="@SPI.ResponsibleDepartment" 
                                   Data="@AvailableDepartments" 
                                   Placeholder="Select department..."
                                   Style="width: 100%;" 
                                   AllowClear="true" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Data Owner" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@SPI.DataOwner" 
                                  Placeholder="Person responsible for data collection" 
                                  Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Review Authority" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@SPI.ReviewAuthority" 
                                  Placeholder="Person responsible for review" 
                                  Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Next Review Date" Variant="Variant.Outlined">
                    <RadzenDatePicker @bind-Value="@SPI.NextReviewDate" 
                                     DateFormat="yyyy-MM-dd" 
                                     Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
    </RadzenFieldset>

    <RadzenFormField Text="Calculation Method" Variant="Variant.Outlined">
        <RadzenTextArea @bind-Value="@SPI.CalculationMethod" 
                       Rows="2" 
                       Placeholder="Describe how this indicator is calculated..." 
                       Style="width: 100%;" />
    </RadzenFormField>

    <RadzenFieldset Text="Alert Configuration">
        <RadzenStack Gap="1rem">
            <RadzenCheckBox @bind-Value="@SPI.AlertsEnabled" Name="alertsEnabled" />
            <RadzenLabel Text="Enable Alerts" Component="alertsEnabled" Style="cursor: pointer;" />
            
            @if (SPI.AlertsEnabled)
            {
                <RadzenFormField Text="Alert Recipients" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@SPI.AlertRecipients" 
                                  Placeholder="Comma-separated email addresses" 
                                  Style="width: 100%;" />
                </RadzenFormField>
            }
        </RadzenStack>
    </RadzenFieldset>
</RadzenStack>

<div class="d-flex justify-content-end gap-2 mt-3">
    <RadzenButton Text="Cancel" 
                  ButtonStyle="ButtonStyle.Light" 
                  Click="@(() => DialogService.Close(false))" />
    <RadzenButton Text="@(IsEditMode ? "Update SPI" : "Create SPI")" 
                  Icon="@(IsEditMode ? "save" : "add")" 
                  ButtonStyle="ButtonStyle.Primary" 
                  Click="@SaveSPI" 
                  Disabled="@(!IsValid || IsSaving)" />
</div>

@code {
    [Inject] private DialogService DialogService { get; set; } = default!;

    [Parameter] public SafetyPerformanceIndicator SPI { get; set; } = default!;
    [Parameter] public bool IsEditMode { get; set; } = false;
    [Parameter] public List<SPIType> AvailableTypes { get; set; } = new();
    [Parameter] public List<SPIStatus> AvailableStatuses { get; set; } = new();
    [Parameter] public List<SPIMeasurementFrequency> AvailableFrequencies { get; set; } = new();
    [Parameter] public List<string> AvailableDepartments { get; set; } = new();

    private string SelectedStatus { get; set; } = string.Empty;
    private string SelectedIndicatorType { get; set; } = string.Empty;
    private string SelectedFrequency { get; set; } = string.Empty;
    private bool IsSaving { get; set; } = false;

    // Computed properties for dropdown display
    private List<SPITypeDisplayItem> GetTypeDisplayItems() => AvailableTypes
        .Select(t => new SPITypeDisplayItem 
        { 
            Value = t.Value, 
            DisplayText = $"{t.Name} - {t.Description}" 
        }).ToList();

    private bool IsValid => 
        !string.IsNullOrWhiteSpace(SPI?.Name) &&
        !string.IsNullOrWhiteSpace(SelectedIndicatorType);

    protected override void OnInitialized()
    {
        if (SPI != null)
        {
            SelectedStatus = SPI.Status?.Value ?? SPIStatus.Active.Value;
            SelectedIndicatorType = SPI.IndicatorType?.Value ?? string.Empty;
            SelectedFrequency = SPI.MeasurementFrequency?.Value ?? SPIMeasurementFrequency.Monthly.Value;
        }
    }

    private async Task SaveSPI()
    {
        if (!IsValid) return;

        try
        {
            IsSaving = true;
            
            // Update SPI with selected values
            var selectedStatusEnum = AvailableStatuses.FirstOrDefault(s => s.Value == SelectedStatus) ?? SPIStatus.Active;
            var selectedTypeEnum = AvailableTypes.FirstOrDefault(t => t.Value == SelectedIndicatorType);
            var selectedFrequencyEnum = AvailableFrequencies.FirstOrDefault(f => f.Value == SelectedFrequency) ?? SPIMeasurementFrequency.Monthly;

            if (selectedTypeEnum != null)
            {
                SPI.UpdateStatus(selectedStatusEnum, "SYSTEM");
                SPI.MeasurementFrequency = selectedFrequencyEnum;
                
                DialogService.Close(SPI);
            }
        }
        finally
        {
            IsSaving = false;
        }
    }

    public class SPITypeDisplayItem
    {
        public string Value { get; set; } = string.Empty;
        public string DisplayText { get; set; } = string.Empty;
    }
}