@using Radzen
@using Radzen.Blazor
@using SMS_Domain.Entities

<RadzenStack Orientation="Orientation.Vertical" Gap="1.5rem">
    <!-- Form Header -->
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
        <RadzenText TextStyle="TextStyle.H5" Style="margin: 0;">
            @(IsNew ? "Schedule New Audit" : "Edit Audit")
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color); margin: 0;">
            Schedule and manage audit execution details
        </RadzenText>
    </RadzenStack>

    <!-- Validation Message -->
    @if (!_isValid)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat">
            @_validationMessage
        </RadzenAlert>
    }

    <!-- Form Content -->
    <RadzenTabs RenderMode="TabRenderMode.Client">
        <Tabs>
            <!-- Basic Information Tab -->
            <RadzenTabsItem Text="Basic Information" Icon="info">
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="padding: 1rem 0;">
                    <!-- _code and _name Row -->
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Audit _code" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="@_code" 
                                             Placeholder="e.g., AUD-INT-2024-001"
                                             Style="width: 100%;" />
                            </RadzenFormField>
                            <RadzenButton Text="Generate" 
                                        ButtonStyle="ButtonStyle.Light" 
                                        Size="ButtonSize.ExtraSmall"
                                        Click="@GenerateCode" 
                                        Style="margin-top: 0.25rem;" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenFormField Text="Audit _name" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="@_name" 
                                             Placeholder="Enter audit name"
                                             Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Audit Plan _code (if applicable) -->
                    @if (!string.IsNullOrWhiteSpace(_auditPlanCode))
                    {
                        <RadzenFormField Text="Related Audit Plan" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="@_auditPlanCode" 
                                         Disabled="true"
                                         Style="width: 100%;" />
                        </RadzenFormField>
                    }

                    <!-- _description -->
                    <RadzenFormField Text="_description" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@_description" 
                                      Placeholder="Describe the audit purpose and scope"
                                      Rows="3" 
                                      Style="width: 100%;" />
                    </RadzenFormField>

                    <!-- Type and Department Row -->
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Audit Type" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@_auditType" 
                                              Data="@AuditTypeOptions" 
                                              Placeholder="Select audit type"
                                              Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Responsible Department" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@_responsibleDepartment" 
                                              Data="@DepartmentOptions" 
                                              Placeholder="Select department"
                                              Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- _priority and _status Row -->
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="_priority" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@_priority" 
                                              Data="@PriorityOptions" 
                                              Placeholder="Select priority"
                                              Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="_status" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@_status" 
                                              Data="@StatusOptions" 
                                              Change="@OnStatusChanged"
                                              Placeholder="Select status"
                                              Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenTabsItem>

            <!-- _scope & _objectives Tab -->
            <RadzenTabsItem Text="_scope & _objectives" Icon="target">
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="padding: 1rem 0;">
                    <!-- _scope -->
                    <RadzenFormField Text="Audit _scope" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@_scope" 
                                      Placeholder="Define what areas, processes, or departments will be audited"
                                      Rows="4" 
                                      Style="width: 100%;" />
                    </RadzenFormField>

                    <!-- _objectives -->
                    <RadzenFormField Text="Audit _objectives" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@_objectives" 
                                      Placeholder="List the specific objectives and goals of this audit"
                                      Rows="4" 
                                      Style="width: 100%;" />
                    </RadzenFormField>

                    <!-- Executive Summary (if audit is completed) -->
                    @if (_status == "Completed" || _status == "In Progress")
                    {
                        <RadzenFormField Text="Executive Summary" Variant="Variant.Outlined">
                            <RadzenTextArea @bind-Value="@_executiveSummary" 
                                          Placeholder="High-level summary of audit results and key findings"
                                          Rows="4" 
                                          Style="width: 100%;" />
                        </RadzenFormField>
                    }
                </RadzenStack>
            </RadzenTabsItem>

            <!-- Team & Schedule Tab -->
            <RadzenTabsItem Text="Team & Schedule" Icon="schedule">
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="padding: 1rem 0;">
                    <!-- Lead Auditor and Contact Person Row -->
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Lead Auditor" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="@_leadAuditor" 
                                             Placeholder="Enter lead auditor name"
                                             Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Contact Person" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="@_contactPerson" 
                                             Placeholder="Department contact person"
                                             Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Auditor Team -->
                    <RadzenFormField Text="Auditor Team" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@_auditorTeam" 
                                      Placeholder="List team members and their roles"
                                      Rows="3" 
                                      Style="width: 100%;" />
                    </RadzenFormField>

                    <!-- Audit Location -->
                    <RadzenFormField Text="Audit Location" Variant="Variant.Outlined">
                        <RadzenTextBox @bind-Value="@_auditLocation" 
                                     Placeholder="Primary audit location or areas"
                                     Style="width: 100%;" />
                    </RadzenFormField>

                    <!-- Scheduled Dates Row -->
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0.5rem 0;">Scheduled Dates</RadzenText>
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Scheduled Start Date" Variant="Variant.Outlined">
                                <RadzenDatePicker @bind-Value="@_scheduledStartDate" 
                                                 DateFormat="MM/dd/yyyy"
                                                 Change="@OnScheduledStartDateChanged"
                                                 Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Scheduled End Date" Variant="Variant.Outlined">
                                <RadzenDatePicker @bind-Value="@_scheduledEndDate" 
                                                 DateFormat="MM/dd/yyyy"
                                                 Change="@OnScheduledEndDateChanged"
                                                 Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Actual Dates Row (only show if status is In Progress or Completed) -->
                @if (_showActualDates)
                    {
                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0.5rem 0;">Actual Dates</RadzenText>
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Actual Start Date" Variant="Variant.Outlined">
                                    <RadzenDatePicker @bind-Value="@_actualStartDate" 
                                                    DateFormat="MM/dd/yyyy"
                                                    Change="@OnActualStartDateChanged"
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Actual End Date" Variant="Variant.Outlined">
                                    <RadzenDatePicker @bind-Value="@_actualEndDate" 
                                                    DateFormat="MM/dd/yyyy"
                                                    Change="@OnActualEndDateChanged"
                                                    Disabled="@(_status != "Completed")"
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    }
                </RadzenStack>
            </RadzenTabsItem>

            <!-- _notes Tab -->
            <RadzenTabsItem Text="_notes" Icon="notes">
                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="padding: 1rem 0;">
                    <RadzenFormField Text="Audit _notes" Variant="Variant.Outlined">
                        <RadzenTextArea @bind-Value="@_notes" 
                                      Placeholder="Additional notes, observations, or special requirements"
                                      Rows="8" 
                                      Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>

    <!-- Action Buttons -->
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End" 
                class="border-top pt-3">
        <RadzenButton Text="Cancel" 
                    ButtonStyle="ButtonStyle.Light" 
                    Click="@Cancel"
                    Disabled="@_isSubmitting" />
        <RadzenButton Text="@(IsNew ? "Schedule Audit" : "Update Audit")" 
                    Icon="@(IsNew ? "schedule" : "save")"
                    ButtonStyle="ButtonStyle.Primary" 
                    Click="@SaveAudit"
                    IsBusy="@_isSubmitting" />
    </RadzenStack>
</RadzenStack>

@code {
    // Component logic is in the code-behind file
}

