@using Radzen
@using Radzen.Blazor

<!-- Event Console for debugging like Radzen example -->
@if (showEventConsole)
{
    <RadzenCard Style="margin-top: 1rem;">
        <RadzenText TextStyle="TextStyle.H6">Event Console</RadzenText>
        <RadzenTextArea @bind-Value="@eventLog" Rows="5" ReadOnly="true" Style="width: 100%; font-family: monospace; font-size: 0.85rem;" />
        <div style="margin-top: 10px;">
            <RadzenButton Text="Clear Log" Click="@ClearEventLog" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" />
            <RadzenSwitch @bind-Value="@showEventConsole" Style="margin-left: 10px;" />
            <RadzenLabel Text="Show Event Console" Style="margin-left: 5px;" />
        </div>
    </RadzenCard>
}
else
{
    <div style="margin-top: 1rem; text-align: right;">
        <RadzenSwitch @bind-Value="@showEventConsole" />
        <RadzenLabel Text="Show Event Console" Style="margin-left: 5px;" />
    </div>
}

