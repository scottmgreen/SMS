@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using SMS_Application.Common
@using Radzen
@using Radzen.Blazor

<!-- Modal Header with SMS styling - SAME AS SPIEditDialog -->
<div class="sms-modal-header sms-header-primary">
    <RadzenText TextStyle="TextStyle.H5" class="sms-modal-title" Style="color:white">
        <RadzenIcon Icon="@(IsEditMode ? "edit" : "add")" Style="margin-right: 0.5rem;" />
        @(IsEditMode ? $"Edit Data Point - {SPI?.Name}" : $"Add Data Point - {SPI?.Name}")
    </RadzenText>
</div>

<!-- Modal Body -->
<div class="sms-modal-body">
    <RadzenStack Gap="1rem">
        <!-- SPI Information Display -->
        <RadzenCard Variant="Variant.Outlined" Style="background: #f8f9fa; border-color: #212e61;">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <RadzenStack Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0; font-weight: 600;">@SPI?.Name</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; color: #6c757d;">Code: @SPI?.Code | Unit: @SPI?.MeasurementUnit</RadzenText>
                </RadzenStack>
                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@SPI?.IndicatorType?.Name" />
            </RadzenStack>
        </RadzenCard>

        <!-- Primary Information -->
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="8">
                <RadzenFormField Text="Measurement Value *" Variant="Variant.Outlined">
                    <RadzenNumeric @bind-Value="@currentDataPoint.Value" 
                                   TValue="decimal"
                                   Min="0"
                                   Step="0.01"
                                   Style="width: 100%;"
                                   Placeholder="Enter measurement value..." />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="Unit" Variant="Variant.Outlined">
                    <RadzenTextBox Value="@SPI?.MeasurementUnit" 
                                   ReadOnly="true" 
                                   Style="width: 100%; background-color: #f8f9fa; color: #6c757d;" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Measurement Date *" Variant="Variant.Outlined">
                    <RadzenDatePicker @bind-Value="@currentDataPoint.MeasurementDate" 
                                      TValue="DateTime"
                                      Max="@DateTime.Today"
                                      Style="width: 100%;"
                                      DateFormat="MMM dd, yyyy"
                                      Change="@OnDateChanged" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Reporting Period" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@currentDataPoint.Period" 
                                   Style="width: 100%; background-color: #f8f9fa; color: #6c757d;" 
                                   ReadOnly="true"
                                   Placeholder="Auto-calculated..." />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenFormField Text="Data Source *" Variant="Variant.Outlined">
            <RadzenDropDown @bind-Value="@currentDataPoint.DataSource"
                            Data="@GetDataSourceOptions()"
                            Style="width: 100%;"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Placeholder="Select or type data source..."
                            AllowClear="false" />
        </RadzenFormField>

        <RadzenFormField Text="Notes" Variant="Variant.Outlined">
            <RadzenTextArea @bind-Value="@currentDataPoint.Notes" 
                            Rows="2" 
                            Style="width: 100%;" 
                            Placeholder="Optional notes about this measurement..."
                            MaxLength="500" />
        </RadzenFormField>

        <!-- Verification Section (Edit Mode Only) -->
        @if (IsEditMode)
        {
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        <RadzenCheckBox @bind-Value="@currentDataPoint.IsVerified" TValue="bool" Name="IsVerified" />
                        <RadzenLabel Text="Mark as Verified" Component="IsVerified" Style="cursor: pointer;" />
                    </RadzenStack>
                </RadzenColumn>
                @if (currentDataPoint.IsVerified)
                {
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="Verified By *" Variant="Variant.Outlined">
                            <RadzenTextBox @bind-Value="@currentDataPoint.VerifiedBy" 
                                           Style="width: 100%;" 
                                           Placeholder="Name of verifying person..." />
                        </RadzenFormField>
                    </RadzenColumn>
                }
            </RadzenRow>
        }
    </RadzenStack>
</div>

<!-- Modal Footer - SAME AS SPIEditDialog -->
<div class="sms-modal-footer">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <RadzenButton Text="Cancel" 
                      ButtonStyle="ButtonStyle.Light" 
                      Click="@HandleCancel" />
        <RadzenButton Text="@(IsEditMode ? "Update Data Point" : "Add Data Point")" 
                      Icon="@(IsEditMode ? "save" : "add")" 
                      ButtonStyle="ButtonStyle.Primary" 
                      Click="@SubmitForm" 
                      Disabled="@(!IsValid || IsSaving)" 
                      Style="background-color: #212e61; border-color: #212e61;" />
    </RadzenStack>
</div>

<style>
/* SMS Modal Styling - Consistent with system */
.sms-modal-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e9ecef;
    border-radius: 0.5rem 0.5rem 0 0;
}

.sms-header-primary {
    background-color: #212e61; /* SMS Blue Dark Bold */
    color: white;
}

.sms-modal-title {
    margin: 0;
    font-weight: 600;
    display: flex;
    align-items: center;
}

.sms-modal-body {
    padding: 1.5rem;
    max-height: 70vh;
    overflow-y: auto;
}

.sms-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid #e9ecef;
    border-radius: 0 0 0.5rem 0.5rem;
    background-color: #f8f9fa;
}
</style>