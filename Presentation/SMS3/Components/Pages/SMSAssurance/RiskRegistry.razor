@page "/SMSAssurance/RiskRegistry"
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using SMS_Application.Interfaces
@using SMS_Application.Messaging.Queries

<PageTitle>Risk Registry - SMS Assurance</PageTitle>
<PageHeader Title="SMS Risk Registry"
            Subtitle="Comprehensive overview of all identified risks, their assessments, and mitigation status"
            Icon="assignment" />

<RadzenRow class="rz-mx-auto">
    <RadzenColumn Size="12">
        <RadzenStack>
                     
            <!-- Filter and Search Controls -->
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.NoWrap" JustifyContent="JustifyContent.SpaceBetween" Style="width: 100%;">
                    <!-- Left side filters -->
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.NoWrap">
                        <!-- Status Filter -->
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenLabel Text="Status Filter:" Style="margin: 0; white-space: nowrap;" />
                            <RadzenDropDown @bind-Value="@SelectedStatusFilter"
                                            Data="@StatusFilterOptions"
                                            TextProperty="Text"
                                            ValueProperty="Value"
                                            AllowClear="true"
                                            Placeholder="All Statuses"
                                            Change="@OnFilterChanged"
                                            Style="width: 300px;" />
                        </RadzenStack>

                        <!-- Risk Level Filter -->
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenLabel Text="Risk Level:" Style="margin: 0; white-space: nowrap;" />
                            <RadzenDropDown @bind-Value="@SelectedRiskLevelFilter"
                                            Data="@RiskLevelFilterOptions"
                                            TextProperty="Text"
                                            ValueProperty="Value"
                                            AllowClear="true"
                                            Placeholder="All Risk Levels"
                                            Change="@OnFilterChanged"
                                            Style="width: 225px;" />
                        </RadzenStack>

                        <!-- Search Filter -->
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenLabel Text="Search:" Style="margin: 0; white-space: nowrap;" />
                            <RadzenTextBox @bind-Value="@SearchText"
                                           Placeholder="Search hazards, reports..."
                                           @oninput="@OnSearchChanged"
                                           Style="width: 300px;" />
                        </RadzenStack>
                    </RadzenStack>

                    <!-- Right side refresh button -->
                    <RadzenButton Text="Refresh"
                                  Icon="refresh"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Size="ButtonSize.Medium"
                                  Click="@LoadRiskRegistryData"
                                  IsBusy="@IsLoading" />
                </RadzenStack>
            </RadzenCard>

            <!-- Loading Indicator -->
            @if (IsLoading)
            {
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                        <RadzenText Text="Loading Risk Registry data..." />
                    </RadzenStack>
                </RadzenCard>
            }
            <RadzenDataGrid @ref="RiskRegistryGrid"
                            Data="@FilteredRiskRegistryEntries"
                            Count="@FilteredRiskRegistryEntries.Count"
                            LoadData="@LoadRiskRegistryData"
                            AllowPaging="true" 
                            AllowSorting="true" 
                            AllowFiltering="true"
                            PageSize="25"
                            PagerHorizontalAlign="HorizontalAlign.Left"
                            ShowPagingSummary="true"
                            FilterMode="FilterMode.Advanced"
                            SelectionMode="DataGridSelectionMode.Single"
                            Style="height: calc(100vh - 200px)" >
    
            <Columns>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="ReportCode" Title="Report ID" Width="100px">
                        <Template Context="registry">
                            <div style="@BasicTextStyle">
                                @registry.ReportCode
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="ReportStatus" Title="Report Status" Width="120px">
                        <Template Context="registry">
                            <div style="@BasicTextStyle">
                                @registry.ReportStatus
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="HazardCode" Title="Hazard ID" Width="100px" >
                        <Template Context="registry">
                            <div style="@BasicTextStyle">
                                @registry.HazardCode
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="InitialRiskMatrixCode" Title="Inital RS" Width="110px">
                        <Template Context="registry">
                            <div style="@GetAviationMatrixCellStyle(registry.InitialRiskMatrixCode.Trim())" class="text-center fw-bold">
                                @if (!string.IsNullOrEmpty(registry.InitialRiskMatrixCode) && registry.InitialRiskMatrixCode != "-")
                                {
                                    <div style="@BasicTextStyle">
                                        @($"{registry.InitialRiskMatrixCode} - {registry.InitialHazardRiskLevel?.Value}")
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">TBD</span>
                                }
                            </div>
                        </Template>
                    
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="InitialRiskMatrixCode" Title="Residual RS" Width="110px">
                        <Template Context="registry">
                            <div style="@GetAviationMatrixCellStyle(registry.ResidualRiskMatrixCode.Trim())" class="text-center fw-bold">
                                @if (!string.IsNullOrEmpty(registry.ResidualRiskMatrixCode) && registry.ResidualRiskMatrixCode != "-")
                                {
                                    <div style="@BasicTextStyle">
                                        @($"{registry.ResidualRiskMatrixCode} - {registry.ResidualHazardRiskLevel?.Value}")
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">TBD</span>
                                }
                            </div>
                        </Template>

                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="HazardDescription" Title="Hazard Description" Width="120px">
                        <Template Context="registry">
                            <div style="@BasicTextStyle">
                                @registry.HazardDescription
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="MitigationStatus" Title="Mitigation Status" Width="150px">
                        <Template Context="registry">
                            @if (registry.MitigationStatus !=null)
                            {
                                <div style="@BasicTextStyle">
                                    @registry.MitigationStatus.Value
                                </div>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="TargetDate" Title="Target Date" Width="150px">
                        <Template Context="registry">
                            @if (registry.TargetDate.HasValue)
                            {
                                <div style="@BasicTextStyle">
                                        @registry.TargetDate.Value.ToString("MMM dd, yyyy")
                                </div>
                            }
                            
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="AssignedTo" Title="Owner" Width="120px">
                        <Template Context="registry">
                            <div style="@BasicTextStyle">
                                @registry.AssignedTo
                            </div>
                        </Template>
                        
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="LastUpdated" Title="Owner" Width="110px">
                        <Template Context="registry">
                            @if (registry.LastUpdated.HasValue)
                            {
                                <div style="@BasicTextStyle"> 
                                        @registry.LastUpdated.Value.ToString("MMM dd, yyyy")
                                </div>
                            }
                        </Template>

                    </RadzenDataGridColumn>
            
            
            </Columns>
        </RadzenDataGrid>
           
        </RadzenStack>
    </RadzenColumn>
</RadzenRow>