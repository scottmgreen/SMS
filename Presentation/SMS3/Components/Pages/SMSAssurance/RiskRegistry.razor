@page "/SMSAssurance/RiskRegistry"
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using SMS_Application.Interfaces
@using SMS_Application.Queries

<PageTitle>Risk Registry - SMS Assurance</PageTitle>
<PageHeader Title="SMS Risk Registry"
            Subtitle="Comprehensive overview of all identified risks, their assessments, and mitigation status"
            Icon="assignment" />

<RadzenRow class="rz-mx-auto">
    <RadzenColumn Size="12">
        <RadzenStack>
                     
            <!-- Filter and Search Controls -->
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.NoWrap" JustifyContent="JustifyContent.SpaceBetween" Style="width: 100%;">
                    <!-- Left side filters -->
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.NoWrap">
                        <!-- Status Filter -->
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenLabel Text="Status Filter:" Style="margin: 0; white-space: nowrap;" />
                            <RadzenDropDown @bind-Value="@SelectedStatusFilter"
                                            Data="@StatusFilterOptions"
                                            TextProperty="Text"
                                            ValueProperty="Value"
                                            AllowClear="true"
                                            Placeholder="All Statuses"
                                            Change="@OnFilterChanged"
                                            Style="width: 300px;" />
                        </RadzenStack>

                        <!-- Risk Level Filter -->
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenLabel Text="Risk Level:" Style="margin: 0; white-space: nowrap;" />
                            <RadzenDropDown @bind-Value="@SelectedRiskLevelFilter"
                                            Data="@RiskLevelFilterOptions"
                                            TextProperty="Text"
                                            ValueProperty="Value"
                                            AllowClear="true"
                                            Placeholder="All Risk Levels"
                                            Change="@OnFilterChanged"
                                            Style="width: 225px;" />
                        </RadzenStack>

                        <!-- Search Filter -->
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenLabel Text="Search:" Style="margin: 0; white-space: nowrap;" />
                            <RadzenTextBox @bind-Value="@SearchText"
                                           Placeholder="Search hazards, reports..."
                                           @oninput="@OnSearchChanged"
                                           Style="width: 300px;" />
                        </RadzenStack>
                    </RadzenStack>

                    <!-- Right side refresh button -->
                    <RadzenButton Text="Refresh"
                                  Icon="refresh"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Size="ButtonSize.Medium"
                                  Click="@LoadRiskRegistryData"
                                  IsBusy="@IsLoading" />
                </RadzenStack>
            </RadzenCard>

            <!-- Loading Indicator -->
            @if (IsLoading)
            {
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                        <RadzenText Text="Loading Risk Registry data..." />
                    </RadzenStack>
                </RadzenCard>
            }
            <RadzenDataGrid @ref="RiskRegistryGrid"
                            Data="@FilteredRiskRegistryEntries"
                            Count="@FilteredRiskRegistryEntries.Count"
                            LoadData="@LoadRiskRegistryData"
                            AllowPaging="true" 
                            AllowSorting="true" 
                            AllowFiltering="true"
                            PageSize="25"
                            PagerHorizontalAlign="HorizontalAlign.Left"
                            ShowPagingSummary="true"
                            FilterMode="FilterMode.Advanced"
                            SelectionMode="DataGridSelectionMode.Single"
                            Style="height: calc(100vh - 200px)" >
    
            <Columns>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="ReportCode" Title="Report ID" Width="100px">
                        <Template Context="registry">
                            <div style="@BasicTextStyle">
                                @registry.ReportCode
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="ReportStatus" Title="Report Status" Width="290px">
                        <Template Context="registry">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem" Style="@BasicTextStyle">
                                <span>@registry.ReportStatus</span>
                                @if (IsAssessmentInProgressStatus(registry.ReportStatus))
                                {
                                    <RadzenIcon Icon="warning_amber"
                                                Style="color:#f59e0b;font-size:0.95rem;"
                                                title="Risk assessment in progress: scoring may exist, but assessment is not validated/complete." />
                                }
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="HazardCode" Title="Hazard ID" Width="100px" >
                        <Template Context="registry">
                            <div style="@BasicTextStyle">
                                @if (!string.IsNullOrWhiteSpace(registry.HazardCode))
                                {
                                    <a href="@GetHazardReportingUrl(registry)">@registry.HazardCode</a>
                                }
                                else
                                {
                                    @registry.HazardCode
                                }
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="EffectiveRiskMatrixCode" Title="Risk Score" Width="110px">
                        <Template Context="registry">
                            <div style="@GetAviationMatrixCellStyle(registry.EffectiveRiskMatrixCode?.Trim() ?? string.Empty)" class="text-center fw-bold">
                                @if (!string.IsNullOrEmpty(registry.EffectiveRiskMatrixCode) && registry.EffectiveRiskMatrixCode != "-" && registry.EffectiveRiskMatrixCode != "TBD")
                                {
                                    <div style="@BasicTextStyle">                   
                                        @if (CanNavigateToTechnicalAssessmentStep4(registry))
                                        {
                                            <a href="@GetTechnicalAssessmentStep4Url(registry)">@($"{registry.EffectiveRiskMatrixCode} - {registry.EffectiveHazardRiskLevel.Value}")</a>
                                        }
                                        else
                                        {
                                            @($"{registry.EffectiveRiskMatrixCode} - {registry.EffectiveHazardRiskLevel.Value}")
                                        }
                                    
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">TBD</span>
                                }
                            </div>
                        </Template>
                    
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="InitialRiskMatrixCode" Title="Initial RS" Width="110px">
                        <Template Context="registry">
                            <div style="@GetAviationMatrixCellStyle(registry.InitialRiskMatrixCode?.Trim() ?? string.Empty)" class="text-center fw-bold">
                                @if (!string.IsNullOrEmpty(registry.InitialRiskMatrixCode) && registry.InitialRiskMatrixCode != "-" && registry.InitialRiskMatrixCode != "TBD")
                                {
                                    <div style="@BasicTextStyle">
                                        @if (CanNavigateToTechnicalAssessmentStep4(registry))
                                        {
                                            <a href="@GetTechnicalAssessmentStep4Url(registry)">@($"{registry.InitialRiskMatrixCode} - {registry.InitialHazardRiskLevel?.Value}")</a>
                                        }
                                        else
                                        {
                                            @($"{registry.InitialRiskMatrixCode} - {registry.InitialHazardRiskLevel?.Value}")
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">TBD</span>
                                }
                            </div>
                        </Template>

                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="ResidualRiskMatrixCode" Title="Residual RS" Width="110px">
                        <Template Context="registry">
                            <div style="@GetAviationMatrixCellStyle(registry.ResidualRiskMatrixCode?.Trim() ?? string.Empty)" class="text-center fw-bold">
                                @if (!string.IsNullOrEmpty(registry.ResidualRiskMatrixCode) && registry.ResidualRiskMatrixCode != "-" && registry.ResidualRiskMatrixCode != "TBD")
                                {
                                    <div style="@BasicTextStyle">
                                        @if (CanNavigateToTechnicalAssessmentStep4(registry))
                                        {
                                            <a href="@GetTechnicalAssessmentStep4Url(registry)">@($"{registry.ResidualRiskMatrixCode} - {registry.ResidualHazardRiskLevel?.Value}")</a>
                                        }
                                        else
                                        {
                                            @($"{registry.ResidualRiskMatrixCode} - {registry.ResidualHazardRiskLevel?.Value}")
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">TBD</span>
                                }
                            </div>
                        </Template>

                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="HazardDescription" Title="Hazard Description" Width="120px">
                        <Template Context="registry">
                            <RadzenButton Text="Description"
                                          Icon="description"
                                          ButtonStyle="ButtonStyle.Base"
                                          Variant="Variant.Text"
                                          Size="ButtonSize.ExtraSmall"
                                          Title="Click to view full description"
                                          Class="description-button"
                                          Click="@(() => ShowDescriptionDialog(registry))" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="MitigationStatus" Title="Mitigation Status" Width="150px">
                        <Template Context="registry">
                            @if (registry.MitigationStatus !=null)
                            {
                                <div style="@BasicTextStyle">
                                    @registry.MitigationStatus.Value
                                </div>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="TargetDate" Title="Target Date" Width="150px">
                        <Template Context="registry">
                            @if (registry.TargetDate.HasValue)
                            {
                                <div style="@BasicTextStyle">
                                        @registry.TargetDate.Value.ToString("MMM dd, yyyy")
                                </div>
                            }
                            
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="AssignedTo" Title="Owner" Width="120px">
                        <Template Context="registry">
                            <div style="@BasicTextStyle">
                                @registry.AssignedTo
                            </div>
                        </Template>
                        
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="RiskRegistryEntry" Property="LastUpdated" Title="Owner" Width="110px">
                        <Template Context="registry">
                            @if (registry.LastUpdated.HasValue)
                            {
                                <div style="@BasicTextStyle"> 
                                        @registry.LastUpdated.Value.ToString("MMM dd, yyyy")
                                </div>
                            }
                        </Template>

                    </RadzenDataGridColumn>
            
            
            </Columns>
        </RadzenDataGrid>

        </RadzenStack>
    </RadzenColumn>
</RadzenRow>
@if (ShowDescriptionModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-md">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-file-alt"></i> Hazard Description - @SelectedHazardId
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Text"
                                      Icon="close"
                                      Size="ButtonSize.Small"
                                      Click="@CloseDescriptionModal" />
                    </div>
                </div>
                <div class="sms-modal-body">
                    <RadzenCard Variant="Variant.Outlined">
                        <div class="p-3">
                            <div style="line-height: 1.6; white-space: normal;">
                                @((MarkupString)(SelectedDescription ?? "No description available"))
                            </div>
                        </div>
                    </RadzenCard>
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end">
                        <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                      Text="Close"
                                      Icon="close"
                                      Click="@CloseDescriptionModal"
                                      Size="ButtonSize.Medium" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .sms-modal-xxl {
        max-width: 1400px;
        width: 95%;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 1rem;
    }

    .sms-modal-dialog {
        position: relative;
        margin: 0 auto;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
    }

    .sms-modal-md {
        max-width: 700px;
        width: 100%;
    }

    .sms-modal-content {
        background: white;
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    }

    .sms-modal-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e9ecef;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .sms-header-primary {
        background-color: #212e61; 
        color: white;
    }

    .sms-modal-title {
        margin: 0;
        font-weight: 600;
    }

    .sms-modal-body {
        max-height: calc(100vh - 200px);
        overflow-y: auto;
    }

    .sms-modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid #e9ecef;
        border-radius: 0 0 0.5rem 0.5rem;
    }

</style>