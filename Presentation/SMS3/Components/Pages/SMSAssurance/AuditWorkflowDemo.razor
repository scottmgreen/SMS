@page "/SMSAssurance/AuditWorkflowDemo"
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS3.Configuration.Extensions

@using SMS_Domain.Entities

<PageTitle>Audit Workflow Demo - SMS3</PageTitle>

<!-- SMS Page Header -->
<PageHeader Title="Audit Management Workflow"
           Subtitle="Complete audit lifecycle from planning to completion with findings and evidence management"
           Icon="fas fa-project-diagram" />

<RadzenCard Variant="Variant.Outlined" Style="margin-bottom: 2rem;">
    <RadzenStack Orientation="Orientation.Vertical" Gap="1.5rem">
        <!-- Workflow Overview -->
        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
            <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: var(--rz-primary);">
                ?? Complete Audit Workflow Implementation
            </RadzenText>
            
            <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0;">
                The SMS Audit Management system now provides a complete workflow for conducting audits from initial planning through final completion with comprehensive finding and evidence tracking.
            </RadzenText>
        </RadzenStack>

        <!-- Workflow Steps -->
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard Variant="Variant.Outlined" Style="height: 200px; border-left: 4px solid var(--rz-info);">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem" Style="height: 100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="assignment" Style="color: var(--rz-info); font-size: 1.5rem;" />
                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: var(--rz-info);">
                                1. Plan Audit
                            </RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                            Create audit plans with approval workflow, schedule audits, and set objectives and scope.
                        </RadzenText>
                        <RadzenBadge Text="? Implemented" BadgeStyle="BadgeStyle.Success" Style="margin-top: auto;" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard Variant="Variant.Outlined" Style="height: 200px; border-left: 4px solid var(--rz-success);">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem" Style="height: 100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="play_arrow" Style="color: var(--rz-success); font-size: 1.5rem;" />
                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: var(--rz-success);">
                                2. Start Audit
                            </RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                            Begin scheduled audits with one click. System tracks actual start time and updates status automatically.
                        </RadzenText>
                        <RadzenBadge Text="? Implemented" BadgeStyle="BadgeStyle.Success" Style="margin-top: auto;" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard Variant="Variant.Outlined" Style="height: 200px; border-left: 4px solid var(--rz-warning);">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem" Style="height: 100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="bug_report" Style="color: var(--rz-warning); font-size: 1.5rem;" />
                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: var(--rz-warning);">
                                3. Record Findings
                            </RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                            Submit audit findings with severity levels, corrective actions, and responsible parties during audit execution.
                        </RadzenText>
                        <RadzenBadge Text="? Implemented" BadgeStyle="BadgeStyle.Success" Style="margin-top: auto;" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard Variant="Variant.Outlined" Style="height: 200px; border-left: 4px solid var(--rz-primary);">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem" Style="height: 100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="cloud_upload" Style="color: var(--rz-primary); font-size: 1.5rem;" />
                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: var(--rz-primary);">
                                4. Upload Evidence
                            </RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                            Attach supporting evidence including documents, photos, videos with retention policies and verification.
                        </RadzenText>
                        <RadzenBadge Text="? Implemented" BadgeStyle="BadgeStyle.Success" Style="margin-top: auto;" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined" Style="height: 200px; border-left: 4px solid var(--rz-success);">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem" Style="height: 100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); font-size: 1.5rem;" />
                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: var(--rz-success);">
                                5. Complete Audit
                            </RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                            Finalize audits with executive summaries, automatic finding counts, and completion timestamps.
                        </RadzenText>
                        <RadzenBadge Text="? Implemented" BadgeStyle="BadgeStyle.Success" Style="margin-top: auto;" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined" Style="height: 200px; border-left: 4px solid var(--rz-info);">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem" Style="height: 100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="timeline" Style="color: var(--rz-info); font-size: 1.5rem;" />
                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: var(--rz-info);">
                                6. Track Progress
                            </RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                            Monitor audit progress with real-time dashboards, finding summaries, and evidence tracking.
                        </RadzenText>
                        <RadzenBadge Text="? Implemented" BadgeStyle="BadgeStyle.Success" Style="margin-top: auto;" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Variant="Variant.Outlined" Style="height: 200px; border-left: 4px solid var(--rz-secondary);">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem" Style="height: 100%;">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="assessment" Style="color: var(--rz-secondary); font-size: 1.5rem;" />
                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: var(--rz-secondary);">
                                7. Generate Reports
                            </RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                            Create comprehensive audit reports with findings, evidence, and recommendations for compliance.
                        </RadzenText>
                        <RadzenBadge Text="?? Future Enhancement" BadgeStyle="BadgeStyle.Light" Style="margin-top: auto;" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <!-- Technical Implementation -->
        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: var(--rz-primary);">
                ?? Technical Implementation Details
            </RadzenText>

            <RadzenTabs>
                <Tabs>
                    <RadzenTabsItem Text="Backend Repository" Icon="storage">
                        <RadzenCard Variant="Variant.Text" Style="margin-top: 1rem;">
                            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                                <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0;">
                                    Enhanced Repository Layer
                                </RadzenText>

                                <RadzenUnorderedList>
                                    <li><strong>SMSAuditRepository</strong> - Complete CRUD with workflow methods (StartAuditAsync, CompleteAuditAsync)</li>
                                    <li><strong>SMSAuditFindingRepository</strong> - Finding management with audit linkage and overdue tracking</li>
                                    <li><strong>SMSAuditEvidenceRepository</strong> - Evidence upload, archival, and retention management</li>
                                    <li><strong>Complete field coverage</strong> - All database fields available in CREATE and UPDATE operations</li>
                                    <li><strong>Audit logging</strong> - Comprehensive audit trail with error handling and success tracking</li>
                                </RadzenUnorderedList>
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="UI Components" Icon="web">
                        <RadzenCard Variant="Variant.Text" Style="margin-top: 1rem;">
                            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                                <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0;">
                                    Blazor UI Components
                                </RadzenText>

                                <RadzenUnorderedList>
                                    <li><strong>AuditManagement.razor</strong> - Main dashboard with active audits, plans, and findings overview</li>
                                    <li><strong>AuditDetail.razor</strong> - Comprehensive audit detail view with tabs for findings and evidence</li>
                                    <li><strong>AuditFindingDialog.razor</strong> - Modal for creating/editing findings with severity and assignment</li>
                                    <li><strong>AuditEvidenceDialog.razor</strong> - File upload dialog with metadata and retention policies</li>
                                    <li><strong>AuditWorkflowActions.razor</strong> - Context-aware action buttons based on audit status</li>
                                </RadzenUnorderedList>
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Workflow Features" Icon="settings">
                        <RadzenCard Variant="Variant.Text" Style="margin-top: 1rem;">
                            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                                <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0;">
                                    Key Workflow Features
                                </RadzenText>

                                <RadzenUnorderedList>
                                    <li><strong>Status Management</strong> - Automatic status transitions (Scheduled ? In Progress ? Completed)</li>
                                    <li><strong>Progress Tracking</strong> - Real-time progress calculation and visual indicators</li>
                                    <li><strong>Finding Classification</strong> - Severity levels (Critical, Major, Minor, Observation)</li>
                                    <li><strong>Evidence Management</strong> - File uploads with type classification and verification</li>
                                    <li><strong>Retention Policies</strong> - Configurable evidence retention periods and archival</li>
                                    <li><strong>Dashboard Analytics</strong> - Summary statistics and overdue finding tracking</li>
                                </RadzenUnorderedList>
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenStack>

        <!-- Navigation -->
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="1rem" Style="margin-top: 2rem;">
            <RadzenButton Text="View Audit Management" 
                        Icon="assignment" 
                        ButtonStyle="ButtonStyle.Primary"
                        Click="@(() => Navigation.NavigateToSecure("/SMSAssurance/AuditManagement"))"
                        Size="ButtonSize.Medium" />
            <RadzenButton Text="View Audit Calendar" 
                        Icon="calendar_today" 
                        ButtonStyle="ButtonStyle.Success"
                        Click="@(() => Navigation.NavigateToSecure("/SMSAssurance/AuditCalendar"))"
                        Size="ButtonSize.Medium" />
        </RadzenStack>
    </RadzenStack>
</RadzenCard>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
}