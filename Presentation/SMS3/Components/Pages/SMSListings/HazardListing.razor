@page "/SMSListings/Hazards"
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS3.Components.Pages.SMSListings.Models
@using SMS_Application.Interfaces
@using SMS_Application.Queries
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Shared.Common

<PageTitle>Hazard Listing - SMS3</PageTitle>

<!-- SMS Page Header using reusable component -->
<PageHeader Title="Hazard Listing"
           Subtitle="Complete listing for all SMS Hazards"
           Icon="fas fa-list" />

<RadzenDataGrid @ref="_hazardsGrid" 
                Data="@_hazards" 
                Count="@_totalCount" 
                AllowPaging="true" 
                AllowSorting="true" 
                AllowFiltering="true"
                PageSize="15"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                FilterMode="FilterMode.Advanced"
                SelectionMode="DataGridSelectionMode.Multiple"
                Style="height: calc(100vh - 200px)"
                IsLoading="@_isLoading">
    
    <Columns>
        <RadzenDataGridColumn TItem="Hazard" Width="60px" Sortable="false" Filterable="false">
            <HeaderTemplate>
                <input type="checkbox" />
            </HeaderTemplate>
            <Template Context="hazard">
                <input type="checkbox" @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Hazard" Property="ReportCode" Title="Report ID" Width="150px">
            <Template Context="hazard">
                <div title="@hazard.ReportCode" style="@_basicTextStyle">
                    @(hazard.ReportCode)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Hazard" Property="Code" Title="Hazard ID" Width="120px" >
            <Template Context="hazard">
                <div title="@hazard.Code" style="@_basicTextStyle">
                    @(hazard.Code)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Hazard" Property="Name" Title="Title" Width="350px" >
            <Template Context="hazard">
                <div title="@hazard.HazardTitle" style="@_basicTextStyle">
                    @(hazard.HazardTitle)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Hazard" Title="Description" Width="100px" Sortable="false">
            <Template Context="hazard">
                <RadzenButton Text="Description"
                              Icon="description"
                              ButtonStyle="ButtonStyle.Base"
                              Variant="Variant.Text"
                              Size="ButtonSize.ExtraSmall"
                              Title="Click to view full description"
                              Class="description-button"
                              Click="@(() => ShowDescriptionDialog(hazard))" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Hazard" Property="HazardRiskLevel" Title="Risk Level" Width="350px">
            <Template Context="hazard">
                <div title="@hazard.HazardRiskLevel" style="@_basicTextStyle">
                    @(hazard.HazardRiskLevel.Value ?? RiskLevel.Unkonwn)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Hazard" Property="IsInitialHazard" Title="Initial Hazard" Width="125px">
            <Template Context="hazard">
                <RadzenIcon Icon="@(hazard.IsInitialHazard ? "check_box" : "check_box_outline_blank")"
                            Style="@(hazard.IsInitialHazard ? "color: var(--rz-success);" : "color: var(--rz-danger);")" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Hazard" Title="RR Only" Width="90px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
            <Template Context="hazard">
                @if (IsRiskRegistryOnlyHazard(hazard))
                {
                    <RadzenIcon Icon="check_circle" Style="color: #28a745;" title="Risk Registry Only" />
                }
            </Template>
        </RadzenDataGridColumn>
                

        <!-- Enhanced Actions Column -->
        <RadzenDataGridColumn TItem="Hazard" Title="Actions" Width="150px" Sortable="false" Filterable="false">
            <Template Context="hazard">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                    <RadzenButton ButtonStyle="ButtonStyle.Base"
                                  Size="ButtonSize.Small"
                                  Click="@(() => OnViewHazardAsync(hazard))"
                                  title="View Hazard"
                                  Icon="visibility" />
                    <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small"
                                  Click="@(() => OnEditHazardAsync(hazard))"
                                  title="Edit Hazard"
                                  Icon="edit" />
                    @if (!hazard.IsInitialHazard)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                      Size="ButtonSize.Small"
                                      Click="@(() => OnDeleteHazardAsync(hazard))"
                                      title="Delete Hazard"
                                      Icon="delete" />
                    }
                    
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@if (_showDescriptionModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-md">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-file-alt"></i> Hazard Description - @_selectedHazardId
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Text"
                                      Icon="close"
                                      Size="ButtonSize.Small"
                                      Click="@CloseDescriptionModal" />
                    </div>
                </div>
                <div class="sms-modal-body">
                    <RadzenCard Variant="Variant.Outlined">
                        <div class="p-3">
                            <div style="line-height: 1.6; white-space: normal;">
                                @((MarkupString)(_selectedDescription ?? "No description available"))
                            </div>
                        </div>
                    </RadzenCard>
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end">
                        <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                      Text="Close"
                                      Icon="close"
                                      Click="@CloseDescriptionModal"
                                      Size="ButtonSize.Medium" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .sms-modal-xxl {
        max-width: 1400px;
        width: 95%;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 1rem;
    }

    .sms-modal-dialog {
        position: relative;
        margin: 0 auto;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
    }

    .sms-modal-md {
        max-width: 700px;
        width: 100%;
    }

    .sms-modal-content {
        background: white;
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    }

    .sms-modal-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e9ecef;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .sms-header-primary {
        background-color: #212e61; /* SMS Blue Dark Bold */
        color: white;
    }

    .sms-modal-title {
        margin: 0;
        font-weight: 600;
    }

    .sms-modal-body {
        max-height: calc(100vh - 200px);
        overflow-y: auto;
    }

    .sms-modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid #e9ecef;
        border-radius: 0 0 0.5rem 0.5rem;
    }

    
</style>
