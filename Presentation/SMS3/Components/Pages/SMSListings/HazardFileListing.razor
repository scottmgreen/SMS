@page "/SMSListings/HazardFiles"

@using Radzen
@using Radzen.Blazor
@using SMS_Domain.Entities

<PageTitle>Hazard Files</PageTitle>
<PageHeader Title="Hazard Report Attached File Listing"
            Subtitle="Complete listing and management interface for all SMS Hazard Evidence Files"
            Icon="fas fa-list" />

<RadzenRow class="rz-mb-3" JustifyContent="JustifyContent.End">
    <RadzenColumn Size="12" class="d-flex justify-content-end">
        <RadzenButton Text="Add New"
                      Icon="add_circle"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="OpenAddModal" />
    </RadzenColumn>
</RadzenRow>

<RadzenDataGrid @ref="_filesGrid" 
                Data="@_files" 
                Count="@_totalCount" 
                LoadData="@LoadData"
                AllowPaging="true" 
                AllowSorting="true" 
                AllowFiltering="true"
                PageSize="15"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                FilterMode="FilterMode.Advanced"
                SelectionMode="DataGridSelectionMode.Multiple"
                IsLoading="@_isLoading">
    
    <Columns>
        <RadzenDataGridColumn TItem="HazardFile" Property="ReportCode" Title="Report ID" Width="150px">
            <Template Context="file">
                <div title="@file.ReportCode" style="font-size:smaller;font-weight: 600">
                    @(string.IsNullOrWhiteSpace(file.ReportCode) ? "N/A" : file.ReportCode)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardFile" Property="Code" Title="File ID" Width="150px">
            <Template Context="file">
                <div title="@file.Code" style="font-size:smaller;font-weight: 600">
                    @(file.Code)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardFile" Property="HazardCode" Title="Hazard ID" Width="150px">
            <Template Context="file">
                <div title="@file.HazardCode" style="font-size:smaller;font-weight: 600">
                    @(file.HazardCode)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardFile" Property="Description" Title="Description" Width="300px">
            <Template Context="file">
                <div title="@file.Description" style="font-size:smaller;font-weight: 600">
                    @(file.Description?.Length > 50 ? file.Description.Substring(0, 47) + "..." : file.Description)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardFile" Property="FileName" Title="File Name" Width="200px">
            <Template Context="file">
                @if (ShouldUseStoredExternalPath(file))
                {
                    <RadzenLink Text="@(file.FileName?.Length > 30 ? file.FileName.Substring(0, 27) + "..." : file.FileName)"
                                Path="@ResolveExternalFilePath(file.FilePath)"
                                Target="_blank"
                                title="@file.FileName"
                                Style="font-size:smaller;font-weight:600;" />
                }
                else
                {
                    <div title="@file.FileName" style="font-size:smaller;font-weight: 600">
                        @(file.FileName?.Length > 30 ? file.FileName.Substring(0, 27) + "..." : file.FileName)
                    </div>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardFile" Property="FileType" Title="Type" Width="120px">
            <Template Context="file">
                <div title="@file.FileType" style="font-size:smaller;font-weight: 600">
                    @(file.FileType)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardFile" Property="FileSizeBytes" Title="Size" Width="100px">
            <Template Context="file">
                @FormatFileSize(file.FileSizeBytes)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardFile" Property="UploadedBy" Title="Uploaded By" Width="150px">
            <Template Context="file">
                <div title="@file.UploadedBy" style="font-size:smaller;font-weight: 600">
                    @(file.UploadedBy)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardFile" Property="UploadedDate" Title="Uploaded Date" Width="150px" FormatString="{0:MM/dd/yyyy}">
            <Template Context="file">
                <div title="@file.UploadedDate" style="font-size:smaller;font-weight: 600">
                    @if (file.UploadedDate.HasValue)
                    {
                        @(file.UploadedDate.Value.ToString("MM/dd/yyyy"))
                    }
                    else
                    {
                        <span style="color: var(--rz-text-tertiary-color);">N/A</span>
                    }
                </div>
            </Template>
        </RadzenDataGridColumn>
                
        <RadzenDataGridColumn TItem="HazardFile" Title="Actions" Width="120px" Sortable="false" Filterable="false">
            <Template Context="file">
                <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" 
                            Click="@(() => ReadFile(file))" 
                            Tooltip="View File"
                            Style="margin-right: 5px;" />
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                            Click="@(() => EditFile(file))"
                            Tooltip="Edit File Metadata"
                            Style="margin-right: 5px;" />
                @* <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" 
                            Click="@(() => DeleteFile(file))" 
                            Tooltip="Delete File" /> *@
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<!-- Add New File Modal -->
@if (_showAddModal)
{
    <div class="modal-overlay">
        <div class="file-modal-dialog" style="width: 760px;">
            <div class="file-modal-content">
                <div class="file-modal-header">
                    <h5 class="file-modal-title">
                        <i class="fas fa-upload"></i> Add Hazard File
                    </h5>
                    <RadzenButton ButtonStyle="ButtonStyle.Light"
                                  Variant="Variant.Text"
                                  Icon="close"
                                  Size="ButtonSize.Small"
                                  Click="CloseAddModal" />
                </div>
                <div class="file-modal-body">
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Report ID (optional)" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="_newReportCode" Placeholder="Enter report code..." Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Hazard ID *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="_newHazardCode" Placeholder="Enter hazard code..." Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Description *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                <RadzenTextArea @bind-Value="_newDescription" Rows="3" Placeholder="Enter file description..." Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Supporting Documents" Variant="Variant.Outlined" Style="width: 100%;" AllowFloatingLabel="false">
                                <RadzenStack Gap="0.75rem" Class="rz-py-2 rz-px-2 rz-pb-2">
                                    <RadzenUpload Multiple="false"
                                                  Change="@OnNewFileInputChange"
                                                  ChooseText="📄 Choose Files"
                                                  Class="hazard-upload"
                                                  Style="width: 100%;padding: 0.5rem; border: 1px solid #ccc; border-radius: 0.25rem;"
                                                  Accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.txt"
                                                  MaxFileSize="10485760" />

                                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-base-500">
                                        <RadzenIcon Icon="attach_file" Style="font-size: 0.9rem;" />
                                        Supported: JPG, PNG, PDF, DOC, DOCX, TXT (Max 10MB per file)
                                    </RadzenText>

                                    @if (!string.IsNullOrWhiteSpace(_newFileName))
                                    {
                                        <RadzenText TextStyle="TextStyle.Body2">
                                            <strong>Selected:</strong> @_newFileName (@FormatFileSize(_newFileSizeBytes))
                                        </RadzenText>
                                    }
                                </RadzenStack>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </div>
                <div class="file-modal-footer">
                    <div class="d-flex justify-content-end gap-2">
                        <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Light" Click="CloseAddModal" Disabled="@_isSavingNewFile" />
                        <RadzenButton Text="Upload File" Icon="upload" ButtonStyle="ButtonStyle.Primary" Click="SaveNewFile" Disabled="@_isSavingNewFile" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- File View Modal -->
@if (_showFileModal && _selectedFile is not null)
{
    <div class="modal-overlay">
        <div class="file-modal-dialog">
            <div class="file-modal-content">
                <div class="file-modal-header">
                    <h5 class="file-modal-title">
                        <i class="fas fa-file"></i> @_selectedFile.FileName
                    </h5>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                Variant="Variant.Text"
                                Icon="close"
                                Size="ButtonSize.Small"
                                Click="CloseFileModal" />
                </div>
                <div class="file-modal-body">
                    @if (_isLoadingFile)
                    {
                        <div class="text-center p-4">
                            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                            <p class="mt-2">Loading file...</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_fileViewError))
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i> @_fileViewError
                            <div class="mt-2">
                                <RadzenButton Text="Download File" 
                                            Icon="download" 
                                            ButtonStyle="ButtonStyle.Primary"
                                            Click="DownloadFile" />
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (IsImageFile(_selectedFile.FileType))
                        {
                            <img src="@_fileDataUrl" alt="@_selectedFile.FileName" style="max-width: 100%; height: auto;" />
                        }
                        else if (IsPdfFile(_selectedFile.FileType))
                        {
                            <embed src="@_fileDataUrl" type="application/pdf" width:100% height:600px />
                        }
                        else if (IsTextFile(_selectedFile.FileType))
                        {
                            <pre style="white-space: pre-wrap; max-height: 600px; overflow-y: auto; background: #f5f5f5; padding: 1rem; border-radius: 4px;">@_fileTextContent</pre>
                        }
                        else if (IsVideoFile(_selectedFile.FileType))
                        {
                            <video controls style="max-width: 100%; height: auto;">
                                <source src="@_fileDataUrl" type="@GetMimeType(_selectedFile.FileType)">
                                Your browser does not support the video tag.
                            </video>
                        }
                        else
                        {
                            <div class="text-center p-4">
                                <i class="fas fa-file fa-3x text-muted mb-3"></i>
                                <p>Cannot preview this file type: @_selectedFile.FileType</p>
                                <RadzenButton Text="Download File" 
                                            Icon="download" 
                                            ButtonStyle="ButtonStyle.Primary"
                                            Click="DownloadFile" />
                            </div>
                        }
                    }
                </div>
                <div class="file-modal-footer">
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            <i class="fas fa-info-circle"></i> 
                            Size: @FormatFileSize(_selectedFile.FileSizeBytes) | 
                            Type: @_selectedFile.FileType | 
                            Uploaded: @(_selectedFile.UploadedDate?.ToString("MM/dd/yyyy") ?? "N/A")
                        </small>
                        <div>
                            <RadzenButton Text="Download" 
                                        Icon="download" 
                                        ButtonStyle="ButtonStyle.Secondary"
                                        Click="DownloadFile" 
                                        Style="margin-right: 10px;" />
                            <RadzenButton Text="Close" 
                                        Icon="close"
                                        ButtonStyle="ButtonStyle.Dark"
                                        Click="CloseFileModal" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Edit Metadata Modal -->
@if (_showEditModal && _editingFile is not null)
{
    <div class="modal-overlay">
        <div class="file-modal-dialog" style="width: 700px;">
            <div class="file-modal-content">
                <div class="file-modal-header">
                    <h5 class="file-modal-title">
                        <i class="fas fa-edit"></i> Edit Hazard File Metadata
                    </h5>
                    <RadzenButton ButtonStyle="ButtonStyle.Light"
                                  Variant="Variant.Text"
                                  Icon="close"
                                  Size="ButtonSize.Small"
                                  Click="CloseEditModal" />
                </div>

                <div class="file-modal-body">
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Hazard ID" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="_editHazardCode" Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Report ID" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="_editReportCode" Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Description *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                <RadzenTextArea @bind-Value="_editDescription" Rows="4" Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Category" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="_editCategory" Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Confidential" Variant="Variant.Outlined">
                                <div class="d-flex align-items-center p-2">
                                    <RadzenCheckBox @bind-Value="_editIsConfidential" Name="HazardFileConfidential" />
                                    <RadzenLabel Text="Mark as confidential" Component="HazardFileConfidential" Style="margin-left: 0.5rem; cursor: pointer;" />
                                </div>
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                </div>

                <div class="file-modal-footer">
                    <div class="d-flex justify-content-end gap-2">
                        <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Light" Click="CloseEditModal" Disabled="@_isSavingMetadata" />
                        <RadzenButton Text="Save Metadata" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="SaveFileMetadata" Disabled="@_isSavingMetadata" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
/* File Modal Styles */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
    padding: 1rem;
}

.file-modal-dialog {
    position: relative;
    margin: 0 auto;
    max-width: 90vw;
    max-height: 90vh;
    width: 1000px;
}

.file-modal-content {
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    max-height: 90vh;
}

.file-modal-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e9ecef;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 0.5rem 0.5rem 0 0;
    background-color: #f8f9fa;
}

.file-modal-title {
    margin: 0;
    font-weight: 600;
}

.file-modal-body {
    padding: 1rem;
    overflow-y: auto;
    flex: 1;
}

.file-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid #e9ecef;
    border-radius: 0 0 0.5rem 0.5rem;
    background-color: #f8f9fa;
}

.alert {
    padding: 0.75rem 1.25rem;
    margin-bottom: 1rem;
    border: 1px solid transparent;
    border-radius: 0.25rem;
}

.alert-warning {
    color: #856404;
    background-color: #fff3cd;
    border-color: #ffeaa7;
}

.text-center { text-align: center; }
.p-4 { padding: 1.5rem; }
.mt-2 { margin-top: 0.5rem; }
.mb-3 { margin-bottom: 1rem; }
.text-muted { color: #6c757d; }
.d-flex { display: flex; }
.justify-content-between { justify-content: space-between; }
.align-items-center { align-items: center; }
</style>

<script>
window.downloadFileFromBase64 = (filename, base64Content, mimeType) => {
    const linkSource = `data:${mimeType};base64,${base64Content}`;
    const downloadLink = document.createElement("a");
    downloadLink.href = linkSource;
    downloadLink.download = filename;
    document.body.appendChild(downloadLink);
    downloadLink.click();
    document.body.removeChild(downloadLink);
};
</script>
