@page "/SMSListings/HazardLocations"

@using SMS3.Components.Pages.SMSListings.Models
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS_Application.Interfaces
@using SMS_Application.Queries
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Shared.Common

<PageTitle>Hazard Locations</PageTitle>
<PageHeader Title="Hazard Locations"
            Subtitle="Complete listing and management interface for all SMS Hazard Locations"
            Icon="fas fa-list" />

<RadzenDataGrid @ref="_locationsGrid" 
                Data="@_locations" 
                Count="@_totalCount" 
                LoadData="@LoadData"
                AllowPaging="true" 
                AllowSorting="true" 
                AllowFiltering="true"
                PageSize="15"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                FilterMode="FilterMode.Advanced"
                SelectionMode="DataGridSelectionMode.Multiple"
                IsLoading="@_isLoading">
    
    <Columns>
        
        <RadzenDataGridColumn TItem="HazardLocation" Property="HazardCode" FilterProperty="ReportCode" SortProperty="ReportCode" Type="typeof(string)" FilterOperator="FilterOperator.Contains" Title="Report ID" Width="100px">
            <Template Context="location">
                <div title="@GetReportCodeForLocation(location)" style="@_basicTextStyle">
                    @GetReportCodeForLocation(location)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardLocation" Property="Code" Title="Location ID" Width="100px">
            <Template Context="location">
                                                <div title="@location.Code" style="@_basicTextStyle">
                    @(location.Code)
                </div>
            </Template>

        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardLocation" Property="HazardCode" Title="Hazard ID" Width="100px">
            <Template Context="location">
                                                <div title="@location.HazardCode" style="@_basicTextStyle">
                    @(location.HazardCode)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardLocation" Property="Latitude" Title="Latitude" Width="100px">
            <Template Context="location">
                                                <div title="@(location.Latitude?.ToString("F6"))" style="@_basicTextStyle">
                    @(location.Latitude?.ToString("F6") ?? "N/A")
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardLocation" Property="Longitude" Title="Longitude" Width="100px">
            <Template Context="location">
                                                <div title="@(location.Longitude?.ToString("F6"))" style="@_basicTextStyle">
                    @(location.Longitude?.ToString("F6") ?? "N/A")
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardLocation" Property="Description" Title="Description" Width="300px">
            <Template Context="location">
                                                <div title="@location.Description" style="@_basicTextStyle">
                    @(location.Description)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardLocation" Property="CreatedBy" Title="Created By" Width="120px">
            <Template Context="location">
                                                <div title="@location.CreatedBy" style="@_basicTextStyle">
                    @(location.CreatedBy)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardLocation" Property="CreatedDate" Title="Created Date" Width="120px" FormatString="{0:MM/dd/yyyy}">
            <Template Context="location">
                                                <div title="@location.CreatedDate" style="@_basicTextStyle">
                    @if (location.CreatedDate.HasValue)
                    {
                        @(location.CreatedDate.Value.ToString("MM/dd/yyyy"))
                    }
                </div>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="HazardLocation" Property="IsValidated" Title="Validated" Width="100px">
            <Template Context="location">
                @if (location.IsValidated)
                {
                    <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" title="Validated" />
                }
                else
                {
                    <RadzenIcon Icon="fiber_manual_record" Style="color: var(--rz-danger);" title="Not validated" />
                }
            </Template>
        </RadzenDataGridColumn>
        

        <RadzenDataGridColumn TItem="HazardLocation" Title="Actions" Width="140px" Sortable="false" Filterable="false">
            <Template Context="location">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                    @if (_currentUserService.CanRead("SMS_Listings_HazardLocations"))
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Base"
                                      Size="ButtonSize.Small"
                                      Click="@(() => ViewLocationMap(location))"
                                      Disabled="@(!HasValidCoordinates(location))"
                                      title="@(HasValidCoordinates(location) ? "View location on map" : "No valid coordinates available")"
                                      Icon="visibility" />
                    }

                    @if (_currentUserService.CanUpdate("SMS_Listings_HazardLocations") && !location.IsValidated)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small"
                                      Click="@(() => ValidateLocation(location))"
                                      Disabled="@(!HasValidCoordinates(location))"
                                      title="@(HasValidCoordinates(location) ? "Validate location" : "No valid coordinates available")"
                                      Icon="edit" />
                    }
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>       
    </Columns>
</RadzenDataGrid>
