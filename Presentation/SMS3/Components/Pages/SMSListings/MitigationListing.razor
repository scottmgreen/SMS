@page "/SMSListings/Mitigations"
@page "/SMSListings/Mitigations/{ReportId}"
@page "/SMSListings/Mitigations/{ReportId}/{HazardCode}"
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Application.Queries
@using SMS_Application.Commands
@using SMS_Application.Interfaces
@using SMS_Shared.Common
@using SMS3.Components.Pages.SMSListings.Models
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared

<!-- Context Header -->
@if (_contextHazard is not null || _contextReport is not null)
{
    <RadzenCard Variant="Variant.Outlined" Class="mb-3" Style="border-left: 4px solid var(--rz-info);">
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.H6" Style="color: #212e61; margin: 0;">
                <RadzenIcon Icon="info" Style="margin-right: 0.5rem;" />
                Context Information
            </RadzenText>
            <RadzenRow Gap="1rem">
                @if (_contextReport is not null)
                {
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Body2">
                            <strong>Report:</strong> @_contextReport.Code<br>
                            @* <strong>Report Type:</strong> @_contextReport.ReportType<br> *@
                            <strong>Status:</strong> <RadzenBadge Text="@_contextReport.Status" BadgeStyle="BadgeStyle.Info" />
                        </RadzenText>
                    </RadzenColumn>
                }
                @if (_contextHazard is not null)
                {
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Body2">
                            <strong>Hazard:</strong> @_contextHazard.Code<br>
                            <strong>Category:</strong> @_contextHazard.HazardCategory<br>
                            <strong>Risk Level:</strong> @_contextHazard.HazardRiskLevel.Value
                        </RadzenText>
                    </RadzenColumn>
                }
            </RadzenRow>
        </RadzenStack>
    </RadzenCard>
}
<!-- SMS Page Header using reusable component -->
<PageHeader Title="Mitigation Listing"
            Subtitle="Complete listing and management interface for all SMS mitigations"
            Icon="fas fa-list" />

<!-- Mitigations Data Grid -->
<RadzenDataGrid @ref="_mitigationsGrid"
                Data="@_mitigationModels"
                Count="@_totalCount"
                LoadData="@LoadData"
                AllowPaging="true"
                AllowSorting="true"
                AllowFiltering="true"
                PageSize="15"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                FilterMode="FilterMode.Advanced"
                IsLoading="@_isLoading">

    <Columns>
        <!-- Report ID Column -->
        <RadzenDataGridColumn TItem="MitigationModel" Property="ReportCode" Title="Report ID" Width="120px">
            <Template Context="mitigation">
                <div title="@mitigation.ReportCode" style="@_basicTextStyle">
                    @(mitigation.ReportCode)
                </div>
            </Template>
        </RadzenDataGridColumn>

        <!-- Hazard ID Column -->
        <RadzenDataGridColumn TItem="MitigationModel" Property="HazardCode" Title="Hazard ID" Width="120px">
            <Template Context="mitigation">
                <div title="@mitigation.HazardCode" style="@_basicTextStyle">
                    @(mitigation.HazardCode)
                </div>
            </Template>
        </RadzenDataGridColumn>

        <!-- Mitigation ID Column -->
        <RadzenDataGridColumn TItem="MitigationModel" Property="Code" Title="Mitigation ID" Width="120px">
            <Template Context="mitigation">
                <div title="@mitigation.Code" style="@_basicTextStyle">
                    @(mitigation.Code)
                </div>
            </Template>
        </RadzenDataGridColumn>

        <!-- Mitigation Description -->
        <RadzenDataGridColumn TItem="MitigationModel" Property="Description" Title="Description" Width="320px">
            <Template Context="mitigation">
                @(mitigation.Description?.Length > 100 ? mitigation.Description.Substring(0, 100) + "..." : mitigation.Description)"
            </Template>
        </RadzenDataGridColumn>

        <!-- Status Column -->
        <RadzenDataGridColumn TItem="MitigationModel" Property="Status" Title="Status" Width="120px">
            <Template Context="mitigation">
                <div title="@mitigation.Status.ToString()" style="@_basicTextStyle">
                    @mitigation.Status.Value
                </div>
            </Template>
        </RadzenDataGridColumn>

       
        
        <!-- Progress Column -->
        <RadzenDataGridColumn TItem="MitigationModel" Property="Progress" Title="Progress" Width="100px">
            <Template Context="mitigation">
                <RadzenProgressBar Value="@mitigation.Progress" Max="100" Style="width: 100%;" />
                @* <RadzenText TextStyle="TextStyle.Caption" Text="@($"{mitigationViewModel.Progress}%")" /> *@
            </Template>
        </RadzenDataGridColumn>

        <!-- Target Date Column -->
        <RadzenDataGridColumn TItem="MitigationModel" Property="TargetDate" Title="Target Date" Width="120px" FormatString="{0:MM/dd/yyyy}">
            <Template Context="mitigation">
                @if (mitigation.TargetDate.HasValue)
                {
                    <div title="@mitigation.TargetDate.Value.ToString("MM/dd/yyyy")" style="@_basicTextStyle">
                        @mitigation.TargetDate.Value.ToString("MM/dd/yyyy")
                    </div>
                }
                else
                {
                    <RadzenText Text="Not set" Style="color: var(--rz-text-tertiary-color);" />
                }
            </Template>
        </RadzenDataGridColumn>

        <!-- Actions Column -->
        <RadzenDataGridColumn TItem="MitigationModel" Title="Actions" Width="200px" Sortable="false" Filterable="false">
            <Template Context="mitigation">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                    <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                  Tooltip="View Mitigation Details"
                                  Click="@(() => ViewMitigation(mitigation.Mitigation))" />

                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                  Tooltip="Edit Mitigation"
                                  Click="@(() => EditMitigation(mitigation.Mitigation))" />

                    @if (mitigation.Status != MitigationStatus.Approved)
                    {
                        <RadzenButton Icon="verified" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                      Tooltip="Quick Approve"
                                      Click="@(async () => await QuickApproveMitigation(mitigation.Mitigation))" />
                    }

                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                  Tooltip="Delete Mitigation"
                                  Click="@(() => DeleteMitigation(mitigation.Mitigation))" />
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<!-- Bulk Approval Dialog -->
@if (_showBulkApprovalDialog && _selectedMitigations.Any())
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-lg">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-warning">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-check-double"></i> Bulk Mitigation Approval
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Text"
                                      Icon="close"
                                      Size="ButtonSize.Small"
                                      Click="@CloseBulkApprovalDialog" />
                    </div>
                </div>
                <div class="sms-modal-body">

                    <!-- Context Information -->
                    @if (_contextHazard is not null)
                    {
                        <RadzenCard Variant="Variant.Outlined" Class="mb-3">
                            <div class="p-3">
                                <h6 class="text-primary mb-3">
                                    <i class="fas fa-exclamation-triangle text-warning"></i> Confirmation Required
                                </h6>
                                <p class="mb-3">
                                    You are about to <strong>approve @_selectedMitigations.Count() mitigation(s)</strong> for:
                                </p>
                                <div class="row mb-3">
                                    <div class="col-sm-6">
                                        <strong>Report:</strong> @(_contextReport?.Code ?? ReportId ?? "N/A")<br>
                                        <strong>Hazard:</strong> @_contextHazard.Code<br>
                                    </div>
                                    <div class="col-sm-6">
                                        <strong>Total Mitigations:</strong> @_selectedMitigations.Count()<br>
                                        <strong>Hazard Category:</strong> @_contextHazard.HazardCategory
                                    </div>
                                </div>
                                <div class="bg-light p-2 rounded mb-3">
                                    <strong>Hazard Description:</strong> @_contextHazard.Description
                                </div>
                            </div>
                        </RadzenCard>
                    }

                    <!-- Mitigation List Preview -->
                    <RadzenCard Variant="Variant.Outlined" Class="mb-3">
                        <div class="p-3">
                            <h6 class="text-primary mb-3">
                                <i class="fas fa-list"></i> Mitigations to be Approved
                            </h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-striped">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Name</th>
                                            <th>Current Status</th>
                                            <th>Priority</th>
                                            <th>Progress</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var mitigation in _selectedMitigations)
                                        {
                                            <tr>
                                                <td><code>@mitigation.Code</code></td>
                                                <td>@mitigation.Name</td>
                                                <td>
                                                    @mitigation.Status.Value
                                                                 
                                                </td>
                                                
                                                <td>@mitigation.Progress%</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </RadzenCard>

                    <!-- Warning Message -->
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Icon="warning" ShowIcon="true" Class="mb-3">
                        <strong>Important:</strong> This action will set the status of ALL listed mitigations to "Approved".
                        This action cannot be undone. Please review the mitigations carefully before proceeding.
                    </RadzenAlert>

                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end gap-2">
                        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                      Text="Cancel"
                                      Icon="close"
                                      Click="@CloseBulkApprovalDialog"
                                      Size="ButtonSize.Medium"
                                      Disabled="@_isProcessingBulkApproval" />
                        <RadzenButton ButtonStyle="ButtonStyle.Success"
                                      Text="@(_isProcessingBulkApproval ? "Processing..." : $"Approve All {_selectedMitigations.Count()} Mitigations")"
                                      Icon="@(_isProcessingBulkApproval ? "hourglass_empty" : "verified")"
                                      Click="@ProcessBulkApproval"
                                      Size="ButtonSize.Medium"
                                      Disabled="@_isProcessingBulkApproval" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- View Mitigation Modal Dialog (unchanged from original) -->
@if (_showViewDialog && _selectedMitigation is not null)
{
    <!-- Keep existing view dialog markup -->
}

<style>
    /* Modal styles (unchanged) */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 1rem;
    }

    .sms-modal-dialog {
        position: relative;
        margin: 0 auto;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
    }

    .sms-modal-lg {
        max-width: 900px;
        width: 100%;
    }

    .sms-modal-content {
        background: white;
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    }

    .sms-modal-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e9ecef;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .sms-header-warning {
        background-color: #ff9800;
        color: white;
    }

    .sms-modal-title {
        margin: 0;
        font-weight: 600;
    }

    .sms-modal-body {
        padding: 1.5rem;
    }

    .sms-modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid #e9ecef;
        border-radius: 0 0 0.5rem 0.5rem;
    }
</style>
