@page "/SMSListings/Reports"
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS3.Components.Pages.SMSListings.Models
@using SMS3.Components.Shared.Components
@using SMS_Application.Interfaces
@using SMS_Application.Commands
@using SMS_Application.Queries
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Shared.Common

<PageTitle>Reports Listing - SMS3</PageTitle>

<!-- SMS Page Header using reusable component -->
<PageHeader Title="Reports Listing"
            Subtitle="Complete listing for all SMS Reports"
            Icon="fas fa-list">
    <AdditionalContent>
        <RadzenButton Text="Export Selected Package"
                      Icon="download"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@OnExportSelectedReportsAsync"
                      Disabled="@(!_selectedReports.Any())" />
    </AdditionalContent>
</PageHeader>



<RadzenDataGrid @ref="_reportsGrid" 
                Data="@_reports" 
                @bind-Value="@_selectedReports"
                Count="@_totalCount" 
                LoadData="@LoadData"
                AllowPaging="true" 
                AllowSorting="true" 
                AllowFiltering="true"
                PageSize="25"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                FilterMode="FilterMode.Advanced"
                SelectionMode="DataGridSelectionMode.Multiple"
                Style="height: calc(100vh - 250px)"
                IsLoading="@_isLoading"
                >
    <Columns>
        <RadzenDataGridColumn TItem="Report" Width="60px" Sortable="false" Filterable="false">
            <HeaderTemplate>
                <RadzenCheckBox TValue="bool"
                                TriState="false"
                                Value="@IsAllVisibleReportsSelected()"
                                Change="@OnSelectAllVisibleReportsChanged" />
            </HeaderTemplate>
            <Template Context="report">
                <RadzenCheckBox TValue="bool"
                                TriState="false"
                                Value="@IsReportSelected(report)"
                                Change="@(isChecked => OnReportSelectionChanged(report, (bool)isChecked))"
                                @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Report" Property="Code" Title="Report ID" Width="150px" >
            <Template Context="report">
                <div title="@report.Code" style="@_basicTextStyle">
                    @(report.Code)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Report" Property="Name" Title="Name" Width="300px">
            <Template Context="report">
                <div title="@report.Name" style="@_basicTextStyle">
                    @(report.Name)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Report" Title="Description" Width="100px" Sortable="false">
            <Template Context="report">
                <RadzenButton Text="Description"
                              Icon="description"
                              ButtonStyle="ButtonStyle.Base"
                              Variant="Variant.Text"
                              Size="ButtonSize.ExtraSmall"
                              Title="Click to view full description"
                              Class="description-button"
                              Click="@(() => ShowDescriptionDialog(report))" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Report" Property="Status" Title="Status" Width="250px">
            <Template Context="report">
                <div title="@report.Status" style="@_basicTextStyle">
                    @(report.Status)
                </div>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Report" Property="SubmittedBy" Title="Submitted By" Width="150px">
            <Template Context="report">
                <div title="@report.SubmittedBy" style="@_basicTextStyle">
                    @(report.SubmittedBy)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Report" Property="SubmittedDate" Title="Submitted Date" Width="150px" FormatString="{0:MM/dd/yyyy}">
            <Template Context="report">
                <div title="@report.SubmittedDate" style="@_basicTextStyle">
                    @(report.SubmittedDate)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Report" Property="SubmittingDepartment" Title="Submitting Department" Width="250px">
            <Template Context="report">
                <div title="@report.SubmittingDepartment" style="@_basicTextStyle">
                    @(report.SubmittingDepartment)
                </div>
            </Template>

        </RadzenDataGridColumn>
       
        <!-- Enhanced Actions Column -->
        <RadzenDataGridColumn TItem="Report" Title="Actions" Width="150px" Sortable="false" Filterable="false">
            <Template Context="report">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">

                    @if ((report.Status?.Trim() != ReportStatus.NeedsValidation.Value))
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Success"
                                      Size="ButtonSize.Small"
                                      Click="@(() => OnResetReportAsync(report))"
                                      title="Reset Report"
                                      Icon="visibility" />
                    }

                
                    <RadzenButton ButtonStyle="ButtonStyle.Base" 
                                Size="ButtonSize.Small"
                                Click="@(() => OnViewReportAsync(report))"
                                title="View Details"
                                Icon="visibility" />
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                Size="ButtonSize.Small"
                                Click="@(() => OnEditReportAsync(report))"
                                title="Edit Report"
                                Icon="edit" />
                    <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                Size="ButtonSize.Small"
                                Click="@(() => OnDeleteReportAsync(report))"
                                title="Delete Report"
                                Icon="delete" />
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<!-- Read-Only Report Details Modal -->
@if (ShowDetailsModal && SelectedReport is not null)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-xxl">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-file-alt"></i> Report Details - @SelectedReport.Code
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                    Variant="Variant.Text"
                                    Icon="close"
                                    Size="ButtonSize.Small"
                                    Click="CloseDetailsModal" />
                    </div>
                </div>
                <div class="sms-modal-body p-4">
                    @{
                        var totalHazards = AssociatedHazards.Count;
                        var mappedLocationCount = AssociatedHazards.Count(h => h.HazardLocation?.Latitude.HasValue == true && h.HazardLocation?.Longitude.HasValue == true);
                        var locationRecordCount = AssociatedHazards.Count(h => h.HazardLocation is not null);
                        var validatedLocationCount = AssociatedHazards.Count(h => h.HazardLocation?.IsValidated == true);

                        var areHazardCategoriesValidated = totalHazards > 0 && AssociatedHazards.All(h =>
                            !string.IsNullOrWhiteSpace(h.HazardCategory) &&
                            !h.HazardCategory.Equals("default", StringComparison.OrdinalIgnoreCase));

                        var areHazardTypesValidated = totalHazards > 0 && AssociatedHazards.All(h =>
                            !string.IsNullOrWhiteSpace(h.HazardType) &&
                            !h.HazardType.Equals("default", StringComparison.OrdinalIgnoreCase));

                        var areHazardLocationsValidated = totalHazards > 0 && AssociatedHazards.All(h => h.HazardLocation?.IsValidated == true);

                        var isReportValidated = !string.IsNullOrWhiteSpace(SelectedReport.Status) &&
                            !SelectedReport.Status.Equals(ReportStatus.NeedsValidation.Value, StringComparison.OrdinalIgnoreCase);
                    }

                    <RadzenRow Gap="0.75rem" Class="rz-mb-3 report-details-grid">
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                            <RadzenCard Variant="Variant.Outlined" Class="h-100">
                                <RadzenStack Gap="0.35rem" Class="report-details-stack">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; color: var(--rz-primary);">
                                        <RadzenIcon Icon="info" Style="margin-right: 0.5rem;" />Report Information
                                    </RadzenText>
                                    <div><strong>Report ID:</strong> @SelectedReport.Code</div>
                                    @* <div><strong>Name:</strong> @(SelectedReport.Name ?? "Not specified")</div> *@
                                    <div><strong>Source:</strong> @(SelectedReport.SubmittedBy ?? "Unknown")</div>
                                    <div><strong>Submitted:</strong> @SelectedReport.SubmittedDate.ToString("MM/dd/yyyy HH:mm")</div>
                                    
                                    @if (!string.IsNullOrWhiteSpace(SelectedReport.SubmittingDepartment))
                                    {
                                        <div><strong>Department:</strong> @SelectedReport.SubmittingDepartment</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(SelectedReport.SubmittingDepartmentJobFunction))
                                    {
                                        <div><strong>Job Function:</strong> @SelectedReport.SubmittingDepartmentJobFunction</div>
                                    }
                                </RadzenStack>
                            </RadzenCard>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                            <RadzenCard Variant="Variant.Outlined" Class="h-100">
                                <RadzenStack Gap="0.35rem" Class="report-details-stack">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; color: var(--rz-primary);">
                                        <RadzenIcon Icon="verified" Style="margin-right: 0.5rem;" />Validation Status
                                    </RadzenText>
                                    <div>
                                        <RadzenIcon Icon="@(areHazardCategoriesValidated ? "check_circle" : "cancel")" class="@($"me-2 {(areHazardCategoriesValidated ? "text-success" : "text-danger")}")" />
                                        Hazard Category: @(areHazardCategoriesValidated ? "Validated" : "Default/Invalid")
                                    </div>
                                    <div>
                                        <RadzenIcon Icon="@(areHazardTypesValidated ? "check_circle" : "cancel")" class="@($"me-2 {(areHazardTypesValidated ? "text-success" : "text-danger")}")" />
                                        Hazard Type: @(areHazardTypesValidated ? "Validated" : "Default/Invalid")
                                    </div>
                                    <div>
                                        <RadzenIcon Icon="@(areHazardLocationsValidated ? "check_circle" : "cancel")" class="@($"me-2 {(areHazardLocationsValidated ? "text-success" : "text-danger")}")" />
                                        Hazard Location: @validatedLocationCount/@totalHazards validated
                                    </div>
                                    <div>
                                        <RadzenIcon Icon="@(isReportValidated ? "check_circle" : "schedule")" class="@($"me-2 {(isReportValidated ? "text-success" : "text-warning")}")" />
                                        Report Validation: @(isReportValidated ? "Completed" : "Pending")
                                    </div>
                                </RadzenStack>
                            </RadzenCard>
                        </RadzenColumn>

                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                            <RadzenCard Variant="Variant.Outlined" Class="h-100">
                                <RadzenStack Gap="0.35rem" Class="report-details-stack">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; color: var(--rz-primary);">
                                        <RadzenIcon Icon="settings" Style="margin-right: 0.5rem;" />Processing Status
                                    </RadzenText>
                                    <div>
                                        <strong>Current Status: &nbsp;</strong>
                                        @if (!string.IsNullOrWhiteSpace(SelectedReport.Status))
                                        {
                                            @* <RadzenBadge Text="@SelectedReport.Status" BadgeStyle="@GetStatusBadgeStyle(SelectedReport.Status)" /> *@
                                            @SelectedReport.Status
                                        }
                                        else
                                        {
                                            <span> Unknown</span>
                                        }
                                    </div>
                                    @* <div>
                                        <strong>Current Stage:</strong>
                                        @if (!string.IsNullOrWhiteSpace(SelectedReport.Stage))
                                        {
                                            <RadzenBadge Text="@SelectedReport.Stage" BadgeStyle="@GetStageBadgeStyle(SelectedReport.Stage)" />
                                        }
                                        else
                                        {
                                            <span> Unknown</span>
                                        }
                                    </div> *@
                                    <div><strong>Hazards:</strong> @totalHazards</div>
                                    <div><strong>Attached Files:</strong> @TotalFilesCount</div>
                                </RadzenStack>
                            </RadzenCard>
                        </RadzenColumn>

                        
                    </RadzenRow>

                   @*  @if (!string.IsNullOrWhiteSpace(SelectedReport.Description))
                    {
                        <RadzenCard Variant="Variant.Outlined" Class="rz-mb-3">
                            <RadzenStack Gap="0.5rem">
                                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;"><strong>Description</strong></RadzenText>
                                <div style="line-height: 1.6;">
                                    @((MarkupString)SelectedReport.Description)
                                </div>
                            </RadzenStack>
                        </RadzenCard>
                    } *@

                    <RadzenCard Variant="Variant.Outlined">
                        <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0; color: var(--rz-primary);">
                            <RadzenIcon Icon="warning" Style="margin-right: 0.5rem;" />Associated Hazards (@AssociatedHazards.Count)
                        </RadzenText>

                        @if (AssociatedHazards.Any())
                        {
                            <RadzenDataList Data="@AssociatedHazards" WrapItems="false" AllowPaging="false" Class="rz-mt-2">
                                <Template Context="hazard">
                                    <RadzenCard Variant="Variant.Text" Class="rz-mb-2">
                                        <RadzenRow Gap="1rem">
                                            <RadzenColumn Size="12" SizeLG="7">
                                                <RadzenStack Gap="0.5rem">
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">
                                                        <strong>Hazard ID: </strong> @hazard.Code 
                                                    </RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                                                        <strong>Category/Type:</strong> @string.Join(" - ", new[] { hazard.HazardCategory, hazard.HazardType }.Where(x => !string.IsNullOrWhiteSpace(x)))
                                                    </RadzenText>
                                                    @if (!string.IsNullOrWhiteSpace(hazard.Description))
                                                    {
                                                        <div style="line-height: 1.5;">
                                                            @((MarkupString)hazard.Description)
                                                        </div>
                                                    }
                                                </RadzenStack>
                                            </RadzenColumn>

                                            <RadzenColumn Size="12" SizeLG="5">
                                                @if (hazard.HazardLocation is not null && hazard.HazardLocation.Latitude.HasValue && hazard.HazardLocation.Longitude.HasValue)
                                                {
                                                    <ReadOnlyLocationMap Latitude="@(hazard.HazardLocation.Latitude.Value)"
                                                                         Longitude="@(hazard.HazardLocation.Longitude.Value)"
                                                                         LocationId="@hazard.HazardLocation.Code"
                                                                         LocationDescription="@(hazard.HazardLocation.Description ?? hazard.Code)"
                                                                         MapHeight="220px"
                                                                         ShowZoomControls="false"
                                                                         ShowLocationDetails="true"
                                                                         ZoomLevel="16" />
                                                }
                                                else
                                                {
                                                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Class="rz-mb-0">
                                                        No mapped location available.
                                                    </RadzenAlert>
                                                }
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </RadzenCard>
                                </Template>
                            </RadzenDataList>
                        }
                        else
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Base" Variant="Variant.Flat" Class="rz-mt-2">
                                No hazards associated with this report.
                            </RadzenAlert>
                        }
                    </RadzenCard>
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end gap-2">
                        <RadzenButton ButtonStyle="ButtonStyle.Warning" 
                                    Text="Edit Report" 
                                    Icon="edit"
                                    Click="@(() => EditFromDetailsModal(SelectedReport))"
                                    Size="ButtonSize.Medium" />
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                    Text="Close" 
                                    Icon="close"
                                    Click="CloseDetailsModal"
                                    Size="ButtonSize.Medium" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Custom Reset Confirmation Modal -->
@if (_showResetConfirmModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog" style="max-width: 700px; width: 90%;">
            <div class="sms-modal-content">
                <div class="sms-modal-header" style="background-color: #dc3545; color: white;">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-exclamation-triangle"></i> Confirm Reset Report Validation
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                    Variant="Variant.Text"
                                    Icon="close"
                                    Size="ButtonSize.Small"
                                    Click="CancelResetConfirmation" 
                                    Style="color: white;" />
                    </div>
                </div>
                <div class="sms-modal-body" style="padding: 1.5rem;">
                    <div class="reset-confirmation-message">
                        @_resetConfirmationMessage
                    </div>
                    <div class="reset-warning-final">
                        @GetResetFinalWarning()
                    </div>
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end gap-2">
                        <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                    Text="Cancel" 
                                    Icon="close"
                                    Click="CancelResetConfirmation"
                                    Size="ButtonSize.Medium" />
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                    Text="Yes, Reset Report" 
                                    Icon="refresh"
                                    Click="HandleResetConfirmation"
                                    Size="ButtonSize.Medium"
                                    Disabled="@_isLoading" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (_showDescriptionModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-md">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-file-alt"></i> Report Description - @_selectedReportId
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Text"
                                      Icon="close"
                                      Size="ButtonSize.Small"
                                      Click="@CloseDescriptionModal" />
                    </div>
                </div>
                <div class="sms-modal-body">
                    <RadzenCard Variant="Variant.Outlined">
                        <div class="p-3">
                            <div style="line-height: 1.6; white-space: normal;">
                                @((MarkupString)(_selectedDescription ?? "No description available"))
                            </div>
                        </div>
                    </RadzenCard>
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end">
                        <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                      Text="Close"
                                      Icon="close"
                                      Click="@CloseDescriptionModal"
                                      Size="ButtonSize.Medium" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
.sms-modal-xxl {
    max-width: 1400px;
    width: 95%;
}

.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
    padding: 1rem;
}

.sms-modal-dialog {
    position: relative;
    margin: 0 auto;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
}

    .sms-modal-md {
        max-width: 700px;
        width: 100%;
    }
.sms-modal-content {
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
}

.sms-modal-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e9ecef;
    border-radius: 0.5rem 0.5rem 0 0;
}

.sms-header-primary {
    background-color: #212e61; /* SMS Blue Dark Bold */
    color: white;
}

.sms-modal-title {
    margin: 0;
    font-weight: 600;
}

.sms-modal-body {
    max-height: calc(100vh - 200px);
    overflow-y: auto;
}

.sms-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid #e9ecef;
    border-radius: 0 0 0.5rem 0.5rem;
}

.report-details-grid .rz-card {
    padding: 0.75rem;
}

.report-details-stack {
    line-height: 1.35;
    font-size: 0.92rem;
}

.report-details-stack .rz-text-subtitle2 {
    margin-bottom: 0.15rem;
}

/* Enhanced styles for reset confirmation modal */
.reset-confirmation-message {
    white-space: pre-wrap;
    line-height: 1.6;
    font-size: 14px;
    font-family: 'Segoe UI', system-ui, sans-serif;
}

.reset-warning-final {
    text-align: center;
    font-weight: bold;
    color: #dc3545;
    font-size: 16px;
    margin-top: 1rem;
    padding: 0.75rem;
    background-color: #f8d7da;
    border: 1px solid #f5c6cb;
    border-radius: 0.25rem;
}
</style>
