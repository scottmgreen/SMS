@page "/SMSListings/Reports"
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS3.Components.Pages.SMSListings.Models
@using SMS3.Components.Shared.Components
@using SMS_Application.Interfaces
@using SMS_Application.Commands
@using SMS_Application.Queries
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Shared.Common

<PageTitle>Reports Listing - SMS3</PageTitle>

<!-- SMS Page Header using reusable component -->
<PageHeader Title="Reports Listing"
            Subtitle="Complete listing for all SMS Reports"
            Icon="fas fa-list">
    <AdditionalContent>
        <RadzenButton Text="Export Selected Package"
                      Icon="download"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@OnExportSelectedReportsAsync"
                      Disabled="@(!_selectedReports.Any())" />
    </AdditionalContent>
</PageHeader>



<RadzenDataGrid @ref="_reportsGrid" 
                Data="@_reports" 
                @bind-Value="@_selectedReports"
                Count="@_totalCount" 
                LoadData="@LoadData"
                AllowPaging="true" 
                AllowSorting="true" 
                AllowFiltering="true"
                PageSize="25"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                FilterMode="FilterMode.Advanced"
                SelectionMode="DataGridSelectionMode.Multiple"
                Style="height: calc(100vh - 250px)"
                IsLoading="@_isLoading"
                >
    <Columns>
        <RadzenDataGridColumn TItem="Report" Width="60px" Sortable="false" Filterable="false">
            <HeaderTemplate>
                <RadzenCheckBox TValue="bool"
                                TriState="false"
                                Value="@IsAllVisibleReportsSelected()"
                                Change="@OnSelectAllVisibleReportsChanged" />
            </HeaderTemplate>
            <Template Context="report">
                <RadzenCheckBox TValue="bool"
                                TriState="false"
                                Value="@IsReportSelected(report)"
                                Change="@(isChecked => OnReportSelectionChanged(report, (bool)isChecked))"
                                @onclick:stopPropagation="true" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Report" Property="Code" Title="Report ID" Width="150px" >
            <Template Context="report">
                <div title="@report.Code" style="@_basicTextStyle">
                    @(report.Code)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Report" Property="Name" Title="Name" Width="300px">
            <Template Context="report">
                <div title="@report.Name" style="@_basicTextStyle">
                    @(report.Name)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Report" Title="Description" Width="100px" Sortable="false">
            <Template Context="report">
                <RadzenButton Text="Description"
                              Icon="description"
                              ButtonStyle="ButtonStyle.Base"
                              Variant="Variant.Text"
                              Size="ButtonSize.ExtraSmall"
                              Title="Click to view full description"
                              Class="description-button"
                              Click="@(() => ShowDescriptionDialog(report))" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Report" Property="Status" Title="Status" Width="250px">
            <Template Context="report">
                <div title="@report.Status" style="@_basicTextStyle">
                    @(report.Status)
                </div>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Report" Property="SubmittedBy" Title="Submitted By" Width="150px">
            <Template Context="report">
                <div title="@report.SubmittedBy" style="@_basicTextStyle">
                    @(report.SubmittedBy)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Report" Property="SubmittedDate" Title="Submitted Date" Width="150px" FormatString="{0:MM/dd/yyyy}">
            <Template Context="report">
                <div title="@report.SubmittedDate" style="@_basicTextStyle">
                    @(report.SubmittedDate)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Report" Property="SubmittingDepartment" Title="Submitting Department" Width="250px">
            <Template Context="report">
                <div title="@report.SubmittingDepartment" style="@_basicTextStyle">
                    @(report.SubmittingDepartment)
                </div>
            </Template>

        </RadzenDataGridColumn>
       
        <!-- Enhanced Actions Column -->
        <RadzenDataGridColumn TItem="Report" Title="Actions" Width="150px" Sortable="false" Filterable="false">
            <Template Context="report">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">

                    @if ((report.Status?.Trim() != ReportStatus.NeedsValidation.Value))
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Success"
                                      Size="ButtonSize.Small"
                                      Click="@(() => OnResetReportAsync(report))"
                                      title="Reset Report"
                                      Icon="visibility" />
                    }

                
                    <RadzenButton ButtonStyle="ButtonStyle.Base" 
                                Size="ButtonSize.Small"
                                Click="@(() => OnViewReportAsync(report))"
                                title="View Details"
                                Icon="visibility" />
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                Size="ButtonSize.Small"
                                Click="@(() => OnEditReportAsync(report))"
                                title="Edit Report"
                                Icon="edit" />
                    <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                Size="ButtonSize.Small"
                                Click="@(() => OnDeleteReportAsync(report))"
                                title="Delete Report"
                                Icon="delete" />
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<!-- Read-Only Report Details Modal -->
@if (ShowDetailsModal && SelectedReport is not null)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-xxl">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-file-alt"></i> Report Details - @SelectedReport.Code
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                    Variant="Variant.Text"
                                    Icon="close"
                                    Size="ButtonSize.Small"
                                    Click="CloseDetailsModal" />
                    </div>
                </div>
                <div class="sms-modal-body p-0">
                    <!-- Report Information Section -->
                    <div class="p-4 border-bottom">
                        <RadzenRow Gap="2rem">
                            <RadzenColumn Size="8">
                                <h6 class="text-primary mb-3">
                                    <i class="fas fa-info-circle"></i> Report Information
                                </h6>
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="6">
                                        <RadzenCard Variant="Variant.Outlined">
                                            <div class="p-3">
                                                <strong>Code:</strong> @SelectedReport.Code<br>
                                                <strong>Name:</strong> @(SelectedReport.Name ?? "Not specified")<br>
                                                <strong>Status:</strong> 
                                                @if (!string.IsNullOrEmpty(SelectedReport.Status))
                                                {
                                                    <RadzenBadge Text="@SelectedReport.Status" BadgeStyle="@GetStatusBadgeStyle(SelectedReport.Status)" />
                                                }
                                                <br>
                                                <strong>Stage:</strong>
                                                @if (!string.IsNullOrEmpty(SelectedReport.Stage))
                                                {
                                                    <RadzenBadge Text="@SelectedReport.Stage" BadgeStyle="@GetStageBadgeStyle(SelectedReport.Stage)" />
                                                }
                                            </div>
                                        </RadzenCard>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6">
                                        <RadzenCard Variant="Variant.Outlined">
                                            <div class="p-3">
                                                <strong>Created:</strong> @(SelectedReport.CreatedDate?.ToString("MM/dd/yyyy HH:mm") ?? "N/A")<br>
                                                <strong>Created By:</strong> @(SelectedReport.CreatedBy ?? "System")<br>
                                                <strong>Updated:</strong> @(SelectedReport.UpdatedDate?.ToString("MM/dd/yyyy HH:mm") ?? "Never")<br>
                                                <strong>Updated By:</strong> @(SelectedReport.UpdatedBy ?? "N/A")
                                            </div>
                                        </RadzenCard>
                                    </RadzenColumn>
                                </RadzenRow>
                                @if (!string.IsNullOrEmpty(SelectedReport.Description))
                                {
                                    <div class="mt-3">
                                        <strong>Description:</strong>
                                        <RadzenCard Variant="Variant.Text" Class="mt-2">
                                            <div class="p-2" style="background-color: #f8f9fa;">
                                                @SelectedReport.Description
                                            </div>
                                        </RadzenCard>
                                    </div>
                                }
                            </RadzenColumn>
                            <RadzenColumn Size="4">
                                <h6 class="text-primary mb-3">
                                    <i class="fas fa-chart-line"></i> Quick Stats
                                </h6>
                                <RadzenCard Variant="Variant.Outlined">
                                    <div class="p-3">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span>Associated Hazards:</span>
                                            <RadzenBadge Text="@AssociatedHazards.Count.ToString()" BadgeStyle="BadgeStyle.Info" />
                                        </div>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span>Locations with Maps:</span>
                                            <RadzenBadge Text="@LocationsWithMaps" BadgeStyle="BadgeStyle.Success" />
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>Files Attached:</span>
                                            <RadzenBadge Text="@TotalFilesCount.ToString()" BadgeStyle="BadgeStyle.Secondary" />
                                        </div>
                                    </div>
                                </RadzenCard>
                            </RadzenColumn>
                        </RadzenRow>
                    </div>

                    <!-- Associated Hazards Section -->
                    @if (AssociatedHazards.Any())
                    {
                        <div class="p-4 border-bottom">
                            <h6 class="text-primary mb-3">
                                <i class="fas fa-exclamation-triangle"></i> Associated Hazards (@AssociatedHazards.Count)
                            </h6>
                            <RadzenDataList Data="@AssociatedHazards" WrapItems="true" AllowPaging="false">
                                <Template Context="hazard">
                                    <RadzenCard Class="mb-3">
                                        <RadzenRow>
                                            <RadzenColumn Size="8">
                                                <strong class="text-danger">@hazard.Code</strong> - @(hazard.Name ?? "Unnamed Hazard")
                                                @if (!string.IsNullOrEmpty(hazard.Description))
                                                {
                                                    <div class="text-muted mt-1">
                                                        @(hazard.Description.Length > 100 ? hazard.Description[..97] + "..." : hazard.Description)
                                                    </div>
                                                }
                                            </RadzenColumn>
                                            <RadzenColumn Size="4">
                                                @if (hazard.HazardLocation is not null && hazard.HazardLocation.Latitude.HasValue && hazard.HazardLocation.Longitude.HasValue)
                                                {
                                                    <div class="text-center">
                                                       
                                                        <ReadOnlyLocationMap Latitude="@(hazard.HazardLocation.Latitude.Value)"
                                                                           Longitude="@(hazard.HazardLocation.Longitude.Value)"
                                                                           LocationDescription="@(hazard.HazardLocation.Description ?? hazard.Code)"
                                                                           MapHeight="200px"
                                                                           ShowZoomControls="false"
                                                                           ShowLocationDetails="false"
                                                                           ZoomLevel="16" />
                                                        <small class="text-muted d-block mt-1">
                                                            <i class="fas fa-map-marker-alt"></i> 
                                                            @hazard.HazardLocation.Latitude.Value.ToString("F6"), @hazard.HazardLocation.Longitude.Value.ToString("F6")
                                                        </small>
                                                        
                                                        <RadzenButton ButtonStyle="ButtonStyle.Base" 
                                                                    Size="ButtonSize.ExtraSmall"
                                                                    Text="View Map"
                                                                    Icon="map"
                                                                    Class="mt-2"
                                                                    Click="@(() => ViewHazardLocationMap(hazard))"
                                                                    title="Open full-size location map" />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-center text-muted">
                                                        <i class="fas fa-map-marker-alt fa-2x mb-2"></i>
                                                        <div>No location data available</div>
                                                        @if (!string.IsNullOrEmpty(hazard.LocationArea))
                                                        {
                                                            <small>@hazard.LocationArea</small>
                                                        }
                                                        
                                                    </div>
                                                }
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </RadzenCard>
                                </Template>
                            </RadzenDataList>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="fas fa-exclamation-triangle fa-2x mb-2"></i>
                            <div>No hazards associated with this report</div>
                        </div>
                    }
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end gap-2">
                        <RadzenButton ButtonStyle="ButtonStyle.Warning" 
                                    Text="Edit Report" 
                                    Icon="edit"
                                    Click="@(() => EditFromDetailsModal(SelectedReport))"
                                    Size="ButtonSize.Medium" />
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                    Text="Close" 
                                    Icon="close"
                                    Click="CloseDetailsModal"
                                    Size="ButtonSize.Medium" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Custom Reset Confirmation Modal -->
@if (_showResetConfirmModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog" style="max-width: 700px; width: 90%;">
            <div class="sms-modal-content">
                <div class="sms-modal-header" style="background-color: #dc3545; color: white;">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-exclamation-triangle"></i> Confirm Reset Report Validation
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                    Variant="Variant.Text"
                                    Icon="close"
                                    Size="ButtonSize.Small"
                                    Click="CancelResetConfirmation" 
                                    Style="color: white;" />
                    </div>
                </div>
                <div class="sms-modal-body" style="padding: 1.5rem;">
                    <div class="reset-confirmation-message">
                        @_resetConfirmationMessage
                    </div>
                    <div class="reset-warning-final">
                        @GetResetFinalWarning()
                    </div>
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end gap-2">
                        <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                    Text="Cancel" 
                                    Icon="close"
                                    Click="CancelResetConfirmation"
                                    Size="ButtonSize.Medium" />
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                    Text="Yes, Reset Report" 
                                    Icon="refresh"
                                    Click="HandleResetConfirmation"
                                    Size="ButtonSize.Medium"
                                    Disabled="@_isLoading" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (_showDescriptionModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-md">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-file-alt"></i> Report Description - @_selectedReportId
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Text"
                                      Icon="close"
                                      Size="ButtonSize.Small"
                                      Click="@CloseDescriptionModal" />
                    </div>
                </div>
                <div class="sms-modal-body">
                    <RadzenCard Variant="Variant.Outlined">
                        <div class="p-3">
                            <div style="line-height: 1.6; white-space: normal;">
                                @((MarkupString)(_selectedDescription ?? "No description available"))
                            </div>
                        </div>
                    </RadzenCard>
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end">
                        <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                      Text="Close"
                                      Icon="close"
                                      Click="@CloseDescriptionModal"
                                      Size="ButtonSize.Medium" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
.sms-modal-xxl {
    max-width: 1400px;
    width: 95%;
}

.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
    padding: 1rem;
}

.sms-modal-dialog {
    position: relative;
    margin: 0 auto;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
}

    .sms-modal-md {
        max-width: 700px;
        width: 100%;
    }
.sms-modal-content {
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
}

.sms-modal-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e9ecef;
    border-radius: 0.5rem 0.5rem 0 0;
}

.sms-header-primary {
    background-color: #212e61; /* SMS Blue Dark Bold */
    color: white;
}

.sms-modal-title {
    margin: 0;
    font-weight: 600;
}

.sms-modal-body {
    max-height: calc(100vh - 200px);
    overflow-y: auto;
}

.sms-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid #e9ecef;
    border-radius: 0 0 0.5rem 0.5rem;
}

/* Enhanced styles for reset confirmation modal */
.reset-confirmation-message {
    white-space: pre-wrap;
    line-height: 1.6;
    font-size: 14px;
    font-family: 'Segoe UI', system-ui, sans-serif;
}

.reset-warning-final {
    text-align: center;
    font-weight: bold;
    color: #dc3545;
    font-size: 16px;
    margin-top: 1rem;
    padding: 0.75rem;
    background-color: #f8d7da;
    border: 1px solid #f5c6cb;
    border-radius: 0.25rem;
}
</style>
