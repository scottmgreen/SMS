@page "/SMSListings/ReportCalendar"
@using SMS3.Components.Pages.SMSListings.Models
@using SMS3.Components.Shared
@using SMS_Application.Messaging.Queries
@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using Radzen
@using Radzen.Blazor

<PageTitle>Report Calendar - SMS3</PageTitle>

<!-- SMS Page Header -->
<PageHeader Title="Report Calendar"
           Subtitle="View reports by date using an interactive calendar scheduler"
           Icon="fas fa-calendar-alt">
    @* <AdditionalContent>
        <div class="d-flex gap-2">
            <RadzenButton ButtonStyle="ButtonStyle.Light" 
                         Text="Today" 
                         Icon="today"
                         Click="@GoToToday"
                         Size="ButtonSize.Small" />
            <RadzenButton ButtonStyle="ButtonStyle.Info" 
                         Text="Refresh" 
                         Icon="refresh"
                         Click="@RefreshData"
                         Size="ButtonSize.Small" />
        </div>
    </AdditionalContent> *@
</PageHeader>

<!-- Calendar Scheduler -->
<RadzenRow Gap="1rem">
    <RadzenColumn Size="12">
        <RadzenCard>
            @if (IsLoading)
            {
                <div class="d-flex justify-content-center align-items-center" style="height: 400px;">
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
                </div>
            }
            else
            {
                <!-- Scheduler Component -->
                <RadzenScheduler @ref="scheduler" 
                                TItem="ReportSchedulerItem" 
                                Data="@SchedulerData"
                                Class="report-scheduler"
                                StartProperty="@nameof(ReportSchedulerItem.Start)"
                                EndProperty="@nameof(ReportSchedulerItem.End)"
                                TextProperty="@nameof(ReportSchedulerItem.Text)"
                                SelectedIndex="2"
                                SlotSelect="@OnSlotSelect"
                                AppointmentSelect="@OnAppointmentSelect"
                                AppointmentRender="@OnAppointmentRender"
                                SlotRender="@OnSlotRender"
                                 Style="width: 100%;height:800px">
                    
                    <!-- Custom Views -->
                    <RadzenDayView />
                    <RadzenWeekView />
                    <RadzenMonthView />
                    <RadzenYearView />
                    
                </RadzenScheduler>
            }
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>



<style>
    .report-scheduler .rz-scheduler-appointment {
        border-radius: 4px;
        font-size: 0.875rem;
        font-weight: 700 !important;
        color:darkblue;
    }
    
    
    
    .report-scheduler .rz-scheduler-appointment.report-hazard {
        background-color: var(--rz-primary);
        border-color: var(--rz-primary);
    }
    
    
    
</style>
