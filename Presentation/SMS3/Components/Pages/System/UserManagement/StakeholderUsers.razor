@page "/System/UserManagement/StakeholderUsers"
@using SMS_Application.Messaging.Commands
@using SMS_Application.Messaging.Queries
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS3.Components.Shared
@using Radzen
@using Radzen.Blazor

<PageTitle>Stakeholder User Management - SMS3</PageTitle>
<PageHeader Title="Application User Management"
            Subtitle="@($"Manage SMS Stakeholder Users ({@StakeholderUsersList.Count()})")"
            Icon="fas fa-user-tie">
</PageHeader>
<div class="container-fluid">
    <!-- Messages -->
    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <RadzenRow Gap="1rem" class="rz-mb-3">
            <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenIcon Icon="check_circle" Style="margin-right: 0.5rem;" />
                    @SuccessMessage
                </RadzenAlert>
            </RadzenColumn>
        </RadzenRow>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <RadzenRow Gap="1rem" class="rz-mb-3">
            <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenIcon Icon="error" Style="margin-right: 0.5rem;" />
                    @ErrorMessage
                </RadzenAlert>
            </RadzenColumn>
        </RadzenRow>
    }

    <!-- Users DataGrid -->
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenCard>
                    <div class="d-flex justify-content-end align-items-center w-100">
                        <div class="d-flex gap-2">
                            <RadzenButton Text="Add User" Icon="add" ButtonStyle="ButtonStyle.Success"
                                          Click="@ShowCreateDialog" />
                        </div>
                    </div>
                </RadzenCard>
                <RadzenCard>
                    @if (StakeholderUsersList.Any())
                    {
                        <RadzenDataGrid @ref="usersGrid" Data="@StakeholderUsersList" TItem="SMSStakeholderUser" 
                                      AllowFiltering="true" AllowSorting="true" AllowPaging="true" 
                                      PageSize="10" ShowPagingSummary="true" 
                                      FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                            <Columns>
                                <RadzenDataGridColumn TItem="SMSStakeholderUser" Property="Code" Title="User ID" Width="75px" Sortable="true" Filterable="true">
                                    <Template Context="user">
                                        <div class="d-flex align-items-center">
                                            <strong>@user.Code</strong>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="SMSStakeholderUser" Property="DisplayName" Title="User" Width="150px" Sortable="true" Filterable="true">
                                    <Template Context="user">
                                        <div class="d-flex align-items-center">
                                            <div>
                                                <div><strong>@user.DisplayName</strong></div>
                                                <small style="color: var(--rz-text-secondary-color);">@user.UserName?.Value</small>
                                            </div>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SMSStakeholderUser" Property="UserRole" Title="SMS Role/Permissions" Width="140px" Sortable="false">
                                    <Template Context="user">
                                        @if (user.UserRole != null)
                                        {
                                            @user.UserRole.Name
                                        }
                                        else
                                        {
                                            <RadzenBadge Variant="Variant.Filled" BadgeStyle="BadgeStyle.Light" Text="No Role Assigned" />
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SMSStakeholderUser" Property="Organization" Title="Organization" Width="200px" >
                                    <Template Context="user">
                                        @user.Organization.ToUpper()
                                    </Template>
                                    </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SMSStakeholderUser" Property="StakeholderType" Title="Type" Width="120px">
                                    <Template Context="user">
                                        @GetStakeholderTypeDisplay(user.StakeholderType).ToUpper()
                                    </Template>
                                </RadzenDataGridColumn>
                                
                                
                                <RadzenDataGridColumn TItem="SMSStakeholderUser" Property="IsPOPEmployee" Title="POP Employee" Width="100px">
                                    <Template Context="user">
                                        <RadzenIcon Icon="@(user.IsPOPEmployee ? "check_box" : "check_box_outline_blank")"
                                                    Style="@(user.IsPOPEmployee ? "color: var(--rz-success);" : "color: var(--rz-text-disabled-color);")" />
                                    </Template>
                                </RadzenDataGridColumn>
                                                               
                                <RadzenDataGridColumn TItem="SMSStakeholderUser" Property="IsActive" Title="Active" Width="75px">
                                    <Template Context="user">
                                        <RadzenIcon Icon="@(user.IsActive ? "check_box" : "check_box_outline_blank")"
                                                    Style="@(user.IsActive ? "color: var(--rz-success);" : "color: var(--rz-danger);")" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SMSStakeholderUser" Title="Actions" Width="120px" Sortable="false" Filterable="false">
                                    <Template Context="user">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" 
                                                        Click="@(() => ShowEditDialog(user))" 
                                                        title="Edit User" />
                                            <RadzenButton Icon="admin_panel_settings" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" 
                                                        Click="@(() => ShowRoleDialog(user.Code, user.DisplayName, user.UserRole?.Code))" 
                                                        title="Assign Role" />
                                            <RadzenButton Icon="group" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                                        Click="@(() => ManageGroups(user.Code, user.DisplayName))" title="Manage Groups" />
                                            <RadzenButton Icon="lock" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" 
                                                        Click="@(() => OpenPasswordChangeModal(user.Code, user.DisplayName))" 
                                                        title="Change Password" />
                                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" 
                                                        Click="@(() => ShowDeleteDialog(user.Code, user.DisplayName))" 
                                                        title="Delete User" />
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                    else
                    {
                        <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 3rem;">
                            <RadzenIcon Icon="handshake" Style="font-size: 4rem; color: var(--rz-text-disabled-color);" />
                            <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-text-disabled-color);">
                                No Stakeholder Users Found
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-disabled-color);">
                                Click "Add User" to create your first stakeholder user.
                            </RadzenText>
                            <RadzenButton Text="Add First User" Icon="add" ButtonStyle="ButtonStyle.Info" 
                                        Click="@ShowCreateDialog" />
                        </RadzenStack>
                    }
                </RadzenCard>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</div>

<!-- Shared Password Change Modal -->
<PasswordChangeDialog IsVisible="@ShowPasswordModal" 
                    UserCode="@PasswordUserCode" 
                    UserDisplayName="@PasswordUserDisplayName" 
                    UserType="Stakeholder"
                    OnPasswordChanged="@OnPasswordChangedSuccess" 
                    OnCancel="@ClosePasswordChangeModal" />

<!-- Create User Modal -->
@if (ShowCreateModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-lg">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <h5 class="sms-modal-title">
                        <i class="fas fa-user-plus"></i> Create Stakeholder User
                    </h5>
                </div>
                <div class="sms-modal-body">
                    <RadzenTemplateForm Data="@NewUser" Submit="@((CreateStakeholderUserModel model) => CreateUser())">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="First Name *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width:100%;min-width:100%">
                                    <RadzenTextBox @bind-Value="@NewUser.FirstName" Name="FirstName" 
                                                   Placeholder="Enter first name" 
                                                   Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="FirstName" Text="First name is required" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Last Name *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width:100%;min-width:100%">
                                    <RadzenTextBox @bind-Value="@NewUser.LastName" Name="LastName" 
                                                   Placeholder="Enter last name" 
                                                   Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="LastName" Text="Last name is required" />
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Username *" Variant="Variant.Outlined">
                                    <RadzenTextBox @bind-Value="@NewUser.UserName" Name="UserName" 
                                                   Placeholder="Enter username" 
                                                   Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="UserName" Text="Username is required" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Password *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width:100%;min-width:100%">
                                    <RadzenPassword @bind-Value="@NewUser.Password" Name="Password" 
                                                    Placeholder="Enter password" 
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="Password" Text="Password is required" />
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Stakeholder Type *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width:100%;min-width:100%">
                                    <RadzenDropDown @bind-Value="@NewUser.StakeholderType" Data="@StakeholderTypesForDropdown" Name="StakeholderType"
                                                    ValueProperty="Value" TextProperty="Text" Placeholder="-- Select Type --" 
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="StakeholderType" Text="Stakeholder type is required" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Organization *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width:100%;min-width:100%">
                                    <RadzenTextBox @bind-Value="@NewUser.Organization" Name="Organization" 
                                                   Placeholder="Enter organization" 
                                                   Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="Organization" Text="Organization is required" />
                            </RadzenColumn>
                        </RadzenRow>

                        
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="SMS User Role/Permissions (Optional)" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width:100%;min-width:100%">
                                    <RadzenDropDown @bind-Value="@NewUser.UserRoleCode" Data="@UserRoles"
                                                        ValueProperty="Code" TextProperty="Name"
                                                        Placeholder="-- No Role Assigned --" AllowClear="true"
                                                        Style="width: 100%;" />
                                    </RadzenFormField>
                                    <RadzenText TextStyle="TextStyle.Caption">Assign an SMS user role to define permissions and access levels</RadzenText>
                                </RadzenColumn>


                            </RadzenRow>
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="12">
                                    <RadzenFormField Text="Is POP Employee" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                    <RadzenDropDown @bind-Value="@NewUser.IsPOPEmployee" Data="@IsPOPEmployeeOptions"
                                                        TextProperty="Text" ValueProperty="Value"
                                                        Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Status" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                    <RadzenDropDown @bind-Value="@NewUser.IsActive" Data="@IsActiveOptions"
                                                        TextProperty="Text" ValueProperty="Value"
                                                        Style="width: 100%;" />
                                    </RadzenFormField>
                                </RadzenColumn>
                            </RadzenRow>
                        
                    </RadzenTemplateForm>
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        @* <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" Style="margin: 0;">
                            <RadzenIcon Icon="info" Style="margin-right: 0.5rem;" />
                            Stakeholder users are external partners with role-based access to SMS collaborative functions.
                        </RadzenAlert> *@
                        <div class="d-flex gap-2">
                            <RadzenButton Text="Cancel" Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseCreateModal" />
                            <RadzenButton Text="Create User" Icon="save" ButtonStyle="ButtonStyle.Primary" 
                                          Click="@CreateUser" Disabled="@(!IsCreateFormValid || IsSaving)"
                                          Style="background-color: #212e61; border-color: #212e61;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Edit User Modal -->
@if (ShowEditModal && CurrentEditUser != null)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-lg">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <h5 class="sms-modal-title">
                        <i class="fas fa-edit"></i> Edit Stakeholder User: @CurrentEditUser.DisplayName
                    </h5>
                </div>
                <div class="sms-modal-body">
                    <RadzenTemplateForm Data="@editUser" Submit="@((EditStakeholderUserModel model) => UpdateUser())">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="First Name *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width:100%;min-width:100%">
                                    <RadzenTextBox @bind-Value="@editUser.FirstName" Name="FirstName" 
                                                   Placeholder="Enter first name" 
                                                   Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="FirstName" Text="First name is required" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Last Name *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width:100%;min-width:100%">
                                    <RadzenTextBox @bind-Value="@editUser.LastName" Name="LastName" 
                                                   Placeholder="Enter last name" 
                                                   Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="LastName" Text="Last name is required" />
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Stakeholder Type *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width:100%;min-width:100%">
                                    <RadzenDropDown @bind-Value="@editUser.StakeholderType" Data="@StakeholderTypesForDropdown" Name="StakeholderType"
                                                    ValueProperty="Value" TextProperty="Text" Placeholder="-- Select Type --" 
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="StakeholderType" Text="Stakeholder type is required" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Organization *" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width:100%;min-width:100%">
                                    <RadzenTextBox @bind-Value="@editUser.Organization" Name="Organization" 
                                                   Placeholder="Enter organization" 
                                                   Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="Organization" Text="Organization is required" />
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="SMS User Role/Permissions (Optional)" Variant="Variant.Outlined" AllowFloatingLabel="false" Style="width:100%;min-width:100%">
                                    <RadzenDropDown @bind-Value="@editUser.UserRoleCode" Data="@UserRoles" 
                                                  ValueProperty="Code" TextProperty="Name" 
                                                  Placeholder="-- No Role Assigned --" AllowClear="true" 
                                                  Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenText TextStyle="TextStyle.Caption">Assign an SMS user role to define permissions and access levels</RadzenText>
                            </RadzenColumn>
                            
                            
                        </RadzenRow>
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="12">
                                <RadzenFormField Text="Is POP Employee" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                    <RadzenDropDown @bind-Value="@editUser.IsPOPEmployee" Data="@IsPOPEmployeeOptions"
                                                    TextProperty="Text" ValueProperty="Value"
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Status" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                    <RadzenDropDown @bind-Value="@editUser.IsActive" Data="@IsActiveOptions"
                                                    TextProperty="Text" ValueProperty="Value"
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTemplateForm>
                    

                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end align-items-center w-100">
                        <div class="d-flex gap-2">
                            <RadzenButton Text="Cancel" Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseEditModal" />
                            <RadzenButton Text="Update User" Icon="save" ButtonStyle="ButtonStyle.Warning" 
                                          Click="@UpdateUser" Disabled="@(!IsEditFormValid || IsSaving)"
                                          Style="background-color: #f39c12; border-color: #f39c12;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Role Assignment Modal -->
@if (ShowRoleModal && !string.IsNullOrEmpty(RoleUserCode))
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-lg">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <h5 class="sms-modal-title">
                        <i class="fas fa-user-shield"></i> Assign User Role: @RoleUserDisplayName
                    </h5>
                </div>
                <div class="sms-modal-body">
                  @*   <RadzenFormField Text="Select Role" Variant="Variant.Outlined" AllowFloatingLabel="false">
                        <RadzenDropDown @bind-Value="@CurrentRoleCode" Data="@UserRoles" 
                                      ValueProperty="Code" TextProperty="Name" 
                                      Placeholder="-- Remove Role Assignment --" AllowClear="true" 
                                      Style="width: 100%;" />
                    </RadzenFormField>
                    <br />
                    <RadzenText TextStyle="TextStyle.Caption" Style="margin-top: 0.5rem;">
                        Select a role to assign permissions and access levels, or clear to remove role assignment.
                    </RadzenText> *@
                    
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Current Role" Variant="Variant.Outlined">
                                <RadzenTextBox Value="@(RoleUserDisplayName ?? "No role assigned")"
                                               ReadOnly="true"
                                               Style="background-color: #f8f9fa;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Select Role" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@CurrentRoleCode"
                                                Data="@UserRoles"
                                                TextProperty="Name"
                                                ValueProperty="Code"
                                                Placeholder="Select a role..."
                                                AllowClear="true"
                                                Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>
                   @*  @if (!string.IsNullOrEmpty(CurrentRoleCode))
                    {
                        var selectedRole = UserRoles.FirstOrDefault(r => r.Code == CurrentRoleCode);
                        if (selectedRole != null)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" class="rz-mt-3">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; font-weight: 600;">
                                        Selected Role: @selectedRole.Name
                                    </RadzenText>
                                    @if (selectedRole.Permissions?.Any() == true)
                                    {
                                        var totalPermissions = selectedRole.Permissions.Sum(p => (p.Create ? 1 : 0) + (p.Read ? 1 : 0) + (p.Update ? 1 : 0) + (p.Delete ? 1 : 0));
                                        var maxPermissions = 20; // 5 modules × 4 permissions
                                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                                            This role grants @totalPermissions of @maxPermissions possible permissions.
                                        </RadzenText>
                                    }
                                </RadzenStack>
                            </RadzenAlert>
                        }
                    }
       *@         
                        @if (!string.IsNullOrEmpty(CurrentRoleCode))
                    {
                        var selectedRole = UserRoles.FirstOrDefault(r => r.Code == CurrentRoleCode);
                        @if (selectedRole.Permissions?.Any() == true)
                        {
                            <RadzenDataGrid Data="@SMSModules" TItem="string" AllowPaging="false" class="permission-view-grid">
                                <Columns>
                                    <RadzenDataGridColumn TItem="string" Title="Module" Width="30%">
                                        <Template Context="module">
                                            <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 600;">@module</RadzenText>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="string" Title="Create" Width="17.5%">
                                        <Template Context="module">
                                            <div class="text-center">
                                                @if (IsPermissionGranted(selectedRole, module, "Create"))
                                                {
                                                    <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                    <div><small class="text-success">Granted</small></div>
                                                }
                                                else
                                                {
                                                    <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                    <div><small class="text-muted">Denied</small></div>
                                                }
                                            </div>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="string" Title="Read" Width="17.5%">
                                        <Template Context="module">
                                            <div class="text-center">
                                                @if (IsPermissionGranted(selectedRole, module, "Read"))
                                                {
                                                    <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                    <div><small class="text-success">Granted</small></div>
                                                }
                                                else
                                                {
                                                    <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                    <div><small class="text-muted">Denied</small></div>
                                                }
                                            </div>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="string" Title="Update" Width="17.5%">
                                        <Template Context="module">
                                            <div class="text-center">
                                                @if (IsPermissionGranted(selectedRole, module, "Update"))
                                                {
                                                    <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                    <div><small class="text-success">Granted</small></div>
                                                }
                                                else
                                                {
                                                    <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                    <div><small class="text-muted">Denied</small></div>
                                                }
                                            </div>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="string" Title="Delete" Width="17.5%">
                                        <Template Context="module">
                                            <div class="text-center">
                                                @if (IsPermissionGranted(selectedRole, module, "Delete"))
                                                {
                                                    <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                    <div><small class="text-success">Granted</small></div>
                                                }
                                                else
                                                {
                                                    <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                    <div><small class="text-muted">Denied</small></div>
                                                }
                                            </div>
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>

                        }
                        else
                        {

                        }

                    }
                
                
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end align-items-center w-100">
                        <div class="d-flex gap-2">
                            <RadzenButton Text="Cancel" Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseRoleModal" />
                            <RadzenButton Text="Assign Role" Icon="save" ButtonStyle="ButtonStyle.Success" 
                                          Click="@(() => AssignRoleFromModal(CurrentRoleCode))"
                                          Style="background-color: #28a745; border-color: #28a745;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Group Management Modal -->
@if (ShowGroupsModal && !string.IsNullOrEmpty(GroupManagementUserCode))
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog modal-xl">
            <div class="sms-modal-content">
                <!-- Modal Header -->
                <div class="sms-modal-header sms-header-primary">
                    <h5 class="sms-modal-title">
                        <i class="fas fa-users"></i> Manage Groups: @GroupManagementUserDisplayName
                    </h5>
                </div>
                
                <!-- Modal Body -->
                <RadzenRow Gap="1rem" Style="height: 500px;">
                    <!-- Current User Groups -->
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenCard Style="height: 100%;">
                            <RadzenCard Style="background-color: #e8f5e8; margin: -0.5rem -0.5rem 1rem -0.5rem; padding: 0.5rem;">
                                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: #28a745;">
                                    <RadzenIcon Icon="groups" Style="margin-right: 0.5rem;" />
                                    Current Groups (@UserCurrentGroups.Count)
                                </RadzenText>
                            </RadzenCard>
                            <div style="height: 400px; overflow-y: auto;">
                                @if (UserCurrentGroups.Any())
                                {
                                    @foreach (var group in UserCurrentGroups.OrderBy(g => g.Name))
                                    {
                                        <RadzenCard class="mb-2" Style="background-color: #f8f9fa;">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0;">
                                                        @group.Name
                                                    </RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                        @group.Code
                                                    </RadzenText>
                                                    @if (!string.IsNullOrEmpty(group.Description))
                                                    {
                                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                            @group.Description
                                                        </RadzenText>
                                                    }
                                                </div>
                                                <RadzenButton Icon="group_remove" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                              Click="@(() => RemoveUserFromGroup(group.Code))" title="Remove from group" />
                                            </div>
                                        </RadzenCard>
                                    }
                                }
                                else
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
                                        <RadzenIcon Icon="info" Style="margin-right: 0.5rem;" />
                                        This user is not currently assigned to any stakeholder groups.
                                    </RadzenAlert>
                                }
                            </div>
                        </RadzenCard>
                    </RadzenColumn>

                    <!-- Available Groups -->
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenCard Style="height: 100%;">
                            <RadzenCard Style="background-color: #e3f2fd; margin: -0.5rem -0.5rem 1rem -0.5rem; padding: 0.5rem;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: #007bff;">
                                        <RadzenIcon Icon="group_add" Style="margin-right: 0.5rem;" />
                                        Available Groups (@AvailableGroups.Count)
                                    </RadzenText>
                                    <RadzenButton Text="Assign Selected" Icon="group_add" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                                  Click="@AssignMultipleGroups" Disabled="@(!SelectedGroups.Any(s => s.Value))" />
                                </div>
                            </RadzenCard>
                            <div style="height: 400px; overflow-y: auto;">
                                @if (AvailableGroups.Any())
                                {
                                    @foreach (var group in AvailableGroups.OrderBy(g => g.Name))
                                    {
                                        <RadzenCard class="mb-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="d-flex align-items-center">
                                                    <RadzenCheckBox @bind-Value="SelectedGroups[group.Code]" class="me-2" />
                                                    <div>
                                                        <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0;">
                                                            @group.Name
                                                        </RadzenText>
                                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                            @group.Code
                                                        </RadzenText>
                                                        @if (!string.IsNullOrEmpty(group.Description))
                                                        {
                                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                                @group.Description
                                                            </RadzenText>
                                                        }
                                                    </div>
                                                </div>
                                                <RadzenButton Icon="group_add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                                              Click="@(() => AssignUserToGroup(group.Code))" title="Assign to group" />
                                            </div>
                                        </RadzenCard>
                                    }
                                }
                                else
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
                                        <RadzenIcon Icon="warning" Style="margin-right: 0.5rem;" />
                                        This user is already assigned to all available stakeholder groups.
                                    </RadzenAlert>
                                }
                            </div>
                        </RadzenCard>
                    </RadzenColumn>
                </RadzenRow>

                <!-- Modal Footer -->
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end align-items-center">
                        <div class="d-flex gap-2">
                            <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" Click="@CloseGroupsModal" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
/* Modal Overlay and Dialog */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
    padding: 1rem;
}

.sms-modal-dialog {
    position: relative;
    margin: 0 auto;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
}

.sms-modal-lg {
    max-width: 600px;
    width: 100%;
}

.modal-xl {
    max-width: 1200px;
    width: 100%;
}

.sms-modal-content {
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
}

.sms-modal-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e9ecef;
    border-radius: 0.5rem 0.5rem 0 0;
}

.sms-header-primary {
    background-color: #212e61; /* SMS Blue Dark Bold */
    color: white;
}

.sms-modal-title {
    margin: 0;
    font-weight: 600;
}

.sms-modal-body {
    padding: 1.5rem;
}

.sms-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid #e9ecef;
    border-radius: 0 0 0.5rem 0.5rem;
    background-color: #f8f9fa;
}
</style>