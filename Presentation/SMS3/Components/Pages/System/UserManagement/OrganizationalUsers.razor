@page "/System/UserManagement/OrganizationalUsers"
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS_Domain.Entities
@using SMS_Domain.Enums

<PageTitle>Organizational User Management - SMS3</PageTitle>

<!-- SMS Page Header -->
<PageHeader Title="Organizational User Management"
            Subtitle="@($"Manage SMS Organizational Users ({@OrganizationalUsersList.Count()})")"
           Icon="fas fa-user-tie">

           <AdditionalContent>
                <div class="d-flex justify-content-end align-items-center w-100">
                    <div class="d-flex gap-2">
                        <RadzenButton Text="Add User" Icon="add" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                      Click="@OpenCreateModal" />
                    </div>
                </div>
           </AdditionalContent>
</PageHeader>

<!-- Success/Error Messages -->
@if (!string.IsNullOrEmpty(SuccessMessage))
{
    <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter" class="mb-3">
        <RadzenIcon Icon="check_circle" Style="margin-right: 0.5rem;" />
        @SuccessMessage
    </RadzenAlert>
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" class="mb-3">
        <RadzenIcon Icon="error" Style="margin-right: 0.5rem;" />
        @ErrorMessage
    </RadzenAlert>
}

<!-- Users Display -->
<RadzenCard>
    <RadzenCard>
        @if (OrganizationalUsersList.Any())
        {
            <RadzenDataGrid @ref="usersGrid" Data="@OrganizationalUsersList" TItem="SMSOrganizationalUser" 
                            AllowFiltering="true" AllowColumnResize="true" AllowSorting="true" 
                            PageSize="10" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" 
                            ShowPagingSummary="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                
                <Columns>
                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="Code" Title="User ID" Width="75px" Sortable="true" Filterable="true">
                        <Template Context="user">
                            <div class="d-flex align-items-center">
                                <strong>@user.Code</strong>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    
                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="DisplayName" Title="User" Width="120px" Sortable="true" Filterable="true">
                        <Template Context="user">
                            <div class="d-flex align-items-center">
                                <div>
                                    <div><strong>@user.DisplayName</strong></div>
                                    <small style="color: var(--rz-text-secondary-color);">@user.UserName?.Value</small>
                                </div>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="Department" Title="Department" Width="150px" Sortable="true" Filterable="true">
                        <Template Context="user">
                            @user.Department.Name.ToUpper()
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="Position" Title="Position" Width="125px" Sortable="true" Filterable="true">
                        <Template Context="user">
                            @if (!string.IsNullOrEmpty(user.Position))
                            {
                                <span>@user.Position</span>
                            }
                            else
                            {
                                <em style="color: var(--rz-text-secondary-color);">No position</em>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="OrganizationLevel" Title="SMS Organization Level" Width="250px" Sortable="true" Filterable="true">
                        <Template Context="user">
                            @if (user.OrganizationLevel !=null)
                            {
                                @GetOrganizationLevelDisplayText(user.OrganizationLevel.Name).ToUpper() 
                            }
                            else
                            {
                                <em style="color: var(--rz-text-secondary-color);">No SMS role</em>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="TwoFactorEnabled" Title="2FA Required" Width="120px">
                        <Template Context="user">
                            <RadzenIcon Icon="@(user.TwoFactorEnabled ? "check_box" : "check_box_outline_blank")"
                                        Style="@(user.TwoFactorEnabled ? "color: var(--rz-success);" : "color: var(--rz-danger);")" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Property="IsActive" Title="Active" Width="75px" Sortable="true" Filterable="true">
                        <Template Context="user">
                            <RadzenIcon Icon="@(user.IsActive ? "check_box" : "check_box_outline_blank")"
                                        Style="@(user.IsActive ? "color: var(--rz-success);" : "color: var(--rz-danger);")" />
                        </Template>
                    </RadzenDataGridColumn>

                    
                    <RadzenDataGridColumn TItem="SMSOrganizationalUser" Title="Actions" Width="200px" Sortable="false" Filterable="false">
                        <Template Context="user">
                            <div class="d-flex gap-1">
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => EditUser(user.Code))" title="Edit User" />
                                <RadzenButton Icon="vpn_key" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => OpenPasswordModal(user.Code, user.DisplayName))" title="Change Password" />
                                <RadzenButton Icon="group" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => ManageGroups(user.Code, user.DisplayName))" title="Manage Groups" />
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => ConfirmDelete(user.Code, user.DisplayName))" title="Delete User" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else
        {
            <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 3rem;">
                <RadzenIcon Icon="corporate_fare" Style="font-size: 4rem; color: var(--rz-text-disabled-color);" />
                <RadzenText TextStyle="TextStyle.H5" Style="color: var(--rz-text-disabled-color);">
                    No Organizational Users Found
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-disabled-color);">
                    Click "Add User" to create your first organizational user.
                </RadzenText>
                <RadzenButton Text="Add First User" Icon="add" ButtonStyle="ButtonStyle.Success"
                              Click="@OpenCreateModal" />
            </RadzenStack>
        }
    </RadzenCard>
</RadzenCard>

<!-- Create User Modal -->
@if (ShowCreateModal)
{
    <div class="modal-backdrop">
        <div class="modal-dialog modal-lg">
            <RadzenCard class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header" style="background-color: #212e61; color: white; padding: 1rem; margin: -1rem -1rem 1rem -1rem; border-radius: 6px 6px 0 0;">
                    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: white;">
                        <RadzenIcon Icon="person_add" Style="margin-right: 0.5rem;" />
                        Create Organizational User
                    </RadzenText>
                </div>
                
                <!-- Modal Body -->
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Gap="1rem">
                            <RadzenFormField Text="First Name *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                <RadzenTextBox @bind-Value="@NewFirstName" 
                                               Placeholder="Enter first name" 
                                               Style="width: 100%;" />
                            </RadzenFormField>

                            <RadzenFormField Text="Last Name *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                <RadzenTextBox @bind-Value="@NewLastName" 
                                               Placeholder="Enter last name" 
                                               Style="width: 100%;" />
                            </RadzenFormField>
                            
                            <RadzenFormField Text="Username *" Variant="Variant.Outlined"AllowFloatingLabel="false" >
                                <RadzenTextBox @bind-Value="@NewUserName" 
                                               Placeholder="Enter username" 
                                               Style="width: 100%;" />
                            </RadzenFormField>

                            <RadzenFormField Text="Password *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                <RadzenPassword @bind-Value="@NewPassword" 
                                               Placeholder="Enter password" 
                                               Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Gap="1rem">
                            <RadzenFormField Text="Department *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                <RadzenDropDown @bind-Value="@NewDepartmentId" Data="@DepartmentOptions" 
                                                TextProperty="Text" ValueProperty="Value" 
                                                Style="width: 100%;" Placeholder="Select department"/>
                            </RadzenFormField>

                            <RadzenFormField Text="Position" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                <RadzenTextBox @bind-Value="@NewPosition" 
                                               Placeholder="Enter position/title" 
                                               Style="width: 100%;" />
                            </RadzenFormField>

                            <RadzenFormField Text="SMS Organization Level" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                <RadzenDropDown @bind-Value="@NewOrganizationLevelId" Data="@OrganizationLevelOptions"
                                                TextProperty="Text" ValueProperty="Value"
                                                Style="width: 100%;" Placeholder="Select SMS organizational role"
                                                title="Select the Organization Level that determines authority and approval permissions" />
                            </RadzenFormField>

                            
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
                
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12">
                        <RadzenFormField Text="Two-Factor Authentication" Variant="Variant.Outlined">
                            <div class="d-flex align-items-center p-2">
                                <RadzenCheckBox @bind-Value="@NewTwoFactorEnabled" Name="NewTwoFactorEnabled" />
                                <RadzenLabel Text="Require 2FA" Component="NewTwoFactorEnabled" Style="margin-left: 0.5rem; cursor: pointer;" />
                            </div>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                                
                <!-- Modal Footer -->
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseCreateModal" />
                    <RadzenButton Text="Create User" Icon="save" ButtonStyle="ButtonStyle.Primary" 
                                  Click="@CreateUser" Disabled="@(!IsCreateFormValid || IsSaving)"
                                  Style="background-color: #212e61; border-color: #212e61;" />
                </div>
            </RadzenCard>
        </div>
    </div>
}

<!-- Edit User Modal -->
@if (ShowEditModal && CurrentUser != null)
{
    <div class="modal-backdrop">
        <div class="modal-dialog modal-lg">
            <RadzenCard class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header" style="background-color: #212e61; color: white; padding: 1rem; margin: -1rem -1rem 1rem -1rem; border-radius: 6px 6px 0 0;">
                    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: white;">
                        <RadzenIcon Icon="edit" Style="margin-right: 0.5rem;" />
                        Edit Organizational User
                    </RadzenText>
                </div>
                
                <!-- Modal Body -->
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Gap="1rem">
                            <RadzenFormField Text="User Code" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                <RadzenTextBox Value="@CurrentUser.Code" ReadOnly="true" 
                                               Style="width: 100%; background-color: #f8f9fa;" />
                            </RadzenFormField>

                            <RadzenFormField Text="First Name *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                <RadzenTextBox @bind-Value="@EditFirstName" 
                                               Placeholder="Enter first name" 
                                               Style="width: 100%;" />
                            </RadzenFormField>
                            <RadzenFormField Text="Department *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                <RadzenDropDown @bind-Value="@EditDepartmentId" Data="@DepartmentOptions"
                                                TextProperty="Text" ValueProperty="Value"
                                                Style="width: 100%;" />
                            </RadzenFormField>

                            <RadzenFormField Text="SMS Organization Level" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                <RadzenDropDown @bind-Value="@EditOrganizationLevelId" Data="@OrganizationLevelOptions"
                                                TextProperty="Text" ValueProperty="Value"
                                                Style="width: 100%;"
                                                title="Select the SMS role that determines authority and approval permissions" />
                            </RadzenFormField>

                           <RadzenFormField Text="SMS Role" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                <RadzenDropDown @bind-Value="@EditSMSUserRoleId" Data="@SMSRoleOptions"
                                                TextProperty="Text" ValueProperty="Value"
                                                Style="width: 100%;" Placeholder="Select SMS role (optional)" />
                            </RadzenFormField> 

                            
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenStack Gap="1rem">
                            <RadzenFormField Text="Username" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                <RadzenTextBox Value="@CurrentUser.UserName?.Value" ReadOnly="true"
                                               Style="width: 100%; background-color: #f8f9fa;" />
                            </RadzenFormField>
                            <RadzenFormField Text="Last Name *" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                <RadzenTextBox @bind-Value="@EditLastName"
                                               Placeholder="Enter last name"
                                               Style="width: 100%;" />
                            </RadzenFormField>
                            <RadzenFormField Text="Position" Variant="Variant.Outlined">
                                <RadzenTextBox @bind-Value="@EditPosition"
                                               Placeholder="Enter position/title"
                                               Style="width: 100%;" />
                            </RadzenFormField>
                            
                            
                            
                            
                           
                            @* <RadzenFormField Text="Status" Variant="Variant.Outlined" AllowFloatingLabel="false">
                                <RadzenDropDown @bind-Value="@EditIsActive" Data="@ActiveInactiveStatusOptions" 
                                                TextProperty="Text" ValueProperty="Value" 
                                                Style="width: 100%;" />
                            </RadzenFormField> *@
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Require 2FA" Variant="Variant.Outlined">
                            <div class="d-flex align-items-center p-2">
                                <RadzenCheckBox @bind-Value="@EditTwoFactorEnabled" Name="TwoFactorEnabled" />
                                <RadzenLabel Text="Require 2FA" Component="TwoFactorEnabled" Style="width:120px;margin-left: 0.5rem; cursor: pointer;" />
                            </div>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Active" Variant="Variant.Outlined">
                            <div class="d-flex align-items-center p-2">
                                <RadzenCheckBox @bind-Value="@EditIsActive" Name="IsActive" />
                                <RadzenLabel Text="Active" Component="IsActive" Style="width:120px;margin-left: 0.5rem; cursor: pointer;" />
                            </div>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                
                               
                <!-- Modal Footer -->
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseEditModal" />
                    <RadzenButton Text="Update User" Icon="save" ButtonStyle="ButtonStyle.Primary" 
                                  Click="@UpdateUser" Disabled="@(!IsEditFormValid || IsSaving)"
                                  Style="background-color: #212e61; border-color: #212e61;" />
                </div>
            </RadzenCard>
        </div>
    </div>
}

<!-- Password Change Modal -->
@if (ShowPasswordModal)
{
    <div class="modal-backdrop">
        <div class="modal-dialog">
            <RadzenCard class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header" style="background-color: #17a2b8; color: white; padding: 1rem; margin: -1rem -1rem 1rem -1rem; border-radius: 6px 6px 0 0;">
                    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: white;">
                        <RadzenIcon Icon="vpn_key" Style="margin-right: 0.5rem;" />
                        Change Password
                    </RadzenText>
                </div>
                
                <!-- Modal Body -->
                <RadzenStack Gap="1rem">
                    <RadzenText>
                        Changing password for: <strong>@PasswordUserDisplayName</strong>
                    </RadzenText>
                    
                    <RadzenFormField Text="New Password *" Variant="Variant.Outlined">
                        <RadzenPassword @bind-Value="@NewPassword" 
                                       Placeholder="Enter new password" 
                                       Style="width: 100%;" />
                    </RadzenFormField>
                    
                    <RadzenFormField Text="Confirm Password *" Variant="Variant.Outlined">
                        <RadzenPassword @bind-Value="@ConfirmPassword" 
                                       Placeholder="Confirm new password" 
                                       Style="width: 100%;" />
                    </RadzenFormField>
                    
                    @if (!string.IsNullOrEmpty(PasswordValidationMessage))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter">
                            <RadzenIcon Icon="warning" Style="margin-right: 0.5rem;" />
                            @PasswordValidationMessage
                        </RadzenAlert>
                    }
                </RadzenStack>
                
                <!-- Modal Footer -->
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@ClosePasswordModal" />
                    <RadzenButton Text="Update Password" Icon="save" ButtonStyle="ButtonStyle.Primary" 
                                  Click="@UpdatePassword" Disabled="@(!IsPasswordFormValid || IsSaving)" />
                </div>
            </RadzenCard>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (ShowDeleteModal)
{
    <div class="modal-backdrop">
        <div class="modal-dialog" style="max-width: 700px;">
            <RadzenCard class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header" style="background-color: #dc3545; color: white; padding: 1rem; margin: -1rem -1rem 1rem -1rem; border-radius: 6px 6px 0 0;">
                    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: white;">
                        <RadzenIcon Icon="delete" Style="margin-right: 0.5rem;" />
                        Confirm Delete
                    </RadzenText>
                </div>
                
                <!-- Modal Body -->
                <RadzenStack Gap="1rem">
                    <RadzenText>
                        Are you sure you want to delete the user <strong>@DeleteUserDisplayName</strong>?
                    </RadzenText>
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
                        This action cannot be undone and will remove all user permissions and group memberships.
                    </RadzenAlert>
                </RadzenStack>
                
                <!-- Modal Footer -->
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseDeleteModal" />
                    <RadzenButton Text="Delete User" Icon="delete" ButtonStyle="ButtonStyle.Danger" 
                                  Click="@DeleteUser" Disabled="@IsSaving" />
                </div>
            </RadzenCard>
        </div>
    </div>
}

<!-- Shared Password Change Modal -->
<PasswordChangeDialog IsVisible="@ShowPasswordModal" 
                    UserCode="@PasswordUserCode" 
                    UserDisplayName="@PasswordUserDisplayName" 
                    UserType="Organizational"
                    OnPasswordChanged="@OnPasswordChangedSuccess" 
                    OnCancel="@ClosePasswordChangeModal" />

<!-- Group Management Modal -->
@if (ShowGroupsModal && !string.IsNullOrEmpty(GroupManagementUserCode))
{
    <div class="modal-backdrop">
        <div class="modal-dialog modal-xl">
            <RadzenCard class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header" style="background-color: #212e61; color: white; padding: 1rem; margin: -1rem -1rem 1rem -1rem; border-radius: 6px 6px 0 0;">
                    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; color: white;">
                        <RadzenIcon Icon="group" Style="margin-right: 0.5rem;" />
                        Manage Groups: @GroupManagementUserDisplayName
                    </RadzenText>
                </div>
                
                <!-- Modal Body -->
                <RadzenRow Gap="1rem" Style="height: 500px;">
                    <!-- Current User Groups -->
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenCard Style="height: 100%;">
                            <RadzenCard Style="background-color: #e8f5e8; margin: -0.5rem -0.5rem 1rem -0.5rem; padding: 0.5rem;">
                                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: #28a745;">
                                    <RadzenIcon Icon="groups" Style="margin-right: 0.5rem;" />
                                    Current Groups (@UserCurrentGroups.Count)
                                </RadzenText>
                            </RadzenCard>
                            <div style="height: 400px; overflow-y: auto;">
                                @if (UserCurrentGroups.Any())
                                {
                                    @foreach (var group in UserCurrentGroups.OrderBy(g => g.Name))
                                    {
                                        <RadzenCard class="mb-2" Style="background-color: #f8f9fa;">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0;">
                                                        @group.Name
                                                    </RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                        @group.GroupType - @group.Code
                                                    </RadzenText>
                                                    @if (!string.IsNullOrEmpty(group.Description))
                                                    {
                                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                            @group.Description
                                                        </RadzenText>
                                                    }
                                                </div>
                                                <RadzenButton Icon="group_remove" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                              Click="@(() => RemoveUserFromGroup(group.Code))" title="Remove from group" />
                                            </div>
                                        </RadzenCard>
                                    }
                                }
                                else
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
                                        <RadzenIcon Icon="info" Style="margin-right: 0.5rem;" />
                                        This user is not currently assigned to any organizational groups.
                                    </RadzenAlert>
                                }
                            </div>
                        </RadzenCard>
                    </RadzenColumn>

                    <!-- Available Groups -->
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenCard Style="height: 100%;">
                            <RadzenCard Style="background-color: #e3f2fd; margin: -0.5rem -0.5rem 1rem -0.5rem; padding: 0.5rem;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: #007bff;">
                                        <RadzenIcon Icon="group_add" Style="margin-right: 0.5rem;" />
                                        Available Groups (@AvailableGroups.Count)
                                    </RadzenText>
                                    <RadzenButton Text="Assign Selected" Icon="group_add" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                                  Click="@AssignMultipleGroups" Disabled="@(!SelectedGroups.Any(s => s.Value))" />
                                </div>
                            </RadzenCard>
                            <div style="height: 400px; overflow-y: auto;">
                                @if (AvailableGroups.Any())
                                {
                                    @foreach (var group in AvailableGroups.OrderBy(g => g.Name))
                                    {
                                        <RadzenCard class="mb-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="d-flex align-items-center">
                                                    <RadzenCheckBox @bind-Value="SelectedGroups[group.Code]" class="me-2" />
                                                    <div>
                                                        <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0;">
                                                            @group.Name
                                                        </RadzenText>
                                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                            @group.GroupType - @group.Code
                                                        </RadzenText>
                                                        @if (!string.IsNullOrEmpty(group.Description))
                                                        {
                                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text.secondary-color);">
                                                                @group.Description
                                                            </RadzenText>
                                                        }
                                                        @if (!string.IsNullOrEmpty(group.AuthorityLevel))
                                                        {
                                                            <RadzenBadge Text="@group.AuthorityLevel" BadgeStyle="BadgeStyle.Info" 
                                                                       title="Authority Level" Style="font-size: 0.75rem;" />
                                                        }
                                                    </div>
                                                </div>
                                                <RadzenButton Icon="group_add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                                              Click="@(() => AssignUserToGroup(group.Code))" title="Assign to group" />
                                            </div>
                                        </RadzenCard>
                                    }
                                }
                                else
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
                                        <RadzenIcon Icon="warning" Style="margin-right: 0.5rem;" />
                                        This user is already assigned to all available organizational groups.
                                    </RadzenAlert>
                                }
                            </div>
                        </RadzenCard>
                    </RadzenColumn>
                </RadzenRow>
                
                <!-- Modal Footer -->
                <div class="d-flex justify-content-end align-items-center mt-3">
                    <div class="d-flex gap-2">
                        <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" Click="@CloseGroupsModal" />
                    </div>
                </div>
            </RadzenCard>
        </div>
    </div>
}

<style>
.user-card {
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
}

.user-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

/* Modal Styles */
.modal-backdrop {
    position: fixed;
    top: 0;
