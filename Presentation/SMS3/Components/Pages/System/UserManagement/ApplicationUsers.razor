@page "/System/UserManagement/ApplicationUsers"
@page "/System/UserManagement/ApplicationUsers/Edit/{Id?}"

@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS_Application.Messaging.Commands
@using SMS_Application.Messaging.Queries
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects

<PageTitle>Application User Management - SMS3</PageTitle>
<!-- SMS Page Header -->
<PageHeader Title="Application User Management"
            Subtitle="@($"Manage SMS Application Users ({@ApplicationUsersList.Count()})")"
            Icon="fas fa-user-tie">
            <AdditionalContent>
                <div class="d-flex justify-content-end align-items-center w-100">
                    <div class="d-flex gap-2">
                        <RadzenButton Text="Add User" Icon="add" ButtonStyle="ButtonStyle.Success"
                                      Click="@ShowCreateDialog" />
                    </div>
                </div>
            </AdditionalContent>

</PageHeader>
<div class="container-fluid">
    <!-- Messages -->
    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <RadzenRow Gap="1rem" class="rz-mb-3">
            <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenIcon Icon="check_circle" Style="margin-right: 0.5rem;" />
                    @SuccessMessage
                </RadzenAlert>
            </RadzenColumn>
        </RadzenRow>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <RadzenRow Gap="1rem" class="rz-mb-3">
            <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenIcon Icon="error" Style="margin-right: 0.5rem;" />
                    @ErrorMessage
                </RadzenAlert>
            </RadzenColumn>
        </RadzenRow>
    }

    <!-- Users DataGrid -->
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12">
            <RadzenCard Variant="Variant.Outlined">
               <RadzenCard>
                    @if (ApplicationUsersList.Any())
                    {
                        <RadzenDataGrid @ref="usersGrid" Data="@ApplicationUsersList" TItem="SMSApplicationUser"
                                        AllowFiltering="true" AllowSorting="true" AllowPaging="true"
                                        PageSize="10" ShowPagingSummary="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                            <Columns>
                                <RadzenDataGridColumn TItem="SMSApplicationUser" Property="Code" Title="User ID" Width="125px" Sortable="true" Filterable="true">
                                    <Template Context="user">
                                        <div class="d-flex align-items-center">
                                            <strong>@user.Code</strong>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="SMSApplicationUser" Property="DisplayName" Title="User" Width="200px" Sortable="true" Filterable="true">
                                    <Template Context="user">
                                        <div class="d-flex align-items-center">
                                            <div>
                                                <div><strong>@user.DisplayName</strong></div>
                                                <small style="color: var(--rz-text-secondary-color);">@user.UserName?.Value</small>
                                            </div>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <!-- NEW: User Role Column -->
                                <RadzenDataGridColumn TItem="SMSApplicationUser" Property="UserRole" Title="SMS Role/Permissions " Sortable="false">
                                    <Template Context="user">
                                        @if (user.UserRole != null)
                                        {
                                            @user.UserRole.Name 
                                        }
                                        else
                                        {
                                            <RadzenBadge Variant="Variant.Filled" BadgeStyle="BadgeStyle.Light" Text="No Role Assigned" />
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SMSApplicationUser" Property="TwoFactorEnabled" Title="2FA Required" Width="140px">
                                    <Template Context="user">
                                        <RadzenIcon Icon="@(user.TwoFactorEnabled ? "check_box" : "check_box_outline_blank")"
                                                    Style="@(user.TwoFactorEnabled ? "color: var(--rz-success);" : "color: var(--rz-danger);")" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SMSApplicationUser" Property="IsActive" Title="Active" Width="125px">
                                    <Template Context="user">
                                        <RadzenIcon Icon="@(user.IsActive ? "check_box" : "check_box_outline_blank")"
                                                    Style="@(user.IsActive ? "color: var(--rz-success);" : "color: var(--rz-danger);")" />
                                    </Template>
                                </RadzenDataGridColumn>
                                
                                
                              
                                <RadzenDataGridColumn TItem="SMSApplicationUser" Title="Actions" Width="200px" Sortable="false" Filterable="false">
                                    <Template Context="user">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                                          Click="@(() => EditUser(user.Code))"
                                                          title="Edit User" />

                                            <!-- NEW: Role Assignment Button -->
                                            <RadzenButton Icon="admin_panel_settings" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                                          Click="@(() => OpenRoleAssignmentModal(user.Code, user.DisplayName, user.UserRole?.Code))"
                                                          title="Assign Role" />

                                            <RadzenButton Icon="group" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                                          Click="@(() => ManageGroups(user.Code, user.DisplayName))" title="Manage Groups" />
                                            <RadzenButton Icon="lock" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                          Click="@(() => OpenPasswordChangeModal(user.Code, user.DisplayName))"
                                                          title="Change Password" />
                                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                          Click="@(() => ShowDeleteDialog(user.Code, user.DisplayName))"
                                                          title="Delete User" />
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                    else
                    {
                        <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="1rem" Style="padding: 3rem;">
                            <RadzenIcon Icon="people" Style="font-size: 4rem; color: var(--rz-text-disabled-color);" />
                            <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-text-disabled-color);">
                                No Application Users Found
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-disabled-color);">
                                Click "Add User" to create your first application user.
                            </RadzenText>
                            <RadzenButton Text="Add First User" Icon="add" ButtonStyle="ButtonStyle.Primary"
                                          Click="@ShowCreateDialog" />
                        </RadzenStack>
                    }
                </RadzenCard>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</div>

<!-- 🔥 NEW: Role Assignment Modal -->
@if (ShowRoleAssignmentModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-lg">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <h5 class="sms-modal-title">
                        <i class="fas fa-user-shield"></i> Assign Role: @RoleAssignmentUserDisplayName
                    </h5>
                </div>
                <div class="sms-modal-body">
                    
                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Current Role" Variant="Variant.Outlined">
                                <RadzenTextBox Value="@(CurrentUserRoleCode ?? "No role assigned")"
                                               ReadOnly="true"
                                               Style="background-color: #f8f9fa;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem">
                        <RadzenColumn Size="12">
                            <RadzenFormField Text="Select Role" Variant="Variant.Outlined">
                                <RadzenDropDown @bind-Value="@SelectedRoleCode"
                                                Data="@AvailableRoles"
                                                TextProperty="Name"
                                                ValueProperty="Code"
                                                Placeholder="Select a role..."
                                                AllowClear="true"
                                                Style="width: 100%;" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    @if (!string.IsNullOrEmpty(SelectedRoleCode))
                    {
                        var selectedRole = AvailableRoles.FirstOrDefault(r => r.Code == SelectedRoleCode);
                        @if (selectedRole.Permissions?.Any() == true)
                        {
                        <RadzenDataGrid Data="@SMSModules" TItem="string" AllowPaging="false" class="permission-view-grid">
                            <Columns>
                                <RadzenDataGridColumn TItem="string" Title="Module" Width="30%">
                                    <Template Context="module">
                                        <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 600;">@module</RadzenText>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="string" Title="Create" Width="17.5%">
                                    <Template Context="module">
                                        <div class="text-center">
                                            @if (IsPermissionGranted(selectedRole,module, "Create"))
                                            {
                                                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                <div><small class="text-success">Granted</small></div>
                                            }
                                            else
                                            {
                                                <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                <div><small class="text-muted">Denied</small></div>
                                            }
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="string" Title="Read" Width="17.5%">
                                    <Template Context="module">
                                        <div class="text-center">
                                            @if (IsPermissionGranted(selectedRole,module, "Read"))
                                            {
                                                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                <div><small class="text-success">Granted</small></div>
                                            }
                                            else
                                            {
                                                <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                <div><small class="text-muted">Denied</small></div>
                                            }
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="string" Title="Update" Width="17.5%">
                                    <Template Context="module">
                                        <div class="text-center">
                                            @if (IsPermissionGranted(selectedRole,module, "Update"))
                                            {
                                                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                <div><small class="text-success">Granted</small></div>
                                            }
                                            else
                                            {
                                                <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                <div><small class="text-muted">Denied</small></div>
                                            }
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="string" Title="Delete" Width="17.5%">
                                    <Template Context="module">
                                        <div class="text-center">
                                                @if (IsPermissionGranted(selectedRole,module, "Delete"))
                                            {
                                                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                <div><small class="text-success">Granted</small></div>
                                            }
                                            else
                                            {
                                                <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                <div><small class="text-muted">Denied</small></div>
                                            }
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>

                        }
                        else
                        {
                           
                        }
                
                    }
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end align-items-center w-100">
                        <div class="d-flex gap-2">
                            <RadzenButton Text="Cancel"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          Size="ButtonSize.Medium"
                                          Click="@CloseRoleAssignmentModal" />
                            
                            <RadzenButton Text="Assign Role"
                                          Icon="person_add"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Size="ButtonSize.Medium"
                                          Click="@AssignUserRole"
                                          Disabled="@(string.IsNullOrEmpty(SelectedRoleCode) || IsSaving)" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Edit User Modal -->
@if (IsEditMode && CurrentUser != null)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-lg">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <h5 class="sms-modal-title">
                        <i class="fas fa-edit"></i> Edit User: @CurrentUser.DisplayName
                    </h5>
                </div>
                <div class="sms-modal-body">
                    <RadzenTemplateForm Data="@editUser" Submit="@((EditUserModel model) => UpdateUser(model))">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="First Name" Variant="Variant.Outlined">
                                    <RadzenTextBox @bind-Value="@editUser.FirstName" Name="FirstName" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="FirstName" Text="First name is required" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Last Name" Variant="Variant.Outlined">
                                    <RadzenTextBox @bind-Value="@editUser.LastName" Name="LastName" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="LastName" Text="Last name is required" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow Gap="1rem" class="rz-mt-3">
                            <RadzenColumn Size="12">
                                <RadzenFormField Text="Username" Variant="Variant.Outlined">
                                    <RadzenTextBox Value="@CurrentUser.UserName?.Value" Disabled="true" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-disabled-color);">
                                Username cannot be changed after creation
                            </RadzenText>
                        </RadzenRow>
                        <!-- NEW: Role Assignment in Edit Modal -->
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12">
                                <RadzenFormField Text="Assign Role (Optional)" Variant="Variant.Outlined">
                                    <RadzenDropDown @bind-Value="@EditUserRoleCode"
                                                    Data="@AvailableRoles"
                                                    TextProperty="Name"
                                                    ValueProperty="Code"
                                                    Placeholder="Select a role (optional)..."
                                                    AllowClear="true"
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12">
                                <RadzenFormField Text="Two-Factor Authentication" Variant="Variant.Outlined">
                                    <div class="d-flex align-items-center p-2">
                                        <RadzenCheckBox @bind-Value="@CurrentUser.TwoFactorEnabled" Name="TwoFactorEnabled" />
                                        <RadzenLabel Text="Require 2FA" Component="TwoFactorEnabled" Style="margin-left: 0.5rem; cursor: pointer;" />
                                    </div>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTemplateForm>
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end align-items-center w-100">
                        <div class="d-flex gap-2">
                            <RadzenButton Text="Cancel"
                                          Icon="cancel"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          Size="ButtonSize.Medium"
                                          Click="@CancelEdit" />
                            <RadzenButton Text="Update User"
                                          Icon="save"
                                          ButtonStyle="ButtonStyle.Success"
                                          Size="ButtonSize.Medium"
                                          Click="@(() => UpdateUser(editUser))" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Shared Password Change Modal -->
<PasswordChangeDialog IsVisible="@ShowPasswordModal"
                     UserCode="@PasswordUserCode"
                     UserDisplayName="@PasswordUserDisplayName"
                     UserType="Application"
                     OnPasswordChanged="@OnPasswordChangedSuccess"
                     OnCancel="@ClosePasswordChangeModal" />

<!-- Create User Modal -->
@if (ShowCreateModal)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-lg">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <h5 class="sms-modal-title">
                        <i class="fas fa-user-plus"></i> Create Application User
                    </h5>
                </div>
                <div class="sms-modal-body">
                    <RadzenTemplateForm Data="@NewUser" Submit="@((CreateUserModel model) => CreateUser())">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="First Name *" Variant="Variant.Outlined">
                                    <RadzenTextBox @bind-Value="@NewUser.FirstName" Name="FirstName"
                                                   Placeholder="Enter first name"
                                                   Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="FirstName" Text="First name is required" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="Last Name *" Variant="Variant.Outlined">
                                    <RadzenTextBox @bind-Value="@NewUser.LastName" Name="LastName"
                                                   Placeholder="Enter last name"
                                                   Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="LastName" Text="Last name is required" />
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12">
                                <RadzenFormField Text="Username *" Variant="Variant.Outlined">
                                    <RadzenTextBox @bind-Value="@NewUser.UserName" Name="UserName"
                                                   Placeholder="Enter username"
                                                   Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="UserName" Text="Username is required" />
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12">
                                <RadzenFormField Text="Password *" Variant="Variant.Outlined">
                                    <RadzenPassword @bind-Value="@NewUser.Password" Name="Password"
                                                    Placeholder="Enter password"
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                                <RadzenRequiredValidator Component="Password" Text="Password is required" />
                            </RadzenColumn>
                        </RadzenRow>

                        <!-- NEW: Role Assignment in Create Modal -->
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12">
                                <RadzenFormField Text="Assign Role (Optional)" Variant="Variant.Outlined">
                                    <RadzenDropDown @bind-Value="@NewUser.UserRoleCode"
                                                    Data="@AvailableRoles"
                                                    TextProperty="Name"
                                                    ValueProperty="Code"
                                                    Placeholder="Select a role (optional)..."
                                                    AllowClear="true"
                                                    Style="width: 100%;" />
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>

                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12">
                                <RadzenFormField Text="Two-Factor Authentication" Variant="Variant.Outlined">
                                    <div class="d-flex align-items-center p-2">
                                        <RadzenCheckBox @bind-Value="@NewUser.TwoFactorEnabled" Name="NewUserTwoFactorEnabled" />
                                        <RadzenLabel Text="Require 2FA for this user" Component="NewUserTwoFactorEnabled" Style="margin-left: 0.5rem; cursor: pointer;" />
                                    </div>
                                </RadzenFormField>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTemplateForm>
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end align-items-center w-100">
                        
                        <div class="d-flex gap-2">
                            <RadzenButton Text="Cancel" Icon="cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseCreateModal" />
                            <RadzenButton Text="Create User" Icon="save" ButtonStyle="ButtonStyle.Primary"
                                          Click="@CreateUser" Disabled="@(!IsCreateFormValid || IsSaving)"
                                          Style="background-color: #212e61; border-color: #212e61;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Group Management Modal -->
@if (ShowGroupsModal && !string.IsNullOrEmpty(GroupManagementUserCode))
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog modal-xl">
            <div class="sms-modal-content">
                <!-- Modal Header -->
                <div class="sms-modal-header sms-header-primary">
                    <h5 class="sms-modal-title">
                        <i class="fas fa-users"></i> Manage Groups: @GroupManagementUserDisplayName
                    </h5>
                </div>

                <!-- Modal Body -->
                <div class="sms-modal-body">
                    <RadzenRow Gap="1rem" Style="height: 500px;">
                        <!-- Current User Groups -->
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenCard Style="height: 100%;">
                                <RadzenCard Style="background-color: #e8f5e8; margin: -0.5rem -0.5rem 1rem -0.5rem; padding: 0.5rem;">
                                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: #28a745;">
                                        <RadzenIcon Icon="groups" Style="margin-right: 0.5rem;" />
                                        Current Groups (@UserCurrentGroups.Count)
                                    </RadzenText>
                                </RadzenCard>
                                <div style="height: 400px; overflow-y: auto;">
                                    @if (UserCurrentGroups.Any())
                                    {
                                        @foreach (var group in UserCurrentGroups.OrderBy(g => g.Name))
                                        {
                                            <RadzenCard class="mb-2" Style="background-color: #f8f9fa;">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0;">
                                                            @group.Name
                                                        </RadzenText>
                                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                            @group.Code
                                                        </RadzenText>
                                                        @if (!string.IsNullOrEmpty(group.Description))
                                                        {
                                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                                @group.Description
                                                            </RadzenText>
                                                        }
                                                    </div>
                                                    <RadzenButton Icon="group_remove" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                                  Click="@(() => RemoveUserFromGroup(group.Code))" title="Remove from group" />
                                                </div>
                                            </RadzenCard>
                                        }
                                    }
                                    else
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
                                            <RadzenIcon Icon="info" Style="margin-right: 0.5rem;" />
                                            This user is not currently assigned to any application groups.
                                        </RadzenAlert>
                                    }
                                </div>
                            </RadzenCard>
                        </RadzenColumn>

                        <!-- Available Groups -->
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenCard Style="height: 100%;">
                                <RadzenCard Style="background-color: #e3f2fd; margin: -0.5rem -0.5rem 1rem -0.5rem; padding: 0.5rem;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: #007bff;">
                                            <RadzenIcon Icon="group_add" Style="margin-right: 0.5rem;" />
                                            Available Groups (@AvailableGroups.Count)
                                        </RadzenText>
                                        <RadzenButton Text="Assign Selected" Icon="group_add" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                                      Click="@AssignMultipleGroups" Disabled="@(!SelectedGroups.Any(s => s.Value))" />
                                    </div>
                                </RadzenCard>
                                <div style="height: 400px; overflow-y: auto;">
                                    @if (AvailableGroups.Any())
                                    {
                                        @foreach (var group in AvailableGroups.OrderBy(g => g.Name))
                                        {
                                            <RadzenCard class="mb-2">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="d-flex align-items-center">
                                                        <RadzenCheckBox @bind-Value="SelectedGroups[group.Code]" class="me-2" />
                                                        <div>
                                                            <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0;">
                                                                @group.Name
                                                            </RadzenText>
                                                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                                                @group.Code
                                                            </RadzenText>
                                                            @if (!string.IsNullOrEmpty(group.Description))
                                                            {
                                                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-textsecondary-color);">
                                                                    @group.Description
                                                                </RadzenText>
                                                            }
                                                        </div>
                                                    </div>
                                                    <RadzenButton Icon="group_add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                                                  Click="@(() => AssignUserToGroup(group.Code))" title="Assign to group" />
                                                </div>
                                            </RadzenCard>
                                        }
                                    }
                                    else
                                    {
                                        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
                                            <RadzenIcon Icon="warning" Style="margin-right: 0.5rem;" />
                                            This user is already assigned to all available application groups.
                                        </RadzenAlert>
                                    }
                                </div>
                            </RadzenCard>
                        </RadzenColumn>
                    </RadzenRow>
                </div>

                <!-- Modal Footer -->
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end align-items-center">
                        <div class="d-flex gap-2">
                            <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" Click="@CloseGroupsModal" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

