@using SMS3.Components.Pages.System.UserManagement
@using SMS_Domain.Enums
@using Radzen
@using Radzen.Blazor

<RadzenTemplateForm Data="@Model" Submit="@((OrganizationalUsers.EditOrganizationalUserModel model) => OnSubmit())">
    <RadzenStack Gap="1rem">
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="First Name" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@Model.FirstName" Name="FirstName" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="FirstName" Text="First name is required" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Last Name" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@Model.LastName" Name="LastName" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="LastName" Text="Last name is required" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Department" Variant="Variant.Outlined">
                    <RadzenDropDown @bind-Value="@Model.Department" Data="@Departments" Name="Department" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Department" Text="Department is required" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Position" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@Model.Position" Name="Position" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Position" Text="Position is required" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Organization Level" Variant="Variant.Outlined">
                    <RadzenDropDown @bind-Value="@Model.OrganizationLevel" Data="@OrganizationLevels" 
                                  Placeholder="-- Select Organization Level --" AllowClear="true" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Caption">Select an organization level for SMS hierarchy</RadzenText>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Status" Variant="Variant.Outlined">
                    <RadzenCheckBox @bind-Value="@Model.IsActive" Name="IsActive" />
                    <RadzenLabel Text="Active User" Component="IsActive" Style="margin-left: 0.5rem;" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Caption">Uncheck to deactivate this user</RadzenText>
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-4">
            <RadzenButton Text="Cancel" Variant="Variant.Text" Click="@Cancel" />
            <RadzenButton Text="Update User" Icon="save" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public OrganizationalUsers.EditOrganizationalUserModel Model { get; set; } = new();
    [Parameter] public string[] Departments { get; set; } = Array.Empty<string>();
    [Parameter] public List<string> OrganizationLevels { get; set; } = new();
    [CascadingParameter] public DialogService? DialogService { get; set; }

    private void OnSubmit()
    {
        if (string.IsNullOrWhiteSpace(Model.FirstName) || 
            string.IsNullOrWhiteSpace(Model.LastName) || 
            string.IsNullOrWhiteSpace(Model.Department) ||
            string.IsNullOrWhiteSpace(Model.Position))
        {
            return; // Form validation will handle the errors
        }

        DialogService?.Close(Model);
    }

    private void Cancel()
    {
        DialogService?.Close();
    }
}