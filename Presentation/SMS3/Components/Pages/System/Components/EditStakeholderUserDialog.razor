@using SMS3.Components.Pages.System.UserManagement
@using SMS_Domain.Entities
@using Radzen
@using Radzen.Blazor

<RadzenTemplateForm Data="@Model" Submit="@((StakeholderUsers.EditStakeholderUserModel model) => OnSubmit())">
    <RadzenStack Gap="1rem">
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="First Name" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@Model.FirstName" Name="FirstName" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="FirstName" Text="First name is required" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Last Name" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@Model.LastName" Name="LastName" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="LastName" Text="Last name is required" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Stakeholder Type" Variant="Variant.Outlined">
                    <RadzenDropDown @bind-Value="@Model.StakeholderType" Data="@StakeholderTypesForDropdown" Name="StakeholderType"
                                  ValueProperty="Value" TextProperty="Text" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="StakeholderType" Text="Stakeholder type is required" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Organization" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="@Model.Organization" Name="Organization" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Organization" Text="Organization is required" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="User Role" Variant="Variant.Outlined">
                    <RadzenDropDown @bind-Value="@Model.UserRoleCode" Data="@UserRoles" 
                                  ValueProperty="Code" TextProperty="Name" 
                                  Placeholder="-- No Role Assigned --" AllowClear="true" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Caption">Select a role to define permissions and access levels</RadzenText>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Status" Variant="Variant.Outlined">
                    <RadzenCheckBox @bind-Value="@Model.IsActive" Name="IsActive" />
                    <RadzenLabel Text="Active User" Component="IsActive" Style="margin-left: 0.5rem;" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Caption">Uncheck to deactivate this user</RadzenText>
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-4">
            <RadzenButton Text="Cancel" Variant="Variant.Text" Click="@Cancel" />
            <RadzenButton Text="Update User" Icon="save" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public StakeholderUsers.EditStakeholderUserModel Model { get; set; } = new();
    [Parameter] public IEnumerable<SMSUserRole> UserRoles { get; set; } = new List<SMSUserRole>();
    [Parameter] public string[] StakeholderTypes { get; set; } = Array.Empty<string>();
    [CascadingParameter] public DialogService? DialogService { get; set; }

    // Transform stakeholder types for dropdown
    private IEnumerable<object> StakeholderTypesForDropdown => StakeholderTypes.Select(type => new { 
        Value = type, 
        Text = GetStakeholderTypeDisplay(type) 
    });

    private void OnSubmit()
    {
        if (string.IsNullOrWhiteSpace(Model.FirstName) || 
            string.IsNullOrWhiteSpace(Model.LastName) || 
            string.IsNullOrWhiteSpace(Model.StakeholderType) ||
            string.IsNullOrWhiteSpace(Model.Organization))
        {
            return; // Form validation will handle the errors
        }

        DialogService?.Close(Model);
    }

    private void Cancel()
    {
        DialogService?.Close();
    }

    private string GetStakeholderTypeDisplay(string stakeholderType)
    {
        return stakeholderType switch
        {
            "SUT-0001" => "Airline",
            "SUT-0002" => "Ground Handler",
            "SUT-0003" => "Contractor",
            _ => stakeholderType
        };
    }
}