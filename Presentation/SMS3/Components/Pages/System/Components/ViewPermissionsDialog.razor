@using SMS_Domain.Entities
@using Radzen
@using Radzen.Blazor

<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.H5" Style="margin: 0; text-align: center;">
        <RadzenIcon Icon="admin_panel_settings" Style="margin-right: 0.5rem;" />
        @Role.Name
    </RadzenText>
    
    <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; text-align: center;">
        Code: @Role.Code
    </RadzenText>

    @if (Role.Permissions?.Any() == true)
    {
        <RadzenDataGrid Data="@SMSModules" TItem="string" AllowPaging="false" class="permission-view-grid">
            <Columns>
                <RadzenDataGridColumn TItem="string" Title="Module" Width="30%">
                    <Template Context="module">
                        <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 600;">@module</RadzenText>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="string" Title="Create" Width="17.5%">
                    <Template Context="module">
                        <div class="text-center">
                            @* Using helper method to determine granted or denied *@
                            @if (IsPermissionGranted(module, "Create"))
                            {
                                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                <div><small class="text-success">Granted</small></div>
                            }
                            else
                            {
                                <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                <div><small class="text-muted">Denied</small></div>
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="string" Title="Read" Width="17.5%">
                    <Template Context="module">
                        <div class="text-center">
                            @* Using helper method to determine granted or denied *@
                            @if (IsPermissionGranted(module, "Read"))
                            {
                                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                <div><small class="text-success">Granted</small></div>
                            }
                            else
                            {
                                <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                <div><small class="text-muted">Denied</small></div>
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="string" Title="Update" Width="17.5%">
                    <Template Context="module">
                        <div class="text-center">
                            @* Using helper method to determine granted or denied *@
                            @if (IsPermissionGranted(module, "Update"))
                            {
                                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                <div><small class="text-success">Granted</small></div>
                            }
                            else
                            {
                                <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                <div><small class="text-muted">Denied</small></div>
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="string" Title="Delete" Width="17.5%">
                    <Template Context="module">
                        <div class="text-center">
                            @* Using helper method to determine granted or denied *@
                            @if (IsPermissionGranted(module, "Delete"))
                            {
                                <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                <div><small class="text-success">Granted</small></div>
                            }
                            else
                            {
                                <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                <div><small class="text-muted">Denied</small></div>
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="info" />
                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                    Total: @GetTotalPermissions() of @GetMaxPermissions() possible permissions granted
                </RadzenText>
            </RadzenStack>
        </RadzenAlert>
    }
    else
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter">
            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="warning" Style="font-size: 2rem;" />
                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">No Permissions Defined</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">This role has no module permissions assigned.</RadzenText>
            </RadzenStack>
        </RadzenAlert>
    }

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" class="rz-mt-4">
        <RadzenButton Text="Close" Icon="close" Click="@Close" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter] public SMSUserRole Role { get; set; } = default!;
    [Parameter] public string[] SMSModules { get; set; } = Array.Empty<string>();
    [CascadingParameter] public DialogService? DialogService { get; set; }

    private void Close()
    {
        DialogService?.Close();
    }

    private int GetTotalPermissions()
    {
        return Role.Permissions?.Sum(p => (p.Create ? 1 : 0) + (p.Read ? 1 : 0) + (p.Update ? 1 : 0) + (p.Delete ? 1 : 0)) ?? 0;
    }

    private int GetMaxPermissions()
    {
        return SMSModules.Length * 4;
    }

    private bool IsPermissionGranted(string module, string action)
    {
        var permission = Role.Permissions?.FirstOrDefault(p => p.SMSModule == module);
        return action switch
        {
            "Create" => permission?.Create == true,
            "Read" => permission?.Read == true,
            "Update" => permission?.Update == true,
            "Delete" => permission?.Delete == true,
            _ => false
        };
    }
}