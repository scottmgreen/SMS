@using Radzen
@using Radzen.Blazor

<RadzenStack Gap="1rem">
    <RadzenFormField Text="User" Variant="Variant.Outlined">
        <RadzenTextBox Value="@DisplayName" Disabled="true" />
    </RadzenFormField>

    <RadzenFormField Text="New Password" Variant="Variant.Outlined">
        <RadzenPassword @bind-Value="@NewPassword" />
    </RadzenFormField>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-4">
        <RadzenButton Text="Cancel" Variant="Variant.Text" Click="@Cancel" />
        <RadzenButton Text="Update Password" Icon="vpn_key" ButtonStyle="ButtonStyle.Warning" 
                    Click="@UpdatePassword" Disabled="@string.IsNullOrWhiteSpace(NewPassword)" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter] public string UserId { get; set; } = "";
    [Parameter] public string DisplayName { get; set; } = "";
    [CascadingParameter] public DialogService? DialogService { get; set; }

    private string NewPassword { get; set; } = "";

    private void UpdatePassword()
    {
        if (string.IsNullOrWhiteSpace(NewPassword))
        {
            return;
        }

        DialogService?.Close(NewPassword);
    }

    private void Cancel()
    {
        DialogService?.Close();
    }
}