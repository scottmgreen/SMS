@page "/SMSPolicy/SafetyPolicy"
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared

<PageTitle>Safety Policy - SMS3</PageTitle>

<!-- SMS Page Header using reusable component -->
<PageHeader Title="Safety Policy"
           Subtitle="Organizational safety policy framework and management commitment to safety"
           Icon="fas fa-shield-alt" />

<div class="container-fluid">
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeLG="8">
            <!-- Policy Documents List -->
            <RadzenCard Variant="Variant.Outlined">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">
                        <RadzenIcon Icon="picture_as_pdf" Style="margin-right: 0.5rem;" />
                        Safety Policy Documents
                    </RadzenText>
                </RadzenCard>
                <RadzenCard>
                    <!-- Documents DataGrid -->
                    <RadzenDataGrid Data="@PolicyDocuments" 
                                    TItem="PolicyDocument" 
                                    AllowFiltering="false" 
                                    AllowSorting="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Style="width: 100%;"
                                    GridLines="DataGridGridLines.Both"
                                    Class="rz-datatable-striped">
                        <Columns>
                            <!-- Document Info Column -->
                            <RadzenDataGridColumn TItem="PolicyDocument" Property="Name" Title="Document" Width="60%">
                                <Template Context="document">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                                        <RadzenIcon Icon="@document.Icon" Style="@($"color: {document.Color}; font-size: 1.5rem;")" />
                                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; font-weight: 600;">
                                                @document.Name
                                            </RadzenText>
                                            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: var(--rz-text-secondary-color);">
                                                @document.Description
                                            </RadzenText>
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Style="margin-top: 0.25rem;">
                                                <RadzenBadge Text="@document.Type" Variant="Variant.Flat" IsPill="true" />
                                                <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                                                    Size: @document.Size
                                                </RadzenText>
                                                <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                                                    Modified: @document.LastModified.ToString("MMM dd, yyyy")
                                                </RadzenText>
                                            </RadzenStack>
                                        </RadzenStack>
                                    </RadzenStack>
                                </Template>
                            </RadzenDataGridColumn>

                            <!-- Actions Column -->
                            <RadzenDataGridColumn TItem="PolicyDocument" Title="Actions" Width="40%" Sortable="false" Filterable="false">
                                <Template Context="document">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                                        <RadzenButton Text="View" 
                                                    Icon="visibility" 
                                                    ButtonStyle="ButtonStyle.Primary" 
                                                    Size="ButtonSize.Small"
                                                    Click="@(() => ViewDocument(document.FileName, document.Category))" />
                                    </RadzenStack>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>

                    <!-- Information Alert -->
                    
                </RadzenCard>
            </RadzenCard>
        </RadzenColumn>

        <!-- Information Panel (Simplified) -->
        <RadzenColumn Size="12" SizeLG="4">
            <!-- Document Categories -->
            <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: var(--rz-info);">
                        <RadzenIcon Icon="folder" Style="margin-right: 0.5rem;" />
                        Document Categories
                    </RadzenText>
                </RadzenCard>
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="book" Style="color: var(--rz-primary);" />
                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Policies:</strong> Safety policies and procedures</RadzenText>
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="school" Style="color: var(--rz-success);" />
                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Manuals:</strong> Training and user guides</RadzenText>
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="description" Style="color: var(--rz-warning);" />
                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Templates:</strong> Downloadable forms</RadzenText>
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="assignment" Style="color: var(--rz-info);" />
                            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;"><strong>Forms:</strong> Official documents</RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenCard>

            
            
        </RadzenColumn>
    </RadzenRow>
</div>