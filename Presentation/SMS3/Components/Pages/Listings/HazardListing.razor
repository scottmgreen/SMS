@page "/Listings/Hazards"
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared
@using SMS_Application.Interfaces
@using SMS_Application.Messaging.Queries
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Shared.Common

<PageTitle>Hazard Listing - SMS3</PageTitle>

<!-- SMS Page Header using reusable component -->
<PageHeader Title="Hazard Listing"
           Subtitle="Complete listing and management interface for all SMS hazards"
           Icon="fas fa-list" />

<RadzenDataGrid @ref="hazardsGrid" 
                Data="@hazards" 
                Count="@totalCount" 
                LoadData="@LoadData"
                AllowPaging="true" 
                AllowSorting="true" 
                AllowFiltering="true"
                PageSize="25"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                FilterMode="FilterMode.Advanced"
                SelectionMode="DataGridSelectionMode.Single"
                Style="height: calc(100vh - 200px)"
                IsLoading="@isLoading">
    
    <Columns>
        <RadzenDataGridColumn TItem="Hazard" Property="ReportCode" Title="Report ID" Width="150px">
            <Template Context="hazard">
                <div title="@hazard.ReportCode" style="@BasicTextStyle">
                    @(hazard.ReportCode)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Hazard" Property="Code" Title="Hazard ID" Width="120px" >
            <Template Context="hazard">
                <div title="@hazard.Code" style="@BasicTextStyle">
                    @(hazard.Code)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Hazard" Property="Name" Title="Name" Width="350px" >
            <Template Context="hazard">
                <div title="@hazard.Name" style="@BasicTextStyle">
                    @(hazard.Name)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Hazard" Property="Description" Title="Description" Width="350px" >
            <Template Context="hazard">
                <div title="@hazard.Description" style="@BasicTextStyle">
                    @(hazard.Description?.Length > 50 ? hazard.Description[..47] + "..." : hazard.Description)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Hazard" Property="HazardRiskLevel" Title="Risk Level" Width="350px">
            <Template Context="hazard">
                <div title="@hazard.HazardRiskLevel" style="@BasicTextStyle">
                    @(hazard.HazardRiskLevel.Value ?? RiskLevel.Unkonwn)
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Hazard" Property="IsInitialHazard" Title="Initial Hazard" Width="125px">
            <Template Context="hazard">
                <RadzenIcon Icon="@(hazard.IsInitialHazard ? "check_box" : "check_box_outline_blank")"
                            Style="@(hazard.IsInitialHazard ? "color: var(--rz-success);" : "color: var(--rz-danger);")" />
            </Template>
        </RadzenDataGridColumn>
                

        <!-- Enhanced Actions Column -->
        <RadzenDataGridColumn TItem="Hazard" Title="Actions" Width="150px" Sortable="false" Filterable="false">
            <Template Context="hazard">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                    <RadzenButton ButtonStyle="ButtonStyle.Base"
                                  Size="ButtonSize.Small"
                                  Click="@(() => OnViewHazardAsync(hazard))"
                                  title="View Hazard"
                                  Icon="visibility" />
                    <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small"
                                  Click="@(() => OnEditHazardAsync(hazard))"
                                  title="Edit Hazard"
                                  Icon="edit" />
                    @if (!hazard.IsInitialHazard)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                      Size="ButtonSize.Small"
                                      Click="@(() => OnDeleteHazardAsync(hazard))"
                                      title="Delete Hazard"
                                      Icon="delete" />
                    }
                    
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>