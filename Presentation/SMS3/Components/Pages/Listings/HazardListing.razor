@page "/Listings/Hazards"
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Application.Messaging.Queries
@using SMS_Application.Interfaces
@using SMS_Shared.Common
@using Radzen
@using Radzen.Blazor
@using SMS3.Components.Shared

<PageTitle>Hazard Listing - SMS3</PageTitle>

<!-- SMS Page Header using reusable component -->
<PageHeader Title="Hazard Listing"
           Subtitle="Complete listing and management interface for all SMS hazards"
           Icon="fas fa-list" />

<RadzenDataGrid @ref="hazardsGrid" 
                Data="@hazards" 
                Count="@totalCount" 
                LoadData="@LoadData"
                AllowPaging="true" 
                AllowSorting="true" 
                AllowFiltering="true"
                PageSize="25"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                FilterMode="FilterMode.Advanced"
                SelectionMode="DataGridSelectionMode.Single"
                Style="height: calc(100vh - 200px)">
    
    <Columns>
        <RadzenDataGridColumn TItem="Hazard" Property="Code" Title="Hazard ID" Width="120px" />
        <RadzenDataGridColumn TItem="Hazard" Property="ReportCode" Title="Report Code" Width="150px" />
        <RadzenDataGridColumn TItem="Hazard" Property="Name" Title="Name" Width="350px" />
        <RadzenDataGridColumn TItem="Hazard" Property="Description" Title="Description" Width="350px" />
        <RadzenDataGridColumn TItem="Hazard" Property="IsInitialHazard" Title="Initial Hazard" Width="120px" TextAlign="TextAlign.Center">
            <Template Context="hazard">
                @if (hazard.IsInitialHazard)
                {
                    <RadzenBadge Text="X"
                                 BadgeStyle=BadgeStyle.Success
                                 Variant="Variant.Flat" />
                }
            </Template>
        </RadzenDataGridColumn>
        
                

        <!-- Enhanced Actions Column -->
        <RadzenDataGridColumn TItem="Hazard" Title="Actions" Width="150px" Sortable="false" Filterable="false">
            <Template Context="hazard">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                    <RadzenButton ButtonStyle="ButtonStyle.Base"
                                  Size="ButtonSize.Small"
                                  Click="@(() => OnViewHazardAsync(hazard))"
                                  title="View Hazard"
                                  Icon="visibility" />
                    <RadzenButton ButtonStyle="ButtonStyle.Warning"
                                  Size="ButtonSize.Small"
                                  Click="@(() => OnEditHazardAsync(hazard))"
                                  title="Edit Hazard"
                                  Icon="edit" />
                    @if (!hazard.IsInitialHazard)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                      Size="ButtonSize.Small"
                                      Click="@(() => OnDeleteHazardAsync(hazard))"
                                      title="Delete Hazard"
                                      Icon="delete" />
                    }
                    
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>