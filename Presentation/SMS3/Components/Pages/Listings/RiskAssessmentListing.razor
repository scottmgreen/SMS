@page "/Listings/RiskAssessments"
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Application.Messaging.Queries
@using SMS_Application.Interfaces
@using SMS_Shared.Common
@using Radzen
@using Radzen.Blazor

<PageTitle>Risk Assessments</PageTitle>

<RadzenDataGrid @ref="assessmentsGrid" 
                Data="@assessments" 
                Count="@totalCount" 
                LoadData="@LoadData"
                AllowPaging="true" 
                AllowSorting="true" 
                AllowFiltering="true"
                PageSize="25"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                FilterMode="FilterMode.Advanced"
                SelectionMode="DataGridSelectionMode.Single"
                Style="height: calc(100vh - 200px)">
    
    <Columns>
        <RadzenDataGridColumn TItem="RiskAssessment" Property="Code" Title="Code" Width="150px" />
        <RadzenDataGridColumn TItem="RiskAssessment" Property="Name" Title="Name" Width="250px" />
        <RadzenDataGridColumn TItem="RiskAssessment" Property="AssessmentType" Title="Type" Width="120px" />
        <RadzenDataGridColumn TItem="RiskAssessment" Property="Category" Title="Category" Width="150px" />
        <RadzenDataGridColumn TItem="RiskAssessment" Property="Status" Title="Status" Width="120px" />
        <RadzenDataGridColumn TItem="RiskAssessment" Property="HazardCode" Title="Hazard Code" Width="120px" />
        <RadzenDataGridColumn TItem="RiskAssessment" Property="AssignedTo" Title="Assigned To" Width="150px" />
        <RadzenDataGridColumn TItem="RiskAssessment" Property="CreatedBy" Title="Created By" Width="150px" />
        <RadzenDataGridColumn TItem="RiskAssessment" Property="CreatedDate" Title="Created Date" Width="150px" FormatString="{0:MM/dd/yyyy}" />
        <RadzenDataGridColumn TItem="RiskAssessment" Property="CompletedDate" Title="Completed Date" Width="150px" FormatString="{0:MM/dd/yyyy}" />
        
        <RadzenDataGridColumn TItem="RiskAssessment" Title="Actions" Width="100px" Sortable="false" Filterable="false">
            <Template Context="assessment">
                <RadzenButton Icon="more_vert" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" 
                            Click="@(() => ShowActions(assessment))" Disabled="true" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>