@page "/Listings/Mitigations"
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Application.Messaging.Queries
@using SMS_Application.Messaging.Commands
@using SMS_Application.Interfaces
@using SMS_Shared.Common
@using Radzen
@using Radzen.Blazor

<PageTitle>Mitigations</PageTitle>

<RadzenDataGrid @ref="mitigationsGrid" 
                Data="@mitigations" 
                Count="@totalCount" 
                LoadData="@LoadData"
                AllowPaging="true" 
                AllowSorting="true" 
                AllowFiltering="true"
                PageSize="25"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                FilterMode="FilterMode.Advanced"
                SelectionMode="DataGridSelectionMode.Single"
                Style="height: calc(100vh - 200px)">
    
    <Columns>
        <RadzenDataGridColumn TItem="Mitigation" Property="Code" Title="Code" Width="150px" />
        <RadzenDataGridColumn TItem="Mitigation" Property="Name" Title="Name" Width="200px" />
        <RadzenDataGridColumn TItem="Mitigation" Property="Description" Title="Description" Width="300px" />
        <RadzenDataGridColumn TItem="Mitigation" Property="Type" Title="Type" Width="120px" />
        <RadzenDataGridColumn TItem="Mitigation" Property="Status" Title="Status" Width="120px" />
        <RadzenDataGridColumn TItem="Mitigation" Property="Priority" Title="Priority" Width="100px" />
        <RadzenDataGridColumn TItem="Mitigation" Property="AssignedTo" Title="Assigned To" Width="150px" />
        <RadzenDataGridColumn TItem="Mitigation" Property="DueDate" Title="Due Date" Width="120px" FormatString="{0:MM/dd/yyyy}" />
        <RadzenDataGridColumn TItem="Mitigation" Property="CreatedBy" Title="Created By" Width="150px" />
        <RadzenDataGridColumn TItem="Mitigation" Property="CreatedDate" Title="Created Date" Width="150px" FormatString="{0:MM/dd/yyyy}" />
        
        <RadzenDataGridColumn TItem="Mitigation" Title="Actions" Width="180px" Sortable="false" Filterable="false">
            <Template Context="mitigation">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                    <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" 
                                Tooltip="View Mitigation Details"
                                Click="@(() => ViewMitigation(mitigation))" />
                    
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" 
                                Tooltip="Edit Mitigation"
                                Click="@(() => EditMitigation(mitigation))" />
                    
                    <RadzenButton Icon="history" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" 
                                Tooltip="View History"
                                Click="@(() => ViewHistory(mitigation))" />
                    
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" 
                                Tooltip="Delete Mitigation"
                                Click="@(() => DeleteMitigation(mitigation))" />
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<!-- Confirmation Dialog -->
<RadzenDialog />

<!-- View Mitigation Modal Dialog -->
@if (ShowViewDialog && SelectedMitigation != null)
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-lg">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-primary">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-shield-alt"></i> Mitigation Details
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                    Variant="Variant.Text"
                                    Icon="close"
                                    Size="ButtonSize.Small"
                                    Click="@(() => { ShowViewDialog = false; SelectedMitigation = null; })" />
                    </div>
                </div>
                <div class="sms-modal-body">
                    
                    <!-- Basic Information -->
                    <RadzenCard Variant="Variant.Outlined" Class="mb-3">
                        <div class="p-3">
                            <h6 class="text-primary mb-3">
                                <i class="fas fa-info-circle"></i> Basic Information
                            </h6>
                            <div class="row">
                                <div class="col-sm-6">
                                    <strong>Code:</strong> @SelectedMitigation.Code<br>
                                    <strong>Name:</strong> @SelectedMitigation.Name<br>
                                    <strong>Type:</strong> @SelectedMitigation.Type<br>
                                </div>
                                <div class="col-sm-6">
                                    <strong>Status:</strong> <RadzenBadge Text="@SelectedMitigation.Status" BadgeStyle="@GetStatusBadgeStyle(SelectedMitigation.Status)" /><br>
                                    <strong>Priority:</strong> <RadzenBadge Text="@(SelectedMitigation.Priority ?? "Medium")" BadgeStyle="@GetPriorityBadgeStyle(SelectedMitigation.Priority ?? "Medium")" /><br>
                                    <strong>Progress:</strong> @SelectedMitigation.Progress%<br>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(SelectedMitigation.Description))
                            {
                                <div class="mt-3">
                                    <strong>Description:</strong><br>
                                    <div class="bg-light p-2 rounded" style="white-space: pre-wrap;">@SelectedMitigation.Description</div>
                                </div>
                            }
                        </div>
                    </RadzenCard>

                    <!-- Timeline & Assignment -->
                    <RadzenCard Variant="Variant.Outlined" Class="mb-3">
                        <div class="p-3">
                            <h6 class="text-primary mb-3">
                                <i class="fas fa-calendar-alt"></i> Timeline & Assignment
                            </h6>
                            <div class="row">
                                <div class="col-sm-6">
                                    @if (SelectedMitigation.TargetDate.HasValue)
                                    {
                                        <strong>Target Date:</strong> @SelectedMitigation.TargetDate.Value.ToString("MMM dd, yyyy")<br>
                                    }
                                   
                                </div>
                                <div class="col-sm-6">
                                    @if (!string.IsNullOrWhiteSpace(SelectedMitigation.AssignedDepartment))
                                    {
                                        <strong>Department:</strong> @SelectedMitigation.AssignedDepartment<br>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(SelectedMitigation.AssignedTo))
                                    {
                                        <strong>Assigned To:</strong> @SelectedMitigation.AssignedTo<br>
                                    }
                                </div>
                            </div>
                        </div>
                    </RadzenCard>

                    <!-- Resources & Cost -->
                    @if (SelectedMitigation.EstimatedCost.HasValue || SelectedMitigation.EstimatedHours.HasValue || !string.IsNullOrWhiteSpace(SelectedMitigation.ResourceRequirements))
                    {
                        <RadzenCard Variant="Variant.Outlined" Class="mb-3">
                            <div class="p-3">
                                <h6 class="text-primary mb-3">
                                    <i class="fas fa-dollar-sign"></i> Resources & Cost
                                </h6>
                                <div class="row">
                                    <div class="col-sm-6">
                                        @if (SelectedMitigation.EstimatedCost.HasValue)
                                        {
                                            <strong>Estimated Cost:</strong> @SelectedMitigation.EstimatedCost.Value.ToString("C")<br>
                                        }
                                        @if (SelectedMitigation.EstimatedHours.HasValue)
                                        {
                                            <strong>Estimated Hours:</strong> @($"{SelectedMitigation.EstimatedHours.Value} hours")<br>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(SelectedMitigation.ResourceRequirements))
                                {
                                    <div class="mt-3">
                                        <strong>Resource Requirements:</strong><br>
                                        <div class="bg-light p-2 rounded" style="white-space: pre-wrap;">@SelectedMitigation.ResourceRequirements</div>
                                    </div>
                                }
                            </div>
                        </RadzenCard>
                    }

                    <!-- Associated Data -->
                    <RadzenCard Variant="Variant.Outlined" Class="mb-3">
                        <div class="p-3">
                            <h6 class="text-primary mb-3">
                                <i class="fas fa-link"></i> Associated Data
                            </h6>
                            <div class="row">
                                <div class="col-sm-6">
                                    @if (!string.IsNullOrWhiteSpace(SelectedMitigation.HazardCode))
                                    {
                                        <strong>Hazard Code:</strong> @SelectedMitigation.HazardCode<br>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(SelectedMitigation.RiskAssessmentCode))
                                    {
                                        <strong>Risk Assessment:</strong> @SelectedMitigation.RiskAssessmentCode<br>
                                    }
                                </div>
                                <div class="col-sm-6">
                                    <strong>Created:</strong> @SelectedMitigation.CreatedDate?.ToString("MMM dd, yyyy")<br>
                                    <strong>Created By:</strong> @SelectedMitigation.CreatedBy<br>
                                </div>
                            </div>
                        </div>
                    </RadzenCard>
                    
                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end gap-2">
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" 
                                    Text="Close" 
                                    Icon="close"
                                    Click="@(() => { ShowViewDialog = false; SelectedMitigation = null; })"
                                    Size="ButtonSize.Medium" />
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                                    Text="Edit Mitigation" 
                                    Icon="edit"
                                    Click="@(() => { ShowViewDialog = false; EditMitigation(SelectedMitigation); })"
                                    Size="ButtonSize.Medium" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .text-muted {
        color: var(--rz-text-disabled-color);
        font-style: italic;
    }

    /* Modal Overlay and Dialog */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 1rem;
    }

    .sms-modal-dialog {
        position: relative;
        margin: 0 auto;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
    }

    .sms-modal-lg {
        max-width: 900px;
        width: 100%;
    }

    .sms-modal-content {
        background: white;
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    }

    .sms-modal-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e9ecef;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .sms-header-primary {
        background-color: #212e61; /* SMS Blue Dark Bold */
        color: white;
    }

    .sms-modal-title {
        margin: 0;
        font-weight: 600;
    }

    .sms-modal-body {
        padding: 1.5rem;
    }

    .sms-modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid #e9ecef;
        border-radius: 0 0 0.5rem 0.5rem;
    }
</style>