@page "/Listings/Mitigations"
@page "/Listings/Mitigations/{ReportId}"
@page "/Listings/Mitigations/{ReportId}/{HazardCode}"
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Application.Messaging.Queries
@using SMS_Application.Messaging.Commands
@using SMS_Application.Interfaces
@using SMS_Shared.Common
@using Radzen
@using Radzen.Blazor

<PageTitle>@GetContextTitle()</PageTitle>

<!-- Context Header -->
@if (ContextHazard != null || ContextReport != null)
{
    <RadzenCard Variant="Variant.Outlined" Class="mb-3" Style="border-left: 4px solid var(--rz-info);">
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.H6" Style="color: #212e61; margin: 0;">
                <RadzenIcon Icon="info" Style="margin-right: 0.5rem;" />
                Context Information
            </RadzenText>
            <RadzenRow Gap="1rem">
                @if (ContextReport != null)
                {
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Body2">
                            <strong>Report:</strong> @ContextReport.Code<br>
                            @* <strong>Report Type:</strong> @ContextReport.ReportType<br> *@
                            <strong>Status:</strong> <RadzenBadge Text="@ContextReport.Status" BadgeStyle="BadgeStyle.Info" />
                        </RadzenText>
                    </RadzenColumn>
                }
                @if (ContextHazard != null)
                {
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Body2">
                            <strong>Hazard:</strong> @ContextHazard.Code<br>
                            <strong>Category:</strong> @ContextHazard.HazardCategory<br>
                            <strong>Risk Level:</strong> @ContextHazard.RiskLevel
                        </RadzenText>
                    </RadzenColumn>
                }
            </RadzenRow>
        </RadzenStack>
    </RadzenCard>
}

<!-- Actions Row -->
@if (ShowBulkApprove && mitigations.Any())
{
    <RadzenRow Class="mb-3" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenColumn Size="8">
            <RadzenText TextStyle="TextStyle.H5" Style="color: #212e61; margin: 0;">
                @GetContextTitle()
                <RadzenBadge Text="@totalCount.ToString()" BadgeStyle="BadgeStyle.Light" Style="margin-left: 0.5rem;" />
            </RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="4" Style="text-align: right;">
            @if (GetApprovableMitigationCount() > 0)
            {
                <RadzenButton Text="@($"Bulk Approve ({GetApprovableMitigationCount()})")"
                              Icon="verified"
                              ButtonStyle="ButtonStyle.Success"
                              Size="ButtonSize.Medium"
                              Click="@OpenBulkApprovalDialog"
                              Disabled="@isLoading" />
            }
            else
            {
                <RadzenButton Text="All Approved"
                              Icon="check"
                              ButtonStyle="ButtonStyle.Success"
                              Size="ButtonSize.Medium"
                              Disabled="true" />
            }
        </RadzenColumn>
    </RadzenRow>
}

<!-- Mitigations Data Grid -->
<RadzenDataGrid @ref="mitigationsGrid"
                Data="@mitigations"
                Count="@totalCount"
                LoadData="@LoadData"
                AllowPaging="true"
                AllowSorting="true"
                AllowFiltering="true"
                PageSize="25"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                FilterMode="FilterMode.Advanced"
                SelectionMode="DataGridSelectionMode.Single"
                Style="height: calc(100vh - 300px)">

    <Columns>
        <RadzenDataGridColumn TItem="Mitigation" Property="Code" Title="Code" Width="150px" />
        <RadzenDataGridColumn TItem="Mitigation" Property="Name" Title="Name" Width="250px" />
        <RadzenDataGridColumn TItem="Mitigation" Property="Description" Title="Description" Width="300px">
            <Template Context="mitigation">
                <RadzenText TextStyle="TextStyle.Body2" Text="@(mitigation.Description?.Length > 100 ? mitigation.Description.Substring(0, 100) + "..." : mitigation.Description)" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Mitigation" Property="Type" Title="Type" Width="120px" />
        <RadzenDataGridColumn TItem="Mitigation" Property="Status" Title="Status" Width="120px">
            <Template Context="mitigation">
                <RadzenBadge Text="@mitigation.Status" BadgeStyle="@GetStatusBadgeStyle(mitigation.Status)" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Mitigation" Property="Priority" Title="Priority" Width="100px">
            <Template Context="mitigation">
                <RadzenBadge Text="@(mitigation.Priority ?? "Medium")" BadgeStyle="@GetPriorityBadgeStyle(mitigation.Priority ?? "Medium")" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Mitigation" Property="Progress" Title="Progress" Width="100px">
            <Template Context="mitigation">
                <RadzenProgressBar Value="@mitigation.Progress" Max="100" Style="width: 100%;" />
                <RadzenText TextStyle="TextStyle.Caption" Text="@($"{mitigation.Progress}%")" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Mitigation" Property="DueDate" Title="Due Date" Width="120px" FormatString="{0:MM/dd/yyyy}" />

        <RadzenDataGridColumn TItem="Mitigation" Title="Actions" Width="200px" Sortable="false" Filterable="false">
            <Template Context="mitigation">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                    <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small"
                                  Tooltip="View Mitigation Details"
                                  Click="@(() => ViewMitigation(mitigation))" />

                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                  Tooltip="Edit Mitigation"
                                  Click="@(() => EditMitigation(mitigation))" />

                    @if (mitigation.Status != "Approved")
                    {
                        <RadzenButton Icon="verified" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                      Tooltip="Quick Approve"
                                      Click="@(async () => await QuickApproveMitigation(mitigation))" />
                    }

                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                  Tooltip="Delete Mitigation"
                                  Click="@(() => DeleteMitigation(mitigation))" />
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<!-- Bulk Approval Dialog -->
@if (ShowBulkApprovalDialog && selectedMitigations.Any())
{
    <div class="modal-overlay">
        <div class="sms-modal-dialog sms-modal-lg">
            <div class="sms-modal-content">
                <div class="sms-modal-header sms-header-warning">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="sms-modal-title mb-0">
                            <i class="fas fa-check-double"></i> Bulk Mitigation Approval
                        </h5>
                        <RadzenButton ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Text"
                                      Icon="close"
                                      Size="ButtonSize.Small"
                                      Click="@CloseBulkApprovalDialog" />
                    </div>
                </div>
                <div class="sms-modal-body">

                    <!-- Context Information -->
                    @if (ContextHazard != null)
                    {
                        <RadzenCard Variant="Variant.Outlined" Class="mb-3">
                            <div class="p-3">
                                <h6 class="text-primary mb-3">
                                    <i class="fas fa-exclamation-triangle text-warning"></i> Confirmation Required
                                </h6>
                                <p class="mb-3">
                                    You are about to <strong>approve @selectedMitigations.Count() mitigation(s)</strong> for:
                                </p>
                                <div class="row mb-3">
                                    <div class="col-sm-6">
                                        <strong>Report:</strong> @(ContextReport?.Code ?? ReportId ?? "N/A")<br>
                                        <strong>Hazard:</strong> @ContextHazard.Code<br>
                                    </div>
                                    <div class="col-sm-6">
                                        <strong>Total Mitigations:</strong> @selectedMitigations.Count()<br>
                                        <strong>Hazard Category:</strong> @ContextHazard.HazardCategory
                                    </div>
                                </div>
                                <div class="bg-light p-2 rounded mb-3">
                                    <strong>Hazard Description:</strong> @ContextHazard.Description
                                </div>
                            </div>
                        </RadzenCard>
                    }

                    <!-- Mitigation List Preview -->
                    <RadzenCard Variant="Variant.Outlined" Class="mb-3">
                        <div class="p-3">
                            <h6 class="text-primary mb-3">
                                <i class="fas fa-list"></i> Mitigations to be Approved
                            </h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-striped">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Name</th>
                                            <th>Current Status</th>
                                            <th>Priority</th>
                                            <th>Progress</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var mitigation in selectedMitigations)
                                        {
                                            <tr>
                                                <td><code>@mitigation.Code</code></td>
                                                <td>@mitigation.Name</td>
                                                <td>
                                                    <RadzenBadge Text="@mitigation.Status"
                                                                 BadgeStyle="@GetStatusBadgeStyle(mitigation.Status)" />
                                                </td>
                                                <td>
                                                    <RadzenBadge Text="@(mitigation.Priority ?? "Medium")"
                                                                 BadgeStyle="@GetPriorityBadgeStyle(mitigation.Priority ?? "Medium")" />
                                                </td>
                                                <td>@mitigation.Progress%</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </RadzenCard>

                    <!-- Warning Message -->
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Icon="warning" ShowIcon="true" Class="mb-3">
                        <strong>Important:</strong> This action will set the status of ALL listed mitigations to "Approved".
                        This action cannot be undone. Please review the mitigations carefully before proceeding.
                    </RadzenAlert>

                </div>
                <div class="sms-modal-footer">
                    <div class="d-flex justify-content-end gap-2">
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary"
                                      Text="Cancel"
                                      Icon="close"
                                      Click="@CloseBulkApprovalDialog"
                                      Size="ButtonSize.Medium"
                                      Disabled="@IsProcessingBulkApproval" />
                        <RadzenButton ButtonStyle="ButtonStyle.Success"
                                      Text="@(IsProcessingBulkApproval ? "Processing..." : $"Approve All {selectedMitigations.Count()} Mitigations")"
                                      Icon="@(IsProcessingBulkApproval ? "hourglass_empty" : "verified")"
                                      Click="@ProcessBulkApproval"
                                      Size="ButtonSize.Medium"
                                      Disabled="@IsProcessingBulkApproval" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- View Mitigation Modal Dialog (unchanged from original) -->
@if (ShowViewDialog && SelectedMitigation != null)
{
    <!-- Keep existing view dialog markup -->
}

<!-- Add quick approve method to code-behind -->
@code {
    [Inject] private AuthenticationService AuthService { get; set; } = default!;

    private async Task QuickApproveMitigation(Mitigation mitigation)
    {
        try
        {
            mitigation.Status = MitigationStatus.Approved;
            mitigation.UpdatedDate = DateTime.UtcNow;
            mitigation.UpdatedBy = AuthService.CurrentUser.Code;

            var updateCommand = new UpdateMitigationCommand(mitigation);
            var result = await Mediator.SendAsync(updateCommand, CancellationToken.None);

            if (result.IsSuccess)
            {
                ShowSuccessNotification($"Mitigation {mitigation.Code} approved successfully");
                await LoadInitialData();
                StateHasChanged();
            }
            else
            {
                ShowErrorNotification($"Failed to approve mitigation: {result.Error?.Message}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error quick approving mitigation {Code}", mitigation.Code);
            ShowErrorNotification("Error approving mitigation");
        }
    }
}

