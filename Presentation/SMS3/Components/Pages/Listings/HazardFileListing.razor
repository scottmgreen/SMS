@page "/Listings/HazardFiles"
@using SMS3.Components.Shared
@using SMS_Domain.Entities
@using SMS_Domain.ValueObjects
@using SMS_Application.Messaging.Queries
@using SMS_Application.Messaging.Commands
@using SMS_Application.Interfaces
@using SMS_Shared.Common
@using Radzen
@using Radzen.Blazor

<PageTitle>Hazard Files</PageTitle>
<PageHeader Title="Investigation Listing"
            Subtitle="Complete listing and management interface for all SMS Hazard Evidence Files"
            Icon="fas fa-list" />

<RadzenDataGrid @ref="filesGrid" 
                Data="@files" 
                Count="@totalCount" 
                LoadData="@LoadData"
                AllowPaging="true" 
                AllowSorting="true" 
                AllowFiltering="true"
                PageSize="25"
                PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true"
                FilterMode="FilterMode.Advanced"
                SelectionMode="DataGridSelectionMode.Single"
                Style="height: calc(100vh - 200px)">
    
    <Columns>
        <RadzenDataGridColumn TItem="HazardFile" Property="Code" Title="Code" Width="150px" />
        <RadzenDataGridColumn TItem="HazardFile" Property="HazardCode" Title="Hazard Code" Width="120px" />
        <RadzenDataGridColumn TItem="HazardFile" Property="FileName" Title="File Name" Width="200px" />
        <RadzenDataGridColumn TItem="HazardFile" Property="FileType" Title="Type" Width="120px" />
        <RadzenDataGridColumn TItem="HazardFile" Property="FileSizeBytes" Title="Size" Width="100px">
            <Template Context="file">
                @FormatFileSize(file.FileSizeBytes)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="HazardFile" Property="Description" Title="Description" Width="300px" />
        <RadzenDataGridColumn TItem="HazardFile" Property="UploadedBy" Title="Uploaded By" Width="150px" />
        <RadzenDataGridColumn TItem="HazardFile" Property="UploadedDate" Title="Uploaded Date" Width="150px" FormatString="{0:MM/dd/yyyy}" />
        <RadzenDataGridColumn TItem="HazardFile" Property="CreatedBy" Title="Created By" Width="150px" />
        <RadzenDataGridColumn TItem="HazardFile" Property="CreatedDate" Title="Created Date" Width="150px" FormatString="{0:MM/dd/yyyy}" />
        
        <RadzenDataGridColumn TItem="HazardFile" Title="Actions" Width="120px" Sortable="false" Filterable="false">
            <Template Context="file">
                <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" 
                            Click="@(() => ReadFile(file))" 
                            Tooltip="View File"
                            Style="margin-right: 5px;" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" 
                            Click="@(() => DeleteFile(file))" 
                            Tooltip="Delete File" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<!-- File View Modal -->
@if (showFileModal && selectedFile != null)
{
    <div class="modal-overlay">
        <div class="file-modal-dialog">
            <div class="file-modal-content">
                <div class="file-modal-header">
                    <h5 class="file-modal-title">
                        <i class="fas fa-file"></i> @selectedFile.FileName
                    </h5>
                    <RadzenButton ButtonStyle="ButtonStyle.Light" 
                                Variant="Variant.Text"
                                Icon="close"
                                Size="ButtonSize.Small"
                                Click="CloseFileModal" />
                </div>
                <div class="file-modal-body">
                    @if (isLoadingFile)
                    {
                        <div class="text-center p-4">
                            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                            <p class="mt-2">Loading file...</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(fileViewError))
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i> @fileViewError
                            <div class="mt-2">
                                <RadzenButton Text="Download File" 
                                            Icon="download" 
                                            ButtonStyle="ButtonStyle.Primary"
                                            Click="DownloadFile" />
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (IsImageFile(selectedFile.FileType))
                        {
                            <img src="@fileDataUrl" alt="@selectedFile.FileName" style="max-width: 100%; height: auto;" />
                        }
                        else if (IsPdfFile(selectedFile.FileType))
                        {
                            <embed src="@fileDataUrl" type="application/pdf" width="100%" height="600px" />
                        }
                        else if (IsTextFile(selectedFile.FileType))
                        {
                            <pre style="white-space: pre-wrap; max-height: 600px; overflow-y: auto; background: #f5f5f5; padding: 1rem; border-radius: 4px;">@fileTextContent</pre>
                        }
                        else if (IsVideoFile(selectedFile.FileType))
                        {
                            <video controls style="max-width: 100%; height: auto;">
                                <source src="@fileDataUrl" type="@GetMimeType(selectedFile.FileType)">
                                Your browser does not support the video tag.
                            </video>
                        }
                        else
                        {
                            <div class="text-center p-4">
                                <i class="fas fa-file fa-3x text-muted mb-3"></i>
                                <p>Cannot preview this file type: @selectedFile.FileType</p>
                                <RadzenButton Text="Download File" 
                                            Icon="download" 
                                            ButtonStyle="ButtonStyle.Primary"
                                            Click="DownloadFile" />
                            </div>
                        }
                    }
                </div>
                <div class="file-modal-footer">
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            <i class="fas fa-info-circle"></i> 
                            Size: @FormatFileSize(selectedFile.FileSizeBytes) | 
                            Type: @selectedFile.FileType | 
                            Uploaded: @(selectedFile.UploadedDate?.ToString("MM/dd/yyyy") ?? "N/A")
                        </small>
                        <div>
                            <RadzenButton Text="Download" 
                                        Icon="download" 
                                        ButtonStyle="ButtonStyle.Secondary"
                                        Click="DownloadFile" 
                                        Style="margin-right: 10px;" />
                            <RadzenButton Text="Close" 
                                        Icon="close"
                                        ButtonStyle="ButtonStyle.Dark"
                                        Click="CloseFileModal" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
/* File Modal Styles */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
    padding: 1rem;
}

.file-modal-dialog {
    position: relative;
    margin: 0 auto;
    max-width: 90vw;
    max-height: 90vh;
    width: 1000px;
}

.file-modal-content {
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    max-height: 90vh;
}

.file-modal-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e9ecef;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 0.5rem 0.5rem 0 0;
    background-color: #f8f9fa;
}

.file-modal-title {
    margin: 0;
    font-weight: 600;
}

.file-modal-body {
    padding: 1rem;
    overflow-y: auto;
    flex: 1;
}

.file-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid #e9ecef;
    border-radius: 0 0 0.5rem 0.5rem;
    background-color: #f8f9fa;
}

.alert {
    padding: 0.75rem 1.25rem;
    margin-bottom: 1rem;
    border: 1px solid transparent;
    border-radius: 0.25rem;
}

.alert-warning {
    color: #856404;
    background-color: #fff3cd;
    border-color: #ffeaa7;
}

.text-center { text-align: center; }
.p-4 { padding: 1.5rem; }
.mt-2 { margin-top: 0.5rem; }
.mb-3 { margin-bottom: 1rem; }
.text-muted { color: #6c757d; }
.d-flex { display: flex; }
.justify-content-between { justify-content: space-between; }
.align-items-center { align-items: center; }
</style>

<script>
window.downloadFileFromBase64 = (filename, base64Content, mimeType) => {
    const linkSource = `data:${mimeType};base64,${base64Content}`;
    const downloadLink = document.createElement("a");
    downloadLink.href = linkSource;
    downloadLink.download = filename;
    document.body.appendChild(downloadLink);
    downloadLink.click();
    document.body.removeChild(downloadLink);
};
</script>