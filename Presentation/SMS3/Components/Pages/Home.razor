@page "/"
@layout SMS3.Components.Layout.MainLayout
@inject SMS_Application.Interfaces.ICurrentUserService _currentUserService
@inject NavigationManager Navigation

<PageTitle>PDX SMS </PageTitle>

<!-- Home background - positioned to cover entire viewport -->
<div class="home-background"></div>

<!-- Transparent content area -->
<div style="position: relative; z-index: 1; background: transparent;">
    @* Home content can go here if needed *@
</div>

@code {
    private bool IsAuthenticated => _currentUserService.IsAuthenticated;
    private string? CurrentUserName => _currentUserService.UserDisplayName;
    private string? CurrentUserType => _currentUserService.UserType;
}