@page "/auth-debug"
@using SMS_Application.Interfaces
@inject ICurrentUserService _currentUserService
@inject ILogger<AuthDebug> Logger

<PageTitle>Authentication Debug</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3>Authentication Debug Information</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Current User Service Status</h5>
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Service Available:</strong></td>
                                    <td><span class="badge @(_currentUserService != null ? "bg-success" : "bg-danger")">@(_currentUserService != null ? "Yes" : "No")</span></td>
                                </tr>
                                @if (_currentUserService != null)
                                {
                                    <tr>
                                        <td><strong>IsAuthenticated:</strong></td>
                                        <td><span class="badge @(_currentUserService.IsAuthenticated ? "bg-success" : "bg-secondary")">@_currentUserService.IsAuthenticated</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>IsFullyAuthenticated:</strong></td>
                                        <td><span class="badge @(_currentUserService.IsFullyAuthenticated ? "bg-success" : "bg-warning")">@_currentUserService.IsFullyAuthenticated</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>IsPending2FA:</strong></td>
                                        <td><span class="badge @(_currentUserService.IsPending2FAVerification ? "bg-warning" : "bg-success")">@_currentUserService.IsPending2FAVerification</span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>User Code:</strong></td>
                                        <td><code>@_currentUserService.UserCode</code></td>
                                    </tr>
                                    <tr>
                                        <td><strong>User Type:</strong></td>
                                        <td><code>@_currentUserService.UserType</code></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Display Name:</strong></td>
                                        <td><code>@_currentUserService.UserDisplayName</code></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Email:</strong></td>
                                        <td><code>@_currentUserService.Email</code></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Role Code:</strong></td>
                                        <td><code>@_currentUserService.UserRoleCode</code></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Permission Count:</strong></td>
                                        <td><span class="badge bg-info">@_currentUserService.Permissions.Count</span></td>
                                    </tr>
                                }
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h5>NavMenu Display Logic</h5>
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Should Show Main Menu:</strong></td>
                                    <td><span class="badge @(_currentUserService?.IsFullyAuthenticated == true ? "bg-success" : "bg-secondary")">@(_currentUserService?.IsFullyAuthenticated == true)</span></td>
                                </tr>
                                <tr>
                                    <td><strong>Should Show 2FA Status:</strong></td>
                                    <td><span class="badge @(_currentUserService?.IsPending2FAVerification == true ? "bg-warning" : "bg-secondary")">@(_currentUserService?.IsPending2FAVerification == true)</span></td>
                                </tr>
                            </table>
                            
                            <h5>Available Modules</h5>
                            <div class="list-group">
                                @if (_currentUserService?.IsFullyAuthenticated == true)
                                {
                                    var modules = _currentUserService.GetAccessibleModules();
                                    @foreach (var module in modules)
                                    {
                                        <div class="list-group-item">@module</div>
                                    }
                                }
                                else
                                {
                                    <div class="list-group-item text-muted">Not authenticated</div>
                                }
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mt-3">
                        <div class="col-12">
                            <button class="btn btn-primary" @onclick="RefreshData">Refresh Data</button>
                            <button class="btn btn-secondary ms-2" @onclick="NavigateToHome">Go to Home</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private NavigationManager _navigation { get; set; } = default!;
    
    private async Task RefreshData()
    {
        Logger.LogInformation("?? Refreshing authentication debug data");
        StateHasChanged();
    }
    
    private void NavigateToHome()
    {
        _navigation.NavigateTo("/");
    }
    
    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("?? AuthDebug page loaded");
    }
}