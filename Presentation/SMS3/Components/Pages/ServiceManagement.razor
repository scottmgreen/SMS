@page "/service-management"
@using Microsoft.FeatureManagement
@using Microsoft.Extensions.DependencyInjection

<PageTitle>Service Management - SMS3</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">?? Service Registration Management</h4>
                    <small>View and monitor centralized service registration</small>
                </div>
                <div class="card-body">
                    
                    <div class="alert alert-info">
                        <h5>?? Centralized Service Registration Benefits:</h5>
                        <p class="mb-0">All presentation layer services are now registered through <code>AddPresentationServices()</code> 
                        in <code>SMSPresentationConfiguration.cs</code>, providing better organization, maintainability, and testing capabilities.</p>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5>?? Program.cs Transformation:</h5>
                            <div class="card">
                                <div class="card-body">
                                    <div class="row text-center">
                                        <div class="col-6">
                                            <div class="border-end">
                                                <h6 class="text-danger">? Before</h6>
                                                <div class="display-6 text-danger">~25</div>
                                                <small>Lines of service registration</small>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <h6 class="text-success">? After</h6>
                                            <div class="display-6 text-success">3</div>
                                            <small>Lines of service registration</small>
                                        </div>
                                    </div>
                                    
                                    <div class="mt-3">
                                        <h6>?? Clean Program.cs:</h6>
                                        <pre class="bg-light p-2 rounded small">
<code>// **PRESENTATION LAYER SERVICES**
builder.Services.AddPresentationServices(builder.Configuration);
builder.Services.AddPresentationMiddleware();
builder.Services.ConfigurePresentationOptions(builder.Configuration);</code>
                                        </pre>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <h5>??? Service Categories:</h5>
                            <div class="card">
                                <div class="card-body">
                                    <div class="list-group list-group-flush">
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><strong>?? UI Helper Services</strong></span>
                                            <span class="badge bg-primary">Notifications, Dialogs</span>
                                        </div>
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><strong>?? Authentication Services</strong></span>
                                            <span class="badge bg-success">Static Auth, Sessions</span>
                                        </div>
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><strong>?? API Services</strong></span>
                                            <span class="badge bg-info">External APIs, Business Logic</span>
                                        </div>
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><strong>?? Documentation Services</strong></span>
                                            <span class="badge bg-warning">Swagger, OpenAPI</span>
                                        </div>
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><strong>??? Security Services</strong></span>
                                            <span class="badge bg-danger">API Keys, Filters</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-4">
                        <h5>?? Service Registration Structure:</h5>
                        <div class="card">
                            <div class="card-body">
                                <pre class="mb-0"><code>SMSPresentationConfiguration.cs
??? AddPresentationServices()
?   ??? AddUIHelperServices()           # INotificationHelper, DialogService
?   ??? AddStaticAuthenticationServices() # ISMSSessionService, ICurrentUserService
?   ??? AddPDXSMSApiServices()          # IPDXSMSApiService, Business Logic
?   ??? AddSMSSwaggerServices()         # Swagger/OpenAPI Documentation
?   ??? AddApiSecurityServices()        # ApiKeyAuthenticationFilter
??? AddPresentationMiddleware()         # HttpContextAccessor, Middleware
??? ConfigurePresentationOptions()      # IIS Options, Component Settings</code></pre>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-4">
                        <h5>? Architecture Benefits:</h5>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="card h-100 border-success">
                                    <div class="card-body text-center">
                                        <div class="text-success display-6">??</div>
                                        <h6 class="text-success">Testability</h6>
                                        <p class="small mb-0">Services can be easily mocked and tested independently</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card h-100 border-info">
                                    <div class="card-body text-center">
                                        <div class="text-info display-6">??</div>
                                        <h6 class="text-info">Maintainability</h6>
                                        <p class="small mb-0">Centralized configuration makes changes easier</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card h-100 border-warning">
                                    <div class="card-body text-center">
                                        <div class="text-warning display-6">??</div>
                                        <h6 class="text-warning">Organization</h6>
                                        <p class="small mb-0">Logical grouping of related services</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card h-100 border-primary">
                                    <div class="card-body text-center">
                                        <div class="text-primary display-6">??</div>
                                        <h6 class="text-primary">Reusability</h6>
                                        <p class="small mb-0">Extensions can be reused across projects</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <h5>??? Configuration Control:</h5>
                        <div class="alert alert-light">
                            <div class="row">
                                <div class="col-md-6">
                                    <h6>Feature Flags:</h6>
                                    <ul class="mb-0">
                                        <li><code>ExternalApiEnabled</code> - Controls API endpoints</li>
                                        <li><code>SwaggerInProduction</code> - Controls Swagger in production</li>
                                        <li><code>ErrorNotifications</code> - Controls error notifications</li>
                                        <li><code>SuccessNotifications</code> - Controls success notifications</li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <h6>Configuration Sections:</h6>
                                    <ul class="mb-0">
                                        <li><code>SecurityHeaders</code> - Security header configuration</li>
                                        <li><code>Swagger</code> - API documentation settings</li>
                                        <li><code>ApiAuthentication</code> - API key management</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</div>

