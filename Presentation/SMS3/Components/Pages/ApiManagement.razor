@page "/api-management"
@using Microsoft.FeatureManagement

<PageTitle>API Management - SMS3</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">?? External API Management</h4>
                    <small>Control and monitor external API endpoints</small>
                </div>
                <div class="card-body">
                    
                    <div class="row">
                        <div class="col-md-6">
                            <h5>?? Current API Status:</h5>
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span><strong>External API:</strong></span>
                                        @if (IsExternalApiEnabled)
                                        {
                                            <span class="badge bg-success fs-6">?? ENABLED</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger fs-6">?? DISABLED</span>
                                        }
                                    </div>
                                    
                                    @if (IsExternalApiEnabled)
                                    {
                                        <div class="alert alert-success">
                                            <h6>? Available Endpoints:</h6>
                                            <ul class="mb-0">
                                                <li><code>POST /api/pdxsms</code> - Submit reports</li>
                                                <li><code>GET /api/pdxsms/hazard-categories</code> - Reference data</li>
                                                <li><code>GET /api/pdxsms/hazard-types</code> - Reference data</li>
                                                <li><code>GET /api/pdxsms/reference-data</code> - Complete reference data</li>
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning">
                                            <h6>?? API Status:</h6>
                                            <p class="mb-0">External API endpoints are currently <strong>disabled</strong>. 
                                            All API calls will return 404 Not Found.</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <h5>?? Configuration:</h5>
                            <div class="card">
                                <div class="card-body">
                                    <h6>Feature Flag Control:</h6>
                                    <p>The API is controlled by the <code>ExternalApiEnabled</code> feature flag in <code>appsettings.json</code>:</p>
                                    
                                    <pre class="bg-light p-3 rounded">
<code>"FeatureManagement": {
  "ExternalApiEnabled": @(IsExternalApiEnabled ? "true" : "false"),
  ...
}</code></pre>
                                    
                                    <div class="mt-3">
                                        <h6>?? To Enable/Disable:</h6>
                                        <ol>
                                            <li>Edit <code>appsettings.json</code></li>
                                            <li>Change <code>ExternalApiEnabled</code> to <code>@(!IsExternalApiEnabled ? "true" : "false")</code></li>
                                            <li>Restart the application</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-4">
                        <h5>??? Architecture Benefits:</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h6 class="text-primary">?? Clean Program.cs</h6>
                                        <p class="small mb-0">API endpoints extracted from Program.cs into dedicated classes for better organization and maintainability.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h6 class="text-success">?? Security Control</h6>
                                        <p class="small mb-0">Feature flags provide instant enable/disable capability for security incidents or maintenance windows.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h6 class="text-info">?? Separation of Concerns</h6>
                                        <p class="small mb-0">Business logic separated into services, endpoints into extension methods, models into dedicated classes.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-4">
                        <h5>?? File Structure:</h5>
                        <div class="alert alert-light">
                            <pre class="mb-0"><code>SMS3/Api/
??? Models/
?   ??? PDXSMSApiModels.cs          # Request/Response models
??? Endpoints/
?   ??? PDXSMSApiEndpoints.cs       # API endpoint definitions
??? Services/
?   ??? IPDXSMSApiService.cs        # Service interface
?   ??? PDXSMSApiService.cs         # Business logic implementation
??? Extensions/
    ??? ApiServicesExtensions.cs    # DI registration

Program.cs (cleaned up):
- app.MapPDXSMSApiEndpoints();      # Single line replaces 200+ lines</code></pre>
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private IFeatureManager FeatureManager { get; set; } = default!;
    
    private bool IsExternalApiEnabled { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        IsExternalApiEnabled = await FeatureManager.IsEnabledAsync("ExternalApiEnabled");
    }
}