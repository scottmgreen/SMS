@page "/dashboard"
@using Radzen
@using Radzen.Blazor

<PageTitle>Dashboard - SMS3</PageTitle>

<RadzenRow Gap="1rem">
    <RadzenColumn Size="12">
        <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1" class="rz-pt-8">
            SMS Dashboard
        </RadzenText>
    </RadzenColumn>
</RadzenRow>

<!-- Key Metrics Cards -->
<RadzenRow Gap="1rem" class="rz-my-4">
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenCard Variant="Variant.Outlined" class="rz-text-align-center">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                <RadzenIcon Icon="assignment" Style="font-size: 2rem; color: var(--rz-primary);" />
                <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@TotalReports</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">Total Reports</RadzenText>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenCard Variant="Variant.Outlined" class="rz-text-align-center">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                <RadzenIcon Icon="warning" Style="font-size: 2rem; color: var(--rz-warning);" />
                <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@ActiveHazards</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">Active Hazards</RadzenText>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenCard Variant="Variant.Outlined" class="rz-text-align-center">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                <RadzenIcon Icon="pending" Style="font-size: 2rem; color: var(--rz-info);" />
                <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@PendingAssessments</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">Pending Assessments</RadzenText>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenCard Variant="Variant.Outlined" class="rz-text-align-center">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                <RadzenIcon Icon="check_circle" Style="font-size: 2rem; color: var(--rz-success);" />
                <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@CompletedActions</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">Completed Actions</RadzenText>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<!-- Charts Row -->
<RadzenRow Gap="1rem" class="rz-my-4">
    <RadzenColumn Size="12" SizeLG="6">
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                <RadzenText TextStyle="TextStyle.H5" Style="margin: 0;">Reports by Month</RadzenText>
                <RadzenChart>
                    <RadzenColumnSeries Data="@ReportsByMonth" CategoryProperty="Label" ValueProperty="Value" Title="Reports">
                    </RadzenColumnSeries>
                    <RadzenCategoryAxis Padding="20" />
                    <RadzenValueAxis>
                        <RadzenGridLines Visible="true" />
                        <RadzenAxisTitle Text="Number of Reports" />
                    </RadzenValueAxis>
                </RadzenChart>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    
    <RadzenColumn Size="12" SizeLG="6">
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                <RadzenText TextStyle="TextStyle.H5" Style="margin: 0;">Hazards by Type</RadzenText>
                <RadzenChart>
                    <RadzenDonutSeries Data="@HazardsByType" CategoryProperty="Label" ValueProperty="Value" Title="Hazards">
                    </RadzenDonutSeries>
                    <RadzenLegend Position="LegendPosition.Right" />
                </RadzenChart>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<!-- Recent Activity -->
<RadzenRow Gap="1rem" class="rz-my-4">
    <RadzenColumn Size="12">
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                <RadzenText TextStyle="TextStyle.H5" Style="margin: 0;">Recent Activity</RadzenText>
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                    <RadzenCard Variant="Variant.Text" class="rz-border-radius-1">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="circle" Style="color: var(--rz-success); font-size: 0.8rem;" />
                            <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0;">New hazard reported - Aircraft Ground Equipment</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; margin-left: auto;">2 hours ago</RadzenText>
                        </RadzenStack>
                    </RadzenCard>
                    <RadzenCard Variant="Variant.Text" class="rz-border-radius-1">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="circle" Style="color: var(--rz-info); font-size: 0.8rem;" />
                            <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0;">Risk assessment completed - Runway Operations</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; margin-left: auto;">4 hours ago</RadzenText>
                        </RadzenStack>
                    </RadzenCard>
                    <RadzenCard Variant="Variant.Text" class="rz-border-radius-1">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="circle" Style="color: var(--rz-warning); font-size: 0.8rem;" />
                            <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0;">Action item overdue - Safety Training Update</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; margin-left: auto;">1 day ago</RadzenText>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>
