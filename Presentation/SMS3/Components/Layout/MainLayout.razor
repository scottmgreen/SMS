@inherits LayoutComponentBase
@implements IEventReceiver
@implements IDisposable
@using Radzen
@using SMS3.Components.Layout
@using SMS3.Components.Shared
@using SMS3.Configuration.Extensions

@using SMS_Application.Services
@using SMS_Domain.Entities
@using SMS_Domain.Enums


<div class="d-flex flex-column min-vh-100 sms-main-layout">
    <!-- Horizontal Navigation -->
    <header class="sms-main-header">
        <NavMenu OnLogoutRequested="@OnLogoutRequested" />
    </header>
    
    <!-- Main Content Area -->
    <main class="flex-grow-1 sms-main-content">
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<!-- Radzen Dialog Components - Required for dialogs to work -->
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

<!-- EventBus Notification Display Component - Centralized notification coordination -->

<script>
window.smsLogoutSync = window.smsLogoutSync || {
    _channelName: 'sms-logout-sync-v1',
    _dotNetRef: null,
    _receiverId: null,
    _storageHandler: null,

    register: function (dotNetRef) {
        this._dotNetRef = dotNetRef;

        if (this._storageHandler) {
            return;
        }

        const self = this;
        this._storageHandler = function (event) {
            if (!event || event.key !== self._channelName || !event.newValue || !self._dotNetRef) {
                return;
            }

            try {
                const payload = JSON.parse(event.newValue);
                if (!payload || !payload.receiverKey) {
                    return;
                }

                self._dotNetRef.invokeMethodAsync('ReceiveBrowserLogoutAsync', payload.receiverKey)
                    .catch(function () {
                        // Ignore transient circuit disconnects.
                    });
            } catch {
                // Ignore malformed payload.
            }
        };

        window.addEventListener('storage', this._storageHandler);
    },

    broadcast: function (receiverKey) {
        if (!receiverKey || !window.localStorage) {
            return;
        }

        const payload = {
            receiverKey: receiverKey,
            ts: Date.now()
        };

        localStorage.setItem(this._channelName, JSON.stringify(payload));
    }
};
</script>


<div id="blazor-error-ui" class="sms-error-ui">
    <div class="sms-error-content">
        <i class="fas fa-exclamation-triangle me-2"></i>
        An unhandled error has occurred.
        <a href="" class="reload sms-error-reload">Reload</a>
        <a class="dismiss sms-error-dismiss">??</a>
    </div>
</div>


}

<!-- Shared layout styles are now in wwwroot/css/shared-layouts.css -->

