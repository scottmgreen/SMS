@inherits LayoutComponentBase
@using SMS3.Components.Layout
@using SMS_Domain.Entities
@using SMS_Domain.Enums


<div class="d-flex flex-column min-vh-100 sms-main-layout">
    <!-- Horizontal Navigation -->
    <header class="sms-main-header">
        <NavMenu OnLogoutRequested="@OnLogoutRequested" />
    </header>
    
    <!-- Main Content Area -->
    <main class="flex-grow-1 sms-main-content">
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<!-- Radzen Dialog Components - Required for dialogs to work -->
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

<div id="blazor-error-ui" class="sms-error-ui">
    <div class="sms-error-content">
        <i class="fas fa-exclamation-triangle me-2"></i>
        An unhandled error has occurred.
        <a href="" class="reload sms-error-reload">Reload</a>
        <a class="dismiss sms-error-dismiss">🗙</a>
    </div>
</div>

@code {
    [Inject] private ICurrentUserService CurrentUserService { get; set; } = default!;
    [Inject] private ISMSSessionService SessionService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IWebHostEnvironment Environment { get; set; } = default!;
    [Inject] private IMediator Mediator { get; set; } = default!;
    [Inject] private ILogger<MainLayout> Logger { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // MainLayout initialized
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // MainLayout first render complete
        }
    }

    /// <summary>
    /// Handle logout request from NavMenu - NOW WITH PROPER AUDIT RECORDING
    /// </summary>
    private async Task OnLogoutRequested()
    {
        var logoutStartTime = DateTime.UtcNow;
        string currentUserName = "Unknown";
        SMSUserType userType = SMSUserType.Application; // Fixed: Use correct enum value
        string sessionId = "Unknown";
        TimeSpan sessionDuration = TimeSpan.Zero;

        try
        {
            // Get current user info BEFORE clearing session
            if (CurrentUserService.IsAuthenticated)
            {
                currentUserName = CurrentUserService.UserDisplayName ?? CurrentUserService.UserCode ?? "Unknown";
                
                // Get user type from the service
                var userTypeEnum = CurrentUserService.GetUserTypeEnum();
                if (userTypeEnum != null)
                {
                    userType = userTypeEnum;
                }
                
                // Generate a session ID for audit purposes (since we don't track it elsewhere)
                sessionId = $"SESSION_{DateTime.UtcNow:yyyyMMddHHmmss}";
                
                // Calculate session duration based on login time
                if (CurrentUserService.LoginTime.HasValue)
                {
                    sessionDuration = logoutStartTime - CurrentUserService.LoginTime.Value;
                }
                else
                {
                    sessionDuration = TimeSpan.FromMinutes(30); // Default fallback
                }
            }

            Logger.LogInformation("🔐 Starting logout process for user: {UserName}", currentUserName);

            // 🔐 Record logout audit BEFORE clearing session (and wait for it)
            try
            {
                var logoutCommand = new RecordLogoutCommand(
                    currentUserName,
                    userType,
                    sessionId,
                    "Manual", // Logout type - user clicked logout
                    sessionDuration
                );
                
                var auditResult = await Mediator.SendAsync(logoutCommand, CancellationToken.None);
                Logger.LogInformation("✅ Logout audit recorded for user: {UserName}, Result: {IsSuccess}", 
                    currentUserName, auditResult.IsSuccess);
            }
            catch (Exception auditEx)
            {
                Logger.LogError(auditEx, "❌ Failed to record logout audit for {UserName}", currentUserName);
                // Continue with logout even if audit fails - don't block user
            }

            // Clear authentication using the proper session service
            await SessionService.ClearSMSSessionAsync();
            
            Logger.LogInformation("✅ Session cleared for user: {UserName}", currentUserName);
            
            // Navigate to login page
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Error during logout process for user: {UserName}", currentUserName);
            
            // Still try to clear session and redirect even if audit fails
            try
            {
                await SessionService.ClearSMSSessionAsync();
                Navigation.NavigateTo("/login", forceLoad: true);
            }
            catch (Exception clearEx)
            {
                Logger.LogError(clearEx, "❌ Critical: Failed to clear session during logout");
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
    }
}

<style>
/* =============================================================================
   SMS MAIN LAYOUT - SIMPLE AND CLEAN
   ============================================================================= */

.sms-main-layout {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.sms-main-header {
    position: sticky;
    top: 0;
    z-index: 1030;
    background-color: #212e61 !important;
    color: white !important;
}

.sms-main-content {
    min-height: calc(100vh - 70px);
}

/* Error UI Styling */
.sms-error-ui {
    background: #212e61 !important;
    color: white !important;
    padding: 1rem;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    display: none;
    border-top: 2px solid white !important;
}

.sms-error-content {
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
}

.sms-error-reload {
    color: white !important;
    text-decoration: underline;
    margin-left: 1rem;
    font-weight: 600;
}

.sms-error-reload:hover {
    color: white !important;
    opacity: 0.8;
}

.sms-error-dismiss {
    margin-left: 1rem;
    background: none;
    border: none;
    color: white !important;
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0 0.5rem;
    border-radius: 0.25rem;
    transition: background-color 0.2s;
}

.sms-error-dismiss:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

/* Ensure consistent spacing */
.container-fluid {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
}

/* =============================================================================
   END SMS MAIN LAYOUT
   ============================================================================= */
</style>