@inherits LayoutComponentBase
@using SMS3.Components.Layout
@using SMS_Domain.Entities
@using SMS_Domain.Enums
@using SMS_Application.Services


<div class="d-flex flex-column min-vh-100 sms-main-layout">
    <!-- Horizontal Navigation -->
    <header class="sms-main-header">
        <NavMenu OnLogoutRequested="@OnLogoutRequested" />
    </header>
    
    <!-- Main Content Area -->
    <main class="flex-grow-1 sms-main-content">
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<!-- Radzen Dialog Components - Required for dialogs to work -->
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

<div id="blazor-error-ui" class="sms-error-ui">
    <div class="sms-error-content">
        <i class="fas fa-exclamation-triangle me-2"></i>
        An unhandled error has occurred.
        <a href="" class="reload sms-error-reload">Reload</a>
        <a class="dismiss sms-error-dismiss">🗙</a>
    </div>
</div>

@code {
    [Inject] private ICurrentUserService CurrentUserService { get; set; } = default!;
    [Inject] private ISMSSessionService SessionService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IWebHostEnvironment Environment { get; set; } = default!;
    [Inject] private IMediator Mediator { get; set; } = default!;
    [Inject] private ILogger<MainLayout> Logger { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // MainLayout initialized
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // MainLayout first render complete
        }
    }

    /// <summary>
    /// Handle logout request from NavMenu - STATIC AUTHENTICATION APPROACH
    /// </summary>
    private async Task OnLogoutRequested()
    {
        var logoutStartTime = DateTime.UtcNow;
        string currentUserName = "Unknown";
        SMSUserType userType = SMSUserType.Application;
        string sessionId = "Unknown";
        TimeSpan sessionDuration = TimeSpan.Zero;

        try
        {
            // Get current user info BEFORE clearing static authentication
            if (CurrentUserService.IsAuthenticated)
            {
                currentUserName = CurrentUserService.UserDisplayName ?? CurrentUserService.UserCode ?? "Unknown";
                
                // Get user type from the service
                var userTypeEnum = CurrentUserService.GetUserTypeEnum();
                if (userTypeEnum != null)
                {
                    userType = userTypeEnum;
                }
                
                // Generate a session ID for audit purposes
                sessionId = $"STATIC_SESSION_{DateTime.UtcNow:yyyyMMddHHmmss}";
                
                // Calculate session duration based on login time
                if (CurrentUserService.LoginTime.HasValue)
                {
                    sessionDuration = logoutStartTime - CurrentUserService.LoginTime.Value;
                }
                else
                {
                    sessionDuration = TimeSpan.FromMinutes(30); // Default fallback
                }
            }

            Logger.LogInformation("🔐 Starting logout process for user: {UserName}", currentUserName);

            // 🔐 Record logout audit BEFORE clearing authentication (and wait for it)
            try
            {
                var logoutCommand = new RecordLogoutCommand(
                    currentUserName,
                    userType,
                    sessionId,
                    "Manual", // Logout type - user clicked logout
                    sessionDuration
                );
                
                var auditResult = await Mediator.SendAsync(logoutCommand, CancellationToken.None);
                Logger.LogInformation("✅ Logout audit recorded for user: {UserName}, Result: {IsSuccess}", 
                    currentUserName, auditResult.IsSuccess);
            }
            catch (Exception auditEx)
            {
                Logger.LogError(auditEx, "❌ Failed to record logout audit for {UserName}", currentUserName);
                // Continue with logout even if audit fails
            }

            // **CLEAR STATIC AUTHENTICATION - No session clearing needed**
            StaticCurrentUserService.ClearAuthenticationState();
            
            Logger.LogInformation("✅ Static authentication cleared for user: {UserName}", currentUserName);
            
            // Navigate to HOME PAGE, not login - let them see the guest view
            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Error during logout process for user: {UserName}", currentUserName);
            
            // Still try to clear authentication and redirect even if audit fails
            try
            {
                StaticCurrentUserService.ClearAuthenticationState();
                Navigation.NavigateTo("/", forceLoad: true);
            }
            catch (Exception clearEx)
            {
                Logger.LogError(clearEx, "❌ Critical: Failed to clear static authentication during logout");
                Navigation.NavigateTo("/", forceLoad: true);
            }
        }
    }
}

<!-- Shared layout styles are now in wwwroot/css/shared-layouts.css -->