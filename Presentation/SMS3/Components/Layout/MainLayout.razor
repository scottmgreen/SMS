@inherits LayoutComponentBase
@using SMS3.Components.Layout
@using SMS_Domain.Entities
@using SMS_Domain.Enums


<div class="d-flex flex-column min-vh-100 sms-main-layout">
    <!-- Cascading Authentication State to all child components -->
    <CascadingValue Value="@AuthService" Name="AuthService">
        <!-- Horizontal Navigation -->
        <header class="sms-main-header">
            <NavMenu OnLogoutRequested="@OnLogoutRequested" />
        </header>
        
        <!-- Main Content Area -->
        <main class="flex-grow-1 sms-main-content">
            <article class="content px-4">
                @Body
            </article>
        </main>
    </CascadingValue>
</div>

<!-- Radzen Dialog Components - Required for dialogs to work -->
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

<div id="blazor-error-ui" class="sms-error-ui">
    <div class="sms-error-content">
        <i class="fas fa-exclamation-triangle me-2"></i>
        An unhandled error has occurred.
        <a href="" class="reload sms-error-reload">Reload</a>
        <a class="dismiss sms-error-dismiss">🗙</a>
    </div>
</div>

@code {
    [Inject] private AuthenticationService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IWebHostEnvironment Environment { get; set; } = default!;

    /// <summary>
    /// Handle logout request from NavMenu
    /// </summary>
    private async Task OnLogoutRequested()
    {
        // Clear authentication
        AuthService.ClearAuthentication();
        
        // Navigate to login page
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}

<style>
/* =============================================================================
   SMS MAIN LAYOUT - SIMPLE AND CLEAN
   ============================================================================= */

.sms-main-layout {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.sms-main-header {
    position: sticky;
    top: 0;
    z-index: 1030;
    background-color: #212e61 !important;
    color: white !important;
}

.sms-main-content {
    min-height: calc(100vh - 70px);
}

/* Error UI Styling */
.sms-error-ui {
    background: #212e61 !important;
    color: white !important;
    padding: 1rem;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    display: none;
    border-top: 2px solid white !important;
}

.sms-error-content {
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
}

.sms-error-reload {
    color: white !important;
    text-decoration: underline;
    margin-left: 1rem;
    font-weight: 600;
}

.sms-error-reload:hover {
    color: white !important;
    opacity: 0.8;
}

.sms-error-dismiss {
    margin-left: 1rem;
    background: none;
    border: none;
    color: white !important;
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0 0.5rem;
    border-radius: 0.25rem;
    transition: background-color 0.2s;
}

.sms-error-dismiss:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

/* Ensure consistent spacing */
.container-fluid {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
}

/* =============================================================================
   END SMS MAIN LAYOUT
   ============================================================================= */
</style>