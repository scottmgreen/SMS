@inherits LayoutComponentBase

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <!-- SMS COLOR SYSTEM - EXACT PALETTE COMPLIANCE -->
    <link rel="stylesheet" href="css/sms-colors.css" />
    
    <!-- Radzen Theme -->
    <RadzenTheme Theme="material" />
    
    <title>Login - SMS3</title>
</head>

<body class="sms-login-body">
    <!-- SMS Header - Consistent with MainLayout -->
    <nav class="navbar navbar-expand-lg sms-login-nav">
        <div class="container-fluid">
            <a class="navbar-brand sms-login-brand" href="/">
                <i class="fas fa-plane-departure me-2 sms-login-brand-icon"></i>
                PDX SMS
            </a>
            <div class="navbar-text sms-login-subtitle">
                <small>Safety Management System</small>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="sms-login-container">
        @Body
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

<style>
/* =============================================================================
   SMS LOGIN LAYOUT - EXACT COLOR COMPLIANCE
   ============================================================================= */

.sms-login-body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
        background: linear-gradient(135deg, var(--sms-blue-dark-bold) 0%, var(--sms-teal-light) 100%) !important;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* Header Navigation - Match MainLayout */
.sms-login-nav {
    background-color: var(--sms-blue-dark-bold) !important;
        border-bottom: 2px solid var(--sms-blue-dark-bold) !important;
    box-shadow: 0 0.125rem 0.25rem rgba(33, 46, 97, 0.25) !important;
    padding: 0.75rem 0 !important;
}

.sms-login-brand {
    color: white !important;
    font-weight: 700 !important;
    font-size: 1.5rem !important;
    text-decoration: none !important;
}

.sms-login-brand:hover {
            color: var(--sms-blue-dark-bold) !important;
    text-decoration: none !important;
}

.sms-login-brand-icon {
        color: white !important;
}

.sms-login-subtitle {
        color: var(--sms-blue-dark-bold) !important;
    font-weight: 400 !important;
    font-size: 0.9rem !important;
}

/* Main Content Container */
.sms-login-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 70px);
    padding: 2rem 1rem;
}

/* =============================================================================
   END SMS LOGIN LAYOUT STYLING
   ============================================================================= */
</style>
</html>