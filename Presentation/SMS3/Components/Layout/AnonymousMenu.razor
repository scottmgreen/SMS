@using Radzen
@using Radzen.Blazor
@using SMS3.Configuration.Extensions
@using SMS3.Security

@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment
@inject ISecureRoutingService SecureRoutingService

<!-- RADZEN MENU NAVIGATION - MATCHING NavMenu STYLE -->
<div style="width: 100%; height: 65px; display: flex; justify-content: space-between; align-items: center; padding: 0 1.5rem; background-color: #212e61;">
    
    <!-- Brand Logo with Environment Detection -->
    <a class="navbar-brand sms-brand @BrandCssClass" href="/">
        <i class="fas fa-plane-departure me-2"></i>
        PDX SMS @(EnvironmentSuffix)
    </a>

    <!-- Only show menu items if NOT on PDX or Login pages -->
    @if (!IsOnRestrictedPage)
    {
        <!-- RIGHT SIDE RADZEN MENU -->
        <div style="display: flex; gap: 1rem; align-items: center;">
            <!-- External Reporting Menu -->
            <div class="nav-item">
                <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                    <RadzenMenuItem Text="Submit Report" Value='"/ExternalReporting"' Icon="security"></RadzenMenuItem>
                </RadzenMenu>
            </div>
            <div class="nav-item">
                <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                    <RadzenMenuItem Text="Track Report Status" Value='"/ExternalReporting/TrackStatus"' Icon="search"></RadzenMenuItem>
                </RadzenMenu>
            </div>
        </div>
    }
    
   
</div>

