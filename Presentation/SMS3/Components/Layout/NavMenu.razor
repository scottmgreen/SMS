@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using SMS_Application.Interfaces
@using SMS_Domain.Enums
@using SMS3.Components.Layout
@using Radzen
@using Radzen.Blazor
@inject IJSRuntime JSRuntime
@inject ILogger<NavMenu> Logger
@inject NavigationManager Navigation

<!-- SMS Navigation with Radzen Components -->
<nav class="navbar navbar-expand-lg sms-nav">
    <div class="container-fluid">
        <!-- Brand Logo -->
        <a class="navbar-brand sms-brand" href="/">
            <i class="fas fa-plane-departure me-2 sms-brand-icon"></i>
            PDX SMS
        </a>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler sms-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navigation Links -->
        <div class="collapse navbar-collapse" id="navbarNav">
            @if (AuthState?.IsAuthenticated == true)
            {
                <div class="navbar-nav me-auto d-flex flex-row align-items-center">
                    <!-- Dashboard -->
                    <div class="nav-item me-3">
                        <a class="nav-link sms-nav-link" href="/dashboard">
                            <i class="fas fa-tachometer-alt me-1"></i> Dashboard
                        </a>
                    </div>

                    <!-- SMS Risk Management Menu -->
                    <div class="nav-item me-3">
                        <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                            <RadzenMenuItem Text="SMS Risk Management" Icon="shield" class="sms-menu-item">
                                <RadzenMenuItem Text="Create Hazard Report" Path="/SMSRiskManagement/HazardReporting" Icon="add_circle"></RadzenMenuItem>
                               @*  <RadzenMenuItem Text="Reports" Path="/SMSRiskManagement/Reports" Icon="assignment"></RadzenMenuItem> *@
                                <RadzenMenuItem Text="Report Processing" Path="/SMSRiskManagement/ReportProcessing" Icon="settings"></RadzenMenuItem>
                               @*  <RadzenMenuItem Text="Hazards" Path="/SMSRiskManagement/Hazards" Icon="warning"></RadzenMenuItem> *@
                                <!-- Investigations -->
                                <RadzenMenuItem Text="Investigate" Icon="search">
                                    <RadzenMenuItem Text="Active Investigations" Path="" Icon="assignment"></RadzenMenuItem>
                                    <RadzenMenuItem Text="Interview Calendar" Path="" Icon="diversity_3"></RadzenMenuItem>
                                </RadzenMenuItem>

                            </RadzenMenuItem>
                        </RadzenMenu>
                    </div>

                    <!-- Listings Menu -->
                    <div class="nav-item me-3">
                        <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                            <RadzenMenuItem Text="Listings" Icon="list" class="sms-menu-item">
                                <RadzenMenuItem Text="Reports" Path="/Listings/Reports" Icon="assignment"></RadzenMenuItem>
                                <RadzenMenuItem Text="Airport Shared Data" Path="/Listings/AirportSharedDatasets" Icon="dataset"></RadzenMenuItem>
                                <RadzenMenuItem Text="Hazards" Path="/Listings/Hazards" Icon="warning"></RadzenMenuItem>
                                <RadzenMenuItem Text="Risk Assessments" Path="/Listings/RiskAssessments" Icon="assessment"></RadzenMenuItem>
                                <RadzenMenuItem Text="Risk Analysis" Path="/Listings/RiskAnalysis" Icon="analytics"></RadzenMenuItem>
                                <RadzenMenuItem Text="Mitigations" Path="/Listings/Mitigations" Icon="security"></RadzenMenuItem>
                                <RadzenMenuItem Text="Report Validations" Path="/Listings/ReportValidations" Icon="fact_check"></RadzenMenuItem>
                                <RadzenMenuItem Text="Scoring Panels" Path="/Listings/ScoringPanels" Icon="group"></RadzenMenuItem>
                                <RadzenMenuItem Text="Investigations" Path="/Listings/Investigations" Icon="search"></RadzenMenuItem>
                                <RadzenMenuItem Text="Hazard Locations" Path="/Listings/HazardLocations" Icon="place"></RadzenMenuItem>
                                <RadzenMenuItem Text="Hazard Files" Path="/Listings/HazardFiles" Icon="attach_file"></RadzenMenuItem>
                            </RadzenMenuItem>
                        </RadzenMenu>
                    </div>

                    <!-- SMS Assurance Menu -->
                    <div class="nav-item me-3">
                        <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                            <RadzenMenuItem Text="SMS Assurance" Icon="verified_user" class="sms-menu-item">
                                <!-- Add pages when they exist -->
                            </RadzenMenuItem>
                        </RadzenMenu>
                    </div>

                    <!-- SMS Policy Menu -->
                    <div class="nav-item me-3">
                        <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                            <RadzenMenuItem Text="SMS Policy" Icon="policy" class="sms-menu-item">
                                <RadzenMenuItem Text="Safety Policy" Path="/SMSPolicy/SafetyPolicy" Icon="description"></RadzenMenuItem>
                                <RadzenMenuItem Text="Organizational Structure" Path="/SMSPolicy/OrganizationalStructure" Icon="account_tree"></RadzenMenuItem>
                            </RadzenMenuItem>
                        </RadzenMenu>
                    </div>

                    <!-- SMS Promotion Menu -->
                    <div class="nav-item me-3">
                        <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                            <RadzenMenuItem Text="SMS Promotion" Icon="trending_up" class="sms-menu-item">
                                <!-- Add pages when they exist -->
                            </RadzenMenuItem>
                        </RadzenMenu>
                    </div>

                    <!-- System Administration Menu -->
                    @if (AuthState.HasAdministrativeAccess())
                    {
                        <div class="nav-item me-3">
                            <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                                <RadzenMenuItem Text="System" Icon="settings" class="sms-menu-item">
                                    <!-- User Management -->
                                    <RadzenMenuItem Text="User Management" Icon="people">
                                        <RadzenMenuItem Text="Application Users" Path="/System/UserManagement/ApplicationUsers" Icon="person"></RadzenMenuItem>
                                        <RadzenMenuItem Text="Stakeholder Users" Path="/System/UserManagement/StakeholderUsers" Icon="group"></RadzenMenuItem>
                                        <RadzenMenuItem Text="Organizational Users" Path="/System/UserManagement/OrganizationalUsers" Icon="corporate_fare"></RadzenMenuItem>
                                    </RadzenMenuItem>
                                    
                                    <!-- User Groups -->
                                    <RadzenMenuItem Text="User Groups" Icon="groups">
                                        <RadzenMenuItem Text="Application Groups" Path="/System/UserGroups/ApplicationGroups" Icon="corporate_fare"></RadzenMenuItem>
                                        <RadzenMenuItem Text="Stakeholder Groups" Path="/System/UserGroups/StakeholderGroups" Icon="diversity_3"></RadzenMenuItem>
                                        <RadzenMenuItem Text="Organizational Groups" Path="/System/UserGroups/OrganizationalGroups" Icon="diversity_3"></RadzenMenuItem>
                                    </RadzenMenuItem>
                                    
                                    <!-- User Roles -->
                                    <RadzenMenuItem Text="User Roles" Icon="admin_panel_settings">
                                        <RadzenMenuItem Text="User Roles" Path="/System/UserRoles/UserRoles" Icon="badge"></RadzenMenuItem>
                                    </RadzenMenuItem>
                                </RadzenMenuItem>
                            </RadzenMenu>
                        </div>
                    }

                    <!-- Analytics -->
                    <div class="nav-item me-3">
                        <a class="nav-link sms-nav-link" href="/Reports">
                            <i class="fas fa-chart-bar me-1"></i> Analytics
                        </a>
                    </div>
                </div>

                <!-- User Profile Menu using RadzenProfileMenu -->
                <div class="navbar-nav ms-auto">
                    <div class="nav-item">
                        <RadzenProfileMenu class="sms-profile-menu">
                            <Template>
                                <div class="d-flex align-items-center p-2">
                                    @if (!string.IsNullOrEmpty(AuthState.Email))
                                    {
                                        <RadzenGravatar Email="@AuthState.Email" class="me-2" Size="32" />
                                    }
                                    else
                                    {
                                        <RadzenIcon Icon="account_circle" class="me-2" Style="font-size: 32px; color: white;" />
                                    }
                                    <div class="d-flex flex-column align-items-start">
                                        <small class="mb-0 fw-bold" style="color: white;">@AuthState.DisplayName</small>
                                        <small style="color: white; opacity: 0.7;">@AuthState.UserType User</small>
                                    </div>
                                </div>
                            </Template>
                            <ChildContent>
                                <RadzenProfileMenuItem Text="Profile" Path="/Profile" Icon="person" />
                                <RadzenProfileMenuItem Text="My Dashboard" Path="/dashboard" Icon="dashboard" />
                                <RadzenProfileMenuItem Text="Settings" Path="/Settings" Icon="settings" />
                                <RadzenProfileMenuItem Text="Help" Path="/Help" Icon="help" />
                                <RadzenProfileMenuItem Text="About" Path="/About" Icon="info" />
                                <div class="rz-separator"></div>
                                <!-- Custom Logout using Radzen structure -->
                                <div class="rz-menuitem">
                                    <a class="logout-menuitem-link " href="javascript:void(0)" @onclick="OnLogoutClick" @onclick:preventDefault="true">
                                        <i class="fas fa-sign-out-alt me-2"></i>
                                        Logout
                                    </a>
                                </div>
                            </ChildContent>
                        </RadzenProfileMenu>
                    </div>
                </div>
            }
            else
            {
                <!-- Guest Navigation -->
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link sms-nav-link" href="/Login">
                            <i class="fas fa-sign-in-alt me-1"></i> Login
                        </a>
                    </li>
                </ul>
            }
        </div>
    </div>
</nav>

@code {
    [CascadingParameter(Name = "AuthState")]
    public AuthenticationState? AuthState { get; set; }

    [Parameter]
    public EventCallback OnLogoutRequested { get; set; }

    private async Task OnMenuClick(MenuItemEventArgs args)
    {
        if (!string.IsNullOrEmpty(args.Value?.ToString()))
        {
            var value = args.Value.ToString();
            
            if (value == "logout")
            {
                await Logout();
            }
            else if (value.StartsWith("/"))
            {
                Navigation.NavigateTo(value);
            }
        }
    }

    private async Task OnLogoutClick()
    {
        await Logout();
    }

    private async Task Logout()
    {
        // Trigger logout callback to parent layout - let it handle navigation
        await OnLogoutRequested.InvokeAsync();
        
        // Don't navigate here - let HandleLogout in MainLayout handle it
    }
}

