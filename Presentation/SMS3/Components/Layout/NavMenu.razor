<!-- Session Timeout Modal -->
<SessionTimeoutModal OnLogout="@OnLogoutRequested" 
                    OnContinue="@OnSessionContinued" />

<script>
window.smsSessionActivity = window.smsSessionActivity || {
    _isRegistered: false,
    _dotNetRef: null,
    _lastReportedAt: 0,
    _handler: null,

    register: function (dotNetRef) {
        this._dotNetRef = dotNetRef;

        if (this._isRegistered) {
            return;
        }

        const self = this;
        this._handler = function () {
            const now = Date.now();
            if (now - self._lastReportedAt < 5000) {
                return;
            }

            self._lastReportedAt = now;

            if (self._dotNetRef) {
                self._dotNetRef.invokeMethodAsync('ReportClientActivity')
                    .catch(function () {
                        // Ignore transient disconnects during navigation/disposal.
                    });
            }
        };

        window.addEventListener('mousemove', this._handler, { passive: true });
        window.addEventListener('mousedown', this._handler, { passive: true });
        window.addEventListener('keydown', this._handler, { passive: true });
        window.addEventListener('touchstart', this._handler, { passive: true });
        window.addEventListener('scroll', this._handler, { passive: true });
        window.addEventListener('focus', this._handler, { passive: true });
        document.addEventListener('visibilitychange', this._handler, { passive: true });

        this._isRegistered = true;
    }
};
</script>

