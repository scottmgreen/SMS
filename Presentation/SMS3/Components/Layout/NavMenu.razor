                    <!-- Session Timer -->
                    @* <div class="nav-item me-3">
                        <span class="text-white small">Session: @SessionDurationDisplay</span>
                    </div> *@

                    <!-- User Profile Menu -->
                    <div class="nav-item">
                        <RadzenProfileMenu class="sms-profile-menu">
                            <Template>
                                <div class="d-flex align-items-center p-2 user-profile-template" style="cursor: pointer;">
                                    <div class="d-flex flex-column align-items-start">
                                        <small class="mb-0 fw-bold text-white">@CurrentUserService?.UserDisplayName</small>
                                        <small class="text-white opacity-75">@CurrentUserService?.UserType User</small>
                                    </div>
                                </div>
                            </Template>
                            <ChildContent>
                                <!-- CUSTOM USER PROFILE MODAL TRIGGER -->
                                <div class="rz-menuitem">
                                    <RadzenButton Text="My Profile & Permissions"
                                                  Icon="account_circle"
                                                  ButtonStyle="ButtonStyle.Success"
                                                  Variant="Variant.Text"
                                                  Click="@ShowUserProfileModal"
                                                  Style="width: 100%; justify-content: flex-start;" />
                                </div>
                                <div class="rz-separator"></div>
                                <RadzenProfileMenuItem Text="My Dashboard" Value='"/dashboard"' Icon="dashboard" />
                                <RadzenProfileMenuItem Text="Help" Value='"/Help"' Icon="help" />
                                <RadzenProfileMenuItem Text="About" Value='"/About"' Icon="info" />
                                <div class="rz-separator"></div>
                                <!-- Custom Logout -->
                                <div class="rz-menuitem">
                                    <RadzenButton Text="Logout"
                                                  Icon="logout"
                                                  ButtonStyle="ButtonStyle.Primary"
                                                  Variant="Variant.Text"
                                                  Click="@OnLogoutClick"
                                                  Style="width: 100%; justify-content: flex-start;" />
                                </div>
                            </ChildContent>
                        </RadzenProfileMenu>
                    </div>
                </div>
            }
            else
            {
                <!-- RIGHT SIDE RADZEN MENU -->
                <div style="display: flex; gap: 1rem; align-items: center;">
                    <!-- Confidential Reporting Menu -->
                    <div class="nav-item">
                        <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                            <RadzenMenuItem Text="Submit Report" Value='"/SMSRiskManagement/ConfidentialReporting"' Icon="security"></RadzenMenuItem>
                        </RadzenMenu>
                    </div>
                    <div class="nav-item">
                        <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                            <RadzenMenuItem Text="Track Report Status" Value='"/ConfidentialReporting/TrackStatus"' Icon="search"></RadzenMenuItem>
                        </RadzenMenu>
                    </div>
                    <!-- Login Link -->
                    <div class="nav-item">
                        <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                            <RadzenMenuItem Text="Login" Icon="login" Value='"/login"' class="sms-menu-item"></RadzenMenuItem>
                        </RadzenMenu>
                    </div>
                </div>
            }
        
        </div>
    </div>
</nav>

@code {
    [Inject] private ICurrentUserService CurrentUserService { get; set; } = default!;

    [Parameter]
    public EventCallback OnLogoutRequested { get; set; }

    // Session Timer
    
    private CancellationTokenSource _cancellationTokenSource = new();

    // Environment Detection
    private string BrandCssClass => Environment.IsDevelopment() ? "development" : "";
    private string EnvironmentSuffix => Environment.IsDevelopment() ? "[Development]" : "";

    protected override async Task OnInitializedAsync()
    {
    }

    protected override async Task OnParametersSetAsync()
    {
        // Parameters updated
    }

    
    /// <summary>
    /// Handle menu clicks for SECURE navigation - all URLs automatically encrypted
    /// </summary>
    private async Task OnMenuClick(MenuItemEventArgs args)
    {
        try
        {
            Logger.LogInformation("OnMenuClick called with value: {Value}", args.Value?.ToString());
            
            if (!string.IsNullOrEmpty(args.Value?.ToString()))
            {
                var value = args.Value.ToString();
                if (value.StartsWith("/"))
                {
                    Logger.LogInformation("Navigating to secure URL: {Url}", value);
                    // 🔐 SECURE NAVIGATION - All URLs automatically encrypted
                    Navigation.NavigateToSecure(value);
                }
                else
                {
                    Logger.LogWarning("URL does not start with /: {Url}", value);
                }
            }
            else
            {
                Logger.LogWarning("OnMenuClick called with empty or null value");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in OnMenuClick");
        }
    }

    private async Task OnLogoutClick()
    {
        await OnLogoutRequested.InvokeAsync();
        _cancellationTokenSource?.Cancel();
    }

    // **🔥 USER PROFILE MODAL - USING COMPONENT**
    private async Task ShowUserProfileModal()
    {
        if (CurrentUserService?.IsAuthenticated != true) return;

        var options = new DialogOptions()
        {
            Width = "900px",
            Height = "700px",
            Resizable = true,
            Draggable = true,
            CloseDialogOnOverlayClick = true,
            ShowTitle = true,
            ShowClose = true
        };

        await DialogService.OpenAsync<UserProfileDialog>("User Profile & Permissions",
            new Dictionary<string, object>()
            {
                { "CurrentUserService", CurrentUserService }                
            },
            options);
    }

    public void Dispose()
    {
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
    }
}

