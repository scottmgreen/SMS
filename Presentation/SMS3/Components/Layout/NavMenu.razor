@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using SMS_Application.Interfaces
@using SMS_Domain.Enums
@using SMS_Domain.Entities
@using SMS3.Components.Layout
@using SMS3.Components.Shared
@using SMS3.Extensions
@using Radzen
@using Radzen.Blazor
@inject IJSRuntime JSRuntime
@inject ILogger<NavMenu> Logger
@inject NavigationManager Navigation
@inject Radzen.DialogService DialogService
@inject IWebHostEnvironment Environment

<!-- SMS Navigation with FULL Original Menu Structure -->
<nav class="navbar navbar-expand-lg sms-nav">
    <div class="container-fluid">
        <!-- Brand Logo with Environment Detection -->
        <a class="navbar-brand sms-brand @BrandCssClass" href="/">
            <i class="fas fa-plane-departure me-2"></i>
            PDX SMS @(EnvironmentSuffix)
        </a>

        <!-- Navigation Links -->
        <div class="collapse navbar-collapse" id="navbarNav">
            @if (CurrentUserService?.IsAuthenticated == true)
            {
                <!-- All menu items should be right-justified for authenticated users -->
                <div class="navbar-nav ms-auto d-flex flex-row align-items-center">
                    <!-- SMS Risk Management Menu -->
                    @if (CurrentUserService.CanRead("SMS_RiskManagement"))
                    {
                        <div class="nav-item me-3">
                            <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                                <RadzenMenuItem Text="SMS Risk Management" Icon="shield" class="sms-menu-item">
                                    <RadzenMenuItem Text="Create Hazard Report" Value='"/SMSRiskManagement/HazardReporting"' Icon="add_circle"></RadzenMenuItem>
                                    <RadzenMenuItem Text="Report Processing" Value='"/SMSRiskManagement/ReportProcessing"' Icon="settings"></RadzenMenuItem>
                                    <RadzenMenuItem Text="Search Reports" Value='"/SMSRiskManagement/HazardReportSearch"' Icon="search"></RadzenMenuItem>
                                    <!-- Investigations -->
                                    <RadzenMenuItem Text="Investigate" Icon="search">
                                        <RadzenMenuItem Text="Active Investigations" Value='"/Listings/Investigations"' Icon="assignment"></RadzenMenuItem>
                                        <RadzenMenuItem Text="Interview Calendar" Value='"/SMSRiskManagement/InterviewCalendar"' Icon="diversity_3"></RadzenMenuItem>
                                    </RadzenMenuItem>
                                    <!-- Mitigation -->
                                    <RadzenMenuItem Text="Mitigation" Icon="search">
                                        <RadzenMenuItem Text="Active Mitigations" Value='"/Listings/Mitigations"' Icon="assignment"></RadzenMenuItem>
                                        <RadzenMenuItem Text="Mitigations Calendar" Value='"/SMSRiskManagement/MitigationCalendar"' Icon="diversity_3"></RadzenMenuItem>
                                    </RadzenMenuItem>
                                </RadzenMenuItem>
                            </RadzenMenu>
                        </div>
                    }

                    <!-- Listings Menu -->
                    <div class="nav-item me-3">
                        <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                            <RadzenMenuItem Text="Listings" Icon="list" class="sms-menu-item">
                                <RadzenMenuItem Text="Reports" Value='"/Listings/Reports"' Icon="assignment"></RadzenMenuItem>
                                <RadzenMenuItem Text="Hazards" Value='"/Listings/Hazards"' Icon="warning"></RadzenMenuItem>
                                <RadzenMenuItem Text="Risk Assessments" Value='"/Listings/RiskAssessments"' Icon="assessment"></RadzenMenuItem>
                                <RadzenMenuItem Text="Mitigations" Value='"/Listings/Mitigations"' Icon="security"></RadzenMenuItem>
                                <RadzenMenuItem Text="Investigations" Value='"/Listings/Investigations"' Icon="search"></RadzenMenuItem>
                                <RadzenMenuItem Text="Hazard Locations" Value='"/Listings/HazardLocations"' Icon="place"></RadzenMenuItem>
                                <RadzenMenuItem Text="Hazard Files" Value='"/Listings/HazardFiles"' Icon="attach_file"></RadzenMenuItem>
                            </RadzenMenuItem>
                        </RadzenMenu>
                    </div>

                    <!-- SMS Assurance Menu -->
                    @if (CurrentUserService.CanRead("SMS_Assurance"))
                    {
                        <div class="nav-item me-3">
                            <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                                <RadzenMenuItem Text="SMS Assurance" Icon="verified_user" class="sms-menu-item">
                                    <RadzenMenuItem Text="Risk Registry" Value='"/SMSAssurance/RiskRegistry"' Icon="assignment"></RadzenMenuItem>
                                    <RadzenMenuItem Text="SPI Dashboard" Value='"/SMSAssurance/SPIDashboard"' Icon="dashboard"></RadzenMenuItem>
                                    <RadzenMenuItem Text="SPI Configuration" Value='"/SMSAssurance/SPIConfiguration"' Icon="settings"></RadzenMenuItem>
                                    <RadzenMenuItem Text="Audit Management" Value='"/SMSAssurance/AuditManagement"' Icon="assignment"></RadzenMenuItem>
                                    <RadzenMenuItem Text="Audit Calendar" Value='"/SMSAssurance/AuditCalendar"' Icon="event"></RadzenMenuItem>
                                    <RadzenMenuItem Text="Audit Workflow Demo" Value='"/SMSAssurance/AuditWorkflowDemo"' Icon="trending_up"></RadzenMenuItem>
                                </RadzenMenuItem>
                            </RadzenMenu>
                        </div>
                    }

                    <!-- SMS Policy Menu -->
                    @if (CurrentUserService.CanRead("SMS_Policy"))
                    {
                        <div class="nav-item me-3">
                            <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                                <RadzenMenuItem Text="SMS Policy" Icon="policy" class="sms-menu-item">
                                    <RadzenMenuItem Text="Safety Policy" Value='"/SMSPolicy/SafetyPolicy"' Icon="description"></RadzenMenuItem>
