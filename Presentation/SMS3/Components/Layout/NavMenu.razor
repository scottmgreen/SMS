                                <RadzenMenuItem Text="Reports" Value='"/Listings/Reports"' Icon="assignment"></RadzenMenuItem>
                                <RadzenMenuItem Text="Hazards" Value='"/Listings/Hazards"' Icon="warning"></RadzenMenuItem>
                                <RadzenMenuItem Text="Risk Assessments" Value='"/Listings/RiskAssessments"' Icon="assessment"></RadzenMenuItem>
                                <RadzenMenuItem Text="Mitigations" Value='"/Listings/Mitigations"' Icon="security"></RadzenMenuItem>
                                <RadzenMenuItem Text="Investigations" Value='"/Listings/Investigations"' Icon="search"></RadzenMenuItem>
                                <RadzenMenuItem Text="Hazard Locations" Value='"/Listings/HazardLocations"' Icon="place"></RadzenMenuItem>
                                <RadzenMenuItem Text="Hazard Files" Value='"/Listings/HazardFiles"' Icon="attach_file"></RadzenMenuItem>
                            </RadzenMenuItem>
                        </RadzenMenu>
                    </div>

                    <!-- SMS Assurance Menu -->
                    @if (CurrentUserService.CanRead("SMS_Assurance"))
                    {
                        <div class="nav-item me-3">
                            <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                                <RadzenMenuItem Text="SMS Assurance" Icon="verified_user" class="sms-menu-item">
