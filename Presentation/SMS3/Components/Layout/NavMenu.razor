@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using SMS_Application.Interfaces
@using SMS_Domain.Enums
@using Radzen
@using Radzen.Blazor
@inject ISMSSessionService SessionService
@inject IJSRuntime JSRuntime
@inject ILogger<NavMenu> Logger
@inject NavigationManager Navigation




<!-- SMS Navigation with Radzen Components -->
<nav class="navbar navbar-expand-lg sms-nav">
    <div class="container-fluid">
        <!-- Brand Logo -->
        <a class="navbar-brand sms-brand" href="/">
            <i class="fas fa-plane-departure me-2 sms-brand-icon"></i>
            PDX SMS
        </a>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler sms-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navigation Links -->
        <div class="collapse navbar-collapse" id="navbarNav">
            @if (isAuthenticated)
            {
                <div class="navbar-nav me-auto d-flex flex-row align-items-center">
                    <!-- Dashboard -->
                    <div class="nav-item me-3">
                        <a class="nav-link sms-nav-link" href="/dashboard">
                            <i class="fas fa-tachometer-alt me-1"></i> Dashboard
                        </a>
                    </div>

                    <!-- SMS Risk Management Menu -->
                    <div class="nav-item me-3">
                        <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                            <RadzenMenuItem Text="SMS Risk Management" Icon="shield" class="sms-menu-item">
                                <RadzenMenuItem Text="Reports" Path="/SMSRiskManagement/Reports" Icon="assignment"></RadzenMenuItem>
                                <RadzenMenuItem Text="Report Processing" Path="/SMSRiskManagement/ReportProcessing" Icon="settings"></RadzenMenuItem>
                                <RadzenMenuItem Text="Hazards" Path="/SMSRiskManagement/Hazards" Icon="warning"></RadzenMenuItem>
                            </RadzenMenuItem>
                        </RadzenMenu>
                    </div>

                    <!-- SMS Assurance Menu -->
                    <div class="nav-item me-3">
                        <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                            <RadzenMenuItem Text="SMS Assurance" Icon="verified_user" class="sms-menu-item">
                                <!-- Add pages when they exist -->
                            </RadzenMenuItem>
                        </RadzenMenu>
                    </div>

                    <!-- SMS Policy Menu -->
                    <div class="nav-item me-3">
                        <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                            <RadzenMenuItem Text="SMS Policy" Icon="policy" class="sms-menu-item">
                                <RadzenMenuItem Text="Safety Policy" Path="/SMSPolicy/SafetyPolicy" Icon="description"></RadzenMenuItem>
                                <RadzenMenuItem Text="Organizational Structure" Path="/SMSPolicy/OrganizationalStructure" Icon="account_tree"></RadzenMenuItem>
                            </RadzenMenuItem>
                        </RadzenMenu>
                    </div>

                    <!-- SMS Promotion Menu -->
                    <div class="nav-item me-3">
                        <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                            <RadzenMenuItem Text="SMS Promotion" Icon="trending_up" class="sms-menu-item">
                                <!-- Add pages when they exist -->
                            </RadzenMenuItem>
                        </RadzenMenu>
                    </div>

                    <!-- System Administration Menu -->
                    @if (HasAdministrativeAccess())
                    {
                        <div class="nav-item me-3">
                            <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                                <RadzenMenuItem Text="System" Icon="settings" class="sms-menu-item">
                                    <!-- User Management -->
                                    <RadzenMenuItem Text="User Management" Icon="people">
                                        <RadzenMenuItem Text="Application Users" Path="/System/UserManagement/ApplicationUsers" Icon="person"></RadzenMenuItem>
                                        <RadzenMenuItem Text="Stakeholder Users" Path="/System/UserManagement/StakeholderUsers" Icon="group"></RadzenMenuItem>
                                        <RadzenMenuItem Text="Organizational Users" Path="/System/UserManagement/OrganizationalUsers" Icon="corporate_fare"></RadzenMenuItem>
                                    </RadzenMenuItem>
                                    
                                    <!-- User Groups -->
                                    <RadzenMenuItem Text="User Groups" Icon="groups">
                                        <RadzenMenuItem Text="Application Groups" Path="/System/UserGroups/ApplicationGroups" Icon="corporate_fare"></RadzenMenuItem>
                                        <RadzenMenuItem Text="Stakeholder Groups" Path="/System/UserGroups/StakeholderGroups" Icon="diversity_3"></RadzenMenuItem>
                                    </RadzenMenuItem>
                                    
                                    <!-- User Roles -->
                                    <RadzenMenuItem Text="User Roles" Icon="admin_panel_settings">
                                        <RadzenMenuItem Text="User Roles" Path="/System/UserRoles/UserRoles" Icon="badge"></RadzenMenuItem>
                                        <RadzenMenuItem Text="User Role Management" Path="/System/UserRoles/UserRoleManagement" Icon="assignment_ind"></RadzenMenuItem>
                                    </RadzenMenuItem>
                                </RadzenMenuItem>
                            </RadzenMenu>
                        </div>
                    }

                    <!-- Analytics -->
                    <div class="nav-item me-3">
                        <a class="nav-link sms-nav-link" href="/Reports">
                            <i class="fas fa-chart-bar me-1 sms-icon-teal"></i> Analytics
                        </a>
                    </div>
                </div>

                <!-- User Info & Menu -->
                <div class="navbar-nav ms-auto">
                    <div class="nav-item">
                        <RadzenMenu Click="OnMenuClick" class="sms-radzen-menu">
                            <RadzenMenuItem class="sms-user-menu-item">
                                <Template>
                                    <div class="d-flex align-items-center">
                                        <div class="d-flex flex-column align-items-end me-2">
                                            <small class="mb-0 sms-user-name">@currentUserDisplayName</small>
                                            <small class="sms-user-type">@currentUserTypeName User</small>
                                        </div>
                                        <i class="fas fa-user-circle fs-4 sms-icon-accent"></i>
                                    </div>
                                    <RadzenMenuItem Text="Profile" Path="/Profile" Icon="person"></RadzenMenuItem>
                                    <RadzenMenuItem Text="Settings" Path="/Settings" Icon="settings"></RadzenMenuItem>
                                    <RadzenMenuItem Text="Logout" Path="logout" Icon="logout"></RadzenMenuItem>
                                </Template>
                                
                            </RadzenMenuItem>
                        </RadzenMenu>
                    </div>
                </div>
            }
            else
            {
                <!-- Guest Navigation -->
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link sms-nav-link" href="/Login">
                            <i class="fas fa-sign-in-alt me-1 sms-icon-accent"></i> Login
                        </a>
                    </li>
                </ul>
            }
        </div>
    </div>
</nav>

@code {
    private bool isAuthenticated = false;
    private string? currentUserDisplayName = null;
    private string? currentUserTypeName = null;
    private SMSUserType? currentUserType = null;
    private string lastCheckedTime = "Never";
    private Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthenticationState();
        
        // Set up a timer to periodically check authentication
        refreshTimer = new Timer(async _ => {
            await InvokeAsync(async () => {
                await CheckAuthenticationState();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(5));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Multiple checks to catch session establishment
            for (int i = 0; i < 5; i++)
            {
                await Task.Delay(500);
                await CheckAuthenticationState();
                StateHasChanged();
                if (isAuthenticated) break;
            }
        }
    }

    private async Task CheckAuthenticationState()
    {
        try
        {
            isAuthenticated = SessionService.IsAuthenticated();
            lastCheckedTime = DateTime.Now.ToString("HH:mm:ss");
            
            Logger.LogInformation("NavMenu checking auth: {IsAuth} at {Time}", isAuthenticated, lastCheckedTime);
            
            if (isAuthenticated)
            {
                currentUserDisplayName = SessionService.GetCurrentUserDisplayName();
                var userTypeString = SessionService.GetCurrentUserType();
                currentUserTypeName = userTypeString;
                
                // Convert to proper SMSUserType enum
                currentUserType = userTypeString switch
                {
                    "APPLICATION" => SMSUserType.Application,
                    "ORGANIZATIONAL" => SMSUserType.Organizational,
                    "STAKEHOLDER" => SMSUserType.Stakeholder,
                    _ => null
                };
                
                Logger.LogInformation("NavMenu auth success: User={User}, Type={Type}, UserTypeEnum={TypeEnum}", 
                    currentUserDisplayName, currentUserTypeName, currentUserType?.Value);
            }
            else
            {
                currentUserDisplayName = null;
                currentUserTypeName = null;
                currentUserType = null;
                Logger.LogInformation("NavMenu: Not authenticated");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error checking authentication in NavMenu");
            isAuthenticated = false;
            currentUserDisplayName = null;
            currentUserTypeName = null;
            currentUserType = null;
        }
    }

    /// <summary>
    /// Check if user has administrative access using proper SMSUserType enum
    /// </summary>
    private bool HasAdministrativeAccess()
    {
        return currentUserType != null && 
               (currentUserType == SMSUserType.Application || currentUserType == SMSUserType.Organizational);
    }

    private async Task OnMenuClick(MenuItemEventArgs args)
    {
        if (!string.IsNullOrEmpty(args.Value?.ToString()))
        {
            var value = args.Value.ToString();
            
            if (value == "logout")
            {
                await Logout();
            }
            else if (value.StartsWith("/"))
            {
                Navigation.NavigateTo(value);
            }
        }
    }

    private async Task Logout()
    {
        await SessionService.ClearSMSSessionAsync();
        await JSRuntime.InvokeVoidAsync("location.reload");
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}

