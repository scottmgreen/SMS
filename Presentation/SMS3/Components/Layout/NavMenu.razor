                                    <RadzenMenuItem Text="Search Reports" Value='"/SMSRiskManagement/HazardReportSearch"' Icon="search"></RadzenMenuItem>
                                    <!-- Investigations -->
                                    <RadzenMenuItem Text="Investigate" Icon="search">
