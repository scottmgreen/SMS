@code {
    [CascadingParameter(Name = "AuthService")]
    public AuthenticationService AuthService { get; set; } = default!;

    [Parameter]
    public EventCallback OnLogoutRequested { get; set; }

    // Session Timer
    private string SessionDurationDisplay => $"{_sessionDuration:mm\\:ss}";
    private TimeSpan _sessionDuration = TimeSpan.Zero;
    private DateTime _sessionStartTime = DateTime.Now;
    private bool _timerRunning = true;
    private CancellationTokenSource _cancellationTokenSource = new();

    protected override async Task OnInitializedAsync()
    {
        _sessionStartTime = DateTime.Now;
        _ = Task.Run(StartSessionTimer);
    }

    private async Task StartSessionTimer()
    {
        try
        {
            while (_timerRunning && !_cancellationTokenSource.Token.IsCancellationRequested)
            {
                _sessionDuration = DateTime.Now - _sessionStartTime;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(1000, _cancellationTokenSource.Token);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task OnMenuClick(MenuItemEventArgs args)
    {
        if (!string.IsNullOrEmpty(args.Value?.ToString()))
        {
            var value = args.Value.ToString();
            if (value.StartsWith("/"))
            {
                Navigation.NavigateTo(value);
            }
        }
    }

    private async Task OnLogoutClick()
    {
        await OnLogoutRequested.InvokeAsync();
        _timerRunning = false;
        _cancellationTokenSource?.Cancel();
    }

    // **🔥 USER PROFILE MODAL - USING COMPONENT**
    private async Task ShowUserProfileModal()
    {
        if (AuthService?.IsAuthenticated != true) return;

        var options = new DialogOptions()
        {
            Width = "900px",
            Height = "700px",
            Resizable = true,
            Draggable = true,
            CloseDialogOnOverlayClick = true,
            ShowTitle = true,
            ShowClose = true
        };

        await DialogService.OpenAsync<UserProfileDialog>("User Profile & Permissions",
            new Dictionary<string, object>()
            {
                { "User", AuthService.User },
                { "SessionDuration", SessionDurationDisplay }
            },
            options);
    }

    public void Dispose()
    {
        _timerRunning = false;
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
    }
}

