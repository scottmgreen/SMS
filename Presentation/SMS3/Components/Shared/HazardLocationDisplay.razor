@using SMS_Domain.Entities
@using SMS3.Components.Shared
@using SMS_Application.Messaging.Queries
@using SMS_Application.Interfaces
@inject IMediator Mediator
@inject ILogger<HazardLocationDisplay> Logger

@* 
Hazard Location Display Component
Displays the location of a hazard using the ReadOnlyLocationMap component
Uses CQRS pattern to fetch actual HazardLocation entity data
*@

@if (IsLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: @MapHeight;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
        <RadzenText TextStyle="TextStyle.Body2" Style="margin-left: 0.5rem;">Loading location data...</RadzenText>
    </div>
}
else
{
    <ReadOnlyLocationMap Latitude="@GetLatitude()"
                        Longitude="@GetLongitude()"
                        LocationDescription="@GetLocationDescription()"
                        LocationArea="@GetLocationArea()"
                        LocationSubArea="@GetLocationSubArea()"
                        Title="@(Title ?? "Hazard Location")"
                        MapHeight="@MapHeight"
                        ShowCoordinates="@ShowCoordinates"
                        ShowLocationDetails="@ShowLocationDetails"
                        ShowZoomControls="@ShowZoomControls"
                        ShowLayerControls="@ShowLayerControls"
                        ZoomLevel="@ZoomLevel" />
}

@code {
    #region Parameters
    /// <summary>
    /// The hazard entity containing location information
    /// </summary>
    [Parameter, EditorRequired] public Hazard? Hazard { get; set; }

    /// <summary>
    /// Map title (optional)
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Map height (default: 300px)
    /// </summary>
    [Parameter] public string MapHeight { get; set; } = "300px";

    /// <summary>
    /// Show coordinate information (default: true)
    /// </summary>
    [Parameter] public bool ShowCoordinates { get; set; } = true;

    /// <summary>
    /// Show location details panel (default: true)
    /// </summary>
    [Parameter] public bool ShowLocationDetails { get; set; } = true;

    /// <summary>
    /// Show zoom controls (default: true)
    /// </summary>
    [Parameter] public bool ShowZoomControls { get; set; } = true;

    /// <summary>
    /// Show layer controls (default: false)
    /// </summary>
    [Parameter] public bool ShowLayerControls { get; set; } = false;

    /// <summary>
    /// Initial zoom level (default: 15)
    /// </summary>
    [Parameter] public int ZoomLevel { get; set; } = 15;
    #endregion

    #region Private Properties
    private bool IsLoading { get; set; } = true;
    private HazardLocation? LoadedHazardLocation { get; set; }
    private string? ErrorMessage { get; set; }
    #endregion

    #region Lifecycle Methods
    protected override async Task OnInitializedAsync()
    {
        if (Hazard != null && !string.IsNullOrEmpty(Hazard.Code))
        {
            await LoadHazardLocationAsync();
        }
        else
        {
            IsLoading = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reload location data if Hazard parameter changes
        if (Hazard != null && !string.IsNullOrEmpty(Hazard.Code))
        {
            await LoadHazardLocationAsync();
        }
        else
        {
            IsLoading = false;
            LoadedHazardLocation = null;
        }
    }
    #endregion

    #region Data Loading Methods
    /// <summary>
    /// Load HazardLocation using proper CQRS pattern
    /// </summary>
    private async Task LoadHazardLocationAsync()
    {
        if (Hazard == null || string.IsNullOrEmpty(Hazard.Code))
        {
            IsLoading = false;
            return;
        }

        try
        {
            IsLoading = true;
            ErrorMessage = null;
            
            Logger.LogInformation("Loading HazardLocation for hazard code: {HazardCode}", Hazard.Code);

            // Use CQRS query to get HazardLocation entities
            var query = new GetHazardLocationsByHazardCodeQuery(Hazard.Code);
            var result = await Mediator.SendAsync(query, CancellationToken.None);

            if (result.IsSuccess && result.Value?.Any() == true)
            {
                // Get the most recent/primary location
                LoadedHazardLocation = result.Value
                    .OrderByDescending(l => l.CreatedDate)
                    .FirstOrDefault();

                Logger.LogInformation("Successfully loaded HazardLocation: {LocationCode} for hazard: {HazardCode}", 
                    LoadedHazardLocation?.Code, Hazard.Code);
            }
            else
            {
                Logger.LogInformation("No HazardLocation found for hazard code: {HazardCode}", Hazard.Code);
                LoadedHazardLocation = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading HazardLocation for hazard code: {HazardCode}", Hazard.Code);
            ErrorMessage = "Error loading location data";
            LoadedHazardLocation = null;
        }
        finally
        {
            IsLoading = false;
        }
    }
    #endregion

    #region Helper Methods
    /// <summary>
    /// Get latitude from loaded HazardLocation or fallback to parsed value
    /// </summary>
    private decimal? GetLatitude()
    {
        // Primary: Use loaded HazardLocation
        if (LoadedHazardLocation?.Latitude.HasValue == true)
        {
            return LoadedHazardLocation.Latitude.Value;
        }

        // Fallback: Parse from Hazard.LocationArea for backward compatibility
        if (Hazard?.LocationArea != null)
        {
            var latMatch = Regex.Match(Hazard.LocationArea, @"Lat:\s*(-?\d+\.?\d*)", RegexOptions.IgnoreCase);
            if (latMatch.Success && decimal.TryParse(latMatch.Groups[1].Value, out var lat))
            {
                return lat;
            }
        }

        return null;
    }

    /// <summary>
    /// Get longitude from loaded HazardLocation or fallback to parsed value
    /// </summary>
    private decimal? GetLongitude()
    {
        // Primary: Use loaded HazardLocation
        if (LoadedHazardLocation?.Longitude.HasValue == true)
        {
            return LoadedHazardLocation.Longitude.Value;
        }

        // Fallback: Parse from Hazard.LocationArea for backward compatibility
        if (Hazard?.LocationArea != null)
        {
            var lngMatch = Regex.Match(Hazard.LocationArea, @"Lng:\s*(-?\d+\.?\d*)", RegexOptions.IgnoreCase);
            if (lngMatch.Success && decimal.TryParse(lngMatch.Groups[1].Value, out var lng))
            {
                return lng;
            }
        }

        return null;
    }

    /// <summary>
    /// Get location description from loaded HazardLocation or fallback
    /// </summary>
    private string? GetLocationDescription()
    {
        // Primary: Use loaded HazardLocation description
        if (!string.IsNullOrEmpty(LoadedHazardLocation?.Description))
        {
            return LoadedHazardLocation.Description;
        }

        // Fallback: Use Hazard fields
        if (GetLatitude().HasValue && GetLongitude().HasValue)
        {
            return Hazard?.LocationSubArea ?? "Map location";
        }

        return Hazard?.LocationSubArea ?? Hazard?.LocationArea ?? "Location not specified";
    }

    /// <summary>
    /// Get location area information - using Hazard fields since HazardLocation doesn't have this
    /// </summary>
    private string? GetLocationArea()
    {
        // HazardLocation entity doesn't have LocationArea, so use Hazard fields
        return Hazard?.LocationArea;
    }

    /// <summary>
    /// Get location sub-area information - using Hazard fields since HazardLocation doesn't have this
    /// </summary>
    private string? GetLocationSubArea()
    {
        // HazardLocation entity doesn't have LocationSubArea, so use Hazard fields
        return Hazard?.LocationSubArea;
    }
    #endregion
}