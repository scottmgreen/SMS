@using Radzen
@using Radzen.Blazor

<!-- SMS Investigations Guidance Panel -->
<RadzenCard Variant="Variant.Outlined" Style="position: sticky; top: 1rem;">
    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
        <!-- Header -->
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenIcon Icon="search" Style="color: var(--rz-primary);" />
            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0; color: var(--rz-primary);">
                Investigation Guidance
            </RadzenText>
        </RadzenStack>

        <!-- Regulatory Requirements -->
        <RadzenCard Variant="Variant.Text" Style="background-color: var(--rz-base-50);">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="gavel" Style="color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; font-weight: 600;">
                        14 CFR 139 Requirements
                    </RadzenText>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Text" Size="AlertSize.Small">
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                            <strong>§139.309</strong> Safety Management System
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                            Establish investigation procedures for safety incidents, accidents, and hazards affecting airport operations.
                        </RadzenText>
                    </RadzenAlert>

                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Text" Size="AlertSize.Small">
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                            <strong>§139.301(d)</strong> Investigation Requirements
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                            Investigate safety occurrences to identify causal factors and implement corrective actions.
                        </RadzenText>
                    </RadzenAlert>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        <!-- Investigation Process -->
        <RadzenCard Variant="Variant.Text">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="account_tree" Style="color: var(--rz-info);" />
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; font-weight: 600;">
                        Investigation Process
                    </RadzenText>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                    <RadzenCard Variant="Variant.Text" Style="padding: 0.5rem; background-color: rgba(var(--rz-primary-rgb), 0.1); border-left: 3px solid var(--rz-primary);">
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; font-weight: 600;">1. Assignment</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                            Assign qualified investigator and define investigation scope and objectives
                        </RadzenText>
                    </RadzenCard>

                    <RadzenCard Variant="Variant.Text" Style="padding: 0.5rem; background-color: rgba(var(--rz-info-rgb), 0.1); border-left: 3px solid var(--rz-info);">
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; font-weight: 600;">2. Evidence Collection</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                            Gather physical evidence, documentation, witness statements, and interviews
                        </RadzenText>
                    </RadzenCard>

                    <RadzenCard Variant="Variant.Text" Style="padding: 0.5rem; background-color: rgba(var(--rz-warning-rgb), 0.1); border-left: 3px solid var(--rz-warning);">
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; font-weight: 600;">3. Analysis</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                            Analyze collected data to identify causal factors and contributing conditions
                        </RadzenText>
                    </RadzenCard>

                    <RadzenCard Variant="Variant.Text" Style="padding: 0.5rem; background-color: rgba(var(--rz-success-rgb), 0.1); border-left: 3px solid var(--rz-success);">
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; font-weight: 600;">4. Decision & Recommendations</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                            Document findings, determine if SMS risk exists, and recommend actions
                        </RadzenText>
                    </RadzenCard>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        <!-- Investigation Types -->
        <RadzenCard Variant="Variant.Text">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="category" Style="color: var(--rz-secondary);" />
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; font-weight: 600;">
                        When to Investigate
                    </RadzenText>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.5rem">
                        <RadzenIcon Icon="error" Style="color: var(--rz-danger); font-size: 1rem;" />
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; line-height: 1.3;">
                            <strong>Incidents & Accidents:</strong> Any occurrence resulting in injury, damage, or operational disruption
                        </RadzenText>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.5rem">
                        <RadzenIcon Icon="warning" Style="color: var(--rz-warning); font-size: 1rem;" />
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; line-height: 1.3;">
                            <strong>Serious Near-Miss:</strong> Events that could have resulted in significant consequences
                        </RadzenText>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.5rem">
                        <RadzenIcon Icon="report_problem" Style="color: var(--rz-info); font-size: 1rem;" />
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; line-height: 1.3;">
                            <strong>Complex Hazards:</strong> Reports requiring additional information or expert analysis
                        </RadzenText>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.5rem">
                        <RadzenIcon Icon="repeat" Style="color: var(--rz-secondary); font-size: 1rem;" />
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; line-height: 1.3;">
                            <strong>Recurring Issues:</strong> Patterns of similar events requiring deeper investigation
                        </RadzenText>
                    </RadzenStack>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        <!-- Quick Actions -->
        @* <RadzenCard Variant="Variant.Text">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="bolt" Style="color: var(--rz-success);" />
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; font-weight: 600;">
                        Quick Actions
                    </RadzenText>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                    <RadzenButton Text="New Investigation" 
                                Icon="add_circle" 
                                ButtonStyle="ButtonStyle.Success" 
                                Size="ButtonSize.Small"
                                Style="width: 100%;"
                                Click="@(() => CreateNewInvestigation())" />
                    
                    <RadzenButton Text="My Interviews" 
                                Icon="assignment_ind" 
                                ButtonStyle="ButtonStyle.Primary" 
                                Size="ButtonSize.Small"
                                Style="width: 100%;"
                                Click="@(() => NavigateToMyInterviews())" />
                    
                    <RadzenButton Text="View All Investigations" 
                                Icon="list" 
                                ButtonStyle="ButtonStyle.Info" 
                                Size="ButtonSize.Small"
                                Style="width: 100%;"
                                Click="@(() => NavigateToInvestigationList())" />
                    
                    <RadzenButton Text="Investigation Reports" 
                                Icon="assessment" 
                                ButtonStyle="ButtonStyle.Light" 
                                Size="ButtonSize.Small"
                                Style="width: 100%;"
                                Click="@(() => NavigateToInvestigationReports())" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard> *@

        <!-- Decision Types -->
        <RadzenCard Variant="Variant.Text">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="gavel" Style="color: var(--rz-warning);" />
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; font-weight: 600;">
                        Investigation Decisions
                    </RadzenText>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                        <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); font-size: 0.9rem;" />
                        <strong> No Further Action:</strong> No SMS risk identified
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                        <RadzenIcon Icon="visibility" Style="color: var(--rz-info); font-size: 0.9rem;" />
                        <strong> Continue Monitoring:</strong> Watch for trends
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                        <RadzenIcon Icon="build" Style="color: var(--rz-warning); font-size: 0.9rem;" />
                        <strong> Requires Mitigation:</strong> SMS risk needs controls
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                        <RadzenIcon Icon="trending_up" Style="color: var(--rz-primary); font-size: 0.9rem;" />
                        <strong> Risk Assessment:</strong> Escalate for full analysis
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">
                        <RadzenIcon Icon="send" Style="color: var(--rz-secondary); font-size: 0.9rem;" />
                        <strong> External Referral:</strong> Outside jurisdiction
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        <!-- Best Practices -->
        <RadzenCard Variant="Variant.Text">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="lightbulb" Style="color: var(--rz-warning);" />
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; font-weight: 600;">
                        Best Practices
                    </RadzenText>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.5rem">
                        <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); font-size: 1rem;" />
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; line-height: 1.3;">
                            Begin investigation immediately while evidence is fresh
                        </RadzenText>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.5rem">
                        <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); font-size: 1rem;" />
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; line-height: 1.3;">
                            Focus on facts and root causes, not blame assignment
                        </RadzenText>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.5rem">
                        <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); font-size: 1rem;" />
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; line-height: 1.3;">
                            Document all findings thoroughly with supporting evidence
                        </RadzenText>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.5rem">
                        <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); font-size: 1rem;" />
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; line-height: 1.3;">
                            Complete investigations within established timeframes
                        </RadzenText>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.5rem">
                        <RadzenIcon Icon="check_circle" Style="color: var(--rz-success); font-size: 1rem;" />
                        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; line-height: 1.3;">
                            Maintain confidentiality and objectivity throughout
                        </RadzenText>
                    </RadzenStack>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        <!-- Contact Information -->
        <RadzenCard Variant="Variant.Text" Style="background-color: var(--rz-base-100);">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="contact_support" Style="color: var(--rz-text-secondary-color);" />
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0; font-weight: 600;">
                        Need Help?
                    </RadzenText>
                </RadzenStack>
                
                <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: var(--rz-text-secondary-color);">
                    Contact SMS Manager or Safety Team for investigation guidance and support.
                </RadzenText>
                
                <RadzenButton Text="Contact SMS Team" 
                            Icon="support_agent" 
                            ButtonStyle="ButtonStyle.Light" 
                            Size="ButtonSize.ExtraSmall"
                            Style="margin-top: 0.5rem;"
                            Click="@(() => ContactSupport())" />
            </RadzenStack>
        </RadzenCard>
    </RadzenStack>
</RadzenCard>