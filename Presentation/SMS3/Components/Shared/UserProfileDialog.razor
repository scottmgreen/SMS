@using SMS_Domain.Entities
@using Radzen
@using Radzen.Blazor

<div class="user-profile-modal">
    <div class="user-header">
        <div class="user-avatar">
            @if (!string.IsNullOrEmpty(User?.Email))
            {
                <RadzenGravatar Email="@User.Email" Size="80" />
            }
            else
            {
                <RadzenIcon Icon="account_circle" Style="font-size: 5rem; color: #212e61;" />
            }
        </div>
        <div class="user-info">
            <h3>@User?.DisplayName</h3>
            <p>@User?.Email</p>
            <RadzenBadge Text="@($"{User?.UserType} User")" BadgeStyle="BadgeStyle.Primary" />
        </div>
    </div>

    <RadzenTabs>
        <Tabs>
            <!-- User Details Tab -->
            <RadzenTabsItem Text="User Details" Icon="person">
                <div class="tab-content">
                    <table class="details-table">
                        <tr><td><strong>User ID:</strong></td><td>@User?.UserId</td></tr>
                        <tr><td><strong>First Name:</strong></td><td>@User?.FirstName</td></tr>
                        <tr><td><strong>Last Name:</strong></td><td>@User?.LastName</td></tr>
                        <tr><td><strong>Email:</strong></td><td>@User?.Email</td></tr>
                        <tr><td><strong>User Type:</strong></td><td>@User?.UserType</td></tr>
                        <tr><td><strong>Login Time:</strong></td><td>@User?.LoginTime.ToString("yyyy-MM-dd HH:mm:ss")</td></tr>
                        <tr><td><strong>Session Duration:</strong></td><td>@SessionDuration</td></tr>
                        <tr>
                            <td><strong>Authentication Status:</strong></td>
                            <td>
                                <RadzenBadge Text="@(User?.IsAuthenticated == true ? "Authenticated" : "Not Authenticated")"
                                             BadgeStyle="@(User?.IsAuthenticated == true ? BadgeStyle.Success : BadgeStyle.Danger)" />
                            </td>
                        </tr>
                    </table>
                </div>
            </RadzenTabsItem>

            <!-- Role & Permissions Tab -->
            <RadzenTabsItem Text="Role & Permissions" Icon="security">
                <div class="tab-content">
                    <div class="role-section">
                        <h5>
                            <RadzenIcon Icon="admin_panel_settings" />
                            Assigned Role
                        </h5>
                        @if (User?.UserRole != null)
                        {
                            <div class="role-card">
                                <RadzenCard>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6>@User.UserRole.Name</h6>
                                            <small class="text-muted">Code: @User.UserRole.Code</small>
                                        </div>
                                    </div>
                                </RadzenCard>
                            </div>
                        }
                        else
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" Size="AlertSize.Small">
                                <RadzenIcon Icon="warning" />
                                No role assigned to this user
                            </RadzenAlert>
                        }
                    </div>

                    <div class="permissions-section">
                        <h5>
                            <RadzenIcon Icon="shield" />
                            Module Permissions
                        </h5>

                        @if (User?.Permissions?.Any() == true && SMSModules.Any())
                        {
                            <RadzenDataGrid Data="@SMSModules" TItem="string" AllowPaging="false" class="permission-view-grid" Style="height: 700px; overflow-y:auto">
                                <Columns>
                                    <RadzenDataGridColumn TItem="string" Title="Module" Width="30%">
                                        <Template Context="module">
                                            <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: 600;">@module</RadzenText>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="string" Title="Create" Width="17.5%">
                                        <Template Context="module">
                                            <div class="text-center">
                                                @if (IsPermissionGranted(module, "Create"))
                                                {
                                                    <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                    <div><small class="text-success">Granted</small></div>
                                                }
                                                else
                                                {
                                                    <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                    <div><small class="text-muted">Denied</small></div>
                                                }
                                            </div>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="string" Title="Read" Width="17.5%">
                                        <Template Context="module">
                                            <div class="text-center">
                                                @if (IsPermissionGranted(module, "Read"))
                                                {
                                                    <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                    <div><small class="text-success">Granted</small></div>
                                                }
                                                else
                                                {
                                                    <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                    <div><small class="text-muted">Denied</small></div>
                                                }
                                            </div>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="string" Title="Update" Width="17.5%">
                                        <Template Context="module">
                                            <div class="text-center">
                                                @if (IsPermissionGranted(module, "Update"))
                                                {
                                                    <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                    <div><small class="text-success">Granted</small></div>
                                                }
                                                else
                                                {
                                                    <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                    <div><small class="text-muted">Denied</small></div>
                                                }
                                            </div>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="string" Title="Delete" Width="17.5%">
                                        <Template Context="module">
                                            <div class="text-center">
                                                @if (IsPermissionGranted(module, "Delete"))
                                                {
                                                    <RadzenIcon Icon="check_circle" Style="color: var(--rz-success);" />
                                                    <div><small class="text-success">Granted</small></div>
                                                }
                                                else
                                                {
                                                    <RadzenIcon Icon="cancel" Style="color: var(--rz-text-disabled-color);" />
                                                    <div><small class="text-muted">Denied</small></div>
                                                }
                                            </div>
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        }
                        else if (User?.Permissions?.Any() != true)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Base" Size="AlertSize.Small">
                                <RadzenIcon Icon="info" />
                                No specific permissions assigned. User may have default access based on user type.
                            </RadzenAlert>
                        }
                        else
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" Size="AlertSize.Small">
                                <RadzenIcon Icon="warning" />
                                No modules found. Please check the system configuration.
                            </RadzenAlert>
                        }
                    </div>

                    <!-- Permission Summary -->
                    @if (User?.Permissions?.Any() == true)
                    {
                        <div class="permission-summary-section">
                            <h6>Permission Summary</h6>
                            <RadzenCard Class="permission-summary">
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="summary-item">
                                            <RadzenIcon Icon="add_circle" Style="color: var(--rz-success);" />
                                            <span>Create: @GetPermissionCount("Create")</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="summary-item">
                                            <RadzenIcon Icon="visibility" Style="color: var(--rz-info);" />
                                            <span>Read: @GetPermissionCount("Read")</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="summary-item">
                                            <RadzenIcon Icon="edit" Style="color: var(--rz-warning);" />
                                            <span>Update: @GetPermissionCount("Update")</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="summary-item">
                                            <RadzenIcon Icon="delete" Style="color: var(--rz-danger);" />
                                            <span>Delete: @GetPermissionCount("Delete")</span>
                                        </div>
                                    </div>
                                </div>
                            </RadzenCard>
                        </div>
                    }

                    <!-- Permission Check Helper -->
                    <div class="permission-check-section">
                        <h6>Quick Permission Check</h6>
                        <RadzenCard Class="permission-checker">
                            <div class="row">
                                <div class="col-md-6">
                                    <RadzenTextBox @bind-Value="@_moduleToCheck" Placeholder="Enter module name..." Style="width: 100%;" />
                                </div>
                                <div class="col-md-6">
                                    <RadzenButton Text="Check Permissions" Icon="search" Click="@CheckModulePermissions" ButtonStyle="ButtonStyle.Base" />
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(_permissionCheckResult))
                            {
                                <div class="mt-2">
                                    <RadzenText TextStyle="TextStyle.Body2">@_permissionCheckResult</RadzenText>
                                </div>
                            }
                        </RadzenCard>
                    </div>
                </div>
            </RadzenTabsItem>

            <!-- Session Info Tab -->
            <RadzenTabsItem Text="Session Info" Icon="access_time">
                <div class="tab-content">
                    <div class="session-info">
                        <RadzenCard>
                            <h6><RadzenIcon Icon="schedule" /> Session Details</h6>
                            <table class="details-table">
                                <tr><td><strong>Login Time:</strong></td><td>@User?.LoginTime.ToString("dddd, MMMM dd, yyyy 'at' h:mm:ss tt")</td></tr>
                                <tr><td><strong>Session Duration:</strong></td><td>@SessionDuration</td></tr>
                                <tr><td><strong>User Agent:</strong></td><td>Browser Information</td></tr>
                                <tr><td><strong>IP Address:</strong></td><td>Current Session IP</td></tr>
                            </table>
                        </RadzenCard>

                        <RadzenCard Class="mt-3">
                            <h6><RadzenIcon Icon="timeline" /> Session Activity</h6>
                            <div class="session-timeline">
                                <div class="timeline-item">
                                    <RadzenIcon Icon="login" />
                                    <span>Logged in at @User?.LoginTime.ToString("HH:mm:ss")</span>
                                </div>
                                <div class="timeline-item">
                                    <RadzenIcon Icon="refresh" />
                                    <span>Session active for @SessionDuration</span>
                                </div>
                            </div>
                        </RadzenCard>
                    </div>
                </div>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>

    <div class="modal-actions">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Close" Icon="close" ButtonStyle="ButtonStyle.Secondary" Click="@CloseModal" />
        </RadzenStack>
    </div>
</div>

@code {
    [Parameter] public AuthenticationState? User { get; set; }
    [Parameter] public string SessionDuration { get; set; } = "00:00";
    [Parameter] public EventCallback OnClose { get; set; }

    private string _moduleToCheck = "";
    private string _permissionCheckResult = "";

    // Get unique modules from user permissions
    private string[] SMSModules
    {
        get
        {
            if (User?.Permissions?.Any() != true)
                return Array.Empty<string>();

            return User.Permissions
                .Select(p => p.SMSModule)
                .Where(module => !string.IsNullOrWhiteSpace(module))
                .Distinct()
                .OrderBy(module => module)
                .ToArray();
        }
    }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }

    private bool IsPermissionGranted(string module, string action)
    {
        if (User?.Permissions == null) return false;

        var permission = User.Permissions.FirstOrDefault(p => p.SMSModule == module);
        return action switch
        {
            "Create" => permission?.Create == true,
            "Read" => permission?.Read == true,
            "Update" => permission?.Update == true,
            "Delete" => permission?.Delete == true,
            _ => false
        };
    }

    private int GetPermissionCount(string action)
    {
        if (User?.Permissions == null) return 0;

        return action switch
        {
            "Create" => User.Permissions.Count(p => p.Create),
            "Read" => User.Permissions.Count(p => p.Read),
            "Update" => User.Permissions.Count(p => p.Update),
            "Delete" => User.Permissions.Count(p => p.Delete),
            _ => 0
        };
    }

    private void CheckModulePermissions()
    {
        if (string.IsNullOrEmpty(_moduleToCheck) || User?.Permissions == null)
        {
            _permissionCheckResult = "Please enter a module name.";
            return;
        }

        var modulePermissions = User.Permissions.Where(p =>
            p.SMSModule?.Contains(_moduleToCheck, StringComparison.OrdinalIgnoreCase) == true).ToList();

        if (modulePermissions.Any())
        {
            var permissions = new List<string>();
            foreach (var perm in modulePermissions)
            {
                var permList = new List<string>();
                if (perm.Create) permList.Add("Create");
                if (perm.Read) permList.Add("Read");
                if (perm.Update) permList.Add("Update");
                if (perm.Delete) permList.Add("Delete");

                permissions.Add($"{perm.SMSModule}: {string.Join(", ", permList)}");
            }
            _permissionCheckResult = $"Found permissions: {string.Join("; ", permissions)}";
        }
        else
        {
            _permissionCheckResult = $"No permissions found for module containing '{_moduleToCheck}'";
        }
    }
}

<style>
    .user-profile-modal {
        max-width: 1000px; /* Increased width for grid */
        margin: 0 auto;
    }

    .user-header {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
        padding: 1.5rem;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 8px;
    }

    .user-info h3 {
        margin: 0 0 0.5rem 0;
        color: #212e61;
    }

    .user-info p {
        margin: 0 0 0.5rem 0;
        color: #666;
    }

    .tab-content {
        padding: 1rem 0;
    }

    .details-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1rem;
    }

        .details-table td {
            padding: 0.75rem 0.5rem;
            border-bottom: 1px solid #e9ecef;
        }

            .details-table td:first-child {
                width: 30%;
                color: #495057;
            }

    .role-section,
    .permissions-section,
    .permission-summary-section,
    .permission-check-section {
        margin-bottom: 2rem;
    }

        .role-section h5,
        .permissions-section h5 {
            color: #212e61;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .role-card {
        margin-bottom: 1rem;
    }

    .permission-view-grid {
        border: 1px solid var(--rz-grid-border-color);
        border-radius: 4px;
    }

    .permission-summary {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
    }

    .summary-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem;
        font-weight: 500;
    }

    .permission-checker {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
    }

    .session-info {
        max-height: 400px;
        overflow-y: auto;
    }

    .timeline-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        padding: 0.5rem;
        background: #f8f9fa;
        border-radius: 4px;
    }

    .modal-actions {
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid #e9ecef;
    }
</style>