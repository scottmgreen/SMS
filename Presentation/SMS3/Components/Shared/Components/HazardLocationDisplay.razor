
@using SMS3.Components.Shared
@using SMS3.Components.Shared.Components
@using SMS_Application.Interfaces
@using SMS_Application.Queries
@using SMS_Domain.Entities
@inject IBaseMediator Mediator
@inject ILogger<HazardLocationDisplay> Logger
@namespace SMS3.Components.Shared
@* 
Hazard Location Display Component
Displays the location of a hazard using the ReadOnlyLocationMap component
Uses CQRS pattern to fetch actual HazardLocation entity data
*@

@if (IsLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: @MapHeight;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
        <RadzenText TextStyle="TextStyle.Body2" Style="margin-left: 0.5rem;">Loading location data...</RadzenText>
    </div>
}
else
{
    <ReadOnlyLocationMap Latitude="@GetLatitude()"
                        Longitude="@GetLongitude()"
                        LocationDescription="@GetLocationDescription()"
                        LocationArea="@GetLocationArea()"
                        LocationSubArea="@GetLocationSubArea()"
                        Title="@(Title ?? "Hazard Location")"
                        MapHeight="@MapHeight"
                        ShowCoordinates="@ShowCoordinates"
                        ShowLocationDetails="@ShowLocationDetails"
                        ShowZoomControls="@ShowZoomControls"
                        ShowLayerControls="@ShowLayerControls"
                        ZoomLevel="@ZoomLevel" />
}

