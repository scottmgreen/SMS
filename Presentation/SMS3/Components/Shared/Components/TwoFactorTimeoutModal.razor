@using SMS_Application.Services
@using SMS_Application.Interfaces
@implements IDisposable
@inject TwoFactorSessionTimerService TwoFactorTimer
@inject ISMSSessionService SessionService
@inject NavigationManager Navigation
@inject ILogger<TwoFactorTimeoutModal> Logger

@if (IsVisible)
{
    <div class="modal fade show twofa-timeout-modal" tabindex="-1" role="dialog" style="display: block; z-index: 99999;">
        <div class="modal-backdrop fade show"></div>
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-shield-alt text-warning me-2 fa-2x"></i>
                        <h4 class="modal-title text-warning mb-0">2FA Verification Expiring</h4>
                    </div>
                </div>
                
                <div class="modal-body">
                    <div class="alert alert-warning d-flex align-items-center mb-3">
                        <i class="fas fa-clock me-2"></i>
                        <span>Your 2FA verification will expire in <strong class="countdown-text">@FormatRemainingTime()</strong></span>
                    </div>
                    
                    <p class="mb-3">
                        You must complete two-factor authentication before the timer expires, or you'll need to log in again.
                    </p>
                    
                    <div class="twofa-progress mb-3">
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-danger" 
                                 style="width: @GetProgressPercentage()%" 
                                 role="progressbar">
                            </div>
                        </div>
                    </div>
                    
                    <p class="text-muted small mb-0">
                        <i class="fas fa-info-circle me-1"></i>
                        Enter your 6-digit verification code now to continue, or click "Start Over" to begin again.
                    </p>
                </div>
                
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary me-2" @onclick="OnStartOverClick">
                        <i class="fas fa-undo me-1"></i>
                        Start Over
                    </button>
                    <button type="button" class="btn btn-warning" @onclick="OnDismissClick">
                        <i class="fas fa-times me-1"></i>
                        Dismiss Warning
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
.twofa-timeout-modal .modal-content {
    border-radius: 12px;
    border: none;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.twofa-timeout-modal .modal-header {
    background: #212e61;
    border-radius: 12px 12px 0 0;
    padding: 1.5rem;
}

.twofa-timeout-modal .modal-title {
    font-weight: 600;
    font-size: 1.3rem;
}

.twofa-timeout-modal .modal-body {
    padding: 1.5rem;
}

.twofa-timeout-modal .modal-footer {
    padding: 0 1.5rem 1.5rem 1.5rem;
    justify-content: flex-end;
}

.countdown-text {
    font-family: 'Courier New', monospace;
    font-size: 1.2em;
    color: #dc3545;
    font-weight: bold;
}

.twofa-progress .progress {
    border-radius: 4px;
    background-color: #f8f9fa;
    height: 8px !important;
}

.twofa-timeout-modal .btn {
    min-width: 120px;
    font-weight: 500;
    border-radius: 6px;
    padding: 0.5rem 1rem;
}

.twofa-timeout-modal .alert {
    border-radius: 8px;
    border: none;
    background-color: #fff3cd;
    border-left: 4px solid #dc3545;
}

.twofa-timeout-modal .modal-backdrop {
    background-color: rgba(0, 0, 0, 0.6);
}

/* Prevent scrolling when modal is open */
body.modal-open {
    overflow: hidden;
}
</style>

