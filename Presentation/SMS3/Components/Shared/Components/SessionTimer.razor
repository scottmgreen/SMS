@using Microsoft.Extensions.Configuration
@using SMS_Application.Interfaces
@using SMS_Application.Services
@implements IDisposable
@inject SessionTimerService SessionTimerSvc
@inject ICurrentUserService _currentUserService  
@inject NavigationManager Navigation
@inject ILogger<SessionTimer> Logger
@inject IConfiguration Configuration

@if (_currentUserService.IsAuthenticated && ShowTimer && IsSessionTimerEnabled())
{
    <div class="session-timer-container d-flex align-items-center me-3">
        <i class="fas fa-clock me-1 @GetIconClass()"></i>
        <span class="session-timer @SessionTimerSvc.GetTimerCssClass()" title="@GetTooltipText()">
            @SessionTimerSvc.FormatRemainingTime()
        </span>
        @* @if (IsNearExpiry())
        {
            <i class="fas fa-exclamation-triangle ms-1 text-warning"></i>
        } *@
    </div>
}

<style>
.session-timer-container {
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.session-timer {
    font-family: 'Courier New', monospace;
    letter-spacing: 0.5px;
    font-size: 0.9rem;
}

.session-normal {
    color: #28a745;
}

.session-warning {
    color: #ffc107;
}

.session-critical {
    color: #dc3545;
    font-weight: bold;
}

.session-expired {
    color: #dc3545;
    font-weight: bold;
}

.timer-icon-normal {
    color: #28a745;
}

.timer-icon-warning {
    color: #ffc107;
}

.timer-icon-critical {
    color: #dc3545;
}
</style>

