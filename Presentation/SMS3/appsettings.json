  // 🔄 PROTOCOL SWITCHING REFERENCE TABLE
  // =====================================================================================================
  // SETTING                           │ HTTP VALUE              │ HTTPS VALUE             │ LOCATION
  // =====================================================================================================
  // MasterProtocol.Protocol           │ "HTTP"                  │ "HTTPS"                 │ MasterProtocol
  // Authentication.RequiredProtocol   │ "HTTP"                  │ "HTTPS"                 │ Authentication  
  // Authentication.OverrideProtocol   │ "HTTP"                  │ "HTTPS"                 │ Authentication
  // SessionConfiguration.SecureCookies│ false                   │ true                    │ SessionConfiguration
  // SessionConfiguration.SameSite     │ "Lax"                   │ "Strict"                │ SessionConfiguration
  // FeatureManagement.AllowHttpCookies│ true                    │ false                   │ FeatureManagement
  // FeatureManagement.EnableSecurityHeaders│ false              │ true                    │ FeatureManagement
  // =====================================================================================================
  // NOTE: ForceHttpsProtocol and EnforceHttpsRedirection should be false for BOTH protocols
  //       (false for HTTP obvious, false for HTTPS because it's already native HTTPS)
  // =====================================================================================================


  //"🔧 The 7 Individual Settings": "
  //1.: MasterProtocol.Protocol: HTTP → HTTPS
  //2.: Authentication.RequiredProtocol: HTTP → HTTPS
  //3.: Authentication.OverrideProtocol: HTTP → HTTPS
  //4.: SessionConfiguration.SecureCookies: false → true
  //5.: SessionConfiguration.SameSite: Lax → Strict
  //6.: FeatureManagement.AllowHttpCookies: true → false
  //7.: FeatureManagement.EnableSecurityHeaders: false → true





