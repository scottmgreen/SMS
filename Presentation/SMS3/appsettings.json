  },

  "ConnectionStrings": { "DefaultConnectionString": "Data Source=LL001083\\MSSQLSERVER25;Initial Catalog=SMS;Integrated Security=True;Connect Timeout=30;Encrypt=True;TrustServerCertificate=True;ApplicationIntent=ReadWrite;MultiSubnetFailover=False" },
