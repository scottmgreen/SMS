  "Security": { "RouteEncryptionKey": "rJ8XmN2vP5qS9wB1eY7tU4oI6kL3fH0dA8zC5xV2nM8=" },

  

  "SessionConfiguration": {
    "TimeoutMinutes": 5,
    "SlidingExpiration": true,
    "SecureCookies": true,
    "HttpOnly": true,
    "SameSite": "Strict",
    "CookieName": "SMS_Session",
    "EnableDevelopmentMode": false
  },

  "RequestValidation": {
    "EnableCsrfProtection": true,
    "MaxRequestBodySize": 10485760,
    "EnableInputSanitization": true,
    "EnableSqlInjectionDetection": true,
    "MaxInputLength": 10000,
    "BlockedFileExtensions": [ ".exe", ".bat", ".cmd", ".com", ".scr", ".pif", ".vbs", ".js", ".jar", ".asp", ".aspx", ".php", ".ps1" ],
    "AllowedFileExtensions": [ ".pdf", ".docx", ".xlsx", ".pptx", ".txt", ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tiff", ".zip" ],
    "MaxFileUploadSize": 5242880,
    "EnableRateLimiting": true,
    "RateLimitPerMinute": 60,
    "EnableRequestLogging": true,
    "LogOnlySuspiciousRequests": false
  },

  "TwoFactorAuth": {
    "Enable2FA": true,
    "RequireFor2FAForAllUsers": true,
    "ApplicationName": "PDX SMS Portal",
    "IssuerName": "Port of Portland",
    "TimeWindowSeconds": 30,
    "TotpDigits": 6,
    "TimeTolerance": 1,
    "TwoFASessionTimeoutMinutes": 10,
    "MaxFailedAttempts": 3,
    "LockoutDurationMinutes": 15,
    "EnableBackupCodes": true,
    "BackupCodeCount": 10,
    "EnableEmailBackup": true,
    "EnableSmsBackup": false,
    "LogTwoFactorEvents": true,
    "QrCodeSize": 200
  },

  "SecurityHeaders": {
    "Enabled": true,
    "FrameOptions": "DENY",
    "EnableHSTS": true,
    "HSTSMaxAge": 31536000,
    "LogHeaderApplication": false,
    "AllowedDomains": [ "cdn.jsdelivr.net", "cdnjs.cloudflare.com", "fonts.googleapis.com", "fonts.gstatic.com", "unpkg.com", "tile.openstreetmap.org", "nominatim.openstreetmap.org", "server.arcgisonline.com" ],
    "ContentSecurityPolicy": {
      "Enabled": true,
      "ReportOnly": false,
      "AdditionalScriptSources": [ "https://cdn.jsdelivr.net", "https://cdnjs.cloudflare.com", "https://unpkg.com" ],
      "AdditionalStyleSources": [ "https://cdn.jsdelivr.net", "https://cdnjs.cloudflare.com", "https://fonts.googleapis.com", "https://unpkg.com" ],
      "AdditionalConnectSources": [ "https://cdn.jsdelivr.net", "https://nominatim.openstreetmap.org", "https://server.arcgisonline.com", "https://tile.openstreetmap.org" ]
    }
  },

  // HTTPS-only protocol baseline
  "MasterProtocol": {
    "Protocol": "HTTPS",
    "ForceProtocolEverywhere": true,
    "AllowMixedMode": false
  },

  "ForwardedHeaders": {
    "TrustAllProxies": false,
    "ForwardLimit": 1,
    "RequireHeaderSymmetry": true,
    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ],
    "KnownNetworks": []
  },

  // Authentication strategy: Session primary, Circuit fallback
  "Authentication": {
    "PreferredMethod": "SessionBased",
    "FallbackMethod": "CircuitBased",
    "EnableFallbackChain": true,
    "RequireCompleteUserInstantiation": true,
    "LogAuthenticationDecisions": true,
    "ValidateUserCompletenessOnAccess": true,
    "CircuitCacheTimeoutMinutes": 60,
    "StrictMode": false,
    "RequiredProtocol": "HTTPS",
    "AllowProtocolFallback": false,
    "OverrideProtocol": "HTTPS"
  },

  "FeatureManagement": {
    "AuditLogEnabled": true,
    "ExternalApiEnabled": true,
    "SwaggerEnabled": true,
    "ErrorNotifications": true,
    "SuccessNotifications": true,
    "WarningNotifications": true,
    "InfoNotifications": false,
    "EnableSessionTimer": false,

    // 🔇 AUDIT VERBOSITY CONTROL - Fix chatty audit logging
    "EnableQueryAudit": false, // Disable routine READ operation auditing
    "EnableCommandAudit": true, // Keep CREATE/UPDATE/DELETE auditing
    "EnableBusinessAuditLog": false, // Disable duplicate business audit logging
    "EnableDetailedAuditLogging": false, // Disable verbose entity extraction
    "AuditUIOperationsOnly": false, // Only audit user-initiated operations (not automatic UI loading)

    // Security feature toggles
    "AllowHttpCookies": false,
    "EnforceHttpsRedirection": false,
    "EnableSecurityHeaders": true,
    "EnableCsrfProtection": true,

    // Used by auth diagnostics endpoint registration in Development
    "EnableAuthenticationLogging": true,
    "ForceTechnicalAssessmentWorkflow": false // true = require sequential completion, false = allow non-linear step navigation
  },

