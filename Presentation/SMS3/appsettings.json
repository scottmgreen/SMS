  // 🎯 MASTER PROTOCOL CONFIGURATION - EXPLICIT HTTP/HTTPS CONTROL
  "MasterProtocol": {
    "Protocol": "HTTP", // 🔄 HTTP vs HTTPS: "HTTP" for development, "HTTPS" for production
    "ForceProtocolEverywhere": false, // Apply to ALL components (cookies, sessions, etc.)
    "AllowMixedMode": false // Never allow mixed HTTP/HTTPS
  },

  // 🎯 NEW: AUTHENTICATION STRATEGY CONFIGURATION - PROTOCOL-BASED
  "Authentication": {
    "PreferredMethod": "SessionBased",
    "FallbackMethod": "CircuitBased",
    "EnableFallbackChain": true,
    "RequireCompleteUserInstantiation": true,
    "LogAuthenticationDecisions": true,
    "ValidateUserCompletenessOnAccess": true,
    "CircuitCacheTimeoutMinutes": 60,
    "StrictMode": false,
    "RequiredProtocol": "HTTP", // 🔄 HTTP vs HTTPS: Must match MasterProtocol.Protocol
    "AllowProtocolFallback": true, // Allow fallback when explicit
    "OverrideProtocol": "HTTP" // 🔄 HTTP vs HTTPS: Force protocol everywhere
  },

  "FeatureManagement": {
    "AuditLogEnabled": true,
    "ExternalApiEnabled": true,
    "SwaggerEnabled": true,
    "ErrorNotifications": false,
    "SuccessNotifications": true,
    "WarningNotifications": false,
    "InfoNotifications": false,

    // 🔇 AUDIT VERBOSITY CONTROL - Fix chatty audit logging
    "EnableQueryAudit": false, // Disable routine READ operation auditing
    "EnableCommandAudit": true, // Keep CREATE/UPDATE/DELETE auditing
    "EnableBusinessAuditLog": false, // Disable duplicate business audit logging
    "EnableDetailedAuditLogging": false, // Disable verbose entity extraction
    "AuditUIOperationsOnly": false, // Only audit user-initiated operations (not automatic UI loading)

    // 🚀 EXPLICIT PROTOCOL-BASED SECURITY FEATURE FLAGS
    "AllowHttpCookies": true, // 🔄 HTTP vs HTTPS: true for HTTP, false for HTTPS
    "ForceHttpsProtocol": false, // 🔄 HTTP vs HTTPS: false for HTTP, false for HTTPS native
    "EnforceHttpsRedirection": false, // 🔄 HTTP vs HTTPS: false for HTTP, false for HTTPS native
    "EnableSecurityHeaders": false, // 🔄 HTTP vs HTTPS: false for HTTP (HSTS conflicts), true for HTTPS
    "EnableCsrfProtection": true,

    // 🎯 NEW: AUTHENTICATION FEATURE FLAGS - STRATEGY-BASED AUTHENTICATION CONTROL
    // 
    // SMS Authentication System supports multiple strategies for different deployment scenarios:
    //
    // SESSION-BASED AUTH (EnableSessionBasedAuth):
    //   - Uses HttpContext.Session with cookies for state persistence
    //   - BEST for: Production HTTP/HTTPS deployments with load balancers
    //   - REQUIRES: Session middleware, cookie support, sticky sessions for load balancing
    //   - SECURITY: Session data encrypted, HttpOnly cookies, protocol-appropriate SameSite protection
    //   - COMPATIBILITY: Optimized per protocol - HTTP uses Lax cookies, HTTPS uses Strict cookies
    //
    // CIRCUIT-BASED AUTH (EnableCircuitBasedAuth): 
    //   - Uses Blazor Server circuit IDs for in-memory state storage
    //   - BEST for: Blazor Server single-instance deployments, HTTP development
    //   - REQUIRES: Blazor Server SignalR connections, circuit state management
    //   - LIMITATIONS: Not suitable for load-balanced environments (circuit affinity required)
    //   - PERFORMANCE: Fastest access, no database/session store overhead
    //
    // CONTEXT-BASED AUTH (EnableContextBasedAuth):
    //   - Uses HttpContext.Items for request-scoped temporary storage
    //   - BEST for: Development, testing, temporary authentication bypass
    //   - WARNING: Data lost between requests - NOT suitable for production
    //   - USE CASE: API endpoints, single-request operations, debugging
    //
    // HYBRID AUTH (EnableHybridAuth):
    //   - Attempts multiple strategies with automatic fallback
    //   - BEST for: Migration scenarios, complex deployment environments
    //   - COMPLEXITY: Higher overhead, more difficult to troubleshoot
    //   - RECOMMENDED: Use single strategy for production deployments
    //
    // COMPLETE USERS (RequireCompleteUsers):
    //   - Enforces full user instantiation with roles, permissions, and audit data
    //   - SECURITY: Prevents partial authentication states, ensures permission validation
    //   - PERFORMANCE: Slightly higher overhead but ensures data consistency
    //   - RECOMMENDED: Always true for production systems
    //
    // AUTHENTICATION LOGGING (EnableAuthenticationLogging):
    //   - Logs authentication decisions, strategy selection, and state transitions
    //   - SECURITY: Essential for audit trails, security incident investigation
    //   - COMPLIANCE: Required for SOX, HIPAA, and other regulatory frameworks
    //   - PERFORMANCE: Minimal overhead, logs to structured logging infrastructure
    //
    "EnableSessionBasedAuth": true, // EXPLICIT: Primary strategy - protocol-appropriate cookies (HTTP: insecure, HTTPS: secure)
    "EnableCircuitBasedAuth": true, // EXPLICIT: Blazor Server fallback - circuit-scoped storage (HTTP/HTTPS compatible)
    "EnableContextBasedAuth": true, // EXPLICIT: Production fallback when circuit IDs unavailable - ENABLED FOR PRODUCTION FIX
    "EnableHybridAuth": false, // EXPLICIT: Multi-strategy combination - complex, use only for migration scenarios
    "RequireCompleteUsers": true, // EXPLICIT: Enforce full user instantiation with roles/permissions (recommended true)
    "EnableAuthenticationLogging": true // EXPLICIT: Log all auth decisions and state changes (recommended true for security auditing)
  },

