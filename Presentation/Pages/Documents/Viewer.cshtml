@page "/Documents/Viewer"
@model PDXSMS_Presentation.Pages.Documents.ViewerModel
@{
    ViewData["Title"] = "Document Viewer - PDXSMS";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-3">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyPolicy">Safety Policy</a></li>
                    <li class="breadcrumb-item active">Document Viewer</li>
                </ol>
            </nav>
            
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0">
                                <i class="fas fa-file-pdf"></i> Document Viewer
                            </h4>
                            @if (!string.IsNullOrEmpty(Model.DocumentName))
                            {
                                <small>@Model.DocumentName</small>
                            }
                        </div>
                        <div>
                            @if (!string.IsNullOrEmpty(Model.FilePath))
                            {
                                <a href="@Model.FilePath" target="_blank" class="btn btn-light btn-sm me-2">
                                    <i class="fas fa-external-link-alt"></i> Open in New Tab
                                </a>
                                <a href="@Model.FilePath" download class="btn btn-success btn-sm">
                                    <i class="fas fa-download"></i> Download
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PDF Viewer -->
    <div class="row">
        <div class="col-12">
            @if (!string.IsNullOrEmpty(Model.FilePath))
            {
                <div class="card">
                    <div class="card-body p-0">
                        <!-- Embedded PDF Viewer -->
                        <div class="pdf-viewer-container">
                            <iframe 
                                src="@Model.FilePath#toolbar=1&navpanes=1&scrollbar=1&page=1&view=FitH" 
                                type="application/pdf"
                                width="100%" 
                                height="800px"
                                style="border: none; border-radius: 0.375rem;"
                                title="PDF Document Viewer">
                                <p class="text-center p-4">
                                    <i class="fas fa-exclamation-triangle text-warning"></i>
                                    Your browser does not support embedded PDF viewing.
                                    <br><br>
                                    <a href="@Model.FilePath" target="_blank" class="btn btn-primary">
                                        <i class="fas fa-external-link-alt"></i> Open PDF in New Tab
                                    </a>
                                    <a href="@Model.FilePath" download class="btn btn-success">
                                        <i class="fas fa-download"></i> Download PDF
                                    </a>
                                </p>
                            </iframe>
                        </div>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    <h5><i class="fas fa-exclamation-triangle"></i> Error</h5>
                    <p>@Model.ErrorMessage</p>
                    <a href="/SafetyPolicy" class="btn btn-primary">
                        <i class="fas fa-arrow-left"></i> Back to Safety Policy
                    </a>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <h5><i class="fas fa-file-pdf fa-3x mb-3"></i></h5>
                    <h5>No Document Selected</h5>
                    <p>Please select a document to view.</p>
                    <a href="/SafetyPolicy" class="btn btn-primary">
                        <i class="fas fa-arrow-left"></i> Back to Safety Policy
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .pdf-viewer-container {
        position: relative;
        min-height: 800px;
    }
</style>

@section Scripts {
    <script>
        // Handle iframe loading errors
        const iframe = document.querySelector('iframe');
        if (iframe) {
            iframe.addEventListener('error', function() {
                console.error('PDF failed to load');
                this.style.display = 'none';
                const errorHtml = `
                    <div class="text-center p-4">
                        <i class="fas fa-exclamation-triangle text-warning fa-3x mb-3"></i>
                        <h5>Unable to Display PDF</h5>
                        <p>The PDF could not be loaded in the browser viewer.</p>
                        <a href="@Model.FilePath" target="_blank" class="btn btn-primary me-2">
                            <i class="fas fa-external-link-alt"></i> Open in New Tab
                        </a>
                        <a href="@Model.FilePath" download class="btn btn-success">
                            <i class="fas fa-download"></i> Download PDF
                        </a>
                    </div>
                `;
                this.parentElement.innerHTML = errorHtml;
            });
            
            iframe.addEventListener('load', function() {
                console.log('PDF loaded successfully');
            });
        }
    </script>
}