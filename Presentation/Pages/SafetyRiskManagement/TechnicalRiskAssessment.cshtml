@page "/SafetyRiskManagement/TechnicalRiskAssessment/{hazardId}/{assessmentId}"
@model PDXSMS_Presentation.Pages.SafetyRiskManagement.TechnicalRiskAssessmentModel
@{
    ViewData["Title"] = "Technical Risk Assessment (TRA)";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyRiskManagement">Safety Risk Management</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyRiskManagement/HazardProcessing">Hazard Processing</a></li>
                    <li class="breadcrumb-item active">Technical Risk Assessment</li>
                </ol>
            </nav>
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="card-title"><i class="fas fa-microscope"></i> Technical Risk Assessment (TRA)</h4>
                            <p class="card-text">Formal TRA for High/Critical risk hazards requiring comprehensive evaluation</p>
                            <p class="mb-0"><strong>TRA ID:</strong> @Model.TRA.Id | <strong>Hazard:</strong> @Model.TRA.HazardId</p>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="row text-center">
                                <div class="col-6">
                                    <h3 class="mb-0">@Model.TRA.OverallProgress%</h3>
                                    <small>Overall Progress</small>
                                </div>
                                <div class="col-6">
                                    <h3 class="mb-0">@Model.TRA.CompletedSections/@Model.TRA.RequiredSections</h3>
                                    <small>Sections Complete</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TRA Overview -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-info-circle"></i> TRA Overview</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td class="fw-bold">TRA Title:</td>
                                    <td>@Model.TRA.Title</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Priority:</td>
                                    <td><span class="badge bg-danger">@Model.TRA.Priority</span></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Lead Assessor:</td>
                                    <td>@Model.TRA.LeadAssessor</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Status:</td>
                                    <td><span class="badge bg-warning">@Model.TRA.Status</span></td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td class="fw-bold">Initiated:</td>
                                    <td>@Model.TRA.InitiatedDate.ToString("MM/dd/yyyy")</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Target Completion:</td>
                                    <td class="@(Model.TRA.TargetCompletionDate < DateTime.Now ? "text-danger" : "")">
                                        @Model.TRA.TargetCompletionDate.ToString("MM/dd/yyyy")
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Days Remaining:</td>
                                    <td>
                                        @{
                                            var daysRemaining = (Model.TRA.TargetCompletionDate - DateTime.Now).Days;
                                        }
                                        <span class="badge @(daysRemaining < 2 ? "bg-danger" : daysRemaining < 5 ? "bg-warning" : "bg-success")">
                                            @daysRemaining days
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Related Hazard:</td>
                                    <td>
                                        <a href="/SafetyRiskManagement/HazardReview?hazardId=@Model.TRA.HazardId" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-external-link-alt"></i> @Model.TRA.HazardId
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="mt-3">
                        <h6>Overall Progress</h6>
                        <div class="progress progress-lg">
                            <div class="progress-bar @(Model.TRA.OverallProgress >= 80 ? "bg-success" : Model.TRA.OverallProgress >= 50 ? "bg-warning" : "bg-danger")" 
                                 style="width: @Model.TRA.OverallProgress%">
                                @Model.TRA.OverallProgress% Complete
                            </div>
                        </div>
                        <small class="text-muted">@Model.TRA.CompletedSections of @Model.TRA.RequiredSections sections completed</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6><i class="fas fa-users"></i> TRA Team</h6>
                </div>
                <div class="card-body">
                    @foreach (var member in Model.TRATeam)
                    {
                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-shrink-0">
                                <div class="bg-primary rounded-circle text-white d-flex align-items-center justify-content-center" 
                                     style="width: 40px; height: 40px;">
                                    <i class="fas fa-user"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="mb-0">@member.Name</h6>
                                <small class="text-muted">@member.Role</small><br>
                                <small class="text-muted">Last active: @member.LastActivity.ToString("MM/dd HH:mm")</small>
                            </div>
                            <div class="flex-shrink-0">
                                <span class="badge bg-success">@member.Status</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h6><i class="fas fa-cogs"></i> TRA Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-primary">
                            <i class="fas fa-file-pdf"></i> Generate TRA Report
                        </button>
                        <button type="button" class="btn btn-outline-info">
                            <i class="fas fa-comments"></i> Team Collaboration
                        </button>
                        <button type="button" class="btn btn-outline-secondary">
                            <i class="fas fa-clock"></i> Schedule Review Meeting
                        </button>
                        <form method="post" asp-page-handler="CompleteTRA" class="mt-2">
                            <button type="submit" class="btn btn-success w-100" 
                                    @(Model.TRA.OverallProgress < 100 ? "disabled" : "")>
                                <i class="fas fa-check-circle"></i> Complete TRA
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TRA Sections -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-list-check"></i> TRA Sections</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 5%">#</th>
                                    <th style="width: 30%">Section</th>
                                    <th style="width: 15%">Progress</th>
                                    <th style="width: 15%">Status</th>
                                    <th style="width: 15%">Assigned To</th>
                                    <th style="width: 10%">Completed</th>
                                    <th style="width: 10%">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.TRASections.Length; i++)
                                {
                                    var traSection = Model.TRASections[i];
                                    <tr class="@(traSection.Status == "Completed" ? "table-success" : traSection.Status == "In Progress" ? "table-warning" : "")">
                                        <td><strong>@(i + 1)</strong></td>
                                        <td>
                                            <strong>@traSection.Name</strong>
                                            @if (!string.IsNullOrEmpty(traSection.Comments))
                                            {
                                                <br><small class="text-muted">@traSection.Comments</small>
                                            }
                                        </td>
                                        <td>
                                            <div class="progress">
                                                <div class="progress-bar @(traSection.Progress == 100 ? "bg-success" : traSection.Progress >= 50 ? "bg-warning" : "bg-danger")" 
                                                     style="width: @traSection.Progress%">
                                                    @traSection.Progress%
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @(traSection.Status == "Completed" ? "bg-success" : traSection.Status == "In Progress" ? "bg-warning" : "bg-secondary")">
                                                @traSection.Status
                                            </span>
                                        </td>
                                        <td>@traSection.AssignedTo</td>
                                        <td>
                                            @if (traSection.CompletedDate.HasValue)
                                            {
                                                @traSection.CompletedDate.Value.ToString("MM/dd/yyyy")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                @if (traSection.Status != "Completed")
                                                {
                                                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#updateSectionModal"
                                                            data-section-id="@traSection.Id" data-section-name="@traSection.Name" 
                                                            data-progress="@traSection.Progress" data-status="@traSection.Status">
                                                        <i class="fas fa-edit"></i> Update
                                                    </button>
                                                }
                                                <button type="button" class="btn btn-outline-info">
                                                    <i class="fas fa-eye"></i> View
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Update Section Modal -->
<div class="modal fade" id="updateSectionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update TRA Section</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="UpdateSection">
                <div class="modal-body">
                    <input type="hidden" asp-for="SectionUpdate.SectionId" id="sectionId" />
                    <input type="hidden" asp-for="SectionUpdate.SectionName" id="sectionName" />
                    
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>Section:</strong> <span id="sectionDisplayName"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Status</label>
                                <select asp-for="SectionUpdate.Status" class="form-select" required>
                                    <option value="">Select status...</option>
                                    <option value="Pending">Pending</option>
                                    <option value="In Progress">In Progress</option>
                                    <option value="Completed">Completed</option>
                                    <option value="On Hold">On Hold</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Progress (%)</label>
                                <input type="range" asp-for="SectionUpdate.Progress" class="form-range" 
                                       min="0" max="100" step="5" id="progressRange" />
                                <div class="d-flex justify-content-between">
                                    <small>0%</small>
                                    <small id="progressValue">50%</small>
                                    <small>100%</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Comments / Updates</label>
                        <textarea asp-for="SectionUpdate.Comments" class="form-control" rows="4" 
                                  placeholder="Describe progress, findings, or any issues encountered..."></textarea>
                    </div>
                    
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Note:</strong> Setting status to "Completed" will automatically set progress to 100%.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Section</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .progress-lg {
            height: 25px;
        }
        .progress-lg .progress-bar {
            font-size: 14px;
            line-height: 25px;
        }
    </style>

    <script>
        // Update Section Modal
        document.getElementById('updateSectionModal').addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const sectionId = button.getAttribute('data-section-id');
            const sectionName = button.getAttribute('data-section-name');
            const progress = button.getAttribute('data-progress');
            const status = button.getAttribute('data-status');
            
            document.getElementById('sectionId').value = sectionId;
            document.getElementById('sectionName').value = sectionName;
            document.getElementById('sectionDisplayName').textContent = sectionName;
            document.getElementById('progressRange').value = progress;
            document.getElementById('progressValue').textContent = progress + '%';
            
            // Set status dropdown
            const statusSelect = document.querySelector('select[name="SectionUpdate.Status"]');
            statusSelect.value = status;
        });

        // Progress range updates
        document.getElementById('progressRange').addEventListener('input', function(e) {
            document.getElementById('progressValue').textContent = e.target.value + '%';
        });

        // Auto-set progress to 100% when status is "Completed"
        document.querySelector('select[name="SectionUpdate.Status"]').addEventListener('change', function(e) {
            if (e.target.value === 'Completed') {
                const progressRange = document.getElementById('progressRange');
                progressRange.value = 100;
                document.getElementById('progressValue').textContent = '100%';
            }
        });
    </script>
}

