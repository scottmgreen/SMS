/**
 * View interview details in modal
 */
function viewInterview(id, person, date, conductedBy, interviewNotes, investigatorNotes) {
    const detailsDiv = document.getElementById('interviewDetails');
    detailsDiv.innerHTML = `
        <div class="row">
            <div class="col-md-6">
                <table class="table table-sm table-borderless">
                    <tr><td><strong>Interview ID:</strong></td><td>${id}</td></tr>
                    <tr><td><strong>Person Interviewed:</strong></td><td>${person}</td></tr>
                    <tr><td><strong>Interview Date:</strong></td><td>${date}</td></tr>
                    <tr><td><strong>Conducted By:</strong></td><td>${conductedBy}</td></tr>
                </table>
            </div>
        </div>
        <hr>
        <div class="mb-3">
            <h6><strong>Interview Notes:</strong></h6>
            <div class="bg-light p-3 rounded">${interviewNotes || 'No notes recorded'}</div>
        </div>
        <div class="mb-3">
            <h6><strong>Investigator Analysis:</strong></h6>
            <div class="bg-light p-3 rounded">${investigatorNotes || 'No analysis recorded'}</div>
        </div>
    `;
}

/**
 * Show alert message
 */
function showAlert(type, message) {
    // Remove any existing alerts
    const existingAlerts = document.querySelectorAll('.alert-temp');
    existingAlerts.forEach(alert => alert.remove());
    
    // Create new alert
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show alert-temp`;
    alertDiv.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    
    // Insert at top of container
    const container = document.querySelector('.container-fluid');
    container.insertBefore(alertDiv, container.firstChild);
    
    // Auto-remove after 5 seconds
    setTimeout(() => {
        if (alertDiv.parentNode) {
            alertDiv.remove();
        }
    }, 5000);
}

/**
 * View SVG map in modal viewer
 */
async function viewMapSvg(filePath, title, description) {
    try {
        // Set modal title and description
        document.getElementById('mapViewerTitle').textContent = title;
        document.getElementById('mapViewerDescription').textContent = description;
        document.getElementById('downloadMapLink').href = filePath;
        
        // Load SVG content
        const response = await fetch(filePath);
        if (!response.ok) {
            throw new Error(`Failed to load SVG: ${response.status}`);
        }
        
        const svgContent = await response.text();
        const svgContainer = document.getElementById('svgMapContainer');
        svgContainer.innerHTML = svgContent;
        
        // Reset zoom
        svgContainer.style.transform = 'scale(1)';
        window.currentMapZoom = 1;
        
        // Show modal
        const modal = new bootstrap.Modal(document.getElementById('svgMapViewerModal'));
        modal.show();
        
        // Add panning functionality
        addMapPanningSupport();
        
    } catch (error) {
        console.error('Error loading SVG map:', error);
        showAlert('danger', 'Error loading map. Please try again.');
    }
}

/**
 * Zoom in on the map
 */
function zoomMapIn() {
    const container = document.getElementById('svgMapContainer');
    window.currentMapZoom = (window.currentMapZoom || 1) * 1.2;
    if (window.currentMapZoom > 3) window.currentMapZoom = 3; // Max zoom
    container.style.transform = `scale(${window.currentMapZoom})`;
}

/**
 * Zoom out on the map
 */
function zoomMapOut() {
    const container = document.getElementById('svgMapContainer');
    window.currentMapZoom = (window.currentMapZoom || 1) / 1.2;
    if (window.currentMapZoom < 0.5) window.currentMapZoom = 0.5; // Min zoom
    container.style.transform = `scale(${window.currentMapZoom})`;
}

/**
 * Reset map zoom to original size
 */
function resetMapZoom() {
    const container = document.getElementById('svgMapContainer');
    window.currentMapZoom = 1;
    container.style.transform = 'scale(1)';
}

/**
 * Add panning support to the map
 */
function addMapPanningSupport() {
    const container = document.getElementById('svgMapContainer');
    let isPanning = false;
    let startX, startY, startTransformX = 0, startTransformY = 0;
    
    container.addEventListener('mousedown', (e) => {
        isPanning = true;
        startX = e.clientX;
        startY = e.clientY;
        container.style.cursor = 'grabbing';
        e.preventDefault();
    });
    
    container.addEventListener('mousemove', (e) => {
        if (!isPanning) return;
        
        const deltaX = e.clientX - startX;
        const deltaY = e.clientY - startY;
        
        const newTransformX = startTransformX + deltaX;
        const newTransformY = startTransformY + deltaY;
        
        container.style.transform = `scale(${window.currentMapZoom || 1}) translate(${newTransformX}px, ${newTransformY}px)`;
        e.preventDefault();
    });
    
    container.addEventListener('mouseup', () => {
        if (isPanning) {
            isPanning = false;
            container.style.cursor = 'grab';
            
            // Update stored transform values
            const transform = container.style.transform;
            const translateMatch = transform.match(/translate\(([^,]+),\s*([^)]+)\)/);
            if (translateMatch) {
                startTransformX = parseFloat(translateMatch[1]);
                startTransformY = parseFloat(translateMatch[2]);
            }
        }
    });
    
    container.addEventListener('mouseleave', () => {
        isPanning = false;
        container.style.cursor = 'grab';
    });
    
    // Set initial cursor
    container.style.cursor = 'grab';
}

// Initialize page
document.addEventListener('DOMContentLoaded', function() {
    // Set current date/time for interview date field
    const now = new Date();
    const dateTimeInput = document.querySelector('input[name="NewInterview.InterviewDate"]');
    if (dateTimeInput) {
        dateTimeInput.value = now.toISOString().slice(0, 16);
    }
    
    // Check URL hash for active tab
    const hash = window.location.hash;
    if (hash === '#investigation') {
        // Show investigation tab if coming from HazardProcessing
        const investigationTab = document.querySelector('a[href="#interviews"]');
        if (investigationTab) {
            investigationTab.click();
        }
    }
    
    // If URL hash is #images, show the images tab
    if (hash === '#images') {
        const imagesTab = document.querySelector('a[href="#images"]');
        if (imagesTab) {
            imagesTab.click();
        }
    }
});
</script>
}