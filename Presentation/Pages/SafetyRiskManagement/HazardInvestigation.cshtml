@page
@model PDXSMS_Presentation.Pages.SafetyRiskManagement.HazardInvestigationModel
@{
    ViewData["Title"] = "Hazard Investigation";
}

<div class="container-fluid">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/SafetyRiskManagement">Safety Risk Management</a></li>
            <li class="breadcrumb-item"><a href="/SafetyRiskManagement/HazardProcessing#investigation">Hazard Processing</a></li>
            <li class="breadcrumb-item active">Investigation - @Model.HazardId</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="card-title">
                                <i class="fas fa-search-plus"></i> Hazard Investigation
                            </h4>
                            <p class="card-text mb-0">
                                Comprehensive investigation workflow for hazard @Model.HazardId requiring additional information
                            </p>
                        </div>
                        <div class="col-md-4 text-end">
                            @if (Model.Investigation != null)
                            {
                                <div class="text-center">
                                    <h5 class="mb-0">@Model.Investigation.Id</h5>
                                    <small>Investigation ID</small>
                                    <br>
                                    <span class="badge @(Model.Investigation.Status == "Completed" ? "bg-success" : "bg-warning") mt-1">
                                        @Model.Investigation.Status
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="text-center">
                                    <h5 class="mb-0 text-warning">
                                        <i class="fas fa-exclamation-triangle"></i> New Investigation
                                    </h5>
                                    <small>Setup Required</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Report Summary Panel -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-clipboard-list"></i> Report Summary
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.HazardSummary != null)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Hazard ID:</strong></td>
                                        <td>@Model.HazardSummary.Id</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Hazard Type:</strong></td>
                                        <td>@Model.HazardSummary.HazardType</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Location:</strong></td>
                                        <td>@Model.HazardSummary.Location</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Priority:</strong></td>
                                        <td>
                                            <span class="badge @(Model.HazardSummary.Priority == "High" ? "bg-danger" : Model.HazardSummary.Priority == "Medium" ? "bg-warning" : "bg-info")">
                                                @Model.HazardSummary.Priority
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td><strong>Status:</strong></td>
                                        <td>
                                            <span class="badge bg-warning">@Model.HazardSummary.Status</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Reported Date:</strong></td>
                                        <td>@Model.HazardSummary.ReportedDate.ToString("MM/dd/yyyy HH:mm")</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Reported By:</strong></td>
                                        <td>@Model.HazardSummary.ReportedBy</td>
                                    </tr>
                                    @if (Model.ReportSummary != null)
                                    {
                                        <tr>
                                            <td><strong>Report ID:</strong></td>
                                            <td>@Model.ReportSummary.Id</td>
                                        </tr>
                                    }
                                </table>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <h6><strong>Description:</strong></h6>
                                <p class="mb-0">@Model.HazardSummary.Description</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            Hazard information could not be loaded. Please check the hazard ID and try again.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Investigation Setup Panel -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-user-check"></i> Investigation Setup
                    </h5>
                </div>
                <div class="card-body">
                    <form id="investigationSetupForm">
                        <input type="hidden" name="HazardId" value="@Model.HazardId" />
                        <input type="hidden" name="ReportId" value="@Model.ReportId" />
                        @Html.AntiForgeryToken()
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="fas fa-user-tie"></i> Assigned Investigator <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="AssignedInvestigatorId" class="form-select" required>
                                        <option value="">Select an investigator...</option>
                                        @foreach (var investigator in Model.AvailableInvestigators)
                                        {
                                            <option value="@investigator.Id">
                                                @investigator.DisplayName (@investigator.OrganizationName)
                                            </option>
                                        }
                                    </select>
                                    <div class="form-text">Select the SMS user responsible for conducting this investigation</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Investigation Status</label>
                                    <input type="text" class="form-control" 
                                           value="@(Model.Investigation?.Status ?? "In Progress")" 
                                           readonly style="background-color: #e9ecef;">
                                    <div class="form-text">Status will update automatically as investigation progresses</div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-12">
                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="fas fa-sticky-note"></i> Investigator Notes <span class="text-danger">*</span>
                                    </label>
                                    <textarea asp-for="InvestigatorNotes" class="form-control" rows="4" 
                                              placeholder="Document the investigation plan, objectives, and any initial observations..." required></textarea>
                                    <div class="form-text">Minimum 10 characters required</div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="text-end">
                            <button type="button" class="btn btn-success" onclick="saveInvestigationSetup()">
                                <i class="fas fa-save"></i> Save Investigation Setup
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Investigation Evidence Tabs -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link @(Model.ActiveTab == "interviews" ? "active" : "")" 
                               href="#interviews" data-bs-toggle="tab">
                                <i class="fas fa-users"></i> Interviews
                                @if (Model.Investigation?.Interviews?.Any() == true)
                                {
                                    <span class="badge bg-primary ms-1">@Model.Investigation.Interviews.Count</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.ActiveTab == "documents" ? "active" : "")" 
                               href="#documents" data-bs-toggle="tab">
                                <i class="fas fa-file-alt"></i> Documents
                                @if (Model.Investigation?.Documents?.Any() == true)
                                {
                                    <span class="badge bg-info ms-1">@Model.Investigation.Documents.Count</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.ActiveTab == "images" ? "active" : "")" 
                               href="#images" data-bs-toggle="tab">
                                <i class="fas fa-images"></i> Images
                                @if (Model.Investigation?.Images?.Any() == true)
                                {
                                    <span class="badge bg-success ms-1">@Model.Investigation.Images.Count</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.ActiveTab == "videos" ? "active" : "")" 
                               href="#videos" data-bs-toggle="tab">
                                <i class="fas fa-video"></i> Videos
                                @if (Model.Investigation?.Videos?.Any() == true)
                                {
                                    <span class="badge bg-warning ms-1">@Model.Investigation.Videos.Count</span>
                                }
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content">
                        <!-- Interviews Tab -->
                        <div class="tab-pane fade @(Model.ActiveTab == "interviews" ? "show active" : "")" id="interviews" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5>
                                    <i class="fas fa-users"></i> Interview Records
                                </h5>
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addInterviewModal">
                                    <i class="fas fa-plus"></i> Add Interview
                                </button>
                            </div>
                            
                            @if (Model.Investigation?.Interviews?.Any() == true)
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Interview ID</th>
                                                <th>Person Interviewed</th>
                                                <th>Interview Date</th>
                                                <th>Conducted By</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var interview in Model.Investigation.Interviews)
                                            {
                                                <tr>
                                                    <td><strong>@interview.Id</strong></td>
                                                    <td>@interview.PersonInterviewed</td>
                                                    <td>@interview.InterviewDate.ToString("MM/dd/yyyy HH:mm")</td>
                                                    <td>@interview.ConductedBy</td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <button type="button" class="btn btn-outline-info" 
                                                                    data-bs-toggle="modal" data-bs-target="#viewInterviewModal"
                                                                    onclick="viewInterview('@interview.Id', '@interview.PersonInterviewed', '@interview.InterviewDate.ToString("MM/dd/yyyy HH:mm")', '@interview.ConductedBy', '@Html.Raw(interview.InterviewNotes)', '@Html.Raw(interview.InvestigatorNotes)')">
                                                                <i class="fas fa-eye"></i> View
                                                            </button>
                                                            <button type="button" class="btn btn-outline-primary">
                                                                <i class="fas fa-edit"></i> Edit
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-5">
                                    <i class="fas fa-users fa-3x"></i>
                                    <p class="mt-3">No interviews recorded yet</p>
                                    <p>Click "Add Interview" to record your first interview</p>
                                </div>
                            }
                        </div>

                        <!-- Documents Tab -->
                        <div class="tab-pane fade @(Model.ActiveTab == "documents" ? "show active" : "")" id="documents" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5>
                                    <i class="fas fa-file-alt"></i> Document Repository
                                    <small class="text-muted ms-2">
                                        (From Report Documents)
                                    </small>
                                </h5>
                                <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#addDocumentModal">
                                    <i class="fas fa-plus"></i> Add Document
                                </button>
                            </div>
                            
                            @if (Model.CombinedDocuments?.Documents?.Any() == true)
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Document ID</th>
                                                <th>Title</th>
                                                <th>Type</th>
                                                <th>Report ID</th>
                                                <th>Uploaded Date</th>
                                                <th>Uploaded By</th>
                                                <th>Size</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var document in Model.CombinedDocuments.Documents)
                                            {
                                                <tr>
                                                    <td><strong>@document.Id</strong></td>
                                                    <td>@document.Title</td>
                                                    <td>
                                                        <span class="badge bg-info">@document.DocumentType</span>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted">@document.ReportId</small>
                                                    </td>
                                                    <td>@document.UploadedDate.ToString("MM/dd/yyyy")</td>
                                                    <td>@document.UploadedBy</td>
                                                    <td>
                                                        @if (document.FileSize > 0)
                                                        {
                                                            <small>@(document.FileSize / 1024) KB</small>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <a href="@document.FilePath" download class="btn btn-outline-primary">
                                                                <i class="fas fa-download"></i> Download
                                                            </a>
                                                            <button type="button" class="btn btn-outline-info">
                                                                <i class="fas fa-eye"></i> View
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-5">
                                    <i class="fas fa-file-alt fa-3x"></i>
                                    <p class="mt-3">No documents found</p>
                                    <p>Documents from hazard reports will automatically appear here</p>
                                </div>
                            }
                        </div>

                        <!-- Images Tab -->
                        <div class="tab-pane fade @(Model.ActiveTab == "images" ? "show active" : "")" id="images" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5>
                                    <i class="fas fa-images"></i> Image Gallery
                                    <small class="text-muted ms-2">
                                        (From Report Documents)
                                    </small>
                                </h5>
                                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addImageModal">
                                    <i class="fas fa-plus"></i> Add Image
                                </button>
                            </div>
                            
                            @if (Model.CombinedDocuments?.Images?.Any() == true)
                            {
                                <div class="row">
                                    @foreach (var image in Model.CombinedDocuments.Images)
                                    {
                                        <div class="col-md-4 mb-3">
                                            <div class="card">
                                                @if (image.MediaType == "Map" && image.FilePath.EndsWith(".svg"))
                                                {
                                                    <!-- Map Thumbnail Card -->
                                                    <div class="card-header bg-primary text-white">
                                                        <div class="d-flex align-items-center">
                                                            <i class="fas fa-map-marked-alt me-2"></i>
                                                            <small>Location Map</small>
                                                        </div>
                                                    </div>
                                                    <div class="card-body">
                                                        <!-- SVG Preview Thumbnail -->
                                                        <div class="text-center mb-3" style="height: 120px; overflow: hidden; border: 1px solid #dee2e6; border-radius: 4px; background: #f8f9fa;">
                                                            <div class="d-flex align-items-center justify-content-center h-100">
                                                                <div class="text-muted">
                                                                    <i class="fas fa-map fa-3x text-primary"></i>
                                                                    <br><small>SVG Map</small>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <h6 class="card-title">@image.Title</h6>
                                                        <p class="card-text text-muted small">@image.Description</p>
                                                        <p class="card-text">
                                                            <small class="text-muted">
                                                                @image.Id | @image.UploadedDate.ToString("MM/dd/yyyy")
                                                                <br>Report: @image.ReportId
                                                            </small>
                                                        </p>
                                                        <div class="btn-group btn-group-sm w-100">
                                                            <button type="button" class="btn btn-primary" 
                                                                    onclick="viewMapSvg('@image.FilePath', '@image.Title', '@image.Description')">
                                                                <i class="fas fa-search-plus"></i> View Map
                                                            </button>
                                                            <a href="@image.FilePath" download class="btn btn-success">
                                                                <i class="fas fa-download"></i> Download
                                                            </a>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <!-- Regular Image Card -->
                                                    <div class="card-body">
                                                        <h6 class="card-title">@image.Title</h6>
                                                        <p class="card-text text-muted small">@image.Description</p>
                                                        <p class="card-text">
                                                            <small class="text-muted">
                                                                @image.Id | @image.UploadedDate.ToString("MM/dd/yyyy")
                                                                <br>Report: @image.ReportId
                                                                @if (image.FileSize > 0)
                                                                {
                                                                    @* <br />Size: @(image.FileSize / 1024) KB *@
                                                                }
                                                            </small>
                                                        </p>
                                                        <div class="btn-group btn-group-sm w-100">
                                                            <button type="button" class="btn btn-outline-primary">
                                                                <i class="fas fa-eye"></i> View
                                                            </button>
                                                            <a href="@image.FilePath" download class="btn btn-outline-success">
                                                                <i class="fas fa-download"></i> Download
                                                            </a>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-5">
                                    <i class="fas fa-images fa-3x"></i>
                                    <p class="mt-3">No images found</p>
                                    <p>Images from hazard reports will automatically appear here</p>
                                    <div class="mt-3">
                                        <small class="text-info">
                                            <i class="fas fa-info-circle"></i> 
                                            Map thumbnails from hazard reports with location data are automatically included
                                        </small>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Videos Tab -->
                        <div class="tab-pane fade @(Model.ActiveTab == "videos" ? "show active" : "")" id="videos" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5>
                                    <i class="fas fa-video"></i> Video Library
                                    <small class="text-muted ms-2">
                                        (From Report Documents)
                                    </small>
                                </h5>
                                <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#addVideoModal">
                                    <i class="fas fa-plus"></i> Add Video
                                </button>
                            </div>
                            
                            @if (Model.CombinedDocuments?.Videos?.Any() == true)
                            {
                                <div class="row">
                                    @foreach (var video in Model.CombinedDocuments.Videos)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <div class="card">
                                                <div class="card-body">
                                                    <h6 class="card-title">@video.Title</h6>
                                                    <p class="card-text text-muted">@video.Description</p>
                                                    <p class="card-text">
                                                        <small class="text-muted">
                                                            @video.Id | @video.UploadedDate.ToString("MM/dd/yyyy")
                                                            <br>Report: @video.ReportId
                                                            @if (video.FileSize > 0)
                                                            {
                                                                @* <br />Size: @(video.FileSize / 1024 / 1024) MB *@
                                                            }
                                                        </small>
                                                    </p>
                                                    <div class="btn-group btn-group-sm w-100">
                                                        <button type="button" class="btn btn-outline-primary">
                                                            <i class="fas fa-play"></i> Play
                                                        </button>
                                                        <a href="@video.FilePath" download class="btn btn-outline-warning">
                                                            <i class="fas fa-download"></i> Download
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-5">
                                    <i class="fas fa-video fa-3x"></i>
                                    <p class="mt-3">No videos found</p>
                                    <p>Videos from hazard reports will automatically appear here</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Complete Investigation Actions -->
    @if (Model.Investigation != null && Model.Investigation.Status != "Completed")
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-success">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-check-circle"></i> Complete Investigation
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            <strong>Ready to Complete Investigation?</strong><br>
                            Once you mark this investigation as complete, the hazard will be returned to the validation workflow 
                            for SMS risk determination with the additional information you've gathered.
                        </div>
                        
                        <div class="text-center">
                            <form method="post" asp-page-handler="CompleteInvestigation" style="display: inline;">
                                <input type="hidden" name="HazardId" value="@Model.HazardId" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success btn-lg" 
                                        onclick="return confirm('Are you sure you want to complete this investigation? The hazard will be returned to validation.')">
                                    <i class="fas fa-flag-checkered"></i> Complete Investigation
                                </button>
                            </form>
                            <a href="/SafetyRiskManagement/HazardProcessing#investigation" class="btn btn-secondary btn-lg ms-3">
                                <i class="fas fa-arrow-left"></i> Return to Processing
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Add Interview Modal -->
<div class="modal fade" id="addInterviewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-user-plus"></i> Add Interview Record
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="addInterviewForm">
                <div class="modal-body">
                    <input type="hidden" name="HazardId" value="@Model.HazardId" />
                    @Html.AntiForgeryToken()
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Person Interviewed <span class="text-danger">*</span></label>
                                <input asp-for="NewInterview.PersonInterviewed" class="form-control" 
                                       placeholder="Name and position of interviewee" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Interview Date & Time <span class="text-danger">*</span></label>
                                <input asp-for="NewInterview.InterviewDate" type="datetime-local" 
                                       class="form-control" required />
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Interview Conducted By <span class="text-danger">*</span></label>
                        <input asp-for="NewInterview.ConductedBy" class="form-control" 
                               placeholder="Name of person conducting the interview" required />
                    </div>
                    
                    <div class="mb-3">
