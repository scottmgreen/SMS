@page
@model PDXSMS_Presentation.Pages.SafetyRiskManagement.HazardReportingModel
@{
    ViewData["Title"] = "Submit Hazard Report";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="#"> Safety Risk Management</a></li>
                    <li class="breadcrumb-item active"> Submit Hazard Report</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h4 class="card-title"><i class="fas fa-exclamation-triangle"></i> Submit Hazard Report</h4>
                </div>
            </div>
        </div>
    </div>

   
    <!-- Hazard Report Form -->
    <div class="row">
        <div class="col-lg-8">
            <!-- Success Message Display -->
@*             @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x"></i>
                        </div>
                        <div class="col">
                            <h5 class="alert-heading mb-1">
                                <i class="fas fa-clipboard-check"></i> Success!
                            </h5>
                            <p class="mb-1">@TempData["SuccessMessage"]</p>
                            @if (TempData["HazardReportId"] != null)
                            {
                                <p class="mb-0">
                                    <strong>Reference ID:</strong> 
                                    <span class="badge bg-primary fs-6">@TempData["HazardReportId"]</span>
                                </p>
                            }
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            } *@
            
            <div class="card">
                <div class="card-header">
                    <h4><i class="fas fa-edit"></i> Hazard Report Details</h4>
                </div>
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <!-- Hidden fields to preserve geolocation data across all form operations -->
                        <input type="hidden" asp-for="SelectedGeoLocation.Latitude" />
                        <input type="hidden" asp-for="SelectedGeoLocation.Longitude" />
                        <input type="hidden" asp-for="SelectedGeoLocation.Description" />
                        <input type="hidden" asp-for="SelectedGeoLocation.SelectedDateTime" />
                        
                        <!-- UI State preservation -->
                        <input type="hidden" asp-for="ShowMapModal" />
                        <input type="hidden" asp-for="ShowCustomLocation" />
                        <input type="hidden" asp-for="ShowConfidentialInfo" />
                        
                        <!-- Hazard Type -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label for="hazardType" class="form-label mb-0">Hazard Type <span class="text-danger">*</span></label>
                            </div>
                            <div class="input-group">
                                <select class="form-select" id="hazardType" asp-for="HazardReport.HazardType" 
                                        asp-items="Model.HazardTypeOptions" required>
                                </select>
                                
                            </div>
                           
                            <span asp-validation-for="HazardReport.HazardType" class="text-danger"></span>
                        </div>

                        <!-- Reported By and Reported On -->
                        <div class="mb-3">
                            <div class="row">
                                <div class="col-md-8">
                                    <label for="reportedBy" class="form-label">Reported By <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="reportedBy" asp-for="HazardReport.ReportedBy" 
                                           placeholder="Provide the name and position of the person reporting this hazard (e.g., 'John Smith - Ground Operations Supervisor')" 
                                           required maxlength="200">
                                    
                                    <span asp-validation-for="HazardReport.ReportedBy" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <label for="reportedOn" class="form-label">Reported On <span class="text-danger">*</span></label>
                                    <input type="datetime-local" class="form-control" id="reportedOn" asp-for="HazardReport.ReportedOn" 
                                           required max="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" 
                                           step="60">
                                    <span asp-validation-for="HazardReport.ReportedOn" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Department -->
                        <div class="mb-3">
                            <label for="department" class="form-label">Reporting Department</label>
                            <select class="form-select" id="department" asp-for="HazardReport.Department" 
                                    asp-items="Model.DepartmentOptions">
                                <option value="">Select your department...</option>
                            </select>
                            <span asp-validation-for="HazardReport.Department" class="text-danger"></span>
                        </div>

                        <!-- Location -->
                        <div class="mb-3">
                            <label for="location" class="form-label">Location <span class="text-danger">*</span></label>
                                                       
                            <!-- Map-Only Location Selection -->
                            <div class="input-group">
                                <button type="submit" class="btn btn-primary" formaction="?handler=OpenMapSelector" formnovalidate>
                                    <i class="fas fa-map-marked-alt"></i> Select on Map
                                </button>
                                <input type="text" class="form-control" id="locationDisplay" 
                                       value="@(Model.HasGeoLocation ? Model.GetSelectedLocationText() : "No location selected - click 'Select on Map'")" 
                                       readonly placeholder="Use the map to select a location">
                            </div>
                            
                                                       
                            <span asp-validation-for="HazardReport.Location" class="text-danger"></span>
                        </div>
                      
                        <!-- Description -->
                        <div class="mb-3">
                            <label for="description" class="form-label">Hazard Description <span class="text-danger">*</span></label>
                            <textarea class="form-control @(Model.DescriptionAtLimit ? "border-danger" : Model.DescriptionNearLimit ? "border-warning" : "")" 
                                      id="description" asp-for="HazardReport.Description" rows="6" 
                                      placeholder="Provide a detailed description of the hazard, including:
                                                                                            • What happened or was observed?
                                                                                            • When did it occur? (date/time)
                                                                                            • Who was involved?
                                                                                            • What were the weather/operating conditions?
                                                                                            • What immediate actions were taken?
                                                                                            • What could have been the consequences?
                                                                                            • What do you think contributed to this hazard?" required maxlength="2000"></textarea>
                            <div class="form-text">
                                <span class="float-end">
                                    <span class="@(Model.DescriptionAtLimit ? "text-danger" : Model.DescriptionNearLimit ? "text-warning" : "")">
                                        @Model.DescriptionCharacterCount
                                    </span>/2000 characters
                                </span>
                            </div>
                            <span asp-validation-for="HazardReport.Description" class="text-danger"></span>
                        </div>

                        <!-- Confidential Flag -->
                        <div class="mb-3">
                            <div class="card border-info">
                                <div class="card-body">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="isConfidential" asp-for="HazardReport.IsConfidential">
                                        <label class="form-check-label" for="isConfidential">
                                            <i class="fas fa-lock text-primary"></i> <strong>Submit as Confidential Report</strong>
                                        </label>
                                        <button type="submit" class="btn btn-sm btn-outline-primary ms-2" formaction="?handler=ToggleConfidential">
                                            <i class="fas fa-info-circle"></i> Info
                                        </button>
                                    </div>
                                    
                                    @if (Model.ShowConfidentialInfo)
                                    {
                                        <div class="mt-2">
                                            <div class="alert alert-info small mb-0">
                                                <i class="fas fa-shield-alt"></i> 
                                                <strong>Confidential Protection:</strong> Your identity will be protected and access to this report will be restricted to authorized SMS personnel only.
                                                <br><strong>Benefits:</strong> Enhanced protection from retaliation, restricted access, anonymous follow-up options.
                                                <br><strong>Note:</strong> Confidential reports may take longer to process due to additional security measures.
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- File Attachments -->
                        <div class="mb-3">
                            <label for="attachments" class="form-label">Supporting Documents</label>
                            <input type="file" class="form-control" id="attachments" asp-for="HazardReport.Attachments" multiple 
                                   accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.txt">
                            <div class="form-text">
                                <i class="fas fa-paperclip"></i> Attach photos, documents, or other supporting evidence
                                <br><strong>Supported formats:</strong> JPG, PNG, PDF, DOC, DOCX, TXT (Max 10MB per file)
                            </div>
                            
                            @* Server-side file list display *@
                            @if (Model.SelectedFiles.Any())
                            {
                                <div class="mt-2">
                                    <div class="alert alert-info small">
                                        <strong>Selected files:</strong>
                                        <ul class="mb-0 mt-1">
                                            @foreach (var file in Model.SelectedFiles)
                                            {
                                                <li>@file.Name (@file.SizeDisplay)</li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Form Actions -->
                        <div class="row">
                            <div class="col-12">
                                <hr>
                                <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                                    <div>
                                        <button type="submit" class="btn btn-outline-info" formaction="?handler=ShowPreview" formnovalidate>
                                            <i class="fas fa-eye"></i> Preview Report
                                        </button>
                                    </div>
                                    <div>
                                        <button type="submit" class="btn btn-secondary" formaction="?handler=ClearForm">
                                            <i class="fas fa-times"></i> Clear Form
                                        </button>
                                        <button type="submit" class="btn btn-danger" formaction="?handler=ShowSubmissionConfirmation" formnovalidate>
                                            <i class="fas fa-paper-plane"></i> Submit Hazard Report
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Server-side Preview Modal (conditionally rendered) -->
            @if (Model.ShowPreview)
            {
                <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                    <div class="modal-dialog modal-xl">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <div class="row w-100 align-items-center">
                                    <div class="col">
                                        <h5 class="mb-0">
                                            <i class="fas fa-eye"></i> Hazard Report Preview
                                        </h5>
                                        @* <small>Review your report before submitting</small> *@
                                    </div>
                                    <div class="col-auto">
                                        <form method="post" style="display: inline;">
                                            <!-- Hidden fields to preserve all data -->
                                            <input type="hidden" asp-for="HazardReport.HazardType" />
                                            <input type="hidden" asp-for="HazardReport.ReportedBy" />
                                            <input type="hidden" asp-for="HazardReport.ReportedOn" />
                                            <input type="hidden" asp-for="HazardReport.Department" />
                                            <input type="hidden" asp-for="HazardReport.Description" />
                                            <input type="hidden" asp-for="HazardReport.IsConfidential" />
                                            <input type="hidden" asp-for="HazardReport.Priority" />
                                            <input type="hidden" asp-for="HazardReport.Location" />
                                            <input type="hidden" asp-for="SelectedGeoLocation.Latitude" />
                                            <input type="hidden" asp-for="SelectedGeoLocation.Longitude" />
                                            <input type="hidden" asp-for="SelectedGeoLocation.Description" />
                                            <input type="hidden" asp-for="SelectedGeoLocation.SelectedDateTime" />
                                            <input type="hidden" asp-for="ShowMapModal" />
                                            <input type="hidden" asp-for="ShowCustomLocation" />
                                            <input type="hidden" asp-for="ShowConfidentialInfo" />
                                            
                                            <button type="submit" class="btn-close btn-close-white" formaction="?handler=HidePreview" formnovalidate></button>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <div class="modal-body">
                                <!-- Hidden form to preserve all data during preview operations -->
                                <form method="post" style="display: none;">
                                    <!-- Main form data -->
                                    <input type="hidden" asp-for="HazardReport.HazardType" />
                                    <input type="hidden" asp-for="HazardReport.ReportedBy" />
                                    <input type="hidden" asp-for="HazardReport.ReportedOn" />
                                    <input type="hidden" asp-for="HazardReport.Department" />
                                    <input type="hidden" asp-for="HazardReport.Description" />
                                    <input type="hidden" asp-for="HazardReport.IsConfidential" />
                                    <input type="hidden" asp-for="HazardReport.Priority" />
                                    <input type="hidden" asp-for="HazardReport.Location" />
                                    
                                    <!-- Geolocation data -->
                                    <input type="hidden" asp-for="SelectedGeoLocation.Latitude" />
                                    <input type="hidden" asp-for="SelectedGeoLocation.Longitude" />
                                    <input type="hidden" asp-for="SelectedGeoLocation.Description" />
                                    <input type="hidden" asp-for="SelectedGeoLocation.SelectedDateTime" />
                                    
                                    <!-- UI state -->
                                    <input type="hidden" asp-for="ShowPreview" value="true" />
                                    <input type="hidden" asp-for="ShowMapModal" />
                                    <input type="hidden" asp-for="ShowCustomLocation" />
                                    <input type="hidden" asp-for="ShowConfidentialInfo" />
                                </form>
                                
                                <!-- Preview Header Summary -->
                                <div class="row mb-4">
                                    <div class="col-md-12">
                                        <div class="card border-primary">
                                            <div class="card-header bg-primary text-white">
                                                <h6 class="mb-0"><i class="fas fa-info-circle"></i> Report Summary
                                                </h6>
                                            </div>
                                            <div class="card-body">
                                                                       
                                                <div class="row">
                                            <div class="col-12">
                                        <div class="table-responsive">
                                            <table class="table table-bordered table-hover">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th width="25%" class="text-primary">Field</th>
                                                        <th class="text-primary">Details</th>
                                                        <th width="10%" class="text-center text-primary">Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <th class="bg-light">
                                                            <i class="fas fa-exclamation-triangle text-danger"></i> Hazard Type
                                                        </th>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(Model.HazardReport.HazardType))
                                                            {
                                                                <span class="fw-bold">@Model.GetSelectedHazardTypeText()</span>
                                                            }
                                                            else
                                                            {
                                                                <em class="text-muted">Not selected - Please select a hazard type</em>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @if (!string.IsNullOrEmpty(Model.HazardReport.HazardType))
                                                            {
                                                                <i class="fas fa-check-circle text-success"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="fas fa-times-circle text-danger"></i>
                                                            }
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">
                                                            <i class="fas fa-map-marker-alt text-primary"></i> Location
                                                        </th>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(Model.HazardReport.Location) || Model.HasGeoLocation)
                                                            {
                                                                <div>
                                                                     
                                                                    @if (Model.HasGeoLocation)
                                                                    {
                                                                        
                                                                        <span class="fw-bold">@Model.GetSelectedLocationText()</span>
                                    
                                                                    }
                                                                    else
                                                                    {
                                                                        
                                                                        <small class="text-warning">
                                                                            <i class="fas fa-exclamation-triangle"></i> 
                                                                            <strong>No geolocation data</strong> - Location: "@Model.HazardReport.Location"
                                                                        </small>
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <em class="text-muted">Not specified - Please select or enter a location</em>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @if (!string.IsNullOrEmpty(Model.HazardReport.Location) || Model.HasGeoLocation)
                                                            {
                                                                <i class="fas fa-check-circle text-success"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="fas fa-times-circle text-danger"></i>
                                                            }
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">
                                                            <i class="fas fa-user text-info"></i> Reported By
                                                        </th>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(Model.HazardReport.ReportedBy))
                                                            {
                                                                <span class="fw-bold">@Model.HazardReport.ReportedBy</span>
                                                            }
                                                            else
                                                            {
                                                                <em class="text-muted">Not specified - Please enter who is reporting this hazard</em>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @if (!string.IsNullOrEmpty(Model.HazardReport.ReportedBy))
                                                            {
                                                                <i class="fas fa-check-circle text-success"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="fas fa-times-circle text-danger"></i>
                                                            }
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">
                                                            <i class="fas fa-clock text-info"></i> Reported On
                                                        </th>
                                                        <td>
                                                            <span class="fw-bold">@Model.HazardReport.ReportedOn.ToString("dddd, MMMM dd, yyyy 'at' h:mm tt")</span>
                                                            <br>
                                                            <small class="text-muted">
                                                                @{
                                                                    var timeAgo = DateTime.Now - Model.HazardReport.ReportedOn;
                                                                    string timeAgoText = timeAgo.TotalDays >= 1 
                                                                        ? $"{Math.Floor(timeAgo.TotalDays)} day(s) ago"
                                                                        : timeAgo.TotalHours >= 1 
                                                                            ? $"{Math.Floor(timeAgo.TotalHours)} hour(s) ago"
                                                                            : $"{Math.Floor(timeAgo.TotalMinutes)} minute(s) ago";
                                                                }
                                                                <i class="fas fa-history"></i> @timeAgoText
                                                            </small>
                                                        </td>
                                                        <td class="text-center">
                                                            <i class="fas fa-check-circle text-success"></i>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">
                                                            <i class="fas fa-building text-info"></i> Department
                                                        </th>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(Model.HazardReport.Department))
                                                            {
                                                                <span class="fw-bold">@Model.GetSelectedDepartmentText()</span>
                                                            }
                                                            else
                                                            {
                                                                <em class="text-muted">Not specified (Optional)</em>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            <i class="fas fa-info-circle text-info" title="Optional field"></i>
                                                        </td>
                                                    </tr>
                                                    @*<tr>
                                                        <th class="bg-light">
                                                            <i class="fas fa-flag text-warning"></i> Priority
                                                        </th>
                                                        <td>
                                                            <span class="@Model.PriorityBadgeClass">@Model.GetSelectedPriorityText()</span>
                                                        </td>
                                                        <td class="text-center">
                                                            <i class="fas fa-check-circle text-success"></i>
                                                        </td>
                                                    </tr>
                                                    *@
                                                    <tr>
                                                        <th class="bg-light">
                                                            <i class="fas fa-file-alt text-success"></i> Description
                                                        </th>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(Model.HazardReport.Description))
                                                            {
                                                                <div class="description-preview">
                                                                    <div style="white-space: pre-wrap; max-height: 150px; overflow-y: auto; border: 1px solid #dee2e6; padding: 0.5rem; border-radius: 0.25rem; background-color: #f8f9fa;">@Model.HazardReport.Description</div>
                                                                    <small class="text-muted mt-1 d-block">
                                                                        <i class="fas fa-chart-bar"></i> 
                                                                        Character count: @Model.DescriptionCharacterCount/2000
                                                                        @if (Model.DescriptionNearLimit)
                                                                        {
                                                                            <span class="@(Model.DescriptionAtLimit ? "text-danger" : "text-warning")">
                                                                                (@(Model.DescriptionAtLimit ? "At limit" : "Near limit"))
                                                                            </span>
                                                                        }
                                                                    </small>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <em class="text-muted">No description provided - Please describe the hazard</em>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @if (!string.IsNullOrEmpty(Model.HazardReport.Description))
                                                            {
                                                                <i class="fas fa-check-circle text-success"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="fas fa-times-circle text-danger"></i>
                                                            }
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">
                                                            <i class="fas fa-paperclip text-secondary"></i> Attachments
                                                        </th>
                                                        <td>
                                                            @if (Model.SelectedFiles.Any())
                                                            {
                                                                <div class="attachment-preview">
                                                                    <span class="fw-bold text-success">@Model.SelectedFiles.Count file(s) attached:</span>
                                                                    <ul class="mb-0 mt-1">
                                                                        @foreach (var file in Model.SelectedFiles)
                                                                        {
                                                                            <li>
                                                                                <i class="fas fa-file"></i> 
                                                                                <strong>@file.Name</strong> 
                                                                                <small class="text-muted">(@file.SizeDisplay)</small>
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <em class="text-muted">No files attached (Optional)</em>
                                                            }
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th class="bg-light">
                                                            <i class="fas fa-shield-alt text-warning"></i> Confidentiality
                                                        </th>
                                                        <td>
                                                            @if (Model.HazardReport.IsConfidential)
                                                            {
                                                                // <div class="alert alert-warning mb-0 py-2">
                                                                    <i class="fas fa-lock"></i> 
                                                                    <strong>Confidential Report</strong>
                                                                    <br><small>Your identity will be protected and access will be restricted to authorized SMS personnel only.</small>
                                                                // </div>
                                                            }
                                                            else
                                                            {
                                                                // <div class="alert alert-info mb-0 py-2">
                                                                    <i class="fas fa-unlock"></i> 
                                                                    <strong>Standard Report</strong>
                                                                    <br><small>Report will follow normal processing and visibility procedures.</small>
                                                                // </div>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            <i class="fas fa-check-circle text-success"></i>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @* <div class="col-md-4">
                                        <div class="card border-secondary">
                                            <div class="card-header bg-secondary text-white">
                                                <h6 class="mb-0"><i class="fas fa-chart-pie"></i> Completion Status</h6>
                                            </div>
                                            <div class="card-body text-center">
                                               
                                                
                                                <div class="progress mb-2">
                                                    <div class="progress-bar @(previewIsComplete ? "bg-success" : "bg-warning")" 
                                                         style="width: @previewProgressPercent%">
                                                        @previewProgressPercent%
                                                    </div>
                                                </div>
                                                <small class="@(previewIsComplete ? "text-success" : "text-warning")">
                                                    <i class="fas fa-@(previewIsComplete ? "check-circle" : "exclamation-triangle")"></i>
                                                    @previewCompletedFields of @previewTotalFields required fields completed
                                                </small>
                                            </div>
                                        </div>
                                    </div> *@
                                </div>

                                <!-- Detailed Information -->
                                

                                <!-- Validation Summary -->
                                 @{
                                    var previewCompletedFields = 0;
                                    var previewTotalFields = 5; // Updated to include ReportedOn
                                    if (!string.IsNullOrEmpty(Model.HazardReport.HazardType)) previewCompletedFields++;
                                    if (!string.IsNullOrEmpty(Model.HazardReport.Location) || Model.HasGeoLocation) previewCompletedFields++;
                                    if (!string.IsNullOrEmpty(Model.HazardReport.Description)) previewCompletedFields++;
                                    if (!string.IsNullOrEmpty(Model.HazardReport.ReportedBy)) previewCompletedFields++; // Added ReportedBy check
                                    previewCompletedFields++; // ReportedOn always has a value due to default
                                    var previewProgressPercent = (previewCompletedFields * 100) / previewTotalFields;
                                    var previewIsComplete = previewCompletedFields == previewTotalFields;
                                 }
                                
