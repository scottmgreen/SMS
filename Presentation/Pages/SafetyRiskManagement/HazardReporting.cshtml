                                </form>
                                <div class="mt-2">
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle"></i> Clicking this button will clear the form for a new hazard report
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <!-- Leaflet.js CSS and JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" 
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" 
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <!-- Success Modal Fallback -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Check if success modal should be showing
            const showSuccessModal = @Model.ShowFinalSuccessConfirmation.ToString().ToLower();
            const hazardReportId = '@Model.GeneratedHazardReportId';
            
            // If success modal should be showing but modal element is not found, show fallback alert
            if (showSuccessModal && hazardReportId && hazardReportId.startsWith('HZ-')) {
                // Check if the modal is actually visible after a short delay
                setTimeout(function() {
                    const modalElement = document.querySelector('[data-bs-backdrop="static"][data-bs-keyboard="false"]');
                    
                    // If no modal found or modal is not visible, show fallback
                    if (!modalElement || modalElement.style.display === 'none') {
                        const message = `🎉 HAZARD REPORT SUBMITTED SUCCESSFULLY!\n\n` +
                                      `Your Hazard Report ID: ${hazardReportId}\n\n` +
                                      `✅ Please save this ID for your records\n` +
                                      `✅ Your report will be reviewed within 24-48 hours\n` +
                                      `✅ You will be notified of any status changes\n\n` +
                                      `Contact SMS Team: (503) 555-0100\n` +
                                      `Email: sms@flypdx.com`;
                        
                        alert(message);
                        
                        // Optional: Clear the form after successful submission
                        setTimeout(function() {
                            if (confirm('Would you like to clear the form to submit another report?')) {
                                const clearButton = document.querySelector('button[formaction*="ClearForm"]');
                                if (clearButton) {
                                    clearButton.click();
                                }
                            }
                        }, 1000);
                    }
                }, 500);
            }
        });
    </script>

    @if (Model.ShowMapModal)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                // Initialize map with specific options to ensure click events work
                var map = L.map('hazardLocationMap', {
                    center: [@Model.AirportCenterLatitude, @Model.AirportCenterLongitude],
                    zoom: @Model.DefaultZoomLevel,
                    zoomControl: true,
                    doubleClickZoom: true,
                    closePopupOnClick: true,
                    trackResize: true
                });

                // Add OpenStreetMap tiles
                var streetMap = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                    maxZoom: 19
                });

                // Add satellite imagery as an option
                var satellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                    attribution: 'Tiles © Esri — Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, and the GIS User Community',
                    maxZoom: 19
                });

                // Add default layer
                streetMap.addTo(map);

                // Layer control
                var baseMaps = {
                    "Street Map": streetMap,
                    "Satellite": satellite
                };
                L.control.layers(baseMaps).addTo(map);

                // Global variables
                window.mapInstance = map;
                window.selectedMarker = null;

                // Function to check if coordinates are within bounds - PROPER PDX AIRPORT BOUNDS
                window.isWithinBounds = function(lat, lng) {
                    // CORRECTED PDX Airport bounds - actual airport property boundaries
                    return lat >= 45.580 && lat <= 45.595 && lng >= -122.610 && lng <= -122.580;
                };

                // Custom icon for selected location
                var selectedIcon = L.divIcon({
                    html: '<div style="background-color: #dc3545; border: 3px solid #fff; border-radius: 50%; width: 24px; height: 24px; box-shadow: 0 3px 6px rgba(0,0,0,0.4); position: relative;"><div style="position: absolute; bottom: -8px; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 6px solid transparent; border-right: 6px solid transparent; border-top: 8px solid #dc3545;"></div></div>',
                    iconSize: [24, 32],
                    iconAnchor: [12, 32],
                    popupAnchor: [0, -32],
                    className: 'custom-red-marker'
                });

                // Function to set map location
                window.setMapLocation = function(lat, lng, description) {
                    // Remove existing selected marker
                    if (window.selectedMarker) {
                        map.removeLayer(window.selectedMarker);
                        window.selectedMarker = null;
                    }
                    
                    // Add new marker
                    window.selectedMarker = L.marker([lat, lng], {icon: selectedIcon})
                        .addTo(map)
                        .bindPopup('<strong>Selected Location</strong><br>' + description + '<br><small>Coordinates: ' + lat.toFixed(6) + ', ' + lng.toFixed(6) + '</small>');
                    
                    // Update form fields
                    var latField = document.getElementById('selectedLatitude');
                    var lngField = document.getElementById('selectedLongitude');
                    var descField = document.getElementById('locationDescription');
                    
                    if (latField) latField.value = lat.toFixed(6);
                    if (lngField) lngField.value = lng.toFixed(6); // FIXED: was incorrectly lat.toFixed(6)
                    if (descField) descField.value = description;
                    
                    // Update hidden form fields with current main form data
                    var mainForm = document.querySelector('form[method="post"]:not(#locationForm)');
                    if (mainForm) {
                        var hazardTypeField = mainForm.querySelector('[name="HazardReport.HazardType"]');
                        var reportedByField = mainForm.querySelector('[name="HazardReport.ReportedBy"]');
                        var reportedOnField = mainForm.querySelector('[name="HazardReport.ReportedOn"]');
                        var departmentField = mainForm.querySelector('[name="HazardReport.Department"]');
                        var descriptionField = mainForm.querySelector('[name="HazardReport.Description"]');
                        var confidentialField = mainForm.querySelector('[name="HazardReport.IsConfidential"]');
                        var priorityField = mainForm.querySelector('[name="HazardReport.Priority"]');
                        
                        // Update hidden fields in location form
                        var locationForm = document.getElementById('locationForm');
                        if (locationForm) {
                            updateHiddenField(locationForm, 'HazardReport.HazardType', hazardTypeField?.value || '');
                            updateHiddenField(locationForm, 'HazardReport.ReportedBy', reportedByField?.value || '');
                            updateHiddenField(locationForm, 'HazardReport.ReportedOn', reportedOnField?.value || '');
                            updateHiddenField(locationForm, 'HazardReport.Department', departmentField?.value || '');
                            updateHiddenField(locationForm, 'HazardReport.Description', descriptionField?.value || '');
                            updateHiddenField(locationForm, 'HazardReport.IsConfidential', confidentialField?.checked || false);
                            updateHiddenField(locationForm, 'HazardReport.Priority', priorityField?.value || 'MEDIUM');
                        }
                    }
                    
                    // Center map on selection
                    map.setView([lat, lng], 17);
                    
                    // Update coordinates display
                    var coordsDiv = document.querySelector('.leaflet-control-coordinates');
                    if(coordsDiv) {
                        coordsDiv.innerHTML = '<span style="color: #0066cc;">📍 Location selected: ' + lat.toFixed(6) + ', ' + lng.toFixed(6) + '</span>';
                    }
                };
                
                // Helper function to update hidden fields
                function updateHiddenField(form, name, value) {
                    var field = form.querySelector('[name="' + name + '"]');
                    if (field) {
                        field.value = value;
                    } else {
                        var hiddenField = document.createElement('input');
                        hiddenField.type = 'hidden';
                        hiddenField.name = name;
                        hiddenField.value = value;
                        form.appendChild(hiddenField);
                    }
                }

                // Set initial marker if coordinates exist
                @if (Model.HasGeoLocation)
                {
                    <text>
                    setTimeout(function() {
                        setMapLocation(@Model.SelectedGeoLocation.Latitude, @Model.SelectedGeoLocation.Longitude, '@Html.Raw(Model.GeoLocationDescription)');
                    }, 500);
                    </text>
                }

                // Function to clear selection - FIXED to return to PDX center
                window.clearMapSelection = function() {
                    if (window.selectedMarker) {
                        map.removeLayer(window.selectedMarker);
                        window.selectedMarker = null;
                    }
                    
                    var latField = document.getElementById('selectedLatitude');
                    var lngField = document.getElementById('selectedLongitude');
                    var descField = document.getElementById('locationDescription');
                    
                    if (latField) latField.value = '';
                    if (lngField) lngField.value = '';
                    if (descField) descField.value = '';
                    
                    // FIXED: Return to PDX airport center instead of random location
                    map.setView([@Model.AirportCenterLatitude, @Model.AirportCenterLongitude], @Model.DefaultZoomLevel);
                    
                    var coordsDiv = document.querySelector('.leaflet-control-coordinates');
                    if (coordsDiv) {
                        coordsDiv.innerHTML = '<span style="color: #0066cc;">🔍 Click anywhere on the map to select location</span>';
                    }
                };
                
                // Add PDX airport boundary - ENSURE it doesn't block clicks
                var pdxBounds = [
                    [45.580, -122.610], [45.580, -122.580], [45.595, -122.580], 
                    [45.595, -122.610], [45.580, -122.610]
                ];
                
                var boundaryPolygon = L.polygon(pdxBounds, {
                    color: '#0066cc',
                    weight: 3,
                    opacity: 0.8,
                    fillColor: '#0066cc',
                    fillOpacity: 0.1,
                    dashArray: '10, 10',
                    interactive: false,  // CRITICAL: Non-interactive
                    bubblingMouseEvents: false,  // CRITICAL: Don't interfere with events
                    pane: 'overlayPane' // Put it in the right pane
                }).addTo(map);
                
                // Force cursor to crosshair initially
                map.getContainer().style.cursor = 'crosshair';

                // Add scale control
                L.control.scale({
                    position: 'bottomright',
                    imperial: true,
                    metric: true
                }).addTo(map);

                // Add coordinates display control
                var coordsControl = L.control({position: 'bottomleft'});
                coordsControl.onAdd = function(map) {
                    var div = L.DomUtil.create('div', 'leaflet-control-coordinates');
                    div.style.background = 'rgba(255, 255, 255, 0.95)';
                    div.style.padding = '10px';
                    div.style.fontSize = '13px';
                    div.style.borderRadius = '6px';
                    div.style.border = '2px solid #0066cc';
                    div.style.boxShadow = '0 3px 6px rgba(0,0,0,0.3)';
                    div.style.fontWeight = 'bold';
                    div.innerHTML = '<span style="color: #0066cc;">🔍 Click anywhere on the map to select location</span>';
                    return div;
                };
                coordsControl.addTo(map);
                
                // SIMPLIFIED CSS - don't override Leaflet's default behavior
                var style = document.createElement('style');
                style.textContent = `
                    .leaflet-container {
                        cursor: crosshair;
                    }
                    .leaflet-control button {
                        cursor: pointer !important;
                    }
                `;
                document.head.appendChild(style);

                // Update coordinates display on mouse move with CORRECT cursor feedback
                map.on('mousemove', function(e) {
                    var coords = e.latlng.lat.toFixed(6) + ', ' + e.latlng.lng.toFixed(6);
                    var withinBounds = window.isWithinBounds(e.latlng.lat, e.latlng.lng);
                    var coordsDiv = document.querySelector('.leaflet-control-coordinates');
                    
                    // CORRECT cursor behavior: crosshair inside, grab (hand) outside
                    if (withinBounds) {
                        map.getContainer().style.cursor = 'crosshair';
                    } else {
                        map.getContainer().style.cursor = 'grab'; // Hand cursor outside boundary
                    }
                    
                    if (coordsDiv && !window.selectedMarker) {
                        if (withinBounds) {
                            coordsDiv.innerHTML = '<span style="color: green; font-weight: bold;">👆 CLICK HERE: ' + coords + '</span>';
                        } else {
                            coordsDiv.innerHTML = '<span style="color: red;">❌ Outside bounds: ' + coords + '</span>';
                        }
                    }
                });

                // Main map click handler - ENHANCED with debugging
                map.on('click', function(e) {
                    console.log('=== MAP CLICK DETECTED ===');
                    console.log('Click coordinates:', e.latlng.lat, e.latlng.lng);
                    
                    var lat = e.latlng.lat;
                    var lng = e.latlng.lng;
                    
                    // Check if within bounds
                    var withinBounds = window.isWithinBounds(lat, lng);
                    console.log('Within bounds:', withinBounds);
                    
                    if (!withinBounds) {
                        console.log('Click outside bounds - showing alert');
                        alert('Please click within the PDX airport boundary (blue dashed area).\n\nYour click: ' + lat.toFixed(6) + ', ' + lng.toFixed(6) + '');
                        return;
                    }
                    
                    console.log('Valid click - calling setMapLocation');
                    setMapLocation(lat, lng, 'Custom map location');
                });
            });

            // Geolocation Functions
            function tryAutoDetectLocation() {
                if (!navigator.geolocation) return;

                navigator.geolocation.getCurrentPosition(
                    function(position) {
                        var userLat = position.coords.latitude;
                        var userLng = position.coords.longitude;
                        
                        // Check if user is within PDX airport area
                        if (isWithinExpandedBounds(userLat, userLng)) {
                            setMapLocation(userLat, userLng, 'Your current location (GPS)');
                        } else {
                            // Just center the map on airport but don't select location
                            map.setView([userLat, userLng], 13);
                        }
                    },
                    function(error) {
                        // Silent fail - user can select manually
                    },
                    {
                        enableHighAccuracy: true,
                        timeout: 10000,
                        maximumAge: 60000
                    }
                );
            }

            // Manual current location button
            window.getCurrentLocation = function() {
                if (!navigator.geolocation) {
                    alert('Geolocation is not supported by your browser.');
                    return;
                }

                var btn = document.getElementById('getCurrentLocationBtn');
                var originalHtml = btn.innerHTML;
                
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Getting Location...';
                btn.disabled = true;

                navigator.geolocation.getCurrentPosition(
                    function(position) {
                        var userLat = position.coords.latitude;
                        var userLng = position.coords.longitude;
                        
                        btn.innerHTML = originalHtml;
                        btn.disabled = false;
                        
                        if (isWithinExpandedBounds(userLat, userLng)) {
                            setMapLocation(userLat, userLng, 'Your current location (GPS)');
                        } else {
                            setMapLocation(userLat, userLng, 'Your current location (GPS) - Outside airport area');
                            map.setView([userLat, userLng], 12);
                        }
                    },
                    function(error) {
                        btn.innerHTML = originalHtml;
                        btn.disabled = false;
                        
                        var errorMsg = 'Unable to get your location. Please select manually on the map.';
                        alert(errorMsg);
                    },
                    {
                        enableHighAccuracy: true,
                        timeout: 15000,
                        maximumAge: 30000
                    }
                );
            };

            // Helper function to check expanded bounds - CORRECTED PDX bounds
            function isWithinExpandedBounds(lat, lng) {
                // CORRECTED PDX Airport bounds - actual airport property boundaries
                return lat >= 45.580 && lat <= 45.595 && lng >= -122.610 && lng <= -122.580;
            }

            // Add validation function for form submission - CORRECTED bounds
            window.validateCoordinates = function() {
                var lat = document.getElementById('selectedLatitude').value;
                var lng = document.getElementById('selectedLongitude').value;
                
                if (!lat || !lng) {
                    alert('Please select a location on the map first.');
                    return false;
                }
                
                var latNum = parseFloat(lat);
                var lngNum = parseFloat(lng);
                
                // Use CORRECTED PDX airport bounds
                if (latNum < 45.580 || latNum > 45.595 || lngNum < -122.610 || lngNum > -122.580) {
                    alert('Selected coordinates are outside the valid PDX airport area.');
                    return false;
                }
                
                return true;
            };
        </script>
    }
}

