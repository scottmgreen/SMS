@page
@model PDXSMS_Presentation.Pages.SafetyRiskManagement.DataNormalizationModel
@{
    ViewData["Title"] = "Risk Assessment Data Normalization";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h4><i class="fas fa-database"></i> Risk Assessment Data Normalization</h4>
                    <p class="mb-0">Clean up redundant data and optimize risk assessment JSON structure</p>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ResultMessage))
                    {
                        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")" role="alert">
                            @Html.Raw(Model.ResultMessage)
                        </div>
                    }

                    <div class="row">
                        <!-- Current Issues -->
                        <div class="col-md-6">
                            <h5><i class="fas fa-exclamation-triangle text-warning"></i> Current Issues Identified</h5>
                            <ul class="list-group mb-4">
                                <li class="list-group-item">
                                    <strong>Duplicate Hazard References:</strong>
                                    <ul class="mt-2">
                                        <li><code>referencedHazardIds</code></li>
                                        <li><code>initialHazardId</code></li>
                                        <li><code>validationData.hazardId</code></li>
                                        <li><code>hazardValidationData.sourceHazardId</code></li>
                                    </ul>
                                </li>
                                <li class="list-group-item">
                                    <strong>Duplicate Airport Datasets:</strong>
                                    <ul class="mt-2">
                                        <li><code>validationData.airportSharedDataset</code></li>
                                        <li><code>hazardValidationData.airportSharedDataset</code></li>
                                    </ul>
                                </li>
                                <li class="list-group-item">
                                    <strong>Redundant Validation Data:</strong>
                                    <ul class="mt-2">
                                        <li>Multiple validation objects with same data</li>
                                        <li>Inconsistent property naming</li>
                                    </ul>
                                </li>
                                <li class="list-group-item">
                                    <strong>Step 3 Loading Issues:</strong>
                                    <ul class="mt-2">
                                        <li>Saved data not being restored to form fields</li>
                                        <li>Hazard analysis data not populating</li>
                                    </ul>
                                </li>
                            </ul>
                        </div>

                        <!-- Normalization Benefits -->
                        <div class="col-md-6">
                            <h5><i class="fas fa-check-circle text-success"></i> Normalization Benefits</h5>
                            <ul class="list-group mb-4">
                                <li class="list-group-item list-group-item-success">
                                    <strong>Single Source of Truth:</strong> One <code>primaryHazardId</code> field
                                </li>
                                <li class="list-group-item list-group-item-success">
                                    <strong>Clean Validation Data:</strong> Consolidated into single <code>validationData</code> object
                                </li>
                                <li class="list-group-item list-group-item-success">
                                    <strong>Optimized Structure:</strong> Eliminated redundant properties
                                </li>
                                <li class="list-group-item list-group-item-success">
                                    <strong>Proper Step Loading:</strong> Fixed Step 3 data restoration
                                </li>
                                <li class="list-group-item list-group-item-success">
                                    <strong>Database-Ready:</strong> Clean relational structure
                                </li>
                                <li class="list-group-item list-group-item-success">
                                    <strong>Performance:</strong> Smaller file size, faster loading
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="row">
                        <div class="col-12">
                            <h5><i class="fas fa-cogs"></i> Normalization Actions</h5>
                            
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i>
                                <strong>Recommended Process:</strong>
                                <ol class="mt-2 mb-0">
                                    <li>First, create a backup of your current data</li>
                                    <li>Then, run the normalization process</li>
                                    <li>Test your risk assessments to ensure everything works</li>
                                </ol>
                            </div>

                            <form method="post" class="d-inline">
                                <button type="submit" class="btn btn-secondary me-3" asp-page-handler="BackupCurrentData">
                                    <i class="fas fa-save"></i> Create Backup First
                                </button>
                            </form>

                            <form method="post" class="d-inline">
                                <button type="submit" class="btn btn-warning" asp-page-handler="Normalize" 
                                        onclick="return confirm('This will modify your risk assessment data structure. Have you created a backup? Continue?')">
                                    <i class="fas fa-database"></i> Normalize Data Structure
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Expected Results -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <h5><i class="fas fa-clipboard-list"></i> Expected Results After Normalization</h5>
                            <div class="card border-success">
                                <div class="card-body">
                                    <h6>Clean JSON Structure:</h6>
                                    <pre class="bg-light p-3"><code>{
  "id": "RA-20251024-8D4884",
  "name": "SMS5Step Risk Assessment for HZ-0029",
  "method": "SMS5Step",
  "primaryHazardId": "HZ-0029",
  "referencedHazardIds": ["HZ-0029", "HZ-0002"],
  "stepData": {
    "step1": { ... },
    "step2": { ... },
    "step3": { 
      "hazardAnalysisData": [
        {
          "hazardId": "HZ-0029",
          "worstCredibleOutcome": "...",
          "rootCause": "...",
          "additionalComments": "..."
        }
      ]
    }
  },
  "validationData": {
    "processingDecision": "sms_risk",
    "airportSharedDataset": { ... }
  }
}</code></pre>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
pre code {
    font-size: 0.85em;
    line-height: 1.4;
}

.list-group-item ul {
    margin-bottom: 0;
}

.list-group-item li {
    margin-bottom: 0.25rem;
}
</style>