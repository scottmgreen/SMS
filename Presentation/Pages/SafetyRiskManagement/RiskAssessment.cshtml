@page
@model PDXSMS_Presentation.Pages.SafetyRiskManagement.RiskAssessmentModel
@{
    ViewData["Title"] = "Five-Step Risk Assessment";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="#">Safety Risk Management</a></li>
                    <li class="breadcrumb-item active">Five-Step Risk Assessment</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h4 class="card-title"><i class="fas fa-clipboard-check"></i> SMS Risk Assessment</h4>
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <p class="card-text mb-0">Systematic risk evaluation using SMS methodology</p>
                        @* <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-primary">Step 1: Describe System</span>
                            <span class="badge bg-primary">Step 2: Identify Hazards</span>
                            <span class="badge bg-primary">Step 3: Analyze Risk</span>
                            <span class="badge bg-primary">Step 4: Assess Risk</span>
                            <span class="badge bg-primary">Step 5: Mitigate Risk</span>
                        </div> *@
                    </div>
                </div>
            </div>
        </div>
    </div>

   @*  @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    } *@

    <!-- Action Bar -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">Risk Assessment Management</h5>
                            <small class="text-muted">Manage systematic risk evaluations across all operational areas</small>
                        </div>
                        <div>
                            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#createAssessmentModal">
                                <i class="fas fa-plus"></i> Start New Assessment
                            </button>
                            <a href="/SafetyRiskManagement/RiskAssessmentScenarios" class="btn btn-outline-info">
                                <i class="fas fa-book"></i> View Scenarios
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Assessment Tabs -->
    <div class="row">
        <div class="col-12">
            <ul class="nav nav-tabs" id="assessmentTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="active-tab" data-bs-toggle="tab" data-bs-target="#active" type="button" role="tab">
                        <i class="fas fa-play-circle"></i> Active Assessments 
                        <span class="badge bg-warning ms-1">@Model.ActiveAssessments.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed" type="button" role="tab">
                        <i class="fas fa-check-circle"></i> Completed 
                        <span class="badge bg-success ms-1">@Model.CompletedAssessments.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="templates-tab" data-bs-toggle="tab" data-bs-target="#templates" type="button" role="tab">
                        <i class="fas fa-clipboard-list"></i> Templates
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="assessmentTabsContent">
                <!-- Active Assessments Tab -->
                <div class="tab-pane fade show active" id="active" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-tasks"></i> Active Risk Assessments</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.ActiveAssessments.Any())
                            {
                                <div class="row">
                                    @foreach (var assessment in Model.ActiveAssessments)
                                    {
                                        <div class="col-md-6 col-lg-4 mb-4">
                                            <div class="card border-warning">
                                                <div class="card-header bg-warning bg-opacity-10 d-flex justify-content-between align-items-center">
                                                    <strong>@assessment.Id</strong>
                                                    <div class="col-auto">
                                                        @if (assessment.Status == "From SMS Validation")
                                                        {
                                                            <span class="badge bg-info">
                                                                <i class="fas fa-check-circle"></i> From SMS Validation
                                                            </span>
                                                        }
                                                        else if (assessment.Status == "In Progress")
                                                        {
                                                            <span class="badge bg-primary">In Progress</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">@assessment.Status</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="card-body">
                                                    <h6 class="card-title">@assessment.Name</h6>
                                                    <p class="card-text small text-muted">
                                                        <i class="fas fa-user"></i> Lead: @assessment.LeadAssessor<br>
                                                        <i class="fas fa-calendar"></i> Started: @assessment.StartDate.ToString("MM/dd/yyyy")<br>
                                                        <i class="fas fa-clock"></i> Last Activity: @assessment.LastModified.ToString("MM/dd/yyyy HH:mm")
                                                    </p>
                                                    
                                                    <!-- Current Status -->
                                                    <div class="alert alert-info small mb-3">
                                                        <i class="fas fa-info-circle"></i>
                                                        <strong>Current Status:</strong><br>
                                                        @assessment.LastActivity
                                                    </div>
                                                    
                                                    <!-- Progress Bar -->
                                                    <div class="mb-3">
                                                        <div class="d-flex justify-content-between small mb-1">
                                                            <span>@assessment.CurrentStep</span>
                                                            <span>@assessment.CompletedSteps/@assessment.TotalSteps steps</span>
                                                        </div>
                                                        <div class="progress">
                                                            <div class="progress-bar bg-warning" role="progressbar" style="width: @assessment.Progress%">@assessment.Progress%</div>
                                                        </div>
                                                        <div class="small text-muted mt-1">
                                                            <i class="fas fa-chart-line"></i> Overall Progress: @assessment.Progress%
                                                        </div>
                                                    </div>

                                                    <!-- Action Buttons -->
                                                    <div class="d-grid gap-2">
                                                        @{
                                                            string buttonText = assessment.Method?.ToLowerInvariant() switch
                                                            {
                                                                "simplified" => "Continue Simplified Assessment",
                                                                "sms5step" or "technical" => $"Continue with Step {assessment.CompletedSteps + 1}",
                                                                _ => "Continue Assessment"
                                                            };
                                                        }
                                                        
                                                        <form method="post" asp-page-handler="ContinueAssessment">
                                                            <input type="hidden" name="assessmentId" value="@assessment.Id" />
                                                            <input type="hidden" name="method" value="@assessment.Method" />
                                                            <input type="hidden" name="hazardId" value="@assessment.HazardId" />
                                                            <button type="submit" class="btn btn-warning btn-sm">
                                                                <i class="fas fa-play"></i> @buttonText
                                                                @if (assessment.Method?.ToLowerInvariant() == "simplified")
                                                                {
                                                                    <small class="d-block">Single-step analysis</small>
                                                                }
                                                                else
                                                                {
                                                                    <small class="d-block">Resume at @assessment.CurrentStep</small>
                                                                }
                                                            </button>
                                                        </form>
                                                        
                                                        <div class="btn-group">
                                                            <a href="/SafetyRiskManagement/RiskAssessmentDetails/@assessment.Id" class="btn btn-outline-info btn-sm">
                                                                <i class="fas fa-eye"></i> View Details
                                                            </a>
                                                            @if (assessment.Method?.ToLowerInvariant() == "sms5step")
                                                            {
                                                                <a href="/SafetyRiskManagement/FiveMMethodology" class="btn btn-outline-secondary btn-sm">
                                                                    <i class="fas fa-book"></i> Guide
                                                                </a>
                                                            }
                                                        </div>
                                                    </div>

                                                    <!-- Method Badge -->
                                                    <div class="mt-2">
                                                        @if (assessment.Method?.ToLowerInvariant() == "simplified")
                                                        {
                                                            <span class="badge bg-success">
                                                                <i class="fas fa-tachometer-alt"></i> Simplified Method
                                                            </span>
                                                        }
                                                        else if (assessment.Method?.ToLowerInvariant() == "sms5step")
                                                        {
                                                            <span class="badge bg-primary">
                                                                <i class="fas fa-list-ol"></i> SMS 5-Step Method
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">
                                                                <i class="fas fa-cog"></i> @assessment.Method
                                                            </span>
                                                        }
                                                        
                                                        @if (!string.IsNullOrEmpty(assessment.AssessmentType) && assessment.AssessmentType != "Initial")
                                                        {
                                                            <span class="badge bg-info ms-1">@assessment.AssessmentType</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-5">
                                    <i class="fas fa-clipboard-check fa-3x"></i>
                                    <p class="mt-2">No active risk assessments</p>
                                    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#createAssessmentModal">
                                        Start Your First Assessment
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Completed Assessments Tab -->
                <div class="tab-pane fade" id="completed" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-archive"></i> Completed Risk Assessments</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.CompletedAssessments.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Assessment ID</th>
                                                <th>Name</th>
                                                <th>Lead Assessor</th>
                                                <th>Completed Date</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var assessment in Model.CompletedAssessments)
                                            {
                                                <tr>
                                                    <td><strong>@assessment.Id</strong></td>
                                                    <td>@assessment.Name</td>
                                                    <td>@assessment.LeadAssessor</td>
                                                    <td>@assessment.CompletedDate?.ToString("MM/dd/yyyy")</td>
                                                    <td><span class="badge bg-success">@assessment.Status</span></td>
                                                    <td>
                                                        <div class="btn-group" role="group">
                                                            <a href="/SafetyRiskManagement/RiskAssessmentDetails/@assessment.Id" class="btn btn-sm btn-outline-primary">
                                                                <i class="fas fa-eye"></i> View
                                                            </a>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary">
                                                                <i class="fas fa-download"></i> Export
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted">
                                    <i class="fas fa-archive fa-3x"></i>
                                    <p class="mt-2">No completed assessments</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Templates Tab -->
                <div class="tab-pane fade" id="templates" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-clipboard-list"></i> Assessment Templates</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 col-lg-4 mb-3">
                                    <div class="card border-info">
                                        <div class="card-body text-center">
                                            <i class="fas fa-plane fa-2x text-info mb-2"></i>
                                            <h6>Aircraft Operations</h6>
                                            <p class="small text-muted">Standard template for aircraft operational risk assessments</p>
                                            <button class="btn btn-outline-info btn-sm">Use Template</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-4 mb-3">
                                    <div class="card border-info">
                                        <div class="card-body text-center">
                                            <i class="fas fa-building fa-2x text-info mb-2"></i>
                                            <h6>Ground Operations</h6>
                                            <p class="small text-muted">Template for ground support and ramp operations</p>
                                            <button class="btn btn-outline-info btn-sm">Use Template</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-lg-4 mb-3">
                                    <div class="card border-info">
                                        <div class="card-body text-center">
                                            <i class="fas fa-users fa-2x text-info mb-2"></i>
                                            <h6>Passenger Operations</h6>
                                            <p class="small text-muted">Template for terminal and passenger-related operations</p>
                                            <button class="btn btn-outline-info btn-sm">Use Template</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Assessment Modal -->
<div class="modal fade" id="createAssessmentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Create New Risk Assessment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Assessment Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="NewAssessment.AssessmentName" placeholder="e.g., Terminal B Security Operations" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Assessment Scope <span class="text-danger">*</span></label>
                        <textarea class="form-control" asp-for="NewAssessment.AssessmentScope" rows="3" placeholder="Describe the boundaries and scope of this risk assessment..." required></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Lead Assessor <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="NewAssessment.LeadAssessor" required>
                                    <option value="">Select lead assessor...</option>
                                    <option value="Sarah Johnson">Sarah Johnson - Senior Safety Officer</option>
                                    <option value="Mike Brown">Mike Brown - Risk Assessment Specialist</option>
                                    <option value="Lisa Wilson">Lisa Wilson - Operations Safety Manager</option>
                                    <option value="Tom Davis">Tom Davis - SMS Coordinator</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Planned Start Date</label>
                                <input type="date" class="form-control" asp-for="NewAssessment.PlannedStartDate">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Planned Completion Date</label>
                                <input type="date" class="form-control" asp-for="NewAssessment.PlannedCompletionDate">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Assessment Template</label>
                                <select class="form-select">
                                    <option value="">Start from scratch</option>
                                    <option value="aircraft">Aircraft Operations Template</option>
                                    <option value="ground">Ground Operations Template</option>
                                    <option value="passenger">Passenger Operations Template</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Create Assessment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-focus assessment name when modal opens
        document.getElementById('createAssessmentModal').addEventListener('shown.bs.modal', function () {
            document.querySelector('input[name="NewAssessment.AssessmentName"]').focus();
        });
    </script>
}

