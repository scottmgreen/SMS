@page
@model PDXSMS_Presentation.Pages.SafetyRiskManagement.MitigationTrackingModel
@{
    ViewData["Title"] = "Track Mitigation Implementation";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="#">Safety Risk Management</a></li>
                    <li class="breadcrumb-item active">Track Mitigation Implementation</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h4 class="card-title"><i class="fas fa-tasks"></i> Track Mitigation Implementation</h4>
                    <p class="card-text">Monitor and verify the effectiveness of implemented risk mitigations</p>
                </div>
            </div>
        </div>
    </div>

    @* @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    } *@

    <!-- Metrics Dashboard -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center border-primary">
                <div class="card-body">
                    <h5 class="card-title text-primary">Active Mitigations</h5>
                    <h5 class="display-7">@Model.ActiveMitigations.Count</h5>
                    <p class="card-text">Currently in progress</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-danger">
                <div class="card-body">
                    <h5 class="card-title text-danger">Overdue</h5>
                    <h5 class="display-7">@Model.OverdueMitigations.Count</h5>
                    <p class="card-text">Require immediate attention</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-success">
                <div class="card-body">
                    <h5 class="card-title text-success">Completed</h5>
                    <h5 class="display-7">@Model.CompletedMitigations.Count</h5>
                    <p class="card-text">This month</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-info">
                <div class="card-body">
                    <h5 class="card-title text-info">Avg. Effectiveness</h5>
                    <h5 class="display-7">87%</h5>
                    <p class="card-text">Post-implementation rating</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Mitigation Tracking Tabs -->
    <div class="row">
        <div class="col-12">
            <ul class="nav nav-tabs" id="mitigationTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="active-tab" data-bs-toggle="tab" data-bs-target="#active" type="button" role="tab">
                        <i class="fas fa-play-circle"></i> Active Mitigations 
                        <span class="badge bg-primary ms-1">@Model.ActiveMitigations.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="overdue-tab" data-bs-toggle="tab" data-bs-target="#overdue" type="button" role="tab">
                        <i class="fas fa-exclamation-triangle"></i> Overdue 
                        <span class="badge bg-danger ms-1">@Model.OverdueMitigations.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed" type="button" role="tab">
                        <i class="fas fa-check-circle"></i> Completed
                        <span class="badge bg-success ms-1">@Model.CompletedMitigations.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="effectiveness-tab" data-bs-toggle="tab" data-bs-target="#effectiveness" type="button" role="tab">
                        <i class="fas fa-chart-bar"></i> Effectiveness Analysis
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="mitigationTabsContent">
                <!-- Active Mitigations Tab -->
                <div class="tab-pane fade show active" id="active" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-tasks"></i> Active Mitigation Implementation</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.ActiveMitigations.Any())
                            {
                                <div class="row">
                                    @foreach (var mitigation in Model.ActiveMitigations)
                                    {
                                        <div class="col-lg-6 mb-4">
                                            <div class="card border-primary">
                                                <div class="card-header bg-primary bg-opacity-10 d-flex justify-content-between align-items-center">
                                                    <strong>@mitigation.Id</strong>
                                                    <span class="badge bg-primary">@mitigation.Status</span>
                                                </div>
                                                <div class="card-body">
                                                    <h6 class="card-title">@mitigation.Title</h6>
                                                    <p class="card-text small text-muted">
                                                        <i class="fas fa-exclamation-triangle"></i> Related: @mitigation.RelatedHazard<br>
                                                        <i class="fas fa-user"></i> Responsible: @mitigation.ResponsiblePerson<br>
                                                        <i class="fas fa-calendar"></i> Due: @mitigation.DueDate.ToString("MM/dd/yyyy")
                                                    </p>
                                                    
                                                    <!-- Progress Bar -->
                                                    <div class="mb-3">
                                                        <div class="d-flex justify-content-between small mb-1">
                                                            <span>Progress</span>
                                                            <span>@mitigation.Progress%</span>
                                                        </div>
                                                        <div class="progress">
                                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @mitigation.Progress%"></div>
                                                        </div>
                                                    </div>

                                                    <!-- Action Buttons -->
                                                    <div class="btn-group w-100" role="group">
                                                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="updateMitigation('@mitigation.Id')">
                                                            <i class="fas fa-edit"></i> Update
                                                        </button>
                                                        <button type="button" class="btn btn-outline-info btn-sm">
                                                            <i class="fas fa-eye"></i> Details
                                                        </button>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm">
                                                            <i class="fas fa-comment"></i> Notes
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-tasks fa-3x"></i>
                                    <p class="mt-2">No active mitigations</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Overdue Mitigations Tab -->
                <div class="tab-pane fade" id="overdue" role="tabpanel">
                    <div class="card border-danger">
                        <div class="card-header bg-danger text-white">
                            <h5><i class="fas fa-exclamation-triangle"></i> Overdue Mitigations - Immediate Action Required</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.OverdueMitigations.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Mitigation ID</th>
                                                <th>Title</th>
                                                <th>Responsible Person</th>
                                                <th>Due Date</th>
                                                <th>Days Overdue</th>
                                                <th>Progress</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var mitigation in Model.OverdueMitigations)
                                            {
                                                <tr class="table-danger">
                                                    <td><strong>@mitigation.Id</strong></td>
                                                    <td>@mitigation.Title</td>
                                                    <td>@mitigation.ResponsiblePerson</td>
                                                    <td>@mitigation.DueDate.ToString("MM/dd/yyyy")</td>
                                                    <td>
                                                        <span class="badge bg-danger">@((DateTime.Now - mitigation.DueDate).Days) days</span>
                                                    </td>
                                                    <td>
                                                        <div class="progress" style="height: 20px;">
                                                            <div class="progress-bar bg-danger" style="width: @mitigation.Progress%">@mitigation.Progress%</div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group" role="group">
                                                            <button type="button" class="btn btn-sm btn-danger" onclick="escalateMitigation('@mitigation.Id')">
                                                                <i class="fas fa-exclamation-triangle"></i> Escalate
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="updateMitigation('@mitigation.Id')">
                                                                <i class="fas fa-edit"></i> Update
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-success py-4">
                                    <i class="fas fa-check-circle fa-3x"></i>
                                    <p class="mt-2">No overdue mitigations - Great job!</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Completed Mitigations Tab -->
                <div class="tab-pane fade" id="completed" role="tabpanel">
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <h5><i class="fas fa-check-circle"></i> Completed Mitigations</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.CompletedMitigations.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Mitigation ID</th>
                                                <th>Title</th>
                                                <th>Responsible Person</th>
                                                <th>Completed Date</th>
                                                <th>Effectiveness Rating</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var mitigation in Model.CompletedMitigations)
                                            {
                                                <tr>
                                                    <td><strong>@mitigation.Id</strong></td>
                                                    <td>@mitigation.Title</td>
                                                    <td>@mitigation.ResponsiblePerson</td>
                                                    <td>@(mitigation.CompletedDate?.ToString("MM/dd/yyyy") ?? "Recently")</td>
                                                    <td>
                                                        @switch (mitigation.EffectivenessRating)
                                                        {
                                                            case "Highly Effective":
                                                                <span class="badge bg-success">@mitigation.EffectivenessRating</span>
                                                                break;
                                                            case "Effective":
                                                                <span class="badge bg-primary">@mitigation.EffectivenessRating</span>
                                                                break;
                                                            case "Partially Effective":
                                                                <span class="badge bg-warning">@mitigation.EffectivenessRating</span>
                                                                break;
                                                            case "Ineffective":
                                                                <span class="badge bg-danger">@mitigation.EffectivenessRating</span>
                                                                break;
                                                            default:
                                                                <span class="badge bg-secondary">Under Review</span>
                                                                break;
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="btn-group" role="group">
                                                            <button type="button" class="btn btn-sm btn-outline-primary">
                                                                <i class="fas fa-eye"></i> View Report
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-info">
                                                                <i class="fas fa-chart-bar"></i> Metrics
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-clipboard-check fa-3x"></i>
                                    <p class="mt-2">No completed mitigations this period</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Effectiveness Analysis Tab -->
                <div class="tab-pane fade" id="effectiveness" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-chart-bar"></i> Mitigation Effectiveness Analysis</h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <div class="card border-info">
                                        <div class="card-header bg-info text-white">
                                            <h6>Effectiveness Distribution</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-2">
                                                <div class="d-flex justify-content-between">
                                                    <span>Highly Effective</span>
                                                    <span>60%</span>
                                                </div>
                                                <div class="progress">
                                                    <div class="progress-bar bg-success" style="width: 60%"></div>
                                                </div>
                                            </div>
                                            <div class="mb-2">
                                                <div class="d-flex justify-content-between">
                                                    <span>Effective</span>
                                                    <span>30%</span>
                                                </div>
                                                <div class="progress">
                                                    <div class="progress-bar bg-primary" style="width: 30%"></div>
                                                </div>
                                            </div>
                                            <div class="mb-2">
                                                <div class="d-flex justify-content-between">
                                                    <span>Partially Effective</span>
                                                    <span>8%</span>
                                                </div>
                                                <div class="progress">
                                                    <div class="progress-bar bg-warning" style="width: 8%"></div>
                                                </div>
                                            </div>
                                            <div class="mb-2">
                                                <div class="d-flex justify-content-between">
                                                    <span>Ineffective</span>
                                                    <span>2%</span>
                                                </div>
                                                <div class="progress">
                                                    <div class="progress-bar bg-danger" style="width: 2%"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card border-warning">
                                        <div class="card-header bg-warning text-dark">
                                            <h6>Implementation Metrics</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row text-center">
                                                <div class="col-6">
                                                    <h4 class="text-success">95%</h4>
                                                    <small>On-Time Completion</small>
                                                </div>
                                                <div class="col-6">
                                                    <h4 class="text-primary">12</h4>
                                                    <small>Avg. Days to Complete</small>
                                                </div>
                                            </div>
                                            <hr>
                                            <div class="row text-center">
                                                <div class="col-6">
                                                    <h4 class="text-info">$45K</h4>
                                                    <small>Avg. Implementation Cost</small>
                                                </div>
                                                <div class="col-6">
                                                    <h4 class="text-warning">85%</h4>
                                                    <small>Risk Reduction</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Update Mitigation Modal -->
<div class="modal fade" id="updateMitigationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Update Mitigation Progress</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Update">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" asp-for="UpdateMitigation.Status">
                            <option value="Not Started">Not Started</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Completed">Completed</option>
                            <option value="On Hold">On Hold</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Progress (%)</label>
                        <input type="range" class="form-range" asp-for="UpdateMitigation.Progress" min="0" max="100" oninput="updateProgressDisplay(this.value)">
                        <div class="text-center">
                            <span id="progressDisplay">50%</span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Effectiveness Rating</label>
                        <select class="form-select" asp-for="UpdateMitigation.EffectivenessRating">
                            <option value="">TBD - Not Yet Assessed</option>
                            <option value="Highly Effective">Highly Effective</option>
                            <option value="Effective">Effective</option>
                            <option value="Partially Effective">Partially Effective</option>
                            <option value="Ineffective">Ineffective</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Progress Notes</label>
                        <textarea class="form-control" asp-for="UpdateMitigation.Notes" rows="4" placeholder="Enter progress notes, challenges, or observations..."></textarea>
                    </div>
                    <input type="hidden" asp-for="UpdateMitigation.MitigationId" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Mitigation</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateMitigation(id) {
            document.getElementById('UpdateMitigation_MitigationId').value = id;
            new bootstrap.Modal(document.getElementById('updateMitigationModal')).show();
        }

        function escalateMitigation(id) {
            if (confirm('Escalate this overdue mitigation to management?')) {
                // TODO: Implement escalation logic
                alert('Mitigation ' + id + ' has been escalated to management.');
            }
        }

        function updateProgressDisplay(value) {
            document.getElementById('progressDisplay').textContent = value + '%';
        }

        // Initialize progress display
        document.addEventListener('DOMContentLoaded', function() {
            const progressRange = document.querySelector('input[name="UpdateMitigation.Progress"]');
            if (progressRange) {
                updateProgressDisplay(progressRange.value);
            }
        });
    </script>
}
