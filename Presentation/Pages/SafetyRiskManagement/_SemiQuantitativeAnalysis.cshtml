@model PDXSMS_Presentation.Pages.SafetyRiskManagement.RiskAssessmentWizardModel

<!-- Semi-Quantitative Assessment Analysis -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="fas fa-chart-line"></i> Semi-Quantitative Assessment Guidelines</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <h6><i class="fas fa-calculator"></i> Probability Scale</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Level</th>
                                        <th>Range</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>1</td>
                                        <td>? 10??</td>
                                        <td class="small">Extremely Unlikely</td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>10?? to 10??</td>
                                        <td class="small">Very Unlikely</td>
                                    </tr>
                                    <tr>
                                        <td>3</td>
                                        <td>10?? to 10?³</td>
                                        <td class="small">Unlikely</td>
                                    </tr>
                                    <tr>
                                        <td>4</td>
                                        <td>10?³ to 10?²</td>
                                        <td class="small">Possible</td>
                                    </tr>
                                    <tr>
                                        <td>5</td>
                                        <td>> 10?²</td>
                                        <td class="small">Likely</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <h6><i class="fas fa-exclamation-triangle"></i> Consequence Scale</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Level</th>
                                        <th>Impact</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>1</td>
                                        <td>Negligible</td>
                                        <td class="small">No significant impact</td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>Minor</td>
                                        <td class="small">Limited local impact</td>
                                    </tr>
                                    <tr>
                                        <td>3</td>
                                        <td>Moderate</td>
                                        <td class="small">Regional impact</td>
                                    </tr>
                                    <tr>
                                        <td>4</td>
                                        <td>Major</td>
                                        <td class="small">Significant widespread impact</td>
                                    </tr>
                                    <tr>
                                        <td>5</td>
                                        <td>Catastrophic</td>
                                        <td class="small">Severe long-term impact</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <h6><i class="fas fa-equals"></i> Risk Calculation</h6>
                        <div class="alert alert-info small">
                            <strong>Risk Score = Probability × Consequence</strong>
                            <hr>
                            <ul class="mb-0">
                                <li><strong>1-4:</strong> Very Low Risk</li>
                                <li><strong>5-9:</strong> Low Risk</li>
                                <li><strong>10-14:</strong> Medium Risk</li>
                                <li><strong>15-19:</strong> High Risk</li>
                                <li><strong>20-25:</strong> Very High Risk</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Semi-Quantitative Analysis Form -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h6 class="mb-0"><i class="fas fa-chart-bar"></i> Semi-Quantitative Risk Analysis</h6>
            </div>
            <div class="card-body">
                @if (Model.AssessmentData.IdentifiedHazards?.Any() == true)
                {
                    <form method="post">
                        <!-- Hidden fields to maintain state -->
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="StepNumber" />
                        <input type="hidden" asp-for="AssessmentData.RiskAnalysisMethod" />
                        <input type="hidden" asp-for="AssessmentData.RiskCriteria" />

                        @for (int i = 0; i < Model.AssessmentData.IdentifiedHazards.Count; i++)
                        {
                            var hazard = Model.AssessmentData.IdentifiedHazards[i];
                            var probability = int.TryParse(hazard.Likelihood, out var p) ? p : 0;
                            var consequence = int.TryParse(hazard.Severity, out var c) ? c : 0;
                            var riskScore = probability * consequence;
                            
                            <!-- Hidden fields to preserve hazard data -->
                            <input type="hidden" name="AssessmentData.IdentifiedHazards[@i].Id" value="@hazard.Id" />
                            <input type="hidden" name="AssessmentData.IdentifiedHazards[@i].Description" value="@hazard.Description" />
                            <input type="hidden" name="AssessmentData.IdentifiedHazards[@i].Category" value="@hazard.Category" />
                            <input type="hidden" name="AssessmentData.IdentifiedHazards[@i].WorstCredibleOutcome" value="@hazard.WorstCredibleOutcome" />
                            
                            <div class="card border-secondary mb-3">
                                <div class="card-header">
                                    <div class="row align-items-center">
                                        <div class="col">
                                            <strong>@hazard.Id: @hazard.Description</strong>
                                            @if (!string.IsNullOrEmpty(hazard.Category))
                                            {
                                                <span class="badge bg-info ms-2">@hazard.Category</span>
                                            }
                                        </div>
                                        <div class="col-auto">
                                            @if (riskScore > 0)
                                            {
                                                var riskClass = GetSemiQuantRiskClass(riskScore);
                                                var riskText = GetSemiQuantRiskText(riskScore);
                                                <span class="badge bg-@riskClass">Score: @riskScore - @riskText</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Not Calculated</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Probability Level <span class="text-danger">*</span></label>
                                                <select class="form-select" name="AssessmentData.IdentifiedHazards[@i].Likelihood" 
                                                        onchange="updateSemiQuantRisk(@i)">
                                                    <option value="">Select...</option>
                                                    <option value="1" selected="@(probability == 1)">1 - Extremely Unlikely</option>
                                                    <option value="2" selected="@(probability == 2)">2 - Very Unlikely</option>
                                                    <option value="3" selected="@(probability == 3)">3 - Unlikely</option>
                                                    <option value="4" selected="@(probability == 4)">4 - Possible</option>
                                                    <option value="5" selected="@(probability == 5)">5 - Likely</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Consequence Level <span class="text-danger">*</span></label>
                                                <select class="form-select" name="AssessmentData.IdentifiedHazards[@i].Severity"
                                                        onchange="updateSemiQuantRisk(@i)">
                                                    <option value="">Select...</option>
                                                    <option value="1" selected="@(consequence == 1)">1 - Negligible</option>
                                                    <option value="2" selected="@(consequence == 2)">2 - Minor</option>
                                                    <option value="3" selected="@(consequence == 3)">3 - Moderate</option>
                                                    <option value="4" selected="@(consequence == 4)">4 - Major</option>
                                                    <option value="5" selected="@(consequence == 5)">5 - Catastrophic</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Risk Score</label>
                                                <input type="text" class="form-control" name="AssessmentData.IdentifiedHazards[@i].RiskLevel" 
                                                       value="@riskScore" readonly id="riskScore@(i)">
                                                <div class="form-text">
                                                    <small id="riskText@(i)" class="text-@GetSemiQuantRiskClass(riskScore)">@GetSemiQuantRiskText(riskScore)</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Risk Category</label>
                                                <input type="text" class="form-control" 
                                                       value="@GetSemiQuantRiskText(riskScore)" readonly>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="mb-3">
                                                <label class="form-label">Quantitative Justification</label>
                                                <textarea class="form-control" rows="2"
                                                          placeholder="Provide justification for the probability and consequence levels assigned..."></textarea>
                                                <div class="form-text">
                                                    <small>Document data sources, calculations, or reasoning used</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    @if (!string.IsNullOrEmpty(hazard.WorstCredibleOutcome))
                                    {
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="alert alert-warning small">
                                                    <strong>Worst Credible Outcome:</strong> @hazard.WorstCredibleOutcome
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Calculate Scores Button - FIXED -->
                        <div class="row mb-3">
                            <div class="col-12 text-center">
                                <button type="button" class="btn btn-warning" onclick="calculateAllRiskScoresAnalysis()">
                                    <i class="fas fa-calculator"></i> Calculate All Risk Scores
                                </button>
                                <div class="form-text">
                                    Recalculate risk scores based on probability and consequence levels
                                </div>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                        <p>No hazards identified yet.</p>
                        <p class="small">Please complete Step 2 (Identify Hazards) before proceeding with semi-quantitative analysis.</p>
                        <a href="/SafetyRiskManagement/RiskAssessmentWizard/@Model.Id/step/2" class="btn btn-warning">
                            <i class="fas fa-arrow-left"></i> Go to Step 2
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetSemiQuantRiskClass(int riskScore)
    {
        return riskScore switch
        {
            >= 1 and <= 4 => "success",     // Very Low
            >= 5 and <= 9 => "info",       // Low  
            >= 10 and <= 14 => "warning",  // Medium
            >= 15 and <= 19 => "danger",   // High
            >= 20 and <= 25 => "dark",     // Very High
            _ => "secondary"
        };
    }
    
    private string GetSemiQuantRiskText(int riskScore)
    {
        return riskScore switch
        {
            >= 1 and <= 4 => "Very Low Risk",
            >= 5 and <= 9 => "Low Risk",
            >= 10 and <= 14 => "Medium Risk",
            >= 15 and <= 19 => "High Risk", 
            >= 20 and <= 25 => "Very High Risk",
            _ => ""
        };
    }
}

<script>
function updateSemiQuantRisk(index) {
    const probSelect = document.querySelector(`select[name="AssessmentData.IdentifiedHazards[${index}].Likelihood"]`);
    const consSelect = document.querySelector(`select[name="AssessmentData.IdentifiedHazards[${index}].Severity"]`);
    const scoreInput = document.getElementById(`riskScore${index}`);
    const textElement = document.getElementById(`riskText${index}`);
    
    const prob = parseInt(probSelect.value) || 0;
    const cons = parseInt(consSelect.value) || 0;
    const score = prob * cons;
    
    scoreInput.value = score;
    
    // Update risk text and class
    let riskText = '';
    let riskClass = 'secondary';
    
    if (score >= 1 && score <= 4) {
        riskText = 'Very Low Risk';
        riskClass = 'success';
    } else if (score >= 5 && score <= 9) {
        riskText = 'Low Risk'; 
        riskClass = 'info';
    } else if (score >= 10 && score <= 14) {
        riskText = 'Medium Risk';
        riskClass = 'warning';
    } else if (score >= 15 && score <= 19) {
        riskText = 'High Risk';
        riskClass = 'danger';
    } else if (score >= 20 && score <= 25) {
        riskText = 'Very High Risk';
        riskClass = 'dark';
    }
    
    textElement.textContent = riskText;
    textElement.className = `text-${riskClass}`;
}

function calculateAllRiskScoresAnalysis() {
    console.log('Calculating all semi-quantitative risk scores (Analysis version)');
    
    // Show brief success indicator
    const button = event.target;
    const originalContent = button.innerHTML;
    button.innerHTML = '<i class="fas fa-check"></i> Calculated!';
    button.classList.remove('btn-warning');
    button.classList.add('btn-success');
    
    setTimeout(() => {
        button.innerHTML = originalContent;
        button.classList.remove('btn-success');
        button.classList.add('btn-warning');
    }, 1500);
}
</script>

