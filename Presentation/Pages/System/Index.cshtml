                    </div>
                </div>
                <div class="card-footer">
                    <a href="/System/SystemMonitoring" class="btn btn-success w-100">
                        <i class="fas fa-chart-area"></i> View System Metrics
                    </a>
                </div>
            </div>
        </div>

        <!-- Data Management -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100 border-secondary">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-database"></i> Data Management</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Manage data backup, archival, and maintenance operations.</p>
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Database Size</h6>
                            <p class="mb-0"><strong>@Model.Dashboard.DatabaseSize</strong></p>
                            <small class="text-muted">@Model.Dashboard.StorageUsedPercent% storage used</small>
                        </div>
