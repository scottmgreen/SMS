                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="/System/DataManagement" class="btn btn-secondary w-100">
                        <i class="fas fa-archive"></i> Data Operations
                    </a>
                </div>
            </div>
        </div>
    </div> *@

    <!-- Recent Administrative Activity -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-clock"></i> Recent Administrative Activity</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>User Management</h6>
                            <ul class="list-unstyled small">
                                <li><i class="fas fa-user-plus text-success"></i> New user account created: Jennifer Wu</li>
                                <li><i class="fas fa-user-edit text-info"></i> User role updated: Mike Chen ? Senior Analyst</li>
                                <li><i class="fas fa-key text-warning"></i> Password reset: Robert Kim</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6>System Configuration</h6>
                            <ul class="list-unstyled small">
                                <li><i class="fas fa-cogs text-info"></i> Email notification settings updated</li>
                                <li><i class="fas fa-shield-alt text-success"></i> Security policies reviewed and approved</li>
                                <li><i class="fas fa-database text-primary"></i> Database maintenance scheduled</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>