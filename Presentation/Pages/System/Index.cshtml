@page
@model PDXSMS_Presentation.Pages.System.IndexModel
@{
    ViewData["Title"] = "System Administration";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item active">System Administration</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-12">
                            <h1 class="card-title"><i class="fas fa-server"></i> System Administration</h1>
                            <p class="card-text">Manage system configuration, user accounts, permissions, and administrative functions</p>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="row text-center">
                                <div class="col-6">
                                    <h3 class="mb-0">@Model.Dashboard.SystemHealth%</h3>
                                    <small>System Health</small>
                                </div>
                                <div class="col-6">
                                    <h3 class="mb-0">@Model.Dashboard.ActiveUsers</h3>
                                    <small>Active Users</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- System Status Overview -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body text-center">
                    <h3 class="text-success">@Model.Dashboard.SystemHealth%</h3>
                    <p class="mb-0">System Health</p>
                    <small class="text-muted">All systems operational</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body text-center">
                    <h3 class="text-info">@Model.Dashboard.SystemUptime.Days</h3>
                    <p class="mb-0">Days Uptime</p>
                    <small class="text-muted">Continuous operation</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body text-center">
                    <h3 class="text-warning">@Model.Dashboard.StorageUsedPercent%</h3>
                    <p class="mb-0">Storage Used</p>
                    <small class="text-muted">@Model.Dashboard.DatabaseSize total</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body text-center">
                    <h3 class="text-primary">@Model.Dashboard.SecurityAlerts</h3>
                    <p class="mb-0">Security Alerts</p>
                    <small class="text-muted">No active threats</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Administrative Functions -->
    <div class="row mb-4">
        <!-- User Management -->
        <div class="col-lg-4 mb-4">
            <div class="card h-100 border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-users"></i> User Management</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Manage user accounts, profiles, and access credentials for the SMS system.</p>
                    <ul class="list-unstyled small">
                        <li><i class="fas fa-user-plus text-success"></i> Create and manage user accounts</li>
                        <li><i class="fas fa-user-edit text-success"></i> Update user profiles and information</li>
                        <li><i class="fas fa-key text-success"></i> Reset passwords and credentials</li>
                        <li><i class="fas fa-user-times text-success"></i> Deactivate or suspend accounts</li>
                    </ul>
                    <div class="mb-3">
                        <small class="text-muted">Current Users:</small>
                        <div class="d-flex justify-content-between">
                            <span class="badge bg-success">@Model.Dashboard.ActiveUsers Active</span>
                            <span class="badge bg-secondary">@(Model.Dashboard.TotalUsers - Model.Dashboard.ActiveUsers) Inactive</span>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="/System/UserManagement" class="btn btn-primary w-100">
                        <i class="fas fa-users-cog"></i> Manage Users
                    </a>
                </div>
            </div>
        </div>

        <!-- Roles & Permissions -->
        <div class="col-lg-4 mb-4">
            <div class="card h-100 border-warning">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="fas fa-user-shield"></i> Roles & Permissions</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Configure user roles, permissions, and access control for system security.</p>
                    <ul class="list-unstyled small">
                        <li><i class="fas fa-shield-alt text-warning"></i> Define user roles and hierarchies</li>
                        <li><i class="fas fa-lock text-warning"></i> Set permissions and access levels</li>
                        <li><i class="fas fa-users text-warning"></i> Assign roles to users</li>
                        <li><i class="fas fa-history text-warning"></i> Audit role changes and access</li>
                    </ul>
                    <div class="mb-3">
                        <small class="text-muted">System Roles:</small>
                        <div class="d-flex justify-content-between">
                            <span class="badge bg-warning">@Model.Dashboard.TotalRoles Defined</span>
                            <span class="badge bg-info">3 Active</span>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="/System/RolesAndPermissions" class="btn btn-warning w-100">
                        <i class="fas fa-user-shield"></i> Manage Roles
                    </a>
                </div>
            </div>
        </div>

        <!-- System Configuration -->
        <div class="col-lg-4 mb-4">
            <div class="card h-100 border-info">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-cogs"></i> System Configuration</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Configure system settings, parameters, and operational preferences.</p>
                    <ul class="list-unstyled small">
                        <li><i class="fas fa-sliders-h text-info"></i> System-wide settings and preferences</li>
                        <li><i class="fas fa-bell text-info"></i> Notification and alert configuration</li>
                        <li><i class="fas fa-database text-info"></i> Data retention and archival settings</li>
                        <li><i class="fas fa-shield-alt text-info"></i> Security and compliance parameters</li>
                    </ul>
                    <div class="mb-3">
                        <small class="text-muted">Last Updated:</small>
                        <div class="d-flex justify-content-between">
                            <span class="badge bg-info">@DateTime.Now.AddDays(-3).ToString("MM/dd")</span>
                            <span class="badge bg-success">All Current</span>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="/System/SystemConfiguration" class="btn btn-info w-100">
                        <i class="fas fa-tools"></i> System Settings
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Administrative Functions -->
    @* <div class="row mb-4">
        <!-- System Monitoring -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100 border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-heartbeat"></i> System Monitoring</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Monitor system performance, health, and operational metrics.</p>
                    <div class="row">
                        <div class="col-md-6">
                            <h6>System Health</h6>
                            <div class="progress mb-2">
                                <div class="progress-bar bg-success" style="width: @Model.Dashboard.SystemHealth%">@Model.Dashboard.SystemHealth%</div>
                            </div>
                            <small class="text-muted">All services running normally</small>
                        </div>
                        <div class="col-md-6">
                            <h6>Last Backup</h6>
                            <p class="mb-0"><strong>@Model.Dashboard.LastBackup.ToString("MM/dd/yyyy HH:mm")</strong></p>
