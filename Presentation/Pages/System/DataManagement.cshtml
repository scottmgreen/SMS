@page
@model PDXSMS_Presentation.Pages.System.DataManagementModel
@{
    ViewData["Title"] = "Data Management - System Administration";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/System">System Administration</a></li>
                    <li class="breadcrumb-item active">Data Management</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="card-title"><i class="fas fa-database"></i> Data Management</h1>
                            <p class="card-text">Manage data backup, archival, and maintenance operations</p>
                        </div>
                        <div class="text-end">
                            <h3 class="mb-0">@Model.Overview.DatabaseSize</h3>
                            <small>Database Size</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Overview -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body text-center">
                    <h3 class="text-primary">@Model.Overview.TotalRecords.ToString("N0")</h3>
                    <p class="mb-0">Total Records</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body text-center">
                    <h3 class="text-success">@Model.Overview.ActiveRecords.ToString("N0")</h3>
                    <p class="mb-0">Active Records</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body text-center">
                    <h3 class="text-info">@Model.Overview.ArchivedRecords.ToString("N0")</h3>
                    <p class="mb-0">Archived Records</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body text-center">
                    <h3 class="text-warning">@Model.Overview.StorageUsed%</h3>
                    <p class="mb-0">Storage Used</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Management Functions -->
    <div class="row mb-4">
        <!-- Backup Management -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-success text-white">
                    <h5><i class="fas fa-shield-alt"></i> Backup Management</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-6">
                            <small class="text-muted">Last Backup:</small><br>
                            <strong>@Model.Overview.LastBackup.ToString("MM/dd/yyyy HH:mm")</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Next Backup:</small><br>
                            <strong>@Model.Overview.NextBackup.ToString("MM/dd/yyyy HH:mm")</strong>
                        </div>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted">Retention Policy:</small><br>
                        <strong>@Model.Overview.BackupRetentionDays days</strong>
                    </div>
                    <div class="btn-group w-100">
                        <button type="button" class="btn btn-outline-success">
                            <i class="fas fa-play"></i> Run Backup Now
                        </button>
                        <button type="button" class="btn btn-outline-info">
                            <i class="fas fa-history"></i> Backup History
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Archive Management -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-info text-white">
                    <h5><i class="fas fa-archive"></i> Archive Management</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-6">
                            <small class="text-muted">Archived Records:</small><br>
                            <strong>@Model.Overview.ArchivedRecords.ToString("N0")</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Retention Period:</small><br>
                            <strong>@Model.Overview.ArchiveRetentionYears years</strong>
                        </div>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted">Next Archive Run:</small><br>
                        <strong>@DateTime.Now.AddDays(30).ToString("MM/dd/yyyy")</strong>
                    </div>
                    <div class="btn-group w-100">
                        <button type="button" class="btn btn-outline-info">
                            <i class="fas fa-compress"></i> Archive Old Data
                        </button>
                        <button type="button" class="btn btn-outline-secondary">
                            <i class="fas fa-search"></i> Search Archives
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Operations -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-tools"></i> Data Operations</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i> <strong>Caution</strong>
                        <p class="mb-0">Data operations can affect system performance. Schedule maintenance operations during off-peak hours.</p>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="card border-primary">
                                <div class="card-body text-center">
                                    <i class="fas fa-broom fa-2x text-primary mb-2"></i>
                                    <h6>Data Cleanup</h6>
                                    <p class="small text-muted">Remove obsolete and temporary data</p>
                                    <button class="btn btn-primary btn-sm">Run Cleanup</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card border-warning">
                                <div class="card-body text-center">
                                    <i class="fas fa-cogs fa-2x text-warning mb-2"></i>
                                    <h6>Database Optimization</h6>
                                    <p class="small text-muted">Optimize database performance</p>
                                    <button class="btn btn-warning btn-sm">Optimize Now</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card border-success">
                                <div class="card-body text-center">
                                    <i class="fas fa-check-double fa-2x text-success mb-2"></i>
                                    <h6>Data Integrity Check</h6>
                                    <p class="small text-muted">Verify data consistency</p>
                                    <button class="btn btn-success btn-sm">Check Integrity</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h6>Export Options</h6>
                            <div class="list-group">
                                <button class="list-group-item list-group-item-action">
                                    <i class="fas fa-file-csv"></i> Export Data to CSV
                                </button>
                                <button class="list-group-item list-group-item-action">
                                    <i class="fas fa-file-excel"></i> Export Data to Excel
                                </button>
                                <button class="list-group-item list-group-item-action">
                                    <i class="fas fa-database"></i> Export Database Schema
                                </button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6>Import Options</h6>
                            <div class="list-group">
                                <button class="list-group-item list-group-item-action">
                                    <i class="fas fa-upload"></i> Import Data from File
                                </button>
                                <button class="list-group-item list-group-item-action">
                                    <i class="fas fa-sync"></i> Synchronize External Data
                                </button>
                                <button class="list-group-item list-group-item-action">
                                    <i class="fas fa-history"></i> Restore from Backup
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>