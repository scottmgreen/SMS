@page
@model PDXSMS_Presentation.Pages.System.RolesAndPermissionsModel
@{
    ViewData["Title"] = "Roles & Permissions - System Administration";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/System">System Administration</a></li>
                    <li class="breadcrumb-item active">Roles & Permissions</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="card-title"><i class="fas fa-user-shield"></i> Roles & Permissions</h1>
                            <p class="card-text">Configure user roles, permissions, and access control for system security
                            </p>
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                                <i class="fas fa-plus"></i> Create New Role
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Role Statistics -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body text-center">
                    <h3 class="text-primary">@Model.Stats.TotalRoles</h3>
                    <p class="mb-0">Total Roles</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body text-center">
                    <h3 class="text-success">@Model.Stats.ActiveRoles</h3>
                    <p class="mb-0">Active Roles</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body text-center">
                    <h3 class="text-info">@Model.Stats.TotalPermissions</h3>
                    <p class="mb-0">Available Permissions</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body text-center">
                    <h3 class="text-warning">@Model.Stats.UsersWithRoles</h3>
                    <p class="mb-0">Users with Roles</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Role Management Tabs -->
    <div class="row">
        <div class="col-12">
            <ul class="nav nav-tabs" id="roleTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="roles-tab" data-bs-toggle="tab" data-bs-target="#roles" type="button"
                        role="tab">
                        <i class="fas fa-user-shield"></i> System Roles
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="permissions-tab" data-bs-toggle="tab" data-bs-target="#permissions" type="button"
                        role="tab">
                        <i class="fas fa-lock"></i> Permissions
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="assignments-tab" data-bs-toggle="tab" data-bs-target="#assignments" type="button"
                        role="tab">
                        <i class="fas fa-users"></i> User Assignments
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="roleTabContent">
                <!-- System Roles Tab -->
                <div class="tab-pane fade show active" id="roles" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5><i class="fas fa-user-shield"></i> System Roles</h5>
                                <div>
                                    <button type="button" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-download"></i> Export Roles
                                    </button>
                                    <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                                        <i class="fas fa-plus"></i> Create Role
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                @foreach (var role in Model.Roles)
                                {
                                    <div class="col-md-6 mb-4">
                                        <div class="card border-@(role.IsActive ? "success" : "secondary")">
                                            <div class="card-header bg-@(role.IsActive ? "success" : "secondary") text-white">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <h6 class="mb-0">@role.Name</h6>
                                                        <small>@role.UserCount user(s) assigned</small>
                                                    </div>
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="button" class="btn btn-light btn-sm" 
                                                                onclick="openEditRoleModal('@role.Id', '@role.Name', '@role.Description')" 
                                                                title="Edit Role">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-info btn-sm" 
                                                                onclick="openManagePermissionsModal('@role.Id', '@role.Name')" 
                                                                title="Manage Permissions">
                                                            <i class="fas fa-key"></i>
                                                        </button>
                                                        <form method="post" style="display: inline;" asp-page-handler="DeleteRole" 
                                                              onsubmit="return confirm('Are you sure you want to delete this role?');">
                                                            <input type="hidden" name="roleId" value="@role.Id" />
                                                            <button type="submit" class="btn btn-danger btn-sm" title="Delete Role">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                <p class="card-text small mb-3">@role.Description</p>
                                                <div class="mb-3">
                                                    <strong>Permissions (@role.PermissionIds.Length):</strong>
                                                    <div class="mt-2">
                                                        @foreach (var permissionId in role.PermissionIds.Take(5))
                                                        {
                                                            var permission = Model.AvailablePermissions.FirstOrDefault(p => p.Id == permissionId);
                                                            if (permission != null)
                                                            {
                                                                <span class="badge bg-secondary me-1 mb-1">@permission.Name</span>
                                                            }
                                                        }
                                                        @if (role.PermissionIds.Length > 5)
                                                        {
                                                            <span class="badge bg-info">+@(role.PermissionIds.Length - 5) more</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-6">
                                                        <small class="text-muted">Created:</small><br>
                                                        <strong>@role.CreatedDate.ToString("MM/dd/yyyy")</strong>
                                                    </div>
                                                    <div class="col-6">
                                                        <small class="text-muted">Status:</small><br>
                                                        <span class="badge bg-@(role.IsActive ? "success" : "secondary")">
                                                            @(role.IsActive ? "Active" : "Inactive")
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Permissions Tab -->
                <div class="tab-pane fade" id="permissions" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-lock"></i> Available Permissions</h5>
                        </div>
                        <div class="card-body">
                            @{
                                var groupedPermissions = Model.AvailablePermissions.GroupBy(p => p.Category);
                            }
                            <div class="row">
                                @foreach (var group in groupedPermissions)
                                {
                                    <div class="col-md-6 mb-4">
                                        <div class="card border-info">
                                            <div class="card-header bg-primary text-white">
                                                <h6 class="mb-0">@group.Key</h6>
                                            </div>
                                            <div class="card-body">
                                                @foreach (var permission in group)
                                                {
                                                    <div class="mb-3 border-bottom pb-2">
                                                        <div class="d-flex justify-content-between align-items-start">
                                                            <div>
                                                                <strong>@permission.Name</strong>
                                                                <p class="mb-0 small text-muted">@permission.Description</p>
                                                            </div>
                                                            <span class="badge bg-primary">ID: @permission.Id</span>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- User Assignments Tab -->
                <div class="tab-pane fade" id="assignments" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5><i class="fas fa-users"></i> User Role Assignments</h5>
                                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#assignRoleModal">
                                    <i class="fas fa-user-plus"></i> Assign Role to User
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>User</th>
                                            <th>Assigned Role</th>
                                            <th>Assignment Date</th>
                                            <th>Permissions Count</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var assignment in Model.UserAssignments.OrderBy(a => a.UserName))
                                        {
                                            var role = Model.Roles.FirstOrDefault(r => r.Id == assignment.RoleId);
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar bg-primary text-white rounded-circle me-2" style="width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; font-size: 0.8em;">
                                                            @assignment.UserName.Split(' ').FirstOrDefault()?.Substring(0, 1)@assignment.UserName.Split(' ').LastOrDefault()?.Substring(0, 1)
                                                        </div>
                                                        <strong>@assignment.UserName</strong>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-info">@assignment.RoleName</span>
                                                </td>
                                                <td>@assignment.AssignedDate.ToString("MM/dd/yyyy")</td>
                                                <td>
                                                    <span class="badge bg-secondary">@(role?.PermissionIds.Length ?? 0) permissions</span>
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="button" class="btn btn-outline-warning" 
                                                                onclick="openChangeRoleModal('@assignment.UserId', '@assignment.UserName', '@assignment.RoleId')" 
                                                                title="Change Role">
                                                            <i class="fas fa-exchange-alt"></i>
                                                        </button>
                                                        <form method="post" style="display: inline;" asp-page-handler="RemoveUserRole" 
                                                              onsubmit="return confirm('Are you sure you want to remove this role assignment?');">
                                                            <input type="hidden" name="userId" value="@assignment.UserId" />
                                                            <button type="submit" class="btn btn-outline-danger" title="Remove Role">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Role Modal -->
<div class="modal fade" id="createRoleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateRole">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Role Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="roleName" required 
                               placeholder="e.g., Safety Coordinator">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="roleDescription" rows="3" required 
                                  placeholder="Brief description of the role's purpose and responsibilities"></textarea>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="isActive" checked>
                        <label class="form-check-label">
                            Active Role
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Role Modal -->
<div class="modal fade" id="editRoleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="EditRole">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="roleId" id="editRoleId">
                    <div class="mb-3">
                        <label class="form-label">Role Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="roleName" id="editRoleName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="roleDescription" id="editRoleDescription" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Manage Permissions Modal -->
<div class="modal fade" id="managePermissionsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="UpdateRolePermissions">
                <div class="modal-header">
                    <h5 class="modal-title">Manage Permissions</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="roleId" id="managePermissionsRoleId">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>Role:</strong> <span id="managePermissionsRoleName"></span>
                    </div>
                    
                    <h6>Select Permissions:</h6>
                    @{
                        var groupedPerms = Model.AvailablePermissions.GroupBy(p => p.Category);
                    }
                    @foreach (var group in groupedPerms)
                    {
                        <div class="mb-4">
                            <h6 class="text-primary">@group.Key</h6>
                            <div class="row">
                                @foreach (var permission in group)
                                {
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input permission-checkbox" type="checkbox" 
                                                   name="selectedPermissions" value="@permission.Id" 
                                                   id="perm_@permission.Id">
                                            <label class="form-check-label" for="perm_@permission.Id">
                                                <strong>@permission.Name</strong><br>
                                                <small class="text-muted">@permission.Description</small>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Permissions</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Assign Role Modal -->
<div class="modal fade" id="assignRoleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AssignUserRole">
                <div class="modal-header">
                    <h5 class="modal-title">Assign Role to User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">User <span class="text-danger">*</span></label>
                        <select class="form-select" name="userId" required>
                            <option value="">Select a user...</option>
                            @foreach (var assignment in Model.UserAssignments.OrderBy(a => a.UserName))
                            {
                                <option value="@assignment.UserId">@assignment.UserName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role <span class="text-danger">*</span></label>
                        <select class="form-select" name="roleId" required>
                            <option value="">Select a role...</option>
                            @foreach (var role in Model.Roles.Where(r => r.IsActive))
                            {
                                <option value="@role.Id">@role.Name - (@role.PermissionIds.Length permissions)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Assign Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Change Role Modal -->
<div class="modal fade" id="changeRoleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="ChangeUserRole">
                <div class="modal-header">
                    <h5 class="modal-title">Change User Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="userId" id="changeRoleUserId">
                    <div class="alert alert-info">
                        <i class="fas fa-user"></i>
                        <strong>User:</strong> <span id="changeRoleUserName"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">New Role <span class="text-danger">*</span></label>
                        <select class="form-select" name="newRoleId" id="changeRoleNewRole" required>
                            <option value="">Select a new role...</option>
                            @foreach (var role in Model.Roles.Where(r => r.IsActive))
                            {
                                <option value="@role.Id">@role.Name - (@role.PermissionIds.Length permissions)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Change Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditRoleModal(roleId, roleName, roleDescription) {
            document.getElementById('editRoleId').value = roleId;
            document.getElementById('editRoleName').value = roleName;
            document.getElementById('editRoleDescription').value = roleDescription;
            
            var modal = new bootstrap.Modal(document.getElementById('editRoleModal'));
            modal.show();
        }

        function openManagePermissionsModal(roleId, roleName) {
            document.getElementById('managePermissionsRoleId').value = roleId;
            document.getElementById('managePermissionsRoleName').textContent = roleName;
            
            // Clear all checkboxes
            document.querySelectorAll('.permission-checkbox').forEach(cb => cb.checked = false);
            
            // Find and check permissions for this role
            @foreach (var role in Model.Roles)
            {
                <text>
                if (roleId === '@role.Id') {
                    @foreach (var permId in role.PermissionIds)
                    {
                        <text>
                        var checkbox = document.getElementById('perm_@permId');
                        if (checkbox) checkbox.checked = true;
                        </text>
                    }
                }
                </text>
            }
            
            var modal = new bootstrap.Modal(document.getElementById('managePermissionsModal'));
            modal.show();
        }

        function openChangeRoleModal(userId, userName, currentRoleId) {
            document.getElementById('changeRoleUserId').value = userId;
            document.getElementById('changeRoleUserName').textContent = userName;
            
            // Set current role as selected
            var select = document.getElementById('changeRoleNewRole');
            select.value = currentRoleId;
            
            var modal = new bootstrap.Modal(document.getElementById('changeRoleModal'));
            modal.show();
        }
    </script>
}