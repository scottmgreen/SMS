@page
@model PDXSMS_Presentation.Pages.System.SystemConfigurationModel
@{
    ViewData["Title"] = "System Configuration - System Administration";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/System">System Administration</a></li>
                    <li class="breadcrumb-item active">System Configuration</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="card-title"><i class="fas fa-cogs"></i> System Configuration</h1>
                            <p class="card-text">Configure system settings, parameters, and operational preferences</p>
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn btn-light">
                                <i class="fas fa-save"></i> Save All Changes
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Configuration Tabs -->
    <div class="row">
        <div class="col-12">
            <ul class="nav nav-pills nav-fill mb-3" id="configTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="general-tab" data-bs-toggle="pill" data-bs-target="#general" type="button" role="tab">
                        <i class="fas fa-building"></i><br>General
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="spi-tab" data-bs-toggle="pill" data-bs-target="#spi" type="button" role="tab">
                        <i class="fas fa-chart-line"></i><br>SPI Settings
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="notifications-tab" data-bs-toggle="pill" data-bs-target="#notifications" type="button" role="tab">
                        <i class="fas fa-bell"></i><br>Notifications
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="audits-tab" data-bs-toggle="pill" data-bs-target="#audits" type="button" role="tab">
                        <i class="fas fa-clipboard-check"></i><br>Audits
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="security-tab" data-bs-toggle="pill" data-bs-target="#security" type="button" role="tab">
                        <i class="fas fa-shield-alt"></i><br>Security
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="configTabContent">
                <!-- General Settings -->
                <div class="tab-pane fade show active" id="general" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-building"></i> General System Settings</h5>
                        </div>
                        <div class="card-body">
                            <form>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Organization Name</label>
                                            <input type="text" class="form-control" value="@Model.Settings.GeneralSettings.OrganizationName">
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Time Zone</label>
                                            <select class="form-select">
                                                <option>Pacific Standard Time</option>
                                                <option>Mountain Standard Time</option>
                                                <option>Central Standard Time</option>
                                                <option>Eastern Standard Time</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Language</label>
                                            <select class="form-select">
                                                <option>English (US)</option>
                                                <option>Spanish</option>
                                                <option>French</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Date Format</label>
                                            <select class="form-select">
                                                <option>MM/dd/yyyy</option>
                                                <option>dd/MM/yyyy</option>
                                                <option>yyyy-MM-dd</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Currency Format</label>
                                            <select class="form-select">
                                                <option>USD</option>
                                                <option>CAD</option>
                                                <option>EUR</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">System Logo</label>
                                            <input type="file" class="form-control" accept="image/*">
                                            <small class="form-text text-muted">Upload organization logo (PNG, JPG)</small>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- SPI Settings -->
                <div class="tab-pane fade" id="spi" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-chart-line"></i> Safety Performance Indicator Settings</h5>
                        </div>
                        <div class="card-body">
                            <form>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Default Reporting Period</label>
                                            <select class="form-select">
                                                <option>Monthly</option>
                                                <option>Quarterly</option>
                                                <option>Annually</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Escalation Delay (Hours)</label>
                                            <input type="number" class="form-control" value="@Model.Settings.SPISettings.EscalationDelayHours">
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Data Retention (Months)</label>
                                            <input type="number" class="form-control" value="@Model.Settings.SPISettings.DataRetentionMonths">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="autoCalc" @(Model.Settings.SPISettings.AutoCalculationEnabled ? "checked" : "")>
                                                <label class="form-check-label" for="autoCalc">Enable Auto-Calculation</label>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="thresholdAlert" @(Model.Settings.SPISettings.ThresholdAlertEnabled ? "checked" : "")>
                                                <label class="form-check-label" for="thresholdAlert">Enable Threshold Alerts</label>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <button type="button" class="btn btn-outline-primary">
                                                <i class="fas fa-sliders-h"></i> Configure SPI Thresholds
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Notification Settings -->
                <div class="tab-pane fade" id="notifications" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-bell"></i> Notification Settings</h5>
                        </div>
                        <div class="card-body">
                            <form>
                                <div class="row">
                                    <div class="col-md-6">
                                        <h6>Notification Types</h6>
                                        <div class="mb-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="emailNotif" @(Model.Settings.NotificationSettings.EmailNotificationsEnabled ? "checked" : "")>
                                                <label class="form-check-label" for="emailNotif">Email Notifications</label>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="smsNotif" @(Model.Settings.NotificationSettings.SMSNotificationsEnabled ? "checked" : "")>
                                                <label class="form-check-label" for="smsNotif">SMS Notifications</label>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="systemAlert" @(Model.Settings.NotificationSettings.SystemAlertsEnabled ? "checked" : "")>
                                                <label class="form-check-label" for="systemAlert">System Alerts</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <h6>Settings</h6>
                                        <div class="mb-3">
                                            <label class="form-label">Digest Frequency</label>
                                            <select class="form-select">
                                                <option>Daily</option>
                                                <option>Weekly</option>
                                                <option>Monthly</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Max Recipients per Alert</label>
                                            <input type="number" class="form-control" value="@Model.Settings.NotificationSettings.MaxRecipientsPerAlert">
                                        </div>
                                        <div class="mb-3">
                                            <button type="button" class="btn btn-outline-primary">
                                                <i class="fas fa-envelope"></i> Configure Email Templates
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Audit Settings -->
                <div class="tab-pane fade" id="audits" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-clipboard-check"></i> Audit Configuration</h5>
                        </div>
                        <div class="card-body">
                            <form>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Default Audit Cycle</label>
                                            <select class="form-select">
                                                <option>Annual</option>
                                                <option>Bi-Annual</option>
                                                <option>Quarterly</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Reminder Days Before</label>
                                            <input type="number" class="form-control" value="@Model.Settings.AuditSettings.ReminderDaysBefore">
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Follow-up Days After</label>
                                            <input type="number" class="form-control" value="@Model.Settings.AuditSettings.FollowUpDaysAfter">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Required Team Size</label>
                                            <input type="number" class="form-control" value="@Model.Settings.AuditSettings.RequiredTeamSize">
                                        </div>
                                        <div class="mb-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="autoScheduling" @(Model.Settings.AuditSettings.AutoSchedulingEnabled ? "checked" : "")>
                                                <label class="form-check-label" for="autoScheduling">Enable Auto-Scheduling</label>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <button type="button" class="btn btn-outline-primary">
                                                <i class="fas fa-calendar"></i> Manage Audit Calendar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Security Settings -->
                <div class="tab-pane fade" id="security" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-shield-alt"></i> Security Configuration</h5>
                        </div>
                        <div class="card-body">
                            <form>
                                <div class="row">
                                    <div class="col-md-6">
                                        <h6>Authentication</h6>
                                        <div class="mb-3">
                                            <label class="form-label">Session Timeout (Minutes)</label>
                                            <input type="number" class="form-control" value="@Model.Settings.SecuritySettings.SessionTimeoutMinutes">
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Password Expiry (Days)</label>
                                            <input type="number" class="form-control" value="@Model.Settings.SecuritySettings.PasswordExpiryDays">
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Max Login Attempts</label>
                                            <input type="number" class="form-control" value="@Model.Settings.SecuritySettings.MaxLoginAttempts">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <h6>Security Features</h6>
                                        <div class="mb-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="twoFactor" @(Model.Settings.SecuritySettings.TwoFactorEnabled ? "checked" : "")>
                                                <label class="form-check-label" for="twoFactor">Two-Factor Authentication</label>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Audit Log Retention (Days)</label>
                                            <input type="number" class="form-control" value="@Model.Settings.SecuritySettings.AuditLogRetentionDays">
                                        </div>
                                        <div class="mb-3">
                                            <button type="button" class="btn btn-outline-warning">
                                                <i class="fas fa-key"></i> Reset All Sessions
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-footer">
                    <div class="d-flex justify-content-between">
                        <div>
                            <button type="button" class="btn btn-outline-secondary">
                                <i class="fas fa-undo"></i> Reset to Defaults
                            </button>
                            <button type="button" class="btn btn-outline-info">
                                <i class="fas fa-download"></i> Export Configuration
                            </button>
                        </div>
                        <div>
                            <button type="button" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </button>
                            <button type="button" class="btn btn-info">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>