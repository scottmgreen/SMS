@page
@model PDXSMS_Presentation.Pages.SystemStatusModel
@{
    ViewData["Title"] = "SMS System Status";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item active">System Status</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h1 class="card-title"><i class="fas fa-chart-pie"></i> SMS System Status</h1>
                    <p class="card-text">User interface implementation progress across all SMS sections</p>
                    <div class="row">
                        <div class="col-auto">
                            <h3>@((int)Model.Statistics.CompletionPercentage)% Complete</h3>
                        </div>
                        <div class="col">
                            <div class="progress" style="height: 30px;">
                                <div class="progress-bar bg-success" style="width: @Model.Statistics.CompletionPercentage%">
                                    @Model.Statistics.CompletedPages of @Model.Statistics.TotalPages pages
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Implementation Status by Section -->
    <div class="row">
        <!-- Section 1: Safety Risk Management -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card border-danger h-100">
                <div class="card-header bg-danger text-white">
                    <h5><i class="fas fa-exclamation-triangle"></i> Section 1</h5>
                    <p class="mb-0">Safety Risk Management</p>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <h2 class="text-success">@Model.Statistics.Section1Complete/@Model.Statistics.Section1Pages</h2>
                        <p class="text-muted">Pages Complete</p>
                    </div>
                    <ul class="list-unstyled small">
                        <li><i class="fas fa-check text-success"></i> FR-1.1.1: Submit Hazard Report</li>
                        <li><i class="fas fa-check text-success"></i> FR-1.1.2: Process Hazard Reports</li>
                        <li><i class="fas fa-check text-success"></i> FR-1.2.1-1.2.5: Risk Assessment</li>
                        <li><i class="fas fa-check text-success"></i> Risk Assessment Scenarios</li>
                        <li><i class="fas fa-check text-success"></i> FR-1.3.1: Mitigation Tracking</li>
                        <li><i class="fas fa-check text-success"></i> FR-1.4.1: Confidential Reporting</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Section 2: Safety Assurance -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card border-warning h-100">
                <div class="card-header bg-warning text-dark">
                    <h5><i class="fas fa-chart-line"></i> Section 2</h5>
                    <p class="mb-0">Safety Assurance</p>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <h2 class="text-success">@Model.Statistics.Section2Complete/@Model.Statistics.Section2Pages</h2>
                        <p class="text-muted">Pages Complete</p>
                    </div>
                    <ul class="list-unstyled small">
                        <li><i class="fas fa-check text-success"></i> FR-2.1.1: Performance Monitoring</li>
                        <li><i class="fas fa-check text-success"></i> FR-2.1.2: Safety Audits</li>
                        <li><i class="fas fa-check text-success"></i> FR-2.1.3: Assurance Reporting</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Section 3: Safety Policy -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card border-primary h-100">
                <div class="card-header bg-primary text-white">
                    <h5><i class="fas fa-flag"></i> Section 3</h5>
                    <p class="mb-0">Safety Policy & Objectives</p>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <h2 class="text-secondary">@Model.Statistics.Section3Complete/@Model.Statistics.Section3Pages</h2>
                        <p class="text-muted">Pages Complete</p>
                    </div>
                    <ul class="list-unstyled small">
                        <li><i class="fas fa-clock text-secondary"></i> Safety Policy Management</li>
                        <li><i class="fas fa-clock text-secondary"></i> Safety Objectives Setting</li>
                        <li><i class="fas fa-clock text-secondary"></i> Performance Targets</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Section 4: Records & Admin -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card border-secondary h-100">
                <div class="card-header bg-secondary text-white">
                    <h5><i class="fas fa-archive"></i> Section 4</h5>
                    <p class="mb-0">Records & Administration</p>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <h2 class="text-secondary">@Model.Statistics.Section4Complete/@Model.Statistics.Section4Pages</h2>
                        <p class="text-muted">Pages Complete</p>
                    </div>
                    <ul class="list-unstyled small">
                        <li><i class="fas fa-clock text-secondary"></i> FR-3.3.3: Records Retention</li>
                        <li><i class="fas fa-clock text-secondary"></i> User Management</li>
                        <li><i class="fas fa-clock text-secondary"></i> System Configuration</li>
                        <li><i class="fas fa-clock text-secondary"></i> Compliance Reporting</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Section 5: Safety Promotion -->
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card border-info h-100">
                <div class="card-header bg-info text-white">
                    <h5><i class="fas fa-bullhorn"></i> Section 5</h5>
                    <p class="mb-0">Safety Promotion</p>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <h2 class="text-warning">@Model.Statistics.Section5Complete/@Model.Statistics.Section5Pages</h2>
                        <p class="text-muted">Pages Complete</p>
                    </div>
                    <ul class="list-unstyled small">
                        <li><i class="fas fa-check text-success"></i> Safety Communications</li>
                        <li><i class="fas fa-clock text-secondary"></i> Safety Surveys</li>
                        <li><i class="fas fa-clock text-secondary"></i> Committee Management</li>
                        <li><i class="fas fa-clock text-secondary"></i> Training & Awareness</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Implementation Summary -->
        <div class="col-md-12 col-lg-8 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-list-check"></i> Implementation Highlights</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-success">? Completed Features</h6>
                            <ul class="list-unstyled small">
                                <li>• Complete hazard reporting workflow</li>
                                <li>• Five-step risk assessment with scenarios</li>
                                <li>• Mitigation tracking and effectiveness monitoring</li>
                                <li>• Confidential reporting with enhanced security</li>
                                <li>• Safety communications management</li>
                                <li>• Responsive Bootstrap 5 design</li>
                                <li>• Form validation and user feedback</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-warning">?? In Development</h6>
                            <ul class="list-unstyled small">
                                <li>• Safety performance monitoring</li>
                                <li>• Safety audits and inspections</li>
                                <li>• Safety assurance reporting</li>
                                <li>• Safety policy management</li>
                                <li>• Records retention system</li>
                                <li>• User management interface</li>
                                <li>• Committee management tools</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation -->
    <div class="row">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-header">
                    <h5><i class="fas fa-compass"></i> Quick Navigation</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-2">
                            <h6>Section 1</h6>
                            <div class="d-grid gap-1">
                                <a href="/SafetyRiskManagement/HazardReporting" class="btn btn-outline-danger btn-sm">Hazard Reports</a>
                                <a href="/SafetyRiskManagement/RiskAssessment" class="btn btn-outline-danger btn-sm">Risk Assessment</a>
                                <a href="/SafetyRiskManagement/MitigationTracking" class="btn btn-outline-danger btn-sm">Mitigations</a>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <h6>Section 2</h6>
                            <div class="d-grid gap-1">
                                <a href="/SafetyAssurance/SafetyPerformanceMonitoring" class="btn btn-outline-warning btn-sm">Performance</a>
                                <a href="/SafetyAssurance/SafetyAudits" class="btn btn-outline-warning btn-sm">Audits</a>
                                <a href="/SafetyAssurance/SafetyAssuranceReporting" class="btn btn-outline-warning btn-sm">Reports</a>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <h6>Section 3</h6>
                            <div class="d-grid gap-1">
                                <button class="btn btn-outline-secondary btn-sm" disabled>Policy</button>
                                <button class="btn btn-outline-secondary btn-sm" disabled>Objectives</button>
                                <button class="btn btn-outline-secondary btn-sm" disabled>Targets</button>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <h6>Section 4</h6>
                            <div class="d-grid gap-1">
                                <button class="btn btn-outline-secondary btn-sm" disabled>Records</button>
                                <button class="btn btn-outline-secondary btn-sm" disabled>Users</button>
                                <button class="btn btn-outline-secondary btn-sm" disabled>Config</button>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <h6>Section 5</h6>
                            <div class="d-grid gap-1">
                                <a href="/SafetyPromotion/SafetyCommunications" class="btn btn-outline-info btn-sm">Communications</a>
                                <button class="btn btn-outline-secondary btn-sm" disabled>Surveys</button>
                                <button class="btn btn-outline-secondary btn-sm" disabled>Committees</button>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <h6>Examples</h6>
                            <div class="d-grid gap-1">
                                <a href="/SafetyRiskManagement/RiskAssessmentScenarios" class="btn btn-outline-success btn-sm">Scenarios</a>
                                <a href="/" class="btn btn-outline-primary btn-sm">Dashboard</a>
                                <a href="/SafetyRiskManagement/FiveMMethodology" class="btn btn-outline-success btn-sm">
                                    <i class="fas fa-project-diagram"></i> 5M Guide
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
