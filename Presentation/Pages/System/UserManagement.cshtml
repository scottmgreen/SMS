@page
@model PDXSMS_Presentation.Pages.System.UserManagementModel
@{
    ViewData["Title"] = "User Management - System Administration";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/System">System Administration</a></li>
                    <li class="breadcrumb-item active">User Management</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="card-title"><i class="fas fa-users"></i> User Management</h1>
                            <p class="card-text">Manage user accounts, profiles, and access credentials for the SMS system</p>
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
                                <i class="fas fa-user-plus"></i> Add SMS User
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- User Statistics -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body text-center">
                    <h3 class="text-primary">@Model.Stats.TotalUsers</h3>
                    <p class="mb-0">Total Users</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body text-center">
                    <h3 class="text-success">@Model.Stats.ActiveUsers</h3>
                    <p class="mb-0">Active Users</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body text-center">
                    <h3 class="text-warning">@Model.Stats.InactiveUsers</h3>
                    <p class="mb-0">Inactive Users</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body text-center">
                    <h3 class="text-info">@Model.Stats.AdminUsers</h3>
                    <p class="mb-0">Administrators</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- User Management Tabs -->
    <div class="row">
        <div class="col-12">
            <ul class="nav nav-tabs" id="userTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button" role="tab">
                        <i class="fas fa-users"></i> User Accounts
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="roles-tab" data-bs-toggle="tab" data-bs-target="#roles" type="button" role="tab">
                        <i class="fas fa-user-shield"></i> Role Assignments
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="activity-tab" data-bs-toggle="tab" data-bs-target="#activity" type="button" role="tab">
                        <i class="fas fa-history"></i> User Activity
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="userTabContent">
                <!-- User Accounts Tab -->
                <div class="tab-pane fade show active" id="users" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5><i class="fas fa-users"></i> User Accounts</h5>
                                <div>
                                    <button type="button" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-download"></i> Export Users
                                    </button>
                                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
                                        <i class="fas fa-user-plus"></i> Add User
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Type</th>
                                            <th>Assigned Roles</th>
                                            <th>Department</th>
                                            <th>Status</th>
                                            <th>Last Login</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in Model.Users)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar bg-@(user.UserType == "SMS" ? "success" : "primary") text-white rounded-circle me-2" style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">
                                                            @user.Name.Split(' ').FirstOrDefault()?.Substring(0, 1)@user.Name.Split(' ').LastOrDefault()?.Substring(0, 1)
                                                        </div>
                                                        <strong>@user.Name</strong>
                                                    </div>
                                                </td>
                                                <td>@user.Email</td>
                                                <td>
                                                    <span class="badge bg-@(user.UserType == "SMS" ? "success" : "primary")">@user.UserType</span>
                                                </td>
                                                <td>
                                                    @if (user.AssignedRoles.Any())
                                                    {
                                                        @foreach (var role in user.AssignedRoles.Take(2))
                                                        {
                                                            <span class="badge bg-info me-1">@role</span>
                                                        }
                                                        @if (user.AssignedRoles.Length > 2)
                                                        {
                                                            <span class="badge bg-secondary">+@(user.AssignedRoles.Length - 2)</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No roles assigned</span>
                                                    }
                                                </td>
                                                <td>@user.Department</td>
                                                <td>
                                                    @if (user.IsActive)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Inactive</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (user.LastLogin != DateTime.MinValue)
                                                    {
                                                        @user.LastLogin.ToString("MM/dd/yyyy HH:mm")
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Never</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="button" class="btn btn-outline-primary" 
                                                                onclick="openEditUserModal('@user.Id', '@user.Name', '@user.Email', '@user.Department', @user.IsActive.ToString().ToLower())" 
                                                                title="Edit User">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-info" 
                                                                onclick="openManageUserRolesModal('@user.Id', '@user.Name')" 
                                                                title="Manage Roles">
                                                            <i class="fas fa-user-shield"></i>
                                                        </button>
                                                        <form method="post" style="display: inline;" asp-page-handler="DeleteUser" 
                                                              onsubmit="return confirm('Are you sure you want to delete this @user.UserType.ToLower() user?');">
                                                            <input type="hidden" name="userId" value="@user.Id" />
                                                            <button type="submit" class="btn btn-outline-danger" title="Delete User">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Role Assignments Tab -->
                <div class="tab-pane fade" id="roles" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5><i class="fas fa-user-shield"></i> User Role Assignments</h5>
                                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#bulkAssignRolesModal">
                                    <i class="fas fa-users-cog"></i> Bulk Assign Roles
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                @foreach (var role in Model.Roles)
                                {
                                    var usersWithThisRole = Model.Users.Where(u => u.AssignedRoles.Contains(role.Name)).ToList();
                                    <div class="col-md-6 mb-3">
                                        <div class="card border-info">
                                            <div class="card-header bg-primary text-white">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <h6 class="mb-0">@role.Name</h6>
                                                        <small>@usersWithThisRole.Count user(s) assigned</small>
                                                    </div>
                                                    <button type="button" class="btn btn-light btn-sm" 
                                                            onclick="openAssignRoleToUsersModal('@role.Id', '@role.Name')" 
                                                            title="Assign to Users">
                                                        <i class="fas fa-user-plus"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                <p class="card-text small mb-3">@role.Description</p>
                                                <div>
                                                    <strong>Permissions:</strong>
                                                    <div class="mt-2">
                                                        @foreach (var permission in role.Permissions.Take(3))
                                                        {
                                                            <span class="badge bg-secondary me-1 mb-1">@permission</span>
                                                        }
                                                        @if (role.Permissions.Length > 3)
                                                        {
                                                            <span class="badge bg-info">+@(role.Permissions.Length - 3) more</span>
                                                        }
                                                    </div>
                                                </div>
                                                @if (usersWithThisRole.Any())
                                                {
                                                    <div class="mt-3">
                                                        <strong>Assigned Users:</strong>
                                                        <div class="mt-2">
                                                            @foreach (var user in usersWithThisRole)
                                                            {
                                                                <span class="badge bg-success me-1 mb-1">@user.Name</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- User Activity Tab -->
                <div class="tab-pane fade" id="activity" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-history"></i> User Activity Log</h5>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> <strong>Feature Under Development</strong>
                                <p class="mb-0">User activity tracking and logging features are currently being implemented. This will include login history, action logs, and security audit trails.</p>
                            </div>
                            
                            <!-- Mock Activity Data -->
                            <div class="list-group">
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>Sarah Johnson</strong> logged in
                                            <br><small class="text-muted">From IP: 192.168.1.45</small>
                                        </div>
                                        <small>2 hours ago</small>
                                    </div>
                                </div>
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>Mike Chen</strong> generated SPI report
                                            <br><small class="text-muted">Monthly Performance Report</small>
                                        </div>
                                        <small>4 hours ago</small>
                                    </div>
                                </div>
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>Lisa Rodriguez</strong> scheduled audit
                                            <br><small class="text-muted">Terminal Operations Audit</small>
                                        </div>
                                        <small>1 day ago</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddUser">
                <div class="modal-header">
                    <h5 class="modal-title">Add New SMS User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> <strong>Note:</strong> This will create an SMS Organizational User for safety management operations.
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="fullName" required 
                               placeholder="e.g., John Doe">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email Address <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" name="email" required 
                               placeholder="e.g., john.doe@flypdx.com">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Department <span class="text-danger">*</span></label>
                        <select class="form-select" name="department" required>
                            <option value="">Select department...</option>
                            <option value="Safety Management">Safety Management</option>
                            <option value="Airport Operations">Airport Operations</option>
                            <option value="Information Technology">Information Technology</option>
                            <option value="Quality Assurance">Quality Assurance</option>
                            <option value="Regulatory">Regulatory</option>
                            <option value="Management">Management</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Initial Qualification (Optional)</label>
                        <select class="form-select" name="initialRole">
                            <option value="">No initial qualification</option>
                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role.Id">@role.Name</option>
                            }
                        </select>
                        <div class="form-text">SMS users use qualifications instead of application roles</div>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="isActive" checked>
                        <label class="form-check-label">
                            Active User Account
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Create SMS User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="EditUser">
                <div class="modal-header">
                    <h5 class="modal-title">Edit User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="userId" id="editUserId">
                    <div class="mb-3">
                        <label class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="fullName" id="editUserName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email Address <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" name="email" id="editUserEmail" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Department <span class="text-danger">*</span></label>
                        <select class="form-select" name="department" id="editUserDepartment" required>
                            <option value="Safety">Safety</option>
                            <option value="IT">Information Technology</option>
                            <option value="Quality Assurance">Quality Assurance</option>
                            <option value="Regulatory">Regulatory</option>
                            <option value="Operations">Operations</option>
                            <option value="Management">Management</option>
                        </select>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="isActive" id="editUserActive">
                        <label class="form-check-label">
                            Active User Account
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Manage User Roles Modal -->
<div class="modal fade" id="manageUserRolesModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="UpdateUserRoles">
                <div class="modal-header">
                    <h5 class="modal-title">Manage User Roles</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="userId" id="manageRolesUserId">
                    <div class="alert alert-info">
                        <i class="fas fa-user"></i>
                        <strong>User:</strong> <span id="manageRolesUserName"></span>
                    </div>
                    
                    <h6>Assign Roles:</h6>
                    <div class="row">
                        @foreach (var role in Model.Roles)
                        {
                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input user-role-checkbox" type="checkbox" 
                                           name="selectedRoles" value="@role.Id" 
                                           id="userRole_@role.Id">
                                    <label class="form-check-label" for="userRole_@role.Id">
                                        <strong>@role.Name</strong><br>
                                        <small class="text-muted">@role.Description</small><br>
                                        <small class="text-info">@role.Permissions.Length permission(s)</small>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Roles</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Assign Role to Users Modal -->
<div class="modal fade" id="assignRoleToUsersModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="AssignRoleToMultipleUsers">
                <div class="modal-header">
                    <h5 class="modal-title">Assign Role to Users</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="roleId" id="assignRoleToUsersRoleId">
                    <div class="alert alert-info">
                        <i class="fas fa-user-shield"></i>
                        <strong>Role:</strong> <span id="assignRoleToUsersRoleName"></span>
                    </div>
                    
                    <h6>Select Users:</h6>
                    <div class="row">
                        @foreach (var user in Model.Users)
                        {
                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input bulk-user-checkbox" type="checkbox" 
                                           name="selectedUsers" value="@user.Id" 
                                           id="bulkUser_@user.Id">
                                    <label class="form-check-label" for="bulkUser_@user.Id">
                                        <strong>@user.Name</strong><br>
                                        <small class="text-muted">@user.Email</small><br>
                                        <small class="text-info">@user.Department</small>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Assign Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditUserModal(userId, userName, userEmail, userDepartment, isActive) {
            document.getElementById('editUserId').value = userId;
            document.getElementById('editUserName').value = userName;
            document.getElementById('editUserEmail').value = userEmail;
            document.getElementById('editUserDepartment').value = userDepartment;
            document.getElementById('editUserActive').checked = isActive;
            
            var modal = new bootstrap.Modal(document.getElementById('editUserModal'));
            modal.show();
        }

        function openManageUserRolesModal(userId, userName) {
            document.getElementById('manageRolesUserId').value = userId;
            document.getElementById('manageRolesUserName').textContent = userName;
            
            // Clear all checkboxes
            document.querySelectorAll('.user-role-checkbox').forEach(cb => cb.checked = false);
            
            // Find and check roles for this user
            @foreach (var user in Model.Users)
            {
                <text>
                if (userId === '@user.Id') {
                    @foreach (var role in user.AssignedRoles)
                    {
                        var roleId = Model.Roles.FirstOrDefault(r => r.Name == role)?.Id;
                        if (roleId != null)
                        {
                            <text>
                            var checkbox = document.getElementById('userRole_@roleId');
                            if (checkbox) checkbox.checked = true;
                            </text>
                        }
                    }
                }
                </text>
            }
            
            var modal = new bootstrap.Modal(document.getElementById('manageUserRolesModal'));
            modal.show();
        }

        function openAssignRoleToUsersModal(roleId, roleName) {
            document.getElementById('assignRoleToUsersRoleId').value = roleId;
            document.getElementById('assignRoleToUsersRoleName').textContent = roleName;
            
            // Clear all checkboxes
            document.querySelectorAll('.bulk-user-checkbox').forEach(cb => cb.checked = false);
            
            var modal = new bootstrap.Modal(document.getElementById('assignRoleToUsersModal'));
            modal.show();
        }
    </script>
}