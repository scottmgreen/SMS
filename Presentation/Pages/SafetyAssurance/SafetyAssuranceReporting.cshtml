@page
@model PDXSMS_Presentation.Pages.SafetyAssurance.SafetyAssuranceReportingModel
@{
    ViewData["Title"] = "FR-2.1.3: Safety Assurance Reporting";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyAssurance"> Safety Assurance</a></li>
                    <li class="breadcrumb-item active">Safety Assurance Reporting</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h4 class="card-title"><i class="fas fa-chart-pie"></i> Safety Assurance Reporting</h4>
                    <p class="card-text">Generate and distribute comprehensive safety assurance reports</p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Reporting Metrics -->
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card text-center border-primary">
                <div class="card-body">
                    <h5 class="card-title text-primary">Total Reports</h5>
                    <h5 class="display-7">@Model.Metrics.TotalReports</h5>
                    <p class="card-text">This year</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center border-success">
                <div class="card-body">
                    <h5 class="card-title text-success">Published</h5>
                    <h5 class="display-7">@Model.Metrics.PublishedReports</h5>
                    <p class="card-text">Available</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center border-warning">
                <div class="card-body">
                    <h5 class="card-title text-warning">Draft</h5>
                    <h5 class="display-7">@Model.Metrics.DraftReports</h5>
                    <p class="card-text">In progress</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center border-info">
                <div class="card-body">
                    <h5 class="card-title text-info">Under Review</h5>
                    <h5 class="display-7">@Model.Metrics.UnderReviewReports</h5>
                    <p class="card-text">Pending</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center border-secondary">
                <div class="card-body">
                    <h5 class="card-title text-secondary">Avg. Time</h5>
                    <h5 class="display-7">@Model.Metrics.AvgGenerationTime</h5>
                    <p class="card-text">Days to generate</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center border-success">
                <div class="card-body">
                    <h5 class="card-title text-success">Compliance</h5>
                    <h5 class="display-7">@Model.Metrics.ComplianceRating%</h5>
                    <p class="card-text">Rating</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Bar -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">Report Management</h5>
                            <small class="text-muted">Generate, review, and distribute safety assurance reports</small>
                        </div>
                        <div>
                            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#generateReportModal">
                                <i class="fas fa-plus"></i> Generate Report
                            </button>
                            <button type="button" class="btn btn-outline-primary">
                                <i class="fas fa-calendar-alt"></i> Schedule Report
                            </button>
                            <button type="button" class="btn btn-outline-info">
                                <i class="fas fa-cog"></i> Templates
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Report Tabs -->
    <div class="row">
        <div class="col-12">
            <ul class="nav nav-tabs" id="reportTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="recent-tab" data-bs-toggle="tab" data-bs-target="#recent" type="button" role="tab">
                        <i class="fas fa-clock"></i> Recent Reports 
                        <span class="badge bg-primary ms-1">@Model.RecentReports.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="templates-tab" data-bs-toggle="tab" data-bs-target="#templates" type="button" role="tab">
                        <i class="fas fa-clipboard-list"></i> Templates
                        <span class="badge bg-info ms-1">@Model.AvailableTemplates.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="scheduled-tab" data-bs-toggle="tab" data-bs-target="#scheduled" type="button" role="tab">
                        <i class="fas fa-calendar"></i> Scheduled Reports
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="analytics-tab" data-bs-toggle="tab" data-bs-target="#analytics" type="button" role="tab">
                        <i class="fas fa-chart-bar"></i> Analytics
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="reportTabsContent">
                <!-- Recent Reports Tab -->
                <div class="tab-pane fade show active" id="recent" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-file-alt"></i> Recent Safety Assurance Reports</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.RecentReports.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Report ID</th>
                                                <th>Title</th>
                                                <th>Type</th>
                                                <th>Generated By</th>
                                                <th>Generated Date</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var report in Model.RecentReports)
                                            {
                                                <tr>
                                                    <td><strong>@report.Id</strong></td>
                                                    <td>@report.Title</td>
                                                    <td><span class="badge bg-secondary">@report.ReportType</span></td>
                                                    <td>@report.GeneratedBy</td>
                                                    <td>@report.GeneratedDate.ToString("MM/dd/yyyy")</td>
                                                    <td>
                                                        <span class="badge bg-@(report.Status == "Published" ? "success" : report.Status == "Draft" ? "warning" : "info")">
                                                            @report.Status
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group" role="group">
                                                            <button type="button" class="btn btn-sm btn-outline-primary">
                                                                <i class="fas fa-eye"></i> View
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-success">
                                                                <i class="fas fa-download"></i> Download
                                                            </button>
                                                            @if (report.Status != "Published")
                                                            {
                                                                <button type="button" class="btn btn-sm btn-outline-info">
                                                                    <i class="fas fa-edit"></i> Edit
                                                                </button>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-file-alt fa-3x"></i>
                                    <p class="mt-2">No reports generated yet</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Templates Tab -->
                <div class="tab-pane fade" id="templates" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-clipboard-list"></i> Report Templates</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                @foreach (var template in Model.AvailableTemplates)
                                {
                                    <div class="col-md-6 col-lg-4 mb-3">
                                        <div class="card border-info h-100">
                                            <div class="card-header bg-info text-white">
                                                <h6 class="mb-0">@template.Name</h6>
                                                <small>@template.Type Report</small>
                                            </div>
                                            <div class="card-body">
                                                <p class="card-text small">@template.Description</p>
                                                <div class="d-grid gap-2">
                                                    <button type="button" class="btn btn-outline-info btn-sm" onclick="useTemplate('@template.Id')">
                                                        <i class="fas fa-plus"></i> Use Template
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm">
                                                        <i class="fas fa-eye"></i> Preview
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Scheduled Reports Tab -->
                <div class="tab-pane fade" id="scheduled" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-calendar"></i> Scheduled Reports</h5>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-info" role="alert">
                                <h6><i class="fas fa-info-circle"></i> Automated Report Schedule</h6>
                                <ul class="mb-0">
                                    <li><strong>Monthly Reports:</strong> Generated on the 5th of each month</li>
                                    <li><strong>Quarterly Reports:</strong> Generated within 15 days of quarter end</li>
                                    <li><strong>Annual Reports:</strong> Generated by January 31st</li>
                                    <li><strong>Ad-hoc Reports:</strong> Generated on-demand as needed</li>
                                </ul>
                            </div>
                            
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Report Type</th>
                                            <th>Frequency</th>
                                            <th>Next Due</th>
                                            <th>Responsible</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Monthly Safety Performance</td>
                                            <td>Monthly</td>
                                            <td>March 5, 2024</td>
                                            <td>Safety Manager</td>
                                            <td><span class="badge bg-success">On Track</span></td>
                                        </tr>
                                        <tr>
                                            <td>Quarterly SMS Review</td>
                                            <td>Quarterly</td>
                                            <td>April 15, 2024</td>
                                            <td>SMS Coordinator</td>
                                            <td><span class="badge bg-warning">Due Soon</span></td>
                                        </tr>
                                        <tr>
                                            <td>Annual Safety Report</td>
                                            <td>Annual</td>
                                            <td>January 31, 2025</td>
                                            <td>Accountable Executive</td>
                                            <td><span class="badge bg-success">On Track</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Analytics Tab -->
                <div class="tab-pane fade" id="analytics" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-chart-bar"></i> Reporting Analytics</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="card border-primary">
                                        <div class="card-header bg-primary text-white">
                                            <h6>Report Generation Trends</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="text-center py-3">
                                                <i class="fas fa-chart-line fa-3x text-muted"></i>
                                                <p class="mt-2 text-muted">Trend chart would be displayed here</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card border-success">
                                        <div class="card-header bg-success text-white">
                                            <h6>Report Type Distribution</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-2">
                                                <div class="d-flex justify-content-between">
                                                    <span>Monthly</span>
                                                    <span>45%</span>
                                                </div>
                                                <div class="progress">
                                                    <div class="progress-bar bg-primary" style="width: 45%"></div>
                                                </div>
                                            </div>
                                            <div class="mb-2">
                                                <div class="d-flex justify-content-between">
                                                    <span>Quarterly</span>
                                                    <span>25%</span>
                                                </div>
                                                <div class="progress">
                                                    <div class="progress-bar bg-info" style="width: 25%"></div>
                                                </div>
                                            </div>
                                            <div class="mb-2">
                                                <div class="d-flex justify-content-between">
                                                    <span>Ad-hoc</span>
                                                    <span>20%</span>
                                                </div>
                                                <div class="progress">
                                                    <div class="progress-bar bg-warning" style="width: 20%"></div>
                                                </div>
                                            </div>
                                            <div class="mb-2">
                                                <div class="d-flex justify-content-between">
                                                    <span>Annual</span>
                                                    <span>10%</span>
                                                </div>
                                                <div class="progress">
                                                    <div class="progress-bar bg-success" style="width: 10%"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Generate Report Modal -->
<div class="modal fade" id="generateReportModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Generate Safety Assurance Report</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Generate">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Report Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="NewReport.ReportTitle" placeholder="e.g., March 2024 Safety Performance Report" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Report Type <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="NewReport.ReportType" required>
                                    <option value="">Select report type...</option>
                                    <option value="Monthly">Monthly Report</option>
                                    <option value="Quarterly">Quarterly Report</option>
                                    <option value="Semi-annual">Semi-annual Report</option>
                                    <option value="Annual">Annual Report</option>
                                    <option value="Ad-hoc">Ad-hoc Report</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Template</label>
                                <select class="form-select" asp-for="NewReport.TemplateId">
                                    <option value="">Start from scratch</option>
                                    @foreach (var template in Model.AvailableTemplates)
                                    {
                                        <option value="@template.Id">@template.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Period Start Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" asp-for="NewReport.PeriodStart" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Period End Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" asp-for="NewReport.PeriodEnd" required>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Department Scope</label>
                        <select class="form-select" asp-for="NewReport.Department">
                            <option value="">All Departments</option>
                            <option value="Airfield Operations">Airfield Operations</option>
                            <option value="Terminal Operations">Terminal Operations</option>
                            <option value="Ground Operations">Ground Operations</option>
                            <option value="Security Operations">Security Operations</option>
                            <option value="Emergency Services">Emergency Services</option>
                            <option value="Maintenance">Maintenance</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Report Options</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="NewReport.IncludeCharts">
                            <label class="form-check-label" for="NewReport_IncludeCharts">
                                Include charts and graphs
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="NewReport.IncludeRecommendations">
                            <label class="form-check-label" for="NewReport_IncludeRecommendations">
                                Include recommendations and action items
                            </label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Distribution List</label>
                        <textarea class="form-control" asp-for="NewReport.DistributionList" rows="3" placeholder="Enter email addresses separated by commas..."></textarea>
                        <div class="form-text">Report will be automatically distributed to these recipients</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Generate Report</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function useTemplate(templateId) {
            document.getElementById('NewReport_TemplateId').value = templateId;
            new bootstrap.Modal(document.getElementById('generateReportModal')).show();
        }

        // Auto-focus report title when modal opens
        document.getElementById('generateReportModal').addEventListener('shown.bs.modal', function () {
            document.querySelector('input[name="NewReport.ReportTitle"]').focus();
        });
    </script>
}

