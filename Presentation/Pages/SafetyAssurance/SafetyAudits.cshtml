@page
@model PDXSMS_Presentation.Pages.SafetyAssurance.SafetyAuditsModel
@{
    ViewData["Title"] = "Safety Audits and Inspections";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyAssurance"> Safety Assurance</a></li>
                    <li class="breadcrumb-item active"> Safety Audits</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h4 class="card-title"><i class="fas fa-clipboard-check"></i> Safety Audits and Inspections</h4>
                    <p class="card-text">Schedule, conduct, and manage comprehensive safety audits and inspections</p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Audit Dashboard -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center border-primary">
                <div class="card-body">
                    <h5 class="card-title text-primary">Upcoming</h5>
                    <h5 class="display-7">@Model.UpcomingAudits.Count</h5>
                    <p class="card-text">Scheduled audits</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-warning">
                <div class="card-body">
                    <h5 class="card-title text-warning">Active</h5>
                    <h5 class="display-7">@Model.ActiveAudits.Count</h5>
                    <p class="card-text">In progress</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-success">
                <div class="card-body">
                    <h5 class="card-title text-success">Completed</h5>
                    <h5 class="display-7">@Model.CompletedAudits.Count</h5>
                    <p class="card-text">This quarter</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-info">
                <div class="card-body">
                    <h5 class="card-title text-info">Compliance</h5>
                    <h5 class="display-7">96%</h5>
                    <p class="card-text">Overall rating</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Bar -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">Audit Management</h5>
                            <small class="text-muted">Schedule and manage safety audits and compliance inspections</small>
                        </div>
                        <div>
                            <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#createAuditModal">
                                <i class="fas fa-plus"></i> Schedule Audit
                            </button>
                            <a href="/SafetyAssurance/AuditTemplates" class="btn btn-outline-info">
                                <i class="fas fa-clipboard-list"></i> Templates
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Audit Tabs -->
    <div class="row">
        <div class="col-12">
            <ul class="nav nav-tabs" id="auditTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="upcoming-tab" data-bs-toggle="tab" data-bs-target="#upcoming" type="button" role="tab">
                        <i class="fas fa-calendar-alt"></i> Upcoming Audits 
                        <span class="badge bg-primary ms-1">@Model.UpcomingAudits.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="active-tab" data-bs-toggle="tab" data-bs-target="#active" type="button" role="tab">
                        <i class="fas fa-play-circle"></i> Active Audits 
                        <span class="badge bg-warning ms-1">@Model.ActiveAudits.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed" type="button" role="tab">
                        <i class="fas fa-check-circle"></i> Completed
                        <span class="badge bg-success ms-1">@Model.CompletedAudits.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="calendar-tab" data-bs-toggle="tab" data-bs-target="#calendar" type="button" role="tab">
                        <i class="fas fa-calendar"></i> Calendar View
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="auditTabsContent">
                <!-- Upcoming Audits Tab -->
                <div class="tab-pane fade show active" id="upcoming" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-calendar-alt"></i> Scheduled Audits</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.UpcomingAudits.Any())
                            {
                                <div class="row">
                                    @foreach (var audit in Model.UpcomingAudits)
                                    {
                                        <div class="col-lg-6 mb-4">
                                            <div class="card border-primary">
                                                <div class="card-header bg-primary bg-opacity-10 d-flex justify-content-between align-items-center">
                                                    <strong>@audit.Id</strong>
                                                    <span class="badge bg-@(audit.Priority == "Critical" ? "danger" : audit.Priority == "High" ? "warning" : "secondary")">
                                                        @audit.Priority Priority
                                                    </span>
                                                </div>
                                                <div class="card-body">
                                                    <h6 class="card-title">@audit.Title</h6>
                                                    <p class="card-text small text-muted">
                                                        <i class="fas fa-user"></i> Lead: @audit.LeadAuditor<br>
                                                        <i class="fas fa-building"></i> Department: @audit.Department<br>
                                                        <i class="fas fa-tag"></i> Type: @audit.AuditType<br>
                                                        <i class="fas fa-calendar"></i> @audit.PlannedStartDate.ToString("MM/dd/yyyy") - @audit.PlannedEndDate.ToString("MM/dd/yyyy")
                                                    </p>
                                                    
                                                    <div class="mb-3">
                                                        <small class="text-muted">Days until start:</small>
                                                        <div class="progress">
                                                            @{
                                                                var daysUntil = (audit.PlannedStartDate - DateTime.Now).Days;
                                                                var progressWidth = Math.Max(0, Math.Min(100, (7 - daysUntil) * 100 / 7));
                                                            }
                                                            <div class="progress-bar bg-primary" style="width: @progressWidth%">
                                                                @daysUntil days
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="btn-group w-100" role="group">
                                                        <button type="button" class="btn btn-outline-primary btn-sm">
                                                            <i class="fas fa-eye"></i> Details
                                                        </button>
                                                        <button type="button" class="btn btn-outline-info btn-sm">
                                                            <i class="fas fa-edit"></i> Modify
                                                        </button>
                                                        <button type="button" class="btn btn-outline-success btn-sm">
                                                            <i class="fas fa-play"></i> Start
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-calendar-alt fa-3x"></i>
                                    <p class="mt-2">No upcoming audits scheduled</p>
                                    <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#createAuditModal">
                                        Schedule Your First Audit
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Active Audits Tab -->
                <div class="tab-pane fade" id="active" role="tabpanel">
                    <div class="card">
                        <div class="card-header bg-warning text-dark">
                            <h5><i class="fas fa-play-circle"></i> Audits in Progress</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.ActiveAudits.Any())
                            {
                                @foreach (var audit in Model.ActiveAudits)
                                {
                                    <div class="card border-warning mb-3">
                                        <div class="card-header bg-warning bg-opacity-10">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <strong>@audit.Id: @audit.Title</strong>
                                                <span class="badge bg-warning">@audit.Status</span>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-8">
                                                    <p class="card-text small">
                                                        <i class="fas fa-user"></i> Lead Auditor: @audit.LeadAuditor<br>
                                                        <i class="fas fa-building"></i> Department: @audit.Department<br>
                                                        <i class="fas fa-tag"></i> Type: @audit.AuditType
                                                    </p>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="btn-group w-100" role="group">
                                                        <button type="button" class="btn btn-outline-warning btn-sm">
                                                            <i class="fas fa-clipboard-check"></i> Checklist
                                                        </button>
                                                        <button type="button" class="btn btn-outline-info btn-sm">
                                                            <i class="fas fa-file-alt"></i> Report
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-play-circle fa-3x"></i>
                                    <p class="mt-2">No audits currently in progress</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Completed Audits Tab -->
                <div class="tab-pane fade" id="completed" role="tabpanel">
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <h5><i class="fas fa-check-circle"></i> Completed Audits</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.CompletedAudits.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Audit ID</th>
                                                <th>Title</th>
                                                <th>Type</th>
                                                <th>Department</th>
                                                <th>Lead Auditor</th>
                                                <th>Completed Date</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var audit in Model.CompletedAudits)
                                            {
                                                <tr>
                                                    <td><strong>@audit.Id</strong></td>
                                                    <td>@audit.Title</td>
                                                    <td><span class="badge bg-info">@audit.AuditType</span></td>
                                                    <td>@audit.Department</td>
                                                    <td>@audit.LeadAuditor</td>
                                                    <td>@audit.CompletedDate?.ToString("MM/dd/yyyy")</td>
                                                    <td>
                                                        <div class="btn-group" role="group">
                                                            <button type="button" class="btn btn-sm btn-outline-primary">
                                                                <i class="fas fa-file-pdf"></i> Report
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-info">
                                                                <i class="fas fa-chart-bar"></i> Metrics
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-archive fa-3x"></i>
                                    <p class="mt-2">No completed audits this period</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Calendar View Tab -->
                <div class="tab-pane fade" id="calendar" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-calendar"></i> Audit Calendar</h5>
                        </div>
                        <div class="card-body">
                            <div class="text-center py-5">
                                <i class="fas fa-calendar-alt fa-3x text-muted"></i>
                                <p class="mt-3 text-muted">Interactive audit calendar would be displayed here</p>
                                <p class="text-muted">Showing scheduled audits, deadlines, and availability</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Audit Modal -->
<div class="modal fade" id="createAuditModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Schedule New Safety Audit</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Audit Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="NewAudit.AuditTitle" placeholder="e.g., Terminal Operations Safety Audit" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Audit Type <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="NewAudit.AuditType" required>
                                    <option value="">Select audit type...</option>
                                    <option value="Internal">Internal Audit</option>
                                    <option value="External">External Audit</option>
                                    <option value="Compliance">Compliance Inspection</option>
                                    <option value="Surveillance">Surveillance Audit</option>
                                    <option value="Management">Management Review</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Priority <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="NewAudit.Priority" required>
                                    <option value="Low">Low</option>
                                    <option value="Medium" selected>Medium</option>
                                    <option value="High">High</option>
                                    <option value="Critical">Critical</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description <span class="text-danger">*</span></label>
                        <textarea class="form-control" asp-for="NewAudit.Description" rows="3" placeholder="Describe the audit scope and objectives..." required></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Planned Start Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" asp-for="NewAudit.PlannedStartDate" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Planned End Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" asp-for="NewAudit.PlannedEndDate" required>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Lead Auditor <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="NewAudit.LeadAuditor" required>
                                    <option value="">Select lead auditor...</option>
                                    <option value="Sarah Johnson">Sarah Johnson - Senior Safety Auditor</option>
                                    <option value="Mike Brown">Mike Brown - Compliance Specialist</option>
                                    <option value="Lisa Wilson">Lisa Wilson - Quality Assurance Manager</option>
                                    <option value="Tom Davis">Tom Davis - SMS Coordinator</option>
                                    <option value="External Auditor">External Auditor (TBD)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Department <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="NewAudit.Department" required>
                                    <option value="">Select department...</option>
                                    <option value="Airfield Operations">Airfield Operations</option>
                                    <option value="Terminal Operations">Terminal Operations</option>
                                    <option value="Ground Operations">Ground Operations</option>
                                    <option value="Security Operations">Security Operations</option>
                                    <option value="Emergency Services">Emergency Services</option>
                                    <option value="Maintenance">Maintenance</option>
                                    <option value="All Departments">All Departments</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Audit Scope</label>
                        <textarea class="form-control" asp-for="NewAudit.AuditScope" rows="3" placeholder="Define specific areas, processes, or requirements to be audited..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info">Schedule Audit</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-focus audit title when modal opens
        document.getElementById('createAuditModal').addEventListener('shown.bs.modal', function () {
            document.querySelector('input[name="NewAudit.AuditTitle"]').focus();
        });

        // Set minimum date to today for start date
        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date().toISOString().split('T')[0];
            document.querySelector('input[name="NewAudit.PlannedStartDate"]').setAttribute('min', today);
            
            // Update end date minimum when start date changes
            document.querySelector('input[name="NewAudit.PlannedStartDate"]').addEventListener('change', function() {
                document.querySelector('input[name="NewAudit.PlannedEndDate"]').setAttribute('min', this.value);
            });
        });
    </script>
}

