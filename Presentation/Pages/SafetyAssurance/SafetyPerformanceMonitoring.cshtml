@page
@model PDXSMS_Presentation.Pages.SafetyAssurance.SafetyPerformanceMonitoringModel
@{
    ViewData["Title"] = "Safety Performance Monitoring";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyAssurance"> Safety Assurance</a></li>
                    <li class="breadcrumb-item active"> Safety Performance Monitoring</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h4 class="card-title"><i class="fas fa-chart-line"></i> Safety Performance Monitoring</h4>
                    <p class="card-text"> Establish and monitor safety performance indicators (SPIs)</p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Performance Dashboard -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center border-success">
                <div class="card-body">
                    <h5 class="card-title text-success">Total SPIs</h5>
                    <h5 class="display-7">@Model.Dashboard.TotalSPIs</h5>
                    <p class="card-text">Active indicators</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-success">
                <div class="card-body">
                    <h5 class="card-title text-success">Normal</h5>
                    <h5 class="display-7">@Model.Dashboard.NormalStatus</h5>
                    <p class="card-text">Within targets</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-warning">
                <div class="card-body">
                    <h5 class="card-title text-warning">Warning</h5>
                    <h5 class="display-7">@Model.Dashboard.WarningStatus</h5>
                    <p class="card-text">Below target</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-danger">
                <div class="card-body">
                    <h5 class="card-title text-danger">Alert</h5>
                    <h5 class="display-7">@Model.Dashboard.AlertStatus</h5>
                    <p class="card-text">Threshold exceeded</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Alerts -->
    @if (Model.ActiveAlerts.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5><i class="fas fa-exclamation-triangle"></i> Active Performance Alerts</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var alert in Model.ActiveAlerts)
                        {
                            <div class="alert alert-@(alert.Severity == "High" ? "danger" : "warning") alert-dismissible">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6>@alert.SPIId: @alert.Message</h6>
                                        <small>Created: @alert.CreatedDate.ToString("MM/dd/yyyy HH:mm")</small>
                                    </div>
                                    <span class="badge bg-@(alert.Severity == "High" ? "danger" : "warning")">@alert.Severity</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SPI Management -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5><i class="fas fa-tachometer-alt"></i> Safety Performance Indicators</h5>
                    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#createSPIModal">
                        <i class="fas fa-plus"></i> Create New SPI
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>SPI ID</th>
                                    <th>Indicator Name</th>
                                    <th>Current Value</th>
                                    <th>Target</th>
                                    <th>Threshold</th>
                                    <th>Status</th>
                                    <th>Frequency</th>
                                    <th>Last Updated</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var spi in Model.ActiveSPIs)
                                {
                                    <tr class="@(spi.Status == "Alert" ? "table-danger" : spi.Status == "Warning" ? "table-warning" : "")">
                                        <td><strong>@spi.Id</strong></td>
                                        <td>@spi.Name</td>
                                        <td>
                                            <strong>@spi.CurrentValue@(spi.DataType == "Percentage" ? "%" : "")</strong>
                                        </td>
                                        <td>@spi.TargetValue@(spi.DataType == "Percentage" ? "%" : "")</td>
                                        <td>@spi.ThresholdValue@(spi.DataType == "Percentage" ? "%" : "")</td>
                                        <td>
                                            <span class="badge bg-@(spi.Status == "Normal" ? "success" : spi.Status == "Warning" ? "warning" : "danger")">
                                                @spi.Status
                                            </span>
                                        </td>
                                        <td>@spi.Frequency</td>
                                        <td>@spi.LastUpdated.ToString("MM/dd/yyyy")</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="viewSPIDetails('@spi.Id')">
                                                    <i class="fas fa-chart-line"></i> Chart
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-info" onclick="updateSPI('@spi.Id')">
                                                    <i class="fas fa-edit"></i> Update
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Performance Trends -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-chart-area"></i> Performance Trends</h5>
                </div>
                <div class="card-body">
                    <div class="text-center py-5">
                        <i class="fas fa-chart-line fa-3x text-muted"></i>
                        <p class="mt-3 text-muted">Interactive performance trend charts would be displayed here</p>
                        <button class="btn btn-outline-primary">
                            <i class="fas fa-chart-bar"></i> View Detailed Analytics
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5><i class="fas fa-bullseye"></i> Performance Summary</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6>Overall Performance</h6>
                        <div class="progress">
                            <div class="progress-bar bg-success" style="width: @Model.Dashboard.OverallPerformance%">
                                @Model.Dashboard.OverallPerformance%
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <h6>Trend Direction</h6>
                        <p class="text-@(Model.Dashboard.TrendDirection == "Improving" ? "success" : "warning")">
                            <i class="fas fa-arrow-@(Model.Dashboard.TrendDirection == "Improving" ? "up" : "down")"></i>
                            @Model.Dashboard.TrendDirection
                        </p>
                    </div>
                    <div class="mb-3">
                        <h6>Key Metrics</h6>
                        <ul class="list-unstyled small">
                            <li>• 95% on-time data collection</li>
                            <li>• 87% indicators within target</li>
                            <li>• 2.3 days average response time</li>
                            <li>• 12 proactive improvements</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create SPI Modal -->
<div class="modal fade" id="createSPIModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Create New Safety Performance Indicator</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="CreateSPI">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Indicator Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="NewSPI.IndicatorName" placeholder="e.g., Monthly Hazard Reports" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description <span class="text-danger">*</span></label>
                        <textarea class="form-control" asp-for="NewSPI.Description" rows="3" placeholder="Describe what this indicator measures..." required></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Data Type <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="NewSPI.DataType" required>
                                    <option value="">Select data type...</option>
                                    <option value="Count">Count (Numbers)</option>
                                    <option value="Percentage">Percentage (%)</option>
                                    <option value="Rate">Rate (per period)</option>
                                    <option value="Time">Time (hours/days)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Frequency <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="NewSPI.Frequency" required>
                                    <option value="">Select frequency...</option>
                                    <option value="Daily">Daily</option>
                                    <option value="Weekly">Weekly</option>
                                    <option value="Monthly">Monthly</option>
                                    <option value="Quarterly">Quarterly</option>
                                    <option value="Annually">Annually</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Target Value <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" class="form-control" asp-for="NewSPI.TargetValue" placeholder="e.g., 25" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Alert Threshold <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" class="form-control" asp-for="NewSPI.ThresholdValue" placeholder="e.g., 40" required>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Responsible Person <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="NewSPI.ResponsiblePerson" required>
                            <option value="">Select responsible person...</option>
                            <option value="Safety Manager">Safety Manager</option>
                            <option value="Operations Manager">Operations Manager</option>
                            <option value="Quality Assurance">Quality Assurance</option>
                            <option value="Department Head">Department Head</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Create SPI</button>
                </div>
            </form>
        </div>
    </div>
</div>

