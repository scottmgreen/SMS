@page
@model PDXSMS_Presentation.Pages.Account.NotificationsModel
@{
    ViewData["Title"] = "Notifications - PDXSMS";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item active">Notifications</li>
                </ol>
            </nav>
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <h1 class="card-title">
                                <i class="fas fa-bell"></i> Notifications
                                @if (Model.UnreadCount > 0)
                                {
                                    <span class="badge bg-danger ms-2">@Model.UnreadCount</span>
                                }
                            </h1>
                            <p class="card-text">Stay updated with important system notifications and alerts</p>
                        </div>
                        <div class="col-auto">
                            @if (Model.UnreadCount > 0)
                            {
                                <form method="post" asp-page-handler="MarkAllRead" style="display: inline;">
                                    <button type="submit" class="btn btn-outline-dark">
                                        <i class="fas fa-check-double"></i> Mark All Read
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Notifications List -->
        <div class="col-lg-8">
            <!-- Filter Controls -->
            <div class="card mb-4">
                <div class="card-body">
                    <form method="get">
                        <div class="row align-items-end">
                            <div class="col-md-3">
                                <label for="filterType" class="form-label">Filter by Type</label>
                                <select class="form-select" id="filterType" name="type" asp-for="FilterType" asp-items="Model.NotificationTypeOptions">
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="filterStatus" class="form-label">Status</label>
                                <select class="form-select" id="filterStatus" name="status" asp-for="FilterStatus" asp-items="Model.StatusOptions">
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="searchTerm" class="form-label">Search</label>
                                <input type="text" class="form-control" id="searchTerm" name="search" asp-for="SearchTerm" placeholder="Search notifications...">
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-filter"></i> Filter
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Notifications -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-list"></i> Recent Notifications (@Model.Notifications.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Notifications.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var notification in Model.Notifications)
                            {
                                <div class="list-group-item @(notification.IsRead ? "" : "list-group-item-warning")">
                                    <div class="row align-items-center">
                                        <div class="col">
                                            <div class="d-flex align-items-start">
                                                <div class="me-3">
                                                    <i class="fas @notification.IconClass fa-2x @notification.IconColor"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div>
                                                            <h6 class="mb-1 @(notification.IsRead ? "text-muted" : "")">
                                                                @notification.Title
                                                                @if (!notification.IsRead)
                                                                {
                                                                    <span class="badge bg-primary ms-2">New</span>
                                                                }
                                                            </h6>
                                                            <p class="mb-1 @(notification.IsRead ? "text-muted" : "")">
                                                                @notification.Message
                                                            </p>
                                                            <small class="text-muted">
                                                                <i class="fas fa-clock"></i> @notification.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                                                <span class="ms-2">
                                                                    <span class="badge @notification.TypeBadgeClass">@notification.Type</span>
                                                                </span>
                                                                @if (notification.Priority == "High")
                                                                {
                                                                    <span class="ms-1">
                                                                        <span class="badge bg-danger">High Priority</span>
                                                                    </span>
                                                                }
                                                            </small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <div class="btn-group btn-group-sm">
                                                @if (!notification.IsRead)
                                                {
                                                    <form method="post" asp-page-handler="MarkRead" style="display: inline;">
                                                        <input type="hidden" name="notificationId" value="@notification.Id" />
                                                        <button type="submit" class="btn btn-outline-success" title="Mark as Read">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                    </form>
                                                }
                                                @if (!string.IsNullOrEmpty(notification.ActionUrl))
                                                {
                                                    <a href="@notification.ActionUrl" class="btn btn-outline-primary" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                }
                                                <form method="post" asp-page-handler="DeleteNotification" style="display: inline;">
                                                    <input type="hidden" name="notificationId" value="@notification.Id" />
                                                    <button type="submit" class="btn btn-outline-danger" title="Delete"
                                                            onclick="return confirm('Are you sure you want to delete this notification?')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-bell-slash fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No notifications found</h5>
                            <p class="text-muted">You're all caught up! Check back later for new notifications.</p>
                        </div>
                    }
                </div>
                
                @if (Model.Notifications.Any())
                {
                    <div class="card-footer">
                        <div class="row align-items-center">
                            <div class="col">
                                <small class="text-muted">
                                    Showing @Model.Notifications.Count of @Model.TotalNotifications notifications
                                </small>
                            </div>
                            <div class="col-auto">
                                <nav>
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                            <a class="page-link" href="?page=@(Model.CurrentPage - 1)">Previous</a>
                                        </li>
                                        <li class="page-item active">
                                            <span class="page-link">@Model.CurrentPage</span>
                                        </li>
                                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" href="?page=@(Model.CurrentPage + 1)">Next</a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Notification Settings -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-cog"></i> Notification Preferences
                    </h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="UpdatePreferences">
                        <h6>Email Notifications</h6>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="emailHazards" asp-for="Preferences.EmailHazards">
                                <label class="form-check-label" for="emailHazards">
                                    New Hazard Reports
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="emailAssignments" asp-for="Preferences.EmailAssignments">
                                <label class="form-check-label" for="emailAssignments">
                                    Task Assignments
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="emailDeadlines" asp-for="Preferences.EmailDeadlines">
                                <label class="form-check-label" for="emailDeadlines">
                                    Approaching Deadlines
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="emailSystem" asp-for="Preferences.EmailSystem">
                                <label class="form-check-label" for="emailSystem">
                                    System Updates
                                </label>
                            </div>
                        </div>

                        <h6>In-App Notifications</h6>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="browserHazards" asp-for="Preferences.BrowserHazards">
                                <label class="form-check-label" for="browserHazards">
                                    Hazard Updates
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="browserAssignments" asp-for="Preferences.BrowserAssignments">
                                <label class="form-check-label" for="browserAssignments">
                                    New Assignments
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="browserMentions" asp-for="Preferences.BrowserMentions">
                                <label class="form-check-label" for="browserMentions">
                                    Mentions & Comments
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="notificationFrequency" class="form-label">Email Frequency</label>
                            <select class="form-select" id="notificationFrequency" asp-for="Preferences.EmailFrequency" asp-items="Model.FrequencyOptions">
                            </select>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <i class="fas fa-save"></i> Save Preferences
                        </button>
                    </form>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-pie"></i> Notification Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <h4 class="text-primary">@Model.UnreadCount</h4>
                            <small class="text-muted">Unread</small>
                        </div>
                        <div class="col-6">
                            <h4 class="text-success">@Model.TotalNotifications</h4>
                            <small class="text-muted">Total</small>
                        </div>
                    </div>
                    
                    <hr>
                    
                    <h6>Recent Activity</h6>
                    <div class="small">
                        @foreach (var stat in Model.NotificationStats)
                        {
                            <div class="d-flex justify-content-between mb-1">
                                <span>@stat.Type:</span>
                                <span class="@stat.BadgeClass">@stat.Count</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}