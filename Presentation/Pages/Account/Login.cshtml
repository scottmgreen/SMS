            <form method="post" asp-page-handler="Login">
                <div class="mb-3">
                    <label for="email" class="form-label">
                        <i class="fas fa-envelope text-muted"></i> Email Address
                    </label>
                    <input type="email" class="form-control form-control-lg" id="email" 
                           asp-for="LoginRequest.Email" 
                           placeholder="Enter your email address" 
                           required autofocus>
                    <span asp-validation-for="LoginRequest.Email" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label for="password" class="form-label">
                        <i class="fas fa-lock text-muted"></i> Password
                    </label>
                    <div class="input-group">
                        <input type="password" class="form-control form-control-lg" id="password" 
                               asp-for="LoginRequest.Password" 
                               placeholder="Enter your password" 
                               required>
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword()">
                            <i id="passwordToggle" class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="LoginRequest.Password" class="text-danger"></span>
                </div>
                
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="rememberMe" asp-for="LoginRequest.RememberMe">
                    <label class="form-check-label" for="rememberMe">
                        Keep me signed in
                    </label>
                </div>
                
                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-sign-in-alt"></i> Sign In
                    </button>
                </div>
                
                <div class="text-center mb-3">
                    <a href="?handler=ForgotPassword" class="text-decoration-none me-3">
                        <i class="fas fa-question-circle"></i> Forgot your password?
                    </a>
                </div>
            </form>

            <!-- Debug Links for Development -->
