@page
@model PDXSMS_Presentation.Pages.Account.SettingsModel
@{
    ViewData["Title"] = "Account Settings - PDXSMS";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item active">Account Settings</li>
                </ol>
            </nav>
            <div class="card bg-secondary text-white">
                <div class="card-body">
                    <h1 class="card-title"><i class="fas fa-cog"></i> Account Settings</h1>
                    <p class="card-text">Customize your PDXSMS experience and preferences</p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Main Settings -->
        <div class="col-lg-8">
            <!-- Display Preferences -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-desktop"></i> Display Preferences
                    </h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="UpdateDisplaySettings">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="theme" class="form-label">Theme</label>
                                    <select class="form-select" id="theme" asp-for="Settings.Theme" asp-items="Model.ThemeOptions">
                                    </select>
                                    <div class="form-text">Choose your preferred interface theme</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="language" class="form-label">Language</label>
                                    <select class="form-select" id="language" asp-for="Settings.Language" asp-items="Model.LanguageOptions">
                                    </select>
                                    <div class="form-text">Select your preferred language</div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="dateFormat" class="form-label">Date Format</label>
                                    <select class="form-select" id="dateFormat" asp-for="Settings.DateFormat" asp-items="Model.DateFormatOptions">
                                    </select>
                                    <div class="form-text">How dates should be displayed</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="timeZone" class="form-label">Time Zone</label>
                                    <select class="form-select" id="timeZone" asp-for="Settings.TimeZone" asp-items="Model.TimeZoneOptions">
                                    </select>
                                    <div class="form-text">Your local time zone</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="showHelpTips" asp-for="Settings.ShowHelpTips">
                                <label class="form-check-label" for="showHelpTips">
                                    Show help tips and tooltips
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Display Settings
                        </button>
                    </form>
                </div>
            </div>

            <!-- Dashboard Preferences -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-tachometer-alt"></i> Dashboard Preferences
                    </h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="UpdateDashboardSettings">
                        <div class="mb-3">
                            <label class="form-label">Default Dashboard Widgets</label>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="showActiveHazards" asp-for="Settings.ShowActiveHazards">
                                        <label class="form-check-label" for="showActiveHazards">
                                            Active Hazards Summary
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="showPendingReviews" asp-for="Settings.ShowPendingReviews">
                                        <label class="form-check-label" for="showPendingReviews">
                                            Pending Reviews
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="showRecentActivity" asp-for="Settings.ShowRecentActivity">
                                        <label class="form-check-label" for="showRecentActivity">
                                            Recent Activity Feed
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="showQuickActions" asp-for="Settings.ShowQuickActions">
                                        <label class="form-check-label" for="showQuickActions">
                                            Quick Actions Panel
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="showSystemStatus" asp-for="Settings.ShowSystemStatus">
                                        <label class="form-check-label" for="showSystemStatus">
                                            System Status Indicators
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="showPerformanceMetrics" asp-for="Settings.ShowPerformanceMetrics">
                                        <label class="form-check-label" for="showPerformanceMetrics">
                                            Performance Metrics
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="itemsPerPage" class="form-label">Items per Page</label>
                            <select class="form-select" id="itemsPerPage" asp-for="Settings.ItemsPerPage" asp-items="Model.ItemsPerPageOptions">
                            </select>
                            <div class="form-text">Default number of items to show in lists and tables</div>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Dashboard Settings
                        </button>
                    </form>
                </div>
            </div>

            <!-- Privacy & Security -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-shield-alt"></i> Privacy & Security
                    </h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="UpdateSecuritySettings">
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="twoFactorEnabled" asp-for="Settings.TwoFactorEnabled">
                                <label class="form-check-label" for="twoFactorEnabled">
                                    <strong>Enable Two-Factor Authentication</strong>
                                </label>
                                <div class="form-text">Add an extra layer of security to your account</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="logSecurityEvents" asp-for="Settings.LogSecurityEvents">
                                <label class="form-check-label" for="logSecurityEvents">
                                    Log security-related activities
                                </label>
                                <div class="form-text">Keep track of login attempts and security events</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="sessionTimeout" class="form-label">Session Timeout</label>
                            <select class="form-select" id="sessionTimeout" asp-for="Settings.SessionTimeout" asp-items="Model.SessionTimeoutOptions">
                            </select>
                            <div class="form-text">Automatically log out after period of inactivity</div>
                        </div>

                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-shield-alt"></i> Save Security Settings
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Settings Summary -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle"></i> Current Settings Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <tr>
                                <th>Theme:</th>
                                <td><span class="badge bg-info">@Model.Settings.Theme</span></td>
                            </tr>
                            <tr>
                                <th>Language:</th>
                                <td>@Model.Settings.Language</td>
                            </tr>
                            <tr>
                                <th>Time Zone:</th>
                                <td>@Model.Settings.TimeZone</td>
                            </tr>
                            <tr>
                                <th>Date Format:</th>
                                <td>@Model.Settings.DateFormat</td>
                            </tr>
                            <tr>
                                <th>Items/Page:</th>
                                <td>@Model.Settings.ItemsPerPage</td>
                            </tr>
                            <tr>
                                <th>2FA:</th>
                                <td>
                                    @if (Model.Settings.TwoFactorEnabled)
                                    {
                                        <span class="badge bg-success">Enabled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Disabled</span>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-download"></i> Data Management
                    </h5>
                </div>
                <div class="card-body">
                    <p class="card-text small">
                        Manage your personal data and account information.
                    </p>
                    
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-info btn-sm">
                            <i class="fas fa-download"></i> Export My Data
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-history"></i> Activity History
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm">
                            <i class="fas fa-trash"></i> Delete Account
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}