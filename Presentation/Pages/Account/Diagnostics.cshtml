@page
@model PDXSMS_Presentation.Pages.Account.DiagnosticsModel
@{
    ViewData["Title"] = "Login Diagnostics - PDXSMS";
    Layout = "_LoginLayout";
}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="text-center mb-4">
                <i class="fas fa-stethoscope fa-3x text-success mb-3"></i>
                <h2 class="text-primary">Login Diagnostics</h2>
                <p class="text-muted">Troubleshooting Information</p>
            </div>
        </div>
        
        <div class="login-body">
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                <strong>System Information</strong> - This page helps diagnose login issues.
            </div>
            
            <h6><i class="fas fa-server"></i> Server Information</h6>
            <div class="table-responsive mb-3">
                <table class="table table-sm table-bordered">
                    <tr>
                        <td><strong>Environment</strong></td>
                        <td><code>@Model.EnvironmentName</code></td>
                    </tr>
                    <tr>
                        <td><strong>Server Time</strong></td>
                        <td><code>@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</code></td>
                    </tr>
                    <tr>
                        <td><strong>Session Available</strong></td>
                        <td><code>@Model.SessionAvailable</code></td>
                    </tr>
                    <tr>
                        <td><strong>Session ID</strong></td>
                        <td><code>@Model.SessionId</code></td>
                    </tr>
                </table>
            </div>
            
            <h6><i class="fas fa-users"></i> Test User Accounts</h6>
            <div class="table-responsive mb-3">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Password</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.TestUsers)
                        {
                            <tr>
                                <td><small><code>@user.Email</code></small></td>
                                <td><small><code>@user.Password</code></small></td>
                                <td><span class="badge bg-success">Active</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <h6><i class="fas fa-check-circle"></i> Quick Test</h6>
            <form method="post" asp-page-handler="TestLogin">
                <div class="input-group mb-3">
                    <input type="email" class="form-control" name="testEmail" 
                           placeholder="Test email" value="admin@flypdx.com">
                    <input type="password" class="form-control" name="testPassword" 
                           placeholder="Test password" value="admin123">
                    <button type="submit" class="btn btn-outline-primary">Test Login</button>
                </div>
            </form>
            
            @if (TempData["TestResult"] != null)
            {
                <div class="alert alert-@(TempData["TestSuccess"].ToString() == "True" ? "success" : "danger")">
                    <strong>Test Result:</strong> @TempData["TestResult"]
                </div>
            }
            
            <div class="d-grid mb-3">
                <a href="/Account/Login" class="btn btn-primary">
                    <i class="fas fa-sign-in-alt"></i> Back to Login
                </a>
            </div>
        </div>
        
        <div class="login-footer">
            <hr>
            <div class="text-center">
                <small class="text-muted">
                    <i class="fas fa-tools"></i> Development Diagnostics<br>
                    Portland International Airport Safety Management System
                </small>
            </div>
        </div>
    </div>
</div>