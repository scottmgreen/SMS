@model PDXSMS_Presentation.Pages.SafetyRiskManagement.AssessmentStep

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h5>
                <span class="badge bg-primary me-2">Step @Model.StepNumber</span>
                @Model.StepName
            </h5>
            <span class="badge bg-info">@Model.Duration</span>
        </div>
        <p class="mb-0 mt-2">@Model.Description</p>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-8">
                <h6><i class="fas fa-tasks"></i> Key Activities</h6>
                <ul class="list-group list-group-flush">
                    @foreach (var activity in Model.Activities)
                    {
                        <li class="list-group-item px-0">
                            <i class="fas fa-check-circle text-success me-2"></i>@activity
                        </li>
                    }
                </ul>
            </div>
            <div class="col-lg-4">
                <h6><i class="fas fa-clipboard-list"></i> Deliverables</h6>
                <div class="list-group list-group-flush">
                    @foreach (var deliverable in Model.Deliverables)
                    {
                        <div class="list-group-item px-0">
                            <i class="fas fa-file-alt text-primary me-2"></i>@deliverable
                        </div>
                    }
                </div>
                
                <div class="mt-3">
                    <h6><i class="fas fa-clock"></i> Estimated Duration</h6>
                    <p class="mb-0"><strong>@Model.Duration</strong></p>
                </div>
            </div>
        </div>
    </div>
</div>
