@using PDXSMS.Services
@inject StandardizedRiskMatrixService RiskMatrixService
@model List<PDXSMS_Presentation.Pages.SafetyRiskManagement.HazardRiskMapping>

@{
    // ?? USE STANDARDIZED RISK MATRIX SERVICE for consistent terminology
    var severityLevels = RiskMatrixService.GetAllSeverityLevels();
    var likelihoodCodes = RiskMatrixService.GetAllLikelihoodCodes();
}

<div class="risk-matrix-container">
    <div class="table-responsive">
        <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th class="text-center bg-dark text-white" style="width: 120px;">
                        <strong>LIKELIHOOD ?<br>SEVERITY ?</strong>
                    </th>
                    @foreach (var likelihood in likelihoodCodes)
                    {
                        <th class="text-center bg-secondary text-white" style="width: 100px; font-size: 0.75em;">
                            <strong>@likelihood.Code<br>@likelihood.Name</strong>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var severity in severityLevels.OrderByDescending(s => s.Level))
                {
                    <tr>
                        <td class="text-center bg-light align-middle" style="font-size: 0.75em;">
                            <strong>@severity.Level<br>@severity.Name</strong>
                        </td>
                        @foreach (var likelihood in likelihoodCodes)
                        {
                            var matrixResult = RiskMatrixService.CalculateRisk(severity.Level, likelihood.Code);
                            var hazardsInCell = Model?.Where(h => h.RiskLevel == matrixResult.MatrixCode).ToList() ?? new List<PDXSMS_Presentation.Pages.SafetyRiskManagement.HazardRiskMapping>();
                            var cellClass = matrixResult.GetBootstrapClass();
                            var textClass = GetTextColorClass(cellClass);
                            
                            <td class="text-center risk-cell bg-@cellClass @textClass" 
                                data-risk-level="@matrixResult.MatrixCode" 
                                data-bs-toggle="@(hazardsInCell.Any() ? "tooltip" : "")"
                                data-bs-title="@(hazardsInCell.Any() ? $"{hazardsInCell.Count} hazard(s): {string.Join(", ", hazardsInCell.Select(h => h.HazardId))}" : "")"
                                style="cursor: pointer; height: 60px; vertical-align: middle; position: relative;">
                                <div>
                                    <strong>@matrixResult.MatrixCode</strong>
                                    @if (hazardsInCell.Any())
                                    {
                                        <br>
                                        <span class="badge bg-white text-dark" style="font-size: 0.6em;">
                                            @hazardsInCell.Count
                                        </span>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <!-- ?? STANDARDIZED LEGEND using centralized service -->
    <div class="mt-3">
        <h6>Risk Level Legend:</h6>
        <div class="row">
            @foreach (var riskLevel in Enum.GetValues<StandardizedRiskMatrixService.RiskLevel>().OrderByDescending(r => r))
            {
                var cssClass = RiskMatrixService.GetRiskLevelBootstrapClass(riskLevel);
                var textClass = GetTextColorClass(cssClass);
                
                <div class="col-md-4 mb-2">
                    <span class="badge bg-@cssClass @textClass">@riskLevel</span>
                    @{
                        var sampleResult = StandardizedRiskMatrixService.RiskMatrix.Values.FirstOrDefault(r => r.RiskLevel == riskLevel);
                    }
                    @if (sampleResult != null)
                    {
                        <small class="ms-2">@sampleResult.RiskDescription</small>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .risk-matrix-container .risk-cell {
        transition: all 0.2s ease;
        font-size: 0.85em;
    }
    
    .risk-matrix-container .risk-cell:hover {
        transform: scale(1.05);
        box-shadow: 0 2px 6px rgba(0,0,0,0.2);
        z-index: 10;
        position: relative;
    }
    
    .risk-matrix-container th {
        font-size: 0.75em;
    }
    
    .risk-matrix-container td {
        font-size: 0.8em;
    }
</style>

@functions {
    /// <summary>
    /// Get appropriate text color class for background
    /// </summary>
    private string GetTextColorClass(string backgroundClass)
    {
        return backgroundClass switch
        {
            "dark" or "danger" => "text-white",
            "warning" => "text-dark", 
            _ => "text-dark"
        };
    }
}
