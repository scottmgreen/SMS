<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PDXSMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Minimal header for guest users - NO NAVIGATION LINKS -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container-fluid">
                <!-- No clickable brand/logo for guests - security measure -->
                <span class="navbar-brand">
                    <i class="fas fa-shield-alt"></i> PDX Safety Management System (PDXSMS)
                </span>
                
                <!-- Guest indicator with security warning -->
                <div class="navbar-nav ms-auto">
                    <span class="nav-link text-light">
                        <small>
                            <i class="fas fa-user-secret"></i> Session expires in <span id="sessionTimer">30:00</span>
                        </small>
                    </span>
                </div>
            </div>
        </nav>
        
        <!-- Security notice banner -->
        <div class="bg-danger text-white py-2">
            <div class="container-fluid">
                <div class="d-flex align-items-center justify-content-between">
                    <small>
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>SECURITY NOTICE:</strong> You are in an anonymous session restricted to confidential reporting only. All information submitted through this form is protected and handled with strict confidentiality.
                    </small>
                    
                </div>
            </div>
        </div>
    </header>

    <main role="main" class="py-4">
        @RenderBody()
    </main>

    <!-- Footer with no navigation links -->
    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">
            <p class="mb-1">&copy; 2024 - Portland International Airport (PDX) - Safety Management System</p>
            <p class="small mb-0">
                <i class="fas fa-shield-alt"></i> Confidential Reporting Portal | 14 CFR Part 139 Compliant | 
                <i class="fas fa-lock"></i> Anonymous & Secure
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Enhanced security and session management -->
    <script>
        // 30-minute session timer for guests
        let sessionTimeLeft = 30 * 60; // 30 minutes in seconds
        
        function updateTimer() {
            const minutes = Math.floor(sessionTimeLeft / 60);
            const seconds = sessionTimeLeft % 60;
            const timerElement = document.getElementById('sessionTimer');
            
            if (timerElement) {
                timerElement.textContent = 
                    `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            }
            
            if (sessionTimeLeft <= 0) {
                alert('Your anonymous session has expired for security purposes. You will be redirected to the login page.');
                window.location.href = '/Account/Login';
                return;
            }
            
            sessionTimeLeft--;
        }
        
        // Update timer every second
        setInterval(updateTimer, 1000);
        updateTimer(); // Initial call
        
        // Warn before session expires
        setTimeout(() => {
            if (sessionTimeLeft > 0) {
                alert('Your anonymous session will expire in 5 minutes. Please complete your report submission.');
            }
        }, 25 * 60 * 1000); // 25 minutes

        // ENHANCED SECURITY MEASURES FOR GUESTS
        
        // Prevent all forms of navigation
        document.addEventListener('DOMContentLoaded', function() {
            // Disable all anchor tags that might allow navigation
            document.querySelectorAll('a').forEach(function(link) {
                const href = link.getAttribute('href');
                if (href && href !== '#' && !href.startsWith('tel:') && !href.startsWith('mailto:')) {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        alert('Navigation is disabled in anonymous sessions for your security. Please complete your report or the session will timeout.');
                    });
                }
            });
        });

        // Prevent back/forward navigation
        (function() {
            // Clear navigation history
            if (window.history && window.history.pushState) {
                // Replace current history entry
                window.history.replaceState(null, null, '/SafetyRiskManagement/ConfidentialReporting');
                
                // Push a state to prevent back navigation
                window.history.pushState(null, null, '/SafetyRiskManagement/ConfidentialReporting');
                
                // Handle popstate (back/forward button)
                window.addEventListener('popstate', function(event) {
                    alert('Navigation is disabled in anonymous sessions for security. Your session will end if you continue.');
                    // Clear session and redirect to login
                    fetch('/Account/Login?handler=ClearGuestSession', { method: 'POST' })
                        .then(() => {
                            window.location.href = '/Account/Login';
                        });
                });
            }
        })();

        // Prevent keyboard shortcuts for navigation
        document.addEventListener('keydown', function(e) {
            // Disable Alt+Left (back), Alt+Right (forward)
            if (e.altKey && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) {
                e.preventDefault();
                e.stopPropagation();
                alert('Navigation shortcuts are disabled in anonymous sessions.');
            }
            
            // Disable Ctrl+R (refresh), F5 (refresh), Ctrl+Shift+R (hard refresh)
            if ((e.ctrlKey && e.key === 'r') || e.key === 'F5' || (e.ctrlKey && e.shiftKey && e.key === 'r')) {
                e.preventDefault();
                e.stopPropagation();
                alert('Page refresh is disabled in anonymous sessions. Your session will end if you continue.');
            }
            
            // Disable Backspace key (can trigger back navigation)
            if (e.key === 'Backspace' && 
                !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName) && 
                !document.activeElement.isContentEditable) {
                e.preventDefault();
                e.stopPropagation();
            }

            // Disable F12, Ctrl+Shift+I, Ctrl+U (developer tools)
            if (e.key === 'F12' || 
                (e.ctrlKey && e.shiftKey && e.key === 'I') ||
                (e.ctrlKey && e.key === 'u')) {
                e.preventDefault();
                e.stopPropagation();
            }
        });

        // Disable right-click context menu
        document.addEventListener('contextmenu', function(e) {
            e.preventDefault();
        });

        // Monitor for attempts to navigate away
        window.addEventListener('beforeunload', function(e) {
            // Clear guest session
            fetch('/Account/Login?handler=ClearGuestSession', { method: 'POST' });
        });

        // Prevent drag and drop (security measure)
        document.addEventListener('dragover', function(e) {
            e.preventDefault();
        });
        
        document.addEventListener('drop', function(e) {
            e.preventDefault();
        });

        // Clear any existing localStorage for security
        try {
            localStorage.clear();
            sessionStorage.clear();
        } catch (e) {
            // Ignore errors if storage is not available
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>