@page
@model PDXSMS_Presentation.Pages.SafetyPromotion.SafetyCommunicationsModel
@{
    ViewData["Title"] = "Safety Communications";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="#">Safety Promotion</a></li>
                    <li class="breadcrumb-item active">Safety Communications</li>
                </ol>
            </nav>
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h1 class="card-title"><i class="fas fa-bullhorn"></i> Safety Communications</h1>
                    <p class="card-text">Foster safety culture through effective communication and information sharing</p>
                    <div class="row mt-3">
                        <div class="col-auto">
                            <span class="badge bg-light text-dark">Safety Bulletins</span>
                        </div>
                        <div class="col-auto">
                            <span class="badge bg-light text-dark">Operational Briefings</span>
                        </div>
                        <div class="col-auto">
                            <span class="badge bg-light text-dark">Committee Summaries</span>
                        </div>
                        <div class="col-auto">
                            <span class="badge bg-light text-dark">Digital Updates</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Action Bar -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">Communication Management</h5>
                            <small class="text-muted">Manage all safety-critical communications and information sharing</small>
                        </div>
                        <div>
                            <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#createCommunicationModal">
                                <i class="fas fa-plus"></i> Create Communication
                            </button>
                            <a href="/SafetyPromotion/CommunicationScenarios" class="btn btn-outline-info">
                                <i class="fas fa-lightbulb"></i> View Examples
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Communication Types Tabs -->
    <div class="row">
        <div class="col-12">
            <ul class="nav nav-tabs" id="communicationTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="bulletins-tab" data-bs-toggle="tab" data-bs-target="#bulletins" type="button" role="tab">
                        <i class="fas fa-exclamation-circle"></i> Safety Bulletins 
                        <span class="badge bg-danger ms-1">@Model.RecentBulletins.Count(b => b.Status == "Active")</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="briefings-tab" data-bs-toggle="tab" data-bs-target="#briefings" type="button" role="tab">
                        <i class="fas fa-users"></i> Operational Briefings 
                        <span class="badge bg-warning ms-1">@Model.RecentBriefings.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="summaries-tab" data-bs-toggle="tab" data-bs-target="#summaries" type="button" role="tab">
                        <i class="fas fa-clipboard"></i> Committee Summaries
                        <span class="badge bg-info ms-1">@Model.RecentSummaries.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="updates-tab" data-bs-toggle="tab" data-bs-target="#updates" type="button" role="tab">
                        <i class="fas fa-globe"></i> Digital Updates
                        <span class="badge bg-success ms-1">@Model.RecentUpdates.Count</span>
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="communicationTabsContent">
                <!-- Safety Bulletins Tab -->
                <div class="tab-pane fade show active" id="bulletins" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-exclamation-circle"></i> Safety Bulletins</h5>
                            <p class="mb-0 text-muted">Critical safety information shared following incidents, findings, or trend analyses</p>
                        </div>
                        <div class="card-body">
                            @if (Model.RecentBulletins.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Bulletin ID</th>
                                                <th>Title</th>
                                                <th>Issue Date</th>
                                                <th>Priority</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var bulletin in Model.RecentBulletins)
                                            {
                                                <tr>
                                                    <td><strong>@bulletin.Id</strong></td>
                                                    <td>@bulletin.Title</td>
                                                    <td>@bulletin.IssueDate.ToString("MM/dd/yyyy")</td>
                                                    <td>
                                                        <span class="badge bg-@(bulletin.Priority == "High" ? "danger" : bulletin.Priority == "Medium" ? "warning" : "secondary")">
                                                            @bulletin.Priority
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-@(bulletin.Status == "Active" ? "success" : "secondary")">
                                                            @bulletin.Status
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group" role="group">
                                                            <button type="button" class="btn btn-sm btn-outline-primary">
                                                                <i class="fas fa-eye"></i> View
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-info">
                                                                <i class="fas fa-share"></i> Distribute
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-exclamation-circle fa-3x"></i>
                                    <p class="mt-2">No safety bulletins issued</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Operational Briefings Tab -->
                <div class="tab-pane fade" id="briefings" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-users"></i> Operational Briefings</h5>
                            <p class="mb-0 text-muted">Real-time safety updates during shift handovers and operational briefings</p>
                        </div>
                        <div class="card-body">
                            @if (Model.RecentBriefings.Any())
                            {
                                <div class="row">
                                    @foreach (var briefing in Model.RecentBriefings)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <div class="card border-warning">
                                                <div class="card-header bg-warning bg-opacity-10">
                                                    <strong>@briefing.Id</strong>
                                                    <span class="float-end text-muted">@briefing.BriefingDate.ToString("MM/dd/yyyy HH:mm")</span>
                                                </div>
                                                <div class="card-body">
                                                    <h6 class="card-title">@briefing.Title</h6>
                                                    <p class="card-text small">
                                                        <i class="fas fa-user"></i> Conducted by: @briefing.ConductedBy<br>
                                                        <i class="fas fa-users"></i> Audience: @briefing.Audience
                                                    </p>
                                                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                                        <button class="btn btn-outline-warning btn-sm">
                                                            <i class="fas fa-eye"></i> View Notes
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-users fa-3x"></i>
                                    <p class="mt-2">No recent briefings</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Committee Summaries Tab -->
                <div class="tab-pane fade" id="summaries" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-clipboard"></i> Committee Summaries</h5>
                            <p class="mb-0 text-muted">Key findings and updates from SMS committees and teams</p>
                        </div>
                        <div class="card-body">
                            @if (Model.RecentSummaries.Any())
                            {
                                @foreach (var summary in Model.RecentSummaries)
                                {
                                    <div class="card border-info mb-3">
                                        <div class="card-header bg-info bg-opacity-10">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <strong>@summary.Id</strong>
                                                <span class="badge bg-info">@summary.CommitteeName</span>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            <h6 class="card-title">@summary.Title</h6>
                                            <p class="card-text small text-muted">
                                                <i class="fas fa-calendar"></i> @summary.SummaryDate.ToString("MM/dd/yyyy")
                                            </p>
                                            <h6>Key Findings:</h6>
                                            <ul class="list-unstyled">
                                                @foreach (var finding in summary.KeyFindings)
                                                {
                                                    <li><i class="fas fa-check-circle text-success me-2"></i>@finding</li>
                                                }
                                            </ul>
                                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                                <button class="btn btn-outline-info btn-sm">
                                                    <i class="fas fa-eye"></i> View Full Summary
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-clipboard fa-3x"></i>
                                    <p class="mt-2">No committee summaries available</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Digital Updates Tab -->
                <div class="tab-pane fade" id="updates" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-globe"></i> Digital Updates</h5>
                            <p class="mb-0 text-muted">SMS web page updates, system announcements, and digital communications</p>
                        </div>
                        <div class="card-body">
                            @if (Model.RecentUpdates.Any())
                            {
                                <div class="list-group">
                                    @foreach (var update in Model.RecentUpdates)
                                    {
                                        <div class="list-group-item">
                                            <div class="d-flex w-100 justify-content-between">
                                                <h6 class="mb-1">@update.Title</h6>
                                                <small>@update.UpdateDate.ToString("MM/dd/yyyy")</small>
                                            </div>
                                            <p class="mb-1">@update.Content</p>
                                            <small class="text-muted">
                                                <i class="fas fa-tv"></i> Channel: @update.Channel
                                            </small>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-globe fa-3x"></i>
                                    <p class="mt-2">No digital updates</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Communication Modal -->
<div class="modal fade" id="createCommunicationModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Create Safety Communication</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Communication Type <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="NewCommunication.Type" required>
                                    <option value="">Select type...</option>
                                    <option value="Safety Bulletin">Safety Bulletin</option>
                                    <option value="Operational Briefing">Operational Briefing</option>
                                    <option value="Committee Summary">Committee Summary</option>
                                    <option value="Digital Update">Digital Update</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Priority Level</label>
                                <select class="form-select" asp-for="NewCommunication.Priority">
                                    <option value="Low">Low</option>
                                    <option value="Medium" selected>Medium</option>
                                    <option value="High">High</option>
                                    <option value="Critical">Critical</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="NewCommunication.Title" placeholder="e.g., Winter Weather Operations Update" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Content <span class="text-danger">*</span></label>
                        <textarea class="form-control" asp-for="NewCommunication.Content" rows="6" placeholder="Enter the communication content..." required></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Target Audience <span class="text-danger">*</span></label>
                                <select class="form-select" asp-for="NewCommunication.Audience" required>
                                    <option value="">Select audience...</option>
                                    <option value="All Staff">All Staff</option>
                                    <option value="Ground Crew">Ground Crew</option>
                                    <option value="Operations Staff">Operations Staff</option>
                                    <option value="Security Personnel">Security Personnel</option>
                                    <option value="Management">Management</option>
                                    <option value="Tenants">Tenants</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Distribution Channel</label>
                                <select class="form-select" asp-for="NewCommunication.Channel">
                                    <option value="Email">Email</option>
                                    <option value="Web Portal">Web Portal</option>
                                    <option value="Mobile App">Mobile App</option>
                                    <option value="Physical Posting">Physical Posting</option>
                                    <option value="All Channels">All Channels</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info">Create & Distribute</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-focus title when modal opens
        document.getElementById('createCommunicationModal').addEventListener('shown.bs.modal', function () {
            document.querySelector('select[name="NewCommunication.Type"]').focus();
        });
    </script>
}

