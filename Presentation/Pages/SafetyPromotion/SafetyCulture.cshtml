@page
@model PDXSMS_Presentation.Pages.SafetyPromotion.SafetyCultureModel
@{
    ViewData["Title"] = "Safety Culture";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyPromotion">Safety Promotion</a></li>
                    <li class="breadcrumb-item active">Safety Culture</li>
                </ol>
            </nav>
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h1 class="card-title"><i class="fas fa-users"></i> Safety Culture</h1>
                            <p class="card-text">Assess, monitor, and promote positive safety culture across the organization</p>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="row text-center">
                                <div class="col-6">
                                    <h3 class="mb-0">@Model.Dashboard.OverallCultureScore</h3>
                                    <small>Culture Score (1-5)</small>
                                </div>
                                <div class="col-6">
                                    <h3 class="mb-0">@Model.Dashboard.ParticipationRate%</h3>
                                    <small>Participation Rate</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Culture Dashboard -->
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card border-success">
                <div class="card-body text-center">
                    <h3 class="text-success">@Model.Dashboard.OverallCultureScore</h3>
                    <p class="mb-0">Culture Score</p>
                    <small class="text-muted">Out of 5.0</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-primary">
                <div class="card-body text-center">
                    <h3 class="text-primary">@Model.Dashboard.ParticipationRate%</h3>
                    <p class="mb-0">Participation</p>
                    <small class="text-muted">Employee engagement</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-info">
                <div class="card-body text-center">
                    <h3 class="text-info">+@Model.Dashboard.PositiveTrend%</h3>
                    <p class="mb-0">Positive Trend</p>
                    <small class="text-muted">Year over year</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-warning">
                <div class="card-body text-center">
                    <h3 class="text-warning">@Model.Dashboard.InitiativesActive</h3>
                    <p class="mb-0">Active Initiatives</p>
                    <small class="text-muted">In progress</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-secondary">
                <div class="card-body text-center">
                    <h3 class="text-secondary">@Model.Dashboard.SurveyResponseRate%</h3>
                    <p class="mb-0">Survey Response</p>
                    <small class="text-muted">Latest assessment</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-dark">
                <div class="card-body text-center">
                    <h3 class="text-dark">@Model.Dashboard.ReportingCulture</h3>
                    <p class="mb-0">Reporting Culture</p>
                    <small class="text-muted">Willingness to report</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Tabs -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" href="#assessment" data-bs-toggle="tab">
                                <i class="fas fa-chart-pie"></i> Culture Assessment
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#initiatives" data-bs-toggle="tab">
                                <i class="fas fa-lightbulb"></i> Culture Initiatives
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#metrics" data-bs-toggle="tab">
                                <i class="fas fa-chart-line"></i> Culture Metrics
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#feedback" data-bs-toggle="tab">
                                <i class="fas fa-comments"></i> Employee Feedback
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content">
                        <!-- Culture Assessment Tab -->
                        <div class="tab-pane fade show active" id="assessment" role="tabpanel">
                            <div class="row">
                                <div class="col-lg-8">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5><i class="fas fa-poll"></i> Current Assessment: @Model.CurrentAssessment.AssessmentPeriod</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row mb-3">
                                                <div class="col-md-6">
                                                    <strong>Assessment Period:</strong><br>
                                                    @Model.CurrentAssessment.StartDate.ToString("MMM dd, yyyy") - @Model.CurrentAssessment.EndDate.ToString("MMM dd, yyyy")
                                                </div>
                                                <div class="col-md-6">
                                                    <strong>Status:</strong> <span class="badge bg-success">@Model.CurrentAssessment.Status</span>
                                                </div>
                                            </div>
                                            
                                            <div class="row mb-4">
                                                <div class="col-md-6">
                                                    <h6>Response Rate</h6>
                                                    <div class="progress">
                                                        <div class="progress-bar bg-info" style="width: @Model.CurrentAssessment.CompletionRate%">
                                                            @Model.CurrentAssessment.CompletionRate%
                                                        </div>
                                                    </div>
                                                    <small class="text-muted">@Model.CurrentAssessment.ResponseCount responses received</small>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="text-center">
                                                        <h2 class="text-success">@Model.Dashboard.OverallCultureScore</h2>
                                                        <p class="mb-0">Overall Culture Score</p>
                                                        <small class="text-muted">Scale: 1.0 (Poor) - 5.0 (Excellent)</small>
                                                    </div>
                                                </div>
                                            </div>

                                            <h6>Key Findings</h6>
                                            <ul class="list-group list-group-flush">
                                                @foreach (var finding in Model.CurrentAssessment.KeyFindings)
                                                {
                                                    <li class="list-group-item">
                                                        <i class="fas fa-check-circle text-success"></i> @finding
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                        <div class="card-footer">
                                            <div class="btn-group">
                                                <button type="button" class="btn btn-primary">
                                                    <i class="fas fa-file-pdf"></i> Download Full Report
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary">
                                                    <i class="fas fa-chart-bar"></i> View Detailed Analytics
                                                </button>
                                                <button type="button" class="btn btn-outline-info">
                                                    <i class="fas fa-plus"></i> Schedule Next Assessment
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-lg-4">
                                    <div class="card">
                                        <div class="card-header">
                                            <h6><i class="fas fa-chart-pie"></i> Culture Dimensions</h6>
                                        </div>
                                        <div class="card-body">
                                            <canvas id="cultureRadarChart" width="300" height="300"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Culture Initiatives Tab -->
                        <div class="tab-pane fade" id="initiatives" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5>Active Culture Initiatives</h5>
                                <button type="button" class="btn btn-primary">
                                    <i class="fas fa-plus"></i> Launch New Initiative
                                </button>
                            </div>
                            
                            <div class="row">
                                @foreach (var initiative in Model.Initiatives)
                                {
                                    <div class="col-lg-6 mb-4">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <div class="row align-items-center">
                                                    <div class="col">
                                                        <h6 class="mb-0">@initiative.Title</h6>
                                                        <small class="text-muted">@initiative.Category</small>
                                                    </div>
                                                    <div class="col-auto">
                                                        <span class="badge @(initiative.Status == "Active" ? "bg-success" : initiative.Status == "Planning" ? "bg-warning" : "bg-secondary")">
                                                            @initiative.Status
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                <p class="text-muted small">@initiative.Description</p>
                                                
                                                <div class="row mb-3">
                                                    <div class="col-6">
                                                        <strong>Progress</strong><br>
                                                        <div class="progress">
                                                            <div class="progress-bar" style="width: @initiative.Progress%">@initiative.Progress%</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <strong>Participants</strong><br>
                                                        <span class="h4">@initiative.Participants</span> employees
                                                    </div>
                                                </div>
                                                
                                                <div class="row">
                                                    <div class="col-6">
                                                        <strong>Started:</strong><br>
                                                        @initiative.StartDate.ToString("MM/dd/yyyy")
                                                    </div>
                                                    <div class="col-6">
                                                        <strong>Target:</strong><br>
                                                        @initiative.TargetDate.ToString("MM/dd/yyyy")
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-footer">
                                                <div class="btn-group w-100">
                                                    <button type="button" class="btn btn-outline-primary btn-sm">
                                                        <i class="fas fa-eye"></i> View Details
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm">
                                                        <i class="fas fa-edit"></i> Update Progress
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Culture Metrics Tab -->
                        <div class="tab-pane fade" id="metrics" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5>Culture Performance Metrics</h5>
                                <button type="button" class="btn btn-outline-primary">
                                    <i class="fas fa-download"></i> Export Metrics
                                </button>
                            </div>
                            
                            <div class="row">
                                @foreach (var metric in Model.Metrics)
                                {
                                    <div class="col-lg-6 mb-4">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="row align-items-center">
                                                    <div class="col">
                                                        <h6 class="mb-0">@metric.Name</h6>
                                                        <small class="text-muted">Last updated: @metric.LastUpdated.ToString("MM/dd/yyyy")</small>
                                                    </div>
                                                    <div class="col-auto">
                                                        <span class="badge @(metric.Trend == "Increasing" ? "bg-success" : metric.Trend == "Decreasing" ? "bg-danger" : "bg-warning")">
                                                            @metric.Trend
                                                        </span>
                                                    </div>
                                                </div>
                                                
                                                <div class="row mt-3">
                                                    <div class="col-4 text-center">
                                                        <h4 class="mb-0">@metric.CurrentValue</h4>
                                                        <small class="text-muted">Current</small>
                                                    </div>
                                                    <div class="col-4 text-center">
                                                        <h4 class="mb-0 @(metric.CurrentValue > metric.PreviousValue ? "text-success" : metric.CurrentValue < metric.PreviousValue ? "text-danger" : "text-muted")">
                                                            @metric.PreviousValue
                                                        </h4>
                                                        <small class="text-muted">Previous</small>
                                                    </div>
                                                    <div class="col-4 text-center">
                                                        <h4 class="mb-0">@metric.Target</h4>
                                                        <small class="text-muted">Target</small>
                                                    </div>
                                                </div>
                                                
                                                <div class="mt-3">
                                                    <div class="progress">
                                                        <div class="progress-bar @(metric.CurrentValue >= metric.Target ? "bg-success" : "bg-warning")" 
                                                             style="width: @((metric.CurrentValue / metric.Target * 100).ToString("F0"))%">
                                                        </div>
                                                    </div>
                                                    <small class="text-muted">Unit: @metric.Unit</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Employee Feedback Tab -->
                        <div class="tab-pane fade" id="feedback" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5>Recent Employee Feedback</h5>
                                <div class="btn-group">
                                    <button type="button" class="btn btn-outline-primary">
                                        <i class="fas fa-filter"></i> Filter Feedback
                                    </button>
                                    <button type="button" class="btn btn-primary">
                                        <i class="fas fa-plus"></i> Collect New Feedback
                                    </button>
                                </div>
                            </div>
                            
                            <div class="row">
                                @foreach (var feedback in Model.RecentFeedback)
                                {
                                    <div class="col-lg-6 mb-3">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="row align-items-center mb-2">
                                                    <div class="col">
                                                        <h6 class="mb-0">@feedback.Source</h6>
                                                        <small class="text-muted">@feedback.Department | @feedback.Date.ToString("MM/dd/yyyy")</small>
                                                    </div>
                                                    <div class="col-auto">
                                                        <span class="badge @(feedback.Category == "Positive" ? "bg-success" : feedback.Category == "Concern" ? "bg-warning" : "bg-info")">
                                                            @feedback.Category
                                                        </span>
                                                    </div>
                                                </div>
                                                <blockquote class="blockquote">
                                                    <p class="mb-0">"@feedback.Feedback"</p>
                                                </blockquote>
                                            </div>
                                            <div class="card-footer">
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-outline-primary">
                                                        <i class="fas fa-reply"></i> Respond
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary">
                                                        <i class="fas fa-share"></i> Share
                                                    </button>
                                                    <button type="button" class="btn btn-outline-info">
                                                        <i class="fas fa-flag"></i> Follow Up
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Culture Radar Chart
        const radarCtx = document.getElementById('cultureRadarChart').getContext('2d');
        new Chart(radarCtx, {
            type: 'radar',
            data: {
                labels: [
                    'Leadership Commitment',
                    'Employee Engagement', 
                    'Communication',
                    'Reporting Culture',
                    'Learning Culture',
                    'Trust & Respect'
                ],
                datasets: [{
                    label: 'Current Score',
                    data: [4.3, 4.1, 3.8, 4.2, 3.9, 4.0],
                    backgroundColor: 'rgba(13, 110, 253, 0.2)',
                    borderColor: '#0d6efd',
                    borderWidth: 2
                }, {
                    label: 'Target Score',
                    data: [4.5, 4.5, 4.2, 4.5, 4.3, 4.4],
                    backgroundColor: 'rgba(25, 135, 84, 0.1)',
                    borderColor: '#198754',
                    borderWidth: 1,
                    borderDash: [5, 5]
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom' }
                },
                scales: {
                    r: {
                        beginAtZero: true,
                        max: 5,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    </script>
}

