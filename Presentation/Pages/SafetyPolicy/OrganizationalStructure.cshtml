@page
@model PDXSMS_Presentation.Pages.SafetyPolicy.OrganizationalStructureModel
@{
    ViewData["Title"] = "SMS Organizational Structure";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyPolicy">Safety Policy</a></li>
                    <li class="breadcrumb-item active">Organizational Structure</li>
                </ol>
            </nav>
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="card-title"><i class="fas fa-sitemap"></i> SMS Organizational Structure</h4>
                            @* <p class="card-text">PDX SMS organizational hierarchy, roles, responsibilities, and committees</p> *@
                        </div>
                        <div class="col-md-4 text-end">
                            <button type="button" class="btn btn-outline-light" data-bs-toggle="modal" data-bs-target="#organizationGuidanceModal">
                                <i class="fas fa-question-circle"></i> Guidance
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Organization Metrics -->
    @* <div class="row mb-8">
        <div class="col-md-2">
            <div class="card border-primary">
                <div class="card-body text-center">
                    <div class="h4 text-primary">@Model.Metrics.TotalSMSRoles</div>
                    <small>SMS Roles</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-success">
                <div class="card-body text-center">
                    <div class="h4 text-success">@Model.Metrics.FilledPositions</div>
                    <small>Filled Positions</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-warning">
                <div class="card-body text-center">
                    <div class="h4 text-warning">@Model.Metrics.VacantPositions</div>
                    <small>Vacant Positions</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-info">
                <div class="card-body text-center">
                    <div class="h4 text-info">@Model.Metrics.ActiveTeams</div>
                    <small>Active Committees</small>
                </div>
            </div>
        </div>
    </div> *@

    <!-- Assignment Status Alert -->
    @if (Model.Metrics.VacantPositions > 0)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-warning">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Assignment Required:</strong> @Model.Metrics.VacantPositions SMS roles need to be filled to ensure complete organizational coverage.
                        </div>
                        <div class="col-md-4 text-end">
                            <a href="/SafetyPolicy/ResponsibilitiesAndAccountability" class="btn btn-warning">
                                <i class="fas fa-user-plus"></i> Manage Assignments
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Organizational Chart -->
    <div class="row mb-4">
        <div class="col-10">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-sitemap"></i> PDX SMS Organizational Chart</h5>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-light" onclick="expandAllRoles()">
                                <i class="fas fa-expand-arrows-alt"></i> Expand All
                            </button>
                            <button type="button" class="btn btn-outline-light" onclick="collapseAllRoles()">
                                <i class="fas fa-compress-arrows-alt"></i> Collapse All
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Interactive Organizational Chart -->
                    <div id="organizationalChart" class="org-chart">
                        @{
                            ViewBag.AllRoles = Model.OrganizationalRoles;
                            var assignedRoles = Model.OrganizationalRoles.Where(r => r.AssignedUsersCount > 0).OrderBy(r => r.HierarchyLevel).ToList();
                        }
                        
                        @if (assignedRoles.Any())
                        {
                            <div class="alert alert-success mb-3">
                                <i class="fas fa-users"></i> <strong>Active SMS Organization</strong> - Showing only roles with current assignments
                            </div>
                            
                            @foreach (var role in assignedRoles)
                            {
                                @await Html.PartialAsync("_OrganizationalRoleCard", role)
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <i class="fas fa-exclamation-triangle"></i>
                                        <strong>No Active Assignments:</strong> No SMS roles currently have assigned personnel. The organizational chart will appear as roles are filled.
                                    </div>
                                    <div class="col-md-4 text-end">
                                        <a href="/SafetyPolicy/ResponsibilitiesAndAccountability" class="btn btn-warning">
                                            <i class="fas fa-user-plus"></i> Assign Personnel
                                        </a>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="card border-info">
                                <div class="card-header bg-info text-white">
                                    <h6 class="mb-0"><i class="fas fa-info-circle"></i> Available SMS Roles (Not Yet Assigned)</h6>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        @foreach (var role in Model.OrganizationalRoles.OrderBy(r => r.HierarchyLevel))
                                        {
                                            <div class="col-md-6 col-lg-4 mb-2">
                                                <div class="card border-secondary h-100">
                                                    <div class="card-body p-2 text-center">
                                                        <div class="small text-muted">Level @role.HierarchyLevel</div>
                                                        <div class="fw-bold">@role.Title</div>
                                                        <span class="badge bg-warning">Vacant</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="text-center mt-3">
                                        <a href="/SafetyPolicy/ResponsibilitiesAndAccountability" class="btn btn-primary">
                                            <i class="fas fa-user-plus"></i> Start Making Assignments
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Roles and Responsibilities Details -->
    <div class="row mb-4">
        <div class="col-10">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-users"></i> SMS Roles and Responsibilities</h5>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-light active" id="showAssignedBtn" onclick="showAssignedRoles()">
                                <i class="fas fa-user-check"></i> Assigned Only (@Model.OrganizationalRoles.Count(r => r.AssignedUsersCount > 0))
                            </button>
                            <button type="button" class="btn btn-outline-light" id="showAllBtn" onclick="showAllRoles()">
                                <i class="fas fa-list"></i> All Roles (@Model.OrganizationalRoles.Count)
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="assignedRolesContainer">
                        @{
                            var assignedRolesDetail = Model.OrganizationalRoles.Where(r => r.AssignedUsersCount > 0).OrderBy(r => r.HierarchyLevel).ToList();
                        }
                        
                        @if (assignedRolesDetail.Any())
                        {
                            <div class="alert alert-success mb-3">
                                <i class="fas fa-check-circle"></i> <strong>Active SMS Personnel:</strong> The following roles are currently staffed and operational.
                            </div>
                            
                            @foreach (var role in assignedRolesDetail)
                            {
                                <div class="role-detail mb-4" id="role-@role.HierarchyLevel">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="card border-success h-100">
                                                <div class="card-header bg-success text-white">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <h6 class="mb-0">@role.Title</h6>
                                                        <span class="badge bg-light text-success">
                                                            <i class="fas fa-user-check"></i> @role.AssignedUsersCount assigned
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="card-body">
                                                    <p class="mb-2"><strong>Assignment Status:</strong><br>
                                                        <span class="text-success">
                                                            <i class="fas fa-check-circle"></i> Role Staffed (@role.AssignedUsersCount users)
                                                        </span>
                                                    </p>
                                                    <p class="mb-2"><strong>Hierarchy Level:</strong> @role.HierarchyLevel</p>
                                                    
                                                    <div class="d-grid gap-2 mt-3">
                                                        <a href="/SafetyPolicy/ResponsibilitiesAndAccountability" class="btn btn-outline-success btn-sm">
                                                            <i class="fas fa-user-cog"></i> View Assignments
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-8">
                                            <div class="card h-100">
                                                <div class="card-body">
                                                    <h6 class="text-primary">Responsibility</h6>
                                                    <p class="mb-3">@role.Description</p>
                                                    
                                                    <h6 class="text-success">Key Duties</h6>
                                                    <ul class="mb-0">
                                                        @foreach (var duty in role.KeyResponsibilities)
                                                        {
                                                            <li>@duty</li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @if (role != assignedRolesDetail.Last())
                                {
                                    <hr>
                                }
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning text-center">
                                <i class="fas fa-exclamation-triangle fa-2x mb-2"></i>
                                <h5>No SMS Roles Currently Staffed</h5>
                                <p>Personnel assignments are needed to activate the SMS organizational structure. Start by assigning key personnel to critical roles.</p>
                                <a href="/SafetyPolicy/ResponsibilitiesAndAccountability" class="btn btn-warning">
                                    <i class="fas fa-user-plus"></i> Make First Assignment
                                </a>
                            </div>
                        }
                    </div>
                    
                    <div id="allRolesContainer" style="display: none;">
                        @foreach (var role in Model.OrganizationalRoles.OrderBy(r => r.HierarchyLevel))
                        {
                            <div class="role-detail mb-4" id="all-role-@role.HierarchyLevel">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="card border-@(role.AssignedUsersCount > 0 ? "success" : "warning") h-100">
                                            <div class="card-header bg-@(role.AssignedUsersCount > 0 ? "success" : "warning") text-white">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <h6 class="mb-0">@role.Title</h6>
                                                    <span class="badge bg-@(role.AssignedUsersCount > 0 ? "light text-success" : "light text-warning")">
                                                        @if (role.AssignedUsersCount > 0)
                                                        {
                                                            <text><i class="fas fa-user-check"></i> @role.AssignedUsersCount assigned</text>
                                                        }
                                                        else
                                                        {
                                                            <text><i class="fas fa-exclamation-triangle"></i> Vacant</text>
                                                        }
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                @if (role.AssignedUsersCount > 0)
                                                {
                                                    <p class="mb-2"><strong>Assignment Status:</strong><br>
                                                        <span class="text-success">
                                                            <i class="fas fa-check-circle"></i> Role Staffed (@role.AssignedUsersCount users)
                                                        </span>
                                                    </p>
                                                }
                                                else
                                                {
                                                    <p class="mb-2"><strong>Assignment Status:</strong><br>
                                                        <span class="text-warning">
                                                            <i class="fas fa-exclamation-triangle"></i> Position Vacant
                                                        </span>
                                                    </p>
                                                }
                                                <p class="mb-2"><strong>Hierarchy Level:</strong> @role.HierarchyLevel</p>
                                                
                                                <div class="d-grid gap-2 mt-3">
                                                    <a href="/SafetyPolicy/ResponsibilitiesAndAccountability" class="btn btn-outline-@(role.AssignedUsersCount > 0 ? "success" : "warning") btn-sm">
                                                        <i class="fas fa-user-cog"></i> @(role.AssignedUsersCount > 0 ? "View Assignments" : "Assign Personnel")
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="card h-100">
                                            <div class="card-body">
                                                <h6 class="text-primary">Responsibility</h6>
                                                <p class="mb-3">@role.Description</p>
                                                
                                                <h6 class="text-success">Key Duties</h6>
                                                <ul class="mb-0">
                                                    @foreach (var duty in role.KeyResponsibilities)
                                                    {
                                                        <li>@duty</li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @if (role != Model.OrganizationalRoles.Last())
                            {
                                <hr>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SMS Committees and Teams -->
    <div class="row mb-4">
        <div class="col-10">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="fas fa-users-cog"></i> SMS Committees and Teams</h5>
                </div>
                <div class="card-body">
                    @foreach (var committee in Model.Committees)
                    {
                        <div class="committee-detail mb-4">
                            <div class="card border-warning">
                                <div class="card-header bg-light">
                                    <div class="row align-items-center">
                                        <div class="col-md-8">
                                            <h6 class="mb-0 text-warning">@committee.Name</h6>
                                            <small class="text-muted">
                                                Facilitator: @committee.Facilitator | Cadence: @committee.MeetingCadence
                                            </small>
                                        </div>
                                        <div class="col-md-4 text-end">
                                            @if (committee.NextMeetingDate.HasValue)
                                            {
                                                <span class="badge bg-info">Next: @committee.NextMeetingDate.Value.ToString("MMM dd, yyyy")</span>
                                            }
                                            <div class="mt-1">
                                                <span class="badge bg-@(committee.ActiveMembersCount > 0 ? "success" : "warning")">
                                                    @committee.ActiveMembersCount members
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <h6 class="text-primary">Purpose</h6>
                                            <p class="mb-3">@committee.Purpose</p>
                                        </div>
                                        <div class="col-md-4">
                                            <h6 class="text-success">Membership Status</h6>
                                            @if (committee.ActiveMembersCount > 0)
                                            {
                                                <div class="alert alert-success p-2 mb-2">
                                                    <small>
                                                        <i class="fas fa-users"></i> @committee.ActiveMembersCount active members<br>
                                                        <i class="fas fa-vote-yea"></i> @committee.VotingMembersCount voting members
                                                    </small>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="alert alert-warning p-2 mb-2">
                                                    <small><i class="fas fa-exclamation-triangle"></i> No members assigned</small>
                                                </div>
                                            }
                                            
                                            <div class="d-grid">
                                                <a href="/SafetyPolicy/ResponsibilitiesAndAccountability" class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-user-plus"></i> Manage Members
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    @if (committee.LastMeetingDate.HasValue)
                                    {
                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <div class="alert alert-light p-2">
                                                    <small><strong>Last Meeting:</strong> @committee.LastMeetingDate.Value.ToString("MMMM dd, yyyy")</small>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Documentation & Records -->
    <div class="row">
        <div class="col-10">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-folder"></i> Documentation & Records</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <h6>Meeting Documentation Requirements</h6>
                            <ul class="mb-3">
                                <li>All SMS meetings documented via minutes or action logs</li>
                                <li>Records include: attendees, topics, decisions, action items, and risk assessments</li>
                                <li>Committee minutes reviewed by chair/facilitator</li>
                                <li>Records retained per federal/state retention policies</li>
                            </ul>
                        </div>
                        <div class="col-md-4">
                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-outline-success">
                                    <i class="fas fa-calendar"></i> Committee Schedules
                                </button>
                                <button type="button" class="btn btn-outline-info">
                                    <i class="fas fa-file-alt"></i> Meeting Minutes
                                </button>
                                <button type="button" class="btn btn-outline-primary">
                                    <i class="fas fa-tasks"></i> Action Items
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="alert alert-info mt-3">
                        <div class="row">
                            <div class="col-md-6">
                                <strong><i class="fas fa-calendar-check"></i> Last Structure Review:</strong><br>
                                @Model.Metrics.LastStructureUpdate.ToString("MMMM dd, yyyy")
                            </div>
                            <div class="col-md-6">
                                <strong><i class="fas fa-calendar-plus"></i> Next Structure Review:</strong><br>
                                @Model.Metrics.LastStructureUpdate.AddYears(1).ToString("MMMM dd, yyyy")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Organization Guidance Modal -->
<div class="modal fade" id="organizationGuidanceModal" tabindex="-1" aria-labelledby="organizationGuidanceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="organizationGuidanceModalLabel">
                    <i class="fas fa-sitemap"></i> SMS Organizational Structure Guide
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-primary">
                    <i class="fas fa-info-circle"></i>
                    <strong>14 CFR Part 139 Compliance:</strong> This organizational structure ensures compliance with Subpart E requirements for SMS implementation at Part 139 airports.
                </div>
                
                <h6><i class="fas fa-layer-group"></i> Organizational Hierarchy</h6>
                <p>The SMS organization follows a clear hierarchy with defined reporting relationships and accountability levels:</p>
                <ul>
                    <li><strong>Level 1:</strong> Accountable Executive - Ultimate accountability</li>
                    <li><strong>Level 2:</strong> Responsible Executive - Strategic oversight</li>
                    <li><strong>Level 3:</strong> Responsible Manager - Operational management</li>
                    <li><strong>Level 4:</strong> SMS Manager - Day-to-day SMS operations</li>
                    <li><strong>Level 5:</strong> SMS Coordinator - Support and coordination</li>
                    <li><strong>Level 6:</strong> SMS Team - Cross-functional expertise</li>
                </ul>
                
                <h6><i class="fas fa-users-cog"></i> Committee Structure</h6>
                <p>Three key committees support SMS implementation:</p>
                <ul>
                    <li><strong>Rapid Review Team:</strong> Biweekly hazard triage and preliminary assessments</li>
                    <li><strong>Airside Safety Committee:</strong> Monthly operational coordination</li>
                    <li><strong>Executive Committee:</strong> Annual strategic oversight</li>
                </ul>
                
                <h6><i class="fas fa-clipboard-check"></i> Key Responsibilities</h6>
                <p>Each role has specific responsibilities aligned with SMS requirements and organizational needs. External stakeholders participate through committees and operational interfaces.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Close Guide
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Organizational chart interaction
        function expandAllRoles() {
            document.querySelectorAll('.role-card').forEach(card => {
                card.classList.add('expanded');
            });
        }

        function collapseAllRoles() {
            document.querySelectorAll('.role-card').forEach(card => {
                card.classList.remove('expanded');
            });
        }

        // Toggle between assigned roles only and all roles
        function showAssignedRoles() {
            document.getElementById('assignedRolesContainer').style.display = 'block';
            document.getElementById('allRolesContainer').style.display = 'none';
            document.getElementById('showAssignedBtn').classList.add('active');
            document.getElementById('showAllBtn').classList.remove('active');
        }

        function showAllRoles() {
            document.getElementById('assignedRolesContainer').style.display = 'none';
            document.getElementById('allRolesContainer').style.display = 'block';
            document.getElementById('showAssignedBtn').classList.remove('active');
            document.getElementById('showAllBtn').classList.add('active');
        }

        // Smooth scrolling to role details
        function scrollToRole(level) {
            const element = document.getElementById(`role-${level}`) || document.getElementById(`all-role-${level}`);
            if (element) {
                element.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        // Initialize tooltips and interactive elements
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize tooltips if Bootstrap is available
            if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });
            }

            // Check if we have any assigned roles to show different default view
            const assignedContainer = document.getElementById('assignedRolesContainer');
            const assignedRoles = assignedContainer.querySelector('.alert-success');
            
            // If no assigned roles, automatically show all roles view
            if (!assignedRoles) {
                showAllRoles();
            }
        });
    </script>
}

<style>
/* Organizational Chart Styling */
.org-chart {
    padding: 20px;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    border-radius: 10px;
    min-height: 400px;
}

.role-card {
    transition: all 0.3s ease;
    cursor: pointer;
    margin-bottom: 15px;
}

.role-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.role-detail {
    scroll-margin-top: 100px;
}

/* Committee styling */
.committee-detail {
    transition: all 0.3s ease;
}

.committee-detail:hover {
    transform: translateX(5px);
}

/* Card hover effects */
.card:hover {
    transition: transform 0.2s ease-in-out;
}

.border-primary:hover {
    box-shadow: 0 0 15px rgba(0, 123, 255, 0.3);
}

.border-success:hover {
    box-shadow: 0 0 15px rgba(40, 167, 69, 0.3);
}

.border-warning:hover {
    box-shadow: 0 0 15px rgba(255, 193, 7, 0.3);
}

.border-info:hover {
    box-shadow: 0 0 15px rgba(23, 162, 184, 0.3);
}
</style>