            <!-- SMS Teams Tab -->
            <div class="tab-pane fade" id="sms-teams" role="tabpanel">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="fas fa-users-cog"></i> SMS Teams Management</h5>
                            <button type="button" class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#createSMSTeamModal">
