                                    <th>Type</th>
                                    <th>Members</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var team in Model.AllGroups.Where(g => g.Type == "SMSTeam"))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@team.Name</div>
                                            <small class="text-muted">Created: @team.CreatedDate.ToString("yyyy-MM-dd")</small>
                                        </td>
                                        <td>@team.Description</td>
                                        <td><span class="badge bg-primary">@team.Category</span></td>
                                        <td>@team.MemberCount</td>
                                        <td>
                                            @if (team.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" onclick="editSMSTeam('@team.Id', '@team.Name')" title="Edit Team">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn btn-outline-info" onclick="manageSMSTeamMembers('@team.Id', '@team.Name')" title="Manage Members">
                                                    <i class="fas fa-users"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" onclick="deleteSMSTeam('@team.Id', '@team.Name')" title="Delete Team">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["SuccessMessage"] != null)
