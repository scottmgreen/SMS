@page
@model PDXSMS_Presentation.Pages.SafetyPolicy.ResponsibilitiesAndAccountabilityModel
@{
    ViewData["Title"] = "SMS Organizational Management";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/SafetyPolicy">Safety Policy</a></li>
                    <li class="breadcrumb-item active">SMS Organizational Management</li>
                </ol>
            </nav>
            <div class="card bg-gradient-success text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="card-title">🎯 SMS Organizational Management</h4>
                            <p class="card-text">Manage SMS Organizational Users, Stakeholder Users, Teams, and Group assignments for safety management operations</p>
                            <small><i class="fas fa-info-circle"></i> Note: Application Users are managed under System → User Management</small>
                        </div>
                        <div class="col-md-4 text-end">
                            <button type="button" class="btn btn-outline-light" onclick="loadUserStats()">
                                <i class="fas fa-sync-alt"></i> Refresh Stats
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Dashboard -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body text-center">
                    <div class="h3 text-success">@Model.Stats.TotalSMSUsers</div>
                    <small>SMS Users</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body text-center">
                    <div class="h3 text-info">@Model.Stats.TotalStakeholderUsers</div>
                    <small>Stakeholder Users</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-dark">
                <div class="card-body text-center">
                    <div class="h3 text-dark">@Model.Stats.SMSTeams</div>
                    <small>SMS Teams</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-secondary">
                <div class="card-body text-center">
                    <div class="h3 text-secondary">@Model.Stats.StakeholderGroups</div>
                    <small>Stakeholder Groups</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tab Navigation - Application Users removed, they're managed under System menu -->
    <ul class="nav nav-tabs" id="userManagementTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="sms-users-tab" data-bs-toggle="tab" data-bs-target="#sms-users" type="button" role="tab">
                <i class="fas fa-user-tie"></i> SMS Users (@Model.Stats.TotalSMSUsers)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="stakeholder-users-tab" data-bs-toggle="tab" data-bs-target="#stakeholder-users" type="button" role="tab">
                <i class="fas fa-handshake"></i> Stakeholder Users (@Model.Stats.TotalStakeholderUsers)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="sms-teams-tab" data-bs-toggle="tab" data-bs-target="#sms-teams" type="button" role="tab">
                <i class="fas fa-users-cog"></i> SMS Teams (@Model.Stats.SMSTeams)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="stakeholder-groups-tab" data-bs-toggle="tab" data-bs-target="#stakeholder-groups" type="button" role="tab">
                <i class="fas fa-layer-group"></i> Stakeholder Groups (@Model.Stats.StakeholderGroups)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="debug-tab" data-bs-toggle="tab" data-bs-target="#debug" type="button" role="tab">
                <i class="fas fa-bug"></i> Debug & Export
            </button>
        </li>
    </ul>

    <div class="tab-content" id="userManagementTabContent">
        <!-- SMS Users Tab -->
        <div class="tab-pane fade show active" id="sms-users" role="tabpanel">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-user-tie"></i> SMS Organizational Users Management</h5>
                        <button type="button" class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#createSMSUserModal">
                            <i class="fas fa-plus"></i> Add SMS User
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Employee ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Department</th>
                                    <th>SMS Teams</th>
                                    <th>Employee Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.SMSUsers)
                                {
                                    <tr>
                                        <td>@user.EmployeeId</td>
                                        <td>
                                            <div class="fw-bold">@user.DisplayName</div>
                                            <small class="text-muted">@user.JobTitle</small>
                                        </td>
                                        <td>@user.Email</td>
                                        <td>@user.Department</td>
                                        <td>
                                            @if (user.SMSTeamMemberships.Any())
                                            {
                                                @foreach (var team in user.SMSTeamMemberships)
                                                {
                                                    <span class="badge bg-success me-1">@team</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">No teams</span>
                                            }
                                        </td>
                                        <td>
                                            @if (user.IsEmployee && user.EmploymentStatus == "Active")
                                            {
                                                <span class="badge bg-success">Active Employee</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">@user.EmploymentStatus</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" onclick="openEditSMSUserModal('@user.Id', '@user.DisplayName', '@user.Email', '@user.Department', '@user.JobTitle', '@user.EmployeeId', '@user.Phone')" title="Edit SMS User">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn btn-outline-info" onclick="openManageSMSTeamsModal('@user.Id', '@user.DisplayName')" title="Manage Teams">
                                                    <i class="fas fa-users-cog"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" onclick="deleteSMSUser('@user.Id', '@user.DisplayName')" title="Delete SMS User">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stakeholder Users Tab -->
        <div class="tab-pane fade" id="stakeholder-users" role="tabpanel">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-handshake"></i> Stakeholder Users Management</h5>
                        <button type="button" class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#createStakeholderUserModal">
                            <i class="fas fa-plus"></i> Add Stakeholder User
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Organization</th>
                                    <th>Type</th>
                                    <th>Category</th>
                                    <th>Groups</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.StakeholderUsers)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@user.DisplayName</div>
                                            <small class="text-muted">@user.PreferredContactMethod</small>
                                        </td>
                                        <td>@user.Email</td>
                                        <td>@user.OrganizationName</td>
                                        <td><span class="badge bg-info">@user.StakeholderType</span></td>
                                        <td><span class="badge bg-@(user.StakeholderCategory == "Critical" ? "danger" : user.StakeholderCategory == "Important" ? "warning" : "secondary")">@user.StakeholderCategory</span></td>
                                        <td>
                                            @if (user.StakeholderGroups.Any())
                                            {
                                                @foreach (var group in user.StakeholderGroups)
                                                {
                                                    <span class="badge bg-info me-1">@group</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">No groups</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" onclick="openEditStakeholderUserModal('@user.Id', '@user.DisplayName', '@user.Email', '@user.OrganizationName', '@user.Phone', '@user.StakeholderType', '@user.StakeholderCategory', '@user.PreferredContactMethod')" title="Edit Stakeholder User">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn btn-outline-info" onclick="openManageStakeholderGroupsModal('@user.Id', '@user.DisplayName')" title="Manage Groups">
                                                    <i class="fas fa-layer-group"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" onclick="deleteStakeholderUser('@user.Id', '@user.DisplayName')" title="Delete Stakeholder User">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- SMS Teams Tab -->
        <div class="tab-pane fade" id="sms-teams" role="tabpanel">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-users-cog"></i> SMS Teams Management</h5>
                        <button type="button" class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#createSMSTeamModal">
