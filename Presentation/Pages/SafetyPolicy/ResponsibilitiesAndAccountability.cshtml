                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 🆕 NEW: Stakeholder Groups Tab -->
            <div class="tab-pane fade" id="stakeholder-groups" role="tabpanel">
                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="fas fa-layer-group"></i> Stakeholder Groups Management</h5>
                            <button type="button" class="btn btn-outline-dark btn-sm" data-bs-toggle="modal" data-bs-target="#createStakeholderGroupModal">
                                <i class="fas fa-plus"></i> Create Stakeholder Group
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            <strong>Stakeholder Groups:</strong> Organize external stakeholders by type and priority level. 
                            These groups are used in risk assessments to efficiently select relevant stakeholders for consultation and communication.
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Group Name</th>
                                        <th>Description</th>
                                        <th>Category</th>
                                        <th>Members</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var group in Model.AllGroups.Where(g => g.Type == "StakeholderGroup"))
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold">@group.Name</div>
                                                <small class="text-muted">Created: @group.CreatedDate.ToString("yyyy-MM-dd")</small>
                                            </td>
                                            <td>@group.Description</td>
                                            <td><span class="badge bg-@(group.Category == "Critical" ? "danger" : group.Category == "Important" ? "warning" : "secondary")">@group.Category</span></td>
                                            <td>
                                                <span class="fw-bold">@group.MemberCount</span>
                                                <small class="text-muted">stakeholder(s)</small>
                                            </td>
                                            <td>
                                                @if (group.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary" onclick="editStakeholderGroup('@group.Id', '@group.Name', '@group.Description', '@group.Category')" title="Edit Group">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-outline-info" onclick="viewStakeholderGroupMembers('@group.Id', '@group.Name')" title="View Members">
                                                        <i class="fas fa-users"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" onclick="deleteStakeholderGroup('@group.Id', '@group.Name')" title="Delete Group">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (!Model.AllGroups.Any(g => g.Type == "StakeholderGroup"))
                            {
                                <div class="text-center py-4">
                                    <i class="fas fa-layer-group fa-3x text-muted mb-3"></i>
                                    <h5 class="text-muted">No Stakeholder Groups</h5>
                                    <p class="text-muted">Create stakeholder groups to organize external stakeholders by type and priority.</p>
                                    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#createStakeholderGroupModal">
                                        <i class="fas fa-plus"></i> Create First Stakeholder Group
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Debug Tab -->
            <div class="tab-pane fade" id="debug" role="tabpanel">
                <div class="card">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0"><i class="fas fa-bug"></i> Debug & Export Tools</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6><i class="fas fa-download"></i> Export Data</h6>
                                <div class="d-grid gap-2">
                                    <a href="/api/users/sms" target="_blank" class="btn btn-outline-success">
                                        <i class="fas fa-user-tie"></i> Export SMS Users JSON
                                    </a>
                                    <a href="/api/users/stakeholders" target="_blank" class="btn btn-outline-info">
                                        <i class="fas fa-handshake"></i> Export Stakeholder Users JSON
                                    </a>
                                    <a href="/api/groups" target="_blank" class="btn btn-outline-warning">
                                        <i class="fas fa-sitemap"></i> Export Groups JSON
                                    </a>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6><i class="fas fa-chart-bar"></i> Real-time Statistics</h6>
                                <div id="liveStats" class="bg-light p-3 rounded">
                                    <div class="text-center">
