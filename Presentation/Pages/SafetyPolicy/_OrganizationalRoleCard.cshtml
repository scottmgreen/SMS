@model PDXSMS.UseCases.Queries.Organization.SMSOrganizationalRoleDto

<div class="role-card" data-level="@Model.HierarchyLevel">
    <div class="card border-primary mb-3" style="margin-left: @((Model.HierarchyLevel - 1) * 40)px;">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="mb-0">@Model.Title</h6>
                    <small class="opacity-75">Level @Model.HierarchyLevel</small>
                </div>
                <div>
                    @if (Model.AssignedUsersCount > 0)
                    {
                        <span class="badge bg-success">@Model.AssignedUsersCount Assigned</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">Vacant</span>
                    }
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <p class="mb-2"><strong>Description:</strong><br>@Model.Description</p>
                    @if (Model.AssignedUsersCount > 0)
                    {
                        <p class="mb-2 small text-success">
                            <i class="fas fa-check-circle"></i> Position filled with @Model.AssignedUsersCount users
                        </p>
                    }
                    else
                    {
                        <p class="mb-2 small text-warning">
                            <i class="fas fa-exclamation-triangle"></i> Position vacant - assignment needed
                        </p>
                    }
                </div>
                <div class="col-md-4 text-end">
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="scrollToRole(@Model.HierarchyLevel)">
                        <i class="fas fa-info-circle"></i> Details
                    </button>
                    <a href="/SafetyPolicy/ResponsibilitiesAndAccountability" class="btn btn-outline-success btn-sm mt-1">
                        <i class="fas fa-user-cog"></i> Manage
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Note: Child roles would be rendered here if we implement hierarchical display -->
</div>