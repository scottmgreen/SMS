@page "/registration"
@using CBT3_Application.Interfaces
@using CBT3_UI
@using CBT_UI.Components.Pages.Shared
@using Radzen.Blazor;
@using Radzen;

@using CBT3_Application.Messaging;
@using CBT3_Application.Messaging.Commands;
@using CBT3_Application.Messaging.Queries;
@using CBT3_Application.Services;

@using CBT3_Domain.Common;
@using CBT3_Domain.Entities;
@using CBT3_Domain.Errors;
@using CBT3_Domain.ValueObjects;
@using Microsoft.AspNetCore.Components.Forms;
@using Microsoft.AspNetCore.Components

@inject NavigationManager _navManager
@inject CBT3_App _cbtApp
@inject DialogService _dialogService
@inject IMediator mediator

@rendermode InteractiveServer
<style>
    body {
        /* background-color: #b1bed2; */
        background-image: url('/images/background_opening.jpg'); /* Specify the path to your image */
        background-size: cover; /* Adjusts the size of the background image to cover the entire body */
        background-repeat: no-repeat; /* Prevents the background image from repeating */
        background-attachment: fixed; /* Fixes the background image when scrolling */
    }
    .centered-container {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh; /* Adjust the height based on your requirement */
    }

    .keypad {
        display: flex;
    }

    .column {
        display: flex;
        flex-direction: column;
        margin: 0 10px; /* Adjust the margin based on your requirement */
    }

    .keybutton{
        width: 75px; /* Adjust the width based on your requirement */
        height: 75px; /* Adjust the height based on your requirement */
        margin: 10px; /* Adjust the margin based on your requirement */
        font-size: 18px;
        background-color: #006AA9 !important;
        color: #fff !important;
    }

    .checkboxNotifications {
        width: 40px !important;
        height: 40px !important;
        margin: 20px !important;
        font-size: 18px !important;
        font-weight: 400;
        /* background-color: #006AA9 !important; */
        color: #fff !important;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 50px; /* Adds space between checkbox and label */
    }

    .notification-option {
        display: flex;
        align-items: center;
        margin-bottom: 10px; /* Adds space between rows */
    }

    
    .keyboardRow {
        text-align: center
    }

    .key {
        display: inline-block;
        border: 1px solid red;
        padding: 10px;
        margin-bottom: 5px;
    }

    .backspace
    {
        width: 110px; /* Adjust the width based on your requirement */
        height: 75px; /* Adjust the height based on your requirement */
        margin: 10px; /* Adjust the margin based on your requirement */
        font-size: 18px;
        background-color: #006AA9 !important;
    }

    .submit {
        width: 110px; /* Adjust the width based on your requirement */
        height: 75px; /* Adjust the height based on your requirement */
        margin: 10px; /* Adjust the margin based on your requirement */
        font-size: 18px;
        color:white;
    }

    .custom-width {
        max-width: 40%; /* Adjust the width as per your requirement */
    }

      .bigger-input {
        width: 300px;
        height: 40px;
        font-size: 16px;
    }

    .btn-primary {
        background-color: #006AA9;
        outline: none; /* Remove the outline */
        box-shadow: none; /* Remove the box shadow */
    }

        .btn-primary:hover {
            background-color: #006AA9; /* Restore default background color on hover */
            border-color: #007bff; /* Restore default border color on hover */
            outline: none; /* Remove the outline */
            box-shadow: none; /* Remove the box shadow */
        }

    .btn-success {
        background-color: forestgreen;
        outline: none; /* Remove the outline */
        box-shadow: none; /* Remove the box shadow */
        color: white;
    }

        .btn-success:hover {
        background-color: forestgreen; /* Restore default background color on hover */
            border-color: #007bff; /* Restore default border color on hover */
            outline: none; /* Remove the outline */
            box-shadow: none; /* Remove the box shadow */
            color:white;
        }

    .heading-container {
        position: fixed;
        top: 20%;
        left: 50%;
        white-space: nowrap;
        transform: translate(-50%, -50%);
        text-align: center
    }
    radzenlabel{
        font-size: 18px;
        font-weight: 600
    }
    .radzenfieldset{
        /* margin: 220px auto; */
        background-color: rgba(28, 62, 98, 0.5);
    }

    .rz-steps-number{
        color:black;
    }

    .course-button-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px; /* Adjust the gap between buttons as needed */
        position: fixed;
        justify-content: center;
    }

    .course-button-grid button {
        margin: 5px; /* Add margin to create a gap around each button */
        width: 300px;
    }

    .course-button-container {
        display: inline-block;
        text-align: center;
        position: fixed;
        top: 10%;
        left: 50%;
        width: 950px;
        transform: translate(-50%, -50%);
    }

    .course-button-container RadzenButton {
            display: inline-block;
            margin-right: 10px; /* Optional: Add some space between the buttons */
        }

    .course-button-style {
        width: 320px; /* Adjusted width for a larger button */
        height: 120px; /* Adjusted height for a taller button */
        font-size: 18px; /* Adjust font size for larger text */
        background-color: #006AA9 !important;
        color: #ffffff !important;
    }

    .radzen-dialog {
        /* background-color: rgba(28, 62, 98, 0.5); */
        background-color: white;
        padding: 20px; /* Add padding as needed */

    }

    .rz-dialog-confirm-buttons > .rz-secondary {
        width: 220px;
        color: #ffffff !important;
        height: 60px;
        font-size: 18px;
        background-color: red !important;
    }

    .rz-dialog-confirm-buttons > .rz-primary {
        width: 220px;
        color: #ffffff !important;
        height: 60px;
        font-size: 18px;
        background-color: #006AA9 !important;
    }

    .rz-steps .rz-steps-item .rz-steps-number {display: none;}

    a.rz-steps-next {
        display: none;
    }

    a.rz-steps-prev {
        display: none;
    }

    .admin-button {
        /* opacity: 0; */
        position: fixed;
        font-size: 24px; /* Adjust button font size as needed */
        padding: 10px 20px; /* Adjust button padding as needed */
        border: none;
        pointer-events: auto
    }
    /* Button positions */
    .container .admin-button-top-left {
        top: 0;
        left: 0;
    }

    .container .admin-button-top-right {
        top: 0;
        right: 0;
    }

    .container .admin-button-bottom-left {
        bottom: 0;
        left: 0;
    }

    .container .admin-button-bottom-right {
        bottom: 0;
        right: 0;
    }

    .rz-dialog.rz-dialog-alert {
        width: 600px !important; /* Adjust as needed */
        max-width: 90vw; /* Prevents it from being too wide on smaller screens */
    }

    .rz-dialog.rz-dialog-confirm {
        width: 800px !important; /* Adjust as needed */
        max-width: 90vw; /* Prevents it from being too wide on smaller screens */
    }

    .rz-dialog-titlebar {
        
        justify-content: center; 
        display: flex; 
    }
    .info-grid {
        display: grid;
        grid-template-columns: 350px 200px; /* Fixed width for label (200px) and data (300px) */
        gap: 5px 15px; /* Adjusts spacing */
        width: 700px; /* Total fixed width */
        margin-top: 35px;
        font-weight: bold;
    }

    .label {
        text-align: right; /* Right-aligns the labels */
    }

    .data {
        text-align: left; /* Left-aligns the data */
    }

    .rz-chkbox-icon {
        font-weight: bold;
        transform: scale(1.7);
    }

    .rz-chkbox-box {
        width: 40px !important; /* Increase width */
        height: 40px !important; /* Increase height */
    }

    </style>



