@rendermode InteractiveServer
@using System.Text
@using Radzen
@inject Radzen.DialogService dialogService
@inject CBT3_Application.Services.SystemService _systemService

<style>
    .debug-button {
        font-size: 12px;
        background-color: #006AA9 !important;
        color: #ffffff !important;
        border: none; /* Remove any default borders */
        /*border-radius: 8px;  Add rounded corners */
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2); /* Create a raised shadow effect */
        transition: box-shadow 0.3s ease; /* Smooth transition for shadow on hover */
    }

    
    .rz-dialog.rz-dialog-alert {
        width: 700px !important; /* Adjust as needed */
        max-width: 90vw; /* Prevents it from being too wide on smaller screens */
    }

    .info-grid {
        display: grid;
        grid-template-columns: auto 1fr; /* Two columns: label (auto), data (flexible width) */
        gap: 5px 15px; /* Adjusts spacing */
        margin-top: 35px;
        font-weight: bold;
    }

    .label {
        text-align: right; /* Right-aligns the labels */
    }

    .data {
        text-align: left; /* Left-aligns the data */
    }
</style>


<script>
    function closeWindow() {
        window.close();
    }
</script>

    <div>
    @if (AppState.Trainee is not null)
    {
        <span style="font-size:12px;color:white">@AppState.Trainee.ToString()&nbsp;</span>
    }

    @if (_systemService.GetFeatureEnabledAsync("DebugEnabled").Result.Value)
    {
        <span style="font-size:12px;color:white">
            @if (AppState.Course is not null)
            {
                <RadzenButton class="debug-button" Text="Course Debug" Style="font-size: 12px; color: white;" Click="ShowDebug" />
            }
            else
            {

            }
        </span>
       
    }
    
    </div>
       





@code {
    [CascadingParameter]
    public CascadingAppState AppState { get; set; }
    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        //UpdateMessage(DateTime.Now.ToString(""));

        await base.OnInitializedAsync();
    }


    private async Task ShowDebug()
    {

        ConfirmOptions _confirmOptions = new ConfirmOptions() { OkButtonText = "OK", CancelButtonText = "No", ShowClose = false };
        string dialogMessage = $@"
        <div class='info-grid'>
            <div class='label'>Course:</div>
            <div class='data'>{AppState?.Course?.CourseName}</div>

            <div class='label'>Lesson:</div>
            <div class='data'>{AppState?.LessonPage?.LessonID.Value}</div>
            <div class='label'>LessonPage:</div>
            <div class='data'>{AppState?.LessonPage?.Id.Value}</div>
            <div class='label'>LessonPageType:</div>
            <div class='data'>{AppState?.LessonPage?.LessonPageType.Value}</div>
            <div class='label'>LessonPageSubType:</div>
            <div class='data'>{AppState?.LessonPage?.LessonPageSubType}</div>
            <br>
        </div>";

        var dialog = await dialogService.Alert("", dialogMessage, _confirmOptions);
    }
          
        
}