@page "/courseplayer/{traineeId}/{courseId}"

@using CBT3_Application.Interfaces
@using CBT3_Application.Messaging.Commands
@using CBT3_Domain.Common
@using CBT3_Domain.Enums
@using CBT3_Domain.Entities
@using CBT3_Domain.Events
@using CBT3_Domain.Events.DomainEvents
@using CBT3_Domain.Events.SystemEvents
@using CBT3_Domain.Interfaces

@using CBT3_Application.Services
@using CBT3_UI
@using CBT_UI.Components.Pages.Shared
@using Radzen
@using Blazored.Video
@using Blazored.Video.Support

@rendermode InteractiveServer

@inject DialogService _dialogService
@inject NavigationManager _navManager
@inject IMediator _mediator
@inject IMessenger _messenger
@inject CourseMachine _courseMachine;
@inject TrainingService _trainingService;
@inject CBT3_App _cbtApp

<style>

    body {
        background-image: url('/images/background_opening.jpg'); /* Specify the path to your image */
        background-size: cover; /* Adjusts the size of the background image to cover the entire body */
        background-repeat: no-repeat; /* Prevents the background image from repeating */
        background-attachment: fixed; /* Fixes the background image when scrolling */
        
    }

    .button-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px; /* Adjust the gap between buttons as needed */
        position: fixed;
        justify-content: center;
    }



    .button-style {
        width: 320px; /* Adjusted width for a larger button */
        height: 120px; /* Adjusted height for a taller button */
        font-size: 18px; /* Adjust font size for larger text */
        background-color: #006AA9 !important;
        color: #ffffff !important;
    }



    /* .custom-radzen-button {
        background-color: #006AA9 !important;
        width: 220px;
        color: #ffffff !important;
        height: 60px;
        font-size: 18px;
    } */
    .cbt-button {
        width: 320px; /* Adjusted width for a larger button */
        height: 120px; /* Adjusted height for a taller button */
        font-size: 18px; /* Adjust font size for larger text */
        background-color: #006AA9 !important;
        color: #ffffff !important;
        border: none; /* Remove any default borders */
        /*border-radius: 8px;  Add rounded corners */
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2); /* Create a raised shadow effect */
        transition: box-shadow 0.3s ease; /* Smooth transition for shadow on hover */
    }

        .cbt-button:hover {
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3); /* Increase shadow on hover for an elevated effect */
        }

    .buttons-container {
        display: inline-block;
        text-align: center;
        position: fixed;
        top: 80%;
        left: 50%;
        width: 900px;
        transform: translate(-50%, -50%);
    }

    .video-container {
        background-color: black;
        font-size: 18px;
        display: inline-block;
        text-align: center;
        position: fixed;
        top: 50%;
        left: 50%;
        width: 1200px;
        transform: translate(-50%, -50%);
    }

    .heading-container {
        opacity:.95;
        background-color: transparent; /* Sets the background color to white */
        font-size: 60px; /* Sets the font size to 60 pixels */
        /* text-transform: uppercase; */ /* Uncomment this line if you want to transform text to uppercase */
        display: inline-block; /* Displays the container as an inline block */
        text-align: center; /* Aligns the text content to the center */
        position: fixed; /* Sets the position to fixed */
        top: 25%; /* Positions the container 50% from the top of the viewport */
        left: 50%; /* Positions the container 50% from the left of the viewport */
        width: 1550px; /* Sets the width of the container to 1550 pixels */
        /* height: 200px; */ /* Uncomment this line if you want to set a specific height for the container */
        transform: translate(-50%, -50%); /* Translates the container -50% of its own width and height */
    }

   /*  .button-container RadzenButton {
        display: inline-block;
        margin-right: 10px;
        top: 50%;
        left: 50%;
            }
    */
    

    .center-container {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        margin: 0;
    }

    .course-container {
        display: inline-block;
        /* display: inline-block; */
        height: 200px;
        width: 500px;
        background-color: black;
        color: yellow;
        max-height: 500px; /* Adjust the max height as needed */
        overflow-y: auto;
        padding: 10px;
        /* left: 50%; */
    }

       
    .radzen-dialog {
        /* background-color: rgba(28, 62, 98, 0.5); */
        /* background-color: white; */
        background-color: transparent;
        padding: 20px; /* Add padding as needed */
    }

    .admin-dialog {
        /* background-color: rgba(28, 62, 98, 0.5); */
        background-color: black;
        /*background-color: white;*/
        padding: 20px; /* Add padding as needed */
    }

    .image-container {
        opacity: .95;
        background-color: transparent; /* Sets the background color to white */
        font-size: 60px; /* Sets the font size to 60 pixels */
        /* text-transform: uppercase; */ /* Uncomment this line if you want to transform text to uppercase */
        display: inline-block; /* Displays the container as an inline block */
        text-align: center; /* Aligns the text content to the center */
        position: fixed; /* Sets the position to fixed */
        top: 55%; /* Positions the container 50% from the top of the viewport */
        left: 50%; /* Positions the container 50% from the left of the viewport */
        width: 1550px; /* Sets the width of the container to 1550 pixels */
        /* height: 200px; */ /* Uncomment this line if you want to set a specific height for the container */
        transform: translate(-50%, -50%); /* Translates the container -50% of its own width and height */
    }

    .centered-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        width: 100vw;
        position: absolute;
        top: 0;
        left: 0;
    }
</style>

<div class="centered-container">
    <RadzenProgressBarCircular Style="@_spinner" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
</div>

<div class="buttons-container">
    
    <div style="@_startButton">
        <RadzenButton class="btn button cbt-button" Style="@_startButton" Click="CourseMachineStart" Text="START" />
    </div>
    <div style="@_continueButton">
        <RadzenButton class="btn button cbt-button" Style="@_continueButton" Click="ContinueClick" Text="CONTINUE" />
    </div>
    <div style="@_customerserviceButton">
        <RadzenButton class="btn button cbt-button" Style="@_customerserviceButton" Click="CustomerServiceClick" Text="CONTINUE" />
    </div>
    <div style="@_exitsystem_exitcourseButtons; justify-content:center;">
        <RadzenButton class="btn button cbt-button" Style="" Click="NavigateToSplash" Text="EXIT SYSTEM" />&nbsp;&nbsp;&nbsp;&nbsp;
        <RadzenButton class="btn button cbt-button" Style="" Click="NavigateToCourseSelection" Text="EXIT COURSE" />
    </div>
</div>
   
@if (_imageFileName != string.Empty)
{
    <div class="image-container"><RadzenImage Path="@_imageFileName" Style="max-width: 50%; height: auto;" /></div>
}


<div class="heading-container" style="@_lessonPage">
   
    <span>@_lessonPageText</span>
</div>




@code {
    [CascadingParameter]
    public CascadingAppState AppState { get; set; }


    
}

