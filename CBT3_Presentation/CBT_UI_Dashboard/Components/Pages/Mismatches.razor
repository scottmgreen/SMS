@page "/mismatches"
@using CBT3_Application.Interfaces
@using CBT3_Application.Messaging.Queries
@using CBT3_Domain.Common
@using CBT3_Domain.Entities
@using Radzen
@using Radzen.Blazor
@inject CBT3_Application.Services.DashboardService _dashboardService
@inject IMediator _mediator

<h3>Mismatches</h3>
<RadzenDataGrid Data="@mistmatches" AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false"
                FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="5" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or"
                SelectionMode="DataGridSelectionMode.Single" >

    <Columns>
        <RadzenDataGridColumn Property="UPID" Title="UPID" Width="100px" />
        <RadzenDataGridColumn Property="DYOB" Title="YOB" Width="100px" />
        <RadzenDataGridColumn Property="FirstName" Title="First Name" Frozen="true" Width="160px" />
        <RadzenDataGridColumn Property="LastName" Title="Last Name" Width="160px" />
        <RadzenDataGridColumn Property="CourseCode" Title="Course" Width="160px" />
        <RadzenDataGridColumn Property="CourseStartDate" Title="Started At" FormatString="{0:G}" Width="160px" />
        <RadzenDataGridColumn Property="CourseEndDate" Title="Ended At" FormatString="{0:G}" Width="160px" />
        <!-- Actions Column -->
        <RadzenDataGridColumn Title="Actions" Width="150px">
            <Template Context="data">
                <!-- Edit Icon -->
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click=@(args=> EditRecord(data))/>
                <!-- Delete Icon -->
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(args => DeleteRecord(data))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    TrainingRecord? selectedRecord;
    List<TrainingRecord> mistmatches = new();
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // Get the data asynchronously
        GetMismatchedTrainingRecordsQuery query = new();
        Result<List<TrainingRecord>> mistmatches_result = await _mediator.SendAsync(query, default);

        // Check for success and assign to the list
        if (mistmatches_result.IsSuccess && mistmatches_result.Value != null)
        {
            mistmatches = mistmatches_result.Value;
        }

        

    }

    private void EditRecord(TrainingRecord record)
    {
        // This method should contain the logic for editing the record.
        // Example: Navigate to an edit page or open a modal for editing the record.
        Console.WriteLine($"Edit record with UPID: {record.UPID}");

        // Example: You could use a modal or navigate to a new page for editing
        // Navigate to an edit page, for example:
        // NavigationManager.NavigateTo($"/edit/{record.UPID}");
    }
    private async Task DeleteRecord(TrainingRecord record)
    {
        // This method should contain the logic for deleting the record.
        // Example: Show a confirmation dialog before performing the delete.
        Console.WriteLine($"Delete record with UPID: {record.UPID}");

        // Example: Ask for confirmation before deleting
        bool isConfirmed = await ShowConfirmationDialog("Are you sure you want to delete this record?");
        if (isConfirmed)
        {
            // Perform deletion logic here, like calling a service to delete the record
            Console.WriteLine($"Record with UPID: {record.UPID} deleted.");

            // Optionally, update the data source by removing the record
            mistmatches.Remove(record);
            StateHasChanged(); // Refresh the UI after removal
        }
    }

    // Example confirmation dialog
    private Task<bool> ShowConfirmationDialog(string message)
    {
        // You can implement a confirmation dialog here. For now, we will just return true (confirm).
        return Task.FromResult(true);
    }
}
