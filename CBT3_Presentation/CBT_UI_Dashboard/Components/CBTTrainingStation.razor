@using CBT3_Domain.Entities
@using CBT3_Domain.Enums
@using Radzen
@using Radzen.Blazor
@inject DialogService _DialogService

<div @onclick="HandleClick">
    <i class="fa-solid fa-desktop pc-icon"></i>&nbsp;&nbsp;
    <div style="font-weight: bold;width:50px;">@HostName</div>
    @* <div>@Status ?? "N/A"</div> *@
    @* <div>@SessionID?.Value ?? "N/A"</div>
    <div>@TraineeID?.Value ?? "N/A"</div>
    <div>@CourseID?.Value ?? "N/A"</div>
    <div>@CourseStartedAt?.ToString("G") ?? "Not Started"</div>
    <div>@CourseEndedAt?.ToString("G") ?? "Not Ended"</div> *@
    
</div>

@code {
    
    [Parameter] public string? HostName { get; set; }
    [Parameter] public string? Status { get; set; }
    [Parameter] public string? SessionID { get; set; }
    [Parameter] public string? TraineeID { get; set; }
    [Parameter] public string? CourseID { get; set; }
    [Parameter] public string? CourseStartedAt { get; set; }
    [Parameter] public string? CourseEndedAt { get; set; }

    [Parameter] public EventCallback<string> OnClick { get; set; }
    

    private async  void HandleClick()
    {
        await OnClick.InvokeAsync(HostName);
        await ShowCloseableFromOverlayDialog(HostName);
    }

   
    async Task ShowCloseableFromOverlayDialog(string station)
    {
        await _DialogService.OpenAsync("Station: " + station, ds =>
        @<div>
        <p>Status: @Status</p>
        <p>Session ID: @SessionID</p>
        <p>Trainee ID: @TraineeID</p>
        <p>Course ID: @CourseID</p>
        <p>Session Started At: @CourseStartedAt</p>
        <p>Session Ended At: @CourseEndedAt</p>

        <br>
        <div>@Status</div>
        </div>, new DialogOptions() { CloseDialogOnOverlayClick = true });
    }
    
}
