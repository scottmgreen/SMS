<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	  <WarningsAsErrors />
	  <WarningsNotAsErrors />
    
    <!-- Version Information -->
    <Version>1.1.4</Version>
    <AssemblyVersion>1.1.4.0</AssemblyVersion>
    <FileVersion>1.1.4.0</FileVersion>
    <AssemblyTitle>SMS Shared Library</AssemblyTitle>
    <Product>PDX Safety Management System</Product>
    <Company>Portland International Airport</Company>
    <Copyright>Copyright © 2024 Portland International Airport</Copyright>
    
	  <!-- Suppress common nullable reference type warnings during migration -->
	  <NoWarn>$(NoWarn);CS8618;CS8625;CS8604;CS8602;CS8600;CS8601;CS8603;CS8605;CS8607;CS8608;CS8609;CS8610;CS8611;CS8612;CS8613;CS8614;CS8615;CS8616;CS8617;CS8619;CS8620;CS8621;CS8622;CS8623;CS8624;CS8629;CS8631;CS8633;CS8634;CS8635;CS8636;CS8637;CS8638;CS8639;CS8640;CS8641;CS8642;CS8643;CS8644;CS8645;CS8646;CS8647;CS8648;CS8649;CS8653;CS8654;CS8655;CS8667;CS8670;CS8714;CS8762;CS8763;CS8764;CS8765;CS8766;CS8767;CS8768;CS8769;CS8770;CS8774;CS8775;CS8776;CS8777;CS8778;CS8794;CS8819</NoWarn>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.FeatureManagement" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
	<FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="System.Net" />
    <Using Include="System.Xml.Linq" />
  </ItemGroup>
</Project>
